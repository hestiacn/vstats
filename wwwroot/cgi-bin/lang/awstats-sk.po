#------------------------------------------------------------------------------
# Popisy formátov
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Textový súbor (štandardizácia ASCII v roku 1963, neformátovaný čistý text. Základ všetkého zdrojového kódu, konfigurácií a denníkov. Unix používa LF, Windows používa CRLF pre nový riadok, stále najuniverzálnejší formát údajov v počítačoch)"

msgid "mime_log"
msgstr "Súbor denníka (čistý textový súbor, ktorý zaznamenáva informácie o činnosti systému a aplikácií, často používaný na riešenie problémov, analýzu výkonu, bezpečnostný audit. Štandardné formáty ako Apache combined log, Nginx access log, syslog atď.)"

msgid "mime_page"
msgstr "HTML webová stránka (Tim Berners-Lee vynašiel WWW v roku 1989, definoval tri technológie HTML/HTTP/URL v roku 1990, bezplatne ich sprístupnil bez patentu. V roku 2014 sa HTML5 stal oficiálnym štandardom W3C, podporuje zobrazenie, multimédiá a tlač. Získal Turingovu cenu v roku 2016)"

msgid "mime_khtml"
msgstr "Motor webových stránok KHTML (KDE 2.0 bolo vydané v roku 1998, vykresľovací motor prehliadača Konqueror. V roku 2001 Apple vytvoril WebKit založený na KHTML, v roku 2008 Google vytvoril Blink z WebKitu, ktorý sa stal jadrom prehliadačov Chrome, Edge, Safari a ďalších. KHTML je príkladom toho, ako komunita otvoreného zdrojového kódu položila základy moderných prehliadačových motorov, jeho technologické dedičstvo pokračuje cez WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamický skript (interpretovaný jazyk, nevyžaduje kompiláciu. Zahŕňa ASP, JSP, CGI, ColdFusion, Tcl, VBScript atď., široko používaný v ranom webovom vývoji, správe systému, automatizácii úloh. Moderné skriptovacie jazyky ako Python, Ruby, JavaScript sa vyvinuli na hlavné nástroje na vývoj full-stack aplikácií)"

msgid "mime_js"
msgstr "Skript JavaScript (Brendan Eich ho vytvoril za 10 dní v Netscape v roku 1995, natívny programovací jazyk prehliadačov. V roku 1997 bol ECMAScript štandardizovaný, v roku 2009 sa zrodil Node.js, ktorý z neho urobil full-stack jazyk, npm je najväčší správca balíkov na svete. Už roky najpopulárnejší programovací jazyk na GitHub-e)"

msgid "mime_py"
msgstr "Skript Python (vytvorený Guido van Rossumom v roku 1991, známy povinným odsadzovaním a čistou syntaxou. Široko používaný vo webovom vývoji, dátovej vede, umelej inteligencii, automatizovanej prevádzke. Viacnásobný držiteľ ceny TIOBE za programovací jazyk roka)"

msgid "mime_sh"
msgstr "Shell skript (Unix sa narodil v roku 1971, príkazový skriptovací jazyk. Používa sa na správu systému, automatizáciu úloh, spúšťanie služieb, skripty nasadenia. Základná zručnosť pre správcov Linuxu)"

msgid "mime_rb"
msgstr "Skript Ruby (vytvorený Yukihiro Matsumotom v roku 1995, zameriava sa na šťastie vývojára. Rámec Ruby on Rails otvoril paradigmu vývoja „konvencia namiesto konfigurácie“, ovplyvnil dizajn moderných webových rámcov)"

msgid "mime_pl"
msgstr "Skript Perl (vytvorený Larrym Wallom v roku 1987, známy svojou pragmatickosťou, nazývaný „švajčiarsky nôž“. CPAN bol priekopníkom moderných správcov balíkov jazykov, mal hlboký vplyv v oblasti spracovania textu, správy systému a CGI)"

msgid "mime_php"
msgstr "Dynamická stránka PHP (vytvorená Rasmusom Lerdorfom v roku 1995, navrhnutá špeciálne pre webový vývoj. Viac ako 70% webových stránok na svete ju používa, poháňa platformy ako WordPress, Facebook, Wikipedia. PHP 8 zaviedlo kompiláciu JIT, výrazne zvyšuje výkon)"

msgid "mime_image"
msgstr "Obrázkový súbor"

msgid "mime_document"
msgstr "Dokumentový súbor"

msgid "mime_package"
msgstr "Softvérový balík"

msgid "mime_archive"
msgstr "Skombinovaný súbor Gzip (projekt GNU z roku 1992, založený na algoritme DEFLATE. Na webe sa používa na dynamickú kompresiu obsahu odpovedí, miera kompresie zvyčajne 60-90%. Po roku 2015 bol v niektorých scenároch nahradený Brotli, ale stále je najrozšírenejšie podporovaným kompresným formátom na strane servera)"

msgid "mime_audio"
msgstr "Zvukový súbor"

msgid "mime_video"
msgstr "Video súbor"

msgid "mime_jscript"
msgstr "JavaScript (vyvinutý Brendanom Eichom v roku 1995)"

msgid "mime_json"
msgstr "JSON dáta (navrhnuté Douglasom Crockfordom v roku 2001, ľahký formát výmeny dát, de facto štandard pre webové API)"

msgid "mime_vbs"
msgstr "VBScript (vyvinutý spoločnosťou Microsoft v roku 1996, Windows skriptovací jazyk, používaný pre ASP stránky a skripty správy Windows. S rozšírením PowerShell a JavaScriptu sa postupne vyraďuje z prevádzky)"

msgid "mime_conf"
msgstr "Konfiguračný súbor (textový formát na ukladanie konfigurácie softvéru, bežné formáty: INI, JSON, YAML, TOML, XML. Konfigurácie systému Linux sú väčšinou v adresári /etc)"

msgid "mime_css"
msgstr "CSS šablóna štýlov (W3C vydalo CSS1 ako prvý oficiálny štandard v decembri 1996, CSS2 pridal umiestňovanie a typy médií v roku 1998, od roku 2011 CSS3 modulovo zaviedlo zaoblené rohy, animácie, flexibilné boxy, mriežkový layout a responzívny dizajn. Spolu s HTML a JavaScriptom sú tri základné technológie front-endu, všetky moderné prehliadače (Chrome, Firefox, Safari, Edge) ho natívne podporujú, je jediným štandardom pre definovanie webových štýlov)"

msgid "mime_xsl"
msgstr "XSL šablóna štýlov (štandard W3C z roku 1999, jazyk na transformáciu dokumentov XML, môže konvertovať XML na HTML/PDF/text. Po rozšírení JSON sa jeho používanie znížilo)"

msgid "mime_runtime"
msgstr "Spustiteľný súbor (spustiteľné formáty operačného systému ako EXE, ELF, Mach-O, obsahuje strojový kód a informácie o načítaní)"

msgid "mime_library"
msgstr "Knižničný súbor (DLL, SO, dylib a iné dynamicky linkované knižnice, kód načítaný počas spúšťania programu)"

msgid "mime_swf"
msgstr "Flash animácia (vyvinutá spoločnosťou Macromedia v roku 1996, neskôr prešla na Adobe. Štandard pre interaktívne webové animácie, kedysi dominoval internetovým animáciám a hrám. Problémy: závislosť na plugine, žiadna podpora na mobiloch, vysoké bezpečnostné riziko. V roku 2017 Adobe oznámilo vyradenie, podpora bola úplne ukončená v roku 2020, nahradený HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD definícia typu dokumentu (špecifikácia XML, definuje štruktúru dokumentu XML, používa sa na overenie platnosti XML)"

msgid "mime_csv"
msgstr "Formát dát CSV (hodnoty oddelené čiarkami, univerzálny formát pre tabuľkové údaje, štandard pre import/export v Exceli a databázach)"

msgid "mime_jnlp"
msgstr "Java Web Start (spúšťač java aplikácií, technológia distribúcie java desktopových aplikácií z roku 2000, teraz vyradená)"

msgid "mime_lit"
msgstr "Microsoft Reader e-kniha (vydaný spoločnosťou Microsoft v roku 2000, formát LIT, vyradený)"

msgid "mime_svg"
msgstr "SVG vektorová grafika (štandard W3C z roku 1999, pretože Microsoft dlho presadzoval svoj vlastný formát VML, prehliadač IE podporoval až do roku 2011, čo oneskorilo jeho rozšírenie. Po roku 2015, s vyradením IE a rozšírením HD obrazoviek, sa stal preferovaným formátom pre ikony a logá)"

msgid "mime_ai"
msgstr "Adobe Illustrator vektorová grafika (vydaná v roku 1987, priemyselný štandard formátu vektorovej grafiky, prvá voľba pre tlačový dizajn, logá a ikony)"

msgid "mime_phshop"
msgstr "Obrázok Photoshop (vydaný spoločnosťou Adobe v roku 1990, zdrojový formát Photoshopu PSD, priemyselný štandard spracovania obrazu)"

msgid "mime_ttf"
msgstr "TrueType písmo (vyvinuté spoločne spoločnosťami Apple a Microsoft v roku 1989, vektorový formát písma, konzistentné zobrazenie na obrazovke a v tlači, predvolený formát písma moderných operačných systémov)"

msgid "mime_fon"
msgstr "Webové písmo WOFF2 (odporúčanie W3C z roku 2014, používa kompresný algoritmus Brotli, v porovnaní so starším WOFF je veľkosť znížená asi o 30%, v porovnaní s TTF/OTF znížená o viac ako 50%, všetky moderné prehliadače ho podporujú, je preferovaným formátom pre moderné webové písma, podporovaný viac ako 98% prehliadačov)"

msgid "mime_pdf"
msgstr "PDF dokument (vyvinutý spoločnosťou Adobe v roku 1993, v roku 2008 sa stal medzinárodným štandardom ISO. Formát dokumentu nezávislý na platforme, zachováva konzistentnosť formátovania, globálny štandard pre distribúciu elektronických dokumentov)"

msgid "mime_dotnet"
msgstr "Dynamická stránka ASP.NET (vydané spoločnosťou Microsoft v roku 2002, dynamická webová technológia pre platformu Windows, súčasť .NET Frameworku)"

msgid "mime_mdb"
msgstr "Databáza Access (súbor databázy Microsoft Access, vydaný v roku 1992, desktopové databázové riešenie pre Windows)"

msgid "mime_md"
msgstr "Markdown dokument (vytvorený Johnom Gruberom v roku 2004, dizajn syntaxe bol ovplyvnený reStructuredText a Setext. Základná filozofia návrhu je „čitateľnosť je vykreslenie“, pôvodná implementácia Markdown.pl je napísaná v Perle a vykonáva transformáciu textu založenú na regulárnych výrazoch. Odvodené špecifikácie zahŕňajú GFM (2013), CommonMark (2017), Pandoc Markdown atď. Poháňa ekosystémy ako GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, stal sa de facto štandardným formátom pre statické generátory webových stránok a dokumentáciu vývojárov)"

msgid "mime_crystal"
msgstr "Formát správ Crystal Reports (SAP business intelligence správy, štandardný formát podnikových správ)"

msgid "mime_libreoffice"
msgstr "LibreOffice dokument (vyvinutý The Document Foundation v roku 2010, vetva OpenOffice, implementácia štandardu ODF, hlavný open source kancelársky balík)"

msgid "mime_encrypt"
msgstr "Šifrovaný súbor (súbor, ktorý je potrebné dešifrovať na zobrazenie, bežné prípony: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Dáta GPS trasy (formát výmeny GPS, zaznamenáva informácie o geografickej polohe, univerzálny formát pre športové hodinky a navigačné zariadenia)"

msgid "mime_diskimage"
msgstr "Obraz disku (DMG, ISO, IMG a ďalšie obrazové súbory optických/pevných diskov, používa sa na distribúciu softvéru alebo zálohovanie pamäťových médií)"

msgid "mime_vm"
msgstr "Obraz virtuálneho počítača (VMDK, VDI, VHDX, OVA a ďalšie súbory virtuálnych diskov, formáty virtualizačných platforiem ako VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent súbor torrent (vynájdený Bramom Cohenom v roku 2001, P2P indexový súbor na sťahovanie, obsahuje metadáta súboru a informácie o Trackeri)"

msgid "mime_gis"
msgstr "Dáta GIS (Shapefile, GeoJSON a ďalšie geopriestorové formáty dát, používané na mapy a priestorovú analýzu)"

msgid "mime_ebook"
msgstr "E-kniha (EPUB, MOBI, AZW a ďalšie formáty e-kníh. EPUB je medzinárodný štandard, MOBI/AZW je formát Amazon Kindle)"

msgid "mime_avif"
msgstr "Obrázok AVIF (vydaný Alianciou pre otvorené médiá v roku 2019, založený na kódovaní AV1, miera kompresie je o 50% lepšia ako WebP, štandard webových obrázkov novej generácie)"

msgid "mime_markdown"
msgstr "Markdown dokument (navrhnutý Johnom Gruberom v roku 2004, ľahký značkovací jazyk, univerzálny formát pre GitHub README, technickú dokumentáciu, príspevky na fórach)"

msgid "mime_yaml"
msgstr "YAML konfigurácia (navrhnutá Clarkom Evansom v roku 2001, human readable formát serializácie dát, štandardný formát konfiguračných súborov pre Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML konfigurácia (navrhnutá Tomom Prestonom-Wernerom v roku 2013, „Tom's Obvious Minimal Language“, formát konfiguračných súborov pre moderné nástroje ako Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Súbor komponentu Vue (predstavený v roku 2014 Evanom You, progresívny JavaScript framework. Prostredníctvom jednosúborových komponentov (SFC) dokonale spája HTML, CSS a JS, čím výrazne zvyšuje efektivitu vývoja. Je to jeden z najpopulárnejších frontend frameworkov na svete. Zároveň ako jadro moderných generátorov statických stránok, ako je VitePress, je široko používaný na pohon interaktívnej technickej dokumentácie a blogov.)"

msgid "mime_wasm"
msgstr "WebAssembly modul (štandard W3C z roku 2017, vysoko výkonný vykonávací formát v prehliadači, C/C++/Rust/R sa môžu kompilovať na cieľ, výkon blízky natívnemu)"

msgid "mime_jsx"
msgstr "React JSX komponent (Facebook predstavil JavaScript XML v roku 2013, syntax komponentov pre framework React, inovatívna paradigma pre písanie HTML v JavaScripte)"

msgid "mime_tsx"
msgstr "TypeScript TSX komponent (vyvinutý spoločnosťou Microsoft v roku 2012, TypeScript + JSX, štandardný spôsob vývoja Reactu s bezpečnosťou typov)"

msgid "mime_heif"
msgstr "Obrázok HEIF (štandard MPEG z roku 2015, efektívny formát obrazového súboru, široko používaný v ekosystéme Apple)"

msgid "mime_heic"
msgstr "Obrázok HEIC (implementácia HEIF od Apple, predvolený formát fotografií pre iPhone, natívne podporovaný na iOS/macOS)"

msgid "mime_gltf"
msgstr "3D model GLTF (formát prenosu GL, „JPEG pre 3D svet“, vydaný skupinou Khronos Group v roku 2015, štandardný formát pre web 3D)"

msgid "mime_glb"
msgstr "Binárny 3D model GLB (binárna verzia GLTF, jeden súbor obsahuje všetky zdroje, používa sa na distribúciu 3D scén)"

msgid "mime_gls"
msgstr "GLOSSARY glosár (súbor definícií pojmov, používa sa na správu terminológie v systémoch dokumentácie)"

msgid "mime_cbz"
msgstr "CBZ komiksová kniha (obrazy komiksov skomprimované ZIP, univerzálny formát pre zbieranie komiksov)"

msgid "mime_cbr"
msgstr "CBR komiksová kniha (obrazy komiksov skomprimované RAR, univerzálny formát pre zbieranie komiksov)"

msgid "mime_fb2"
msgstr "E-kniha FB2 (FictionBook 2.0, ruský formát e-kníh, štruktúra XML, široko podporovaný čítačkami s otvoreným zdrojovým kódom)"

msgid "mime_kepub"
msgstr "E-kniha KEPUB (formát EPUB špecifický pre Kobo, optimalizovaný formát pre čítačky e-kníh Kobo)"

msgid "mime_m4b"
msgstr "Audio kniha M4B (formát audio knihy MPEG-4, podporuje záložky, formát audio kníh iTunes)"

msgid "mime_kfx"
msgstr "Formát Kindle KFX (vydaný spoločnosťou Amazon v roku 2015, špeciálny formát pre e-knihy Kindle, podporuje vylepšenú typografiu a rýchle listovanie)"

msgid "mime_chm"
msgstr "Pomocný súbor CHM (vydaný spoločnosťou Microsoft v roku 1997, kompilovaný formát HTML pomocníka, štandard pre dokumentáciu pomocníka softvéru Windows)"

msgid "mime_mht"
msgstr "Webový archív MHT (vydaný spoločnosťou Microsoft v roku 1999, jednosúborový webový formát, formát ukladania webových stránok prehliadačom IE)"

msgid "mime_wml"
msgstr "Bezdrôtový značkovací jazyk WML (štandard WAP z roku 1999, používaný pre súbory webových stránok starých funkčných telefónov, vyradený)"

msgid "mime_xhtml"
msgstr "XHTML webová stránka (štandard W3C z roku 2000, XML verzia HTML, prísnejšia syntax. V roku 2009 W3C zastavil údržbu, pozornosť sa presunula na HTML5)"

msgid "mime_xml"
msgstr "XML dokument (štandard W3C z roku 1998, rozšíriteľný značkovací jazyk, základný formát pre webové služby, konfiguračné súbory, výmenu dát)"

msgid "mime_sgml"
msgstr "SGML dokument (štandard ISO z roku 1986, predchodca HTML, štandardný všeobecný značkovací jazyk, XML aj HTML sú odvodené zo SGML)"

msgid "mime_apng"
msgstr "APNG animácia (vyvinutá spoločnosťou Mozilla v roku 2004, animačné rozšírenie PNG, moderná náhrada za GIF, podporuje pravé farby a priehľadnosť)"

msgid "mime_bmp"
msgstr "BMP bitmapa (formát bitmapy Windows, natívne podporovaný od Windows 1.0. Nekomprimovaný, veľká veľkosť súboru, ale vďaka jednoduchej štruktúre a nepotrebe ďalších kodekov sa stále používa v Nástroji na vystrihovanie Windows 11, programe Paint, zdrojoch ikon v inštalačných balíkoch EXE/MSI, súboroch kurzora a niektorých starších ovládačoch. Pri rovnakej kvalite obrazu je veľkosť súboru asi 3-10 krát väčšia ako PNG. Vo väčšine prípadov bol nahradený formátmi PNG/JPEG, ale ekosystém Windows stále zachováva širokú kompatibilitu)"

msgid "mime_cdr"
msgstr "Vektorová grafika CDR (špecifický formát CorelDRAW, kanadská spoločnosť Corel, softvér na dizajn vektorovej grafiky)"

msgid "mime_gif"
msgstr "Obrázok GIF (vyvinutý spoločnosťou CompuServe v roku 1987, 256-farebný animovaný formát obrázka. Slabiny: málo farieb, hrubá kvalita obrazu, nepodporuje priehľadnosť, veľký súbor, nízka snímková frekvencia. Nahradený modernými animovanými formátmi obrázkov ako APNG, WebP)"

msgid "mime_ico"
msgstr "Ikona ICO (formát súboru ikon Windows, podporuje viacero rozlíšení, štandardný formát pre favicon webových stránok)"

msgid "mime_jpeg"
msgstr "Obrázok JPEG (štandard ISO z roku 1992, stratový kompresný formát fotografií, de facto štandard pre fotografie na internete)"

msgid "mime_jpg"
msgstr "Obrázok JPEG (štandard ISO z roku 1992, stratový kompresný formát fotografií, de facto štandard pre fotografie na internete)"

msgid "mime_png"
msgstr "Obrázok PNG (odporúčanie W3C z roku 1996, podporuje pravé farby a priehľadnosť, statická náhrada za GIF, internetový štandard pre bezkompresné obrázky)"

msgid "mime_ps"
msgstr "PostScript súbor popisu stránky (vydaný spoločnosťou Adobe v roku 1985, jazyk popisu stránky, predchodca PDF, používaný na tlač a publikovanie)"

msgid "mime_psb"
msgstr "Veľký dokument PSB (formát veľmi veľkého obrazu Adobe Photoshop, podporuje gigantické obrázky presahujúce 2 GB alebo 30 000 pixelov)"

msgid "mime_psd"
msgstr "Obrázok PSD (zdrojový súbor Adobe Photoshop, podporuje vrstvy, kanály, cesty, priemyselný štandard spracovania obrazu)"

msgid "mime_webp"
msgstr "Obrázok WebP (vyvinutý spoločnosťou Google v roku 2010, formát webových obrázkov, podporuje stratovú/bezkompresnú kompresiu a animáciu, miera kompresie je o 25-35% lepšia ako PNG, o 25% lepšia ako JPEG)"

msgid "mime_woff"
msgstr "Webové písmo WOFF (vytvorené v roku 2009, štandard W3C z roku 2018. Kompresia založená na TrueType/OpenType, optimalizácia načítavania webových písiem, štandardný formát písiem ikon moderných webových stránok)"

msgid "mime_7z"
msgstr "Skombinovaný balík 7z (vyvinutý Igorom Pavlovom v roku 1999, špecifický formát programu 7-Zip. Algoritmus LZMA, vysoká kompresia, otvorený zdrojový kód a zadarmo. Formát 7z je pri rovnakej miere kompresie zvyčajne o 30-50% menší ako ZIP, bežný formát v komunite otvoreného zdrojového kódu a pre distribúciu softvéru)"

msgid "mime_ace"
msgstr "Skombinovaný balík ACE (vyvinutý v 90. rokoch, formát programu WinACE. Kedysi konkuroval RAR, relatívne vysoká miera kompresie. Vývoj bol zastavený v roku 2007, teraz bol nahradený 7z/RAR, zriedka používaný)"

msgid "mime_bz2"
msgstr "Skombinovaný balík BZIP2 (vyvinutý Julianom Sewardom v roku 1996, kompresný algoritmus triedenia blokov. Miera kompresie je o 15-20% lepšia ako GZIP, ale pomalší. Zdrojový kód jadra Linuxu, balíky s otvoreným zdrojovým kódom často používajú tento formát, prípona .bz2)"

msgid "mime_cab"
msgstr "Skombinovaný balík CAB (vyvinutý spoločnosťou Microsoft v roku 1995, formát Cabinet. Formát inštalačných balíkov systému Windows, používa sa pre ovládače, distribúciu systémových súborov. Windows Installer (MSI) interne používa CAB na ukladanie súborov)"

msgid "mime_dmg"
msgstr "Obraz disku DMG (vydaný spoločnosťou Apple v 80. rokoch, formát Disk Image. Štandardný formát distribúcie softvéru pre macOS, dvojitým kliknutím sa pripojí ako virtuálny disk, potiahnutím a pustení nainštalujete aplikáciu. Podporuje kompresiu a šifrovanie, hlavný formát na sťahovanie softvéru pre Mac)"

msgid "mime_emz"
msgstr "Skombinovaný obrázok EMZ (komprimovaný vylepšený metazáznam Windows, komprimovaná verzia EMF. Formát ukladania vektorovej grafiky v dokumentoch Office, v podstate ide o súbor EMF skomprimovaný programom GZIP)"

msgid "mime_gz"
msgstr "Skombinovaný balík GZIP (vyvinutý Jean-loup Gaillym a Markom Adlerom v roku 1992, projekt GNU. Štandardný kompresný nástroj Unix/Linux, bežný formát pre kompresiu prenosu HTTP. Prípona .gz, často používaný spolu s TAR)"

msgid "mime_jar"
msgstr "Skombinovaný balík JAR (vydaný spoločnosťou Sun Microsystems v roku 1997, formát Java ARchive. V podstate ide o skombinovaný balík ZIP, používa sa na balenie knižníc tried Java a aplikácií. Základný formát v ekosystéme Java ako Maven, Gradle, Android tiež používa JAR)"

msgid "mime_lzma"
msgstr "Skombinovaný balík LZMA (vyvinutý Igorom Pavlovom v roku 1998, algoritmus reťazca Lempel-Ziv-Markov. Základný kompresný algoritmus formátu 7z, vysoká kompresia, rýchla dekompresia. Používa sa na firmvér, distribúciu softvéru pre vstavané systémy)"

msgid "mime_rar"
msgstr "Skombinovaný balík RAR (vyvinutý Eugenom Roshalom v roku 1993, formát Roshal ARchive. Vysoká kompresia, podporuje rozdelenie na zväzky, záznamy obnovy. Formát programu WinRAR, kompresia lepšia ako ZIP, ale vyžaduje platený softvér, nástroje s otvoreným zdrojovým kódom ako unrar môžu dekomprimovať)"

msgid "mime_tar"
msgstr "Archív TAR (predstavený v Unix V7 v roku 1979, formát Tape ARchive. Formát páskového archívu, nekomprimuje iba balí, často používaný spolu s GZIP/BZIP2/XZ. Zdrojový kód balíkov Linuxu, ukladanie vrstiev obrazov Docker používa formát TAR)"

msgid "mime_tgz"
msgstr "Skombinovaný balík TGZ (kombinovaný formát TAR + GZIP, prípona .tgz alebo .tar.gz. Najuniverzálnejší formát distribúcie balíkov Unix/Linux, široko používaný pre zdrojové balíky, binárne balíky, predstaviteľ „rozbaliť a použiť“)"

msgid "mime_tbz2"
msgstr "Skombinovaný balík TBZ2 (kombinovaný formát TAR + BZIP2, prípona .tbz2 alebo .tar.bz2. Miera kompresie je o 15-20% lepšia ako TGZ, vhodný pre distribúciu veľkých súborov, zdrojový kód jadra Linuxu dlhodobo používa tento formát)"

msgid "mime_xz"
msgstr "Skombinovaný balík XZ (vydaný v roku 2009, založený na algoritme LZMA2. Extrémne vysoká kompresia, o 30-50% lepšia ako GZIP, relatívne rýchla dekompresia. Široko používaný v jadre Linuxu, správcoch balíkov (napríklad interne v .deb Debianu), odporúčaný formát pre súčasný ekosystém Linuxu)"

msgid "mime_z"
msgstr "Skombinovaný balík Z (formát príkazu compress Unix z roku 1985, algoritmus LZW. Raný kompresný formát Unixu, nahradený GZIP. Prípona .Z, na moderných systémoch sa používa zriedka)"

msgid "mime_zip"
msgstr "Skombinovaný balík ZIP (vyvinutý Philom Katzom v roku 1989, formát PKZIP. Natívne podporovaný systémom Windows, najuniverzálnejší kompresný formát na internete. Podporuje viacero súborov, štruktúru adresárov, možnosť výberu kompresného algoritmu. Java JAR, Android APK, dokumenty Office DOCX/XLSX sú založené na formáte ZIP)"

msgid "mime_zst"
msgstr "Skombinovaný balík Zstandard (vyvinutý spoločnosťou Facebook v roku 2015, navrhnutý Yannom Colletom. Vysokorýchlostný kompresný algoritmus, miera kompresie blízka LZMA, rýchlosť ďaleko prevyšuje GZIP. Jadro Linuxu 5.9+ podporuje, Arch Linux pacman, Debian APT ho postupne preberajú, kompresný štandard novej generácie)"

msgid "mime_lz4"
msgstr "Skombinovaný balík LZ4 (vyvinutý Yannom Colletom v roku 2011, extrémne rýchly kompresný algoritmus. Rýchlosť kompresie je viac ako 10-krát rýchlejšia ako GZIP, vhodný pre scenáre kompresie v reálnom čase. Jadro Linuxu, OpenZFS, Hadoop ho široko používajú, prvá voľba pre scenáre, kde je rýchlosť prioritou)"

msgid "mime_lzo"
msgstr "Skombinovaný balík LZO (vyvinutý Markusom Oberhumerom v roku 1996, algoritmus Lempel-Ziv-Oberhumer. Rýchlosť dekompresie je extrémne rýchla, miera kompresie je priemerná. Jadro Linuxu Squashfs, firmvér OpenWrt ho používajú, vhodný pre vstavané systémy)"

msgid "mime_msi"
msgstr "Inštalačný balík MSI (vydaný spoločnosťou Microsoft v roku 1999, formát balíka Windows Installer. Štandardný inštalačný formát pre aplikácie Windows, podporuje vrátenie transakcií, správu komponentov, tichú inštaláciu. Preferovaný formát pre distribúciu softvéru na úrovni podnikov, dodnes hlavný prúd pre inštaláciu softvéru Windows)"

msgid "mime_pkg"
msgstr "Inštalačný balík PKG (formát inštalačného balíka aplikácií macOS, založený na technológii Installer od Apple. Štandardný formát distribúcie softvéru macOS, podporuje výber komponentov, inštalačné skripty, funkciu odinštalovania. Dvojitým kliknutím na súbor .pkg nainštalujete, bežná metóda distribúcie pre softvér mimo Mac App Store)"

msgid "mime_apk"
msgstr "Balík aplikácie Android APK (vydaný spoločnosťou Google v roku 2008, tradičný inštalačný formát pre aplikácie Android. APK je v podstate balík ZIP obsahujúci kód, zdroje, manifestový súbor. Od roku 2021 Google Play vyžaduje, aby nové aplikácie používali formát AAB, ale APK sa stále používa na vývoj a ladenie, obchody tretích strán a bočnú inštaláciu)"

msgid "mime_ipa"
msgstr "Balík aplikácie iOS IPA (balík iOS App Store, inštalačný formát pre aplikácie iOS/iPadOS. Predstavený v roku 2008 spolu s iPhone SDK. Musí byť distribuovaný cez App Store alebo podpísaný podnikovým certifikátom. Obsahuje spustiteľný súbor, zdroje, Info.plist a informácie o podpise)"

msgid "mime_hap"
msgstr "Balík aplikácie HarmonyOS HAP (HarmonyOS Ability Package, základná jednotka aplikácie HarmonyOS. Predstavený v roku 2020 s HarmonyOS 2.0. Podporuje dva typy: entry a feature, distribučný formát pre telefóny Huawei, tablety, inteligentné hodinky a ďalšie zariadenia HarmonyOS)"

msgid "mime_har"
msgstr "HarmonyOS statická zdieľaná knižnica HAR (HarmonyOS Archive, statická zdieľaná knižnica HarmonyOS, môže byť zdieľaná viacerými balíkmi HAP, používa sa na vývoj založený na komponentoch a opätovné použitie modulov)"

msgid "mime_aab"
msgstr "Android App Bundle (vydaný spoločnosťou Google v roku 2018, od roku 2021 Google Play vyžaduje, aby nové aplikácie používali tento formát. AAB je distribučný formát, Google Play generuje optimalizované APK podľa konfigurácie zariadenia (architektúra CPU, hustota obrazovky, jazyk), veľkosť inštalačného balíka sa v priemere znižuje o 35%. Vývojári nahrávajú AAB, používatelia sťahujú APK)"

msgid "mime_xapk"
msgstr "Balík aplikácie XAPK (rozširujúci balík aplikácií Android tretej strany, obsahuje APK + dátové súbory OBB. Používa sa pre veľké hry a zložité aplikácie, rieši limit 100 MB pre jeden súbor APK. Bežný v obchodoch s aplikáciami tretích strán ako APKPure, APKMirror, nie je oficiálny formát Google)"

msgid "mime_appx"
msgstr "Balík aplikácie Windows (vydaný spoločnosťou Microsoft v roku 2012, inštalačný formát pre aplikácie Windows 8/10/11. Podporuje konverziu aplikácií UWP a desktopových, distribuovaný cez Microsoft Store. V roku 2024 Microsoft predstavil MSIX ako nástupnícky formát, postupne nahrádza APPX)"

msgid "mime_msix"
msgstr "Balík aplikácie MSIX (vydaný spoločnosťou Microsoft v roku 2018, nový generický formát balenia aplikácií pre Windows. Kombinuje výhody APPX a MSI, podporuje všetky typy aplikácií Windows, môže byť distribuovaný cez Microsoft Store alebo bočne inštalovaný, odporúčaný formát pre Windows 11)"

msgid "mime_appimage"
msgstr "Balík aplikácie AppImage (predstavený v roku 2004, inštalačne nenáročný formát aplikácie Linux. „Jedna aplikácia, jeden súbor“, nevyžaduje inštaláciu, beží priamo, podporuje väčšinu distribúcií Linuxu, bežný spôsob distribúcie Linuxového softvéru pre vývojárov)"

msgid "mime_flatpak"
msgstr "Balík aplikácie Flatpak (predstavený v roku 2015, formát aplikácie Linux v karanténe. Beží na rôznych distribúciách, izolovaný od hostiteľského systému, vedený spoločnosťami Fedora, Red Hat, predvolený formát Centra softvéru GNOME)"

msgid "mime_snap"
msgstr "Balík aplikácie Snap (vydaný spoločnosťou Canonical v roku 2014, materská spoločnosť Ubuntu, univerzálny formát aplikácií Linux. Automatické aktualizácie, izolácia v karanténe, podporuje viac ako 40 distribúcií Linuxu, predvolený formát Centra softvéru Ubuntu)"

msgid "mime_deb"
msgstr "Softvérový balík Debian (vydaný projektom Debian v roku 1993, štandardný inštalačný formát pre Debian/Ubuntu a ich deriváty. Spravuje sa pomocou dpkg, APT je jeho predná časť správcu balíkov, jeden z najvyspelejších formátov balíkov v ekosystéme Linuxu, dodnes hlavný prúd v rodine Debian)"

msgid "mime_rpm"
msgstr "Softvérový balík RPM (vydaný spoločnosťou Red Hat v roku 1997, štandardný formát pre distribúcie Red Hat/Fedora/CentOS/SUSE a ďalšie. RPM znamená „Red Hat Package Manager“, spolu s DEB sú dva veľké formáty balíkov v Linuxe, dodnes hlavný prúd v rodine RHEL)"

msgid "mime_pacman"
msgstr "Softvérový balík Arch (vydaný spoločnosťou Arch Linux v roku 2002, formát .pkg.tar.zst používaný správcom balíkov pacman. Jadro rolovacej distribúcie Arch Linux, známy pre svoju jednoduchosť a princíp KISS, AUR (Arch User Repository) je jeho charakteristickým znakom)"

msgid "mime_exe"
msgstr "Spustiteľný súbor EXE (spustiteľný formát programu Windows, skratka pre „Executable“. Natívny spustiteľný formát operačného systému Windows, obsahuje štruktúru PE. Vyvinul sa z formátu MZ z MS-DOS, v roku 1993 Windows NT zaviedol formát PE (Portable Executable) a používa sa dodnes. Inštalačné balíky softvéru, aplikácie, systémové nástroje používajú tento formát. Používateľom dvojitého kliknutia sa spustí, najrozšírenejší spustiteľný formát na svete)"

msgid "mime_dll"
msgstr "Dynamická knižnica DLL (vydaná spoločnosťou Microsoft v roku 1993, Dynamic Link Library. Zdieľaná knižnica kódu Windows, načítava sa dynamicky počas spúšťania programu, šetrí pamäť a miesto na disku. Systémové komponenty, zásuvné moduly aplikácií, ovládače používajú formát DLL. Hlavný spôsob implementácie rozhrania Windows API, problém DLL Hell bol v ére .NET zmiernený)"

msgid "mime_com"
msgstr "Spustiteľný súbor COM (spustiteľný formát z éry MS-DOS, skratka pre „Command“. Jednoduchá štruktúra súboru, limit 64 KB, hlavný formát pred Windows 3.x. Vyradený, moderný Windows používa formát EXE, prípona COM sa stále používa pre niektoré súbory komponentov)"

msgid "mime_aac"
msgstr "Zvuk AAC (štandard MPEG z roku 1997, Advanced Audio Coding. Nástupca MP3, kvalita zvuku lepšia ako MP3 pri rovnakej bitovej rýchlosti, predvolený formát zvuku pre YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Zvuk ALAC (vyvinutý spoločnosťou Apple v roku 2004, Apple Lossless Audio Codec. Bezstratový formát Apple, otvorený zdrojový kód v roku 2011, predvolený formát pre bezstratový zvuk v iTunes a Apple Music)"

msgid "mime_flac"
msgstr "Zvuk FLAC (vyvinutý nadáciou Xiph.Org v roku 2001, Free Lossless Audio Codec. Bezstratová kompresia, kvalita zvuku rovnaká ako CD, veľkosť súboru približne polovičná oproti pôvodnému WAV. Otvorený zdrojový kód bez patentov, preferovaný formát pre audiofilov a zberateľov digitálnej hudby)"

msgid "mime_mp3"
msgstr "Zvuk MP3 (vyvinutý Fraunhoferovým inštitútom v roku 1993, MPEG-1 Audio Layer 3. Stratový kompresný formát, malá veľkosť súboru, prijateľná kvalita, kľúčový formát digitálnej hudobnej revolúcie v roku 2000, hybná sila iPodu a Napsteru. Patent vypršal v roku 2017, stal sa formátom verejnej domény)"

msgid "mime_oga"
msgstr "Zvuk Ogg Audio (vyvinutý nadáciou Xiph.Org, čistý zvukový formát kontajnera Ogg, používa kódovanie Vorbis. Otvorený zdrojový kód bez patentov, účinnosť kompresie lepšia ako MP3, široko používaný v projektoch s otvoreným zdrojovým kódom)"

msgid "mime_ogg"
msgstr "Zvuk OGG (vyvinutý nadáciou Xiph.Org v roku 2000, formát Ogg Vorbis. Otvorený zdrojový kód bez patentov, účinnosť kompresie lepšia ako MP3, skorý používateľ bol Spotify, široko používaný na zvukové efekty v hrách)"

msgid "mime_opus"
msgstr "Zvuk Opus (štandardizovaný IETF v roku 2012, otvorený zdrojový kód bez patentového zvukového formátu. Kombinuje technológie SILK a CELT, extrémne nízka latencia, najvyššia účinnosť kompresie, predvolený zvukový formát pre WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Zvuk WAV (vyvinutý spoločnosťami Microsoft a IBM v roku 1991, natívny zvukový formát Windows. Kódovanie PCM bez kompresie, bezstratová kvalita zvuku, ale veľká veľkosť súboru, štandardný formát profesionálneho úpravy zvuku)"

msgid "mime_wma"
msgstr "Zvuk WMA (vyvinutý spoločnosťou Microsoft v roku 1999, Windows Media Audio. Dve verzie: stratová a bezstratová, natívne podporovaná systémom Windows, rozšírená spolu s Windows Media Player. Teraz marginalizovaný, nahradený MP3/AAC)"

msgid "mime_dsf"
msgstr "Zvuk DSF (formát Direct Stream Digital, vyvinutý spoločnosťami Sony a Philips. 1-bit vysoká vzorkovacia frekvencia, štandardný formát audio DSD, digitálna verzia SACD, audiofilský high-endový zvukový formát, veľkosť súboru obrovská)"

msgid "mime_ape"
msgstr "APE Audio (vyvinutý Monkey's Audio v roku 2000, bezstratový kompresný formát. Vyššia kompresia ako FLAC, ale pomalšie kódovanie, stále sa používa na platforme Windows a medzi audio nadšencami)"

msgid "mime_mid"
msgstr "Zvuk MIDI (stanovený asociáciou MIDI v roku 1983, Musical Instrument Digital Interface. Formát notového záznamu, nie nahrávka, veľkosť súboru veľmi malá, štandard pre elektronické hudobné nástroje, vyzváňacie tóny mobilných telefónov, zvukové efekty v hrách. V roku 1991 bol General MIDI štandardizovaný, definujúci 128 nástrojových farieb)"

msgid "mime_m4a"
msgstr "Zvuk M4A (MPEG-4 Audio, kontajnerový formát AAC. Štandardný formát obchodu iTunes Music Store, hlavný zvukový formát v ekosystéme Apple, podporuje ochranu DRM)"

msgid "mime_m3u"
msgstr "Zoznam skladieb M3U (formát zoznamu skladieb URL MP3, čistý textový súbor, zaznamenáva cesty zvukových súborov. Štandard z éry Winampu, používaný pre internetové rádio, online streamovanie hudby. M3U8 je jeho UTF-8 verzia, používaná pre HTTP Live Streaming)"

msgid "mime_asf"
msgstr "Streamovanie ASF (vyvinuté spoločnosťou Microsoft v roku 1996, Advanced Systems Format. Streamovací kontajner Windows Media, podporuje synchronný prenos zvuku a videa. Používa sa pre živé vysielanie a streamovanie videa na požiadanie, WMA/WMV sú založené na kontajneri ASF)"

msgid "mime_avi"
msgstr "Video AVI (vydané spoločnosťou Microsoft v roku 1992, skorý video štandard Windows. „Audio Video Interleave“, prekladané ukladanie zvuku a videa, najpopulárnejší formát videa v rokoch 1990-2000, teraz nahradený MP4/MKV)"

msgid "mime_divx"
msgstr "Video DivX (vyvinuté spoločnosťou DivX v roku 1998, formát kódovania videa založený na MPEG-4. Hlavný formát zdieľania videí na internete v roku 2000, prvá technológia, ktorá skomprimovala kvalitu DVD na veľkosť CD. Kvôli sporom o autorské práva sa neskôr transformovala na komerčný kodér)"

msgid "mime_mp4"
msgstr "Video MP4 (štandard MPEG z roku 2001, MPEG-4 Časť 14. Najuniverzálnejší formát videa na svete, podporuje kódovanie H.264/H.265, predvolený formát pre internetové videá, nahrávanie telefónom, YouTube)"

msgid "mime_m4v"
msgstr "Video M4V (formát videa iTunes, variant MP4. Formát videa v ekosystéme Apple, štandardný formát pre filmy, televízne programy v iTunes Store, podporuje ochranu autorských práv DRM)"

msgid "mime_mpeg"
msgstr "Video MPEG (stanovené organizáciou MPEG v roku 1988, Moving Picture Experts Group. Zakladateľ štandardov digitálnej kompresie videa, hlboký vplyv MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (internetové video))"

msgid "mime_mkv"
msgstr "Video MKV (vyvinuté projektom Matroska v roku 2002, otvorený zdrojový kód multimediálny kontajner. Podporuje viacero zvukových stôp, viacero titulkov, kapitoly, „nástroj na balenie“, preferovaný formát na zdieľanie HD filmov)"

msgid "mime_mpg"
msgstr "Video MPEG (prípona videa MPEG-1/MPEG-2, štandardný formát pre VCD a DVD. Hlavný formát videa na optických diskoch v rokoch 1990-2000, teraz nahradený H.264/H.265)"

msgid "mime_ogv"
msgstr "Video Ogg Video (vyvinuté nadáciou Xiph.Org, video formát kontajnera Ogg, používa kódovanie Theora. Otvorený zdrojový kód bez patentov, jeden z prvých štandardov pre video HTML5, natívne podporovaný Firefoxom)"

msgid "mime_ogx"
msgstr "Multimediálny kontajner Ogg (vyvinutý nadáciou Xiph.Org, univerzálne rozšírenie kontajnera Ogg, môže obsahovať viacero stôp: zvuk, video, titulky atď. Otvorený zdrojový kód multimediálny štandard, používaný pre hry, streamovanie)"

msgid "mime_rm"
msgstr "Video RealMedia (vyvinuté spoločnosťou RealNetworks v roku 1995, formát RealMedia. Priekopník internetového streamovania v rokoch 1990-2000, základný formát prehrávača RealPlayer. Slabiny: vyžaduje špeciálny prehrávač, slabá kvalita kompresie, neskôr nahradený Flash/MP4)"

msgid "mime_flv"
msgstr "Video Flash (formát sa objavil v roku 2002, formát Flash Video. Kedysi bol hlavným formátom pre internetové videá, skorý používateľ bol YouTube. Slabiny: vyžaduje plugin Flash, slabý výkon, veľa bezpečnostných dier. Od roku 2015 hlavné webové stránky prešli na video HTML5, teraz vyradený)

msgid "mime_f4v"
msgstr "Video F4V (formát Flash videa vyvinutý spoločnosťou Adobe, nástupca FLV. Založený na štandarde MPEG-4, podporuje kódovanie H.264. Spolu s technológiou Flash bol vyradený, Adobe ukončilo podporu v roku 2020)"

msgid "mime_wmv"
msgstr "Video WMV (vyvinuté spoločnosťou Microsoft v roku 1999, Windows Media Video. Natívne podporované systémom Windows, optimalizované na streamovanie, bežný formát pre skoré online videá, teraz marginalizovaný)"

msgid "mime_wmf"
msgstr "Formát médií WMF (Windows Media Format, mediálny rámec Microsoftu. Zahŕňa súhrnný názov pre video WMV a zvuk WMA, natívne podporovaný prehrávačom Windows Media Player)"

msgid "mime_mov"
msgstr "Video MOV (vyvinuté spoločnosťou Apple v roku 1991, formát kontajnera QuickTime. Štandardný formát profesionálneho strihu videa, podporuje viacero kodekov, natívne podporovaný Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "Video QuickTime (vydané spoločnosťou Apple v roku 1991, formát QuickTime. Video štandard pre platformu Mac, MOV je jeho kontajner, prehrávač QuickTime bol široko používaný. V roku 2016 Apple zastavil vývoj verzie pre Windows, postupne nahradzovaný MP4)"

msgid "mime_webm"
msgstr "Video WebM (vydané spoločnosťou Google v roku 2010, otvorený zdrojový kód bez patentov video formát. Založený na kontajneri Matroska, kódovanie VP8/VP9, štandardný formát pre video HTML5, predvolený formát prehrávania na webe YouTube)"

msgid "mime_3gp"
msgstr "Video 3GP (stanovené organizáciou 3GPP v roku 2000, video formát pre mobilné zariadenia. Veľkosť súboru veľmi malá, nízka kvalita, formát nahrávania videa na starých mobilných telefónoch, používaný na odosielanie MMS)"

