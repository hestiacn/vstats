msgstr "  %s търсачки (и ключови фрази/ключови думи, използвани от тях)"

msgid "  All HTTP errors with last referrer"
msgstr "  Всички HTTP грешки с последен реферер"

msgid "  Report by day/month/year"
msgstr "  Доклад по ден/месец/година"

msgid "  Dynamic or static HTML or XHTML reports, static PDF reports"
msgstr "  Динамични или статични HTML или XHTML доклади, статични PDF доклади"

