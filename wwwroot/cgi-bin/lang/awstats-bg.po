msgstr "  Обратно DNS търсене (IPv4 и IPv6) и GeoIP търсене"

msgid "  Number of visits, number of unique visitors"
msgstr "  Брой посещения, брой уникални посетители"

msgid "  Visits duration and list of last visits"
msgstr "  Продължителност на посещенията и списък на последните посещения"

msgid "  Authenticated users"
msgstr "  Удостоверени потребители"

msgid "  Days of week and rush hours"
msgstr "  Дни от седмицата и пикови часове"

