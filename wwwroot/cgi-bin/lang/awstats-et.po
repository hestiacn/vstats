#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstifail (1963. aasta ASCII standardimine, vormindamata tavatekst. Kogu lähtekoodi, konfiguratsiooni, logide alus. Unix kasutab LF-i, Windows CRLF-i reavahetuseks, endiselt kõige universaalsem andmevorming arvutites)"

msgid "mime_log"
msgstr "Logifail (tekstifail, mis salvestab teavet süsteemi ja rakenduste töö kohta, mida kasutatakse sageli tõrkeotsinguks, jõudluse analüüsimiseks ja turbeauditiks. Standardsed vormingud hõlmavad Apache kombineeritud logi, Nginx juurdepääsulogi, syslog jne)"

msgid "mime_page"
msgstr "HTML veebileht (Tim Berners-Lee leiutas World Wide Webi 1989. aastal, määratles kolm peamist tehnoloogiat HTML/HTTP/URL 1990. aastal, andis need tasuta ilma patenteerimata. HTML5-st sai ametlik W3C standard 2014. aastal, toetab kuvamist, multimeediat ja printimist. Turingi auhinna võitja 2016)"

msgid "mime_khtml"
msgstr "KHTML veebimootor (KDE 2.0 välja antud 1998. aastal, Konquerori brauseri renderdusmootor. Apple lõi 2001. aastal WebKiti, mis põhineb KHTML-il, ja Google lõi 2008. aastal WebKitist Blinki, millest sai Chrome'i, Edge'i, Safari jt brauserite südamik. KHTML on näide sellest, kuidas avatud lähtekoodiga kogukond pani aluse kaasaegsetele brauserimootoritele, mille tehnoloogiline pärand jätkub WebKiti/Blinki kaudu tänaseni)"

msgid "mime_script"
msgstr "Dünaamiline skriptikeel (interpretaatorikeel, pole vaja kompileerida. Sisaldab ASP, JSP, CGI, ColdFusion, Tcl, VBScript jne, mida kasutati laialdaselt varases veebiarenduses, süsteemihalduses, ülesannete automatiseerimises. Kaasaegsed skriptikeeled nagu Python, Ruby, JavaScript on arenenud täisvirna arenduse põhitööriistadeks)"

msgid "mime_js"
msgstr "JavaScripti skript (Brendan Eich lõi selle 10 päevaga Netscapis 1995. aastal, brauseri algne programmeerimiskeel. ECMAScript standardiseeriti 1997. aastal, Node.js sündis 2009. aastal, muutes selle platvormideüleseks keeleks, npm on maailma suurim paketihaldur. GitHubi kõige populaarsem programmeerimiskeel aastaid)"

msgid "mime_py"
msgstr "Pythoni skript (Guido van Rossum lõi selle 1991. aastal, tuntud kohustusliku taandamise ja lihtsa süntaksi poolest. Seda kasutatakse laialdaselt veebiarenduses, andmeteaduses, tehisintellektis, halduse automatiseerimises. TIOBE aasta programmeerimiskeele auhinna mitmekordne võitja)"

msgid "mime_sh"
msgstr "Shelli skript (Unix sündis 1971. aastal, käsurea keel. Kasutatakse süsteemihalduseks, ülesannete automatiseerimiseks, teenuste käivitamiseks, juurutamisskriptideks. Linuxi halduse jaoks vajalik oskus)"

msgid "mime_rb"
msgstr "Ruby skript (Yukihiro Matsumoto lõi selle 1995. aastal, keskendub arendaja õnnetundele. Ruby on Railsi raamistik oli konventsiooni eelistamise konfiguratsioonile paradigmade teerajaja, mõjutades kaasaegsete veebiraamistike kujundust)"

msgid "mime_pl"
msgstr "Perli skript (Larry Wall lõi selle 1987. aastal, tuntud oma pragmaatilisuse poolest, mida sageli nimetatakse 'Šveitsi armee noaks'. CPAN on kaasaegsete programmeerimiskeelte paketihaldurite eelkäija, millel on sügav mõju tekstitöötluse, süsteemihalduse ja CGI valdkonnas)"

msgid "mime_php"
msgstr "PHP dünaamiline veebileht (Rasmus Lerdorf lõi selle 1995. aastal, mis on spetsiaalselt loodud veebiarenduseks. Üle 70% maailma veebisaitidest kasutab seda, see käitab platvorme nagu WordPress, Facebook, Wikipedia. PHP 8 tutvustab JIT-kompileerimist, mis parandab oluliselt jõudlust)"

msgid "mime_image"
msgstr "Pildifail"

msgid "mime_document"
msgstr "Dokumendifail"

msgid "mime_package"
msgstr "Tarkvarapakett"

msgid "mime_archive"
msgstr "Gzip tihendatud fail (GNU projekt 1992, põhineb DEFLATE algoritmil. Seda kasutatakse veebis vastuste dünaamiliseks tihendamiseks, tihendusaste on tavaliselt 60-90%. Pärast 2015. aastat asendati see mõnes stsenaariumis Brotliga, kuid see on endiselt kõige laialdasemalt toetatud tihendusvorming serveripoolses osas)"

msgid "mime_audio"
msgstr "Helifail"

msgid "mime_video"
msgstr "Videofail"

msgid "mime_jscript"
msgstr "JavaScript (välja töötatud Brendan Eichi poolt 1995. aastal)"

msgid "mime_json"
msgstr "JSON-andmed (Douglas Crockfordi pakutud 2001. aastal, kerge andmevahetuse vorming, de facto standard veebi API-de jaoks)"

msgid "mime_vbs"
msgstr "VBScript (välja töötatud Microsofti poolt 1996. aastal, Windowsi skriptimise keel, mida kasutati ASP veebilehtede ja Windowsi haldusskriptide jaoks. PowerShell'i ja JavaScripti populaarsuse kasvuga on see järk-järgult kasutusest kõrvaldatud)"

msgid "mime_conf"
msgstr "Konfiguratsioonifail (salvestab tarkvara konfiguratsiooni tekstivormingus, tavalised vormingud: INI, JSON, YAML, TOML, XML. Linuxi süsteemi konfiguratsioonid on enamasti /etc kataloogis)"

msgid "mime_css"
msgstr "CSS-i stiilileht (W3C esimene ametlik standard CSS1 avaldati 1996. aasta detsembris, CSS2 lisas positsioneerimise ja meediatüübid 1998. aastal, alates 2011. aastast tutvustati CSS3 moodulipõhiselt ümarate nurkade, animatsioonide, flexboxi, ruudustiku paigutuse ja reageeriva disainiga. Koos HTML-i ja JavaScriptiga moodustavad need kolm peamist esiosa tehnoloogiat, kõik kaasaegsed brauserid (Chrome, Firefox, Safari, Edge) toetavad seda natiivselt, ainus standard veebistiilide määratlemiseks)"

msgid "mime_xsl"
msgstr "XSL-i stiilileht (W3C standard 1999, XML-dokumentide teisendamise keel, saab XML-i teisendada HTML/PDF/tekstiks. Pärast JSON-i populaarsust on kasutamine vähenenud)"

msgid "mime_runtime"
msgstr "Käivitatav fail (operatsioonisüsteemi käivitatav vorming nagu EXE, ELF, Mach-O, sisaldab masinkoodi ja laadimise teavet)"

msgid "mime_library"
msgstr "Teegi fail (DLL, SO, dylib jne dünaamilised lingiteegid, jagatud kood, mis laaditakse programmi käivitamisel)"

msgid "mime_swf"
msgstr "Flashi animatsioon (välja töötatud Macromedia poolt 1996. aastal, hiljem Adobe'i omandis. Standard interaktiivse veebianimatsiooni jaoks, mis domineeris kunagi Interneti-animatsioonide ja -mängude üle. Puudused: sõltuvus pistikprogrammist, puudub tugi mobiilseadmetes, kõrge turvarisk. Adobe teatas selle lõpetamisest 2017. aastal, tugi lõpetati täielikult 2020. aastal, asendati HTML5/CSS3/JS-ga)"

msgid "mime_dtd"
msgstr "DTD dokumenditüübi määratlus (XML-i spetsifikatsioon, määratleb XML-dokumendi struktuuri, mida kasutatakse XML-i kehtivuse kontrollimiseks)"

msgid "mime_csv"
msgstr "CSV-andmevorming (komaga eraldatud väärtused, universaalne vorming tabelandmete jaoks, standard Exceli ja andmebaaside importimiseks/eksportimiseks)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java rakenduse käivitaja, Java töölauarakenduste jagamise tehnoloogia 2000ndatel, praegu kasutusest kõrvaldatud)"

msgid "mime_lit"
msgstr "Microsoft Readeri e-raamat (Microsoft tutvustas 2000. aastal, LIT-vorming, kasutusest kõrvaldatud)"

msgid "mime_svg"
msgstr "SVG vektorgraafika (W3C standard 1999, Microsoft reklaamis pikka aega oma VML-vormingut, IE-brauser toetas seda alles alates 2011. aastast, mis põhjustas populariseerimise viivituse. Pärast 2015. aastat, IE-i kõrvaldamisega ja kõrge eraldusvõimega ekraanide populariseerimisega, sai sellest ikoonide ja logode esimene valik)"

msgid "mime_ai"
msgstr "Adobe Illustratori vektorgraafika (tutvustatud 1987. aastal, tööstusharu standardne vektorgraafika vorming, esimene valik trükidisaini, logode, ikoonide jaoks)"

msgid "mime_phshop"
msgstr "Photoshopi pilt (Adobe tutvustas 1990. aastal, Photoshopi lähtefaili PSD-vorming, pilditöötluse tööstusharu standard)"

msgid "mime_ttf"
msgstr "TrueType font (Apple ja Microsoft ühisarendus 1989. aastal, vektorfondi vorming, ühtlane kuvamine ekraanil ja prindis, operatsioonisüsteemide vaikefondi vorming)"

msgid "mime_fon"
msgstr "WOFF2 veebifont (W3C soovitus 2014, kasutab Brotli tihendusalgoritmi, suurust on vähendatud umbes 30% võrreldes vanema WOFF-iga, üle 50% võrreldes TTF/OTF-iga. Seda toetavad praegu kõik kaasaegsed brauserid, see on parim valik veebifontide jaoks tänapäeval, mida toetab üle 98% brauseritest)"

msgid "mime_pdf"
msgstr "PDF-dokument (Adobe töötas välja 1993. aastal, sai ISO rahvusvaheliseks standardiks 2008. aastal. Platvormideülene dokumendivorming, säilitab vormingu ühtluse, elektrooniliste dokumentide levitamise ülemaailmne standard)"

msgid "mime_dotnet"
msgstr "ASP.NET dünaamiline leht (Microsoft tutvustas 2002. aastal, dünaamiline veebilehe tehnoloogia Windowsi platvormile, osa .NET Frameworkist)"

msgid "mime_mdb"
msgstr "Accessi andmebaas (Microsoft Accessi andmebaasifail, tutvustatud 1992. aastal, töölaua andmebaasi lahendus Windowsis)"

msgid "mime_md"
msgstr "Markdowni dokument (John Gruber lõi 2004. aastal, süntaksi kujundust mõjutasid reStructuredText ja Setext. Peamine disainifilosoofia on 'loetavus võrdub renderdamisega', algne Markdown.pl teostus kasutab Perli regulaaravaldiseid. Tuletatud spetsifikatsioonide hulka kuuluvad GFM (2013), CommonMark (2017), Pandoc Markdown jne. Toetab ökosüsteeme nagu GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, on saanud staatiliste saitide generaatorite ja arendajate dokumentatsiooni de facto standardvorminguks)"

msgid "mime_crystal"
msgstr "Crystal Reportsi aruandevorming (SAP ärianalüütika aruanded, ettevõtte aruannete standardvorming)"

msgid "mime_libreoffice"
msgstr "LibreOffice dokument (The Document Foundation töötas välja 2010. aastal, OpenOffice'i haru, ODF-i standardi teostus, peamine avatud lähtekoodiga kontoritarkvarapakett)"

msgid "mime_encrypt"
msgstr "Krüpteeritud fail (vaatamiseks on vaja dekrüptida, levinud laiendid: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS-i raja andmed (GPS-i vahetusvorming, salvestab geograafilise asukoha teavet, universaalne vorming spordikellade ja navigatsiooniseadmete jaoks)"

msgid "mime_diskimage"
msgstr "Ketta kujutis (DMG, ISO, IMG jne, ketta/CD-kujutise failid, mida kasutatakse tarkvara levitamiseks või salvestusmeediumi varundamiseks)"

msgid "mime_vm"
msgstr "Virtuaalmasina kujutis (VMDK, VDI, VHDX, OVA jne, virtuaalketta failid, vormingud virtualiseerimisplatvormidele nagu VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrenti torrentifail (Bram Cohen leiutas 2001. aastal, P2P indeksifail allalaadimiseks, sisaldab faili metaandmeid ja Trackeri teavet)"

msgid "mime_gis"
msgstr "GIS-i georuumilised andmed (georuumilised andmevormingud nagu Shapefile, GeoJSON, mida kasutatakse kaartide ja ruumianalüüsi jaoks)"

msgid "mime_ebook"
msgstr "E-raamat (e-raamatu vormingud nagu EPUB, MOBI, AZW. EPUB on rahvusvaheline standard, MOBI/AZW on Amazon Kindle'i vormingud)"

msgid "mime_avif"
msgstr "AVIF-pilt (Alliance for Open Media tutvustas 2019. aastal, põhineb AV1 koodekil, tihendusaste on 50% kõrgem kui WebP-l, uus veebipildi standard)"

msgid "mime_markdown"
msgstr "Markdowni dokument (John Gruber kujundas 2004. aastal, kerge märgistuskeel, universaalne vorming GitHub README, tehnilise dokumentatsiooni, foorumite jaoks)"

msgid "mime_yaml"
msgstr "YAML-konfiguratsioon (Clark Evans kujundas 2001. aastal, inimese loetav andmete serialiseerimise vorming, standardne konfiguratsioonifaili vorming Kubernetes, Ansible, Docker Compose jaoks)"

msgid "mime_toml"
msgstr "TOML-konfiguratsioon (Tom Preston-Werner kujundas 2013. aastal, 'Tom's Obvious Minimal Language', konfiguratsioonifaili vorming kaasaegsete tööriistade jaoks nagu Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue komponendi fail (Evan You loodud 2014. aastal, progressiivne JavaScripti raamistik. Ühefaililiste komponentide (SFC) kaudu ühendab see suurepäraselt HTML-i, CSS-i ja JS-i, suurendades oluliselt arenduse tõhusust. See on üks maailma populaarsemaid frontendi raamistikke. Samuti kasutatakse seda laialdaselt kaasaegsete staatiliste saidigeneraatorite (nt VitePress) tuumana interaktiivse tehnilise dokumentatsiooni ja blogide loomiseks.)"

msgid "mime_wasm"
msgstr "WebAssembly moodul (W3C standard 2017, kõrge jõudlusega vorming brauseris, C/C++/Rust/R saab sellesse kompileerida, jõudlus lähedane algkoodile)"

msgid "mime_jsx"
msgstr "React JSX komponent (Facebook tutvustas JavaScript XML-i 2013. aastal, Reacti raamistiku komponendi süntaks, uuenduslik paradigma HTML-i kirjutamiseks JavaScripti sees)"

msgid "mime_tsx"
msgstr "TypeScript TSX komponent (Microsoft töötas välja 2012. aastal, TypeScript + JSX, standardne viis Reacti rakenduste arendamiseks tüübiohutusega)"

msgid "mime_heif"
msgstr "HEIF-pilt (MPEG standard 2015, tõhus pildifaili vorming, mida kasutatakse laialdaselt Apple'i ökosüsteemis)"

msgid "mime_heic"
msgstr "HEIC-pilt (Apple'i HEIF-i teostus, iPhone'i vaikimisi pildivorming, natiivne tugi iOS/macOS-is)"

msgid "mime_gltf"
msgstr "GLTF 3D mudel (GL-i edastusvorming, '3D-maailma JPEG', avaldas Khronos Group 2015. aastal, veebi 3D standardvorming)"

msgid "mime_glb"
msgstr "GLB kahend 3D mudel (GLTF-i kahendversioon, üks fail sisaldab kõiki ressursse, mida kasutatakse 3D-stseeni levitamiseks)"

msgid "mime_gls"
msgstr "GLOSSARY sõnastik (termini määratluse fail, mida kasutatakse terminite haldamiseks dokumendisüsteemides)"

msgid "mime_cbz"
msgstr "CBZ koomiksiraamat (ZIP-ga tihendatud koomiksipildid, universaalne vorming koomiksite kogujatele)"

msgid "mime_cbr"
msgstr "CBR koomiksiraamat (RAR-ga tihendatud koomiksipildid, universaalne vorming koomiksite kogujatele)"

msgid "mime_fb2"
msgstr "FB2 e-raamat (FictionBook 2.0, vene e-raamatu vorming, XML-struktuur, laialdaselt toetatud avatud lähtekoodiga lugejate poolt)"

msgid "mime_kepub"
msgstr "KEPUB e-raamat (Kobo spetsiaalne EPUB-vorming, optimeeritud vorming Kobo e-raamatute lugejate jaoks)"

msgid "mime_m4b"
msgstr "M4B audioraamat (MPEG-4 heliraamatu vorming, toetab järjehoidjaid, iTunesi audioraamatu vorming)"

msgid "mime_kfx"
msgstr "Kindle KFX vorming (Amazon tutvustas 2015. aastal, Kindle'i spetsiaalne e-raamatuvorming, toetab täiustatud tüpograafiat ja kiiret lehekülgede pööramist)"

msgid "mime_chm"
msgstr "CHM abifail (Microsoft tutvustas 1997. aastal, kompileeritud HTML-i abivorming, standard Windowsi tarkvara abidokumentatsiooni jaoks)"

msgid "mime_mht"
msgstr "MHT veebiarhiiv (Microsoft tutvustas 1999. aastal, ühefaili veebilehe vorming, veebilehe salvestamise vorming IE-brauseris)"

msgid "mime_wml"
msgstr "WML (Wireless Markup Language, WAP-i standard 1999, mida kasutati vanade funktsioonidega telefonide veebilehtede jaoks, kasutusest kõrvaldatud)"

msgid "mime_xhtml"
msgstr "XHTML veebileht (W3C standard 2000, HTML-i XML-versioon, rangem süntaks. W3C lõpetas hoolduse 2009. aastal, keskendus HTML5-le)"

msgid "mime_xml"
msgstr "XML-dokument (W3C standard 1998, laiendatav märgistuskeel, põhivorming veebiteenuste, konfiguratsioonifailide, andmevahetuse jaoks)"

msgid "mime_sgml"
msgstr "SGML-dokument (ISO standard 1986, HTML-i eelkäija, Standardne üldine märgistuskeel, XML ja HTML pärinevad SGML-ist)"

msgid "mime_apng"
msgstr "APNG animatsioon (Mozilla töötas välja 2004. aastal, PNG laiendus animatsiooni jaoks, kaasaegne asendus GIF-ile, toetab tõelisi värve ja läbipaistvust)"

msgid "mime_bmp"
msgstr "BMP-bitmap (Windowsi bitmapi vorming, natiivne tugi alates Windows 1.0-st. Tihendamata, suured failimahud, kuid lihtsa struktuuri ja täiendavate koodekite puudumise tõttu kasutavad Windows 11 ekraanipildi tööriist, joonistusprogramm, ikoonide ressursid EXE/MSI installipakettides, kursori failid ja mõned vanad draiverid seda endiselt. Sama pildikvaliteedi korral on fail umbes 3-10 korda suurem kui PNG, enamikus stsenaariumides on selle asendanud PNG/JPEG, kuid Windowsi ökosüsteem säilitab endiselt laia ühilduvuse)"

msgid "mime_cdr"
msgstr "CDR vektorgraafika (CorelDRAW-i spetsiaalne vorming, Corel Corporation Kanadast, vektorgraafika disaini tarkvara)"

msgid "mime_gif"
msgstr "GIF-pilt (CompuServe töötas välja 1987. aastal, 256-värviga animatsioonivorming. Puudused: piiratud värvide arv, krobeline pildikvaliteet, ei toeta läbipaistvust, suured failid, madal kaadrisagedus. Asendatud kaasaegsete animatsioonivormingutega nagu APNG, WebP)"

msgid "mime_ico"
msgstr "ICO-ikoon (Windowsi ikoonifaili vorming, toetab mitut eraldusvõimet, veebilehe faviconi standardvorming)"

msgid "mime_jpeg"
msgstr "JPEG-pilt (ISO standard 1992, kadudega tihendusvorming fotode jaoks, de facto standard fotode jaoks Internetis)"

msgid "mime_jpg"
msgstr "JPEG-pilt (ISO standard 1992, kadudega tihendusvorming fotode jaoks, de facto standard fotode jaoks Internetis)"

msgid "mime_png"
msgstr "PNG-pilt (W3C soovitus 1996, toetab tõelisi värve ja läbipaistvust, staatiline asendus GIF-ile, kadudeta pildi standard Internetis)"

msgid "mime_ps"
msgstr "PostScripti lehekirjelduse fail (Adobe tutvustas 1985. aastal, lehekirjelduse keel, PDF-i eelkäija, mida kasutatakse trükkimiseks ja kirjastamiseks)"

msgid "mime_psb"
msgstr "PSB suur dokument (Adobe Photoshopi vorming ülisuurte piltide jaoks, toetab pilte, mis on suuremad kui 2 GB või 30000 pikslit)"

msgid "mime_psd"
msgstr "PSD-pilt (Adobe Photoshopi lähtefail, toetab kihte, kanaleid, teid, pilditöötluse tööstusharu standardvorming)"

msgid "mime_webp"
msgstr "WebP-pilt (Google töötas välja 2010. aastal, veebipildi vorming, toetab kadudega/kadudeta tihendust ja animatsiooni, tihendusaste on 25-35% kõrgem kui PNG-l ja 25% kõrgem kui JPEG-il)"

msgid "mime_woff"
msgstr "WOFF veebifont (loodud 2009. aastal, W3C standard 2018. Põhineb TrueType/OpenType tihendusel, veebifontide laadimise optimeerimine, standardvorming ikoonifontide jaoks kaasaegsetel veebilehtedel)"

msgid "mime_7z"
msgstr "7z tihendatud pakett (Igor Pavlov töötas välja 1999. aastal, 7-Zipi programmi spetsiaalne vorming. LZMA algoritm, kõrge tihendusaste, avatud lähtekoodiga ja tasuta. 7z-vorming on sama tihendusastme korral tavaliselt 30-50% väiksem kui ZIP, tavaline vorming avatud lähtekoodiga kogukonnas ja tarkvara levitamisel)"

msgid "mime_ace"
msgstr "ACE tihendatud pakett (välja töötatud 1990ndatel, WinACE programmi vorming. Konkureeris kunagi RAR-iga, suhteliselt kõrge tihendusaste. Arendus lõpetati 2007. aastal, praegu on selle asendanud 7z/RAR, harva kasutatav)"

msgid "mime_bz2"
msgstr "BZIP2 tihendatud pakett (Julian Seward töötas välja 1996. aastal, plokkide sorteerimise tihendusalgoritm. Tihendusaste on 15-20% kõrgem kui GZIP-il, kuid kiirus on aeglasem. Levinud vorming Linuxi kerneli lähtekoodi, avatud lähtekoodiga tarkvarapakettide jaoks, laiend .bz2)"

msgid "mime_cab"
msgstr "CAB tihendatud pakett (Microsoft töötas välja 1995. aastal, Cabineti vorming. Installipaketi vorming Windowsi jaoks, mida kasutatakse draiverite ja süsteemifailide levitamiseks. Windows Installer (MSI) kasutab CAB-i sisemiselt failide salvestamiseks)"

msgid "mime_dmg"
msgstr "DMG ketta kujutis (Apple tutvustas 1980ndatel, Disk Image vorming. macOS-i tarkvara levitamise standardvorming, topeltklõpsuga ühendub virtuaalkettana, lohistades rakenduse installimiseks. Toetab tihendamist ja krüptimist, Maci tarkvara allalaadimise peamine vorming)"

msgid "mime_emz"
msgstr "EMZ tihendatud pilt (Windowsi tihendatud Enhanced Metafile, EMF-i tihendatud versioon. Vektorgraafika salvestamise vorming Office'i dokumentides, sisuliselt on see GZIP-ga tihendatud EMF-fail)"

msgid "mime_gz"
msgstr "GZIP tihendatud pakett (Jean-loup Gailly ja Mark Adler töötasid välja 1992. aastal, GNU projekt. Standardne tihendustööriist Unix/Linuxi süsteemides, tavaline vorming HTTP tihendamiseks edastamisel. Laiend .gz, sageli kasutatakse koos TAR-iga)"

msgid "mime_jar"
msgstr "JAR tihendatud pakett (Sun Microsystems tutvustas 1997. aastal, Java ARchive vorming. Sisuliselt on see ZIP-tihendatud pakett, mida kasutatakse Java klasside ja rakenduste pakkimiseks. Põhivorming Java ökosüsteemis nagu Maven, Gradle, Android kasutab samuti JAR-i)"

msgid "mime_lzma"
msgstr "LZMA tihendatud pakett (Igor Pavlov töötas välja 1998. aastal, Lempel-Ziv-Markov ahela algoritm. 7z-vormingu peamine tihendusalgoritm, kõrge tihendusaste, kiire dekompressioon. Kasutatakse püsivara ja sisseehitatud süsteemide tarkvara levitamiseks)"

msgid "mime_rar"
msgstr "RAR tihendatud pakett (Eugene Roshal töötas välja 1993. aastal, Roshal ARchive vorming. Kõrge tihendusaste, toetab köidete jagamist ja taastekirjet. WinRAR programmi vorming, tihendusaste on parem kui ZIP-il, kuid vajab tasulist tarkvara, avatud lähtekoodiga tööriistad nagu unrar saavad dekompressioonida)"

msgid "mime_tar"
msgstr "TAR arhiivipakett (tutvustati Unix V7-s 1979. aastal, Lindi arhiivi vorming. Lindi arhiivi vorming, ainult pakkimine ilma tihenduseta, sageli kasutatakse koos GZIP/BZIP2/XZ-ga. Linuxi tarkvarapaketi lähtekood, Dockeri pildi kihiline ladustamine kasutab TAR-vormingut)"

msgid "mime_tgz"
msgstr "TGZ tihendatud pakett (TAR + GZIP vormingu kombinatsioon, laiend .tgz või .tar.gz. Unix/Linuxi tarkvarapakettide kõige universaalsem levitamise vorming, mida kasutatakse laialdaselt lähtekoodi ja binaarpakettide jaoks, 'paki lahti ja kasuta' kontseptsiooni esindaja)"

msgid "mime_tbz2"
msgstr "TBZ2 tihendatud pakett (TAR + BZIP2 vormingu kombinatsioon, laiend .tbz2 või .tar.bz2. Tihendusaste on 15-20% kõrgem kui TGZ-il, sobib suurte failide levitamiseks, Linuxi kerneli lähtekood on seda vormingut pikka aega kasutanud)"

msgid "mime_xz"
msgstr "XZ tihendatud pakett (tutvustati 2009. aastal, põhineb LZMA2 algoritmil. Äärmiselt kõrge tihendusaste, 30-50% kõrgem kui GZIP-il, dekompressiooni kiirus suhteliselt kiire. Seda kasutatakse laialdaselt Linuxi kerneli, paketihaldurite (nagu Debiani .deb paketi sisemine struktuur), soovitatav vorming tänapäeva Linuxi ökosüsteemis)"

msgid "mime_z"
msgstr "Z tihendatud pakett (Unixi compress käsuvorming aastast 1985, LZW algoritm. Varajane Unixi tihendusvorming, mille on asendanud GZIP. Laiend .Z, kaasaegsetes süsteemides harva kasutatav)"

msgid "mime_zip"
msgstr "ZIP tihendatud pakett (Phil Katz töötas välja 1989. aastal, PKZIP vorming. Windows toetab seda natiivselt, kõige universaalsem tihendusvorming Internetis. Toetab mitut faili, kataloogistruktuuri, saab valida tihendusalgoritmi. Java JAR, Android APK, Office'i dokumentide DOCX/XLSX põhinevad ZIP-vormingul)"

msgid "mime_zst"
msgstr "Zstandard tihendatud pakett (Facebook töötas välja 2015. aastal, kujundas Yann Collet. Suure kiirusega tihendusalgoritm, tihendusaste LZMA lähedal, kiirus palju suurem kui GZIP-il. Linuxi kernel 5.9+ toetab seda, Arch Linux pacman, Debian APT võtavad seda järk-järgult kasutusele, uue põlvkonna tihendusstandard)"

msgid "mime_lz4"
msgstr "LZ4 tihendatud pakett (Yann Collet töötas välja 2011. aastal, ülikiire tihendusalgoritm. Tihenduskiirus on üle 10 korra suurem kui GZIP-il, sobib reaalajas tihendamise stsenaariumideks. Seda kasutatakse laialdaselt Linuxi kerneli, OpenZFS, Hadoop, kiiruse prioriteediga stsenaariumide esimene valik)"

msgid "mime_lzo"
msgstr "LZO tihendatud pakett (Markus Oberhumer töötas välja 1996. aastal, Lempel-Ziv-Oberhumer algoritm. Ülikiire dekompressioon, keskmine tihendusaste. Linuxi kernel Squashfs, OpenWrt püsivara kasutavad seda, sobib sisseehitatud süsteemide jaoks)"

msgid "mime_msi"
msgstr "MSI installipakett (Microsoft tutvustas 1999. aastal, Windows Installeri paketivorming. Windowsi rakenduste standardne installivorming, toetab tehingu tagasipööramist, komponentide haldamist, vaikset installimist. Ettevõtte tarkvara levitamise esimene valik, endiselt Windowsi tarkvara installimise peamine vorming tänapäeval)"

msgid "mime_pkg"
msgstr "PKG installipakett (macOS-i rakenduse installivorming, põhineb Apple'i Installeri tehnoloogial. macOS-i tarkvara levitamise standardvorming, toetab komponentide valikut, installiskripte, desinstallimise funktsiooni. .pkg-faili saab installida topeltklõpsuga, Maci tarkvara tavaline levitamise viis väljaspool Mac App Store'i)"

msgid "mime_apk"
msgstr "APK Androidi rakenduse pakett (Google tutvustas 2008. aastal, Androidi süsteemi traditsiooniline installivorming. APK on sisuliselt ZIP-tihendatud pakett, sisaldab koodi, ressursse, manifestifaili. Alates 2021. aastast nõuab Google Play, et uued rakendused kasutaksid AAB-vormingut, kuid APK-d kasutatakse endiselt arendamiseks, silumiseks, levitamiseks kolmandate osapoolte poodide kaudu ja külgpaigalduseks)"

msgid "mime_ipa"
msgstr "IPA Apple'i rakenduse pakett (iOS App Store Package, installivorming iOS/iPadOS rakenduste jaoks. Tutvustati 2008. aastal koos iPhone SDK-ga. Nõuab levitamist App Store'i kaudu või ettevõtte sertifikaadiga allkirjastamist. Sisaldab käivitatavat faili, ressursse, allkirjastatud teavet Info.plist-is)"

msgid "mime_hap"
msgstr "HAP HarmonyOS rakenduse pakett (HarmonyOS Ability Package, HarmonyOS rakenduse põhiüksus. Tutvustati koos HarmonyOS 2.0-ga 2020. aastal. Toetab entry ja feature tüüpe, levitamise vorming Huawei telefonide, tahvelarvutite, nutikellade ja muude HarmonyOS-seadmete jaoks)"

msgid "mime_har"
msgstr "HAR HarmonyOS staatiline jagatud pakett (HarmonyOS Archive, staatiline jagatud teek HarmonyOS-i jaoks, mida saab jagada mitme HAP-i vahel, mida kasutatakse komponentide arendamiseks ja moodulite taaskasutamiseks)"

msgid "mime_aab"
msgstr "Android App Bundle (Google tutvustas 2018. aastal, alates 2021. aastast nõuab Google Play, et uued rakendused kasutaksid seda vormingut. AAB on levitamise vorming, Google Play genereerib dünaamiliselt optimeeritud APK-d seadme konfiguratsiooni (protsessori arhitektuur, ekraani tihedus, keel) alusel, installipaketi keskmine suurus on vähenenud 35%. Arendajad laadivad üles AAB-i, kasutajad laadivad alla APK-d)"

msgid "mime_xapk"
msgstr "XAPK rakenduse pakett (kolmanda osapoole laiendatud Androidi rakenduse pakett, sisaldab APK + OBB andmefaili. Kasutatakse suurte mängude ja keerukate rakenduste jaoks, lahendab ühe APK-faili 100 MB piirangu. Levinud kolmandate osapoolte rakenduste poodides nagu APKPure, APKMirror, ei ole Google'i ametlik vorming)"

msgid "mime_appx"
msgstr "Windowsi rakenduse pakett (Microsoft tutvustas 2012. aastal, installivorming Windows 8/10/11 rakenduste jaoks. Toetab UWP-d ja töölauarakenduste teisendamist, levitatakse Microsoft Store'i kaudu. Microsoft tutvustas 2024. aastal MSIX-i järglase vorminguna, asendab järk-järgult APPX-i)"

msgid "mime_msix"
msgstr "MSIX rakenduse pakett (Microsoft tutvustas 2018. aastal, uus Windowsi rakenduste pakkimise vorming. Ühendab APPX-i ja MSI-i eelised, toetab kõiki Windowsi rakenduste tüüpe, saab levitada Microsoft Store'i kaudu või külgpaigaldada, soovitatav vorming Windows 11 jaoks)"

msgid "mime_appimage"
msgstr "AppImage rakenduse pakett (tutvustati 2004. aastal, Linuxi installivaba rakenduse vorming. 'Üks rakendus = üks fail', töötab otse ilma installimata, toetab enamikku Linuxi distributsioone, tavaline viis arendajatele Linuxi tarkvara levitamiseks)"

msgid "mime_flatpak"
msgstr "Flatpak rakenduse pakett (tutvustati 2015. aastal, Linuxi liivakastiga rakenduse vorming. Töötab distributsioonide vahel, isoleeritud süsteemi keskkonnast, töötasid välja Fedora, Red Hat, vaikevorming GNOME Software keskuses)"

msgid "mime_snap"
msgstr "Snap rakenduse pakett (Canonical tutvustas 2014. aastal, töötas välja Ubuntu emaettevõte, Linuxi universaalne rakenduse vorming. Automaatne uuendamine, liivakasti isolatsioon, toetab 40+ Linuxi distributsiooni, vaikevorming Ubuntu Software keskuses)"

msgid "mime_deb"
msgstr "Debiani tarkvarapakett (Debiani projekt tutvustas 1993. aastal, standardne installivorming Debian/Ubuntu ja nende tuletiste jaoks. Seda haldab dpkg, APT on selle eesotsas olev paketihaldur, üks küpsemaid paketivorminguid Linuxi ökosüsteemis, endiselt Debiani perekonna peamine vorming)"

msgid "mime_rpm"
msgstr "RPM tarkvarapakett (Red Hat tutvustas 1997. aastal, standardvorming Red Hat/Fedora/CentOS/SUSE ja teiste distributsioonide jaoks. RPM tähistab 'Red Hat Package Manager', koos DEB-iga on see üks kahest suurest paketivormingust Linuxis, endiselt RHEL-i perekonna peamine vorming)"

msgid "mime_pacman"
msgstr "Archi tarkvarapakett (Arch Linux tutvustas 2002. aastal, pacman paketihalduri poolt kasutatav .pkg.tar.zst vorming. Veereva väljalaskega Arch Linuxi tuum, tuntud oma lihtsuse ja KISS-põhimõtte poolest, AUR (Arch User Repository) on selle eripära)"

msgid "mime_exe"
msgstr "EXE-käivitatav fail (Windowsi käivitatav programmivorming, lühend sõnast 'Executable'. Windowsi operatsioonisüsteemi algne käivitatav vorming, sisaldab PE-struktuuri. Arenes välja MS-DOS-i MZ-vormingust, PE (Portable Executable) vorming tutvustati Windows NT-ga 1993. aastal ja seda kasutatakse siiani. Tarkvara installipaketid, rakendused, süsteemi tööriistad kasutavad seda vormingut. Kasutaja topeltklõpsab selle käivitamiseks, kõige laialdasemalt kasutatav käivitatav vorming maailmas)"

msgid "mime_dll"
msgstr "DLL dünaamiline lingiteek (Microsoft tutvustas 1993. aastal, Dynamic Link Library. Windowsi jagatud koodi teek, mis laaditakse dünaamiliselt programmi käivitamisel, säästab mälu ja kettaruumi. Süsteemi komponendid, rakenduste pistikprogrammid, draiverid kasutavad DLL-vormingut. Windowsi API peamine rakendusviis, 'DLL Hell' probleemi on .NET-i ajastul leevendatud)"

msgid "mime_com"
msgstr "COM-käivitatav fail (käivitatav vorming MS-DOS-i ajastust, lühend sõnast 'Command'. Lihtne failistruktuur, 64 KB piirang, peamine vorming enne Windows 3.x-i. Kasutusest kõrvaldatud, kaasaegne Windows kasutab EXE-vormingut, COM-laiendit kasutatakse endiselt mõne komponendifaili jaoks)"

msgid "mime_aac"
msgstr "AAC-heli (MPEG standard 1997, Advanced Audio Coding. MP3 järeltulija, helikvaliteet on parem kui MP3-l sama bitikiiruse juures, vaikimisi helivorming YouTube'i, iTunes'i, Nintendo Switchi jaoks)"

msgid "mime_alac"
msgstr "ALAC-heli (Apple töötas välja 2004. aastal, Apple Lossless Audio Codec. Apple'i kadudeta vorming, muutus avatud lähtekoodiliseks 2011. aastal, vaikimisi kadudeta helivorming iTunes'is ja Apple Musicus)"

msgid "mime_flac"
msgstr "FLAC-heli (Xiph.Org Foundation töötas välja 2001. aastal, Free Lossless Audio Codec. Kadudeta tihendus, helikvaliteet on sama, mis CD-l, fail on umbes poole väiksem kui originaalne WAV. Avatud lähtekoodiga ja patendivaba, esimene valik audiofiilidele ja digitaalse muusika kogujatele)"

msgid "mime_mp3"
msgstr "MP3-heli (Fraunhofer Institute töötas välja 1993. aastal, MPEG-1 Audio Layer 3. Kadudega tihendusvorming, väikesed failid mõistliku helikvaliteediga, oli 2000. aastate digitaalse muusika revolutsiooni peamine vorming, vastutab iPod ja Napster. Patent aegus 2017. aastal, muutudes avalikuks omandiks)"

msgid "mime_oga"
msgstr "Ogg Audio heli (Xiph.Org Foundation töötas välja, Ogg konteineri puhas helivorming, kasutab Vorbis koodekit. Avatud lähtekoodiga ja patendivaba, tihenduse tõhusus on parem kui MP3-l, mida kasutatakse laialdaselt avatud lähtekoodiga projektides)"

msgid "mime_ogg"
msgstr "OGG-heli (Xiph.Org Foundation töötas välja 2000. aastal, Ogg Vorbis vorming. Avatud lähtekoodiga ja patendivaba, tihenduse tõhusus on parem kui MP3-l, seda kasutas varakult Spotify, mida kasutatakse laialdaselt heliefektide jaoks mängudes)"

msgid "mime_opus"
msgstr "Opus-heli (IETF standardiseeris 2012. aastal, avatud lähtekoodiga ja patendivaba. Ühendab SILK ja CELT tehnoloogiad, äärmiselt madal latentsusaeg, kõrgeim tihenduse tõhusus, vaikimisi helivorming WebRTC, WhatsApp, Discord jaoks)"

msgid "mime_wav"
msgstr "WAV-heli (Microsoft ja IBM töötasid välja 1991. aastal, Windowsi algne helivorming. PCM-kodeering ilma tihenduseta, veatu kvaliteet, kuid failid on tohutud, standardvorming professionaalseks helitöötluseks)"

msgid "mime_wma"
msgstr "WMA-heli (Microsoft töötas välja 1999. aastal, Windows Media Audio. Sellel on kadudega ja kadudeta versioonid, Windows toetab seda natiivselt, populaarseks sai koos Windows Media Playeriga. Tänapäeval on see marginaalne, asendatud MP3/AAC-ga)"

msgid "mime_dsf"
msgstr "DSF-heli (Direct Stream Digital vorming, töötasid välja Sony ja Philips. 1-bitine kõrge diskreetimissagedus, DSD-heli standardvorming, SACD digitaalversioon, tipptasemel helivorming audiofiilidele, tohutud failid)"

msgid "mime_ape"
msgstr "APE Heli (Monkey's Audio poolt 2000. aastal loodud, kadudeta pakkimisvorming. Kõrgem pakkimissuhe kui FLAC-il, kuid aeglasem kodeerimine, kasutusel endiselt Windowsi platvormil ja audioentusiastide seas)"

msgid "mime_mid"
msgstr "MIDI-heli (MIDI Association kehtestas standardi 1983. aastal, Musical Instrument Digital Interface. Noodikirja formaat, mitte salvestus, äärmiselt väikesed failid, standard elektrooniliste muusikainstrumentide, mobiiltelefonide helinate, heliefektide jaoks mängudes. General MIDI standardiseeriti 1991. aastal, määratleb 128 instrumenti)"

msgid "mime_m4a"
msgstr "M4A-heli (MPEG-4 Audio, AAC konteinerivorming. Standardvorming iTunes Music Store'i jaoks, peamine helivorming Apple'i ökosüsteemis, toetab DRM-kaitset)"

msgid "mime_m3u"
msgstr "M3U esitusloend (MP3 URL-ide esitusloendi vorming, tavaline tekstifail, salvestab helifailide teed. Standard Winampi ajastust, mida kasutatakse Interneti-raadio, veebimuusika voogedastuse jaoks. M3U8 on selle UTF-8 versioon, mida kasutatakse HTTP Live Streamingi jaoks)"

msgid "mime_asf"
msgstr "ASF voogedastusmeedia (Microsoft töötas välja 1996. aastal, Advanced Systems Format. Windows Media voogedastuse konteiner, toetab sünkroniseeritud heli ja video edastamist. Kasutatakse otseülekannete ja video nõudmisel voogedastuse jaoks, WMA/WMV põhinevad ASF-konteineril)"

msgid "mime_avi"
msgstr "AVI-video (Microsoft tutvustas 1992. aastal, varajane Windowsi videostandard. 'Audio Video Interleave', heli ja video on põimitud, oli kõige populaarsem video vorming 1990ndatel ja 2000ndatel, tänapäeval on selle asendanud MP4/MKV)"

msgid "mime_divx"
msgstr "DivX-video (DivX ettevõte töötas välja 1998. aastal, MPEG-4 põhinev videokoodek. Oli peamine vorming Internetis videote jagamiseks 2000ndatel, esimene, mis võimaldas DVD-kvaliteedi tihendamise CD-suurusele. Autoriõiguse vaidluste tõttu muudeti hiljem kaubanduslikuks koodekiks)"

msgid "mime_mp4"
msgstr "MP4-video (MPEG standard 2001, MPEG-4 Part 14. Maailma kõige universaalsem videovorming, toetab H.264/H.265 kodeeringut, vaikimisi vorming Interneti-video, mobiiltelefoniga salvestamise, YouTube'i jaoks)"

msgid "mime_m4v"
msgstr "M4V-video (iTunesi videovorming, MP4 variant. Videovorming Apple'i ökosüsteemis, standardvorming filmide ja telesaadete jaoks iTunes Store'is, toetab DRM-autoriõiguse kaitset)"

msgid "mime_mpeg"
msgstr "MPEG-video (MPEG organisatsioon kehtestas standardi 1988. aastal, Moving Picture Experts Group. Digitaalse videotihenduse peamised standardid, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (Interneti-video) on olnud sügava mõjuga)"

msgid "mime_mkv"
msgstr "MKV-video (Matroska projekt töötas välja 2002. aastal, avatud lähtekoodiga multimeedia konteinerivorming. Toetab mitut heliriba, mitut subtiitrite rada, peatükke, 'võimeline pakkima kõike', esimene valik kõrglahutusega filmide jagamiseks)"

msgid "mime_mpg"
msgstr "MPEG-video (MPEG-1/MPEG-2 video laiend, standardvorming VCD ja DVD jaoks. Oli peamine vorming videote jaoks CD-del 1990ndatel ja 2000ndatel, tänapäeval on selle asendanud H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video video (Xiph.Org Foundation töötas välja, Ogg konteineri video vorming, kasutab Theora koodekit. Avatud lähtekoodiga ja patendivaba, oli üks varajasi standardeid HTML5-video jaoks, Firefox toetab seda natiivselt)"

msgid "mime_ogx"
msgstr "Ogg multimeedia konteiner (Xiph.Org Foundation töötas välja, Ogg konteineri universaalne laiendus, võib sisaldada mitut rada nagu heli, video, subtiitrid. Avatud lähtekoodiga multimeedia standard, mida kasutatakse mängudes ja voogedastuses)"

msgid "mime_rm"
msgstr "RealMedia video (RealNetworks töötas välja 1995. aastal, RealMedia vorming. Oli Interneti voogedastuse pioneer 1990ndatel ja 2000ndatel, RealPlayeri põhivorming. Puudused: vajab spetsiaalset mängijat, halb tihenduskvaliteet, asendatud Flash/MP4-ga)"

msgid "mime_flv"
msgstr "Flashi video (vorming ilmus 2002. aastal, Flashi video vorming. Oli kunagi Interneti-video peamine vorm, mida kasutas varakult YouTube. Puudused: vajab Flashi pistikprogrammi, halb jõudlus, palju turvaauke. Alates 2015. aastast läksid peamised veebisaidid üle HTML5-videole, tänapäeval on see kasutusest kõrvaldatud)"

msgid "mime_f4v"
msgstr "F4V video (Adobe'i välja töötatud Flashi videovorming, FLV järeltulija. Põhineb MPEG-4 standardil, toetab H.264 kodeeringut. Koos Flashi tehnoloogiaga kasutusest kõrvaldatud, Adobe lõpetas toe 2020. aastal)"

msgid "mime_wmv"
msgstr "WMV video (Microsoft töötas välja 1999. aastal, Windows Media Video. Windows toetab seda natiivselt, optimeeritud voogedastuse edastamiseks, oli tavaline vorming veebivideote jaoks 2000ndatel, tänapäeval on see marginaalne)"

msgid "mime_wmf"
msgstr "WMF meedia vorming (Windows Media Format, Microsofti meediumiraamistik. Sisaldab WMV videot, WMA heli, Windows Media Player toetab seda natiivselt)"

msgid "mime_mov"
msgstr "MOV video (Apple töötas välja 1991. aastal, QuickTime konteinerivorming. Standardvorming professionaalseks video redigeerimiseks, toetab mitut koodekit, Final Cut Pro, Premiere toetavad seda natiivselt)"

msgid "mime_qt"
msgstr "QuickTime video (Apple tutvustas 1991. aastal, QuickTime vorming. Standard Maci platvormi video jaoks, MOV on selle konteiner, QuickTime'i mängijat kasutati laialdaselt. Apple lõpetas Windowsi versiooni arendamise 2016. aastal, asendatakse järk-järgult MP4-ga)"

msgid "mime_webm"
msgstr "WebM video (Google tutvustas 2010. aastal, avatud lähtekoodiga ja patendivaba. Põhineb Matroska konteineril, VP8/VP9 kodeering, HTML5-video standardvorming, YouTube'i veebiesitaja vaikimisi vorming)"

msgid "mime_3gp"
msgstr "3GP video (3GPP kehtestas 2000. aastal, mobiilseadme video vorming. Äärmiselt väikesed failid, madal kvaliteet, vorming salvestamiseks vanade funktsioonidega telefonides, kasutati MMS-i kaudu saatmiseks)"

