#------------------------------------------------------------------------------
# Formatbeskrivelser
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstfil (ASCII-standardisering i 1963, uformatert ren tekst. Grunnlaget for all kildekode, konfigurasjon og logger. Unix bruker LF, Windows bruker CRLF for linjeskift, fortsatt det mest universelle dataformatet i datamaskiner)"

msgid "mime_log"
msgstr "Loggfil (ren tekstfil som registrerer informasjon om system- og applikasjonsdrift, ofte brukt for feilsøking, ytelsesanalyse og sikkerhetsrevisjon. Standardformater som Apache combined log, Nginx access log, syslog osv.)"

msgid "mime_page"
msgstr "HTML-nettside (Tim Berners-Lee oppfant WWW i 1989, definerte HTML/HTTP/URL-teknologiene i 1990, ga dem ut gratis uten patent. I 2014 ble HTML5 en offisiell W3C-standard, støtter visning, multimedia og utskrift. Vant Turing-prisen i 2016)"

msgid "mime_khtml"
msgstr "KHTML nettsidemotor (KDE 2.0 ble utgitt i 1998, Konqueror-nettleserens gjengivelsesmotor. I 2001 laget Apple WebKit basert på KHTML, i 2008 opprettet Google Blink fra WebKit, som ble kjernen i Chrome, Edge, Safari og andre nettlesere. KHTML er et eksempel på hvordan åpen kildekode-samfunnet la grunnlaget for moderne nettlesermotorer, dets teknologiske arv fortsetter gjennom WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamisk skript (tolket språk, trenger ikke kompilering. Inkluderer ASP, JSP, CGI, ColdFusion, Tcl, VBScript osv., mye brukt i tidlig nettutvikling, systemadministrasjon, automatisering av oppgaver. Moderne skriptspråk som Python, Ruby, JavaScript har utviklet seg til hovedverktøy for fullstack-utvikling)"

msgid "mime_js"
msgstr "JavaScript-skript (Brendan Eich laget det på 10 dager i Netscape i 1995, nettlesernes opprinnelige programmeringsspråk. I 1997 ble ECMAScript standardisert, i 2009 ble Node.js født og gjorde det til et fullstackspråk, npm er den største pakkeansvarlige i verden. Flere år på rad det mest populære programmeringsspråket på GitHub)"

msgid "mime_py"
msgstr "Python-skript (skapt av Guido van Rossum i 1991, kjent for tvungen innrykk og ren syntaks. Mye brukt i nettutvikling, datavitenskap, kunstig intelligens, automatisert drift. Vant TIOBEs programmeringsspråk-år flere ganger)"

msgid "mime_sh"
msgstr "Shell-skript (Unix ble født i 1971, kommandoskriftspråk. Brukes til systemadministrasjon, automatisering av oppgaver, oppstart av tjenester, utplasseringsskript. Grunnleggende ferdighet for Linux-administratorer)"

msgid "mime_rb"
msgstr "Ruby-skript (skapt av Yukihiro Matsumoto i 1995, fokuserer på utviklerens lykke. Ruby on Rails-rammeverket introduserte konvensjon fremfor konfigurasjon-paradigmet, påvirket designet av moderne nettrammeverk)"

msgid "mime_pl"
msgstr "Perl-skript (skapt av Larry Wall i 1987, kjent for sin praktiske tilnærming, kalt \"sveitsisk hærkniv\". CPAN var pioneren for moderne pakkeansvarlige, hadde stor innflytelse innen tekstbehandling, systemadministrasjon og CGI-området)"

msgid "mime_php"
msgstr "PHP-dynamisk side (skapt av Rasmus Lerdorf i 1995, spesialdesignet for nettutvikling. Over 70% av nettstedene i verden bruker det, driver plattformer som WordPress, Facebook, Wikipedia. PHP 8 introduserte JIT-kompilering, betydelig ytelsesforbedring)"

msgid "mime_image"
msgstr "Bildefil"

msgid "mime_document"
msgstr "Dokumentfil"

msgid "mime_package"
msgstr "Programvarepakke"

msgid "mime_archive"
msgstr "Gzip-komprimert fil (GNU-prosjekt fra 1992, basert på DEFLATE-algoritme. På nettet brukes den til dynamisk komprimering av svar, komprimeringsgrad vanligvis 60-90%. Etter 2015 ble den i noen scenarier erstattet av Brotli, men er fortsatt det mest støttede komprimeringsformatet på serversiden)"

msgid "mime_audio"
msgstr "Lydfil"

msgid "mime_video"
msgstr "Videofil"

msgid "mime_jscript"
msgstr "JavaScript (utviklet av Brendan Eich i 1995)"

msgid "mime_json"
msgstr "JSON-data (foreslått av Douglas Crockford i 2001, lettvekts datautvekslingsformat, de facto-standard for nett-APIer)"

msgid "mime_vbs"
msgstr "VBScript (utviklet av Microsoft i 1996, Windows-skriftspråk, brukes til ASP-nettsider og Windows-administrasjonsskript. Med utbredelsen av PowerShell og JavaScript, er det gradvis faset ut)"

msgid "mime_conf"
msgstr "Konfigurasjonsfil (tekstformat for lagring av programvarekonfigurasjon, vanlige formater: INI, JSON, YAML, TOML, XML. Linux-systemkonfigurasjoner er ofte i /etc-katalogen)"

msgid "mime_css"
msgstr "CSS-stilark (W3C ga ut CSS1 som første offisielle standard i desember 1996, CSS2 la til posisjonering og medietyper i 1998, fra 2011 introduserte CSS3 modulært avrundede hjørner, animasjoner, fleksibokser, rutenettoppsett og responsivt design. Sammen med HTML og JavaScript er det de tre kjerneteknologiene for frontend-utvikling, alle moderne nettlesere (Chrome, Firefox, Safari, Edge) støtter det innfødt, det er den eneste standarden for definisjon av nettstiler)"

msgid "mime_xsl"
msgstr "XSL-stilark (W3C-standard fra 1999, XML-dokumentomformingsspråk, kan konvertere XML til HTML/PDF/tekst. Etter at JSON ble utbredt, har bruken avtatt)"

msgid "mime_runtime"
msgstr "Kjørbar fil (EXE, ELF, Mach-O og andre kjørbare formater for operativsystemer, inneholder maskinkode og innlastingsinformasjon)"

msgid "mime_library"
msgstr "Bibliotekfil (DLL, SO, dylib og andre dynamisk koblede biblioteker, kode som lastes inn under programkjøring)"

msgid "mime_swf"
msgstr "Flash-animasjon (utviklet av Macromedia i 1996, senere overtatt av Adobe. Standard for interaktive nettanimasjoner, dominerte internettanimasjon og -spill. Ulemper: avhengig av programtillegg, ikke støttet på mobil, høy sikkerhetsrisiko. I 2017 kunngjorde Adobe at det skulle fases ut, støtten opphørte fullstendig i 2020, erstattet av HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD-dokumenttypebeskrivelse (XML-spesifikasjon, definerer strukturen til et XML-dokument, brukes til å validere XML-validitet)"

msgid "mime_csv"
msgstr "CSV-dataformat (kommaseparerte verdier, universelt format for tabelldata, standard for import/eksport i Excel og databaser)"

msgid "mime_jnlp"
msgstr "Java Web Start (starter for Java-applikasjoner, teknologi for distribusjon av Java-skrivebordsapplikasjoner fra 2000-tallet, nå nedlagt)"

msgid "mime_lit"
msgstr "Microsoft Reader e-bok (introdusert av Microsoft i 2000, LIT-format, nedlagt)"

msgid "mime_svg"
msgstr "SVG-vektorgrafikk (W3C-standard fra 1999, fordi Microsoft lenge fremmet sitt eget VML-format, støttet IE-nettleseren det først i 2011, noe som forsinket utbredelsen. Etter 2015, med avviklingen av IE og utbredelsen av HD-skjermer, ble det det foretrukne formatet for ikoner og logoer)"

msgid "mime_ai"
msgstr "Adobe Illustrator-vektorgrafikk (introdusert i 1987, bransjestandard for vektorgrafikkformat, førstevalg for trykkedesign, logoer og ikoner)"

msgid "mime_phshop"
msgstr "Photoshop-bilde (introdusert av Adobe i 1990, Photoshop-kildeformat PSD, bransjestandard for bildebehandling)"

msgid "mime_ttf"
msgstr "TrueType-font (utviklet i fellesskap av Apple og Microsoft i 1989, vektorfontformat, konsistent visning på skjerm og utskrift, standard fontformat på moderne operativsystemer)"

msgid "mime_fon"
msgstr "WOFF2-webfont (W3C-anbefaling fra 2014, bruker Brotli-komprimeringsalgoritme, sammenlignet med eldre WOFF er størrelsen redusert med omtrent 30%, sammenlignet med TTF/OTF redusert med over 50%, alle moderne nettlesere støtter det, foretrukket format for moderne webfonter, støttet av over 98% av nettleserne)"

msgid "mime_pdf"
msgstr "PDF-dokument (utviklet av Adobe i 1993, ble ISO internasjonal standard i 2008. Plattformuavhengig dokumentformat, opprettholder formatkonsistens, global standard for distribusjon av elektroniske dokumenter)"

msgid "mime_dotnet"
msgstr "ASP.NET-dynamisk side (introdusert av Microsoft i 2002, dynamisk nettteknologi for Windows-plattform, en del av .NET Framework)"

msgid "mime_mdb"
msgstr "Access-database (Microsoft Access-databasefil, introdusert i 1992, Windows skrivebordsdatabase-løsning)"

msgid "mime_md"
msgstr "Markdown-dokument (opprettet av John Gruber i 2004, syntaksdesignet er påvirket av reStructuredText og Setext. Den sentrale designfilosofien er 'lesbarhet er gjengivelse', den opprinnelige implementeringen Markdown.pl brukte Perl-regulære uttrykk for teksttransformasjon. Avledede spesifikasjoner inkluderer GFM (2013), CommonMark (2017), Pandoc Markdown osv. Driver økosystemer som GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, og har blitt standardformatet for statiske nettstedgeneratorer og utviklerdokumentasjon)"

msgid "mime_crystal"
msgstr "Crystal Reports-rapportformat (SAP business intelligence-rapporter, standardformat for bedriftsrapporter)"

msgid "mime_libreoffice"
msgstr "LibreOffice-dokument (utviklet av The Document Foundation i 2010, en gren av OpenOffice, ODF-standardimplementering, en mainstream åpen kildekode-kontorpakke)"

msgid "mime_encrypt"
msgstr "Kryptert fil (fil som må dekrypteres for å vises, vanlige utvidelser: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS-spordata (GPS-utvekslingsformat, registrerer geografisk posisjonsinformasjon, universelt format for sportsklokker og navigasjonsenheter)"

msgid "mime_diskimage"
msgstr "Diskavbildning (DMG, ISO, IMG og andre optiske disk-/diskavbildningsfiler, brukes til programvare-distribusjon eller sikkerhetskopiering av lagringsmedier)"

msgid "mime_vm"
msgstr "Virtuell maskin-avbildning (VMDK, VDI, VHDX, OVA og andre virtuelle diskfiler, formater for virtualiseringsplattformer som VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent-seedfil (oppfunnet av Bram Cohen i 2001, P2P-nedlastingsindeksfil, inneholder metadata om fil og Tracker-informasjon)"

msgid "mime_gis"
msgstr "GIS geografisk informasjonssystem-data (Shapefile, GeoJSON og andre geospatiale dataformater, brukes for kart og romlig analyse)"

msgid "mime_ebook"
msgstr "E-bok (EPUB, MOBI, AZW og andre e-bokformater. EPUB er internasjonal standard, MOBI/AZW er Amazons Kindle-format)"

msgid "mime_avif"
msgstr "AVIF-bilde (introdusert av Alliance for Open Media i 2019, basert på AV1-koding, komprimeringsgraden er 50% bedre enn WebP, en ny generasjons standard for nettbilder)"

msgid "mime_markdown"
msgstr "Markdown-dokument (designet av John Gruber i 2004, lettvekts markeringsspråk, universelt format for GitHub README, teknisk dokumentasjon, foruminlegg)"

msgid "mime_yaml"
msgstr "YAML-konfigurasjon (designet av Clark Evans i 2001, menneskelesbart dataserialiseringsformat, standard format for konfigurasjonsfiler som Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML-konfigurasjon (designet av Tom Preston-Werner i 2013, \"Tom's Obvious Minimal Language\", konfigurasjonsfilformat for moderne verktøy som Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue-komponentfil (introdusert i 2014 av Evan You, progressiv JavaScript-rammeverk. Gjennom enkeltfilkomponenter (SFC) kombinerer den HTML, CSS og JS perfekt, noe som i stor grad øker utviklingseffektiviteten. Det er et av verdens mest populære frontend-rammeverk. Også som kjerne i moderne statiske nettstedsgeneratorer som VitePress, brukes det mye til å drive interaktiv teknisk dokumentasjon og blogger.)"

msgid "mime_wasm"
msgstr "WebAssembly-modul (W3C-standard fra 2017, høyytelses utførelsesformat i nettleser, C/C++/Rust/R kan kompilere til mål, ytelse nær det opprinnelige)"

msgid "mime_jsx"
msgstr "React JSX-komponent (Facebook introduserte JavaScript XML i 2013, komponentsyntaks for React-rammeverket, en innovativ paradigm for å skrive HTML i JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX-komponent (utviklet av Microsoft i 2012, TypeScript + JSX, standardmodus for React-utvikling med typesikkerhet)"

msgid "mime_heif"
msgstr "HEIF-bilde (MPEG-standard fra 2015, effektivt bildefilformat, mye brukt i Apples økosystem)"

msgid "mime_heic"
msgstr "HEIC-bilde (Apples implementering av HEIF, standard bildeformat for iPhone, innfødt støttet på iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D-modell (GL-overføringsformat, \"JPEG for 3D-verdenen\", utgitt av Khronos Group i 2015, standardformat for web 3D)"

msgid "mime_glb"
msgstr "GLB binær 3D-modell (binær versjon av GLTF, én fil inneholder alle ressurser, brukes for distribusjon av 3D-scener)"

msgid "mime_gls"
msgstr "GLOSSARY-ordliste (termdefinisjonsfil, brukes for terminologihåndtering i dokumentsystemer)"

msgid "mime_cbz"
msgstr "CBZ-tegneserie (ZIP-komprimerte tegneseriebilder, universelt format for tegneseriesamlinger)"

msgid "mime_cbr"
msgstr "CBR-tegneserie (RAR-komprimerte tegneseriebilder, universelt format for tegneseriesamlinger)"

msgid "mime_fb2"
msgstr "FB2 e-bok (FictionBook 2.0, russisk e-bokformat, XML-struktur, mye støttet av lesere med åpen kildekode)"

msgid "mime_kepub"
msgstr "KEPUB e-bok (Kobo-spesifikt EPUB-format, optimalisert format for Kobo e-boklesere)"

msgid "mime_m4b"
msgstr "M4B lydbok (MPEG-4 lydbokformat, støtter bokmerker, iTunes-lydbokformat)"

msgid "mime_kfx"
msgstr "Kindle KFX-format (introdusert av Amazon i 2015, spesialformat for Kindle e-bøker, støtter forbedret typografi og rask blading)"

msgid "mime_chm"
msgstr "CHM-hjelpefil (introdusert av Microsoft i 1997, kompilert HTML-hjelpeformat, standard for Windows-programvarehjelpedokumentasjon)"

msgid "mime_mht"
msgstr "MHT nettsidearkiv (introdusert av Microsoft i 1999, enkeltfil nettsideformat, format for lagring av nettsider i IE-nettleseren)"

msgid "mime_wml"
msgstr "WML trådløst markeringsspråk (WAP-standard fra 1999, brukes for nettsider på eldre mobiltelefoner, nedlagt)"

msgid "mime_xhtml"
msgstr "XHTML-side (W3C-standard fra 2000, XML-versjon av HTML, strengere syntaks. I 2009 avsluttet W3C vedlikeholdet, fokuset flyttet til HTML5)"

msgid "mime_xml"
msgstr "XML-dokument (W3C-standard fra 1998, utvidbart markeringsspråk, basisformat for nettjenester, konfigurasjonsfiler, datautveksling)"

msgid "mime_sgml"
msgstr "SGML-dokument (ISO-standard fra 1986, forgjengeren til HTML, standard universelt markeringsspråk, både XML og HTML stammer fra SGML)"

msgid "mime_apng"
msgstr "APNG-animasjon (utviklet av Mozilla i 2004, animasjonsutvidelse av PNG, moderne erstatning for GIF, støtter ekte farger og gjennomsiktighet)"

msgid "mime_bmp"
msgstr "BMP-bitmap (Windows bitmap-format, innfødt støttet siden Windows 1.0. Ukomprimert, stor filstørrelse, men på grunn av sin enkle struktur og manglende behov for ekstra kodeker, brukes den fortsatt i Windows 11s utklippsverktøy, Paint-programmet, ikonressurser i EXE/MSI-installasjonspakker, markørfiler og noen eldre drivere. Ved samme bildekvalitet er filstørrelsen omtrent 3-10 ganger større enn PNG. I de fleste tilfeller er den erstattet av PNG/JPEG, men Windows-økosystemet opprettholder fortsatt bred kompatibilitet)"

msgid "mime_cdr"
msgstr "CDR-vektorgrafikk (CorelDRAW-spesialformat, Corel Corporation, vektorgrafikkdesignprogramvare)"

msgid "mime_gif"
msgstr "GIF-bilde (utviklet av CompuServe i 1987, 256-farge animert format. Ulemper: lite farger, grov kvalitet, støtter ikke gjennomsiktighet, store filer, lav bildefrekvens. Erstattet av moderne animerte formater som APNG, WebP)"

msgid "mime_ico"
msgstr "ICO-ikon (Windows ikonfilformat, støtter flere oppløsninger, standardformat for favicon på nettsider)"

msgid "mime_jpeg"
msgstr "JPEG-bilde (ISO-standard fra 1992, bildeformat med tap av kvalitet, de facto standard for bilder på internett)"

msgid "mime_jpg"
msgstr "JPEG-bilde (ISO-standard fra 1992, bildeformat med tap av kvalitet, de facto standard for bilder på internett)"

msgid "mime_png"
msgstr "PNG-bilde (W3C-anbefaling fra 1996, støtter ekte farger og gjennomsiktighet, statisk erstatning for GIF, internettstandard for bilder uten tap)"

msgid "mime_ps"
msgstr "PostScript-sidebeskrivelsesfil (introdusert av Adobe i 1985, sidebeskrivelsesspråk, forgjengeren til PDF, brukes for utskrift og publisering)"

msgid "mime_psb"
msgstr "PSB stort dokument (Adobe Photoshop ekstra stort bildeformat, støtter bilder større enn 2GB eller 30000 piksler)"

msgid "mime_psd"
msgstr "PSD-bilde (Adobe Photoshop-kildeformat, støtter lag, kanaler, stier, bransjestandard for bildebehandling)"

msgid "mime_webp"
msgstr "WebP-bilde (utviklet av Google i 2010, nettverksbildeformat, støtter komprimering med/tap og animasjon, komprimeringsgraden er 25-35% bedre enn PNG, 25% bedre enn JPEG)"

msgid "mime_woff"
msgstr "WOFF-webfont (opprettet i 2009, W3C-standard fra 2018. Komprimering basert på TrueType/OpenType, optimalisering av lasting av webfonter, standardformat for ikoner på moderne nettsider)"

msgid "mime_7z"
msgstr "7z-komprimert pakke (utviklet av Igor Pavlov i 1999, spesialformat for 7-Zip-programmet. LZMA-algoritme, høy komprimering, åpen kildekode og gratis. 7z-formatet ved samme komprimeringsgrad er vanligvis 30-50% mindre enn ZIP, vanlig format i åpen kildekode-miljøet og for programvare-distribusjon)"

msgid "mime_ace"
msgstr "ACE-komprimert pakke (utviklet på 1990-tallet, format for WinACE-programmet. Konkurrerte med RAR, relativt høy komprimering. Utviklingen stoppet i 2007, erstattet av 7z/RAR, brukes sjelden)"

msgid "mime_bz2"
msgstr "BZIP2-komprimert pakke (utviklet av Julian Seward i 1996, blokksorteringsalgoritme. Komprimeringsgraden er 15-20% bedre enn GZIP, men langsommere. Vanlig format for Linux-kjernens kildekode, åpen kildekode-pakker, filendelse .bz2)"

msgid "mime_cab"
msgstr "CAB-komprimert pakke (utviklet av Microsoft i 1995, Cabinet-format. Format for installasjonspakker for Windows-systemet, brukes for drivere, distribusjon av systemfiler. Windows Installer (MSI) bruker internt CAB for lagring av filer)"

msgid "mime_dmg"
msgstr "DMG-diskavbildning (introdusert av Apple på 1980-tallet, Disk Image-format. Standardformat for distribusjon av programvare på macOS, dobbeltklikk monteres som virtuell disk, dra og slipp for å installere. Støtter komprimering og kryptering, det dominerende formatet for nedlasting av Mac-programvare)"

msgid "mime_emz"
msgstr "EMZ-komprimert bilde (Windows komprimert forbedret metafil, komprimert versjon av EMF. Format for lagring av vektorgrafikk i Office-dokumenter, er i hovedsak en GZIP-komprimert EMF-fil)"

msgid "mime_gz"
msgstr "GZIP-komprimert pakke (utviklet av Jean-loup Gailly og Mark Adler i 1992, GNU-prosjekt. Standard komprimeringsverktøy på Unix/Linux, vanlig format for HTTP-overføring med komprimering. Filendelse .gz, brukes ofte sammen med TAR)"

msgid "mime_jar"
msgstr "JAR-komprimert pakke (introdusert av Sun Microsystems i 1997, Java ARchive-format. Er i hovedsak en ZIP-komprimert pakke, brukes for pakking av Java-klassebiblioteker og applikasjoner. Kjerneformat i Java-økosystemet som Maven, Gradle, Android bruker også JAR)"

msgid "mime_lzma"
msgstr "LZMA-komprimert pakke (utviklet av Igor Pavlov i 1998, Lempel-Ziv-Markov chain-algoritme. Kjernekomprimeringsalgoritme for 7z-format, høy komprimering, rask dekomprimering. Brukes for fastvare, distribusjon av programvare for innebygde systemer)"

msgid "mime_rar"
msgstr "RAR-komprimert pakke (utviklet av Eugene Roshal i 1993, Roshal ARchive-format. Høy komprimering, støtter oppdeling i volumer, gjenopprettingsposter. Format for WinRAR-programmet, komprimering bedre enn ZIP, men krever betalt programvare, verktøy med åpen kildekode som unrar kan dekomprimere)"

msgid "mime_tar"
msgstr "TAR-arkiv (introdusert i Unix V7 i 1979, Tape ARchive-format. Tape-arkivformat, komprimerer ikke, bare pakker, brukes ofte sammen med GZIP/BZIP2/XZ. Kildekoden til Linux-pakker, lagring av lag i Docker-avbildninger bruker TAR-format)"

msgid "mime_tgz"
msgstr "TGZ-komprimert pakke (kombinasjon av TAR + GZIP, filendelse .tgz eller .tar.gz. Det mest universelle distribusjonsformatet for Unix/Linux-pakker, mye brukt for kildekodepakker, binærpakker, representant for \"pakk ut og bruk\")"

msgid "mime_tbz2"
msgstr "TBZ2-komprimert pakke (kombinasjon av TAR + BZIP2, filendelse .tbz2 eller .tar.bz2. Komprimeringsgraden er 15-20% bedre enn TGZ, egnet for distribusjon av store filer, Linux-kjernens kildekode har lenge brukt dette formatet)"

msgid "mime_xz"
msgstr "XZ-komprimert pakke (introdusert i 2009, basert på LZMA2-algoritme. Ekstremt høy komprimering, 30-50% bedre enn GZIP, relativt rask dekomprimering. Mye brukt i Linux-kjernen, pakkeansvarlige (som internt i Debians .deb), anbefalt format for det nåværende Linux-økosystemet)"

msgid "mime_z"
msgstr "Z-komprimert pakke (Unix compress-kommandoformat fra 1985, LZW-algoritme. Tidlig Unix-komprimeringsformat, erstattet av GZIP. Filendelse .Z, sjelden brukt på moderne systemer)"

msgid "mime_zip"
msgstr "ZIP-komprimert pakke (utviklet av Phil Katz i 1989, PKZIP-format. Innfødt støttet av Windows, det mest universelle komprimeringsformatet på internett. Støtter flere filer, katalogstruktur, kan velge komprimeringsalgoritme. Java JAR, Android APK, Office-dokumenter DOCX/XLSX er basert på ZIP-format)"

msgid "mime_zst"
msgstr "Zstandard-komprimert pakke (utviklet av Facebook i 2015, designet av Yann Collet. Høyhastighets komprimeringsalgoritme, komprimeringsgrad nær LZMA, hastighet langt over GZIP. Støttet av Linux-kjerne 5.9+, Arch Linux pacman, Debian APT tar det gradvis i bruk, en ny generasjons komprimeringsstandard)"

msgid "mime_lz4"
msgstr "LZ4-komprimert pakke (utviklet av Yann Collet i 2011, ekstremt rask komprimeringsalgoritme. Komprimeringshastigheten er over 10 ganger raskere enn GZIP, egnet for sanntidskomprimering. Mye brukt i Linux-kjernen, OpenZFS, Hadoop, førstevalg for scenarier der hastighet er prioritet)"

msgid "mime_lzo"
msgstr "LZO-komprimert pakke (utviklet av Markus Oberhumer i 1996, Lempel-Ziv-Oberhumer-algoritme. Ekstremt rask dekomprimeringshastighet, moderat komprimeringsgrad. Brukes i Linux-kjernens Squashfs, OpenWrt-fastvare, egnet for innebygde systemer)"

msgid "mime_msi"
msgstr "MSI-installasjonspakke (introdusert av Microsoft i 1999, Windows Installer-pakkeformat. Standard installasjonsformat for Windows-applikasjoner, støtter transaksjonsrulling, komponentadministrasjon, stille installasjon. Foretrukket format for distribusjon av bedriftsprogramvare, fortsatt det dominerende formatet for installasjon av Windows-programvare)"

msgid "mime_pkg"
msgstr "PKG-installasjonspakke (format for installasjonspakke for macOS-applikasjoner, basert på Apples Installer-teknologi. Standardformat for distribusjon av macOS-programvare, støtter komponentvalg, installasjonsskript, avinstalleringsfunksjon. Dobbeltklikk på .pkg-filen for å installere, vanlig distribusjonsmetode for programvare utenfor Mac App Store)"

msgid "mime_apk"
msgstr "APK Android-applikasjonspakke (introdusert av Google i 2008, tradisjonell installasjonsformat for Android-applikasjoner. APK er i hovedsak en ZIP-pakke, inneholder kode, ressurser og manifestfil. Fra 2021 krever Google Play at nye applikasjoner bruker AAB-format, men APK brukes fortsatt for utvikling og feilsøking, tredjepartsbutikker og sidelasting)"

msgid "mime_ipa"
msgstr "IPA iOS-applikasjonspakke (iOS App Store Package, installasjonsformat for iOS/iPadOS-applikasjoner. Introdusert i 2008 med iPhone SDK. Må distribueres via App Store eller signeres med bedriftssertifikat. Inneholder kjørbar fil, ressurser, Info.plist og signaturinformasjon)"

msgid "mime_hap"
msgstr "HAP HarmonyOS-applikasjonspakke (HarmonyOS Ability Package, grunnleggende enhet for HarmonyOS-applikasjoner. Introdusert i 2020 med HarmonyOS 2.0. Støtter to typer: entry og feature, distribusjonsformat for Huawei-telefoner, nettbrett, smartklokker og andre HarmonyOS-enheter)"

msgid "mime_har"
msgstr "HAR HarmonyOS statisk delt bibliotek (HarmonyOS Archive, statisk delt bibliotek for HarmonyOS, kan deles av flere HAP-pakker, brukes for komponentbasert utvikling og gjenbruk av moduler)"

msgid "mime_aab"
msgstr "Android App Bundle (introdusert av Google i 2018, fra 2021 gjør Google Play dette formatet obligatorisk for nye applikasjoner. AAB er et distribusjonsformat, Google Play genererer optimaliserte APK-er basert på enhetskonfigurasjon (CPU-arkitektur, skjermtetthet, språk), installasjonspakkens størrelse reduseres i gjennomsnitt med 35%. Utviklere laster opp AAB, brukere laster ned APK)"

msgid "mime_xapk"
msgstr "XAPK-applikasjonspakke (tredjeparts Android-applikasjonsutvidelsespakke, inneholder APK + OBB-datafiler. Brukes for store spill og komplekse applikasjoner, løser 100 MB-grensen for en enkelt APK-fil. Vanlig i tredjeparts app-butikker som APKPure, APKMirror, ikke et offisielt Google-format)"

msgid "mime_appx"
msgstr "Windows-applikasjonspakke (introdusert av Microsoft i 2012, installasjonsformat for Windows 8/10/11-applikasjoner. Støtter UWP- og skrivebordsapplikasjonskonvertering, distribueres via Microsoft Store. I 2024 introduserte Microsoft MSIX som etterfølgerformat, gradvis erstatter APPX)"

msgid "mime_msix"
msgstr "MSIX-applikasjonspakke (introdusert av Microsoft i 2018, en ny generasjons pakkeformat for Windows. Kombinerer fordelene med APPX og MSI, støtter alle typer Windows-applikasjoner, kan distribueres via Microsoft Store eller sidelastes, anbefalt format for Windows 11)"

msgid "mime_appimage"
msgstr "AppImage-applikasjonspakke (introdusert i 2004, Linux-installasjonsfritt applikasjonsformat. \"Én applikasjon, én fil\", ingen installasjon nødvendig, kjører direkte, støtter de fleste Linux-distribusjoner, vanlig distribusjonsmåte for Linux-programvare for utviklere)"

msgid "mime_flatpak"
msgstr "Flatpak-applikasjonspakke (introdusert i 2015, Linux-sandkasseapplikasjonsformat. Kjører på tvers av distribusjoner, isolert fra vertssystemet, ledet av Fedora, Red Hat, standardformat for GNOME Software Center)"

msgid "mime_snap"
msgstr "Snap-applikasjonspakke (introdusert av Canonical i 2014, morselskapet til Ubuntu, Linux universelt applikasjonsformat. Automatiske oppdateringer, sandkasseisolering, støtter 40+ Linux-distribusjoner, standardformat for Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Debian-programvarepakke (introdusert av Debian-prosjektet i 1993, standard installasjonsformat for Debian/Ubuntu og deres derivater. Administreres med dpkg, APT er grensesnittet for pakkeansvarlig, et av de mest modne pakkeformatene i Linux-økosystemet, fortsatt det dominerende formatet i Debian-familien)"

msgid "mime_rpm"
msgstr "RPM-programvarepakke (introdusert av Red Hat i 1997, standardformat for Red Hat/Fedora/CentOS/SUSE og andre distribusjoner. RPM står for \"Red Hat Package Manager\", sammen med DEB et av de to store pakkeformatene i Linux, fortsatt dominerende i RHEL-familien)"

msgid "mime_pacman"
msgstr "Arch-programvarepakke (introdusert av Arch Linux i 2002, .pkg.tar.zst-format som brukes av pacman-pakkeansvarlig. Kjernen i Arch Linux med rullende utgivelser, kjent for enkelhet og KISS-prinsippet, AUR (Arch User Repository) er dens særegenhet)"

msgid "mime_exe"
msgstr "EXE-kjørbar fil (Windows kjørbart programformat, forkortelse for \"Executable\". Innfødt kjørbart format for Windows-operativsystemet, inneholder PE-struktur. Utviklet seg fra MZ-formatet fra MS-DOS, i 1993 introduserte Windows NT PE-formatet (Portable Executable) og brukes fortsatt. Programvareinstallasjonspakker, applikasjoner, systemverktøy bruker dette formatet. Brukeren dobbeltklikker for å kjøre, det mest brukte kjørbare formatet i verden)"

msgid "mime_dll"
msgstr "DLL-dynamisk koblingsbibliotek (introdusert av Microsoft i 1993, Dynamic Link Library. Windows delt kodebibliotek, lastes dynamisk under programkjøring, sparer minne og diskplass. Systemkomponenter, applikasjonsprogramtillegg, drivere bruker DLL-format. Kjernemåten å implementere Windows API på, DLL Hell-problemet er mildnet i .NET-tiden)"

msgid "mime_com"
msgstr "COM-kjørbar fil (kjørbart format fra MS-DOS-tiden, forkortelse for \"Command\". Enkel filstruktur, 64KB-begrensning, mainstream-format før Windows 3.x. Nedlagt, moderne Windows bruker EXE-format, COM-filendelse brukes fortsatt for noen komponentfiler)"

msgid "mime_aac"
msgstr "AAC-lyd (MPEG-standard fra 1997, Advanced Audio Coding. Etterfølgeren til MP3, lydkvaliteten bedre enn MP3 ved samme bithastighet, standard lydformat for YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC-lyd (utviklet av Apple i 2004, Apple Lossless Audio Codec. Apples tapsfrie format, åpen kildekode i 2011, standardformat for iTunes og Apple Music tapsfri lyd)"

msgid "mime_flac"
msgstr "FLAC-lyd (utviklet av Xiph.Org Foundation i 2001, Free Lossless Audio Codec. Tapsfri komprimering, lydkvalitet som CD, filstørrelse omtrent halvparten av original WAV. Åpen kildekode uten patenter, foretrukket format for audiofiler og digitale musikksamlinger)"

msgid "mime_mp3"
msgstr "MP3-lyd (utviklet av Fraunhofer Institute i 1993, MPEG-1 Audio Layer 3. Format med tap av kvalitet, liten filstørrelse akseptabel kvalitet, kjernen i den digitale musikkrevolusjonen på 2000-tallet, hovedårsaken til iPod og Napster. Patentet utløp i 2017, ble offentlig domenefilformat)"

msgid "mime_oga"
msgstr "Ogg Audio-lyd (utviklet av Xiph.Org Foundation, rent lydformat for Ogg-beholderen, bruker Vorbis-koding. Åpen kildekode uten patenter, komprimeringskvalitet bedre enn MP3, mye brukt i åpen kildekode-prosjekter)"

msgid "mime_ogg"
msgstr "OGG-lyd (utviklet av Xiph.Org Foundation i 2000, Ogg Vorbis-format. Åpen kildekode uten patenter, komprimeringskvalitet bedre enn MP3, tidlig bruker var Spotify, mye brukt for lydeffekter i spill)"

msgid "mime_opus"
msgstr "Opus-lyd (standardisert av IETF i 2012, åpen kildekode uten patenter lydformat. Kombinerer SILK- og CELT-teknologi, ekstremt lav latens, høyest komprimeringskvalitet, standard lydformat for WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV-lyd (utviklet av Microsoft og IBM i 1991, innfødt Windows-lydformat. PCM-koding uten komprimering, tapsfri lydkvalitet, men enorme filer, standardformat for profesjonell lydredigering)"

msgid "mime_wma"
msgstr "WMA-lyd (utviklet av Microsoft i 1999, Windows Media Audio. To versjoner: med og uten tap, innfødt støttet av Windows, ble utbredt med Windows Media Player. Er nå marginalisert, erstattet av MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF-lyd (Direct Stream Digital-format, utviklet av Sony og Philips, 1-bit høy samplingsfrekvens, standardformat for DSD-lyd, digital versjon av SACD, audiophile high-end-lydformat, enorme filer)"

msgid "mime_ape"
msgstr "APE Lyd (utviklet av Monkey's Audio i 2000, tapsfri komprimeringsformat. Høyere komprimering enn FLAC, men langsommere koding, brukes fortsatt på Windows-plattformen og blant audio-entusiaster)"

msgid "mime_mid"
msgstr "MIDI-lyd (opprettet av MIDI Association i 1983, Musical Instrument Digital Interface. Noteformat snarere enn opptak, svært små filer, standard for elektroniske instrumenter, ringetoner for mobiltelefoner, lydeffekter i spill. I 1991 ble General MIDI standardisert, definerte 128 instrumentlyder)"

msgid "mime_m4a"
msgstr "M4A-lyd (MPEG-4 Audio, beholderformat for AAC. Standardformat for iTunes Music Store, mainstream-lydformat i Apples økosystem, støtter DRM-beskyttelse)"

msgid "mime_m3u"
msgstr "M3U-spilleliste (MP3 URL-spillelisteformat, ren tekstfil, registrerer stier til lydfiler. Standard fra Winamp-tiden, brukes for nettradio, online musikkstrømming. M3U8 er dens UTF-8-versjon, brukes for HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF-strømming (utviklet av Microsoft i 1996, Advanced Systems Format. Windows Media-beholder for strømming, støtter synkronisert lyd- og videooverføring. Brukes for direktesendinger og strømming på forespørsel, WMA/WMV er basert på ASF-beholderen)"

msgid "mime_avi"
msgstr "AVI-video (introdusert av Microsoft i 1992, tidlig Windows-videostandard. \"Audio Video Interleave\", lyd- og vekselvis lagring, det mest populære videoformatet på 1990-2000-tallet, erstattet av MP4/MKV)"

msgid "mime_divx"
msgstr "DivX-video (utviklet av DivX-selskapet i 1998, videokodingsformat basert på MPEG-4. Hovedformat for fildeling av videoer på internett på 2000-tallet, den første teknologien som komprimerte DVD-kvalitet til CD-størrelse. På grunn av opphavsrettskonflikter, ble det senere kommersielt kodingsverktøy)"

msgid "mime_mp4"
msgstr "MP4-video (MPEG-standard fra 2001, MPEG-4 Part 14. Det mest universelle videoformatet i verden, støtter H.264/H.265-koding, standardformat for nettvideo, mobilopptak, YouTube)"

msgid "mime_m4v"
msgstr "M4V-video (iTunes-videoformat, variant av MP4. Videoformat i Apples økosystem, standardformat for filmer og TV-serier på iTunes Store, støtter DRM-opphavsrettsbeskyttelse)"

msgid "mime_mpeg"
msgstr "MPEG-video (opprettet av MPEG-organisasjonen i 1988, Moving Picture Experts Group. Grunnlegger av standarder for digital videokomprimering, stor innflytelse fra MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (nettvideo))"

msgid "mime_mkv"
msgstr "MKV-video (utviklet av Matroska-prosjektet i 2002, åpen kildekode multimediebeholder. Støtter flere lydspor, flere undertekster, kapitler, \"innpakningsverktøy\", foretrukket format for fildeling av HD-filmer)"

msgid "mime_mpg"
msgstr "MPEG-video (MPEG-1/MPEG-2 videofilendelse, standardformat for VCD og DVD. Hovedformat for videoer på optiske plater på 1990-2000-tallet, erstattet av H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video-video (utviklet av Xiph.Org Foundation, videoformat for Ogg-beholderen, bruker Theora-koding. Åpen kildekode uten patenter, tidlig standard for HTML5-video, innfødt støttet av Firefox)"

msgid "mime_ogx"
msgstr "Ogg-multimediebeholder (utviklet av Xiph.Org Foundation, universell utvidelse av Ogg-beholderen, kan inneholde flere spor: lyd, video, undertekster osv. Åpen kildekode-multimediastandard, brukes for spill, strømming)"

msgid "mime_rm"
msgstr "RealMedia-video (utviklet av RealNetworks i 1995, RealMedia-format. Pioner innen internettstrømming på 1990-2000-tallet, kjernformat for RealPlayer-avspilleren. Ulemper: krever spesialavspiller, dårlig komprimeringskvalitet, ble erstattet av Flash/MP4)"

msgid "mime_flv"
msgstr "Flash-video (formatet dukket opp i 2002, Flash Video-format. Var en gang mainstream for nettvideo, tidlig bruker var YouTube. Ulemper: krever Flash-programtillegg, dårlig ytelse, mange sikkerhetshull. Fra 2015 gikk mainstream-nettsteder over til HTML5-video, nå nedlagt)"

msgid "mime_f4v"
msgstr "F4V-video (Flash-videoformat utviklet av Adobe, etterfølger til FLV. Basert på MPEG-4-standarden, støtter H.264-koding. Sammen med Flash-teknologien ble den nedlagt, Adobe avsluttet støtten i 2020)"

msgid "mime_wmv"
msgstr "WMV-video (utviklet av Microsoft i 1999, Windows Media Video. Innfødt støttet av Windows, optimalisert for strømming, vanlig format for online-videoer i de tidlige dagene, nå marginalisert)"

msgid "mime_wmf"
msgstr "WMF-medieformat (Windows Media Format, Microsofts medierammeverk. Omfatter WMV-video og WMA-lyd, innfødt støttet av Windows Media Player)"

msgid "mime_mov"
msgstr "MOV-video (utviklet av Apple i 1991, QuickTime-beholderformat. Standardformat for profesjonell videoredigering, støtter flere kodeker, innfødt støttet av Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime-video (introdusert av Apple i 1991, QuickTime-format. Videostandard for Mac-plattformen, MOV er dens beholder, QuickTime-avspilleren var mye brukt. I 2016 avsluttet Apple utviklingen av Windows-versjonen, gradvis erstattet av MP4)"

msgid "mime_webm"
msgstr "WebM-video (introdusert av Google i 2010, åpen kildekode uten patenter videoformat. Basert på Matroska-beholderen, VP8/VP9-koding, standardformat for HTML5-video, YouTubes standard web-avspillingsformat)"

msgid "mime_3gp"
msgstr "3GP-video (opprettet av 3GPP i 2000, videoformat for mobile enheter. Svært små filer, lav kvalitet, format for videoopptak på tidlige mobiltelefoner, brukes for MMS-sending)"

