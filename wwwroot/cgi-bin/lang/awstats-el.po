#------------------------------------------------------------------------------
# Περιγραφές μορφών
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Αρχείο κειμένου (τυποποίηση ASCII το 1963, απλό κείμενο χωρίς μορφοποίηση. Βάση όλου του πηγαίου κώδικα, ρυθμίσεων, αρχείων καταγραφής. Το Unix χρησιμοποιεί LF, τα Windows CRLF για αλλαγή γραμμής, ακόμα και σήμερα η πιο κοινή μορφή δεδομένων στην πληροφορική)"

msgid "mime_log"
msgstr "Αρχείο καταγραφής (απλό αρχείο κειμένου που καταγράφει πληροφορίες λειτουργίας συστήματος και εφαρμογών, χρησιμοποιείται συχνά για αντιμετώπιση προβλημάτων, ανάλυση απόδοσης, έλεγχο ασφαλείας. Τυπικές μορφές όπως Apache combined log, Nginx access log, syslog κ.λπ.)"

msgid "mime_page"
msgstr "Ιστοσελίδα HTML (Ο Tim Berners-Lee εφηύρε τον Παγκόσμιο Ιστό το 1989, όρισε τις τρεις τεχνολογίες HTML/HTTP/URL το 1990, προσφέροντάς τες δωρεάν χωρίς δίπλωμα ευρεσιτεχνίας. Το HTML5 έγινε το επίσημο πρότυπο W3C το 2014, υποστηρίζοντας προβολή, πολυμέσα και εκτύπωση. Βραβευμένος με το βραβείο Turing το 2016)"

msgid "mime_khtml"
msgstr "Μηχανή ιστού KHTML (κυκλοφόρησε με το KDE 2.0 το 1998, μηχανή απόδοσης του προγράμματος περιήγησης Konqueror. Η Apple δημιούργησε το WebKit με βάση το KHTML το 2001, η Google δημιούργησε το Blink από το WebKit το 2008, το οποίο έγινε ο πυρήνας των προγραμμάτων περιήγησης Chrome, Edge, Safari. Το KHTML είναι ένα παράδειγμα του πώς η κοινότητα ανοιχτού κώδικα έθεσε τα θεμέλια για σύγχρονες μηχανές προγραμμάτων περιήγησης, η τεχνολογική κληρονομιά του συνεχίζεται μέσω των WebKit/Blink)"

msgid "mime_script"
msgstr "Δυναμική δέσμη ενεργειών (ερμηνευόμενη γλώσσα, δεν απαιτεί μεταγλώττιση. Περιλαμβάνει ASP, JSP, CGI, ColdFusion, Tcl, VBScript κ.λπ., ευρέως χρησιμοποιούμενη στην πρώιμη ανάπτυξη ιστού, διαχείριση συστήματος, αυτοματοποίηση εργασιών. Σύγχρονες γλώσσες σεναρίου όπως η Python, η Ruby, η JavaScript έχουν εξελιχθεί στις κύριες γλώσσες για ανάπτυξη πλήρους στοίβας)"

msgid "mime_js"
msgstr "Δέσμη ενεργειών JavaScript (Ο Brendan Eich τη δημιούργησε σε 10 ημέρες στο Netscape το 1995, εγγενής γλώσσα προγραμματισμού προγράμματος περιήγησης. Η ECMAScript τυποποιήθηκε το 1997, η γέννηση του Node.js το 2009 την έκανε γλώσσα πλήρους στοίβας, το npm είναι ο μεγαλύτερος διαχειριστής πακέτων στον κόσμο. Για χρόνια η πιο δημοφιλής γλώσσα προγραμματισμού στο GitHub)"

msgid "mime_py"
msgstr "Δέσμη ενεργειών Python (δημιουργήθηκε από τον Guido van Rossum το 1991, γνωστή για την υποχρεωτική εσοχή και την απλή σύνταξη. Χρησιμοποιείται ευρέως στην ανάπτυξη ιστού, την επιστήμη δεδομένων, την τεχνητή νοημοσύνη, την αυτοματοποίηση λειτουργιών. Πολλαπλός νικητής του βραβείου TIOBE για τη γλώσσα προγραμματισμού της χρονιάς)"

msgid "mime_sh"
msgstr "Δέσμη ενεργειών Shell (γέννηση του Unix το 1971, γλώσσα σεναρίου εντολών. Χρησιμοποιείται για διαχείριση συστήματος, αυτοματοποίηση εργασιών, εκκίνηση υπηρεσιών, δέσμες ενεργειών ανάπτυξης. Απαραίτητη δεξιότητα για τη διαχείριση Linux)"

msgid "mime_rb"
msgstr "Δέσμη ενεργειών Ruby (δημιουργήθηκε από τον Yukihiro Matsumoto το 1995, επικεντρωμένη στην ευτυχία του προγραμματιστή. Το πλαίσιο Ruby on Rails εισήγαγε το παράδειγμα σύμβαση έναντι διαμόρφωσης, επηρεάζοντας τον σχεδιασμό σύγχρονων πλαισίων ιστού)"

msgid "mime_pl"
msgstr "Δέσμη ενεργειών Perl (δημιουργήθηκε από τον Larry Wall το 1987, γνωστή για τον πραγματισμό της, αποκαλούμενη 'ελβετικό μαχαίρι'. Το CPAN ήταν πρωτοπόρος των σύγχρονων διαχειριστών πακέτων γλωσσών, είχε βαθιά επιρροή στην επεξεργασία κειμένου, τη διαχείριση συστήματος και το CGI)"

msgid "mime_php"
msgstr "Δυναμική ιστοσελίδα PHP (δημιουργήθηκε από τον Rasmus Lerdorf το 1995, σχεδιασμένη ειδικά για ανάπτυξη ιστού. Πάνω από το 70% των ιστοσελίδων στον κόσμο τη χρησιμοποιούν, τροφοδοτεί πλατφόρμες όπως WordPress, Facebook, Wikipedia. Η PHP 8 εισάγει μεταγλώττιση JIT, βελτιώνοντας σημαντικά την απόδοση)"

msgid "mime_image"
msgstr "Αρχείο εικόνας"

msgid "mime_document"
msgstr "Αρχείο εγγράφου"

msgid "mime_package"
msgstr "Πακέτο λογισμικού"

msgid "mime_archive"
msgstr "Συμπιεσμένο αρχείο Gzip (έργο GNU του 1992, βασισμένο στον αλγόριθμο DEFLATE. Στον Ιστό χρησιμοποιείται για δυναμική συμπίεση περιεχομένου απάντησης, ο βαθμός συμπίεσης είναι συνήθως 60-90%. Μετά το 2015 αντικαταστάθηκε σε ορισμένα σενάρια από το Brotli, αλλά εξακολουθεί να είναι η ευρύτερα υποστηριζόμενη μορφή συμπίεσης στην πλευρά του διακομιστή)"

msgid "mime_audio"
msgstr "Αρχείο ήχου"

msgid "mime_video"
msgstr "Αρχείο βίντεο"

msgid "mime_jscript"
msgstr "JavaScript (αναπτύχθηκε από τον Brendan Eich το 1995)"

msgid "mime_json"
msgstr "Δεδομένα JSON (προτάθηκαν από τον Douglas Crockford το 2001, ελαφριά μορφή ανταλλαγής δεδομένων, de facto πρότυπο για Web API)"

msgid "mime_vbs"
msgstr "VBScript (αναπτύχθηκε από τη Microsoft το 1996, γλώσσα σεναρίου Windows, χρησιμοποιείται για ιστοσελίδες ASP και δέσμες ενεργειών διαχείρισης Windows. Με τη διάδοση των PowerShell και JavaScript, σταδιακά καταργείται)"

msgid "mime_conf"
msgstr "Αρχείο ρυθμίσεων (αποθηκεύει τη διαμόρφωση λογισμικού σε μορφή κειμένου, κοινές μορφές: INI, JSON, YAML, TOML, XML. Η διαμόρφωση συστήματος Linux βρίσκεται κυρίως στον κατάλογο /etc)"

msgid "mime_css"
msgstr "Φύλλο στυλ CSS (Το W3C δημοσίευσε το πρώτο επίσημο πρότυπο CSS1 τον Δεκέμβριο του 1996, το CSS2 πρόσθεσε τοποθέτηση και τύπους μέσων το 1998, από το 2011 η αρθρωτή CSS3 εισήγαγε στρογγυλεμένες γωνίες, κινούμενα σχέδια, εύκαμπτο κουτί, διάταξη πλέγματος και σχεδιασμό απόκρισης. Μαζί με HTML και JavaScript αποτελεί μία από τις τρεις κύριες τεχνολογίες front-end, όλα τα σύγχρονα προγράμματα περιήγησης (Chrome, Firefox, Safari, Edge) την υποστηρίζουν εγγενώς, είναι το μοναδικό πρότυπο για τον ορισμό στυλ ιστοσελίδων)"

msgid "mime_xsl"
msgstr "Φύλλο στυλ XSL (πρότυπο W3C του 1999, γλώσσα μετασχηματισμού εγγράφων XML, μπορεί να μετατρέψει XML σε HTML/PDF/κείμενο. Η χρήση της έχει μειωθεί μετά τη διάδοση του JSON)"

msgid "mime_runtime"
msgstr "Εκτελέσιμο αρχείο (εκτελέσιμη μορφή λειτουργικού συστήματος όπως EXE, ELF, Mach-O, περιέχει κώδικα μηχανής και πληροφορίες φόρτωσης)"

msgid "mime_library"
msgstr "Αρχείο βιβλιοθήκης (DLL, SO, dylib κ.λπ., δυναμικά συνδεδεμένες βιβλιοθήκες, κοινόχρηστος κώδικας που φορτώνει το πρόγραμμα κατά την εκτέλεση)"

msgid "mime_swf"
msgstr "Κινούμενο σχέδιο Flash (Η Macromedia το ανέπτυξε το 1996, αργότερα στην κατοχή της Adobe. Διαδραστικό πρότυπο κινούμενων σχεδίων ιστού, κάποτε κυριαρχούσε σε κινούμενα σχέδια και παιχνίδια στο διαδίκτυο. Μειονεκτήματα: απαιτεί πρόσθετο, δεν υποστηρίζεται σε κινητές συσκευές, υψηλός κίνδυνος ασφαλείας. Η Adobe ανακοίνωσε την κατάργησή του το 2017, διέκοψε εντελώς την υποστήριξη το 2020, αντικαταστάθηκε από HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "Ορισμός τύπου εγγράφου DTD (προδιαγραφή XML, ορίζει τη δομή ενός εγγράφου XML, χρησιμοποιείται για την επικύρωση της ορθότητας XML)"

msgid "mime_csv"
msgstr "Μορφή δεδομένων CSV (τιμές διαχωρισμένες με κόμμα, κοινή μορφή δεδομένων πίνακα, πρότυπο για εισαγωγή/εξαγωγή στο Excel και σε βάσεις δεδομένων)"

msgid "mime_jnlp"
msgstr "Java Web Start (εκκινητής εφαρμογών Java, τεχνολογία διανομής εφαρμογών επιφάνειας εργασίας Java της δεκαετίας του 2000, τώρα απαρχαιωμένη)"

msgid "mime_lit"
msgstr "Ηλεκτρονικό βιβλίο Microsoft Reader (Η Microsoft το κυκλοφόρησε το 2000, μορφή LIT, απαρχαιωμένο)"

msgid "mime_svg"
msgstr "Διανυσματικά γραφικά SVG (πρότυπο W3C του 1999, επειδή η Microsoft προωθούσε για μεγάλο χρονικό διάστημα τη δική της μορφή VML, το πρόγραμμα περιήγησης IE το υποστήριξε μόλις το 2011, γεγονός που καθυστέρησε την υιοθέτησή του. Μετά το 2015, με την κατάργηση του IE και τη διάδοση οθονών υψηλής ανάλυσης, έγινε η προτιμώμενη μορφή για εικονίδια και λογότυπα)"

msgid "mime_ai"
msgstr "Διανυσματικά γραφικά Adobe Illustrator (κυκλοφόρησε το 1987, διανυσματική μορφή γραφικών βιομηχανικού προτύπου, προτιμώμενη για σχεδιασμό εκτύπωσης, λογότυπα, εικονίδια)"

msgid "mime_phshop"
msgstr "Εικόνα Photoshop (Η Adobe την κυκλοφόρησε το 1990, αρχική μορφή αρχείου Photoshop PSD, βιομηχανικό πρότυπο για επεξεργασία εικόνας)"

msgid "mime_ttf"
msgstr "Γραμματοσειρά TrueType (Apple και Microsoft ανέπτυξαν από κοινού το 1989, μορφή διανυσματικής γραμματοσειράς, η προβολή στην οθόνη και η εκτύπωση είναι συνεπείς, προεπιλεγμένη μορφή γραμματοσειράς σύγχρονων λειτουργικών συστημάτων)"

msgid "mime_fon"
msgstr "Γραμματοσειρά ιστού WOFF2 (σύσταση W3C του 2014, χρησιμοποιεί αλγόριθμο συμπίεσης Brotli, σε σύγκριση με παλαιότερο WOFF ο όγκος μειώνεται κατά περίπου 30%, σε σύγκριση με TTF/OTF μειώνεται κατά πάνω από 50%, υποστηρίζεται από όλα τα σύγχρονα προγράμματα περιήγησης, είναι η προτιμώμενη μορφή για σύγχρονες γραμματοσειρές ιστού, υποστηρίζεται από πάνω από 98% των προγραμμάτων περιήγησης)"

msgid "mime_pdf"
msgstr "Έγγραφο PDF (Η Adobe το ανέπτυξε το 1993, έγινε πρότυπο ISO το 2008. Μορφή εγγράφου ανεξάρτητη από πλατφόρμα, διατηρεί συνέπεια μορφοποίησης, είναι το παγκόσμιο πρότυπο για τη διανομή ηλεκτρονικών εγγράφων)"

msgid "mime_dotnet"
msgstr "Δυναμική σελίδα ASP.NET (Η Microsoft την κυκλοφόρησε το 2002, τεχνολογία δυναμικών ιστοσελίδων σε πλατφόρμα Windows, μέρος του .NET Framework)"

msgid "mime_mdb"
msgstr "Βάση δεδομένων Access (αρχείο βάσης δεδομένων Microsoft Access, κυκλοφόρησε το 1992, λύση βάσης δεδομένων επιφάνειας εργασίας Windows)"

msgid "mime_md"
msgstr "Έγγραφο Markdown (δημιουργήθηκε από τον John Gruber το 2004, σχεδιασμός σύνταξης επηρεασμένος από reStructuredText και Setext. Η βασική φιλοσοφία σχεδιασμού είναι 'η αναγνωσιμότητα σημαίνει δυνατότητα απόδοσης', η αρχική υλοποίηση Markdown.pl χρησιμοποιεί κανονικές εκφράσεις Perl. Οι παράγωγες προδιαγραφές περιλαμβάνουν GFM (2013), CommonMark (2017), Pandoc Markdown κ.λπ. Τροφοδοτεί οικοσυστήματα όπως GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, καθιστώντας το την πραγματική πρότυπη μορφή για στατικούς δημιουργούς ιστοσελίδων και τεκμηρίωση προγραμματιστών)"

msgid "mime_crystal"
msgstr "Μορφή αναφοράς Crystal Reports (επιχειρηματική νοημοσύνη SAP, πρότυπη μορφή για εταιρικές αναφορές)"

msgid "mime_libreoffice"
msgstr "Έγγραφο LibreOffice (Το The Document Foundation το ανέπτυξε το 2010, κλάδος του OpenOffice, υλοποίηση του προτύπου ODF, η κύρια σουίτα γραφείου ανοιχτού κώδικα)"

msgid "mime_encrypt"
msgstr "Κρυπτογραφημένο αρχείο (απαιτείται αποκρυπτογράφηση για προβολή, συνήθεις επεκτάσεις: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Δεδομένα διαδρομής GPS (μορφή ανταλλαγής GPS, καταγράφει γεωγραφικές πληροφορίες, κοινή μορφή για αθλητικά ρολόγια και συσκευές πλοήγησης)"

msgid "mime_diskimage"
msgstr "Εικόνα δίσκου (αρχεία εικόνας δίσκου/CD-ROM όπως DMG, ISO, IMG, χρησιμοποιούνται για διανομή λογισμικού ή δημιουργία αντιγράφων ασφαλείας μέσων αποθήκευσης)"

msgid "mime_vm"
msgstr "Εικόνα εικονικής μηχανής (αρχεία εικονικού δίσκου όπως VMDK, VDI, VHDX, OVA, μορφές για πλατφόρμες εικονικοποίησης όπως VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "Αρχείο torrent BitTorrent (Ο Bram Cohen το εφηύρε το 2001, αρχείο ευρετηρίου για λήψεις P2P, περιέχει μεταδεδομένα αρχείου και πληροφορίες Tracker)"

msgid "mime_gis"
msgstr "Δεδομένα γεωγραφικού πληροφοριακού συστήματος GIS (γεωχωρικά δεδομένα όπως Shapefile, GeoJSON, χρησιμοποιούνται για χάρτες και χωρική ανάλυση)"

msgid "mime_ebook"
msgstr "Ηλεκτρονικό βιβλίο (μορφές ηλεκτρονικών βιβλίων όπως EPUB, MOBI, AZW. Το EPUB είναι το διεθνές πρότυπο, MOBI/AZW είναι μορφές για Amazon Kindle)"

msgid "mime_avif"
msgstr "Εικόνα AVIF (κυκλοφόρησε από την Alliance for Open Media το 2019, βασισμένη στην κωδικοποίηση AV1, ρυθμός συμπίεσης 50% καλύτερος από το WebP, νέο πρότυπο εικόνας ιστού)"

msgid "mime_markdown"
msgstr "Έγγραφο Markdown (σχεδιάστηκε από τον John Gruber το 2004, ελαφριά γλώσσα σήμανσης, κοινή μορφή για README GitHub, τεχνική τεκμηρίωση, αναρτήσεις φόρουμ)"

msgid "mime_yaml"
msgstr "Ρύθμιση YAML (σχεδιάστηκε από τον Clark Evans το 2001, αναγνώσιμη από τον άνθρωπο μορφή σειριοποίησης δεδομένων, πρότυπο για αρχεία ρυθμίσεων για Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Ρύθμιση TOML (σχεδιάστηκε από τον Tom Preston-Werner το 2013, 'Tom's Obvious Minimal Language', μορφή αρχείου ρυθμίσεων για σύγχρονα εργαλεία όπως Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Αρχείο συστατικού Vue (παρουσιάστηκε το 2014 από τον Evan You, προοδευτικό πλαίσιο JavaScript. Μέσω συστατικών ενός αρχείου (SFC) συνδυάζει τέλεια HTML, CSS και JS, αυξάνοντας σημαντικά την αποδοτικότητα ανάπτυξης. Είναι ένα από τα πιο δημοφιλή frontend πλαίσια παγκοσμίως. Επίσης, ως πυρήνας σύγχρονων γεννητριών στατικών ιστοτόπων όπως το VitePress, χρησιμοποιείται ευρέως για την τροφοδοσία διαδραστικής τεχνικής τεκμηρίωσης και ιστολογίων.)"

msgid "mime_wasm"
msgstr "Μονάδα WebAssembly (πρότυπο W3C από το 2017, μορφή εκτέλεσης υψηλής απόδοσης στο πρόγραμμα περιήγησης, C/C++/Rust/R μπορούν να μεταγλωττιστούν ως στόχος, απόδοση κοντά στην εγγενή)"

msgid "mime_jsx"
msgstr "Στοιχείο React JSX (Η Facebook κυκλοφόρησε το JavaScript XML το 2013, σύνταξη στοιχείου του πλαισίου React, καινοτόμο παράδειγμα που εισάγει HTML σε JavaScript)"

msgid "mime_tsx"
msgstr "Στοιχείο TypeScript TSX (αναπτύχθηκε από τη Microsoft το 2012, TypeScript + JSX, τυπικός τρόπος γραφής για ανάπτυξη React με ασφάλεια τύπου)"

msgid "mime_heif"
msgstr "Εικόνα HEIF (πρότυπο MPEG του 2015, μορφή αρχείου εικόνας υψηλής απόδοσης, ευρέως χρησιμοποιούμενη στο οικοσύστημα Apple)"

msgid "mime_heic"
msgstr "Εικόνα HEIC (υλοποίηση HEIF από την Apple, προεπιλεγμένη μορφή φωτογραφίας στο iPhone, υποστηρίζεται εγγενώς σε iOS/macOS)"

msgid "mime_gltf"
msgstr "3D μοντέλο GLTF (μορφή μεταφοράς GL, 'JPEG του 3D κόσμου', η Khronos Group το εξέδωσε το 2015, πρότυπη μορφή για Web 3D)"

msgid "mime_glb"
msgstr "Δυαδικό 3D μοντέλο GLB (δυαδική έκδοση του GLTF, ένα μόνο αρχείο περιέχει όλους τους πόρους, χρησιμοποιείται για διανομή 3D σκηνών)"

msgid "mime_gls"
msgstr "Γλωσσάρι GLOSSARY (αρχείο ορισμών όρων, για διαχείριση όρων σε συστήματα τεκμηρίωσης)"

msgid "mime_cbz"
msgstr "Κόμικς CBZ (εικόνες κόμικς συμπιεσμένες με ZIP, κοινή μορφή για συλλογή κόμικς)"

msgid "mime_cbr"
msgstr "Κόμικς CBR (εικόνες κόμικς συμπιεσμένες με RAR, κοινή μορφή για συλλογή κόμικς)"

msgid "mime_fb2"
msgstr "Ηλεκτρονικό βιβλίο FB2 (FictionBook 2.0, ρωσική μορφή ηλεκτρονικού βιβλίου, δομή XML, ευρέως υποστηριζόμενη από αναγνώστες ανοιχτού κώδικα)"

msgid "mime_kepub"
msgstr "Ηλεκτρονικό βιβλίο KEPUB (ειδική μορφή EPUB για Kobo, βελτιστοποιημένη μορφή για τον αναγνώστη ηλεκτρονικών βιβλίων Kobo)"

msgid "mime_m4b"
msgstr "Ηχητικό βιβλίο M4B (μορφή ήχου MPEG-4 για βιβλία, υποστηρίζει σελιδοδείκτες, μορφή ηχητικού βιβλίου iTunes)"

msgid "mime_kfx"
msgstr "Μορφή Kindle KFX (Η Amazon την κυκλοφόρησε το 2015, ειδική μορφή ηλεκτρονικού βιβλίου για Kindle, υποστηρίζει προηγμένη διάταξη και γρήγορη ανατροπή σελίδων)"

msgid "mime_chm"
msgstr "Αρχείο βοήθειας CHM (Η Microsoft το κυκλοφόρησε το 1997, μεταγλωττισμένη μορφή βοήθειας HTML, πρότυπο για τεκμηρίωση βοήθειας λογισμικού Windows)"

msgid "mime_mht"
msgstr "Αρχείο ιστού MHT (Η Microsoft το κυκλοφόρησε το 1999, μορφή ιστοσελίδας σε ένα αρχείο, μορφή αποθήκευσης ιστοσελίδων του προγράμματος περιήγησης IE)"

msgid "mime_wml"
msgstr "Γλώσσα σήμανσης ασύρματης δικτύωσης WML (πρότυπο WAP του 1999, χρησιμοποιείται για ιστοσελίδες σε πρώιμα τηλέφωνα, απαρχαιωμένο)"

msgid "mime_xhtml"
msgstr "Ιστοσελίδα XHTML (πρότυπο W3C του 2000, έκδοση XML της HTML, αυστηρότερη σύνταξη. Το W3C σταμάτησε τη συντήρηση το 2009, μετατοπίζοντας την εστίαση στο HTML5)"

msgid "mime_xml"
msgstr "Έγγραφο XML (πρότυπο W3C του 1998, επεκτάσιμη γλώσσα σήμανσης, βασική μορφή για υπηρεσίες ιστού, αρχεία ρυθμίσεων, ανταλλαγή δεδομένων)"

msgid "mime_sgml"
msgstr "Έγγραφο SGML (πρότυπο ISO του 1986, πρόδρομος της HTML, τυπική γενική γλώσσα σήμανσης, τόσο το XML όσο και η HTML προέρχονται από το SGML)"

msgid "mime_apng"
msgstr "Κινούμενο σχέδιο APNG (Η Mozilla το ανέπτυξε το 2004, επέκταση κινούμενων σχεδίων του PNG, σύγχρονη αντικατάσταση του GIF, υποστηρίζει πραγματικά χρώματα και διαφάνεια)"

msgid "mime_bmp"
msgstr "BMP εικόνα bitmap (Μορφή bitmap των Windows, εγγενώς υποστηριζόμενη από τα Windows 1.0. Χωρίς συμπίεση, μεγάλο μέγεθος αρχείου, αλλά λόγω της απλής δομής και της έλλειψης ανάγκης για πρόσθετους κωδικοποιητές, εξακολουθεί να χρησιμοποιείται στο εργαλείο αποκομμάτων των Windows 11, στο πρόγραμμα Ζωγραφική, σε πόρους εικονιδίων σε πακέτα εγκατάστασης EXE/MSI, σε αρχεία δρομέα και σε ορισμένα παλαιότερα προγράμματα οδήγησης. Στην ίδια ποιότητα εικόνας, το μέγεθος αρχείου είναι περίπου 3-10 φορές μεγαλύτερο από το PNG. Στις περισσότερες περιπτώσεις έχει αντικατασταθεί από PNG/JPEG, αλλά το οικοσύστημα των Windows εξακολουθεί να διατηρεί ευρεία συμβατότητα)"

msgid "mime_cdr"
msgstr "Διανυσματικά γραφικά CDR (ειδική μορφή του CorelDRAW, καναδική εταιρεία Corel, λογισμικό σχεδιασμού διανυσματικών γραφικών)"

msgid "mime_gif"
msgstr "Εικόνα GIF (Η CompuServe την ανέπτυξε το 1987, μορφή εικόνας κινούμενων σχεδίων 256 χρωμάτων. Μειονεκτήματα: λίγα χρώματα, τραχιά ποιότητα εικόνας, δεν υποστηρίζει διαφάνεια, μεγάλο αρχείο, χαμηλή συχνότητα καρέ. Αντικαταστάθηκε από σύγχρονες μορφές κινούμενων σχεδίων όπως APNG, WebP)"

msgid "mime_ico"
msgstr "Εικονίδιο ICO (μορφή εικονιδίου Windows, υποστηρίζει πολλαπλές αναλύσεις, τυπική μορφή για το favicon ιστοσελίδων)"

msgid "mime_jpeg"
msgstr "Εικόνα JPEG (πρότυπο ISO του 1992, μορφή συμπίεσης με απώλειες για φωτογραφίες, de facto πρότυπο για φωτογραφίες στο διαδίκτυο)"

msgid "mime_jpg"
msgstr "Εικόνα JPEG (πρότυπο ISO του 1992, μορφή συμπίεσης με απώλειες για φωτογραφίες, de facto πρότυπο για φωτογραφίες στο διαδίκτυο)"

msgid "mime_png"
msgstr "Εικόνα PNG (σύσταση W3C του 1996, υποστηρίζει πραγματικά χρώματα και διαφάνεια, στατική αντικατάσταση του GIF, πρότυπο για εικόνες χωρίς απώλειες στο διαδίκτυο)"

msgid "mime_ps"
msgstr "Αρχείο περιγραφής σελίδας PostScript (Η Adobe το κυκλοφόρησε το 1985, γλώσσα περιγραφής σελίδας, πρόδρομος του PDF, χρησιμοποιείται για εκτύπωση και έκδοση)"

msgid "mime_psb"
msgstr "Μεγάλο έγγραφο PSB (μορφή Adobe Photoshop για εξαιρετικά μεγάλες εικόνες, υποστηρίζει γιγάντιες εικόνες άνω των 2 GB ή 30000 pixel)"

msgid "mime_psd"
msgstr "Εικόνα PSD (αρχείο πηγαίου κώδικα Adobe Photoshop, υποστηρίζει επίπεδα, κανάλια, διαδρομές, πρότυπο βιομηχανίας για επεξεργασία εικόνας)"

msgid "mime_webp"
msgstr "Εικόνα WebP (Η Google την ανέπτυξε το 2010, μορφή εικόνας ιστού, υποστηρίζει συμπίεση με απώλειες/χωρίς απώλειες και κινούμενα σχέδια, ρυθμός συμπίεσης 25-35% καλύτερος από το PNG και 25% καλύτερος από το JPEG)"

msgid "mime_woff"
msgstr "Γραμματοσειρά ιστού WOFF (δημιουργήθηκε το 2009, πρότυπο W3C από το 2018. Συμπιεσμένη με βάση τα TrueType/OpenType, βελτιστοποιημένη για φόρτωση γραμματοσειρών ιστού, τυπική μορφή για γραμματοσειρές εικονιδίων σύγχρονων ιστοσελίδων)"

msgid "mime_7z"
msgstr "Συμπιεσμένο αρχείο 7z (Ο Igor Pavlov το ανέπτυξε το 1999, ειδική μορφή του προγράμματος 7-Zip. Αλγόριθμος LZMA, υψηλός ρυθμός συμπίεσης, ανοιχτός κώδικας και δωρεάν. Η μορφή 7z είναι συνήθως 30-50% μικρότερη από το ZIP με τον ίδιο ρυθμό συμπίεσης, κοινή μορφή στην κοινότητα ανοιχτού κώδικα και για διανομή λογισμικού)"

msgid "mime_ace"
msgstr "Συμπιεσμένο αρχείο ACE (αναπτύχθηκε τη δεκαετία του 1990, μορφή του προγράμματος WinACE. Κάποτε ανταγωνιζόταν το RAR, ο ρυθμός συμπίεσης ήταν αρκετά υψηλός. Η ανάπτυξη σταμάτησε το 2007, τώρα αντικαταστάθηκε από 7z/RAR, σπάνια χρησιμοποιείται)"

msgid "mime_bz2"
msgstr "Συμπιεσμένο αρχείο BZIP2 (Ο Julian Seward το ανέπτυξε το 1996, αλγόριθμος συμπίεσης ταξινόμησης μπλοκ. Ο ρυθμός συμπίεσης είναι 15-20% υψηλότερος από το GZIP αλλά πιο αργός. Κοινή μορφή για τον πηγαίο κώδικα του πυρήνα Linux, πακέτα λογισμικού ανοιχτού κώδικα, επέκταση .bz2)"

msgid "mime_cab"
msgstr "Συμπιεσμένο αρχείο CAB (Η Microsoft το ανέπτυξε το 1995, μορφή Cabinet. Μορφή πακέτου εγκατάστασης για Windows, χρησιμοποιείται για προγράμματα οδήγησης, διανομή αρχείων συστήματος. Το Windows Installer (MSI) χρησιμοποιεί εσωτερικά CAB για την αποθήκευση αρχείων)"

msgid "mime_dmg"
msgstr "Εικόνα δίσκου DMG (Η Apple την εισήγαγε τη δεκαετία του 1980, μορφή Disk Image. Τυπική μορφή για διανομή λογισμικού macOS, διπλό κλικ για προσάρτηση ως εικονικός δίσκος, μεταφορά και απόθεση για εγκατάσταση της εφαρμογής. Υποστηρίζει συμπίεση και κρυπτογράφηση, είναι η κύρια μορφή για λήψη λογισμικού Mac)"

msgid "mime_emz"
msgstr "Συμπιεσμένη εικόνα EMZ (Windows συμπιεσμένο βελτιωμένο μετα-αρχείο, συμπιεσμένη έκδοση του EMF. Μορφή αποθήκευσης διανυσματικών γραφικών σε έγγραφα Office, στην ουσία είναι ένα αρχείο EMF συμπιεσμένο με GZIP)"

msgid "mime_gz"
msgstr "Συμπιεσμένο αρχείο GZIP (Οι Jean-loup Gailly και Mark Adler το ανέπτυξαν το 1992, έργο GNU. Τυπικό εργαλείο συμπίεσης σε Unix/Linux, κοινή μορφή για συμπίεση μεταφοράς HTTP. Επέκταση .gz, συχνά χρησιμοποιείται μαζί με TAR)"

msgid "mime_jar"
msgstr "Συμπιεσμένο αρχείο JAR (Η Sun Microsystems το κυκλοφόρησε το 1997, μορφή Java ARchive. Στην ουσία είναι ένα αρχείο ZIP, χρησιμοποιείται για τη συσκευασία βιβλιοθηκών και εφαρμογών Java. Βασική μορφή του οικοσυστήματος Java όπως Maven, Gradle. Το Android χρησιμοποιεί επίσης JAR)"

msgid "mime_lzma"
msgstr "Συμπιεσμένο αρχείο LZMA (Ο Igor Pavlov το ανέπτυξε το 1998, αλγόριθμος Lempel-Ziv-Markov chain. Κύριος αλγόριθμος συμπίεσης της μορφής 7z, υψηλός ρυθμός συμπίεσης, γρήγορη ταχύτητα αποσυμπίεσης. Χρησιμοποιείται για διανομή υλικολογισμικού και λογισμικού για ενσωματωμένα συστήματα)"

msgid "mime_rar"
msgstr "Συμπιεσμένο αρχείο RAR (Ο Eugene Roshal το ανέπτυξε το 1993, μορφή Roshal ARchive. Υψηλός ρυθμός συμπίεσης, υποστηρίζει διαχωρισμό σε τόμους και εγγραφές ανάκτησης. Μορφή του προγράμματος WinRAR, ο ρυθμός συμπίεσης είναι καλύτερος από το ZIP αλλά απαιτεί λογισμικό επί πληρωμή, εργαλεία ανοιχτού κώδικα όπως το unrar μπορούν να αποσυμπιέσουν)"

msgid "mime_tar"
msgstr "Αρχείο TAR (Το Unix V7 το εισήγαγε το 1979, μορφή Tape ARchive. Αρχείο ταινίας, μόνο πακετάρει χωρίς συμπίεση, συχνά χρησιμοποιείται μαζί με GZIP/BZIP2/XZ. Ο πηγαίος κώδικας πακέτων Linux, η αποθήκευση στρωμάτων εικόνων Docker χρησιμοποιεί τη μορφή TAR)"

msgid "mime_tgz"
msgstr "Συμπιεσμένο αρχείο TGZ (συνδυασμένη μορφή TAR + GZIP, επέκταση .tgz ή .tar.gz. Η πιο κοινή μορφή για διανομή πακέτων λογισμικού Unix/Linux, πακέτα πηγαίου κώδικα, δυαδικά πακέτα, ευρέως χρησιμοποιούμενη, αντιπροσωπεύει 'αποσυμπίεση και χρήση')"

msgid "mime_tbz2"
msgstr "Συμπιεσμένο αρχείο TBZ2 (συνδυασμένη μορφή TAR + BZIP2, επέκταση .tbz2 ή .tar.bz2. Ο ρυθμός συμπίεσης 15-20% υψηλότερος από το TGZ, κατάλληλο για διανομή μεγάλων αρχείων, ο πυρήνας Linux χρησιμοποιούσε αυτή τη μορφή για μεγάλο χρονικό διάστημα)"

msgid "mime_xz"
msgstr "Συμπιεσμένο αρχείο XZ (εισήχθη το 2009, βασισμένο στον αλγόριθμο LZMA2. Εξαιρετικά υψηλός ρυθμός συμπίεσης, 30-50% καλύτερος από το GZIP, ταχύτητα αποσυμπίεσης σχετικά γρήγορη. Ο πυρήνας Linux, οι διαχειριστές πακέτων (όπως μέσα στο .deb του Debian) το χρησιμοποιούν ευρέως, προτεινόμενη μορφή στο τρέχον οικοσύστημα Linux)"

msgid "mime_z"
msgstr "Συμπιεσμένο αρχείο Z (μορφή της εντολής Unix compress του 1985, αλγόριθμος LZW. Παλαιά μορφή συμπίεσης Unix, αντικαταστάθηκε από GZIP. Επέκταση .Z, τα σύγχρονα συστήματα την χρησιμοποιούν σπάνια)"

msgid "mime_zip"
msgstr "Συμπιεσμένο αρχείο ZIP (Ο Phil Katz το ανέπτυξε το 1989, μορφή PKZIP. Τα Windows το υποστηρίζουν εγγενώς, η πιο κοινή μορφή συμπίεσης στο διαδίκτυο. Υποστηρίζει πολλά αρχεία, δομή καταλόγου, μπορεί να επιλέξει αλγόριθμο συμπίεσης. Το JAR της Java, το APK του Android, τα DOCX/XLSX από έγγραφα Office βασίζονται στη μορφή ZIP)"

msgid "mime_zst"
msgstr "Συμπιεσμένο αρχείο Zstandard (Η Facebook το ανέπτυξε το 2015, σχεδιάστηκε από τον Yann Collet. Αλγόριθμος συμπίεσης υψηλής ταχύτητας, ρυθμός συμπίεσης κοντά στο LZMA, ταχύτητα πολύ μεγαλύτερη από το GZIP. Ο πυρήνας Linux 5.9+ το υποστηρίζει, το Arch Linux pacman, το Debian APT το εισάγουν σταδιακά, νέα γενιά προτύπου συμπίεσης)"

msgid "mime_lz4"
msgstr "Συμπιεσμένο αρχείο LZ4 (Ο Yann Collet το ανέπτυξε το 2011, εξαιρετικά γρήγορος αλγόριθμος συμπίεσης. Η ταχύτητα συμπίεσης είναι πάνω από 10 φορές ταχύτερη από το GZIP, κατάλληλο για σενάρια συμπίεσης σε πραγματικό χρόνο. Ο πυρήνας Linux, το OpenZFS, το Hadoop το χρησιμοποιούν ευρέως, πρώτη επιλογή για σενάρια όπου η ταχύτητα είναι προτεραιότητα)"

msgid "mime_lzo"
msgstr "Συμπιεσμένο αρχείο LZO (Ο Markus Oberhumer το ανέπτυξε το 1996, αλγόριθμος Lempel-Ziv-Oberhumer. Η ταχύτητα αποσυμπίεσης είναι εξαιρετικά γρήγορη, ο ρυθμός συμπίεσης είναι μέσος. Ο πυρήνας Linux Squashfs, το υλικολογισμικό OpenWrt το χρησιμοποιούν, κατάλληλο για ενσωματωμένα συστήματα)"

msgid "mime_msi"
msgstr "Πακέτο εγκατάστασης MSI (Η Microsoft το κυκλοφόρησε το 1999, μορφή πακέτου Windows Installer. Τυπική μορφή εγκατάστασης για εφαρμογές Windows, υποστηρίζει επαναφορά συναλλαγών, διαχείριση στοιχείων, σίγουρη εγκατάσταση. Πρώτη επιλογή για διανομή λογισμικού σε επίπεδο επιχείρησης, παραμένει η κύρια μορφή για εγκατάσταση λογισμικού Windows μέχρι σήμερα)"

msgid "mime_pkg"
msgstr "Πακέτο εγκατάστασης PKG (μορφή πακέτου εγκατάστασης εφαρμογών macOS, βασισμένη στην τεχνολογία Installer της Apple. Τυπική μορφή για διανομή λογισμικού macOS, υποστηρίζει επιλογή στοιχείων, δέσμες ενεργειών εγκατάστασης, λειτουργία απεγκατάστασης. Διπλό κλικ στο αρχείο .pkg για εγκατάσταση, κοινή μέθοδος διανομής για λογισμικό εκτός του Mac App Store)"

msgid "mime_apk"
msgstr "APK πακέτο εφαρμογών Android (παρουσιάστηκε από την Google το 2008, παραδοσιακή μορφή εγκατάστασης εφαρμογών Android. Το APK είναι ουσιαστικά ένα πακέτο ZIP που περιέχει κώδικα, πόρους και αρχείο εκδήλωσης. Από το 2021, το Google Play απαιτεί οι νέες εφαρμογές να χρησιμοποιούν τη μορφή AAB, αλλά το APK εξακολουθεί να χρησιμοποιείται για εντοπισμό σφαλμάτων, καταστήματα τρίτων και πλευρική φόρτωση)"

msgid "mime_ipa"
msgstr "IPA πακέτο εφαρμογών iOS (iOS App Store Package, μορφή εγκατάστασης εφαρμογών iOS/iPadOS. Παρουσιάστηκε το 2008 με το iPhone SDK. Πρέπει να διανέμεται μέσω του App Store ή να υπογράφεται με εταιρικό πιστοποιητικό. Περιέχει εκτελέσιμο αρχείο, πόρους, Info.plist και πληροφορίες υπογραφής)"

msgid "mime_hap"
msgstr "HAP πακέτο εφαρμογών HarmonyOS (HarmonyOS Ability Package, βασική μονάδα εφαρμογής HarmonyOS. Παρουσιάστηκε το 2020 με το HarmonyOS 2.0. Υποστηρίζει δύο τύπους: entry και feature, μορφή διανομής για τηλέφωνα Huawei, tablet, smartwatches και άλλες συσκευές HarmonyOS)"

msgid "mime_har"
msgstr "HAR στατική κοινόχρηστη βιβλιοθήκη HarmonyOS (HarmonyOS Archive, στατική κοινόχρηστη βιβλιοθήκη του HarmonyOS, μπορεί να κοινοποιηθεί από πολλά πακέτα HAP, χρησιμοποιείται για ανάπτυξη βασισμένη σε συστατικά και επαναχρησιμοποίηση ενοτήτων)"

msgid "mime_aab"
msgstr "Android App Bundle (Η Google το κυκλοφόρησε το 2018, από το 2021 το Google Play επιβάλλει νέες εφαρμογές να χρησιμοποιούν αυτή τη μορφή. Το AAB είναι μια μορφή διανομής, το Google Play δημιουργεί βελτιστοποιημένα APK ανάλογα με τη διαμόρφωση της συσκευής (αρχιτεκτονική CPU, πυκνότητα οθόνης, γλώσσα), το μέγεθος του πακέτου εγκατάστασης μειώνεται κατά μέσο όρο 35%. Οι προγραμματιστές ανεβάζουν AAB, οι χρήστες κατεβάζουν APK)"

msgid "mime_xapk"
msgstr "Πακέτο εφαρμογής XAPK (πακέτο επέκτασης εφαρμογών Android τρίτων, περιέχει APK + αρχεία δεδομένων OBB. Χρησιμοποιείται για μεγάλα παιχνίδια και πολύπλοκες εφαρμογές, λύνει το όριο των 100 MB για ένα μόνο αρχείο APK. Συνήθες σε καταστήματα εφαρμογών τρίτων όπως APKPure, APKMirror, δεν είναι επίσημη μορφή Google)"

msgid "mime_appx"
msgstr "Πακέτο εφαρμογής Windows (Η Microsoft το κυκλοφόρησε το 2012, μορφή εγκατάστασης για εφαρμογές Windows 8/10/11. Υποστηρίζει εφαρμογές UWP και μετατροπή εφαρμογών επιφάνειας εργασίας, διανέμεται μέσω του Microsoft Store. Το 2024, η Microsoft κυκλοφόρησε το MSIX ως διάδοχο, αντικαθιστώντας σταδιακά το APPX)"

msgid "mime_msix"
msgstr "Πακέτο εφαρμογής MSIX (Η Microsoft το κυκλοφόρησε το 2018, νέα γενιά μορφής συσκευασίας για εφαρμογές Windows. Συνδυάζει τα πλεονεκτήματα των APPX και MSI, υποστηρίζει όλους τους τύπους εφαρμογών Windows, μπορεί να διανέμεται μέσω του Microsoft Store ή με πλευρική φόρτωση, προτεινόμενη μορφή για Windows 11)"

msgid "mime_appimage"
msgstr "Πακέτο εφαρμογής AppImage (εισήχθη το 2004, μορφή εφαρμογής Linux χωρίς εγκατάσταση. 'Μία εφαρμογή - ένα αρχείο', εκτελείται απευθείας χωρίς εγκατάσταση, υποστηρίζει τις περισσότερες διανομές Linux, κοινή μέθοδος για προγραμματιστές να διανέμουν λογισμικό Linux)"

msgid "mime_flatpak"
msgstr "Πακέτο εφαρμογής Flatpak (εισήχθη το 2015, μορφή εφαρμογής Linux σε απομονωμένο περιβάλλον. Λειτουργεί σε διανομές, απομονωμένο από το σύστημα υποδοχής, η ανάπτυξη καθοδηγείται από Fedora και Red Hat, προεπιλεγμένη μορφή του GNOME Software Center)"

msgid "mime_snap"
msgstr "Πακέτο εφαρμογής Snap (Η Canonical το κυκλοφόρησε το 2014, η μητρική εταιρεία του Ubuntu το ανέπτυξε, καθολική μορφή εφαρμογής Linux. Αυτόματη ενημέρωση, απομόνωση σε απομονωμένο περιβάλλον, υποστηρίζει 40+ διανομές Linux, προεπιλεγμένη μορφή του Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Πακέτο λογισμικού Debian (το έργο Debian το κυκλοφόρησε το 1993, τυπική μορφή εγκατάστασης για Debian/Ubuntu και τα παράγωγά τους. Διαχειρίζεται χρησιμοποιώντας dpkg, το APT είναι ο διαχειριστής πακέτων front-end του, μία από τις πιο ώριμες μορφές πακέτων στο οικοσύστημα Linux, παραμένει η κύρια στην οικογένεια Debian μέχρι σήμερα)"

msgid "mime_rpm"
msgstr "Πακέτο λογισμικού RPM (Η Red Hat το κυκλοφόρησε το 1997, τυπική μορφή για διανομές όπως Red Hat/Fedora/CentOS/SUSE. RPM σημαίνει 'Red Hat Package Manager', μαζί με το DEB αποτελούν τις δύο κύριες μορφές πακέτων Linux, παραμένει η κύρια στην οικογένεια RHEL μέχρι σήμερα)"

msgid "mime_pacman"
msgstr "Πακέτο λογισμικού Arch (το Arch Linux το κυκλοφόρησε το 2002, μορφή .pkg.tar.zst που χρησιμοποιεί ο διαχειριστής πακέτων pacman. Ο πυρήνας των rolling release διανομών Arch Linux, γνωστός για την απλότητά του και την αρχή KISS, το AUR (Arch User Repository) είναι το χαρακτηριστικό του γνώρισμα)"

msgid "mime_exe"
msgstr "Εκτελέσιμο αρχείο EXE (μορφή εκτελέσιμου προγράμματος Windows, συντομογραφία του 'Executable'. Εγγενής εκτελέσιμη μορφή του λειτουργικού συστήματος Windows, περιέχει τη δομή PE. Εξελίχθηκε από τη μορφή MZ από την εποχή του MS-DOS, τα Windows NT εισήγαγαν τη μορφή PE (Portable Executable) το 1993 και χρησιμοποιείται μέχρι σήμερα. Πακέτα εγκατάστασης λογισμικού, εφαρμογές, εργαλεία συστήματος χρησιμοποιούν αυτή τη μορφή. Ο χρήστης κάνει διπλό κλικ για να το εκτελέσει, είναι η πιο ευρέως χρησιμοποιούμενη εκτελέσιμη μορφή στον κόσμο)"

msgid "mime_dll"
msgstr "Δυναμική βιβλιοθήκη σύνδεσης DLL (Η Microsoft την εισήγαγε το 1993, Dynamic Link Library. Κοινόχρηστη βιβλιοθήκη κώδικα των Windows, το πρόγραμμα φορτώνεται δυναμικά κατά την εκτέλεση, εξοικονομεί μνήμη και χώρο στο δίσκο. Στοιχεία συστήματος, πρόσθετα εφαρμογών, προγράμματα οδήγησης χρησιμοποιούν τη μορφή DLL. Ο κύριος τρόπος υλοποίησης του API των Windows, το πρόβλημα 'DLL Hell' μετριάστηκε στην εποχή .NET)"

msgid "mime_com"
msgstr "Εκτελέσιμο αρχείο COM (εκτελέσιμη μορφή από την εποχή του MS-DOS, συντομογραφία του 'Command'. Πολύ απλή δομή αρχείου, περιορισμός 64KB, κύρια μορφή πριν από τα Windows 3.x, απαρχαιωμένο. Τα σύγχρονα Windows χρησιμοποιούν τη μορφή EXE, η επέκταση COM εξακολουθεί να χρησιμοποιείται για ορισμένα αρχεία στοιχείων)"

msgid "mime_aac"
msgstr "Ήχος AAC (πρότυπο MPEG του 1997, Advanced Audio Coding. Διάδοχος του MP3, ποιότητα ήχου καλύτερη από MP3 με την ίδια ταχύτητα bit, προεπιλεγμένη μορφή ήχου για YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Ήχος ALAC (Η Apple το ανέπτυξε το 2004, Apple Lossless Audio Codec. Η μορφή χωρίς απώλειες της Apple, έγινε ανοιχτού κώδικα το 2011, προεπιλεγμένη μορφή χωρίς απώλειες για iTunes και Apple Music)"

msgid "mime_flac"
msgstr "Ήχος FLAC (Το Xiph.Org Foundation το ανέπτυξε το 2001, Free Lossless Audio Codec. Συμπίεση χωρίς απώλειες, ποιότητα ήχου ίδια με CD, μέγεθος αρχείου περίπου το ήμισυ του αρχικού WAV. Ανοιχτού κώδικα και ελεύθερο διπλωμάτων ευρεσιτεχνίας, προτιμώμενη μορφή για audiophile και συλλογές ψηφιακής μουσικής)"

msgid "mime_mp3"
msgstr "Ήχος MP3 (Το Fraunhofer Institute το ανέπτυξε το 1993, MPEG-1 Audio Layer 3. Μορφή συμπίεσης με απώλειες, μικρό αρχείο με αποδεκτή ποιότητα ήχου, η κύρια μορφή της ψηφιακής μουσικής επανάστασης της δεκαετίας του 2000, υπεύθυνο για το iPod και το Napster. Τα διπλώματα ευρεσιτεχνίας έληξαν το 2017, έγινε μορφή δημόσιου τομέα)"

msgid "mime_oga"
msgstr "Ήχος Ogg Audio (αναπτύχθηκε από το Xiph.Org Foundation, καθαρή μορφή ήχου του δοχείου Ogg, χρησιμοποιεί κωδικοποίηση Vorbis. Ανοιχτού κώδικα και ελεύθερο διπλωμάτων ευρεσιτεχνίας, αποδοτικότητα συμπίεσης καλύτερη από MP3, ευρέως χρησιμοποιούμενο σε έργα ανοιχτού κώδικα)"

msgid "mime_ogg"
msgstr "Ήχος OGG (Το Xiph.Org Foundation το ανέπτυξε το 2000, μορφή Ogg Vorbis. Ανοιχτού κώδικα και ελεύθερο διπλωμάτων ευρεσιτεχνίας, αποδοτικότητα συμπίεσης καλύτερη από MP3, το πρώιμο Spotify το χρησιμοποιούσε, ευρέως χρησιμοποιούμενο για εφέ ήχου σε παιχνίδια)"

msgid "mime_opus"
msgstr "Ήχος Opus (η IETF το τυποποίησε το 2012, ανοιχτή και ελεύθερη διπλωμάτων ευρεσιτεχνίας μορφή ήχου, συνδυάζει τεχνολογίες SILK και CELT, εξαιρετικά χαμηλή καθυστέρηση, υψηλότερη αποδοτικότητα συμπίεσης, προεπιλεγμένη μορφή ήχου για WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Ήχος WAV (Η Microsoft και η IBM το ανέπτυξαν το 1991, εγγενής μορφή ήχου Windows. Κωδικοποίηση PCM, χωρίς συμπίεση, ποιότητα ήχου χωρίς απώλειες αλλά πολύ μεγάλο αρχείο, τυπική μορφή για επαγγελματική επεξεργασία ήχου)"

msgid "mime_wma"
msgstr "Ήχος WMA (Η Microsoft το ανέπτυξε το 1999, Windows Media Audio. Έχει εκδόσεις με απώλειες/χωρίς απώλειες, υποστηρίζεται εγγενώς από Windows, διαδόθηκε με το Windows Media Player. Τώρα είναι περιθωριοποιημένο, αντικαταστάθηκε από MP3/AAC)"

msgid "mime_dsf"
msgstr "Ήχος DSF (μορφή Direct Stream Digital, αναπτύχθηκε από Sony και Philips. Υψηλή συχνότητα δειγματοληψίας 1 bit, τυπική μορφή ήχου DSD, ψηφιακή έκδοση του SACD, μορφή ήχου υψηλής ποιότητας για audiofile, πολύ μεγάλο αρχείο)"

msgid "mime_ape"
msgstr "Ήχος APE (αναπτύχθηκε από την Monkey's Audio το 2000, μορφή συμπίεσης χωρίς απώλειες. Υψηλότερη συμπίεση από FLAC αλλά βραδύτερη κωδικοποίηση, εξακολουθεί να χρησιμοποιείται σε πλατφόρμα Windows και μεταξύ λάτρεις του ήχου)"

msgid "mime_mid"
msgstr "Ήχος MIDI (η MIDI Association το καθόρισε το 1983, Musical Instrument Digital Interface. Μορφή παρτιτούρας, όχι ηχογράφηση, πολύ μικρό αρχείο, πρότυπο για ηλεκτρονικά μουσικά όργανα, ήχους κλήσης τηλεφώνου, εφέ ήχου σε παιχνίδια. Το General MIDI τυποποιήθηκε το 1991, ορίζει 128 όργανα)"

msgid "mime_m4a"
msgstr "Ήχος M4A (MPEG-4 Audio, μορφή δοχείου για AAC. Τυπική μορφή του καταστήματος μουσικής iTunes, κύρια μορφή ήχου στο οικοσύστημα Apple, υποστηρίζει προστασία DRM)"

msgid "mime_m3u"
msgstr "Λίστα αναπαραγωγής M3U (μορφή λίστας αναπαραγωγής URL MP3, απλό αρχείο κειμένου, καταγράφει διαδρομές αρχείων ήχου. Πρότυπο από την εποχή του Winamp, χρησιμοποιείται για ραδιόφωνο στο διαδίκτυο, ροή μουσικής σε απευθείας σύνδεση. Το M3U8 είναι η έκδοση UTF-8 του, χρησιμοποιείται για HTTP Live Streaming)"

msgid "mime_asf"
msgstr "Ροή ASF (Η Microsoft το ανέπτυξε το 1996, Advanced Systems Format. Δοχείο ροής Windows Media, υποστηρίζει σύγχρονη μετάδοση ήχου και βίντεο. Χρησιμοποιείται για ζωντανές μεταδόσεις στο διαδίκτυο και ροή βίντεο κατά παραγγελία, τα WMA/WMV βασίζονται στο δοχείο ASF)"

msgid "mime_avi"
msgstr "Βίντεο AVI (Η Microsoft το κυκλοφόρησε το 1992, πρώιμο πρότυπο βίντεο Windows. 'Audio Video Interleave', εναλλάσσει ήχο και βίντεο, ήταν η πιο δημοφιλής μορφή βίντεο τη δεκαετία 1990-2000, τώρα έχει αντικατασταθεί από MP4/MKV)"

msgid "mime_divx"
msgstr "Βίντεο DivX (Η DivX Corporation το ανέπτυξε το 1998, μορφή κωδικοποιητή βίντεο βασισμένη σε MPEG-4. Η κύρια μορφή για διαδικτυακή κοινή χρήση βίντεο τη δεκαετία του 2000, η πρώτη τεχνολογία που συμπίεσε την ποιότητα DVD σε μέγεθος CD. Λόγω διαφωνιών πνευματικών δικαιωμάτων, αργότερα μετατράπηκε σε εμπορικό κωδικοποιητή)"

msgid "mime_mp4"
msgstr "Βίντεο MP4 (πρότυπο MPEG του 2001, MPEG-4 Μέρος 14. Η πιο διαδεδομένη μορφή βίντεο στον κόσμο, υποστηρίζει κωδικοποίηση H.264/H.265, προεπιλεγμένη μορφή για βίντεο στο διαδίκτυο, εγγραφή με κινητό τηλέφωνο, YouTube)"

msgid "mime_m4v"
msgstr "Βίντεο M4V (μορφή βίντεο iTunes, παραλλαγή του MP4. Μορφή βίντεο στο οικοσύστημα Apple, τυπική μορφή για ταινίες και τηλεοπτικά προγράμματα στο iTunes Store, υποστηρίζει προστασία πνευματικών δικαιωμάτων DRM)"

msgid "mime_mpeg"
msgstr "Βίντεο MPEG (ο οργανισμός MPEG το καθόρισε το 1988, Moving Picture Experts Group. Έθεσε τα θεμέλια για πρότυπα συμπίεσης ψηφιακού βίντεο, τα MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (διαδικτυακό βίντεο) είχαν βαθιά επίδραση)"

msgid "mime_mkv"
msgstr "Βίντεο MKV (το έργο Matroska το ανέπτυξε το 2002, ανοιχτό δοχείο πολυμέσων. Υποστηρίζει πολλαπλές ροές ήχου, πολλαπλούς υπότιτλους, κεφάλαια, 'εργαλείο συσκευασίας', προτιμώμενη μορφή για κοινή χρήση ταινιών υψηλής ανάλυσης)"

msgid "mime_mpg"
msgstr "Βίντεο MPEG (επεκτάσεις βίντεο MPEG-1/MPEG-2, τυπική μορφή για VCD και DVD. Η κύρια μορφή για βίντεο σε οπτικούς δίσκους τη δεκαετία 1990-2000, τώρα έχει αντικατασταθεί από H.264/H.265)"

msgid "mime_ogv"
msgstr "Βίντεο Ogg Video (αναπτύχθηκε από το Xiph.Org Foundation, μορφή βίντεο του δοχείου Ogg, χρησιμοποιεί κωδικοποίηση Theora. Ανοιχτό και ελεύθερο διπλωμάτων ευρεσιτεχνίας, ένα από τα πρώτα πρότυπα για βίντεο HTML5, το Firefox το υποστηρίζει εγγενώς)"

msgid "mime_ogx"
msgstr "Δοχείο πολυμέσων Ogg (αναπτύχθηκε από το Xiph.Org Foundation, γενική επέκταση του δοχείου Ogg, μπορεί να περιέχει πολλαπλές ροές όπως ήχο, βίντεο, υπότιτλους. Ανοιχτό πρότυπο πολυμέσων, χρησιμοποιείται για παιχνίδια, ροή)"

msgid "mime_rm"
msgstr "Βίντεο RealMedia (Η RealNetworks το ανέπτυξε το 1995, μορφή RealMedia. Πρωτοπόρος της ροής στο διαδίκτυο τη δεκαετία 1990-2000, κύρια μορφή του προγράμματος αναπαραγωγής RealPlayer. Μειονεκτήματα: απαιτεί ειδικό πρόγραμμα αναπαραγωγής, κακή ποιότητα συμπίεσης, αργότερα αντικαταστάθηκε από Flash/MP4)"

msgid "mime_flv"
msgstr "Βίντεο Flash (η μορφή εμφανίστηκε το 2002, μορφή Flash Video. Κάποτε ήταν η κύρια μορφή βίντεο στο διαδίκτυο. Το πρώιμο YouTube το χρησιμοποιούσε. Μειονεκτήματα: ανάγκη για πρόσθετο Flash, χαμηλή απόδοση, πολλές ευπάθειες ασφαλείας. Από το 2015, οι κύριες ιστοσελίδες μεταπήδησαν σε βίντεο HTML5, τώρα είναι απαρχαιωμένο)"

msgid "mime_f4v"
msgstr "Βίντεο F4V (μορφή βίντεο Flash που αναπτύχθηκε από την Adobe, διάδοχος του FLV. Βασισμένο στο πρότυπο MPEG-4, υποστηρίζει κωδικοποίηση H.264. Απαρχαιωμένο μαζί με την τεχνολογία Flash, η Adobe σταμάτησε την υποστήριξη το 2020)"

msgid "mime_wmv"
msgstr "Βίντεο WMV (Η Microsoft το ανέπτυξε το 1999, Windows Media Video. Υποστηρίζεται εγγενώς από Windows, βελτιστοποιημένο για ροή, ήταν μια κοινή μορφή σε πρώιμα διαδικτυακά βίντεο, τώρα είναι περιθωριοποιημένο)"

msgid "mime_wmf"
msgstr "Μορφή πολυμέσων WMF (Windows Media Format, πλαίσιο πολυμέσων της Microsoft, περιλαμβάνει βίντεο WMV, ήχο WMA, υποστηρίζεται εγγενώς από το Windows Media Player)"

msgid "mime_mov"
msgstr "Βίντεο MOV (Η Apple το ανέπτυξε το 1991, μορφή δοχείου QuickTime. Τυπική μορφή για επαγγελματική επεξεργασία βίντεο, υποστηρίζει πολλαπλούς κωδικοποιητές, υποστηρίζεται εγγενώς από Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "Βίντεο QuickTime (Η Apple το κυκλοφόρησε το 1991, μορφή QuickTime. Πρότυπο βίντεο στην πλατφόρμα Mac, το MOV είναι το δοχείο του, το πρόγραμμα αναπαραγωγής QuickTime ήταν κάποτε ευρέως χρησιμοποιούμενο. Η Apple σταμάτησε την ανάπτυξη της έκδοσης Windows το 2016, αντικαθιστώντας το σταδιακά με MP4)"

msgid "mime_webm"
msgstr "Βίντεο WebM (Η Google το κυκλοφόρησε το 2010, ανοιχτή και ελεύθερη διπλωμάτων ευρεσιτεχνίας μορφή βίντεο. Βασισμένο στο δοχείο Matroska, κωδικοποίηση VP8/VP9, τυπική μορφή βίντεο HTML5, προεπιλεγμένη μορφή για αναπαραγωγή στο YouTube στο διαδίκτυο)"

msgid "mime_3gp"
msgstr "Βίντεο 3GP (η 3GPP το καθόρισε το 2000, μορφή βίντεο για κινητές συσκευές. Πολύ μικρό αρχείο, χαμηλής ποιότητας, μορφή για εγγραφή βίντεο σε πρώιμα τηλέφωνα, χρησιμοποιήθηκε για αποστολή MMS)"

