msgid "Target"
msgstr "Tikslas"

msgid "Grabber"
msgstr "Surinkimo įrankis"

#------------------------------------------------------------------------------
# Formato aprašymai
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstinis failas (1963 m. ASCII standartizacija, neformatuotas paprastas tekstas. Viso šaltinio kodo, konfigūracijų, žurnalų pagrindas. Unix naudoja LF, Windows naudoja CRLF eilutės lūžiui, vis dar dažniausias duomenų formatas kompiuterijoje)"

msgid "mime_log"
msgstr "Žurnalo failas (paprastas tekstinis failas, registruojantis sistemos ir programų vykdymo informaciją, dažnai naudojamas trikčių šalinimui, veikimo analizei, saugumo auditui. Standartiniai formatai, tokie kaip Apache combined log, Nginx access log, syslog ir kt.)"

msgid "mime_page"
msgstr "HTML tinklalapis (Tim Berners-Lee išrado pasaulinį tinklą 1989 m., 1990 m. apibrėžė tris technologijas HTML/HTTP/URL, nemokamai jas pasiūlė be patento. HTML5 tapo oficialiu W3C standartu 2014 m., palaiko rodymą, daugialypę terpę ir spausdinimą. Apdovanotas Tiuringo premija 2016 m.)"

msgid "mime_khtml"
msgstr "KHTML žiniatinklio variklis (išleistas su KDE 2.0 1998 m., Konqueror naršyklės atvaizdavimo variklis. Apple sukūrė WebKit pagal KHTML 2001 m., Google sukūrė Blink iš WebKit 2008 m., kuris tapo tokių naršyklių kaip Chrome, Edge, Safari pagrindu. KHTML yra pavyzdys, kaip atvirojo kodo bendruomenė padėjo pamatus šiuolaikiniams naršyklių varikliams, o jos technologinis paveldas tęsiasi per WebKit/Blink)"

msgid "mime_script"
msgstr "Dinaminis scenarijus (interpretuojama kalba, nereikalauja kompiliacijos. Apima ASP, JSP, CGI, ColdFusion, Tcl, VBScript ir kt., plačiai naudojamas ankstyvoje žiniatinklio kūrime, sistemos administravime, užduočių automatizavime. Šiuolaikinės scenarijų kalbos, tokios kaip Python, Ruby, JavaScript, tapo pagrindinėmis kalbomis full-stack kūrimui)"

msgid "mime_js"
msgstr "JavaScript scenarijus (Brendan Eich sukūrė per 10 dienų „Netscape“ 1995 m., gimtoji naršyklės programavimo kalba. ECMAScript standartizuotas 1997 m., Node.js gimimas 2009 m. pavertė jį full-stack kalba, npm yra didžiausia pasaulyje paketų tvarkyklė. Daugelį metų populiariausia programavimo kalba „GitHub“)"

msgid "mime_py"
msgstr "Python scenarijus (Guido van Rossum sukūrė 1991 m., žinomas dėl privalomo įtraukimo ir paprastos sintaksės. Plačiai naudojamas žiniatinklio kūrime, duomenų moksle, dirbtiniame intelekte, automatizuotose operacijose. Daugkartinis TIOBE metų programavimo kalbos apdovanojimo laimėtojas)"

msgid "mime_sh"
msgstr "Shell scenarijus (Unix gimimas 1971 m., komandų scenarijų kalba. Naudojama sistemos administravimui, užduočių automatizavimui, paslaugų paleidimui, diegimo scenarijams. Būtinas įgūdis Linux administravimui)"

msgid "mime_rb"
msgstr "Ruby scenarijus (Yukihiro Matsumoto sukūrė 1995 m., orientuotas į kūrėjų laimę. „Ruby on Rails“ sistema įvedė „konvencija prieš konfigūraciją“ paradigmą, turinčią įtakos šiuolaikinių žiniatinklio sistemų dizainui)"

msgid "mime_pl"
msgstr "Perl scenarijus (Larry Wall sukūrė 1987 m., žinomas dėl savo pragmatiškumo, vadinamas „šveicarišku penkiasdešimt penkiu“. CPAN buvo šiuolaikinių kalbų paketų tvarkyklių pradininkas, turėjęs didelę įtaką tekstų apdorojimui, sistemos administravimui ir CGI)"

msgid "mime_php"
msgstr "PHP dinaminis tinklalapis (Rasmus Lerdorf sukūrė 1995 m., specialiai sukurtas žiniatinklio kūrimui. Daugiau nei 70% pasaulio svetainių jį naudoja, varo tokias platformas kaip „WordPress“, „Facebook“, „Wikipedia“. PHP 8 įdiegia JIT kompiliavimą, žymiai pagerinantį našumą)"

msgid "mime_image"
msgstr "Vaizdo failas"

msgid "mime_document"
msgstr "Dokumento failas"

msgid "mime_package"
msgstr "Programinės įrangos paketas"

msgid "mime_archive"
msgstr "Gzip suspaustas failas (GNU projektas 1992 m., pagrįstas DEFLATE algoritmu. Žiniatinklyje naudojamas dinamiškam atsakymo turinio glaudinimui, glaudinimo santykis paprastai yra 60-90%. Po 2015 m. kai kuriais atvejais pakeistas Brotli, bet vis dar plačiausiai palaikomas glaudinimo formatas serverio pusėje)"

msgid "mime_audio"
msgstr "Garso failas"

msgid "mime_video"
msgstr "Vaizdo failas"

msgid "mime_jscript"
msgstr "JavaScript (sukūrė Brendan Eich 1995 m.)"

msgid "mime_json"
msgstr "JSON duomenys (Douglas Crockford pasiūlė 2001 m., lengvas duomenų mainų formatas, faktinis standartas žiniatinklio API)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft sukūrė 1996 m., Windows scenarijų kalba, naudojama ASP tinklalapiams ir Windows administravimo scenarijams. Populiarėjant PowerShell ir JavaScript, palaipsniui nyksta)"

msgid "mime_conf"
msgstr "Konfigūracijos failas (saugo programinės įrangos konfigūraciją tekstiniu formatu, įprasti formatai: INI, JSON, YAML, TOML, XML. Linux sistemos konfigūracija dažniausiai yra /etc kataloge)"

msgid "mime_css"
msgstr "CSS stiliaus lapas (W3C paskelbė pirmąjį oficialų standartą CSS1 1996 m. gruodžio mėn., CSS2 pridėjo pozicionavimą ir medijos tipus 1998 m., nuo 2011 m. CSS3 modulizacija įvedė užapvalintus kampus, animacijas, lanksčią dėžę, tinklelio išdėstymą ir atsakingą dizainą. Kartu su HTML ir JavaScript sudaro tris pagrindines front-end technologijas, visos šiuolaikinės naršyklės (Chrome, Firefox, Safari, Edge) jį palaiko iš pradžių, tai yra vienintelis standartas, skirtas apibrėžti tinklalapių stilių)"

msgid "mime_xsl"
msgstr "XSL stiliaus lapas (W3C standartas 1999 m., XML dokumentų transformavimo kalba, gali konvertuoti XML į HTML/PDF/tekstą. Naudojimas sumažėjo po JSON išpopuliarėjimo)"

msgid "mime_runtime"
msgstr "Vykdomasis failas (operacinės sistemos vykdomasis formatas, pvz., EXE, ELF, Mach-O, sudėtyje yra mašininio kodo ir įkėlimo informacijos)"

msgid "mime_library"
msgstr "Bibliotekos failas (DLL, SO, dylib ir kt., dinamiškai susietos bibliotekos, bendras kodas, kurį programa įkelia vykdymo metu)"

msgid "mime_swf"
msgstr "Flash animacija (Macromedia sukūrė 1996 m., vėliau atiteko Adobe. Interaktyvus žiniatinklio animacijos standartas, kadaise dominavęs interneto animacijose ir žaidimuose. Trūkumai: reikalauja papildinio, nepalaikoma mobiliuosiuose įrenginiuose, didelė saugumo rizika. Adobe paskelbė apie jo panaikinimą 2017 m., visiškai nutraukė palaikymą 2020 m., pakeistas HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD dokumento tipo apibrėžimas (XML specifikacija, apibrėžianti XML dokumento struktūrą, naudojama XML teisėtumui patvirtinti)"

msgid "mime_csv"
msgstr "CSV duomenų formatas (kableliais atskirtos reikšmės, įprastas lentelių duomenų formatas, standartas importui/eksportui į Excel ir duomenų bazes)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java programų paleidimo įrenginys, Java darbalaukio programų platinimo technologija iš 2000-ųjų, dabar pasenusi)"

msgid "mime_lit"
msgstr "„Microsoft Reader“ elektroninė knyga („Microsoft“ išleido 2000 m., LIT formatas, pasenęs)"

msgid "mime_svg"
msgstr "SVG vektorinė grafika (W3C standartas 1999 m., kadangi „Microsoft“ ilgai reklamavo savo VML formatą, IE naršyklė jį palaikė tik 2011 m., o tai atitolino jo pritaikymą. Po 2015 m., kai IE išnyko ir išpopuliarėjo didelės raiškos ekranai, jis tapo pageidaujamu formatu piktogramoms ir logotipams)"

msgid "mime_ai"
msgstr "„Adobe Illustrator“ vektorinė grafika (išleista 1987 m., pramonės standartinis vektorinės grafikos formatas, pageidaujamas spausdinimo dizainui, logotipams, piktogramoms)"

msgid "mime_phshop"
msgstr "„Photoshop“ vaizdas („Adobe“ išleido 1990 m., „Photoshop“ šaltinio failo formatas PSD, vaizdo apdorojimo pramonės standartas)"

msgid "mime_ttf"
msgstr "„TrueType“ šriftas („Apple“ ir „Microsoft“ kartu sukūrė 1989 m., vektorinio šrifto formatas, ekrano rodymas ir spausdinimas atitinka, numatytasis šiuolaikinių operacinių sistemų šrifto formatas)"

msgid "mime_fon"
msgstr "WOFF2 žiniatinklio šriftas (W3C rekomendacija 2014 m., naudoja Brotli glaudinimo algoritmą, palyginti su senesniu WOFF, tūris sumažėja apie 30%, palyginti su TTF/OTF, sumažėja daugiau nei 50%, šiuo metu jį palaiko visos šiuolaikinės naršyklės, todėl jis yra pageidaujamas šiuolaikinių žiniatinklio šriftų formatas, palaikomas daugiau nei 98% naršyklių)"

msgid "mime_pdf"
msgstr "PDF dokumentas („Adobe“ sukūrė 1993 m., tapo ISO standartu 2008 m. Nuo platformos nepriklausomas dokumento formatas, išlaiko formavimo nuoseklumą, yra pasaulinis elektroninių dokumentų platinimo standartas)"

msgid "mime_dotnet"
msgstr "ASP.NET dinaminis puslapis („Microsoft“ išleido 2002 m., dinaminių tinklalapių technologija, skirta „Windows“ platformai, „.NET Framework“ dalis)"

msgid "mime_mdb"
msgstr "Access duomenų bazė („Microsoft Access“ duomenų bazės failas, išleistas 1992 m., „Windows“ darbalaukio duomenų bazės sprendimas)"

msgid "mime_md"
msgstr "„Markdown“ dokumentas (John Gruber sukūrė 2004 m., sintaksės dizainą paveikė reStructuredText ir Setext. Pagrindinė dizaino filosofija yra „skaitomumas reiškia galimybę atvaizduoti“, originalus diegimas Markdown.pl naudoja Perl reguliariąsias išraiškas. Išvestinės specifikacijos apima GFM (2013), CommonMark (2017), Pandoc Markdown ir kt. Varo ekosistemas, tokias kaip GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, tapdamas faktišku standartiniu statinių svetainių generatorių ir kūrėjų dokumentacijos formatu)"

msgid "mime_crystal"
msgstr "„Crystal Reports“ ataskaitos formatas (SAP verslo analizė, standartinis įmonių ataskaitų formatas)"

msgid "mime_libreoffice"
msgstr "„LibreOffice“ dokumentas („The Document Foundation“ sukūrė 2010 m., šaka nuo „OpenOffice“, ODF standarto diegimas, pagrindinis atvirojo kodo biuro paketas)"

msgid "mime_encrypt"
msgstr "Užšifruotas failas (norint peržiūrėti, reikia iššifruoti, įprasti plėtiniai: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS maršruto duomenys (GPS mainų formatas, registruoja geografinę informaciją, įprastas sportinių laikrodžių ir navigacinių prietaisų formatas)"

msgid "mime_diskimage"
msgstr "Disko vaizdas (disko / CD-ROM vaizdo failai, pvz., DMG, ISO, IMG, naudojami programinei įrangai platinti arba laikmenų atsarginėms kopijoms kurti)"

msgid "mime_vm"
msgstr "Virtualiosios mašinos vaizdas (virtualaus disko failai, pvz., VMDK, VDI, VHDX, OVA, formatai, skirti virtualizavimo platformoms, tokioms kaip VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "„BitTorrent“ torrent failas (Bram Cohen išrado 2001 m., indekso failas, skirtas P2P atsisiuntimams, sudėtyje yra failo metaduomenų ir stebėjimo įrenginio informacijos)"

msgid "mime_gis"
msgstr "GIS geografinės informacinės sistemos duomenys (erdviniai duomenys, pvz., Shapefile, GeoJSON, naudojami žemėlapiams ir erdvinei analizei)"

msgid "mime_ebook"
msgstr "Elektroninė knyga (elektroninių knygų formatai, pvz., EPUB, MOBI, AZW. EPUB yra tarptautinis standartas, MOBI / AZW yra „Amazon Kindle“ formatai)"

msgid "mime_avif"
msgstr "AVIF vaizdas („Alliance for Open Media“ išleido 2019 m., pagrįstas AV1 kodavimu, glaudinimo santykis 50% geresnis nei WebP, naujos kartos žiniatinklio vaizdo standartas)"

msgid "mime_markdown"
msgstr "„Markdown“ dokumentas (John Gruber sukūrė 2004 m., lengva žymėjimo kalba, įprastas formatas, skirtas „GitHub“ README, techninei dokumentacijai, forumų pranešimams)"

msgid "mime_yaml"
msgstr "YAML konfigūracija (Clark Evans sukūrė 2001 m., žmogaus skaitomas duomenų serializavimo formatas, standartas, skirtas „Kubernetes“, „Ansible“, „Docker Compose“ konfigūracijos failams)"

msgid "mime_toml"
msgstr "TOML konfigūracija (Tom Preston-Werner sukūrė 2013 m., „Tom's Obvious Minimal Language“, konfigūracijos failo formatas, skirtas šiuolaikiniams įrankiams, tokiems kaip „Rust“ / „Cargo“, „Python“ / „pip“, „Go“)"

msgid "mime_vue"
msgstr "Vue komponento failas (pradėtas naudoti 2014 m. Evan You, progresyvi JavaScript karkasas. Naudodamas vieno failo komponentus (SFC), jis puikiai sujungia HTML, CSS ir JS, žymiai padidindamas kūrimo efektyvumą. Tai viena populiariausių frontend karkasų pasaulyje. Taip pat kaip šiuolaikinių statinių svetainių generatorių, tokių kaip VitePress, šerdis, jis plačiai naudojamas interaktyviai techninei dokumentacijai ir tinklaraščiams valdyti.)"

msgid "mime_wasm"
msgstr "„WebAssembly“ modulis (W3C standartas nuo 2017 m., didelio našumo vykdymo formatas naršyklėje, C / C ++ / Rust / R gali būti kompiliuojami kaip tikslas, našumas artimas gimtajam)"

msgid "mime_jsx"
msgstr "„React JSX“ komponentas („Facebook“ paskelbė „JavaScript XML“ 2013 m., „React“ sistemos komponento sintaksė, naujoviška paradigma, įvedanti HTML į JavaScript)"

msgid "mime_tsx"
msgstr "„TypeScript TSX“ komponentas („Microsoft“ sukūrė 2012 m., „TypeScript“ + JSX, standartinis rašymo būdas, skirtas tipo saugiam „React“ kūrimui)"

msgid "mime_heif"
msgstr "HEIF vaizdas (MPEG standartas 2015 m., efektyvus vaizdo failo formatas, plačiai naudojamas „Apple“ ekosistemoje)"

msgid "mime_heic"
msgstr "HEIC vaizdas („Apple“ HEIF diegimas, numatytasis nuotraukų formatas „iPhone“, iš pradžių palaikomas iOS / macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D modelis (GL perdavimo formatas, „3D pasaulio JPEG“, „Khronos Group“ išleido 2015 m., standartinis „Web 3D“ formatas)"

msgid "mime_glb"
msgstr "GLB dvejetainis 3D modelis (GLTF dvejetainė versija, viename faile yra visi ištekliai, naudojamas 3D scenų platinimui)"

msgid "mime_gls"
msgstr "GLOSSARY terminų žodynėlis (terminų apibrėžčių failas, skirtas terminų valdymui dokumentavimo sistemose)"

msgid "mime_cbz"
msgstr "CBZ komiksų knyga (ZIP suspausti komiksų vaizdai, įprastas komiksų kolekcionavimo formatas)"

msgid "mime_cbr"
msgstr "CBR komiksų knyga (RAR suspausti komiksų vaizdai, įprastas komiksų kolekcionavimo formatas)"

msgid "mime_fb2"
msgstr "FB2 elektroninė knyga („FictionBook 2.0“, rusiškas elektroninių knygų formatas, XML struktūra, plačiai palaikoma atvirojo kodo skaitytuvų)"

msgid "mime_kepub"
msgstr "KEPUB elektroninė knyga (specialus EPUB formatas, skirtas „Kobo“, optimizuotas formatas, skirtas „Kobo“ elektroninių knygų skaitytuvui)"

msgid "mime_m4b"
msgstr "M4B garso knyga (MPEG-4 garso formatas, skirtas knygoms, palaiko žymes, „iTunes“ garso knygų formatas)"

msgid "mime_kfx"
msgstr "„Kindle KFX“ formatas („Amazon“ išleido 2015 m., specialus elektroninių knygų formatas, skirtas „Kindle“, palaiko išplėstinį maketą ir greitą puslapių vartymą)"

msgid "mime_chm"
msgstr "CHM pagalbos failas („Microsoft“ išleido 1997 m., kompiliuotas HTML pagalbos formatas, standartas, skirtas „Windows“ programinės įrangos pagalbos dokumentacijai)"

msgid "mime_mht"
msgstr "MHT žiniatinklio archyvas („Microsoft“ išleido 1999 m., vieno failo žiniatinklio formatas, IE naršyklės formatas, skirtas saugoti tinklalapius)"

msgid "mime_wml"
msgstr "WML belaidė žymėjimo kalba (WAP standartas 1999 m., naudojamas ankstyvųjų funkcinių telefonų tinklalapiams, pasenęs)"

msgid "mime_xhtml"
msgstr "XHTML tinklalapis (W3C standartas 2000 m., XML HTML versija, griežtesnė sintaksė. W3C nustojo jį prižiūrėti 2009 m., sutelkdama dėmesį į HTML5)"

msgid "mime_xml"
msgstr "XML dokumentas (W3C standartas 1998 m., išplečiama žymėjimo kalba, pagrindinis formatas, skirtas žiniatinklio paslaugoms, konfigūracijos failams, duomenų mainams)"

msgid "mime_sgml"
msgstr "SGML dokumentas (ISO standartas 1986 m., HTML pirmtakas, standartinė bendroji žymėjimo kalba, tiek XML, tiek HTML yra kilę iš SGML)"

msgid "mime_apng"
msgstr "APNG animacija („Mozilla“ sukūrė 2004 m., PNG animacijos plėtinys, modernus GIF pakaitalas, palaiko tikras spalvas ir skaidrumą)"

msgid "mime_bmp"
msgstr "BMP bitmap (Windows bitmap formatas, vietinis nuo Windows 1.0. Nesuglaudintas, didelio dydžio failas, tačiau dėl paprastos struktūros ir papildomų kodekų nereikalingumo, jis vis dar naudojamas Windows 11 iškirpimo įrankyje, Piešimo programoje, EXE/MSI diegimo paketų piktogramų ištekliuose, žymeklių failuose ir kai kuriose senesnėse tvarkyklėse. Esant tokiai pačiai vaizdo kokybei, failo dydis yra apie 3-10 kartų didesnis nei PNG. Daugeliu atvejų jį pakeitė PNG/JPEG, tačiau Windows ekosistema vis dar išlaiko platų suderinamumą)"

msgid "mime_cdr"
msgstr "CDR vektorinė grafika (specialus „CorelDRAW“ formatas, Kanados įmonė „Corel“, vektorinės grafikos dizaino programinė įranga)"

msgid "mime_gif"
msgstr "GIF vaizdas („CompuServe“ sukūrė 1987 m., 256 spalvų animuotas vaizdo formatas. Trūkumai: mažai spalvų, grubi vaizdo kokybė, nepalaiko skaidrumo, didelis failas, mažas kadrų dažnis. Pakeistas šiuolaikiniais animuotais formatais, tokiais kaip APNG, WebP)"

msgid "mime_ico"
msgstr "ICO piktograma („Windows“ piktogramų formatas, palaiko kelias raiškas, standartinis svetainių „favicon“ formatas)"

msgid "mime_jpeg"
msgstr "JPEG vaizdas (ISO standartas 1992 m., nuostolingas glaudinimo formatas, skirtas nuotraukoms, faktinis interneto nuotraukų standartas)"

msgid "mime_jpg"
msgstr "JPEG vaizdas (ISO standartas 1992 m., nuostolingas glaudinimo formatas, skirtas nuotraukoms, faktinis interneto nuotraukų standartas)"

msgid "mime_png"
msgstr "PNG vaizdas (W3C rekomendacija 1996 m., palaiko tikras spalvas ir skaidrumą, statinis GIF pakaitalas, standartas, skirtas nuostolinghams vaizdams internete)"

msgid "mime_ps"
msgstr "„PostScript“ puslapio aprašymo failas („Adobe“ išleido 1985 m., puslapio aprašymo kalba, PDF pirmtakas, naudojamas spausdinimui ir leidybai)"

msgid "mime_psb"
msgstr "PSB didelis dokumentas („Adobe Photoshop“ formatas, skirtas labai dideliems vaizdams, palaiko milžiniškus vaizdus, didesnius nei 2 GB arba 30000 pikselių)"

msgid "mime_psd"
msgstr "PSD vaizdas („Adobe Photoshop“ šaltinio failas, palaiko sluoksnius, kanalus, kelius, pramonės standartinis vaizdo apdorojimo formatas)"

msgid "mime_webp"
msgstr "WebP vaizdas („Google“ sukūrė 2010 m., žiniatinklio vaizdo formatas, palaiko nuostolingą / nenuostolingą glaudinimą ir animaciją, glaudinimo santykis 25-35% geresnis nei PNG ir 25% geresnis nei JPEG)"

msgid "mime_woff"
msgstr "WOFF žiniatinklio šriftas (sukurtas 2009 m., W3C standartas 2018 m. Suspaustas remiantis „TrueType“ / „OpenType“, optimizuotas žiniatinklio šriftų įkėlimui, standartinis šiuolaikinių svetainių piktogramų šriftų formatas)"

msgid "mime_7z"
msgstr "7z suspaustas archyvas (Igor Pavlov sukūrė 1999 m., specialus „7-Zip“ programos formatas. LZMA algoritmas, didelis glaudinimo santykis, atvirojo kodo ir nemokamas. 7z formatas, esant tokiam pačiam glaudinimo santykiui, paprastai yra 30–50% mažesnis nei ZIP, įprastas formatas atvirojo kodo bendruomenėje ir programinės įrangos platinimui)"

msgid "mime_ace"
msgstr "ACE suspaustas archyvas (sukurtas 1990-aisiais, „WinACE“ programos formatas. Kažkada konkuravo su RAR, glaudinimo santykis buvo gana didelis. Plėtra sustabdyta 2007 m., dabar pakeista 7z / RAR, retai naudojamas)"

msgid "mime_bz2"
msgstr "BZIP2 suspaustas archyvas (Julian Seward sukūrė 1996 m., blokų rūšiavimo glaudinimo algoritmas. Glaudinimo santykis yra 15–20% didesnis nei GZIP, bet lėtesnis. Įprastas „Linux“ branduolio šaltinio kodo, atvirojo kodo programinės įrangos paketų formatas, plėtinys .bz2)"

msgid "mime_cab"
msgstr "CAB suspaustas archyvas („Microsoft“ sukūrė 1995 m., „Cabinet“ formatas. „Windows“ diegimo paketo formatas, naudojamas tvarkyklėms, sistemos failams platinti. „Windows Installer“ (MSI) viduje naudoja CAB failams saugoti)"

msgid "mime_dmg"
msgstr "DMG disko vaizdas („Apple“ pristatė aštuntajame dešimtmetyje, „Disk Image“ formatas. Standartinis „macOS“ programinės įrangos platinimo formatas, dukart spustelėkite, kad prijungtumėte kaip virtualų diską, nuvilkite ir paleiskite, kad įdiegtumėte programą. Palaiko glaudinimą ir šifravimą, yra pagrindinis „Mac“ programinės įrangos atsisiuntimo formatas)"

msgid "mime_emz"
msgstr "EMZ suspaustas vaizdas („Windows“ suspaustas patobulintas metafailas, suspausta EMF versija. Vektorinės grafikos saugojimo formatas „Office“ dokumentuose, iš esmės tai yra GZIP suspaustas EMF failas)"

msgid "mime_gz"
msgstr "GZIP suspaustas archyvas (Jean-loup Gailly ir Mark Adler sukūrė 1992 m., GNU projektas. Standartinis glaudinimo įrankis, skirtas Unix / Linux, įprastas HTTP perdavimo glaudinimo formatas. Plėtinys .gz, dažnai naudojamas kartu su TAR)"

msgid "mime_jar"
msgstr "JAR suspaustas archyvas („Sun Microsystems“ išleido 1997 m., „Java ARchive“ formatas. Iš esmės tai ZIP failas, naudojamas Java bibliotekoms ir programoms pakuoti. Pagrindinis „Java“ ekosistemos formatas, pvz., „Maven“, „Gradle“. „Android“ taip pat naudoja JAR)"

msgid "mime_lzma"
msgstr "LZMA suspaustas archyvas (Igor Pavlov sukūrė 1998 m., Lempel-Ziv-Markov grandinės algoritmas. Pagrindinis 7z formato glaudinimo algoritmas, didelis glaudinimo santykis, greitas išpakavimo greitis. Naudojamas programinei įrangai, skirtai įterptinėms sistemoms, platinti)"

msgid "mime_rar"
msgstr "RAR suspaustas archyvas (Eugene Roshal sukūrė 1993 m., Roshal ARchive formatas. Didelis glaudinimo santykis, palaiko padalijimą į tomus ir atkūrimo įrašus. „WinRAR“ programos formatas, glaudinimo santykis geresnis nei ZIP, tačiau reikalauja mokamos programinės įrangos, atvirojo kodo įrankiai, tokie kaip „unrar“, gali išpakuoti)"

msgid "mime_tar"
msgstr "TAR archyvas („Unix V7“ pristatė 1979 m., „Tape ARchive“ formatas. Juostinis archyvas, tik pakuoja be glaudinimo, dažnai naudojamas kartu su GZIP / BZIP2 / XZ. „Linux“ paketų šaltinio kodas, „Docker“ vaizdų sluoksnių saugojimas naudoja TAR formatą)"

msgid "mime_tgz"
msgstr "TGZ suspaustas archyvas (TAR + GZIP kombinuotas formatas, plėtinys .tgz arba .tar.gz. Dažniausias Unix / Linux programinės įrangos paketų platinimo formatas, šaltinio kodų paketai, dvejetainiai paketai, plačiai naudojami, reiškia „išpakuok ir naudok“)"

msgid "mime_tbz2"
msgstr "TBZ2 suspaustas archyvas (TAR + BZIP2 kombinuotas formatas, plėtinys .tbz2 arba .tar.bz2. Glaudinimo santykis 15–20% didesnis nei TGZ, tinka didelių failų platinimui, „Linux“ branduolys ilgą laiką naudojo šį formatą)"

msgid "mime_xz"
msgstr "XZ suspaustas archyvas (pristatytas 2009 m., pagrįstas LZMA2 algoritmu. Labai didelis glaudinimo santykis, 30–50% geresnis nei GZIP, išpakavimo greitis gana greitas. „Linux“ branduolys, paketų tvarkyklės (pvz., „Debian“ .deb viduje) plačiai naudojamos, rekomenduojamas formatas dabartinėje „Linux“ ekosistemoje)"

msgid "mime_z"
msgstr "Z suspaustas archyvas („Unix“ glaudinimo komandos formatas 1985 m., LZW algoritmas. Ankstyvas „Unix“ glaudinimo formatas, pakeistas GZIP. Plėtinys .Z, šiuolaikinės sistemos jį naudoja retai)"

msgid "mime_zip"
msgstr "ZIP suspaustas archyvas (Phil Katz sukūrė 1989 m., PKZIP formatas. „Windows“ palaiko iš pradžių, labiausiai paplitęs glaudinimo formatas internete. Palaiko kelis failus, katalogų struktūrą, gali pasirinkti glaudinimo algoritmą. „Java“ JAR, „Android“ APK, „Office“ dokumentų DOCX / XLSX yra pagrįsti ZIP formatu)"

msgid "mime_zst"
msgstr "Zstandard suspaustas archyvas („Facebook“ sukūrė 2015 m., sukūrė Yann Collet. Didelės spartos glaudinimo algoritmas, glaudinimo santykis artimas LZMA, greitis daug didesnis nei GZIP. „Linux“ branduolys 5.9+ palaiko, „Arch Linux“ pacman, „Debian“ APT palaipsniui priima, naujos kartos glaudinimo standartas)"

msgid "mime_lz4"
msgstr "LZ4 suspaustas archyvas (Yann Collet sukūrė 2011 m., itin greitas glaudinimo algoritmas. Glaudinimo greitis yra daugiau nei 10 kartų greitesnis nei GZIP, tinka realaus laiko glaudinimo scenarijams. „Linux“ branduolys, OpenZFS, Hadoop plačiai naudoja, pirmasis pasirinkimas scenarijuose, kuriuose pirmenybė teikiama greičiui)"

msgid "mime_lzo"
msgstr "LZO suspaustas archyvas (Markus Oberhumer sukūrė 1996 m., Lempel-Ziv-Oberhumer algoritmas. Išpakavimo greitis yra labai greitas, glaudinimo santykis yra vidutinis. „Linux“ branduolys „Squashfs“, „OpenWrt“ programinės įrangos paketas naudoja jį, tinka įterptinėms sistemoms)"

msgid "mime_msi"
msgstr "MSI diegimo paketas („Microsoft“ išleido 1999 m., „Windows Installer“ paketo formatas. Standartinis diegimo formatas, skirtas „Windows“ programoms, palaiko operacijų atšaukimą, komponentų valdymą, tylų diegimą. Pirmasis pasirinkimas programinės įrangos platinimui įmonės lygiu, iki šiol pagrindinis „Windows“ programinės įrangos diegimo formatas)"

msgid "mime_pkg"
msgstr "PKG diegimo paketas („macOS“ programų diegimo paketo formatas, pagrįstas „Apple“ diegimo technologija. Standartinis „macOS“ programinės įrangos platinimo formatas, palaiko komponentų pasirinkimą, diegimo scenarijus, pašalinimo funkciją. Dukart spustelėkite .pkg failą norėdami įdiegti, įprastas platinimo būdas programinei įrangai, esančiai ne „Mac App Store“)"

msgid "mime_apk"
msgstr "APK Android programų paketas (pradėtas naudoti Google 2008 m., tradicinis Android programų diegimo formatas. APK iš esmės yra ZIP paketas, kuriame yra kodas, ištekliai ir manifesto failas. Nuo 2021 m. „Google Play“ reikalauja, kad naujos programos naudotų AAB formatą, tačiau APK vis dar naudojamas derinimui, trečiųjų šalių parduotuvėms ir šalutiniam įkėlimui)"

msgid "mime_ipa"
msgstr "IPA iOS programų paketas („iOS App Store Package“, iOS/iPadOS programų diegimo formatas. Pristatytas 2008 m. su iPhone SDK. Turi būti platinamas per „App Store“ arba pasirašytas įmonės sertifikatu. Sudėtyje yra vykdomasis failas, ištekliai, Info.plist ir parašo informacija)"

msgid "mime_hap"
msgstr "HAP „HarmonyOS“ programų paketas („HarmonyOS Ability Package“ – pagrindinis „HarmonyOS“ programos vienetas. Pristatytas 2020 m. su „HarmonyOS 2.0“. Palaiko du tipus: „entry“ ir „feature“, platinimo formatas, skirtas „Huawei“ telefonams, planšetiniams kompiuteriams, išmaniesiems laikrodžiams ir kitiems „HarmonyOS“ įrenginiams)"

msgid "mime_har"
msgstr "HAR statinė bendroji „HarmonyOS“ biblioteka („HarmonyOS Archive“, statinė bendroji „HarmonyOS“ biblioteka, gali būti bendrinama kelių HAP paketų, naudojama komponentais pagrįstam kūrimui ir modulių pakartotiniam naudojimui)"

msgid "mime_aab"
msgstr "„Android App Bundle“ („Google“ išleido 2018 m., nuo 2021 m. „Google Play“ reikalauja, kad naujos programos naudotų šį formatą. AAB yra platinimo formatas, „Google Play“ generuoja optimizuotus APK pagal įrenginio konfigūraciją (CPU architektūra, ekrano tankis, kalba), diegimo paketo dydis sumažėja vidutiniškai 35%. Kūrėjai įkelia AAB, vartotojai atsisiunčia APK)"

msgid "mime_xapk"
msgstr "XAPK programos paketas (trečiosios šalies „Android“ programos plėtinio paketas, kuriame yra APK + OBB duomenų failai. Naudojamas dideliems žaidimams ir sudėtingoms programoms, išsprendžia 100 MB vieno APK failo apribojimą. Įprasta trečiųjų šalių programų parduotuvėse, tokiose kaip APKPure, APKMirror, nėra oficialus „Google“ formatas)"

msgid "mime_appx"
msgstr "„Windows“ programos paketas („Microsoft“ išleido 2012 m., diegimo formatas, skirtas „Windows 8/10/11“ programoms. Palaiko UWP programų ir darbalaukio programų konvertavimą, platinamas per „Microsoft Store“. 2024 m. „Microsoft“ pristatė MSIX kaip įpėdinį, palaipsniui pakeičiantį APPX)"

msgid "mime_msix"
msgstr "MSIX programos paketas („Microsoft“ išleido 2018 m., naujos kartos pakavimo formatas, skirtas „Windows“ programoms. Sujungia APPX ir MSI privalumus, palaiko visų tipų „Windows“ programas, galima platinti per „Microsoft Store“ arba diegti iš šono, rekomenduojamas formatas, skirtas „Windows 11“)"

msgid "mime_appimage"
msgstr "AppImage programos paketas (pristatytas 2004 m., „Linux“ programos formatas be diegimo. „Viena programa - vienas failas“, veikia tiesiogiai be diegimo, palaiko daugumą „Linux“ platinimų, įprastas būdas kūrėjams platinti „Linux“ programinę įrangą)"

msgid "mime_flatpak"
msgstr "Flatpak programos paketas (pristatytas 2015 m., „Linux“ programos formatas smėlio dėžėje. Veikia per platinimus, izoliuotas nuo pagrindinės sistemos, plėtrą veda „Fedora“ ir „Red Hat“, numatytasis „GNOME“ programinės įrangos centro formatas)"

msgid "mime_snap"
msgstr "Snap programos paketas („Canonical“ išleido 2014 m., „Ubuntu“ patronuojanti įmonė sukūrė, universalus „Linux“ programos formatas. Automatinis atnaujinimas, smėlio dėžės izoliavimas, palaiko 40+ „Linux“ platinimų, numatytasis „Ubuntu“ programinės įrangos centro formatas)"

msgid "mime_deb"
msgstr "„Debian“ programinės įrangos paketas („Debian“ projektas išleido 1993 m., standartinis diegimo formatas, skirtas „Debian“ / „Ubuntu“ ir jų išvestinėms. Valdomas naudojant dpkg, APT yra jo paketų tvarkyklės priekinė dalis, vienas brandžiausių paketų formatų „Linux“ ekosistemoje, iki šiol pagrindinis „Debian“ šeimoje)"

msgid "mime_rpm"
msgstr "RPM programinės įrangos paketas („Red Hat“ išleido 1997 m., standartinis formatas, skirtas tokiems platinimams kaip „Red Hat“ / „Fedora“ / „CentOS“ / „SUSE“. RPM reiškia „Red Hat Package Manager“, kartu su DEB sudaro du pagrindinius „Linux“ paketų formatus, iki šiol pagrindinis RHEL šeimoje)"

msgid "mime_pacman"
msgstr "„Arch“ programinės įrangos paketas („Arch Linux“ išleido 2002 m., .pkg.tar.zst formatas, kurį naudoja pacman paketų tvarkyklė. „Arch Linux“ nuolatinio atnaujinimo platinimų pagrindas, žinomas dėl savo paprastumo ir KISS principo, AUR („Arch User Repository“) yra jo ypatybė)"

msgid "mime_exe"
msgstr "EXE vykdomasis failas („Windows“ vykdomosios programos formatas, santrumpa „Executable“. Gimtoji „Windows“ operacinės sistemos vykdomoji forma, sudėtyje yra PE struktūra. Išsivystė iš MZ formato iš MS-DOS eros, „Windows NT“ pristatė PE („Portable Executable“) formatą 1993 m., kuris naudojamas iki šiol. Programinės įrangos diegimo paketai, programos, sistemos įrankiai naudoja šį formatą. Vartotojas dukart spusteli, kad jį paleistų, plačiausiai naudojamas vykdomasis formatas pasaulyje)"

msgid "mime_dll"
msgstr "DLL dinamiškai susieta biblioteka („Microsoft“ pristatė 1993 m., „Dynamic Link Library“. Bendras „Windows“ kodų bibliotekos failas, programa dinamiškai įkeliama vykdymo metu, taupo atmintį ir disko vietą. Sistemos komponentai, programų papildiniai, tvarkyklės naudoja DLL formatą. Pagrindinis „Windows“ API diegimo būdas, „DLL pragaro“ problema buvo sušvelninta .NET eroje)"

msgid "mime_com"
msgstr "COM vykdomasis failas (vykdomasis formatas iš MS-DOS eros, santrumpa „Command“. Labai paprasta failo struktūra, 64 KB apribojimas, pagrindinis formatas prieš „Windows 3.x“, pasenęs. Šiuolaikiniai „Windows“ naudoja EXE formatą, COM plėtinys vis dar naudojamas kai kuriems komponentų failams)"

msgid "mime_aac"
msgstr "AAC garsas (MPEG standartas 1997 m., „Advanced Audio Coding“. MP3 įpėdinis, garso kokybė geresnė nei MP3 tuo pačiu bitų dažniu, numatytasis garso formatas, skirtas „YouTube“, „iTunes“, „Nintendo Switch“)"

msgid "mime_alac"
msgstr "ALAC garsas („Apple“ sukūrė 2004 m., „Apple Lossless Audio Codec“. „Apple“ nenostolingas formatas, atvirojo kodo 2011 m., numatytasis nenostolingas formatas, skirtas „iTunes“ ir „Apple Music“)"

msgid "mime_flac"
msgstr "FLAC garsas (Xiph.Org fondas sukūrė 2001 m., „Free Lossless Audio Codec“. Nenostolingas glaudinimas, garso kokybė tokia pati kaip CD, failo dydis yra maždaug pusė originalaus WAV. Atvirojo kodo ir be patentų, pageidaujamas formatas audiofilams ir skaitmeninės muzikos kolekcijoms)"

msgid "mime_mp3"
msgstr "MP3 garsas (Fraunhofer institutas sukūrė 1993 m., MPEG-1 Audio Layer 3. Nuostolingas glaudinimo formatas, mažas failas, priimtinos garso kokybės, pagrindinis 2000-ųjų skaitmeninės muzikos revoliucijos formatas, atsakingas už iPod ir Napster. Patentai baigėsi 2017 m., tapo viešo domeno formatas)"

msgid "mime_oga"
msgstr "Ogg Audio garsas (sukūrė Xiph.Org fondas, gryno garso Ogg konteinerio formatas, naudoja Vorbis kodavimą. Atvirojo kodo ir be patentų, glaudinimo efektyvumas geresnis nei MP3, plačiai naudojamas atvirojo kodo projektuose)"

msgid "mime_ogg"
msgstr "OGG garsas (Xiph.Org fondas sukūrė 2000 m., Ogg Vorbis formatas. Atvirojo kodo ir be patentų, glaudinimo efektyvumas geresnis nei MP3, ankstyvasis „Spotify“ jį naudojo, plačiai naudojamas garso efektams žaidimuose)"

msgid "mime_opus"
msgstr "Opus garsas (IETF standartizavo 2012 m., atviras ir be patentų garso formatas, sujungia SILK ir CELT technologijas, labai mažas vėlavimas, didžiausias glaudinimo efektyvumas, numatytasis garso formatas, skirtas WebRTC, „WhatsApp“, „Discord“)"

msgid "mime_wav"
msgstr "WAV garsas („Microsoft“ ir „IBM“ sukūrė 1991 m., gimtoji „Windows“ garso formatas. PCM kodavimas, nesuspaustas, nenostolinga garso kokybė, bet failas labai didelis, standartinis profesionalaus garso redagavimo formatas)"

msgid "mime_wma"
msgstr "WMA garsas („Microsoft“ sukūrė 1999 m., „Windows Media Audio“. Turi nuostolingas / nenostolingas versijas, „Windows“ palaiko iš pradžių, išplito su „Windows Media Player“. Dabar marginalizuotas, pakeistas MP3 / AAC)"

msgid "mime_dsf"
msgstr "DSF garsas („Direct Stream Digital“ formatas, sukūrė „Sony“ ir „Philips“. 1 bito didelė atrankos dažnis, standartinis DSD garso formatas, skaitmeninė SACD versija, aukštos kokybės garso formatas audiofilams, failas labai didelis)"

msgid "mime_ape"
msgstr "APE Audio (sukurtas Monkey's Audio 2000 m., nuostolingo glaudinimo formatas. Didesnis glaudinimas nei FLAC, bet lėtesnis kodavimas, vis dar naudojamas Windows platformoje ir tarp audio entuziastų)"

msgid "mime_mid"
msgstr "MIDI garsas (MIDI asociacija nustatė 1983 m., „Musical Instrument Digital Interface“. Natų formatas, ne įrašas, failas labai mažas, standartas, skirtas elektroniniams muzikos instrumentams, telefono skambučiams, garso efektams žaidimuose. Bendras MIDI buvo standartizuotas 1991 m., apibrėžia 128 instrumentus)"

msgid "mime_m4a"
msgstr "M4A garsas (MPEG-4 Audio, AAC konteinerio formatas. Standartinis „iTunes“ muzikos parduotuvės formatas, pagrindinis garso formatas „Apple“ ekosistemoje, palaiko DRM apsaugą)"

msgid "mime_m3u"
msgstr "M3U grojaraštis (MP3 URL grojaraščio formatas, paprastas teksto failas, registruoja garso failų kelius. „Winamp“ eros standartas, naudojamas interneto radijui, muzikos srautiniam perdavimui internete. M3U8 yra jo UTF-8 versija, naudojama HTTP tiesioginiam srautiniam perdavimui)"

msgid "mime_asf"
msgstr "ASF srautas („Microsoft“ sukūrė 1996 m., „Advanced Systems Format“. „Windows Media“ srautinio perdavimo konteineris, palaiko sinchroninį garso ir vaizdo perdavimą. Naudojamas tiesioginėms interneto transliacijoms ir vaizdo įrašams pagal pareikalavimą, WMA / WMV yra pagrįsti ASF konteineriu)"

msgid "mime_avi"
msgstr "AVI vaizdo įrašas („Microsoft“ išleido 1992 m., ankstyvasis „Windows“ vaizdo standartas. „Audio Video Interleave“, kaitalioja garsą ir vaizdą, buvo populiariausias vaizdo formatas 1990–2000 m., dabar pakeistas MP4 / MKV)"

msgid "mime_divx"
msgstr "DivX vaizdo įrašas („DivX Corporation“ sukūrė 1998 m., MPEG-4 pagrįstas vaizdo kodeko formatas. Pagrindinis internetinio vaizdo įrašų dalijimosi formatas 2000-aisiais, pirmoji technologija, suspaudusi DVD kokybę iki CD dydžio. Dėl autorių teisių ginčų vėliau virto komerciniu koduotuvu)"

msgid "mime_mp4"
msgstr "MP4 vaizdo įrašas (MPEG standartas 2001 m., MPEG-4 14 dalis. Labiausiai paplitęs vaizdo formatas pasaulyje, palaiko H.264 / H.265 kodavimą, numatytasis interneto vaizdo įrašų, mobiliųjų telefonų filmavimo, „YouTube“ formatas)"

msgid "mime_m4v"
msgstr "M4V vaizdo įrašas („iTunes“ vaizdo formatas, MP4 variantas. Vaizdo formatas „Apple“ ekosistemoje, standartinis „iTunes Store“ filmų ir televizijos laidų formatas, palaiko DRM autorių teisių apsaugą)"

msgid "mime_mpeg"
msgstr "MPEG vaizdo įrašas (MPEG organizacija nustatė 1988 m., „Moving Picture Experts Group“. Padėjo skaitmeninio vaizdo glaudinimo standartų pagrindus, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (interneto vaizdo įrašai) turėjo didelę įtaką)"

msgid "mime_mkv"
msgstr "MKV vaizdo įrašas („Matroska“ projektas sukūrė 2002 m., atvirojo kodo daugialypės terpės konteineris. Palaiko kelis garso takelius, kelis subtitrus, skyrius, „pakavimo įrankis“, pageidaujamas aukštos raiškos filmų dalijimosi formatas)"

msgid "mime_mpg"
msgstr "MPEG vaizdo įrašas (MPEG-1 / MPEG-2 vaizdo plėtiniai, standartinis VCD ir DVD formatas. Pagrindinis vaizdo formatas optiniuose diskuose 1990–2000 m., dabar pakeistas H.264 / H.265)"

msgid "mime_ogv"
msgstr "Ogg Video vaizdo įrašas (sukūrė Xiph.Org fondas, Ogg konteinerio vaizdo formatas, naudoja Theora kodavimą. Atviras ir be patentų, vienas iš ankstyvųjų HTML5 vaizdo standartų, „Firefox“ palaiko iš pradžių)"

msgid "mime_ogx"
msgstr "Ogg daugialypės terpės konteineris (sukūrė Xiph.Org fondas, bendras Ogg konteinerio plėtinys, gali turėti kelias juostas, pavyzdžiui, garsą, vaizdą, subtitrus. Atviras daugialypės terpės standartas, naudojamas žaidimuose, srautiniame perdavime)"

msgid "mime_rm"
msgstr "RealMedia vaizdo įrašas (RealNetworks sukūrė 1995 m., RealMedia formatas. Interneto srautinio perdavimo pradininkas 1990–2000 m., pagrindinis „RealPlayer“ grotuvo formatas. Trūkumai: reikalauja specialaus grotuvo, bloga glaudinimo kokybė, vėliau pakeistas Flash / MP4)"

msgid "mime_flv"
msgstr "Flash vaizdo įrašas (formatas pasirodė 2002 m., „Flash Video“ formatas. Kažkada buvo pagrindinis interneto vaizdo formatas. Ankstyvasis „YouTube“ jį naudojo. Trūkumai: reikalingas „Flash“ papildinys, prastas našumas, daug saugumo spragų. Nuo 2015 m. pagrindinės svetainės perėjo prie HTML5 vaizdo, dabar pasenęs)"

msgid "mime_f4v"
msgstr "F4V vaizdo įrašas („Flash“ vaizdo formatas, kurį sukūrė „Adobe“, FLV įpėdinis. Pagrįstas MPEG-4 standartu, palaiko H.264 kodavimą. Pasenęs kartu su „Flash“ technologija, „Adobe“ nutraukė palaikymą 2020 m.)"

msgid "mime_wmv"
msgstr "WMV vaizdo įrašas („Microsoft“ sukūrė 1999 m., „Windows Media Video“. „Windows“ palaiko iš pradžių, optimizuotas srautiniam perdavimui, buvo įprastas formatas ankstyvajame interneto vaizdo įraše, dabar marginalizuotas)"

msgid "mime_wmf"
msgstr "WMF laikmenos formatas („Windows Media Format“, „Microsoft“ laikmenos sistemos struktūra, apima WMV vaizdo įrašą, WMA garsą, „Windows Media Player“ palaiko iš pradžių)"

msgid "mime_mov"
msgstr "MOV vaizdo įrašas („Apple“ sukūrė 1991 m., „QuickTime“ konteinerio formatas. Standartinis profesionalaus vaizdo redagavimo formatas, palaiko kelis kodekus, „Final Cut Pro“ ir „Premiere“ palaiko iš pradžių)"

msgid "mime_qt"
msgstr "„QuickTime“ vaizdo įrašas („Apple“ išleido 1991 m., „QuickTime“ formatas. Vaizdo standartas „Mac“ platformoje, MOV yra jo konteineris, „QuickTime“ grotuvas kažkada buvo plačiai naudojamas. „Apple“ nutraukė „Windows“ versijos kūrimą 2016 m., palaipsniui jį keisdama MP4)"

msgid "mime_webm"
msgstr "WebM vaizdo įrašas („Google“ išleido 2010 m., atviras ir be patentų vaizdo formatas. Pagrįstas „Matroska“ konteineriu, VP8 / VP9 kodavimu, standartinis HTML5 vaizdo formatas, numatytasis „YouTube“ atkūrimo formatas internete)"

msgid "mime_3gp"
msgstr "3GP vaizdo įrašas (3GPP nustatė 2000 m., vaizdo formatas, skirtas mobiliesiems įrenginiams. Labai mažas failas, žemos kokybės, formatas, skirtas filmuoti ankstyvaisiais mobiliaisiais telefonais, naudojamas MMS siuntimui)"

