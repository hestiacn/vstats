msgstr "  Vikudagar og álagstímar"

msgid "  Hosts list and unresolved IP addresses list"
msgstr "  Listi yfir hýsla og listi yfir óleystar IP-tölur"

msgid "  Most viewed, entry and exit pages"
msgstr "  Oftast skoðaðar, inngangs- og útgöngusíður"

msgid "  Files type and Web compression (mod_gzip, mod_deflate stats)"
msgstr "  Tegundir skráa og vefþjöppun (mod_gzip, mod_deflate tölfræði)"

msgid "  Configured Database Statistics"
msgstr "  Stillað gagnagrunns tölfræði"

msgid "  %s domains/countries"
msgstr "  %s lén/lönd"

