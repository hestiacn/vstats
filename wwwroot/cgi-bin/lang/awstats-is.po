msgstr "Mismunandi ormar"

msgid "Target"
msgstr "Markmið"

msgid "Grabber"
msgstr "Sláttutól"

#------------------------------------------------------------------------------
# Formlýsingar
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Textaskrá (ASCII staðlað 1963, formlausan hreinan texta. Grundvöllur alls frumkóða, stillinga, atvikaskráa. Unix notar LF, Windows notar CRLF fyrir línubil, enn algengasta gagnasniðið í tölvufræði)"

msgid "mime_log"
msgstr "Atvikaskrá (einföld textaskrá sem skráir upplýsingar um kerfis- og forritarekstur, oft notuð við bilanagreiningu, afkastagreiningu, öryggisúttektir. Stöðluð snið eins og Apache combined log, Nginx access log, syslog o.fl.)"

msgid "mime_page"
msgstr "HTML vefsíða (Tim Berners-Lee fann upp World Wide Web árið 1989, skilgreindi þrjár tæknileiðir HTML/HTTP/URL árið 1990, bauð þær upp ókeypis án einkaleyfis. HTML5 varð opinber W3C staðall árið 2014, styður birtingu, margmiðlun og prentun. Vann Turing verðlaunin 2016)"

msgid "mime_khtml"
msgstr "KHTML vefvél (gefin út með KDE 2.0 árið 1998, vél fyrir birtingu Konqueror vafrans. Apple bjó til WebKit byggt á KHTML árið 2001, Google bjó til Blink úr WebKit árið 2008, sem varð kjarni vafra eins og Chrome, Edge, Safari. KHTML er dæmi um hvernig opna frumkóða samfélagið lagði grunninn að nútíma vafravélum, tæknileg arfleifð þess heldur áfram í gegnum WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamískt skrift (túlkað tungumál, krefst ekki þýðingar. Felur í sér ASP, JSP, CGI, ColdFusion, Tcl, VBScript o.fl., mikið notað í snemma vefþróun, kerfisstjórnun, verkefna sjálfvirkni. Nútíma skrift tungumál eins og Python, Ruby, JavaScript hafa þróast í aðaltungumál fyrir full-stack þróun)"

msgid "mime_js"
msgstr "JavaScript skrift (Brendan Eich bjó til á 10 dögum í Netscape árið 1995, upprunalegt forritunarmál vafrans. ECMAScript var staðlað árið 1997, fæðing Node.js árið 2009 gerði það að full-stack tungumáli, npm er stærsta pakkastjóri heims. Í mörg ár vinsælasta forritunarmálið á GitHub)"

msgid "mime_py"
msgstr "Python skrift (Guido van Rossum bjó til árið 1991, þekkt fyrir skyldubundna inndrátt og einfalda setningafræði. Mikið notað í vefþróun, gagnavísindum, gervigreind, sjálfvirkni. Margfaldur sigurvegari TIOBE verðlauna fyrir forritunarmál ársins)"

msgid "mime_sh"
msgstr "Shell skrift (fæðing Unix árið 1971, skipanamál fyrir skrift. Notað við kerfisstjórnun, verkefna sjálfvirkni, ræsingu þjónustu, dreifingarskrift. Nauðsynleg færni fyrir Linux stjórnun)"

msgid "mime_rb"
msgstr "Ruby skrift (Yukihiro Matsumoto bjó til árið 1995, einblínir á hamingju forritara. Ruby on Rails grindin kynnti hugmyndafræðina 'venja fremur en stilling', sem hefur áhrif á hönnun nútíma vefgrinda)"

msgid "mime_pl"
msgstr "Perl skrift (Larry Wall bjó til árið 1987, þekkt fyrir raunsæi, kölluð 'Svissneski vasahnífurinn'. CPAN var brautryðjandi nútíma pakkastjóra forritunarmála, hafði mikil áhrif á textavinnslu, kerfisstjórnun og CGI)"

msgid "mime_php"
msgstr "PHP dynamísk vefsíða (Rasmus Lerdorf bjó til árið 1995, hönnuð sérstaklega fyrir vefþróun. Yfir 70% vefsíða heims nota hana, knýr vettvanga eins og WordPress, Facebook, Wikipedia. PHP 8 kynnir JIT þýðingu, bætir afköst verulega)"

msgid "mime_image"
msgstr "Myndskrá)"

msgid "mime_document"
msgstr "Skjalsskrá)"

msgid "mime_package"
msgstr "Hugbúnaðarpakki)"

msgid "mime_archive"
msgstr "Gzip þjöppuð skrá (GNU verkefni 1992, byggt á DEFLATE reikniriti. Á vefnum notað fyrir dynamíska þjöppun svarefnis, þjöppunarhlutfall er venjulega 60-90%. Eftir 2015 var Brotli komið í staðinn í sumum tilfellum, en er enn útbreiddasta þjöppunarsniðið á þjónshlið)"

msgid "mime_audio"
msgstr "Hljóðskrá)"

msgid "mime_video"
msgstr "Myndbandsskrá)"

msgid "mime_jscript"
msgstr "JavaScript (þróað af Brendan Eich árið 1995)"

msgid "mime_json"
msgstr "JSON gögn (Douglas Crockford lagði til árið 2001, létt gagnaskiptasnið, staðreynd staðall fyrir vefforritunarskil)"

msgid "mime_vbs"
msgstr "VBScript (þróað af Microsoft árið 1996, Windows skriftamál, notað fyrir ASP vefsíður og Windows stjórnunarskrift. Með útbreiðslu PowerShell og JavaScript, er það smám saman að hverfa)"

msgid "mime_conf"
msgstr "Stillingaskrá (geymir hugbúnaðarstillingar í textasniði, algeng snið: INI, JSON, YAML, TOML, XML. Linux kerfisstillingar eru að mestu í /etc skráasafninu)"

msgid "mime_css"
msgstr "CSS stílsíða (W3C gaf út fyrsta opinbera staðalinn CSS1 í desember 1996, CSS2 bætti við staðsetningu og miðlategundum árið 1998, frá 2011 kynnti CSS3 einingavæðingu ávalar horn, hreyfingar, sveigjanlega kassa, grindar skipulag og viðbragðshönnun. Ásamt HTML og JavaScript er það ein af þremur aðal tækni front-end, allir nútíma vafrar (Chrome, Firefox, Safari, Edge) styðja það náttúrulega, það er eina staðallinn fyrir að skilgreina útlit vefsíðna)"

msgid "mime_xsl"
msgstr "XSL stílsíða (W3C staðall frá 1999, tungumál til að umbreyta XML skjölum, getur breytt XML í HTML/PDF/texta. Notkun hefur minnkað eftir útbreiðslu JSON)"

msgid "mime_runtime"
msgstr "Keyrsluskrá (keyrslusnið stýrikerfis eins og EXE, ELF, Mach-O, inniheldur vélamálskóða og upplýsingar um hleðslu)"

msgid "mime_library"
msgstr "Bókasafnsskrá (DLL, SO, dylib o.fl., dynamískt tengd bókasöfn, sameiginlegur kóði sem forritið hleður meðan á keyrslu stendur)"

msgid "mime_swf"
msgstr "Flash hreyfimynd (Macromedia þróaði það árið 1996, seinna í eigu Adobe. Gagnvirkur staðall fyrir vefhreyfimyndir, eitt sinn ríkti yfir hreyfimyndum og leikjum á internetinu. Gallar: krefst viðbyggingar, ekki stutt á farsímum, mikil öryggisáhætta. Adobe tilkynnti um brotthvarf árið 2017, hætti stuðningi að fullu árið 2020, skipt út fyrir HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD skilgreining skjalagerðar (XML forskrift, skilgreinir byggingu XML skjals, notuð til að staðfesta lögmæti XML)"

msgid "mime_csv"
msgstr "CSV gagnasnið (gildi aðskilin með kommum, algengt töflugagnasnið, staðall fyrir innflutning/útflutning í Excel og gagnagrunna)"

msgid "mime_jnlp"
msgstr "Java Web Start (ræsir Java forrita, dreifingartækni fyrir Java skrifborðsforrita frá 2000, nú úrelt)"

msgid "mime_lit"
msgstr "Microsoft Reader rafbók (Microsoft gaf út árið 2000, LIT snið, úrelt)"

msgid "mime_svg"
msgstr "SVG vigurmynd (W3C staðall 1999, vegna þess að Microsoft ýtti lengi undir sitt eigið VML snið, studdi IE vafrinn það fyrst árið 2011, sem seinkaði almennri notkun. Eftir 2015, með brotthvarfi IE og útbreiðslu háskerpuskjáa, varð það valið snið fyrir tákn og lógó)"

msgid "mime_ai"
msgstr "Adobe Illustrator vigurmynd (gefinn út 1987, iðnaðarstaðall vigurmyndasnið, valið fyrir prentun, lógó, tákn)"

msgid "mime_phshop"
msgstr "Photoshop mynd (Adobe gaf út árið 1990, Photoshop upprunalega sniðið PSD, iðnaðarstaðall fyrir myndvinnslu)"

msgid "mime_ttf"
msgstr "TrueType letur (Apple og Microsoft þróuðu saman 1989, vigur letursnið, skjábirting og prentun er samkvæm, sjálfgefið letursnið nútíma stýrikerfa)"

msgid "mime_fon"
msgstr "WOFF2 veffletur (W3C tilmæli 2014, notar Brotli þjöppunarreiknirit, samanborið við eldra WOFF er rúmmál um 30% minna, samanborið við TTF/OTF um 50% minna, stutt af öllum nútíma vöfrum, valið snið fyrir nútíma veffletur, stutt af yfir 98% vafra)"

msgid "mime_pdf"
msgstr "PDF skjal (Adobe þróaði það 1993, varð ISO staðall 2008. Vettvangsoháð skjalasnið, heldur samræmi í sniði, er alþjóðlegur staðall fyrir dreifingu rafrænna skjala)"

msgid "mime_dotnet"
msgstr "ASP.NET dynamísk síða (Microsoft gaf út 2002, tækni fyrir dynamískar vefsíður á Windows vettvangi, hluti af .NET Framework)"

msgid "mime_mdb"
msgstr "Access gagnagrunnur (Microsoft Access gagnagrunnsskrá, gefin út 1992, Windows skrifborðs gagnagrunnslausn)"

msgid "mime_md"
msgstr "Markdown skjal (John Gruber bjó til 2004, hönnun setningafræði undir áhrifum frá reStructuredText og Setext. Helsta hönnunarheimspeki er 'læsileiki þýðir möguleika á birtingu', upprunaleg útfærsla Markdown.pl notar Perl reglulegar segðir. Afleiddar forskriftir innihalda GFM (2013), CommonMark (2017), Pandoc Markdown o.fl. Knýr vistkerfi eins og GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, og verður staðlað snið fyrir kyrrstæðar vefsíðugerðir og þróunarskjölun)"

msgid "mime_crystal"
msgstr "Crystal Reports skýrslusnið (SAP viðskiptagreind, staðlað snið fyrir fyrirtækjaskýrslur)"

msgid "mime_libreoffice"
msgstr "LibreOffice skjal (The Document Foundation þróaði 2010, grein OpenOffice, útfærsla ODF staðals, helsti opna skrifstofupakkinn)"

msgid "mime_encrypt"
msgstr "Dulkóðuð skrá (þarf að afkóða til að sjá, algengar viðbætur: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS slóð gögn (GPS skiptisnið, skráir landfræðilegar upplýsingar, algengt snið fyrir íþróttaúr og leiðsögutæki)"

msgid "mime_diskimage"
msgstr "Diskmynd (DMG, ISO, IMG o.fl. disk/CD-ROM myndaskrár, notaðar til dreifingar hugbúnaðar eða afritunar geymslumiðla)"

msgid "mime_vm"
msgstr "Sýndarvélarmynd (VMDK, VDI, VHDX, OVA o.fl., sýndardiskaskrár, snið fyrir sýndarvæðingarvettvang eins og VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent torrent skrá (Bram Cohen fann upp 2001, vísitöluskrá fyrir P2P niðurhal, inniheldur lýsigögn skráar og Tracker upplýsingar)"

msgid "mime_gis"
msgstr "GIS landfræðileg upplýsingakerfi (landrými gögn eins og Shapefile, GeoJSON, notuð fyrir kort og staðbundna greiningu)"

msgid "mime_ebook"
msgstr "Rafbók (rafbókasnið eins og EPUB, MOBI, AZW. EPUB er alþjóðlegur staðall, MOBI/AZW eru snið fyrir Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF mynd (Alliance for Open Media gaf út 2019, byggt á AV1 kóðun, þjöppunarhlutfall 50% betra en WebP, ný kynslóð vefmyndastaðals)"

msgid "mime_markdown"
msgstr "Markdown skjal (John Gruber hannaði 2004, létt merkingarmál, algengt snið fyrir GitHub README, tæknilega skjölun, umræðuþræði)"

msgid "mime_yaml"
msgstr "YAML stilling (Clark Evans hannaði 2001, mannlegra læsilegt gagnaröðunarsnið, staðall fyrir stillingaskrár fyrir Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML stilling (Tom Preston-Werner hannaði 2013, 'Tom's Obvious Minimal Language', stillingaskráarsnið fyrir nútíma verkfæri eins og Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue íhlutaskrá (kynnt árið 2014 af Evan You, framsækið JavaScript grindurverk. Með einni skráaríhlutum (SFC) sameinar það HTML, CSS og JS fullkomlega, sem eykur verulega skilvirkni við þróun. Það er eitt vinsælasta frontend grindurverk í heimi. Einnig sem kjarni nútíma kyrrstæðra vefmynda eins og VitePress, er það víða notað til að keyra gagnvirka tæknilega skjölun og blogg.)"

msgid "mime_wasm"
msgstr "WebAssembly eining (W3C staðall 2017, háafkasta keyrslusnið í vafra, C/C++/Rust/R geta þýtt sem mark, afköst nálægt innfæddum)"

msgid "mime_jsx"
msgstr "React JSX íhlutur (Facebook gaf út JavaScript XML 2013, íhlutasnið React grinds, nýstárleg nálgun sem færir HTML inn í JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX íhlutur (Microsoft þróaði 2012, TypeScript + JSX, staðlað skrifað mynstur fyrir týpuörugga React þróun)"

msgid "mime_heif"
msgstr "HEIF mynd (MPEG staðall 2015, skilvirkt myndaskráarsnið, mikið notað í Apple vistkerfinu)"

msgid "mime_heic"
msgstr "HEIC mynd (Apple útfærsla á HEIF, sjálfgefið mynda snið á iPhone, stutt innbyggt í iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D líkan (GL flutningssnið, 'JPEG 3D heimsins', Khronos Group gaf út 2015, staðlað snið fyrir Web 3D)"

msgid "mime_glb"
msgstr "GLB tvíundir 3D líkan (tvíundarútgáfa af GLTF, ein skrá inniheldur allar auðlindir, notuð til dreifingar 3D senna)"

msgid "mime_gls"
msgstr "GLOSSARY orðasafn (skrá með skilgreiningum hugtaka, fyrir hugtakastjórnun í skjölunarkerfum)"

msgid "mime_cbz"
msgstr "CBZ myndasögubók (ZIP þjappaðar myndasögumyndir, algengt snið fyrir myndasögusöfn)"

msgid "mime_cbr"
msgstr "CBR myndasögubók (RAR þjappaðar myndasögumyndir, algengt snið fyrir myndasögusöfn)"

msgid "mime_fb2"
msgstr "FB2 rafbók (FictionBook 2.0, rússneskt rafbókasnið, XML bygging, mikið stutt af opnum frumkóða lesum)"

msgid "mime_kepub"
msgstr "KEPUB rafbók (Kobo sérstakt EPUB snið, bestað snið fyrir Kobo rafbókalesara)"

msgid "mime_m4b"
msgstr "M4B hljóðbók (MPEG-4 hljóðsnið fyrir bækur, styður bókamerki, iTunes hljóðbókasnið)"

msgid "mime_kfx"
msgstr "Kindle KFX snið (Amazon gaf út 2015, sérstakt rafbókasnið fyrir Kindle, styður háþróaða uppsetningu og fljótímanlega blaðsíðuskipti)"

msgid "mime_chm"
msgstr "CHM hjálparskrá (Microsoft gaf út 1997, þýtt HTML hjálparsnið, staðall fyrir hjálparskjöl fyrir Windows hugbúnað)"

msgid "mime_mht"
msgstr "MHT vefsafn (Microsoft gaf út 1999, eins skráar vefsíðusnið, IE vafrinn snið til að vista vefsíður)"

msgid "mime_wml"
msgstr "WML þráðlaust merkingarmál (WAP staðall 1999, notað fyrir vefsíður á fyrstu farsímum, úrelt)"

msgid "mime_xhtml"
msgstr "XHTML vefsíða (W3C staðall 2000, XML útgáfa af HTML, strangari setningafræði. W3C hætti viðhaldi 2009, einbeitti sér að HTML5)"

msgid "mime_xml"
msgstr "XML skjal (W3C staðall 1998, útvíkjanlegt merkingarmál, grunnsnið fyrir vefþjónustur, stillingaskrár, gagnaskipti)"

msgid "mime_sgml"
msgstr "SGML skjal (ISO staðall 1986, forveri HTML, staðlað almennt merkingarmál, bæði XML og HTML eru komin frá SGML)"

msgid "mime_apng"
msgstr "APNG hreyfimynd (Mozilla þróaði 2004, hreyfimyndaútfærsla PNG, nútíma skipti fyrir GIF, styður alvöru liti og gagnsæi)"

msgid "mime_bmp"
msgstr "BMP bitmappa (Windows bitmappasnið, innfæddur stuðningur síðan Windows 1.0. Óþjappað, stór skráarstærð, en vegna einfaldrar uppbyggingar og skorts á þörf fyrir viðbótar kódekum, er það enn notað í klippingartæki Windows 11, Paint forritinu, táknauðlindum í EXE/MSI uppsetningarpökkum, bendilskrám og sumum eldri reklum. Við sömu myndgæði er skráarstærðin um 3-10 sinnum stærri en PNG. Í flestum tilfellum hefur því verið skipt út fyrir PNG/JPEG, en Windows vistkerfið viðheldur enn víðtæku samhæfni)"

msgid "mime_cdr"
msgstr "CDR vigurmynd (CorelDRAW sérstakt snið, kanadískt fyrirtæki Corel, hugbúnaður fyrir hönnun vigurmynda)"

msgid "mime_gif"
msgstr "GIF mynd (CompuServe þróaði 1987, 256 lita hreyfimyndasnið. Gallar: fáir litir, gróf myndgæði, styður ekki gagnsæi, stór skrá, lágur rammatíðni. Skipt út fyrir nútíma hreyfimyndasnið eins og APNG, WebP)"

msgid "mime_ico"
msgstr "ICO tákn (Windows táknasnið, styður margar upplausnir, staðlað snið fyrir favicon vefsíðna)"

msgid "mime_jpeg"
msgstr "JPEG mynd (ISO staðall 1992, gagnatapandi þjöppunarsnið fyrir ljósmyndir, staðreyndarstaðall fyrir ljósmyndir á internetinu)"

msgid "mime_jpg"
msgstr "JPEG mynd (ISO staðall 1992, gagnatapandi þjöppunarsnið fyrir ljósmyndir, staðreyndarstaðall fyrir ljósmyndir á internetinu)"

msgid "mime_png"
msgstr "PNG mynd (W3C tilmæli 1996, styður alvöru liti og gagnsæi, kyrrstæð skipti fyrir GIF, staðall fyrir gagnatapalausar myndir á internetinu)"

msgid "mime_ps"
msgstr "PostScript síðulýsingarskrá (Adobe gaf út 1985, síðulýsingarmál, forveri PDF, notað fyrir prentun og útgáfu)"

msgid "mime_psb"
msgstr "PSB stórt skjal (Adobe Photoshop snið fyrir afar stórar myndir, styður risastórar myndir yfir 2 GB eða 30000 pixla)"

msgid "mime_psd"
msgstr "PSD mynd (Adobe Photoshop upprunaleg skrá, styður lög, rásir, slóðir, iðnaðarstaðall fyrir myndvinnslu)"

msgid "mime_webp"
msgstr "WebP mynd (Google þróaði 2010, vefmyndasnið, styður gagnatapandi/gagnatapalausa þjöppun og hreyfimyndir, þjöppunarhlutfall 25-35% betra en PNG og 25% betra en JPEG)"

msgid "mime_woff"
msgstr "WOFF veffletur (búið til 2009, W3C staðall 2018. Þjappað byggt á TrueType/OpenType, bestað fyrir hleðslu veffletra, staðlað snið fyrir táknsletur á nútíma vefsíðum)"

msgid "mime_7z"
msgstr "7z þjöppuð skrá (Igor Pavlov þróaði 1999, sérstakt snið 7-Zip forritsins. LZMA reiknirit, hátt þjöppunarhlutfall, opinn frumkóði og ókeypis. 7z sniðið er venjulega 30-50% minna en ZIP við sama þjöppunarhlutfall, algengt snið í opna frumkóða samfélaginu og fyrir dreifingu hugbúnaðar)"

msgid "mime_ace"
msgstr "ACE þjöppuð skrá (þróuð á tíunda áratugnum, snið WinACE forritsins. Keppti eitt sinn við RAR, þjöppunarhlutfall var nokkuð hátt. Þróun hætt 2007, nú skipt út fyrir 7z/RAR, sjaldan notað)"

msgid "mime_bz2"
msgstr "BZIP2 þjöppuð skrá (Julian Seward þróaði 1996, þjöppunarreiknirit með flokkun blokka. Þjöppunarhlutfall 15-20% hærra en GZIP en hægara. Algengt snið fyrir frumkóða Linux kjarna, opna frumkóða hugbúnaðarpakka, viðbót .bz2)"

msgid "mime_cab"
msgstr "CAB þjöppuð skrá (Microsoft þróaði 1995, Cabinet snið. Uppsetningarpakkasnið fyrir Windows, notað fyrir rekla, dreifingu kerfisskrár. Windows Installer (MSI) notar innra CAB til að geyma skrár)"

msgid "mime_dmg"
msgstr "DMG diskmynd (Apple kynnti á 9. áratugnum, Disk Image snið. Staðlað snið fyrir dreifingu macOS hugbúnaðar, tvísmelltu til að setja upp sem sýndardisk, dragðu og slepptu til að setja upp forritið. Styður þjöppun og dulkóðun, er aðalsniðið fyrir niðurhal Mac hugbúnaðar)"

msgid "mime_emz"
msgstr "EMZ þjöppuð mynd (Windows þjöppuð aukin lýsigögn, þjöppuð útgáfa af EMF. Snið til geymslu á vigurmyndum í Office skjölum, í raun er það GZIP þjöppuð EMF skrá)"

msgid "mime_gz"
msgstr "GZIP þjöppuð skrá (Jean-loup Gailly og Mark Adler þróuðu 1992, GNU verkefni. Staðlað þjöppunarverkfæri í Unix/Linux, algengt snið fyrir HTTP flutningsþjöppun. Viðbót .gz, oft notað ásamt TAR)"

msgid "mime_jar"
msgstr "JAR þjöppuð skrá (Sun Microsystems gaf út 1997, Java ARchive snið. Í raun er þetta ZIP skrá, notað til að pakka Java bókasöfnum og forritum. Grunnsnið fyrir Java vistkerfi eins og Maven, Gradle. Android notar einnig JAR)"

msgid "mime_lzma"
msgstr "LZMA þjöppuð skrá (Igor Pavlov þróaði 1998, Lempel-Ziv-Markov keðju reiknirit. Aðal þjöppunarreiknirit 7z sniðsins, hátt þjöppunarhlutfall, hratt afþjöppunarhraði. Notað fyrir dreifingu fastbúnaðar og hugbúnaðar fyrir innbyggð kerfi)"

msgid "mime_rar"
msgstr "RAR þjöppuð skrá (Eugene Roshal þróaði 1993, Roshal ARchive snið. Hátt þjöppunarhlutfall, styður skiptingu í hluta og endurheimtuskrár. Snið WinRAR forritsins, þjöppunarhlutfall betra en ZIP en krefst greidds hugbúnaðar, opinn frumkóða verkfæri eins og unrar geta afþjappað)"

msgid "mime_tar"
msgstr "TAR safnskrá (Unix V7 kynnti 1979, Tape ARchive snið. Segulbandsafn, pakkar aðeins án þjöppunar, oft notað ásamt GZIP/BZIP2/XZ. Frumkóði Linux pakka, geymsla laga Docker mynda notar TAR snið)"

msgid "mime_tgz"
msgstr "TGZ þjöppuð skrá (samið snið TAR + GZIP, viðbót .tgz eða .tar.gz. Algengasta sniðið fyrir dreifingu Unix/Linux hugbúnaðarpakka, frumkóðapakkar, tvíundarpakkar, mikið notað, táknar 'afþjappaðu og notaðu')"

msgid "mime_tbz2"
msgstr "TBZ2 þjöppuð skrá (samið snið TAR + BZIP2, viðbót .tbz2 eða .tar.bz2. Þjöppunarhlutfall 15-20% hærra en TGZ, hentar fyrir dreifingu stórra skráa, Linux kjarninn notaði þetta snið lengi)"

msgid "mime_xz"
msgstr "XZ þjöppuð skrá (kynnt 2009, byggt á LZMA2 reikniriti. Mjög hátt þjöppunarhlutfall, 30-50% betra en GZIP, afþjöppunarhraði tiltölulega hratt. Linux kjarninn, pakkastjórar (eins og inni í .deb Debian) nota það mikið, mælt með sniði í núverandi Linux vistkerfi)"

msgid "mime_z"
msgstr "Z þjöppuð skrá (snið Unix compress skipunarinnar frá 1985, LZW reiknirit. Snemma Unix þjöppunarsnið, skipt út fyrir GZIP. Viðbót .Z, nútíma kerfi nota það sjaldan)"

msgid "mime_zip"
msgstr "ZIP þjöppuð skrá (Phil Katz þróaði 1989, PKZIP snið. Windows styður náttúrulega, algengasta þjöppunarsniðið á internetinu. Styður margar skrár, skráasafnsbyggingu, getur valið þjöppunarreiknirit. JAR frá Java, APK frá Android, DOCX/XLSX frá Office skjölum byggja á ZIP sniði)"

msgid "mime_zst"
msgstr "Zstandard þjöppuð skrá (Facebook þróaði 2015, hannað af Yann Collet. Háhraða þjöppunarreiknirit, þjöppunarhlutfall nálægt LZMA, hraði langt umfram GZIP. Linux kjarni 5.9+ styður, Arch Linux pacman, Debian APT taka það smám saman upp, ný kynslóð þjöppunarstaðals)"

msgid "mime_lz4"
msgstr "LZ4 þjöppuð skrá (Yann Collet þróaði 2011, afar hratt þjöppunarreiknirit. Þjöppunarhraði meira en 10 sinnum hraðari en GZIP, hentar fyrir rauntíma þjöppun. Linux kjarninn, OpenZFS, Hadoop nota það mikið, fyrsta val þegar hraði er í forgangi)"

msgid "mime_lzo"
msgstr "LZO þjöppuð skrá (Markus Oberhumer þróaði 1996, Lempel-Ziv-Oberhumer reiknirit. Afþjöppunarhraði afar hratt, þjöppunarhlutfall meðal. Linux kjarninn Squashfs, OpenWrt fastbúnaður nota það, hentar fyrir innbyggð kerfi)"

msgid "mime_msi"
msgstr "MSI uppsetningarpakki (Microsoft gaf út 1999, Windows Installer pakkasnið. Staðlað uppsetningarsnið fyrir Windows forrit, styður viðsnúning færslna, stjórnun íhluta, hljóðláta uppsetningu. Fyrsta val fyrir dreifingu hugbúnaðar á fyrirtækjastigi, enn aðalsniðið fyrir uppsetningu Windows hugbúnaðar í dag)"

msgid "mime_pkg"
msgstr "PKG uppsetningarpakki (macOS uppsetningarpakkasnið fyrir forrit, byggt á Installer tækni Apple. Staðlað snið fyrir dreifingu macOS hugbúnaðar, styður val á íhlutum, uppsetningarskrift, fjarlægingaraðgerð. Tvísmelltu á .pkg skrána til að setja upp, algeng dreifingaraðferð fyrir hugbúnað fyrir utan Mac App Store)"

msgid "mime_apk"
msgstr "APK Android forritapakki (kynntur af Google árið 2008, hefðbundið uppsetningarform fyrir Android forrit. APK er í raun ZIP pakki sem inniheldur kóða, auðlindir og stillingarskrá. Frá 2021 krefst Google Play þess að ný forrit noti AAB sniðið, en APK er enn notað við villuleit, þriðja aðila verslanir og hliðaruppsetningu)"

msgid "mime_ipa"
msgstr "IPA iOS forritapakki (iOS App Store Package, uppsetningarform fyrir iOS/iPadOS forrit. Kynntur árið 2008 með iPhone SDK. Verður að dreifa í gegnum App Store eða vera undirritaður með fyrirtækjavottorði. Inniheldur keyrsluskrá, auðlindir, Info.plist og undirritunarupplýsingar)"

msgid "mime_hap"
msgstr "HAP HarmonyOS forritapakki (HarmonyOS Ability Package, grunneining HarmonyOS forrits. Kynntur árið 2020 með HarmonyOS 2.0. Styður tvær gerðir: entry og feature, dreifingarform fyrir Huawei síma, spjaldtölvur, snjallúr og önnur HarmonyOS tæki)"

msgid "mime_har"
msgstr "HAR HarmonyOS kyrrstætt sameiginlegt bókasafn (HarmonyOS Archive, kyrrstætt sameiginlegt bókasafn HarmonyOS, geta deilt með mörgum HAP pökkum, notað fyrir íhlutamiðaða þróun og endurnotkun eininga)"

msgid "mime_aab"
msgstr "Android App Bundle (Google gaf út 2018, frá 2021 krefst Google Play að ný forrit noti þetta snið. AAB er dreifingarsnið, Google Play býr til bestuð APK í samræmi við stillingar tækis (CPU arkitektúr, skjáþéttleiki, tungumál), stærð uppsetningarpakka minnkar að meðaltali um 35%. Forritarar hlaða upp AAB, notendur hlaða niður APK)"

msgid "mime_xapk"
msgstr "XAPK forritspakki (þriðja aðila Android forritsvíðtökupakki, inniheldur APK + OBB gagnaskrár. Notað fyrir stóra leiki og flókin forrit, leysir 100 MB takmörkun fyrir eina APK skrá. Algengt í þriðja aðila forritaverslunum eins og APKPure, APKMirror, ekki opinbert Google snið)"

msgid "mime_appx"
msgstr "Windows forritspakki (Microsoft gaf út 2012, uppsetningarsnið fyrir Windows 8/10/11 forrit. Styður UWP forrit og umbreytingu skrifborðsforrita, dreift í gegnum Microsoft Store. Árið 2024 kynnti Microsoft MSIX sem erfingja, skiptir smám saman út APPX)"

msgid "mime_msix"
msgstr "MSIX forritspakki (Microsoft gaf út 2018, ný kynslóð umbúðasniðs fyrir Windows forrit. Sameinar kosti APPX og MSI, styður allar tegundir Windows forrita, hægt að dreifa í gegnum Microsoft Store eða hliðaruppsetningu, mælt með sniði fyrir Windows 11)"

msgid "mime_appimage"
msgstr "AppImage forritspakki (kynntur 2004, Linux forritasnið án uppsetningar. 'Eitt forrit - ein skrá', keyrir beint án uppsetningar, styður flestar Linux dreifingar, algeng leið fyrir forritara til að dreifa Linux hugbúnaði)"

msgid "mime_flatpak"
msgstr "Flatpak forritspakki (kynntur 2015, Linux forritasnið í sandkassa. Virkar yfir dreifingar, einangrað frá gestgjafakerfi, þróun stýrt af Fedora og Red Hat, sjálfgefið snið GNOME hugbúnaðarmiðstöðvar)"

msgid "mime_snap"
msgstr "Snap forritspakki (Canonical gaf út 2014, móðurfyrirtæki Ubuntu þróaði, alhliða Linux forritasnið. Sjálfvirk uppfærsla, sandkassa einangrun, styður 40+ Linux dreifingar, sjálfgefið snið Ubuntu hugbúnaðarmiðstöðvar)"

msgid "mime_deb"
msgstr "Debian hugbúnaðarpakki (Debian verkefnið gaf út 1993, staðlað uppsetningarsnið fyrir Debian/Ubuntu og afleiddar útgáfur. Stjórnað með dpkg, APT er pakkastjóri framenda hans, eitt af fullþroskuðustu pakkasniðum í Linux vistkerfinu, enn aðalsniðið í Debian fjölskyldunni í dag)"

msgid "mime_rpm"
msgstr "RPM hugbúnaðarpakki (Red Hat gaf út 1997, staðlað snið fyrir dreifingar eins og Red Hat/Fedora/CentOS/SUSE. RPM stendur fyrir 'Red Hat Package Manager', ásamt DEB eru tvö helstu pakkasnið Linux, enn aðalsniðið í RHEL fjölskyldunni í dag)"

msgid "mime_pacman"
msgstr "Arch hugbúnaðarpakki (Arch Linux gaf út 2002, .pkg.tar.zst sniðið sem pacman pakkastjórinn notar. Kjarni Arch Linux rolling release dreifinganna, þekktur fyrir einfaldleika sinn og KISS meginregluna, AUR (Arch User Repository) er einkenni hans)"

msgid "mime_exe"
msgstr "EXE keyrsluskrá (Windows keyrslu forritssnið, skammstöfun fyrir 'Executable'. Upprunalegt keyrslusnið Windows stýrikerfisins, inniheldur PE byggingu. Þróaðist frá MZ sniði frá MS-DOS tímabilinu, Windows NT kynnti PE (Portable Executable) sniðið árið 1993 og er enn notað í dag. Uppsetningarpakkar hugbúnaðar, forrit, kerfisverkfæri nota þetta snið. Notandinn tvísmellir til að keyra það, mest notaða keyrslusnið í heimi)"

msgid "mime_dll"
msgstr "DLL dynamískt tengt bókasafn (Microsoft kynnti 1993, Dynamic Link Library. Sameiginlegt kóðabókasafn Windows, forritið hleðst inn dynamískt meðan á keyrslu stendur, sparir minni og diskpláss. Kerfisíhlutir, forritsviðbætur, reklar nota DLL snið. Helsta leiðin til að innleiða Windows API, 'DLL helvíti' vandamálið hefur minnkað á .NET tímabilinu)"

msgid "mime_com"
msgstr "COM keyrsluskrá (keyrslusnið frá MS-DOS tímabilinu, skammstöfun fyrir 'Command'. Mjög einföld skráabygging, 64KB takmörkun, aðalsnið fyrir Windows 3.x, úrelt. Nútíma Windows nota EXE snið, COM viðbótin er enn notuð fyrir sumar íhlutaskrár)"

msgid "mime_aac"
msgstr "AAC hljóð (MPEG staðall 1997, Advanced Audio Coding. Eftirmaður MP3, hljóðgæði betri en MP3 við sama bitahraða, sjálfgefið hljóðsnið fyrir YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC hljóð (Apple þróaði 2004, Apple Lossless Audio Codec. Apple gagnatapalaust snið, opinn frumkóði 2011, sjálfgefið gagnatapalaust snið fyrir iTunes og Apple Music)"

msgid "mime_flac"
msgstr "FLAC hljóð (Xiph.Org stofnunin þróaði 2001, Free Lossless Audio Codec. Gagnatapalaus þjöppun, hljóðgæði eins og á geislaplötu, skráarstærð um helming upprunalegs WAV. Opinn frumkóði og einkaleyfislaus, valið snið fyrir hljóðfræðinga og stafræna tónlistarsöfn)"

msgid "mime_mp3"
msgstr "MP3 hljóð (Fraunhofer stofnunin þróaði 1993, MPEG-1 Audio Layer 3. Gagnatapandi þjöppunarsnið, lítil skrá með ásættanlegum hljóðgæðum, aðalsniðið í stafrænu tónlistarbyltingunni á 21. öld, ábyrgt fyrir iPod og Napster. Einkaleyfi runnu út árið 2017, varð almenningseign)"

msgid "mime_oga"
msgstr "Ogg Audio hljóð (þróað af Xiph.Org stofnuninni, hreint hljóðsnið af Ogg íláti, notar Vorbis kóðun. Opinn frumkóði og einkaleyfislaus, skilvirkni þjöppunar betri en MP3, mikið notað í opnum frumkóða verkefnum)"

msgid "mime_ogg"
msgstr "OGG hljóð (Xiph.Org stofnunin þróaði 2000, Ogg Vorbis snið. Opinn frumkóði og einkaleyfislaus, skilvirkni þjöppunar betri en MP3, snemma Spotify notaði það, mikið notað fyrir hljóðbrellur í leikjum)"

msgid "mime_opus"
msgstr "Opus hljóð (IETF staðlaði 2012, opið og einkaleyfislaust hljóðsnið, sameinar SILK og CELT tækni, mjög lítil töf, hæsta skilvirkni þjöppunar, sjálfgefið hljóðsnið fyrir WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV hljóð (Microsoft og IBM þróuðu 1991, innfæddur hljóðsnið Windows. PCM kóðun, óþjappað, gagnatapalaus hljóðgæði en mjög stór skrá, staðlað snið fyrir faglega hljóðvinnslu)"

msgid "mime_wma"
msgstr "WMA hljóð (Microsoft þróaði 1999, Windows Media Audio. Er með gagnatapandi/gagnatapalausar útgáfur, innfæddur stuðningur Windows, dreifðist með Windows Media Player. Nú á jaðrinum, skipt út fyrir MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF hljóð (Direct Stream Digital snið, þróað af Sony og Philips. 1 bita há tíðni sýnatöku, staðlað DSD hljóðsnið, stafræn útgáfa af SACD, hágæða hljóðsnið fyrir hljóðfræðinga, mjög stór skrá)"

msgid "mime_ape"
msgstr "APE Hljóð (þróað af Monkey's Audio árið 2000, tapþjöppunarsnið. Meiri þjöppun en FLAC en hægari kóðun, enn notað á Windows vettvangi og meðal hljóðáhugamanna)"

msgid "mime_mid"
msgstr "MIDI hljóð (MIDI samtökin settu 1983, Musical Instrument Digital Interface. Nótna snið, ekki upptaka, mjög lítil skrá, staðall fyrir rafræn hljóðfæri, hringitóna síma, hljóðbrellur í leikjum. General MIDI var staðlað 1991, skilgreinir 128 hljóðfæri)"

msgid "mime_m4a"
msgstr "M4A hljóð (MPEG-4 Audio, ílátssnið fyrir AAC. Staðlað snið iTunes tónlistarverslunar, aðal hljóðsnið í Apple vistkerfinu, styður DRM vernd)"

msgid "mime_m3u"
msgstr "M3U spilunarlisti (MP3 URL spilunarlistasnið, venjuleg textaskrá, skráir slóðir hljóðskráa. Staðall frá Winamp tímabilinu, notað fyrir netútvörp, streymi tónlistar á netinu. M3U8 er UTF-8 útgáfa þess, notuð fyrir HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF streymi (Microsoft þróaði 1996, Advanced Systems Format. Windows Media streymisílát, styður samstillta flutning á hljóði og myndbandi. Notað fyrir beinar netútsendingar og myndband á eftirspurn streymi, WMA/WMV byggja á ASF ílátinu)"

msgid "mime_avi"
msgstr "AVI myndband (Microsoft gaf út 1992, snemma Windows myndbandsstaðall. 'Audio Video Interleave', víxlar hljóði og myndbandi, var vinsælasta myndbandssniðið á árunum 1990-2000, nú skipt út fyrir MP4/MKV)"

msgid "mime_divx"
msgstr "DivX myndband (DivX fyrirtækið þróaði 1998, myndbandskódek snið byggt á MPEG-4. Aðalsnið fyrir miðlun myndbanda á netinu á 20. öld, fyrsta tæknin sem þjappaði DVD gæðum á geislaplötustærð. Vegna höfundarréttardeilna, breyttist síðar í viðskiptalegan kóðara)"

msgid "mime_mp4"
msgstr "MP4 myndband (MPEG staðall 2001, MPEG-4 Part 14. Algengasta myndbandssnið heims, styður H.264/H.265 kóðun, sjálfgefið snið fyrir myndband á netinu, upptöku með farsíma, YouTube)"

msgid "mime_m4v"
msgstr "M4V myndband (iTunes myndbandssnið, afbrigði af MP4. Myndbandssnið í Apple vistkerfinu, staðlað snið fyrir kvikmyndir og sjónvarpsefni í iTunes Store, styður DRM höfundarréttarvernd)"

msgid "mime_mpeg"
msgstr "MPEG myndband (MPEG samtökin settu 1988, Moving Picture Experts Group. Lögðu grunninn að stöðlum fyrir þjöppun stafræns myndbands, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (netmyndband) höfðu mikil áhrif)"

msgid "mime_mkv"
msgstr "MKV myndband (Matroska verkefnið þróaði 2002, opið margmiðlunarílát. Styður margar hljóðrásir, marga texta, kafla, 'umbúðatól', valið snið fyrir miðlun á hárri upplausn kvikmynda)"

msgid "mime_mpg"
msgstr "MPEG myndband (MPEG-1/MPEG-2 myndbandaviðbætur, staðlað snið fyrir VCD og DVD. Aðal myndbandssnið á geisladiskum á árunum 1990-2000, nú skipt út fyrir H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video myndband (þróað af Xiph.Org stofnuninni, myndbandssnið Ogg íláts, notar Theora kóðun. Opið og einkaleyfislaust, einn af fyrstu stöðlunum fyrir HTML5 myndband, Firefox styður það innfædda)"

msgid "mime_ogx"
msgstr "Ogg margmiðlunarílát (þróað af Xiph.Org stofnuninni, almenn framlenging á Ogg íláti, getur innihaldið margar rásir eins og hljóð, myndband, texta. Opinn margmiðlunarstaðall, notað fyrir leiki, streymi)"

msgid "mime_rm"
msgstr "RealMedia myndband (RealNetworks þróaði 1995, RealMedia snið. Brautryðjandi netstreymis á árunum 1990-2000, aðalsnið RealPlayer spilarans. Gallar: krefst sérstaks spilara, léleg þjöppunargæði, síðar skipt út fyrir Flash/MP4)"

msgid "mime_flv"
msgstr "Flash myndband (sniðið kom fram 2002, Flash Video snið. Var einu sinni aðal myndbandssnið á netinu. Snemma YouTube notaði það. Gallar: þörf fyrir Flash viðbót, léleg afköst, margir öryggisveikleikar. Frá 2015 hafa helstu vefsíður skipt yfir í HTML5 myndband, nú úrelt)"

msgid "mime_f4v"
msgstr "F4V myndband (Flash myndbandssnið þróað af Adobe, eftirmaður FLV. Byggt á MPEG-4 staðlinum, styður H.264 kóðun. Úrelt ásamt Flash tækninni, Adobe lagði niður stuðning árið 2020)"

msgid "mime_wmv"
msgstr "WMV myndband (Microsoft þróaði 1999, Windows Media Video. Innfæddur stuðningur Windows, bestað fyrir streymi, var algengt snið í snemma netmyndbandi, nú á jaðrinum)"

msgid "mime_wmf"
msgstr "WMF margmiðlunarsnið (Windows Media Format, margmiðlunarrammi Microsoft, nær yfir WMV myndband, WMA hljóð, Windows Media Player styður innfædda)"

msgid "mime_mov"
msgstr "MOV myndband (Apple þróaði 1991, QuickTime ílátssnið. Staðlað snið fyrir faglega myndbands klippingu, styður marga kóða, Final Cut Pro og Premiere styðja innfædda)"

msgid "mime_qt"
msgstr "QuickTime myndband (Apple gaf út 1991, QuickTime snið. Myndbandsstaðall á Mac vettvangi, MOV er ílát hans, QuickTime spilarinn var áður mikið notaður. Apple lagði niður þróun Windows útgáfunnar árið 2016, skiptir smám saman út fyrir MP4)"

msgid "mime_webm"
msgstr "WebM myndband (Google gaf út 2010, opið og einkaleyfislaust myndbandssnið. Byggt á Matroska ílátinu, VP8/VP9 kóðun, staðlað HTML5 myndbandssnið, sjálfgefið snið fyrir spilun á YouTube á vefnum)"

msgid "mime_3gp"
msgstr "3GP myndband (3GPP setti 2000, myndbandssnið fyrir farsíma. Mjög lítil skrá, lág gæði, snið fyrir myndbandsupptöku á fyrstu farsímum, notað fyrir MMS sendingar)"

