# ഫോർമാറ്റ് വിവരണങ്ങൾ
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "ടെക്സ്റ്റ് ഫയൽ (1963-ൽ ASCII മാനകീകരിക്കപ്പെട്ടു, ഫോർമാറ്റിംഗ് ഇല്ലാത്ത ലളിതമായ ടെക്സ്റ്റ്. എല്ലാ സോഴ്സ് കോഡ്, കോൺഫിഗറേഷൻ, ലോഗുകളുടെ അടിസ്ഥാനം. Unix-ൽ LF, Windows-ൽ CRLF ഉപയോഗിക്കുന്നു, ഇന്നും കമ്പ്യൂട്ടറുകളിൽ ഏറ്റവും സാധാരണമായ ഡാറ്റ ഫോർമാറ്റ്)"

msgid "mime_log"
msgstr "ലോഗ് ഫയൽ (സിസ്റ്റം, അപ്ലിക്കേഷന്റെ വിവരങ്ങൾ രേഖപ്പെടുത്തുന്നു, സാധാരണയായി പിശകുകൾ കണ്ടെത്തൽ, പ്രകടന വിശകലനം, സുരക്ഷാ ഓഡിറ്റിംഗ് എന്നിവയ്ക്ക് ഉപയോഗിക്കുന്നു. സ്റ്റാൻഡേർഡ് ഫോർമാറ്റുകൾ: Apache combined log, Nginx access log, syslog)"

msgid "mime_page"
msgstr "HTML വെബ് പേജ് (1989-ൽ ടിം ബെർണേഴ്സ്-ലീ വേൾഡ് വൈഡ് വെബ് കണ്ടുപിടിച്ചു, 1990-ൽ HTML/HTTP/URL എന്നീ മൂന്ന് മൂല സാങ്കേതികവിദ്യകൾ നിർവചിച്ചു, പേറ്റന്റ് ഇല്ലാതെ സൗജന്യമായി തുറന്നുകൊടുത്തു. 2014-ൽ HTML5 W3C ഔദ്യോഗിക മാനകമായി. 2016-ൽ ട്യൂറിംഗ് പുരസ്കാരം നേടി)"

msgid "mime_khtml"
msgstr "KHTML വെബ് എഞ്ചിൻ (1998-ൽ KDE 2.0-നൊപ്പം പുറത്തിറങ്ങി, Konqueror ബ്രൗസറിന്റെ റെൻഡറിംഗ് എഞ്ചിൻ. 2001-ൽ ആപ്പിൾ KHTML അടിസ്ഥാനമാക്കി WebKit സൃഷ്ടിച്ചു, 2008-ൽ ഗൂഗിൾ WebKit-ൽ നിന്ന് Blink ഫോർക്ക് ചെയ്തു, ഇത് Chrome, Edge, Safari ബ്രൗസറുകളുടെ കോർ ആയി. KHTML ഓപ്പൺ സോഴ്സ് കമ്മ്യൂണിറ്റിയുടെ ഉദാഹരണമാണ്, ഇത് ആധുനിക ബ്രൗസർ എഞ്ചിനുകൾക്ക് അടിത്തറ പാകി)"

msgid "mime_script"
msgstr "ഡൈനാമിക് സ്ക്രിപ്റ്റ് (കമ്പൈൽ ചെയ്യാതെ, ഇന്റർപ്രെറ്റ് ചെയ്യപ്പെടുന്ന ഭാഷ. ASP, JSP, CGI, ColdFusion, Tcl, VBScript എന്നിവ ഉൾപ്പെടുന്നു, ആദ്യകാല വെബ് വികസനത്തിൽ, സിസ്റ്റം മാനേജ്മെന്റിൽ, ഓട്ടോമേഷൻ ജോലികളിൽ വ്യാപകമായി ഉപയോഗിച്ചിരുന്നു. ആധുനിക സ്ക്രിപ്റ്റിംഗ് ഭാഷകളായ Python, Ruby, JavaScript ഇപ്പോൾ പൂർണ്ണ തോതിലുള്ള പ്രോഗ്രാമിംഗ് ഭാഷകളാണ്)"

msgid "mime_js"
msgstr "JavaScript സ്ക്രിപ്റ്റ് (1995-ൽ Brendan Eich Netscape-ൽ 10 ദിവസത്തിനുള്ളിൽ സൃഷ്ടിച്ചു, ബ്രൗസറിന്റെ നേറ്റീവ് പ്രോഗ്രാമിംഗ് ഭാഷ. 1997-ൽ ECMAScript മാനകീകരിക്കപ്പെട്ടു, 2009-ൽ Node.js സൃഷ്ടിക്കപ്പെട്ടതോടെ ഇത് പൂർണ്ണ തോതിലുള്ള ഭാഷയായി മാറി, npm ലോകത്തിലെ ഏറ്റവും വലിയ പാക്കേജ് മാനേജറാണ്. GitHub-ലെ ഏറ്റവും ജനപ്രിയമായ പ്രോഗ്രാമിംഗ് ഭാഷ)"

msgid "mime_py"
msgstr "Python സ്ക്രിപ്റ്റ് (1991-ൽ Guido van Rossum സൃഷ്ടിച്ചു, നിർബന്ധിത ഇൻഡന്റേഷൻ, ലളിതമായ സിന്റാക്സ് എന്നിവയാൽ സവിശേഷത. വെബ് വികസനം, ഡാറ്റ സയൻസ്, ആർട്ടിഫിഷ്യൽ ഇന്റലിജൻസ്, ഓട്ടോമേഷൻ എന്നിവയിൽ വ്യാപകമായി ഉപയോഗിക്കുന്നു. TIOBE വാർഷിക പ്രോഗ്രാമിംഗ് ഭാഷാ പുരസ്കാരം പലതവണ നേടിയിട്ടുണ്ട്)"

msgid "mime_sh"
msgstr "ഷെൽ സ്ക്രിപ്റ്റ് (1971-ൽ Unix-നൊപ്പം, കമാൻഡ് സ്ക്രിപ്റ്റിംഗ് ഭാഷ. സിസ്റ്റം മാനേജ്മെന്റ്, ഓട്ടോമേഷൻ ജോലികൾ, സേവനങ്ങൾ ആരംഭിക്കൽ, വിന്യാസ സ്ക്രിപ്റ്റുകൾ എന്നിവയ്ക്ക് ഉപയോഗിക്കുന്നു. Linux അഡ്മിനിസ്ട്രേഷനിലെ അനിവാര്യ കഴിവ്)"

msgid "mime_rb"
msgstr "Ruby സ്ക്രിപ്റ്റ് (1995-ൽ Yukihiro Matsumoto സൃഷ്ടിച്ചു, ഡെവലപ്പർമാരുടെ സന്തോഷത്തിൽ ശ്രദ്ധ കേന്ദ്രീകരിക്കുന്നു. Ruby on Rails ഫ്രെയിംവർക്ക് "സംപ്രദായത്തേക്കാൾ കോൺഫിഗറേഷൻ മികച്ചത്" എന്ന മാതൃക അവതരിപ്പിച്ചു, ഇത് ആധുനിക വെബ് ഫ്രെയിംവർക്കുകളുടെ രൂപകൽപ്പനയെ സ്വാധീനിച്ചു)"

msgid "mime_pl"
msgstr "Perl സ്ക്രിപ്റ്റ് (1987-ൽ Larry Wall സൃഷ്ടിച്ചു, പ്രായോഗികതയ്ക്ക് പേരുകേട്ടതാണ്, "സ്വിസ് ആർമി നൈഫ്" എന്ന് വിളിക്കപ്പെടുന്നു. CPAN ആധുനിക ഭാഷാ പാക്കേജ് മാനേജർമാരുടെ മുൻഗാമിയായിരുന്നു, ടെക്സ്റ്റ് പ്രോസസ്സിംഗ്, സിസ്റ്റം മാനേജ്മെന്റ്, CGI എന്നീ മേഖലകളിൽ പ്രധാന സ്വാധീനം ചെലുത്തി)"

msgid "mime_php"
msgstr "PHP ഡൈനാമിക് പേജ് (1995-ൽ Rasmus Lerdorf സൃഷ്ടിച്ചു, പ്രത്യേകിച്ച് വെബ് വികസനത്തിനായി. ലോകത്തിലെ വെബ്സൈറ്റുകളിൽ 70% ഉപയോഗിക്കുന്നു, WordPress, Facebook, Wikipedia എന്നിവ ഉൾപ്പെടെ. PHP 8 JIT കമ്പൈലേഷൻ അവതരിപ്പിച്ചു, പ്രകടനം ഗണ്യമായി മെച്ചപ്പെടുത്തി)"

msgid "mime_image"
msgstr "ചിത്ര ഫയൽ"

msgid "mime_document"
msgstr "പ്രമാണ ഫയൽ"

msgid "mime_package"
msgstr "സോഫ്റ്റ്വെയർ പാക്കേജ്"

msgid "mime_archive"
msgstr "Gzip കംപ്രസ് ചെയ്ത ഫയൽ (1992-ൽ GNU പ്രോജക്റ്റ്, DEFLATE അൽഗോരിതത്തെ അടിസ്ഥാനമാക്കി. വെബിൽ ഡൈനാമിക് കംപ്രഷനായി ഉപയോഗിക്കുന്നു, കംപ്രഷൻ നിരക്ക് സാധാരണയായി 60-90%. 2015-ന് ശേഷം Brotli കൊണ്ട് ഭാഗികമായി മാറ്റിസ്ഥാപിച്ചു, എന്നാൽ ഇപ്പോഴും സെർവറുകളിൽ ഏറ്റവും സാധാരണമായ കംപ്രഷൻ ഫോർമാറ്റാണ്)"

msgid "mime_audio"
msgstr "ഓഡിയോ ഫയൽ"

msgid "mime_video"
msgstr "വീഡിയോ ഫയൽ"

msgid "mime_jscript"
msgstr "JavaScript (1995-ൽ Brendan Eich സൃഷ്ടിച്ചു)"

msgid "mime_json"
msgstr "JSON ഡാറ്റ (2001-ൽ Douglas Crockford നിർദ്ദേശിച്ചു, ലഘുവായ ഡാറ്റ കൈമാറ്റ ഫോർമാറ്റ്, Web API യുടെ യഥാർത്ഥ മാനകം)"

msgid "mime_vbs"
msgstr "VBScript (1996-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, വിൻഡോസ് സ്ക്രിപ്റ്റിംഗ് ഭാഷ, ASP പേജുകളിലും വിൻഡോസ് മാനേജ്മെന്റ് സ്ക്രിപ്റ്റുകളിലും ഉപയോഗിക്കുന്നു. PowerShell, JavaScript എന്നിവയുടെ വ്യാപനത്തോടെ, ക്രമേണ പഴയതായി മാറി)"

msgid "mime_conf"
msgstr "കോൺഫിഗറേഷൻ ഫയൽ (സോഫ്റ്റ്വെയർ കോൺഫിഗറേഷൻ ടെക്സ്റ്റ് ഫോർമാറ്റിൽ സംഭരിക്കുന്നു, സാധാരണ ഫോർമാറ്റുകൾ: INI, JSON, YAML, TOML, XML. Linux സിസ്റ്റം കോൺഫിഗറേഷനുകൾ മിക്കവയും /etc ഡയറക്ടറിയിലാണ്)"

msgid "mime_css"
msgstr "CSS സ്റ്റൈൽ ഷീറ്റ് (1996 ഡിസംബറിൽ W3C ആദ്യ ഔദ്യോഗിക മാനകമായ CSS1 പ്രസിദ്ധീകരിച്ചു, 1998-ൽ CSS2 ലേഔട്ടും മീഡിയ തരങ്ങളും ചേർത്തു, 2011 മുതൽ CSS3 മൊഡ്യൂളർ പതിപ്പ് റൗണ്ട് കോണുകൾ, അനിമേഷൻ, Flexbox, Grid ലേഔട്ട്, റെസ്പോൺസീവ് ഡിസൈൻ എന്നിവ അവതരിപ്പിച്ചു. HTML, JavaScript എന്നിവയ്ക്കൊപ്പം ഫ്രണ്ട്-എൻഡിന്റെ മൂന്ന് പ്രധാന സാങ്കേതികവിദ്യകളിൽ ഒന്നാണ്, എല്ലാ ആധുനിക ബ്രൗസറുകളും (Chrome, Firefox, Safari, Edge) സ്വദേശിയമായി പിന്തുണയ്ക്കുന്നു, പേജ് ശൈലി നിർവചിക്കുന്നതിനുള്ള ഏക മാനകമാണ്)"

msgid "mime_xsl"
msgstr "XSL സ്റ്റൈൽ ഷീറ്റ് (1999-ൽ W3C മാനകം, XML പ്രമാണ രൂപാന്തരീകരണ ഭാഷ, XML-നെ HTML/PDF/ടെക്സ്റ്റാക്കി മാറ്റാൻ കഴിയും. JSON വ്യാപിച്ചതിന് ശേഷം ഉപയോഗം കുറഞ്ഞു)"

msgid "mime_runtime"
msgstr "എക്സിക്യൂട്ടബിൾ ഫയൽ (EXE, ELF, Mach-O ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ എക്സിക്യൂട്ട് ചെയ്യാവുന്ന ഫോർമാറ്റുകൾ, മെഷീൻ കോഡും ലോഡിംഗ് വിവരങ്ങളും ഉൾക്കൊള്ളുന്നു)"

msgid "mime_library"
msgstr "ലൈബ്രറി ഫയൽ (DLL, SO, dylib ഡൈനാമിക് ലിങ്ക് ലൈബ്രറികൾ, പ്രോഗ്രാം പ്രവർത്തിപ്പിക്കുമ്പോൾ ലോഡ് ചെയ്യുന്നു)"

msgid "mime_swf"
msgstr "Flash അനിമേഷൻ (1996-ൽ Macromedia വികസിപ്പിച്ചു, പിന്നീട് Adobe ഏറ്റെടുത്തു. സംവേദനാത്മക വെബ് അനിമേഷന്റെ മാനകം, ഇൻറർനെറ്റ് അനിമേഷനിലും ഗെയിമുകളിലും ആധിപത്യം സ്ഥാപിച്ചു. ന്യൂനതകൾ: പ്ലഗിനെ ആശ്രയിക്കുന്നു, മൊബൈൽ ഉപകരണങ്ങളിൽ പ്രവർത്തിച്ചിരുന്നില്ല, ഉയർന്ന സുരക്ഷാ അപകടസാധ്യത. 2017-ൽ Adobe പിന്തുണ നിർത്തലാക്കുന്നതായി പ്രഖ്യാപിച്ചു, 2020-ൽ പൂർണ്ണമായും നിർത്തലാക്കപ്പെട്ടു, HTML5/CSS3/JS കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു)"

msgid "mime_dtd"
msgstr "DTD ഡോക്യുമെന്റ് തരം നിർവചനം (XML വിവരണം, XML ഡോക്യുമെന്റിന്റെ ഘടന നിർവചിക്കുന്നു, XML-ന്റെ സാധുത പരിശോധിക്കുന്നതിന്)"

msgid "mime_csv"
msgstr "CSV ഡാറ്റ ഫോർമാറ്റ് (കോമ കൊണ്ട് വേർതിരിച്ച മൂല്യങ്ങൾ, പട്ടിക ഡാറ്റയുടെ സാർവത്രിക ഫോർമാറ്റ്, Excel, ഡാറ്റാബേസ് ഇറക്കുമതി/കയറ്റുമതി മാനകം)"

msgid "mime_jnlp"
msgstr "Java Web Start (ജാവ അപ്ലിക്കേഷൻ ലോഞ്ചർ, 2000-കളിൽ ജാവ ഡെസ്ക്ടോപ്പ് അപ്ലിക്കേഷനുകൾ വിതരണം ചെയ്യുന്നതിനുള്ള സാങ്കേതികവിദ്യ, ഇപ്പോൾ പഴയതായി മാറി)"

msgid "mime_lit"
msgstr "Microsoft Reader ഇ-ബുക്ക് (2000-ൽ Microsoft പുറത്തിറക്കി, LIT ഫോർമാറ്റ്, ഇപ്പോൾ പഴയതായി മാറി)"

msgid "mime_svg"
msgstr "SVG വെക്റ്റർ ഗ്രാഫിക്സ് (1999-ൽ W3C മാനകം, Microsoft അതിന്റെ സ്വന്തം VML ഫോർമാറ്റ് ദീർഘകാലം പ്രചരിപ്പിച്ചതിനാൽ, IE ബ്രൗസർ 2011 വരെ പിന്തുണച്ചിരുന്നില്ല, ഇത് വ്യാപനത്തെ വൈകിപ്പിച്ചു. 2015-ന് ശേഷം, IE നിർത്തലാക്കലും ഉയർന്ന റെസലൂഷൻ സ്ക്രീനുകളുടെ വ്യാപനവും കാരണം, ഐക്കണുകൾ, ലോഗോകൾ എന്നിവയ്ക്കുള്ള ഇഷ്ടപ്പെട്ട ഫോർമാറ്റായി മാറി)"

msgid "mime_ai"
msgstr "Adobe Illustrator വെക്റ്റർ ഗ്രാഫിക്സ് (1987-ൽ പുറത്തിറങ്ങി, വ്യവസായ മാനക വെക്റ്റർ ഗ്രാഫിക്സ് ഫോർമാറ്റ്, പ്രിന്റ് ഡിസൈൻ, ലോഗോകൾ, ഐക്കണുകൾ എന്നിവയ്ക്ക് ഇഷ്ടപ്പെട്ടത്)"

msgid "mime_phshop"
msgstr "ഫോട്ടോഷോപ്പ് ചിത്രം (1990-ൽ Adobe പുറത്തിറക്കി, ഫോട്ടോഷോപ്പിന്റെ സോഴ്സ് ഫയൽ PSD, ചിത്ര പ്രോസസ്സിംഗ് വ്യവസായത്തിന്റെ മാനകം)"

msgid "mime_ttf"
msgstr "TrueType ഫോണ്ട് (1989-ൽ Apple-ഉം Microsoft-ഉം സംയുക്തമായി വികസിപ്പിച്ചെടുത്തു, വെക്റ്റർ ഫോണ്ട് ഫോർമാറ്റ്, സ്ക്രീൻ ഡിസ്പ്ലേയും പ്രിന്റിംഗും ഒരുപോലെയാണ്, ആധുനിക ഓപ്പറേറ്റിംഗ് സിസ്റ്റങ്ങളുടെ സ്റ്റാൻഡേർഡ് ഫോണ്ട് ഫോർമാറ്റ്)"

msgid "mime_fon"
msgstr "WOFF2 വെബ് ഫോണ്ട് (2014-ൽ W3C അംഗീകരിച്ചു, Brotli കംപ്രഷൻ അൽഗോരിതം ഉപയോഗിക്കുന്നു, മുൻ WOFF ഫോർമാറ്റിനേക്കാൾ ഏകദേശം 30% ചെറുതാണ്, TTF/OTF-നേക്കാൾ 50% ൽ കൂടുതൽ, എല്ലാ ആധുനിക ബ്രൗസറുകളും പിന്തുണയ്ക്കുന്നു, ആധുനിക വെബ് ഫോണ്ടുകളുടെ ഇഷ്ടപ്പെട്ട ഫോർമാറ്റാണ്, ബ്രൗസറുകളുടെ 98% ൽ കൂടുതൽ ഉപയോഗിക്കുന്നു)"

msgid "mime_pdf"
msgstr "PDF പ്രമാണം (1993-ൽ Adobe വികസിപ്പിച്ചെടുത്തു, 2008-ൽ ISO അന്താരാഷ്ട്ര മാനകമായി. ക്രോസ്-പ്ലാറ്റ്ഫോം പ്രമാണ ഫോർമാറ്റ്, ഫോർമാറ്റിംഗ് സ്ഥിരത നിലനിർത്തുന്നു, ഇലക്ട്രോണിക് പ്രമാണങ്ങളുടെ വിതരണത്തിന്റെ ആഗോള മാനകമാണ്)"

msgid "mime_dotnet"
msgstr "ASP.NET ഡൈനാമിക് പേജ് (2002-ൽ Microsoft പുറത്തിറക്കി, വിൻഡോസ് പ്ലാറ്റ്ഫോമിന്റെ ഡൈനാമിക് വെബ് പേജ് സാങ്കേതികവിദ്യ, .NET Framework-ന്റെ ഭാഗം)"

msgid "mime_mdb"
msgstr "Access ഡാറ്റാബേസ് (Microsoft Access database file, 1992-ൽ പുറത്തിറങ്ങി, വിൻഡോസ് ഡെസ്ക്ടോപ്പ് ഡാറ്റാബേസ് പരിഹാരം)"

msgid "mime_md"
msgstr "Markdown പ്രമാണം (2004-ൽ John Gruber സൃഷ്ടിച്ചു, GitHub README, സാങ്കേതിക പ്രമാണീകരണം, ഫോറം പോസ്റ്റുകളുടെ സാർവത്രിക ഫോർമാറ്റ്)"

msgid "mime_crystal"
msgstr "Crystal Reports റിപ്പോർട്ട് ഫോർമാറ്റ് (SAP ബിസിനസ് ഇന്റലിജൻസ് റിപ്പോർട്ടുകൾ, കോർപ്പറേറ്റ് റിപ്പോർട്ടുകളുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_libreoffice"
msgstr "LibreOffice പ്രമാണം (2010-ൽ The Document Foundation വികസിപ്പിച്ചെടുത്തു, OpenOffice ഫോർക്ക്, ODF മാനകത്തിന്റെ നടപ്പാക്കൽ, പ്രധാന ഓപ്പൺ സോഴ്സ് ഓഫീസ് സ്യൂട്ട്)"

msgid "mime_encrypt"
msgstr "എൻക്രിപ്റ്റ് ചെയ്ത ഫയൽ (കാണുന്നതിന് ഡീക്രിപ്റ്റ് ചെയ്യേണ്ടതുണ്ട്, സാധാരണ വിപുലീകരണങ്ങൾ: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS ട്രാക്ക് ഡാറ്റാ (GPS കൈമാറ്റ ഫോർമാറ്റ്, ഭൂമിശാസ്ത്രപരമായ സ്ഥാന വിവരങ്ങൾ സംഭരിക്കുന്നു, സ്പോർട്സ് വാച്ചുകൾ, നാവിഗേഷൻ ഉപകരണങ്ങളുടെ സാർവത്രിക ഫോർമാറ്റ്)"

msgid "mime_diskimage"
msgstr "ഡിസ്ക് ഇമേജ് (DMG, ISO, IMG, മറ്റ് ഡിസ്ക് ഇമേജ് ഫയലുകൾ, സോഫ്റ്റ്വെയർ വിതരണം ചെയ്യുന്നതിനോ മീഡിയ ബാക്കപ്പിനോ ഉപയോഗിക്കുന്നു)"

msgid "mime_vm"
msgstr "വെർച്ച്വൽ മെഷീൻ ഇമേജ് (VMDK, VDI, VHDX, OVA, മറ്റ് വെർച്ച്വൽ മെഷീൻ ഡിസ്ക് ഫയലുകൾ, VMware, VirtualBox, Hyper-V വെർച്ച്വലൈസേഷൻ പ്ലാറ്റ്ഫോമുകളുടെ ഫോർമാറ്റുകൾ)"

msgid "mime_torrent"
msgstr "BitTorrent ടോറന്റ് ഫയൽ (2001-ൽ Bram Cohen കണ്ടുപിടിച്ചു, P2P ഡൗൺലോഡ് സൂചിക ഫയൽ, ഫയൽ മെറ്റാഡാറ്റയും ട്രാക്കർ വിവരങ്ങളും ഉൾക്കൊള്ളുന്നു)"

msgid "mime_gis"
msgstr "GIS ജിയോഗ്രാഫിക് ഇൻഫർമേഷൻ സിസ്റ്റത്തിന്റെ ഡാറ്റ (Shapefile, GeoJSON, മറ്റ് ജിയോസ്പേഷ്യൽ ഡാറ്റാ ഫോർമാറ്റുകൾ, മാപ്പുകൾക്കും സ്പേഷ്യൽ വിശകലനത്തിനും ഉപയോഗിക്കുന്നു)"

msgid "mime_ebook"
msgstr "ഇ-ബുക്ക് (EPUB, MOBI, AZW ഇ-ബുക്ക് ഫോർമാറ്റുകൾ. EPUB അന്താരാഷ്ട്ര മാനകമാണ്, MOBI/AZW Amazon Kindle ഫോർമാറ്റാണ്)"

msgid "mime_avif"
msgstr "AVIF ചിത്രം (2019-ൽ ഓപ്പൺ മീഡിയ അലയൻസ് പുറത്തിറക്കി, AV1 അടിസ്ഥാനമാക്കി, കംപ്രഷൻ നിരക്ക് WebP-യേക്കാൾ 50% മികച്ചതാണ്, പുതിയ തലമുറയിലെ വെബ് ചിത്രങ്ങളുടെ മാനകം)"

msgid "mime_markdown"
msgstr "Markdown പ്രമാണം (2004-ൽ John Gruber രൂപകൽപ്പന ചെയ്തു, ലഘുവായ മാർക്ക്അപ്പ് ഭാഷ, GitHub README, സാങ്കേതിക പ്രമാണീകരണം, ഫോറം പോസ്റ്റുകളുടെ സാർവത്രിക ഫോർമാറ്റ്)"

msgid "mime_yaml"
msgstr "YAML കോൺഫിഗറേഷൻ (2001-ൽ Clark Evans രൂപകൽപ്പന ചെയ്തു, മനുഷ്യന് വായിക്കാൻ കഴിയുന്ന ഡാറ്റാ സീരിയലൈസേഷൻ ഫോർമാറ്റ്, Kubernetes, Ansible, Docker Compose കോൺഫിഗറേഷൻ ഫയലുകളുടെ മാനകം)"

msgid "mime_toml"
msgstr "TOML കോൺഫിഗറേഷൻ (2013-ൽ Tom Preston-Werner രൂപകൽപ്പന ചെയ്തു, 'Tom's Obvious Minimal Language', Rust/Cargo, Python/pip, Go തുടങ്ങിയ ആധുനിക ഉപകരണങ്ങളുടെ കോൺഫിഗറേഷൻ ഫയൽ ഫോർമാറ്റ്)"

msgid "mime_vue"
msgstr "Vue കമ്പോണന്റ് ഫയൽ (2014-ൽ ഇവാൻ യു അവതരിപ്പിച്ചു, പ്രോഗ്രസീവ് JavaScript ഫ്രെയിംവർക്ക്. സിംഗിൾ-ഫയൽ കമ്പോണന്റുകൾ (SFC) വഴി HTML, CSS, JS എന്നിവ തികച്ചും സംയോജിപ്പിക്കുന്നു, വികസന കാര്യക്ഷമത വളരെയധികം വർദ്ധിപ്പിക്കുന്നു. ലോകത്തിലെ ഏറ്റവും ജനപ്രിയമായ ഫ്രണ്ടെന്റ് ഫ്രെയിംവർക്കുകളിൽ ഒന്നാണിത്. കൂടാതെ, VitePress പോലുള്ള ആധുനിക സ്റ്റാറ്റിക് സൈറ്റ് ജനറേറ്ററുകളുടെ കേന്ദ്രമായി, സംവേദനാത്മക സാങ്കേതിക ഡോക്യുമെന്റേഷനും ബ്ലോഗുകളും പ്രവർത്തിപ്പിക്കുന്നതിന് വ്യാപകമായി ഉപയോഗിക്കുന്നു.)"

msgid "mime_wasm"
msgstr "WebAssembly മൊഡ്യൂൾ (2017-ൽ W3C മാനകം, ബ്രൗസറിന്റെ ഉയർന്ന പ്രകടന രൂപ ഫോർമാറ്റ്, C/C++/Rust/R കമ്പൈൽ ചെയ്യാം, പ്രകടനം നേറ്റീവ് കോഡിനോട് അടുത്താണ്)"

msgid "mime_jsx"
msgstr "React JSX ഘടകം (2013-ൽ Facebook പുറത്തിറക്കി, JavaScript XML, React ഫ്രെയിംവർക്ക് ഘടക സിന്റാക്സ്, HTML JavaScript-ൽ എഴുതുന്നതിനുള്ള നൂതന മാതൃക)"

msgid "mime_tsx"
msgstr "TypeScript TSX ഘടകം (2012-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, TypeScript + JSX, React-ന്റെ ടൈപ്പ് സുരക്ഷിത വികസനത്തിന്റെ സ്റ്റാൻഡേർഡ് രീതി)"

msgid "mime_heif"
msgstr "HEIF ചിത്രം (2015-ൽ MPEG മാനകം, ഉയർന്ന കാര്യക്ഷമതയുള്ള ചിത്ര ഫയൽ ഫോർമാറ്റ്, ആപ്പിൾ ആവാസവ്യവസ്ഥയിൽ വ്യാപകമായി ഉപയോഗിക്കുന്നു)"

msgid "mime_heic"
msgstr "HEIC ചിത്രം (Apple-ന്റെ HEIF നടപ്പാക്കൽ, iPhone-ന്റെ ഡിഫോൾട്ട് ഫോട്ടോ ഫോർമാറ്റ്, iOS/macOS സ്വദേശി പിന്തുണ)"

msgid "mime_gltf"
msgstr "GLTF 3D മോഡൽ (GL ട്രാൻസ്ഫർ ഫോർമാറ്റ്, '3D-യുടെ JPEG', 2015-ൽ Khronos Group പുറത്തിറക്കി, വെബ് 3D-യുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_glb"
msgstr "GLB ബൈനറി 3D മോഡൽ (GLTF-ന്റെ ബൈനറി പതിപ്പ്, ഒരൊറ്റ ഫയലിൽ എല്ലാ വിഭവങ്ങളും ഉൾക്കൊള്ളുന്നു, 3D രംഗങ്ങൾ വിതരണം ചെയ്യുന്നതിന് ഉപയോഗിക്കുന്നു)"

msgid "mime_gls"
msgstr "GLOSSARY പദാവലി (പദ നിർവചന ഫയൽ, പ്രമാണീകരണ സംവിധാനങ്ങളുടെ പദ മാനേജ്മെന്റിനായി ഉപയോഗിക്കുന്നു)"

msgid "mime_cbz"
msgstr "CBZ കോമിക് പുസ്തകം (ZIP-ൽ കംപ്രസ് ചെയ്ത കോമിക് ചിത്രങ്ങൾ, കോമിക് ശേഖരണത്തിന്റെ സാർവത്രിക ഫോർമാറ്റ്)"

msgid "mime_cbr"
msgstr "CBR കോമിക് പുസ്തകം (RAR-ൽ കംപ്രസ് ചെയ്ത കോമിക് ചിത്രങ്ങൾ, കോമിക് ശേഖരണത്തിന്റെ സാർവത്രിക ഫോർമാറ്റ്)"

msgid "mime_fb2"
msgstr "FB2 ഇ-ബുക്ക് (FictionBook 2.0, റഷ്യൻ ഇ-ബുക്ക് ഫോർമാറ്റ്, XML ഘടന, ഓപ്പൺ സോഴ്സ് റീഡറുകളിൽ വ്യാപകമായി പിന്തുണയ്ക്കുന്നു)"

msgid "mime_kepub"
msgstr "KEPUB ഇ-ബുക്ക് (Kobo-യുടെ പ്രത്യേക EPUB ഫോർമാറ്റ്, Kobo ഇ-ബുക്ക് റീഡറിന്റെ ഒപ്റ്റിമൈസ് ചെയ്ത ഫോർമാറ്റ്)"

msgid "mime_m4b"
msgstr "M4B ഓഡിയോ പുസ്തകം (MPEG-4 ഓഡിയോ പുസ്തക ഫോർമാറ്റ്, ബുക്ക്മാർക്കുകളെ പിന്തുണയ്ക്കുന്നു, iTunes ഓഡിയോ പുസ്തക ഫോർമാറ്റ്)"

msgid "mime_kfx"
msgstr "Kindle KFX ഫോർമാറ്റ് (2015-ൽ Amazon പുറത്തിറക്കി, Kindle-ന്റെ പ്രത്യേക ഇ-ബുക്ക് ഫോർമാറ്റ്, മെച്ചപ്പെട്ട ലേഔട്ടും വേഗത്തിലുള്ള പേജ് മറിച്ചിലും പിന്തുണയ്ക്കുന്നു)"

msgid "mime_chm"
msgstr "CHM സഹായ ഫയൽ (1997-ൽ Microsoft പുറത്തിറക്കി, കംപൈൽ ചെയ്ത HTML സഹായ ഫോർമാറ്റ്, വിൻഡോസ് സോഫ്റ്റ്വെയർ സഹായ പ്രമാണീകരണത്തിന്റെ മാനകം)"

msgid "mime_mht"
msgstr "MHT വെബ് ആർക്കൈവ് (1999-ൽ Microsoft പുറത്തിറക്കി, ഒറ്റ ഫയൽ വെബ് പേജ് ഫോർമാറ്റ്, IE ബ്രൗസർ പേജുകൾ സംരക്ഷിക്കുന്നതിന് ഉപയോഗിക്കുന്ന ഫോർമാറ്റ്)"

msgid "mime_wml"
msgstr "WML വയർലെസ് മാർക്ക്അപ്പ് ലാംഗ്വേജ് (1999-ൽ WAP മാനകം, ആദ്യകാല ഫീച്ചർ ഫോണുകളുടെ വെബ് പേജുകൾക്കായി ഉപയോഗിച്ചിരുന്നു, ഇപ്പോൾ പഴയതായി മാറി)"

msgid "mime_xhtml"
msgstr "XHTML വെബ് പേജ് (2000-ൽ W3C മാനകം, HTML-ന്റെ XML പതിപ്പ്, കൂടുതൽ കർശനമായ സിന്റാക്സോടെ. 2009-ൽ W3C പിന്തുണ നിർത്തി, ശ്രദ്ധ HTML5-ലേക്ക് മാറ്റി)"

msgid "mime_xml"
msgstr "XML പ്രമാണം (1998-ൽ W3C മാനകം, എക്സ്റ്റെൻസിബിൾ മാർക്ക്അപ്പ് ലാംഗ്വേജ്, വെബ് സേവനങ്ങൾ, കോൺഫിഗറേഷൻ ഫയലുകൾ, ഡാറ്റാ കൈമാറ്റത്തിന്റെ അടിസ്ഥാന ഫോർമാറ്റ്)"

msgid "mime_sgml"
msgstr "SGML പ്രമാണം (1986-ൽ ISO മാനകം, HTML-ന്റെ പൂർവ്വികൻ, സ്റ്റാൻഡേർഡ് ജനറലൈസ്ഡ് മാർക്ക്അപ്പ് ലാംഗ്വേജ്, XML, HTML എന്നിവ SGML-ൽ നിന്ന് ഉരുത്തിരിഞ്ഞവയാണ്)"

msgid "mime_apng"
msgstr "APNG അനിമേഷൻ (2004-ൽ Mozilla വികസിപ്പിച്ചെടുത്തു, PNG-യുടെ അനിമേറ്റഡ് വിപുലീകരണം, GIF-ന്റെ ആധുനിക പകരംവയ്പ്പ്, യഥാർത്ഥ നിറങ്ങളെയും അർദ്ധസുതാര്യതയെയും പിന്തുണയ്ക്കുന്നു)"

msgid "mime_bmp"
msgstr "BMP ബിറ്റ്മാപ്പ് (വിൻഡോസ് ബിറ്റ്മാപ്പ് ഫോർമാറ്റ്, Windows 1.0 മുതൽ സ്വദേശി പിന്തുണ. കംപ്രസ് ചെയ്തിട്ടില്ല, ഫയൽ താരതമ്യേന വലുതാണ്, എന്നാൽ ലളിതമായ ഘടനയും അധിക കോഡെക്കുകളുടെ ആവശ്യമില്ലാത്തതും കാരണം, Windows 11 സ്ക്രീൻഷോട്ട് ടൂൾ, പെയിന്റ് പ്രോഗ്രാം, EXE/MSI ഇൻസ്റ്റലേഷൻ പാക്കേജ് ഐക്കൺ റിസോഴ്സുകൾ, കഴ്സർ ഫയലുകൾ, ചില പഴയ ഡ്രൈവറുകൾ ഇപ്പോഴും ഉപയോഗിക്കുന്നു. അതേ ഗുണമേന്മയുള്ള ചിത്രത്തിന് ഫയൽ PNG-യേക്കാൾ ഏകദേശം 3-10 മടങ്ങ് വലുതാണ്, മിക്ക സാഹചര്യങ്ങളിലും PNG/JPEG കൊണ്ട് മാറ്റിസ്ഥാപിച്ചിട്ടുണ്ട്, എന്നാൽ Windows പരിസ്ഥിതി വ്യവസ്ഥയിൽ ഇപ്പോഴും വിശാലമായ അനുയോജ്യത നിലനിർത്തുന്നു)"

msgid "mime_cdr"
msgstr "CDR വെക്റ്റർ ഗ്രാഫിക്സ് (CorelDRAW-ന്റെ സ്പെഷ്യൽ ഫോർമാറ്റ്, കനേഡിയൻ Corel കമ്പനി, വെക്റ്റർ ഗ്രാഫിക്സ് ഡിസൈൻ സോഫ്റ്റ്വെയർ)"

msgid "mime_gif"
msgstr "GIF ചിത്രം (1987-ൽ CompuServe വികസിപ്പിച്ചെടുത്തു, 256 നിറങ്ങളുള്ള ചലിക്കുന്ന ചിത്ര ഫോർമാറ്റ്. ന്യൂനതകൾ: കുറഞ്ഞ നിറങ്ങൾ, കുറഞ്ഞ ഗുണമേന്മ, അർദ്ധസുതാര്യത ഇല്ല, വലിയ ഫയൽ, കുറഞ്ഞ ഫ്രെയിം നിരക്ക്. APNG, WebP, തുടങ്ങിയ ആധുനിക ചലിക്കുന്ന ചിത്ര ഫോർമാറ്റുകളാൽ മാറ്റിസ്ഥാപിക്കപ്പെട്ടു)"

msgid "mime_ico"
msgstr "ICO ഐക്കൺ (വിൻഡോസ് ഐക്കൺ ഫയൽ ഫോർമാറ്റ്, ബഹുറെസലൂഷനുകളെ പിന്തുണയ്ക്കുന്നു, വെബ്സൈറ്റ് ഫാവിക്കോണിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_jpeg"
msgstr "JPEG ചിത്രം (1992-ൽ ISO മാനകം, നഷ്ടമുള്ള കംപ്രഷൻ ഫോട്ടോ ഫോർമാറ്റ്, ഇന്റർനെറ്റ് ഫോട്ടോകളുടെ യഥാർത്ഥ മാനകം)"

msgid "mime_jpg"
msgstr "JPEG ചിത്രം (1992-ൽ ISO മാനകം, നഷ്ടമുള്ള കംപ്രഷൻ ഫോട്ടോ ഫോർമാറ്റ്, ഇന്റർനെറ്റ് ഫോട്ടോകളുടെ യഥാർത്ഥ മാനകം)"

msgid "mime_png"
msgstr "PNG ചിത്രം (1996-ൽ W3C ശുപാർശ, യഥാർത്ഥ നിറങ്ങളെയും അർദ്ധസുതാര്യതയെയും പിന്തുണയ്ക്കുന്നു, GIF-ന്റെ സ്റ്റാറ്റിക് പകരംവയ്പ്പ്, ഇന്റർനെറ്റിന്റെ നഷ്ടമില്ലാത്ത ചിത്ര മാനകം)"

msgid "mime_ps"
msgstr "PostScript പേജ് വിവരണ ഫയൽ (1985-ൽ Adobe പുറത്തിറക്കി, പേജ് വിവരണ ഭാഷ, PDF-ന്റെ പൂർവ്വികൻ, പ്രിന്റിംഗിനും പ്രസിദ്ധീകരണത്തിനും ഉപയോഗിക്കുന്നു)"

msgid "mime_psb"
msgstr "PSB വലിയ പ്രമാണം (Adobe Photoshop-ന്റെ വളരെ വലിയ ചിത്ര ഫോർമാറ്റ്, 2GB അല്ലെങ്കിൽ 30000 പിക്സലുകളിൽ കൂടുതലുള്ള വലിയ ചിത്രങ്ങളെ പിന്തുണയ്ക്കുന്നു)"

msgid "mime_psd"
msgstr "PSD ചിത്രം (Adobe Photoshop-ന്റെ സോഴ്സ് ഫയൽ, ലെയറുകൾ, ചാനലുകൾ, പാതകൾ എന്നിവയെ പിന്തുണയ്ക്കുന്നു, ചിത്ര സംസ്കരണ വ്യവസായത്തിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_webp"
msgstr "WebP ചിത്രം (2010-ൽ Google വികസിപ്പിച്ചെടുത്തു, വെബ് ചിത്ര ഫോർമാറ്റ്, നഷ്ടമുള്ള/നഷ്ടമില്ലാത്ത കംപ്രഷനും അനിമേഷനും പിന്തുണയ്ക്കുന്നു, കംപ്രഷൻ നിരക്ക് PNG-യേക്കാൾ 25-35% മികച്ചതാണ്, JPEG-യേക്കാൾ 25% മികച്ചതാണ്)"

msgid "mime_woff"
msgstr "WOFF വെബ് ഫോണ്ട് (2009-ൽ സൃഷ്ടിക്കപ്പെട്ടു, 2018-ൽ W3C മാനകം. TrueType/OpenType-നെ അടിസ്ഥാനമാക്കി കംപ്രസ് ചെയ്തത്, വെബ് ഫോണ്ട് ലോഡിംഗ് ഒപ്റ്റിമൈസേഷൻ, ആധുനിക വെബ്സൈറ്റ് ഐക്കൺ ഫോണ്ടുകളുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_7z"
msgstr "7z കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1999-ൽ Igor Pavlov വികസിപ്പിച്ചെടുത്തു, 7-Zip പ്രോഗ്രാമിന്റെ പ്രത്യേക ഫോർമാറ്റ്. LZMA അൽഗോരിതം, ഉയർന്ന കംപ്രഷൻ നിരക്ക്, ഓപ്പൺ സോഴ്സും സൗജന്യവുമാണ്. 7z ഫോർമാറ്റ് അതേ കംപ്രഷൻ ലെവലിൽ സാധാരണയായി ZIP-നേക്കാൾ 30-50% ചെറുതാണ്, ഓപ്പൺ സോഴ്സ് കമ്മ്യൂണിറ്റിയുടെയും സോഫ്റ്റ്വെയർ വിതരണത്തിന്റെയും സാധാരണ ഫോർമാറ്റാണ്)"

msgid "mime_ace"
msgstr "ACE കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1990-കളിൽ സൃഷ്ടിക്കപ്പെട്ടു, WinACE പ്രോഗ്രാം ഫോർമാറ്റ്. RAR-മായി മത്സരിച്ചു, കംപ്രഷൻ നിരക്ക് വളരെ ഉയർന്നതായിരുന്നു. 2007-ൽ വികസനം നിർത്തി, ഇപ്പോൾ 7z/RAR കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു, അപൂർവ്വമായി ഉപയോഗിക്കുന്നു)"

msgid "mime_bz2"
msgstr "BZIP2 കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1996-ൽ Julian Seward വികസിപ്പിച്ചെടുത്തു, ബ്ലോക്ക് സോർട്ടിംഗ് കംപ്രഷൻ അൽഗോരിതം. കംപ്രഷൻ നിരക്ക് GZIP-നേക്കാൾ 15-20% മികച്ചതാണ്, എന്നാൽ വേഗത മന്ദഗതിയിലാണ്. Linux കേർണൽ സോഴ്സ് കോഡ്, ഓപ്പൺ സോഴ്സ് പാക്കേജുകളുടെ സാധാരണ ഫോർമാറ്റ്, വിപുലീകരണം .bz2)"

msgid "mime_cab"
msgstr "CAB കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1995-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, കാബിനറ്റ് ഫോർമാറ്റ്. വിൻഡോസ് സിസ്റ്റം ഇൻസ്റ്റലേഷൻ പാക്കേജ് ഫോർമാറ്റ്, ഡ്രൈവറുകൾ, സിസ്റ്റം ഫയലുകൾ വിതരണം ചെയ്യുന്നതിന് ഉപയോഗിക്കുന്നു. Windows Installer (MSI) ആന്തരികമായി CAB ഉപയോഗിച്ച് ഫയലുകൾ സംഭരിക്കുന്നു)"

msgid "mime_dmg"
msgstr "DMG ഡിസ്ക് ഇമേജ് (1980-കളിൽ Apple പുറത്തിറക്കി, ഡിസ്ക് ഇമേജ് ഫോർമാറ്റ്. macOS സോഫ്റ്റ്വെയർ വിതരണത്തിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, ഡബിൾ ക്ലിക്ക് ചെയ്യുന്നത് വെർച്ച്വൽ ഡിസ്കായി മൗണ്ട് ചെയ്യും, അപ്ലിക്കേഷൻ ഇൻസ്റ്റാൾ ചെയ്യുന്നതിന് വലിച്ചിട്ട് വിട്ടാൽ മതി. കംപ്രഷനും എൻക്രിപ്ഷനും പിന്തുണയ്ക്കുന്നു, മാക് സോഫ്റ്റ്വെയർ ഡൗൺലോഡുകളുടെ പ്രധാന ഫോർമാറ്റാണ്)"

msgid "mime_emz"
msgstr "EMZ കംപ്രസ് ചെയ്ത ചിത്രം (വിൻഡോസ് കംപ്രസ് ചെയ്ത മെച്ചപ്പെടുത്തിയ മെറ്റാഫയൽ, EMF-ന്റെ കംപ്രസ്ഡ് പതിപ്പ്. Office പ്രമാണങ്ങളിൽ വെക്റ്റർ ഗ്രാഫിക്സ് സംഭരിക്കുന്ന ഫോർമാറ്റ്, അടിസ്ഥാനപരമായി GZIP കംപ്രസ് ചെയ്ത EMF ഫയലാണ്)"

msgid "mime_gz"
msgstr "GZIP കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1992-ൽ Jean-loup Gailly-ഉം Mark Adler-ഉം വികസിപ്പിച്ചെടുത്തു, GNU പ്രോജക്റ്റ്. Unix/Linux-ന്റെ സ്റ്റാൻഡേർഡ് കംപ്രഷൻ ഉപകരണം, HTTP ട്രാൻസ്മിഷൻ കംപ്രഷന്റെ സാധാരണ ഫോർമാറ്റ്. വിപുലീകരണം .gz, സാധാരണയായി TAR-മായി ചേർത്ത് ഉപയോഗിക്കുന്നു)"

msgid "mime_jar"
msgstr "JAR കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1997-ൽ Sun Microsystems പുറത്തിറക്കി, Java ARchive ഫോർമാറ്റ്. അടിസ്ഥാനപരമായി ZIP കംപ്രസ് ചെയ്ത ആർക്കൈവ്, ജാവ ക്ലാസ് ലൈബ്രറികളും അപ്ലിക്കേഷനുകളും പാക്കേജ് ചെയ്യുന്നതിന് ഉപയോഗിക്കുന്നു. Maven, Gradle തുടങ്ങിയ ജാവ ആവാസവ്യവസ്ഥയുടെ അടിസ്ഥാന ഫോർമാറ്റ്, Android-ഉം JAR ഉപയോഗിക്കുന്നു)"

msgid "mime_lzma"
msgstr "LZMA കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1998-ൽ Igor Pavlov വികസിപ്പിച്ചെടുത്തു, Lempel-Ziv-Markov chain അൽഗോരിതം. 7z ഫോർമാറ്റിന്റെ അടിസ്ഥാന കംപ്രഷൻ അൽഗോരിതം, ഉയർന്ന കംപ്രഷൻ നിരക്ക്, ഡീകംപ്രഷൻ വേഗത വേഗമാണ്. ഫേംവെയർ, എംബഡഡ് സിസ്റ്റങ്ങളുടെ സോഫ്റ്റ്വെയർ വിതരണം എന്നിവയ്ക്കായി ഉപയോഗിക്കുന്നു)"

msgid "mime_rar"
msgstr "RAR കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1993-ൽ Eugene Roshal വികസിപ്പിച്ചെടുത്തു, Roshal ARchive ഫോർമാറ്റ്. ഉയർന്ന കംപ്രഷൻ നിരക്ക്, ബഹുഭാഗ കംപ്രഷൻ, പുനഃസ്ഥാപന രേഖകൾ എന്നിവയെ പിന്തുണയ്ക്കുന്നു. WinRAR പ്രോഗ്രാം ഫോർമാറ്റ്, കംപ്രഷൻ നിരക്ക് ZIP-നേക്കാൾ മികച്ചതാണ്, എന്നാൽ പണമടച്ചുള്ള സോഫ്റ്റ്വെയർ ആവശ്യമാണ്, unrar പോലുള്ള ഓപ്പൺ സോഴ്സ് ഉപകരണങ്ങൾ ഇത് ഡീകംപ്രസ് ചെയ്യാൻ കഴിയും)"

msgid "mime_tar"
msgstr "TAR ആർക്കൈവ് (1979-ൽ Unix V7-ൽ അവതരിപ്പിച്ചു, ടേപ്പ് ആർക്കൈവ് ഫോർമാറ്റ്. ടേപ്പ് ആർക്കൈവ് ഫോർമാറ്റ്, കംപ്രസ് ചെയ്യുന്നില്ല, പായ്ക്ക് മാത്രം ചെയ്യുന്നു, സാധാരണയായി GZIP/BZIP2/XZ-മായി ചേർത്ത് ഉപയോഗിക്കുന്നു. Linux സോഫ്റ്റ്വെയർ പാക്കേജുകളുടെ സോഴ്സ് കോഡ്, ഡോക്കർ കണ്ടെയ്നർ ലെയറുകളുടെ സംഭരണം എന്നിവ TAR ഫോർമാറ്റ് ഉപയോഗിക്കുന്നു)"

msgid "mime_tgz"
msgstr "TGZ കംപ്രസ് ചെയ്ത ആർക്കൈവ് (TAR + GZIP കോമ്പിനേഷൻ ഫോർമാറ്റ്, വിപുലീകരണം .tgz അല്ലെങ്കിൽ .tar.gz. Unix/Linux സോഫ്റ്റ്വെയർ പാക്കേജുകളുടെ ഏറ്റവും സാധാരണമായ വിതരണ ഫോർമാറ്റ്, സോഴ്സ് കോഡ് പാക്കേജുകൾ, ബൈനറി പാക്കേജുകൾ എന്നിവ വ്യാപകമായി ഉപയോഗിക്കുന്നു, 'അൺപാക്ക് ചെയ്ത് ഉപയോഗിക്കുക' പ്രതിനിധി)"

msgid "mime_tbz2"
msgstr "TBZ2 കംപ്രസ് ചെയ്ത ആർക്കൈവ് (TAR + BZIP2 കോമ്പിനേഷൻ ഫോർമാറ്റ്, വിപുലീകരണം .tbz2 അല്ലെങ്കിൽ .tar.bz2. കംപ്രഷൻ നിരക്ക് TGZ-നേക്കാൾ 15-20% മികച്ചതാണ്, വലിയ ഫയലുകൾക്ക് അനുയോജ്യമാണ്, Linux കേർണൽ സോഴ്സ് കോഡ് വളരെക്കാലം ഈ ഫോർമാറ്റ് ഉപയോഗിച്ചിരുന്നു)"

msgid "mime_xz"
msgstr "XZ കംപ്രസ് ചെയ്ത ആർക്കൈവ് (2009-ൽ പുറത്തിറങ്ങി, LZMA2 അൽഗോരിതത്തെ അടിസ്ഥാനമാക്കി. കംപ്രഷൻ നിരക്ക് വളരെ ഉയർന്നതാണ്, GZIP-നേക്കാൾ 30-50% മികച്ചതാണ്, ഡീകംപ്രഷൻ വേഗത താരതമ്യേന വേഗമാണ്. Linux കേർണൽ, പാക്കേജ് മാനേജർമാർ (ഉദാ. Debian-ന്റെ .deb ഉള്ളിൽ) വ്യാപകമായി ഉപയോഗിക്കുന്നു, നിലവിൽ Linux ആവാസവ്യവസ്ഥയുടെ ശുപാർശിത ഫോർമാറ്റാണ്)"

msgid "mime_z"
msgstr "Z കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1985-ൽ Unix കംപ്രസ് കമാൻഡിന്റെ ഫോർമാറ്റ്, LZW അൽഗോരിതം. ആദ്യകാല Unix കംപ്രഷൻ ഫോർമാറ്റ്, ഇതിനകം GZIP കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു. വിപുലീകരണം .Z, ആധുനിക സിസ്റ്റങ്ങളിൽ വിരളമായി ഉപയോഗിക്കുന്നു)"

msgid "mime_zip"
msgstr "ZIP കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1989-ൽ Phil Katz വികസിപ്പിച്ചെടുത്തു, PKZIP ഫോർമാറ്റ്. വിൻഡോസ് സ്വദേശി പിന്തുണ, ഇന്റർനെറ്റിലെ ഏറ്റവും സാധാരണമായ കംപ്രഷൻ ഫോർമാറ്റ്. ഒന്നിലധികം ഫയലുകളെയും ഡയറക്ടറി ഘടനയെയും പിന്തുണയ്ക്കുന്നു, കംപ്രഷൻ അൽഗോരിതം തിരഞ്ഞെടുക്കാനുള്ള കഴിവുണ്ട്. ജാവയുടെ JAR, Android-ന്റെ APK, ഓഫീസ് പ്രമാണങ്ങളുടെ DOCX/XLSX എല്ലാം ZIP ഫോർമാറ്റിനെ അടിസ്ഥാനമാക്കിയുള്ളവയാണ്)"

msgid "mime_zst"
msgstr "Zstandard കംപ്രസ് ചെയ്ത ആർക്കൈവ് (2015-ൽ Facebook വികസിപ്പിച്ചെടുത്തു, Yann Collet രൂപകൽപ്പന. ഉയർന്ന വേഗതയുള്ള കംപ്രഷൻ അൽഗോരിതം, കംപ്രഷൻ നിരക്ക് LZMA-യോട് അടുത്താണ്, വേഗതയിൽ GZIP-നെ വളരെയധികം മറികടക്കുന്നു. Linux കേർണൽ 5.9+ പിന്തുണയ്ക്കുന്നു, Arch Linux pacman, Debian APT ക്രമേണ സ്വീകരിക്കുന്നു, പുതിയ തലമുറയിലെ കംപ്രഷൻ മാനകമാണ്)"

msgid "mime_lz4"
msgstr "LZ4 കംപ്രസ് ചെയ്ത ആർക്കൈവ് (2011-ൽ Yann Collet വികസിപ്പിച്ചെടുത്തു, എക്സ്ട്രാ വേഗതയുള്ള കംപ്രഷൻ അൽഗോരിതം. കംപ്രഷൻ വേഗത GZIP-നേക്കാൾ 10 മടങ്ങ് വേഗമാണ്, തത്സമയ കംപ്രഷന് അനുയോജ്യമാണ്. Linux കേർണൽ, OpenZFS, Hadoop എന്നിവ വ്യാപകമായി ഉപയോഗിക്കുന്നു, വേഗതയ്ക്ക് മുൻഗണന നൽകുന്ന സന്ദർഭങ്ങളിൽ ഇഷ്ടപ്പെട്ട ഫോർമാറ്റാണ്)"

msgid "mime_lzo"
msgstr "LZO കംപ്രസ് ചെയ്ത ആർക്കൈവ് (1996-ൽ Markus Oberhumer വികസിപ്പിച്ചെടുത്തു, Lempel-Ziv-Oberhumer അൽഗോരിതം. ഡീകംപ്രഷൻ വേഗത വളരെ വേഗമാണ്, കംപ്രഷൻ നിരക്ക് ഇടത്തരമാണ്. Linux കേർണലിന്റെ Squashfs, OpenWrt ഫേംവെയർ എന്നിവ ഉപയോഗിക്കുന്നു, എംബഡഡ് സിസ്റ്റങ്ങൾക്ക് അനുയോജ്യമാണ്)"

msgid "mime_msi"
msgstr "MSI ഇൻസ്റ്റലേഷൻ പാക്കേജ് (1999-ൽ Microsoft പുറത്തിറക്കി, വിൻഡോസ് ഇൻസ്റ്റാളർ പാക്കേജ് ഫോർമാറ്റ്. വിൻഡോസ് അപ്ലിക്കേഷനുകളുടെ സ്റ്റാൻഡേർഡ് ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്, ട്രാൻസാക്ഷൻ റോൾബാക്ക്, കമ്പോണന്റ് മാനേജ്മെന്റ്, നിശ്ശബ്ദ ഇൻസ്റ്റലേഷൻ എന്നിവയെ പിന്തുണയ്ക്കുന്നു. കോർപ്പറേറ്റ് തലത്തിലെ സോഫ്റ്റ്വെയർ വിതരണത്തിനുള്ള ഇഷ്ടപ്പെട്ട ഫോർമാറ്റ്, ഇന്നും വിൻഡോസ് സോഫ്റ്റ്വെയർ ഇൻസ്റ്റലേഷന്റെ പ്രധാന ഫോർമാറ്റാണ്)"

msgid "mime_pkg"
msgstr "PKG ഇൻസ്റ്റലേഷൻ പാക്കേജ് (macOS അപ്ലിക്കേഷൻ ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്, Apple-ന്റെ ഇൻസ്റ്റാളർ സാങ്കേതികവിദ്യയെ അടിസ്ഥാനമാക്കി. macOS സോഫ്റ്റ്വെയർ വിതരണത്തിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, കമ്പോണന്റ് തിരഞ്ഞെടുക്കൽ, ഇൻസ്റ്റലേഷൻ സ്ക്രിപ്റ്റുകൾ, അൺഇൻസ്റ്റലേഷൻ ഫംഗ്ഷൻ എന്നിവയെ പിന്തുണയ്ക്കുന്നു. .pkg ഫയൽ ഡബിൾ ക്ലിക്ക് ചെയ്യുന്നത് ഇൻസ്റ്റാൾ ചെയ്യും, Mac App Store-ന് പുറത്തുള്ള സോഫ്റ്റ്വെയർ വിതരണത്തിന്റെ സാധാരണ മാർഗ്ഗമാണ്)"

msgid "mime_apk"
msgstr "APK Android അപ്ലിക്കേഷൻ പാക്കേജ് (2008-ൽ Google പുറത്തിറക്കി, Android സിസ്റ്റത്തിന്റെ പരമ്പരാഗത അപ്ലിക്കേഷൻ ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്. APK അടിസ്ഥാനപരമായി ZIP കംപ്രസ് ചെയ്ത ആർക്കൈവാണ്, കോഡ്, വിഭവങ്ങൾ, മാനിഫെസ്റ്റ് ഫയൽ എന്നിവ ഉൾക്കൊള്ളുന്നു. 2021 മുതൽ Google Play പുതിയ അപ്ലിക്കേഷനുകൾ AAB ഫോർമാറ്റിലേക്ക് മാറണമെന്ന് നിർബന്ധിക്കുന്നു, എന്നാൽ APK ഡെവലപ്മെന്റും ഡീബഗ്ഗിംഗും മൂന്നാം കക്ഷി സ്റ്�ോറുകൾക്കും സൈഡ്ലോഡിംഗിനും ഇപ്പോഴും ഉപയോഗിക്കുന്നു)"

msgid "mime_ipa"
msgstr "IPA ആപ്പിൾ അപ്ലിക്കേഷൻ പാക്കേജ് (iOS App Store Package, iOS/iPadOS അപ്ലിക്കേഷൻ ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്. 2008-ൽ iPhone SDK-യ്ക്കൊപ്പം പുറത്തിറങ്ങി. App Store വഴി വിതരണം ചെയ്യുകയോ കോർപ്പറേറ്റ് സർട്ടിഫിക്കറ്റ് ഉപയോഗിച്ച് സൈൻ ചെയ്യുകയോ വേണം. എക്സിക്യൂട്ടബിൾ ഫയൽ, വിഭവങ്ങൾ, Info.plist, സൈനിംഗ് വിവരങ്ങൾ എന്നിവ ഉൾക്കൊള്ളുന്നു)"

msgid "mime_hap"
msgstr "HAP ഹാർമണി OS അപ്ലിക്കേഷൻ പാക്കേജ് (HarmonyOS കഴിവ് പാക്കേജ്, ഹാർമണി OS അപ്ലിക്കേഷന്റെ അടിസ്ഥാന യൂണിറ്റ്. 2020-ൽ ഹാർമണി OS 2.0-നൊപ്പം പുറത്തിറങ്ങി. എൻട്രി, ഫീച്ചർ എന്നീ രണ്ട് തരങ്ങളെ പിന്തുണയ്ക്കുന്നു, ഹുവാവേ ഫോണുകൾ, ടാബ്ലെറ്റുകൾ, സ്മാർട്ട് വാച്ചുകൾ എന്നിവയുൾപ്പെടെയുള്ള ഹാർമണി OS ഉപകരണങ്ങളുടെ വിതരണ ഫോർമാറ്റ്)"

msgid "mime_har"
msgstr "HAR ഹാർമണി OS സ്റ്റാറ്റിക് ഷെയർഡ് പാക്കേജ് (HarmonyOS ആർക്കൈവ്, ഹാർമണി OS സ്റ്റാറ്റിക് ഷെയർഡ് ലൈബ്രറി, ഒന്നിലധികം HAP-കൾക്കിടയിൽ പങ്കിടാൻ കഴിയും, കമ്പോണന്റ് അധിഷ്ഠിത വികസനത്തിനും മൊഡ്യൂൾ പുനരുപയോഗത്തിനും ഉപയോഗിക്കുന്നു)"

msgid "mime_aab"
msgstr "Android App Bundle (2018-ൽ Google പുറത്തിറക്കി, 2021 മുതൽ Google Play പുതിയ അപ്ലിക്കേഷനുകൾ ഈ ഫോർമാറ്റ് ഉപയോഗിക്കണമെന്ന് നിർബന്ധിക്കുന്നു. AAB വിതരണ ഫോർമാറ്റാണ്, Google Play ഉപകരണ കോൺഫിഗറേഷനെ അടിസ്ഥാനമാക്കി (CPU ആർക്കിടെക്ചർ, സ്ക്രീൻ ഡെൻസിറ്റി, ഭാഷ) ഡൈനാമിക് ആയി ഒപ്റ്റിമൈസ് ചെയ്ത APK സൃഷ്ടിക്കുന്നു, ഇൻസ്റ്റലേഷൻ പാക്കേജ് വലിപ്പം ശരാശരി 35% കുറയുന്നു. ഡെവലപ്പർ AAB അപ്ലോഡ് ചെയ്യുന്നു, ഉപയോക്താവ് APK ഡൗൺലോഡ് ചെയ്യുന്നു)"

msgid "mime_xapk"
msgstr "XAPK അപ്ലിക്കേഷൻ പാക്കേജ് (മൂന്നാം കക്ഷി Android അപ്ലിക്കേഷൻ വിപുലീകൃത പാക്കേജ്, APK + OBB ഡാറ്റ ഫയലുകൾ ഉൾക്കൊള്ളുന്നു. വലിയ ഗെയിമുകൾക്കും സങ്കീർണ്ണമായ അപ്ലിക്കേഷനുകൾക്കും ഉപയോഗിക്കുന്നു, APK-യുടെ 100MB പരിധി പ്രശ്നം പരിഹരിക്കുന്നു. APKPure, APKMirror മൂന്നാം കക്ഷി അപ്ലിക്കേഷൻ സ്റ്റോറുകളിൽ സാധാരണമാണ്, Google-ന്റെ ഔദ്യോഗിക ഫോർമാറ്റല്ല)"

msgid "mime_appx"
msgstr "വിൻഡോസ് അപ്ലിക്കേഷൻ പാക്കേജ് (2012-ൽ Microsoft പുറത്തിറക്കി, Windows 8/10/11 അപ്ലിക്കേഷൻ ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്. UWP, ഡെസ്ക്ടോപ്പ് അപ്ലിക്കേഷൻ പരിവർത്തനം എന്നിവയെ പിന്തുണയ്ക്കുന്നു, Microsoft Store വഴി വിതരണം ചെയ്യുന്നു. 2024-ൽ Microsoft MSIX-നെ പിൻഗാമി ഫോർമാറ്റായി പുറത്തിറക്കി, ക്രമേണ APPX-നെ മാറ്റിസ്ഥാപിക്കുന്നു)"

msgid "mime_msix"
msgstr "MSIX അപ്ലിക്കേഷൻ പാക്കേജ് (2018-ൽ Microsoft പുറത്തിറക്കി, വിൻഡോസിന്റെ പുതിയ തലമുറ അപ്ലിക്കേഷൻ പാക്കേജിംഗ് ഫോർമാറ്റ്. APPX, MSI എന്നിവയുടെ ഗുണങ്ങൾ സംയോജിപ്പിക്കുന്നു, എല്ലാ വിൻഡോസ് അപ്ലിക്കേഷൻ തരങ്ങളെയും പിന്തുണയ്ക്കുന്നു, Microsoft Store വഴിയോ സൈഡ്ലോഡിംഗ് വഴിയോ ഇൻസ്റ്റാൾ ചെയ്യാൻ കഴിയും, Windows 11-ന്റെ ശുപാർശിത ഫോർമാറ്റാണ്)"

msgid "mime_appimage"
msgstr "AppImage അപ്ലിക്കേഷൻ പാക്കേജ് (2004-ൽ പുറത്തിറങ്ങി, Linux-ന്റെ ഇൻസ്റ്റാൾ ചെയ്യാത്ത അപ്ലിക്കേഷൻ ഫോർമാറ്റ്. 'ഒരു അപ്ലിക്കേഷൻ ഒരു ഫയൽ', ഇൻസ്റ്റാൾ ചെയ്യാതെ തന്നെ നേരിട്ട് പ്രവർത്തിപ്പിക്കാം, മിക്ക Linux വിതരണങ്ങളെയും പിന്തുണയ്ക്കുന്നു, ഡെവലപ്പർമാർ Linux സോഫ്റ്റ്വെയർ വിതരണം ചെയ്യുന്നതിനുള്ള സാധാരണ മാർഗ്ഗമാണ്)"

msgid "mime_flatpak"
msgstr "Flatpak അപ്ലിക്കേഷൻ പാക്കേജ് (2015-ൽ പുറത്തിറങ്ങി, Linux-ന്റെ സാൻഡ്ബോക്സ് ചെയ്ത അപ്ലിക്കേഷൻ ഫോർമാറ്റ്. വിതരണങ്ങൾക്കിടയിൽ പ്രവർത്തിക്കുന്നു, ഹോസ്റ്റ് സിസ്റ്റത്തിൽ നിന്ന് വേർതിരിച്ചിരിക്കുന്നു, Fedora, Red Hat എന്നിവ വികസനത്തിൽ മുന്നിട്ടുനിൽക്കുന്നു, GNOME സോഫ്റ്റ്വെയർ സെന്ററിന്റെ ഡിഫോൾട്ട് ഫോർമാറ്റ്)"

msgid "mime_snap"
msgstr "Snap അപ്ലിക്കേഷൻ പാക്കേജ് (2014-ൽ Canonical പുറത്തിറക്കി, ഉബുണ്ടു മാതൃ കമ്പനി, Linux-ന്റെ സാർവത്രിക അപ്ലിക്കേഷൻ ഫോർമാറ്റ്. ഓട്ടോമാറ്റിക് അപ്ഡേറ്റ്, സാൻഡ്ബോക്സ് വേർതിരിവ്, 40-ലധികം Linux വിതരണങ്ങളെ പിന്തുണയ്ക്കുന്നു, ഉബുണ്ടു സോഫ്റ്റ്വെയർ സെന്ററിന്റെ ഡിഫോൾട്ട് ഫോർമാറ്റ്)"

msgid "mime_deb"
msgstr "ഡെബിയൻ സോഫ്റ്റ്വെയർ പാക്കേജ് (1993-ൽ ഡെബിയൻ പ്രോജക്റ്റ് പുറത്തിറക്കി, Debian/Ubuntu, അവയുടെ വകഭേദങ്ങളുടെ സ്റ്റാൻഡേർഡ് ഇൻസ്റ്റലേഷൻ ഫോർമാറ്റ്. dpkg ഉപയോഗിച്ച് മാനേജ് ചെയ്യുന്നു, APT അതിന്റെ പാക്കേജ് മാനേജറിന്റെ ഫ്രണ്ട്-എൻഡ് ആണ്, Linux ആവാസവ്യവസ്ഥയിലെ ഏറ്റവും പഴക്കമേറിയ പാക്കേജ് ഫോർമാറ്റുകളിൽ ഒന്നാണ്, ഇന്നും Debian കുടുംബത്തിന്റെ പ്രധാന ഫോർമാറ്റാണ്)"

msgid "mime_rpm"
msgstr "RPM സോഫ്റ്റ്വെയർ പാക്കേജ് (1997-ൽ Red Hat പുറത്തിറക്കി, Red Hat/Fedora/CentOS/SUSE, മറ്റ് വിതരണങ്ങളുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്. RPM പൂർണ്ണമായും 'Red Hat Package Manager' ആണ്, DEB-നൊപ്പം Linux-ന്റെ രണ്ട് പ്രധാന പാക്കേജ് ഫോർമാറ്റുകളിൽ ഒന്നാണ്, ഇന്നും RHEL കുടുംബത്തിന്റെ പ്രധാന ഫോർമാറ്റാണ്)"

msgid "mime_pacman"
msgstr "ആർക്ക് സോഫ്റ്റ്വെയർ പാക്കേജ് (2002-ൽ Arch Linux പുറത്തിറക്കി, pacman പാക്കേജ് മാനേജർ ഉപയോഗിക്കുന്ന .pkg.tar.zst ഫോർമാറ്റ്. Arch Linux-ന്റെ റോളിംഗ് റിലീസിന്റെ കേർണൽ, ലാളിത്യത്തിനും KISS തത്വത്തിനും പേരുകേട്ടതാണ്, AUR (Arch User Repository) ഇതിന്റെ പ്രത്യേക സവിശേഷതയാണ്)"

msgid "mime_exe"
msgstr "EXE എക്സിക്യൂട്ടബിൾ ഫയൽ (വിൻഡോസ് എക്സിക്യൂട്ടബിൾ പ്രോഗ്രാം ഫോർമാറ്റ്, 'എക്സിക്യൂട്ടബിൾ' എന്നതിന്റെ ചുരുക്കരൂപം. വിൻഡോസ് ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ സ്വദേശി എക്സിക്യൂഷൻ ഫോർമാറ്റ്, PE ഘടന ഉൾക്കൊള്ളുന്നു. MS-DOS-ന്റെ MZ ഫോർമാറ്റിൽ നിന്ന് ഉരുത്തിരിഞ്ഞതാണ്, 1993-ൽ Windows NT PE (Portable Executable) ഫോർമാറ്റ് അവതരിപ്പിച്ചു, ഇത് ഇന്നും ഉപയോഗിക്കുന്നു. സോഫ്റ്റ്വെയർ ഇൻസ്റ്റലേഷൻ പാക്കേജുകൾ, അപ്ലിക്കേഷനുകൾ, സിസ്റ്റം ഉപകരണങ്ങൾ എന്നിവ ഈ ഫോർമാറ്റ് ഉപയോഗിക്കുന്നു. ഉപയോക്താവിന് ഡബിൾ ക്ലിക്ക് ചെയ്യുന്നത് പ്രവർത്തിപ്പിക്കാൻ കഴിയും, ലോകത്തിലെ ഏറ്റവും വ്യാപകമായി ഉപയോഗിക്കുന്ന എക്സിക്യൂഷൻ ഫോർമാറ്റാണിത്)"

msgid "mime_dll"
msgstr "DLL ഡൈനാമിക് ലിങ്ക് ലൈബ്രറി (1993-ൽ Microsoft പുറത്തിറക്കി, ഡൈനാമിക് ലിങ്ക് ലൈബ്രറി. വിൻഡോസിന്റെ പങ്കിട്ട കോഡ് ലൈബ്രറി, പ്രോഗ്രാം പ്രവർത്തിപ്പിക്കുമ്പോൾ ഡൈനാമിക് ആയി ലോഡ് ചെയ്യുന്നു, മെമ്മറിയും ഡിസ്ക് സ്ഥലവും ലാഭിക്കുന്നു. സിസ്റ്റം കമ്പോണന്റുകൾ, അപ്ലിക്കേഷൻ പ്ലഗിനുകൾ, ഡ്രൈവറുകൾ എല്ലാം DLL ഫോർമാറ്റ് ഉപയോഗിക്കുന്നു. Windows API-യുടെ അടിസ്ഥാന നടപ്പാക്കൽ മാർഗ്ഗം, DLL Hell പ്രശ്നം .NET യുഗത്തിൽ ലഘൂകരിക്കപ്പെട്ടു)"

msgid "mime_com"
msgstr "COM എക്സിക്യൂട്ടബിൾ ഫയൽ (MS-DOS യുഗത്തിന്റെ എക്സിക്യൂട്ടബിൾ ഫോർമാറ്റ്, 'കമാൻഡ്' എന്നതിന്റെ ചുരുക്കരൂപം. ഫയൽ ഘടന ലളിതമാണ്, 64KB പരിധിയോടെ, Windows 3.x വരെ സാധാരണമായിരുന്നു. ഇപ്പോൾ പഴയതായി മാറി, ആധുനിക Windows EXE ഫോർമാറ്റ് ഉപയോഗിക്കുന്നു, COM വിപുലീകരണം ചില കമ്പോണന്റ് ഫയലുകൾക്കായി ഇപ്പോഴും ഉപയോഗിക്കുന്നു)"

msgid "mime_aac"
msgstr "AAC ഓഡിയോ (1997-ൽ MPEG മാനകം, അഡ്വാൻസ്ഡ് ഓഡിയോ കോഡിംഗ്. MP3-യുടെ പിൻഗാമി, ഒരേ ബിറ്റ്രേറ്റിൽ ഗുണമേന്മയിൽ MP3-യെക്കാൾ മികച്ചതാണ്, YouTube, iTunes, നിന്റെൻഡോ സ്വിച്ചിന്റെ ഡിഫോൾട്ട് ഓഡിയോ ഫോർമാറ്റ്)"

msgid "mime_alac"
msgstr "ALAC ഓഡിയോ (2004-ൽ Apple വികസിപ്പിച്ചെടുത്തു, ആപ്പിൾ ലോസ്ലെസ് ഓഡിയോ കോഡെക്. Apple-ന്റെ നഷ്ടരഹിത ഫോർമാറ്റ്, 2011-ൽ ഓപ്പൺ സോഴ്സ് ആയി, iTunes, Apple Music എന്നിവയുടെ നഷ്ടരഹിത ഓഡിയോയുടെ ഡിഫോൾട്ട് ഫോർമാറ്റ്)"

msgid "mime_flac"
msgstr "FLAC ഓഡിയോ (2001-ൽ Xiph.Org ഫൗണ്ടേഷൻ വികസിപ്പിച്ചെടുത്തു, ഫ്രീ ലോസ്ലെസ് ഓഡിയോ കോഡെക്. നഷ്ടരഹിത കംപ്രഷൻ, ഗുണമേന്മ CD-യ്ക്ക് തുല്യമാണ്, ഫയൽ ഏകദേശം WAV-ന്റെ പകുതിയാണ്. ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമാണ്, ഓഡിയോഫൈലുകളും ഡിജിറ്റൽ സംഗീത ശേഖരണക്കാരും ഇഷ്ടപ്പെടുന്ന ഫോർമാറ്റാണ്)"

msgid "mime_mp3"
msgstr "MP3 ഓഡിയോ (1993-ൽ Fraunhofer ഇൻസ്റ്റിറ്റ്യൂട്ട് വികസിപ്പിച്ചെടുത്തു, MPEG-1 ഓഡിയോ ലെയർ 3. നഷ്ടമുള്ള കംപ്രഷൻ ഫോർമാറ്റ്, ഫയൽ ചെറുതും ഗുണമേന്മ സ്വീകാര്യവുമാണ്, 2000-കളിലെ ഡിജിറ്റൽ സംഗീത വിപ്ലവത്തിന്റെ അടിസ്ഥാന ഫോർമാറ്റ്, ഐപോഡിന്റെയും നാപ്സ്റ്ററിന്റെയും നേട്ടം. 2017-ൽ പേറ്റന്റ് കാലഹരണപ്പെട്ടു, പൊതു ഡൊമെയ്ൻ ഫോർമാറ്റായി മാറി)"

msgid "mime_oga"
msgstr "Ogg Audio ഓഡിയോ (Xiph.Org ഫൗണ്ടേഷൻ വികസിപ്പിച്ചെടുത്തു, Ogg കണ്ടെയ്നറിന്റെ ശുദ്ധ ഓഡിയോ ഫോർമാറ്റ്, Vorbis എൻകോഡിംഗ് ഉപയോഗിക്കുന്നു. ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമാണ്, കംപ്രഷൻ ദക്ഷത MP3-നെക്കാൾ മികച്ചതാണ്, ഓപ്പൺ സോഴ്സ് പ്രോജക്റ്റുകളിൽ വ്യാപകമായി ഉപയോഗിക്കുന്നു)"

msgid "mime_ogg"
msgstr "OGG ഓഡിയോ (2000-ൽ Xiph.Org ഫൗണ്ടേഷൻ വികസിപ്പിച്ചെടുത്തു, Ogg Vorbis ഫോർമാറ്റ്. ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമാണ്, കംപ്രഷൻ ദക്ഷത MP3-നെക്കാൾ മികച്ചതാണ്, Spotify ആദ്യകാലത്ത് ഉപയോഗിച്ചു, ഗെയിമുകളുടെ ശബ്ദ ഇഫക്റ്റുകളിൽ വ്യാപകമായി ഉപയോഗിക്കുന്നു)"

msgid "mime_opus"
msgstr "Opus ഓഡിയോ (2012-ൽ IETF മാനകീകരിച്ചു, ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമായ ഓഡിയോ ഫോർമാറ്റ്. SILK, CELT സാങ്കേതികവിദ്യകൾ സംയോജിപ്പിക്കുന്നു, വളരെ കുറഞ്ഞ ലേറ്റൻസി, ഏറ്റവും ഉയർന്ന കംപ്രഷൻ ദക്ഷത, WebRTC, WhatsApp, ഡിസ്കോർഡിന്റെ ഡിഫോൾട്ട് ഓഡിയോ ഫോർമാറ്റ്)"

msgid "mime_wav"
msgstr "WAV ഓഡിയോ (1991-ൽ Microsoft-ഉം IBM-ഉം വികസിപ്പിച്ചെടുത്തു, വിൻഡോസിന്റെ സ്വദേശി ഓഡിയോ ഫോർമാറ്റ്. കംപ്രസ് ചെയ്യാത്ത PCM എൻകോഡിംഗ്, ഗുണമേന്മ നഷ്ടരഹിതമാണെങ്കിലും ഫയൽ വളരെ വലുതാണ്, പ്രൊഫഷണൽ ഓഡിയോ എഡിറ്റിംഗിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്)"

msgid "mime_wma"
msgstr "WMA ഓഡിയോ (1999-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, വിൻഡോസ് മീഡിയ ഓഡിയോ. നഷ്ട/നഷ്ടരഹിത രണ്ട് പതിപ്പുകൾ, വിൻഡോസിന്റെ സ്വദേശി പിന്തുണ, വിൻഡോസ് മീഡിയ പ്ലെയറിനൊപ്പം വ്യാപിച്ചു. ഇപ്പോൾ അവഗണിക്കപ്പെട്ടു, MP3/AAC കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു)"

msgid "mime_dsf"
msgstr "DSF ഓഡിയോ (ഡയറക്ട് സ്ട്രീം ഡിജിറ്റൽ ഫോർമാറ്റ്, സോണിയും ഫിലിപ്സും വികസിപ്പിച്ചെടുത്തു. 1bit ഉയർന്ന സാമ്പിൾ നിരക്ക്, DSD ഓഡിയോയുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, SACD-യുടെ ഡിജിറ്റൽ പതിപ്പ്, ഓഡിയോഫൈലുകളുടെ ഉയർന്ന നിലവാരമുള്ള ഫോർമാറ്റ്, ഫയൽ ഭീമാകാരമാണ്)"

msgid "mime_ape"
msgstr "APE ഓഡിയോ (2000-ൽ Monkey's Audio വികസിപ്പിച്ചെടുത്തു, നഷ്ടരഹിത കംപ്രഷൻ ഫോർമാറ്റ്. FLAC-നേക്കാൾ ഉയർന്ന കംപ്രഷൻ എന്നാൽ മന്ദഗതിയിലുള്ള എൻകോഡിംഗ്, ഇപ്പോഴും Windows പ്ലാറ്റ്ഫോമിലും ഓഡിയോ പ്രേമികൾക്കിടയിലും ഉപയോഗിക്കുന്നു)"

msgid "mime_mid"
msgstr "MIDI ഓഡിയോ (1983-ൽ MIDI അസോസിയേഷൻ നിർണ്ണയിച്ചു, മ്യൂസിക്കൽ ഇൻസ്ട്രുമെന്റ് ഡിജിറ്റൽ ഇന്റർഫേസ്. നോട്ട് ഫോർമാറ്റ്, ഓഡിയോ റെക്കോർഡിംഗ് അല്ല, ഫയൽ വളരെ ചെറുതാണ്, ഇലക്ട്രോണിക് ഉപകരണങ്ങൾ, മൊബൈൽ ഫോൺ റിംഗ്ടോണുകൾ, ഗെയിം ശബ്ദ ഇഫക്റ്റുകളുടെ മാനകം. 1991-ൽ ജനറൽ MIDI മാനകീകരിക്കപ്പെട്ടു, 128 ഉപകരണങ്ങളുടെ തടി നിർവചിച്ചു)"

msgid "mime_m4a"
msgstr "M4A ഓഡിയോ (MPEG-4 ഓഡിയോ, AAC-യുടെ കണ്ടെയ്നർ ഫോർമാറ്റ്. iTunes മ്യൂസിക് സ്റ്�ോറിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, Apple ആവാസവ്യവസ്ഥയുടെ പ്രധാന ഓഡിയോ ഫോർമാറ്റ്, DRM സംരക്ഷണത്തെ പിന്തുണയ്ക്കുന്നു)"

msgid "mime_m3u"
msgstr "M3U പ്ലേലിസ്റ്റ് (MP3 URL പ്ലേലിസ്റ്റ് ഫോർമാറ്റ്, ലളിതമായ ടെക്സ്റ്റ് ഫയൽ, ഓഡിയോ ഫയൽ പാതകൾ രേഖപ്പെടുത്തുന്നു. വിനാംപ് യുഗത്തിന്റെ മാനകം, ഇന്റർനെറ്റ് റേഡിയോ, ഓൺലൈൻ സംഗീത സ്ട്രീമിംഗിനായി ഉപയോഗിക്കുന്നു. M3U8 അതിന്റെ UTF-8 പതിപ്പാണ്, HTTP ലൈവ് സ്ട്രീമിംഗിനായി ഉപയോഗിക്കുന്നു)"

msgid "mime_asf"
msgstr "ASF സ്ട്രീമിംഗ് ഫോർമാറ്റ് (1996-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, അഡ്വാൻസ്ഡ് സിസ്റ്റംസ് ഫോർമാറ്റ്. വിൻഡോസ് മീഡിയയുടെ സ്ട്രീമിംഗ് കണ്ടെയ്നർ, ഓഡിയോയും വീഡിയോയും സിൻക്രണസ് ആയി കൈമാറുന്നതിനെ പിന്തുണയ്ക്കുന്നു. ഇന്റർനെറ്റ് ട്രാൻസ്മിഷനുകൾക്കും സ്ട്രീമിംഗിനും ഉപയോഗിക്കുന്നു, WMA/WMV എന്നിവ ASF കണ്ടെയ്നറിനെ അടിസ്ഥാനമാക്കിയുള്ളവയാണ്)"

msgid "mime_avi"
msgstr "AVI വീഡിയോ (1992-ൽ Microsoft പുറത്തിറക്കി, വിൻഡോസിന്റെ ആദ്യകാല വീഡിയോ മാനകം. 'ഓഡിയോ വീഡിയോ ഇന്റർലീവ്', ഓഡിയോയും വീഡിയോയും മാറിമാറി സംഭരിക്കുന്നു, 1990-2000-കളിൽ ഏറ്റവും ജനപ്രിയമായ വീഡിയോ ഫോർമാറ്റ്, ഇപ്പോൾ MP4/MKV കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു)"

msgid "mime_divx"
msgstr "DivX വീഡിയോ (1998-ൽ DivX കമ്പനി വികസിപ്പിച്ചെടുത്തു, MPEG-4 അടിസ്ഥാനമാക്കിയുള്ള വീഡിയോ എൻകോഡിംഗ് ഫോർമാറ്റ്. 2000-കളിൽ ഇന്റർനെറ്റ് വീഡിയോ പങ്കിടലിന്റെ പ്രധാന ഫോർമാറ്റ്, DVD ഗുണമേന്മ CD വലിപ്പത്തിൽ എൻകോഡ് ചെയ്ത ആദ്യ സാങ്കേതികവിദ്യ. പകർപ്പവകാശ തർക്കങ്ങൾ കാരണം, പിന്നീട് വാണിജ്യ എൻകോഡിംഗിലേക്ക് മാറി)"

msgid "mime_mp4"
msgstr "MP4 വീഡിയോ (2001-ൽ MPEG മാനകം, MPEG-4 ഭാഗം 14. ലോകത്തിലെ ഏറ്റവും സാധാരണമായ വീഡിയോ ഫോർമാറ്റ്, H.264/H.265 എൻകോഡിംഗിനെ പിന്തുണയ്ക്കുന്നു, ഇന്റർനെറ്റ് വീഡിയോകൾ, മൊബൈൽ ഫോൺ റെക്കോർഡിംഗുകൾ, YouTube-ന്റെ ഡിഫോൾട്ട് ഫോർമാറ്റ്)"

msgid "mime_m4v"
msgstr "M4V വീഡിയോ (iTunes വീഡിയോ ഫോർമാറ്റ്, MP4-ന്റെ വകഭേദം. Apple ആവാസവ്യവസ്ഥയുടെ വീഡിയോ ഫോർമാറ്റ്, iTunes Store സിനിമകൾ, ടെലിവിഷൻ പരിപാടികളുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, DRM പകർപ്പവകാശ സംരക്ഷണത്തെ പിന്തുണയ്ക്കുന്നു)"

msgid "mime_mpeg"
msgstr "MPEG വീഡിയോ (1988-ൽ MPEG സംഘടന നിർണ്ണയിച്ചു, മൂവിംഗ് പിക്ചർ എക്സ്പേർട്ട്സ് ഗ്രൂപ്പ്. ഡിജിറ്റൽ വീഡിയോ കംപ്രഷൻ മാനകത്തിന്റെ സ്ഥാപകൻ, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (ഇന്റർനെറ്റ് വീഡിയോ) എന്നിവ പ്രധാന സ്വാധീനം ചെലുത്തി)"

msgid "mime_mkv"
msgstr "MKV വീഡിയോ (2002-ൽ Matroska പ്രോജക്റ്റ് വികസിപ്പിച്ചെടുത്തു, ഓപ്പൺ സോഴ്സ് മൾട്ടിമീഡിയ കണ്ടെയ്നർ ഫോർമാറ്റ്. ഒന്നിലധികം ഓഡിയോ ട്രാക്കുകൾ, ഒന്നിലധികം സബ്ടൈറ്റിലുകൾ, അധ്യായങ്ങൾ എന്നിവയെ പിന്തുണയ്ക്കുന്നു, 'പാക്കേജിംഗിന്റെ മാന്ത്രികൻ', ഉയർന്ന റെസലൂഷൻ സിനിമകൾ പങ്കിടുന്നതിനുള്ള ഇഷ്ടപ്പെട്ട ഫോർമാറ്റ്)"

msgid "mime_mpg"
msgstr "MPEG വീഡിയോ (MPEG-1/MPEG-2 വീഡിയോ വിപുലീകരണം, VCD, DVD എന്നിവയുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്. 1990-2000-കളിൽ ഒപ്റ്റിക്കൽ ഡിസ്ക് വീഡിയോയുടെ പ്രധാന ഫോർമാറ്റ്, ഇപ്പോൾ H.264/H.265 കൊണ്ട് മാറ്റിസ്ഥാപിച്ചു)"

msgid "mime_ogv"
msgstr "Ogg Video വീഡിയോ (Xiph.Org ഫൗണ്ടേഷൻ വികസിപ്പിച്ചെടുത്തു, Ogg കണ്ടെയ്നറിന്റെ വീഡിയോ ഫോർമാറ്റ്, Theora എൻകോഡിംഗ് ഉപയോഗിക്കുന്നു. ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമാണ്, HTML5 വീഡിയോയുടെ ആദ്യകാല മാനകം, Firefox-ന്റെ സ്വദേശി പിന്തുണ)"

msgid "mime_ogx"
msgstr "Ogg മൾട്ടിമീഡിയ കണ്ടെയ്നർ (Xiph.Org ഫൗണ്ടേഷൻ വികസിപ്പിച്ചെടുത്തു, Ogg കണ്ടെയ്നറിന്റെ സാർവത്രിക വിപുലീകരണം, ഓഡിയോ, വീഡിയോ, സബ്ടൈറ്റിലുകളുടെ ഒന്നിലധികം ട്രാക്കുകൾ ഉൾക്കൊള്ളാൻ കഴിയും. ഓപ്പൺ സോഴ്സ് മൾട്ടിമീഡിയ മാനകം, ഗെയിമുകൾ, സ്ട്രീമിംഗ് എന്നിവയിൽ ഉപയോഗിക്കുന്നു)"

msgid "mime_rm"
msgstr "RealMedia വീഡിയോ (1995-ൽ RealNetworks വികസിപ്പിച്ചെടുത്തു, RealMedia ഫോർമാറ്റ്. 1990-2000-കളിൽ ഇന്റർനെറ്റ് സ്ട്രീമിംഗിന്റെ പയനിയർ, RealPlayer-ന്റെ പ്രധാന ഫോർമാറ്റ്. ന്യൂനതകൾ: പ്രത്യേക പ്ലെയർ ആവശ്യമായിരുന്നു, കംപ്രഷൻ ഗുണമേന്മ കുറവായിരുന്നു, പിന്നീട് Flash/MP4 കൊണ്ട് മാറ്റിസ്ഥാപിക്കപ്പെട്ടു)"

msgid "mime_flv"
msgstr "Flash വീഡിയോ (2002-ൽ ഫോർമാറ്റ് പ്രത്യക്ഷപ്പെട്ടു, ഫ്ലാഷ് വീഡിയോ ഫോർമാറ്റ്. ഒരുകാലത്ത് ഇന്റർനെറ്റ് വീഡിയോയുടെ പ്രധാന ഫോർമാറ്റ്, YouTube ആദ്യകാലത്ത് ഉപയോഗിച്ചു. ന്യൂനതകൾ: ഫ്ലാഷ് പ്ലഗിൻ ആവശ്യമായിരുന്നു, പ്രകടനം മോശമായിരുന്നു, സുരക്ഷാ വിടവുകൾ ഉണ്ടായിരുന്നു. 2015 മുതൽ പ്രധാന വെബ്സൈറ്റുകൾ HTML5 വീഡിയോയിലേക്ക് മാറി, ഇപ്പോൾ പഴയതായി മാറി)"

msgid "mime_f4v"
msgstr "F4V വീഡിയോ (Adobe വികസിപ്പിച്ചെടുത്ത ഫ്ലാഷ് വീഡിയോ ഫോർമാറ്റ്, FLV-യുടെ പിൻഗാമി. MPEG-4 മാനകത്തെ അടിസ്ഥാനമാക്കിയുള്ളതാണ്, H.264 എൻകോഡിംഗിനെ പിന്തുണയ്ക്കുന്നു. ഫ്ലാഷ് സാങ്കേതികവിദ്യയ്ക്കൊപ്പം പഴയതായി മാറി, Adobe 2020-ൽ പിന്തുണ നിർത്തി)"

msgid "mime_wmv"
msgstr "WMV വീഡിയോ (1999-ൽ Microsoft വികസിപ്പിച്ചെടുത്തു, വിൻഡോസ് മീഡിയ വീഡിയോ. വിൻഡോസിന്റെ സ്വദേശി പിന്തുണ, സ്ട്രീമിംഗിനായി ഒപ്റ്റിമൈസ് ചെയ്തിരിക്കുന്നു, ആദ്യകാല ഓൺലൈൻ വീഡിയോകളിൽ സാധാരണ ഫോർമാറ്റായിരുന്നു, ഇപ്പോൾ അവഗണിക്കപ്പെട്ടു)"

msgid "mime_wmf"
msgstr "WMF മീഡിയ ഫോർമാറ്റ് (വിൻഡോസ് മീഡിയ ഫോർമാറ്റ്, Microsoft-ന്റെ മീഡിയ ഫ്രെയിംവർക്ക്. WMV വീഡിയോ, WMA ഓഡിയോ എന്നിവ ഉൾക്കൊള്ളുന്നു, വിൻഡോസ് മീഡിയ പ്ലെയറിന്റെ സ്വദേശി പിന്തുണ)"

msgid "mime_mov"
msgstr "MOV വീഡിയോ (1991-ൽ Apple വികസിപ്പിച്ചെടുത്തു, ക്വിക്ടൈം കണ്ടെയ്നർ ഫോർമാറ്റ്. പ്രൊഫഷണൽ വീഡിയോ എഡിറ്റിംഗിന്റെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, ഒന്നിലധികം കോഡെക്കുകളെ പിന്തുണയ്ക്കുന്നു, ഫൈനൽ കട്ട് പ്രോ, പ്രീമിയർ എന്നിവയുടെ സ്വദേശി പിന്തുണ)"

msgid "mime_qt"
msgstr "ക്വിക്ടൈം വീഡിയോ (1991-ൽ Apple പുറത്തിറക്കി, ക്വിക്ടൈം ഫോർമാറ്റ്. മാക് പ്ലാറ്റ്ഫോമിന്റെ വീഡിയോ മാനകം, MOV അതിന്റെ കണ്ടെയ്നറാണ്, ക്വിക്ടൈം പ്ലെയർ വ്യാപകമായി ഉപയോഗിച്ചിരുന്നു. 2016-ൽ Apple വിൻഡോസ് പതിപ്പിന്റെ വികസനം നിർത്തി, ക്രമേണ MP4 കൊണ്ട് മാറ്റിസ്ഥാപിക്കപ്പെട്ടു)"

msgid "mime_webm"
msgstr "WebM വീഡിയോ (2010-ൽ Google പുറത്തിറക്കി, ഓപ്പൺ സോഴ്സും പേറ്റന്റ് രഹിതവുമായ വീഡിയോ ഫോർമാറ്റ്. Matroska കണ്ടെയ്നറിനെ അടിസ്ഥാനമാക്കിയുള്ളതാണ്, VP8/VP9 എൻകോഡിംഗ്, HTML5 വീഡിയോയുടെ സ്റ്റാൻഡേർഡ് ഫോർമാറ്റ്, YouTube-ന്റെ ഡിഫോൾട്ട് വെബ് പ്ലെയറിന്റെ ഫോർമാറ്റ്)"

msgid "mime_3gp"
msgstr "3GP വീഡിയോ (2000-ൽ 3GPP നിർണ്ണയിച്ചു, മൊബൈൽ ഉപകരണങ്ങളുടെ വീഡിയോ ഫോർമാറ്റ്. ഫയൽ വളരെ ചെറുതാണ്, ഗുണമേന്മ കുറവാണ്, ആദ്യകാല ഫീച്ചർ ഫോണുകളുടെ വീഡിയോ റെക്കോർഡിംഗ് ഫോർമാറ്റ്, MMS സന്ദേശങ്ങൾ അയയ്ക്കുന്നതിന് ഉപയോഗിച്ചിരുന്നു)"

