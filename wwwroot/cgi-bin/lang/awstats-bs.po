#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstualna datoteka (ASCII standardizacija 1963. godine, neformatiran običan tekst. Osnova za sav izvorni kod, konfiguraciju, dnevnike. Unix koristi LF, Windows CRLF za prijelom redova, i dalje najuniverzalniji format podataka na računarima)"

msgid "mime_log"
msgstr "Dnevnička datoteka (tekstualna datoteka koja bilježi informacije o radu sistema i aplikacija, često se koristi za otklanjanje grešaka, analizu performansi i sigurnosne revizije. Standardni formati uključuju Apache combined log, Nginx access log, syslog, itd.)"

msgid "mime_page"
msgstr "HTML web stranica (Tim Berners-Lee je izumio World Wide Web 1989. godine, definirao tri glavne tehnologije HTML/HTTP/URL 1990. godine, besplatno ih ustupivši bez patentiranja. HTML5 je postao službeni W3C standard 2014. godine, podržava prikaz, multimediju i štampanje. Dobitnik Turingove nagrade 2016. godine)"

msgid "mime_khtml"
msgstr "KHTML web engine (KDE 2.0 objavljen 1998. godine, engine za prikaz u Konqueror pretraživaču. Apple je 2001. godine kreirao WebKit zasnovan na KHTML-u, a Google je 2008. godine od WebKita napravio Blink, koji postaje jezgro pretraživača poput Chrome, Edge, Safari. KHTML je primjer kako je open source zajednica postavila temelje modernim pretraživačkim engine-ima, a njegovo tehnološko naslijeđe se nastavlja kroz WebKit/Blink do danas)"

msgid "mime_script"
msgstr "Dinamički skriptni jezik (interpretirani jezik, nije potrebno kompajliranje. Uključuje ASP, JSP, CGI, ColdFusion, Tcl, VBScript, itd., široko korišten u ranom web razvoju, administraciji sistema, automatizaciji zadataka. Moderni skriptni jezici poput Python, Ruby, JavaScript razvili su se u glavne alate za cjelokupni razvoj)"

msgid "mime_js"
msgstr "JavaScript skripta (Brendan Eich ga je stvorio za 10 dana u Netscapeu 1995. godine, izvorni programski jezik pretraživača. ECMAScript je standardiziran 1997. godine, Node.js je rođen 2009. godine čineći ga višeplatformskim jezikom, npm je najveći menadžer paketa na svijetu. Već godinama najpopularniji programski jezik na GitHubu)"

msgid "mime_py"
msgstr "Python skripta (Guido van Rossum ga je kreirao 1991. godine, poznat po obaveznom uvlačenju i jednostavnoj sintaksi. Široko se koristi u web razvoju, nauci o podacima, vještačkoj inteligenciji, automatizaciji administracije. Višestruki dobitnik TIOBE nagrade za programski jezik godine)"

msgid "mime_sh"
msgstr "Shell skripta (Unix je rođen 1971. godine, jezik komandne linije. Koristi se za administraciju sistema, automatizaciju zadataka, pokretanje usluga, skripte za postavljanje. Neophodna vještina za Linux administraciju)"

msgid "mime_rb"
msgstr "Ruby skripta (Yukihiro Matsumoto ga je kreirao 1995. godine, fokusiran na zadovoljstvo developera. Ruby on Rails okvir je pionir paradigme konvencije nad konfiguracijom, utječući na dizajn modernih web okvira)"

msgid "mime_pl"
msgstr "Perl skripta (Larry Wall ga je kreirao 1987. godine, poznat po pragmatičnosti, često nazivan 'švicarski nož'. CPAN je preteča modernih menadžera paketa programskih jezika, sa dubokim utjecajem u oblasti obrade teksta, administracije sistema i CGI-ja)"

msgid "mime_php"
msgstr "PHP dinamička web stranica (Rasmus Lerdorf ga je kreirao 1995. godine, posebno dizajniran za web razvoj. Više od 70% web stranica na svijetu ga koristi, pokreće platforme poput WordPress, Facebook, Wikipedia. PHP 8 uvodi JIT kompajliranje, značajno poboljšavajući performanse)"

msgid "mime_image"
msgstr "Datoteka slike"

msgid "mime_document"
msgstr "Datoteka dokumenta"

msgid "mime_package"
msgstr "Softverski paket"

msgid "mime_archive"
msgstr "Gzip komprimirana datoteka (GNU projekat 1992. godine, zasnovan na DEFLATE algoritmu. Koristi se u Web-u za dinamičku kompresiju odgovora, stopa kompresije je obično 60-90%. Nakon 2015. godine, Brotli ga je zamijenio u nekim scenarijima, ali je i dalje najšire podržan format kompresije na serverskoj strani)"

msgid "mime_audio"
msgstr "Audio datoteka"

msgid "mime_video"
msgstr "Video datoteka"

msgid "mime_jscript"
msgstr "JavaScript (razvio Brendan Eich 1995. godine)"

msgid "mime_json"
msgstr "JSON podaci (predložio Douglas Crockford 2001. godine, lagani format za razmjenu podataka, činjenični standard za Web API-je)"

msgid "mime_vbs"
msgstr "VBScript (razvio Microsoft 1996. godine, skriptni jezik za Windows, korišten za ASP web stranice i Windows administratorske skripte. S porastom PowerShell i JavaScript popularnosti, postepeno se povlači)"

msgid "mime_conf"
msgstr "Konfiguracijska datoteka (pohranjuje konfiguracije softvera u tekstualnom formatu, uobičajeni formati: INI, JSON, YAML, TOML, XML. Linux sistemske konfiguracije su uglavnom u /etc direktoriju)"

msgid "mime_css"
msgstr "CSS stilski list (Prvi službeni standard CSS1 od strane W3C-a objavljen je u decembru 1996. godine, CSS2 je dodao pozicioniranje i medijske tipove 1998. godine, od 2011. godine CSS3 je modularno uveden donoseći zaobljene uglove, animacije, fleksibilne kutije, mrežni raspored i responzivni dizajn. Zajedno s HTML-om i JavaScriptom čini tri glavne osnovne tehnologije frontenda, svi moderni pretraživači (Chrome, Firefox, Safari, Edge) ga izvorno podržavaju, jedini je standard za definiranje web stilova)"

msgid "mime_xsl"
msgstr "XSL stilski list (W3C standard 1999. godine, jezik za transformaciju XML dokumenata, može pretvoriti XML u HTML/PDF/tekst. Nakon popularizacije JSON-a, upotreba je smanjena)"

msgid "mime_runtime"
msgstr "Izvršna datoteka (izvršni formati operativnog sistema poput EXE, ELF, Mach-O, sadrži mašinski kod i informacije za učitavanje)"

msgid "mime_library"
msgstr "Bibliotečna datoteka (DLL, SO, dylib, itd. dinamički povezane biblioteke, dijeljeni kod koji se učitava prilikom pokretanja programa)"

msgid "mime_swf"
msgstr "Flash animacija (razvio Macromedia 1996. godine, kasnije u vlasništvu Adobea. Standard za interaktivne web animacije, nekada dominirao internet animacijama i igrama. Nedostaci: ovisnost o dodatku, nepodržavanje na mobilnim uređajima, visok sigurnosni rizik. Adobe je 2017. godine najavio povlačenje, potpuna podrška je obustavljena 2020. godine, zamijenjen sa HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD definicija tipa dokumenta (XML specifikacija, definira strukturu XML dokumenta, koristi se za provjeru ispravnosti XML-a)"

msgid "mime_csv"
msgstr "CSV podatkovni format (vrijednosti odvojene zarezom, univerzalni format za tabelarne podatke, standard za uvoz/izvoz u Excel i baze podataka)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java aplikacijski pokretač, tehnologija distribucije Java desktop aplikacija 2000-ih, danas povučena)"

msgid "mime_lit"
msgstr "Microsoft Reader e-knjiga (Microsoft je predstavio 2000. godine, LIT format, povučen)"

msgid "mime_svg"
msgstr "SVG vektorska grafika (W3C standard 1999. godine, Microsoft je dugo promovirao vlastiti VML format, IE pretraživač ga je podržavao tek od 2011. godine, što je dovelo do kašnjenja u popularizaciji. Nakon 2015. godine, s povlačenjem IE-a i popularizacijom ekrana visoke rezolucije, postao je prvi izbor za ikone i logotipe)"

msgid "mime_ai"
msgstr "Adobe Illustrator vektorska grafika (predstavljen 1987. godine, industrijski standardni vektorski grafički format, prvi izbor za štampanje dizajna, logotipa, ikona)"

msgid "mime_phshop"
msgstr "Photoshop slika (Adobe je predstavio 1990. godine, PSD format izvorne Photoshop datoteke, industrijski standard za obradu slika)"

msgid "mime_ttf"
msgstr "TrueType font (zajednički razvoj Apple i Microsoft 1989. godine, vektorski format fonta, konzistentan prikaz na ekranu i u štampi, podrazumijevani format fonta u modernim operativnim sistemima)"

msgid "mime_fon"
msgstr "WOFF2 web font (W3C preporuka 2014. godine, koristi Brotli kompresijski algoritam, veličina je smanjena za oko 30% u odnosu na stariji WOFF, a za više od 50% u odnosu na TTF/OTF. Trenutno ga podržavaju svi moderni pretraživači, najbolji je izbor za web fontove danas, podržava ga više od 98% pretraživača)"

msgid "mime_pdf"
msgstr "PDF dokument (Adobe razvijen 1993. godine, postao ISO međunarodni standard 2008. godine. Unakrsno-platformski format dokumenta, zadržava konzistentnost formata, globalni je standard za distribuciju elektronskih dokumenata)"

msgid "mime_dotnet"
msgstr "ASP.NET dinamička stranica (Microsoft predstavio 2002. godine, tehnologija dinamičkih web stranica za Windows platformu, dio .NET Framework-a)"

msgid "mime_mdb"
msgstr "Access baza podataka (Microsoft Access datoteka baze podataka, predstavljena 1992. godine, rješenje za desktop bazu podataka na Windows-u)"

msgid "mime_md"
msgstr "Markdown dokument (Kreirao John Gruber 2004. godine, na dizajn sintakse su utjecali reStructuredText i Setext. Osnovna dizajnerska filozofija je 'čitljivost jednaka prikazu', originalna implementacija Markdown.pl koristi Perl regularne izraze. Izvedene specifikacije uključuju GFM (2013), CommonMark (2017), Pandoc Markdown, itd. Pokreće ekosisteme GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, postao je činjenični standardni format za generatore statičkih web stranica i programersku dokumentaciju)"

msgid "mime_crystal"
msgstr "Crystal Reports format izvještaja (SAP poslovni izvještaji, standardni format za izvještaje u preduzećima)"

msgid "mime_libreoffice"
msgstr "LibreOffice dokument (Razvila The Document Foundation 2010. godine, ogranak OpenOffice-a, implementacija ODF standarda, glavni open source office paket)"

msgid "mime_encrypt"
msgstr "Šifrirana datoteka (potrebno je dešifriranje za pregled, uobičajene ekstenzije: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS trag podaci (GPS Exchange Format, bilježi informacije o geografskoj lokaciji, univerzalni format za sportske satove i navigacijske uređaje)"

msgid "mime_diskimage"
msgstr "Disk slike (DMG, ISO, IMG, itd., datoteke za čitanje diskova/CD-ova, koriste se za distribuciju softvera ili backup medija za pohranu)"

msgid "mime_vm"
msgstr "Virtualna mašina slike (VMDK, VDI, VHDX, OVA, itd., datoteke virtuelnog diska, formati za platforme virtuelizacije poput VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent .torrent datoteka (Bram Cohen je izumio 2001. godine, P2P indeksna datoteka za preuzimanje, sadrži metapodatke datoteke i informacije o Trackeru)"

msgid "mime_gis"
msgstr "GIS geografski informacioni sistem podataka (formati geoprostornih podataka poput Shapefile, GeoJSON, koriste se za mape i prostornu analizu)"

msgid "mime_ebook"
msgstr "E-knjiga (formati e-knjiga poput EPUB, MOBI, AZW. EPUB je međunarodni standard, MOBI/AZW su formati za Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF slika (Alliance for Open Media ga je predstavila 2019. godine, zasnovan na AV1 kodeku, stopa kompresije je 50% veća od WebP-a, novi standard web slika)"

msgid "mime_markdown"
msgstr "Markdown dokument (John Gruber ga je dizajnirao 2004. godine, lagani jezik za označavanje, univerzalni format za GitHub README, tehničku dokumentaciju, forume)"

msgid "mime_yaml"
msgstr "YAML konfiguracija (Clark Evans ga je dizajnirao 2001. godine, čovjeku čitljiv format za serijalizaciju podataka, standardni format konfiguracijske datoteke za Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML konfiguracija (Tom Preston-Werner ga je dizajnirao 2013. godine, 'Tom's Obvious Minimal Language', format konfiguracijske datoteke za moderne alate poput Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue komponentna datoteka (Evan You, 2014. Progresivni JavaScript okvir. Putem jednodatotečnih komponenti (SFC) savršeno objedinjuje HTML, CSS i JS, značajno povećavajući efikasnost razvoja, jedan od najpopularnijih frontend okvira na svijetu. Također, kao jezgra modernih generatora statičkih stranica poput VitePress-a, široko se koristi za pokretanje interaktivne tehničke dokumentacije i blogova.)"

msgid "mime_wasm"
msgstr "WebAssembly modul (W3C standard 2017. godine, format za visoke performanse u pretraživaču, C/C++/Rust/R se mogu kompajlirati u njega, performanse bliske izvornom kodu)"

msgid "mime_jsx"
msgstr "React JSX komponenta (Facebook je predstavio JavaScript XML 2013. godine, sintaksa komponente React okvira, inovativna paradigma pisanja HTML-a unutar JavaScript-a)"

msgid "mime_tsx"
msgstr "TypeScript TSX komponenta (Microsoft ga je razvio 2012. godine, TypeScript + JSX, standardni način za razvoj React aplikacija sa sigurnošću tipova)"

msgid "mime_heif"
msgstr "HEIF slika (MPEG standard 2015. godine, efikasni format slikovne datoteke, široko se koristi u Apple ekosistemu)"

msgid "mime_heic"
msgstr "HEIC slika (Apple-ova implementacija HEIF-a, podrazumijevani format fotografije na iPhone-u, izvorno podržan na iOS/macOS-u)"

msgid "mime_gltf"
msgstr "GLTF 3D model (GL Transport Format, 'JPEG svijeta 3D-a', objavio Khronos Group 2015. godine, standardni format za web 3D)"

msgid "mime_glb"
msgstr "GLB binarni 3D model (binarna verzija GLTF-a, pojedinačna datoteka sadrži sve resurse, koristi se za distribuciju 3D scena)"

msgid "mime_gls"
msgstr "GLOSSARY pojmovnik (datoteka definicije termina, koristi se za upravljanje terminima u dokumentacionim sistemima)"

msgid "mime_cbz"
msgstr "CBZ strip knjiga (komprimirane strip slike u ZIP formatu, univerzalni format za kolekcionare stripova)"

msgid "mime_cbr"
msgstr "CBR strip knjiga (komprimirane strip slike u RAR formatu, univerzalni format za kolekcionare stripova)"

msgid "mime_fb2"
msgstr "FB2 e-knjiga (FictionBook 2.0, ruski format e-knjige, XML struktura, široko podržan od strane open source čitača)"

msgid "mime_kepub"
msgstr "KEPUB e-knjiga (Kobo specijalni EPUB format, optimizirani format za Kobo čitače e-knjiga)"

msgid "mime_m4b"
msgstr "M4B audio knjiga (MPEG-4 audio format knjige, podržava oznake, format za iTunes audio knjige)"

msgid "mime_kfx"
msgstr "Kindle KFX format (Amazon ga je predstavio 2015. godine, specijalni format e-knjige za Kindle, podržava poboljšani slog i brzo listanje stranica)"

msgid "mime_chm"
msgstr "CHM datoteka pomoći (Microsoft ga je predstavio 1997. godine, kompilirani HTML format pomoći, standard za dokumentaciju pomoći u Windows softveru)"

msgid "mime_mht"
msgstr "MHT web arhiva (Microsoft ga je predstavio 1999. godine, format web stranice u jednoj datoteci, format za čuvanje web stranica u IE pretraživaču)"

msgid "mime_wml"
msgstr "WML (Wireless Markup Language, WAP standard 1999. godine, korišten za web stranice na starim mobilnim telefonima, ukinut)"

msgid "mime_xhtml"
msgstr "XHTML web stranica (W3C standard 2000. godine, XML verzija HTML-a, strožija sintaksa. W3C je obustavio održavanje 2009. godine, fokus se preusmjerio na HTML5)"

msgid "mime_xml"
msgstr "XML dokument (W3C standard 1998. godine, proširivi jezik za označavanje, osnovni format za web servise, konfiguracijske datoteke, razmjenu podataka)"

msgid "mime_sgml"
msgstr "SGML dokument (ISO standard 1986. godine, prethodnik HTML-a, standardni generalizirani jezik za označavanje, XML i HTML potiču iz SGML-a)"

msgid "mime_apng"
msgstr "APNG animacija (Mozilla ga je razvila 2004. godine, proširenje PNG-a za animaciju, moderna zamjena za GIF, podržava prave boje i prozirnost)"

msgid "mime_bmp"
msgstr "BMP bitmap (Windows bitmap format, izvorno podržan od Windows 1.0. Nekomprimiran, velike veličine fajlova, ali zbog jednostavne strukture i bez potrebe za dodatnim kodecima, Windows 11 alat za snimanje ekrana, program za crtanje, resursi ikona u EXE/MSI instalacijskim paketima, datoteke kursora i neki stari drajveri ga i dalje koriste. Za isti kvalitet slike, datoteka je otprilike 3-10 puta veća od PNG-a, u većini scenarija je zamijenjen PNG/JPEG-om, ali Windows ekosistem i dalje zadržava široku kompatibilnost)"

msgid "mime_cdr"
msgstr "CDR vektorska grafika (specijalni format za CorelDRAW, Corel Corporation iz Kanade, softver za vektorsku grafičku dizajn)"

msgid "mime_gif"
msgstr "GIF slika (CompuServe ga je razvio 1987. godine, 256-boja format za animaciju. Nedostaci: ograničen broj boja, grub kvalitet slike, ne podržava prozirnost, velike datoteke, niska brzina kadrova. Zamijenjen je modernim animacijskim formatima poput APNG, WebP)"

msgid "mime_ico"
msgstr "ICO ikona (Windows format ikonske datoteke, podržava više rezolucija, standardni format za favicon web stranice)"

msgid "mime_jpeg"
msgstr "JPEG slika (ISO standard 1992. godine, format za fotografije s gubitkom kvaliteta, činjenični standard za fotografije na internetu)"

msgid "mime_jpg"
msgstr "JPEG slika (ISO standard 1992. godine, format za fotografije s gubitkom kvaliteta, činjenični standard za fotografije na internetu)"

msgid "mime_png"
msgstr "PNG slika (W3C preporuka 1996. godine, podržava prave boje i prozirnost, statička zamjena za GIF, standard za bezkompresijske slike na internetu)"

msgid "mime_ps"
msgstr "PostScript datoteka opisa stranice (Adobe ga je predstavio 1985. godine, jezik za opis stranice, prethodnik PDF-a, koristi se za štampanje i izdavaštvo)"

msgid "mime_psb"
msgstr "PSB veliki dokument (Adobe Photoshop format za izuzetno velike slike, podržava slike veće od 2GB ili 30000 piksela)"

msgid "mime_psd"
msgstr "PSD slika (Adobe Photoshop izvorna datoteka, podržava slojeve, kanale, putanje, industrijski standardni format za obradu slika)"

msgid "mime_webp"
msgstr "WebP slika (Google ga je razvio 2010. godine, format web slike, podržava kompresiju s gubitkom/bez gubitka i animaciju, stopa kompresije 25-35% veća od PNG-a i 25% veća od JPEG-a)"

msgid "mime_woff"
msgstr "WOFF web font (kreiran 2009. godine, W3C standard 2018. godine. Zasnovan na TrueType/OpenType kompresiji, optimizacija učitavanja web fontova, standardni format za ikone fontova na modernim web stranicama)"

msgid "mime_7z"
msgstr "7z komprimirani paket (Igor Pavlov ga je razvio 1999. godine, specijalni format 7-Zip programa. LZMA algoritam, visoka stopa kompresije, open source i besplatan. 7z format je obično 30-50% manji od ZIP-a pri istoj stopi kompresije, uobičajen je format u open source zajednici i za distribuciju softvera)"

msgid "mime_ace"
msgstr "ACE komprimirani paket (razvijen 1990-ih, format WinACE programa. Nekada se takmičio s RAR-om, imao je relativno visoku stopu kompresije. Razvoj je obustavljen 2007. godine, danas ga je zamijenio 7z/RAR, rijetko se koristi)"

msgid "mime_bz2"
msgstr "BZIP2 komprimirani paket (Julian Seward ga je razvio 1996. godine, algoritam kompresije sortiranjem blokova. Stopa kompresije je 15-20% veća od GZIP-a, ali je brzina manja. Uobičajen format za izvorni kod Linux kernela, open source softverske pakete, ekstenzija .bz2)"

msgid "mime_cab"
msgstr "CAB komprimirani paket (Microsoft ga je razvio 1995. godine, Cabinet format. Format instalacijskog paketa za Windows, koristi se za distribuciju drajvera i sistemskih datoteka. Windows Installer (MSI) interno koristi CAB za pohranu datoteka)"

msgid "mime_dmg"
msgstr "DMG disk slika (Apple ga je predstavio 1980-ih, Disk Image format. Standardni format za distribuciju softvera na macOS-u, dvostrukim klikom se montira kao virtuelni disk, prevlačenjem se instalira aplikacija. Podržava kompresiju i enkripciju, glavni je format za preuzimanje Mac softvera)"

msgid "mime_emz"
msgstr "EMZ komprimirana slika (Windows komprimirana Enhanced Metafile, komprimirana verzija EMF-a. Format za pohranu vektorske grafike u Office dokumentima, u suštini GZIP komprimirana EMF datoteka)"

msgid "mime_gz"
msgstr "GZIP komprimirani paket (Jean-loup Gailly i Mark Adler su ga razvili 1992. godine, GNU projekat. Standardni alat za kompresiju na Unix/Linux sistemima, uobičajeni format za HTTP kompresiju pri prijenosu. Ekstenzija .gz, često se koristi u kombinaciji s TAR-om)"

msgid "mime_jar"
msgstr "JAR komprimirani paket (Sun Microsystems ga je predstavio 1997. godine, Java ARchive format. U suštini ZIP komprimirani paket, koristi se za pakovanje Java klasa i aplikacija. Osnovni format u Java ekosistemu poput Maven, Gradle, Android također koristi JAR)"

msgid "mime_lzma"
msgstr "LZMA komprimirani paket (Igor Pavlov ga je razvio 1998. godine, Lempel-Ziv-Markov chain algoritam. Osnovni algoritam kompresije 7z formata, visoka stopa kompresije, brza dekompresija. Koristi se za distribuciju firmvera i softvera za ugrađene sisteme)"

msgid "mime_rar"
msgstr "RAR komprimirani paket (Eugene Roshal ga je razvio 1993. godine, Roshal ARchive format. Visoka stopa kompresije, podržava podjelu na sveske i oporavak zapisa. Format WinRAR programa, stopa kompresije je bolja od ZIP-a, ali je potreban plaćeni softver, open source alati poput unrar-a mogu dekompresovati)"

msgid "mime_tar"
msgstr "TAR arhivski paket (Uveden u Unix V7 1979. godine, Tape ARchive format. Format trakaste arhive, samo pakovanje bez kompresije, često se koristi u kombinaciji sa GZIP/BZIP2/XZ. Izvorni kod softverskog paketa za Linux, slojevito skladištenje Docker slika koristi TAR format)"

msgid "mime_tgz"
msgstr "TGZ komprimirani paket (kombinacija TAR + GZIP formata, ekstenzija .tgz ili .tar.gz. Najuniverzalniji format distribucije za Unix/Linux softverske pakete, široko se koristi za izvorni kod i binarne pakete, predstavnik 'raspakiraj i koristi' koncepta)"

msgid "mime_tbz2"
msgstr "TBZ2 komprimirani paket (kombinacija TAR + BZIP2 formata, ekstenzija .tbz2 ili .tar.bz2. Stopa kompresije je 15-20% veća od TGZ-a, pogodan za distribuciju velikih datoteka, izvorni kod Linux kernela dugo je koristio ovaj format)"

msgid "mime_xz"
msgstr "XZ komprimirani paket (predstavljen 2009. godine, zasnovan na LZMA2 algoritmu. Izuzetno visoka stopa kompresije, 30-50% veća od GZIP-a, brzina dekompresije je relativno velika. Široko se koristi u Linux kernelu, menadžerima paketa (poput interne strukture Debian .deb paketa), preporučeni je format u Linux ekosistemu danas)"

msgid "mime_z"
msgstr "Z komprimirani paket (Unix compress komandni format iz 1985. godine, LZW algoritam. Rani Unix format kompresije, zamijenio ga je GZIP. Ekstenzija .Z, rijetko se koristi na modernim sistemima)"

msgid "mime_zip"
msgstr "ZIP komprimirani paket (Phil Katz ga je razvio 1989. godine, PKZIP format. Windows izvorno podržava, najuniverzalniji format kompresije na internetu. Podržava više datoteka, strukturu direktorija, može birati algoritam kompresije. JAR u Javi, APK na Androidu, DOCX/XLSX za Office dokumente zasnovani su na ZIP formatu)"

msgid "mime_zst"
msgstr "Zstandard komprimirani paket (Facebook ga je razvio 2015. godine, dizajnirao Yann Collet. Algoritam kompresije velike brzine, stopa kompresije blizu LZMA, brzina znatno veća od GZIP-a. Linux kernel 5.9+ ga podržava, Arch Linux pacman, Debian APT ga postepeno usvajaju, novi je standard kompresije sljedeće generacije)"

msgid "mime_lz4"
msgstr "LZ4 komprimirani paket (Yann Collet ga je razvio 2011. godine, izuzetno brz algoritam kompresije. Brzina kompresije je više od 10 puta veća od GZIP-a, pogodan za scenarije kompresije u realnom vremenu. Široko se koristi u Linux kernelu, OpenZFS, Hadoop-u, prvi je izbor za scenarije gdje je brzina prioritet)"

msgid "mime_lzo"
msgstr "LZO komprimirani paket (Markus Oberhumer ga je razvio 1996. godine, Lempel-Ziv-Oberhumer algoritam. Izuzetno brza dekompresija, prosječna stopa kompresije. Linux kernel Squashfs, OpenWrt firmver ga koriste, pogodan za ugrađene sisteme)"

msgid "mime_msi"
msgstr "MSI instalacijski paket (Microsoft ga je predstavio 1999. godine, Windows Installer format paketa. Standardni format instalacije za Windows aplikacije, podržava povratak transakcija, upravljanje komponentama, tiho instaliranje. Prvi izbor za distribuciju softvera u preduzećima, i dalje je glavni format za instalaciju Windows softvera)"

msgid "mime_pkg"
msgstr "PKG instalacijski paket (macOS aplikacijski instalacijski format, zasnovan na Apple-ovoj Installer tehnologiji. Standardni format za distribuciju softvera na macOS-u, podržava odabir komponenti, instalacijske skripte, funkciju deinstalacije. Dvostrukim klikom na .pkg datoteku se pokreće instalacija, uobičajeni način distribucije softvera izvan Mac App Store-a)"

msgid "mime_apk"
msgstr "APK Android aplikacijski paket (Google ga je predstavio 2008. godine, tradicionalni format instalacije za Android sistem. APK je u suštini ZIP komprimirani paket, sadrži kod, resurse, manifestnu datoteku. Od 2021. Google Play zahtijeva da nove aplikacije koriste AAB format, ali se APK i dalje koristi za razvoj, otklanjanje grešaka, distribuciju putem trećih prodavnica i bočno instaliranje)"

msgid "mime_ipa"
msgstr "IPA Apple aplikacijski paket (iOS App Store Package, format instalacije za iOS/iPadOS aplikacije. Predstavljen 2008. godine s iPhone SDK-om. Zahtijeva distribuciju putem App Store-a ili potpisivanje korporativnim certifikatom. Sadrži izvršnu datoteku, resurse, Info.plist potpisane informacije)"

msgid "mime_hap"
msgstr "HAP HarmonyOS aplikacijski paket (HarmonyOS Ability Package, osnovna jedinica HarmonyOS aplikacije. Predstavljen s HarmonyOS 2.0 2020. godine. Podržava entry i feature tipove, format distribucije za Huawei telefone, tablete, pametne satove i druge HarmonyOS uređaje)"

msgid "mime_har"
msgstr "HAR HarmonyOS statički dijeljeni paket (HarmonyOS Archive, statička dijeljena biblioteka za HarmonyOS, može se dijeliti između više HAP-ova, koristi se za komponentni razvoj i ponovnu upotrebu modula)"

msgid "mime_aab"
msgstr "Android App Bundle (Google ga je predstavio 2018. godine, od 2021. Google Play zahtijeva da nove aplikacije koriste ovaj format. AAB je format za distribuciju, Google Play dinamički generiše optimizirane APK na osnovu konfiguracije uređaja (arhitektura CPU-a, gustina piksela ekrana, jezik), prosječna veličina instalacijskog paketa je smanjena za 35%. Developeri postavljaju AAB, korisnici preuzimaju APK)"

msgid "mime_xapk"
msgstr "XAPK aplikacijski paket (prošireni Android aplikacijski paket treće strane, sadrži APK + OBB podatkovne datoteke. Koristi se za velike igre i složene aplikacije, rješava ograničenje od 100 MB pojedinačne APK datoteke. Uobičajeno u prodavnicama aplikacija treće strane poput APKPure, APKMirror, nije službeni Google format)"

msgid "mime_appx"
msgstr "Windows aplikacijski paket (Microsoft ga je predstavio 2012. godine, format instalacije aplikacija za Windows 8/10/11. Podržava UWP i konverziju desktop aplikacija, distribuira se putem Microsoft Store-a. Microsoft je 2024. godine predstavio MSIX kao nasljedni format, postepeno zamjenjuje APPX)"

msgid "mime_msix"
msgstr "MSIX aplikacijski paket (Microsoft ga je predstavio 2018. godine, novi Windows format za pakovanje aplikacija. Kombinira prednosti APPX i MSI, podržava sve tipove Windows aplikacija, može se distribuirati putem Microsoft Store-a ili bočno instalirati, preporučeni format za Windows 11)"

msgid "mime_appimage"
msgstr "AppImage aplikacijski paket (predstavljen 2004. godine, Linux format aplikacije bez instalacije. 'Jedna aplikacija = jedna datoteka', pokreće se direktno bez instalacije, podržava većinu Linux distribucija, uobičajeni način za developere da distribuiraju Linux softver)"

msgid "mime_flatpak"
msgstr "Flatpak aplikacijski paket (predstavljen 2015. godine, Linux format aplikacije u sandboxu. Pokreće se unakrsno distribucijama, izoliran od sistemskog okruženja, razvijaju ga Fedora, Red Hat, podrazumijevani format u GNOME Software centru)"

msgid "mime_snap"
msgstr "Snap aplikacijski paket (Canonical ga je predstavio 2014. godine, razvija ga Ubuntu matična kompanija, Linux univerzalni format aplikacije. Automatsko ažuriranje, sandbox izolacija, podržava 40+ Linux distribucija, podrazumijevani format u Ubuntu Software centru)"

msgid "mime_deb"
msgstr "Debian softverski paket (Debian projekat ga je predstavio 1993. godine, standardni instalacijski format za Debian/Ubuntu i njihove izvedenice. Njime upravlja dpkg, APT je njegov frontend menadžer paketa, jedan od najzrelijih formata paketa u Linux ekosistemu, i dalje je glavni za Debian porodicu)"

msgid "mime_rpm"
msgstr "RPM softverski paket (Red Hat ga je predstavio 1997. godine, standardni format za Red Hat/Fedora/CentOS/SUSE i druge distribucije. RPM je skraćenica za 'Red Hat Package Manager', uz DEB jedan od dva velika formata paketa u Linuxu, i dalje je glavni za RHEL porodicu)"

msgid "mime_pacman"
msgstr "Arch softverski paket (Arch Linux ga je predstavio 2002. godine, .pkg.tar.zst format koji koristi pacman menadžer paketa. Jezgro Arch Linux distribucije koja se kotrlja, poznat po jednostavnosti i KISS principu, AUR (Arch User Repository) je njegova posebnost)"

msgid "mime_exe"
msgstr "EXE izvršna datoteka (Windows izvršni programski format, skraćenica od 'Executable'. Izvorni izvršni format Windows operativnog sistema, sadrži PE strukturu. Evoluirao je iz MZ formata iz MS-DOS-a, PE (Portable Executable) format je uveden s Windows NT 1993. godine i koristi se i danas. Instalacijski paketi softvera, aplikacije, sistemski alati koriste ovaj format. Korisnik ih pokreće dvostrukim klikom, najšire korišteni izvršni format na svijetu)"

msgid "mime_dll"
msgstr "DLL dinamička biblioteka (Microsoft ju je predstavio 1993. godine, Dynamic Link Library. Windows dijeljena biblioteka koda, učitava se dinamički prilikom pokretanja programa, štedi memoriju i prostor na disku. Sistemske komponente, dodaci aplikacija, drajveri koriste DLL format. Osnovni način implementacije Windows API-ja, problem 'DLL Hell' je ublažen u .NET eri)"

msgid "mime_com"
msgstr "COM izvršna datoteka (izvršni format iz MS-DOS ere, skraćenica od 'Command'. Jednostavna struktura datoteke, ograničenje od 64KB, bio je glavni format prije Windows 3.x. Povučen, moderni Windows koristi EXE format, ekstenzija COM se i dalje koristi za neke komponentne datoteke)"

msgid "mime_aac"
msgstr "AAC audio (MPEG standard 1997. godine, Advanced Audio Coding. Nasljednik MP3-a, kvalitet zvuka je bolji od MP3 pri istoj brzini prijenosa, podrazumijevani audio format za YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC audio (Apple ga je razvio 2004. godine, Apple Lossless Audio Codec. Apple beskompresijski format, postao open source 2011. godine, podrazumijevani format za bežični audio u iTunes i Apple Music-u)"

msgid "mime_flac"
msgstr "FLAC audio (razvila Xiph.Org fondacija 2001. godine, Free Lossless Audio Codec. Beskompresijska kompresija, kvalitet zvuka je isti kao na CD-u, datoteka je otprilike upola manja od originalnog WAV-a. Open source i bez patenta, prvi izbor za audiofile i kolekcionare digitalne muzike)"

msgid "mime_mp3"
msgstr "MP3 audio (razvila Fraunhofer institut 1993. godine, MPEG-1 Audio Layer 3. Format kompresije s gubitkom, male datoteke sa pristojnim kvalitetom zvuka, bio je osnovni format digitalne muzičke revolucije 2000-ih, zaslužan za iPod i Napster. Patent je istekao 2017. godine, postao je javno dobro)"

msgid "mime_oga"
msgstr "Ogg Audio audio (razvila Xiph.Org fondacija, čisti audio format Ogg kontejnera, koristi Vorbis kodek. Open source i bez patenta, efikasnost kompresije je bolja od MP3, široko se koristi u open source projektima)"

msgid "mime_ogg"
msgstr "OGG audio (razvila Xiph.Org fondacija 2000. godine, Ogg Vorbis format. Open source i bez patenta, efikasnost kompresije je bolja od MP3, rano ga je koristio Spotify, široko se koristi u zvučnim efektima za igre)"

msgid "mime_opus"
msgstr "Opus audio (IETF standardiziran 2012. godine, open source i bez patenta. Kombinira SILK i CELT tehnologije, ekstremno niska latencija, najveća efikasnost kompresije, podrazumijevani audio format za WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV audio (razvili Microsoft i IBM 1991. godine, Windows izvorni audio format. PCM kodiranje bez kompresije, besprijekoran kvalitet, ali su datoteke ogromne, standardni format za profesionalnu audio montažu)"

msgid "mime_wma"
msgstr "WMA audio (Microsoft ga je razvio 1999. godine, Windows Media Audio. Ima verzije s gubitkom i bez gubitka, Windows izvorno podržava, postao je popularan s Windows Media Player-om. Danas je na margini, zamijenili su ga MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF audio (Direct Stream Digital format, razvili su ga Sony i Philips. 1-bit visoka brzina uzorkovanja, standardni format DSD audio, digitalna verzija SACD-a, vrhunski audio format za audiofile, ogromne datoteke)"

msgid "mime_ape"
msgstr "APE Audio (razvio Monkey's Audio 2000. godine, format kompresije bez gubitaka. Veća kompresija od FLAC-a ali sporije kodiranje, i dalje se koristi na Windows platformi i među audio entuzijastima)"

msgid "mime_mid"
msgstr "MIDI audio (MIDI asocijacija je uspostavila standard 1983. godine, Musical Instrument Digital Interface. Format notnog zapisa, a ne snimka, izuzetno male datoteke, standard za elektronske muzičke instrumente, melodije mobitela, zvučne efekte u igrama. General MIDI je standardiziran 1991. godine, definira 128 instrumenata)"

msgid "mime_m4a"
msgstr "M4A audio (MPEG-4 Audio, kontejnerski format za AAC. Standardni format za iTunes Music Store, glavni audio format u Apple ekosistemu, podržava DRM zaštitu)"

msgid "mime_m3u"
msgstr "M3U lista za reprodukciju (lista za reprodukciju MP3 URL-ova, obična tekstualna datoteka, bilježi putanje audio datoteka. Standard iz ere Winamp-a, koristi se za internet radio, online streaming muzike. M3U8 je njegova UTF-8 verzija, koristi se za HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF streaming medij (Microsoft ga je razvio 1996. godine, Advanced Systems Format. Windows Media streaming kontejner, podržava sinhronizirani prijenos audio i video zapisa. Koristi se za online prijenos uživo i streaming video na zahtjev, WMA/WMV su zasnovani na ASF kontejneru)"

msgid "mime_avi"
msgstr "AVI video (Microsoft ga je predstavio 1992. godine, rani Windows video standard. 'Audio Video Interleave', audio i video zapis su isprepleteni, bio je najpopularniji video format 1990-ih i 2000-ih, danas ga je zamijenio MP4/MKV)"

msgid "mime_divx"
msgstr "DivX video (razvila DivX kompanija 1998. godine, video kodek zasnovan na MPEG-4. Bio je glavni format za dijeljenje video zapisa na internetu 2000-ih, prvi put je omogućio kompresiju DVD kvaliteta na veličinu CD-a. Zbog autorskih sporova, kasnije se transformirao u komercijalni kodek)"

msgid "mime_mp4"
msgstr "MP4 video (MPEG standard 2001. godine, MPEG-4 Part 14. Najuniverzalniji video format na svijetu, podržava H.264/H.265 kodiranje, podrazumijevani format za internet video, snimanje mobitelom, YouTube)"

msgid "mime_m4v"
msgstr "M4V video (iTunes video format, varijanta MP4-a. Video format u Apple ekosistemu, standardni format za filmove i TV serije u iTunes Store-u, podržava DRM zaštitu autorskih prava)"

msgid "mime_mpeg"
msgstr "MPEG video (MPEG organizacija je uspostavila standard 1988. godine, Moving Picture Experts Group. Osnovni standardi za kompresiju digitalnog videa, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (internet video) imali su dubok utjecaj)"

msgid "mime_mkv"
msgstr "MKV video (razvio Matroska projekat 2002. godine, open source multimedijalni kontejnerski format. Podržava više audio zapisa, više titlova, poglavlja, 'sposoban za pakovanje svega', prvi izbor za dijeljenje filmova visoke definicije)"

msgid "mime_mpg"
msgstr "MPEG video (ekstenzija za MPEG-1/MPEG-2 video, standardni format za VCD i DVD. Bio je glavni format za video na CD-ovima 1990-ih i 2000-ih, danas ga je zamijenio H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video video (razvila Xiph.Org fondacija, video format Ogg kontejnera, koristi Theora kodek. Open source i bez patenta, bio je jedan od ranih standarda za HTML5 video, Firefox ga izvorno podržava)"

msgid "mime_ogx"
msgstr "Ogg multimedijalni kontejner (razvila Xiph.Org fondacija, univerzalno proširenje Ogg kontejnera, može sadržavati više zapisa kao što su audio, video, titlovi. Open source multimedijalni standard, koristi se u igrama i streaming medijima)"

msgid "mime_rm"
msgstr "RealMedia video (RealNetworks ga je razvio 1995. godine, RealMedia format. Bio je pionir streaming medija na internetu 1990-ih i 2000-ih, osnovni format RealPlayer-a. Nedostaci: potreban je specijalizirani plejer, loš kvalitet kompresije, zamijenili su ga Flash/MP4)"

msgid "mime_flv"
msgstr "Flash video (format se pojavio 2002. godine, Flash Video format. Nekada je bio glavni oblik internet videa, rano ga je koristio YouTube. Nedostaci: potreban Flash dodatak, loše performanse, mnoge sigurnosne rupe. Od 2015. godine glavne web stranice su prešle na HTML5 video, danas je ukinut)"

msgid "mime_f4v"
msgstr "F4V video (Flash video format koji je razvio Adobe, nasljednik FLV-a. Zasnovan na MPEG-4 standardu, podržava H.264 kodiranje. Povučen je zajedno sa Flash tehnologijom, Adobe je obustavio podršku 2020. godine)"

msgid "mime_wmv"
msgstr "WMV video (Microsoft ga je razvio 1999. godine, Windows Media Video. Windows izvorno podržava, optimiziran za prijenos streaming medija, bio je čest format za online video 2000-ih, danas je na margini)"

msgid "mime_wmf"
msgstr "WMF medijski format (Windows Media Format, Microsoftov okvir za medije. Uključuje WMV video, WMA audio, Windows Media Player ga izvorno podržava)"

msgid "mime_mov"
msgstr "MOV video (Apple ga je razvio 1991. godine, QuickTime kontejnerski format. Standardni format za profesionalnu video montažu, podržava više kodeka, nativno ga podržavaju Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime video (Apple ga je predstavio 1991. godine, QuickTime format. Standard za video na Mac platformi, MOV je njegov kontejner, QuickTime plejer je bio široko korišten. Apple je 2016. godine obustavio razvoj Windows verzije, postepeno ga zamjenjuje MP4)"

msgid "mime_webm"
msgstr "WebM video (Google ga je predstavio 2010. godine, open source i bez patenta. Zasnovan na Matroska kontejneru, VP8/VP9 kodiranje, standardni format za HTML5 video, podrazumijevani format za YouTube Web plejer)"

msgid "mime_3gp"
msgstr "3GP video (uspostavio 3GPP 2000. godine, video format za mobilne uređaje. Izuzetno male datoteke, nizak kvalitet, format za snimanje na starim mobilnim telefonima, korišten za slanje putem MMS-a)"

