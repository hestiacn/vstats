msgid "[Start date of last visit] and [Last page of last visit] are saved only if session is not finished"
msgstr "[Vrijeme početka posljednje posjete] i [Posljednja stranica posljednje posjete] spremaju se samo ako sesija nije završena"

msgid "The %s first Hits must be first (order not required for others)"
msgstr "Na početnoj stranici se prikazuje samo prvih %s stavki s najvećim brojem zahtjeva. Potpunu listu potražite na stranici s detaljima."

