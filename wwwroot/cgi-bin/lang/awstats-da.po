#------------------------------------------------------------------------------
# Formatbeskrivelser
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstfil (ASCII-standardisering 1963, uformateret almindelig tekst. Grundlaget for al kildekode, konfigurationer, logfiler. Unix bruger LF, Windows bruger CRLF til linjeskift, stadig det mest almindelige dataformat i computere)"

msgid "mime_log"
msgstr "Logfil (almindelig tekstfil, der registrerer system- og applikationskørselsinformation, ofte brugt til fejlfinding, ydeevneanalyse, sikkerhedsrevision. Standardformater som Apache combined log, Nginx access log, syslog osv.)"

msgid "mime_page"
msgstr "HTML-webside (Tim Berners-Lee opfandt World Wide Web i 1989, definerede de tre teknologier HTML/HTTP/URL i 1990, tilbød dem gratis uden patent. HTML5 blev den officielle W3C-standard i 2014, understøtter visning, multimedier og print. Vandt Turing-prisen i 2016)"

msgid "mime_khtml"
msgstr "KHTML webmotor (udgivet med KDE 2.0 i 1998, renderingsmotor til Konqueror-browseren. Apple skabte WebKit baseret på KHTML i 2001, Google skabte Blink fra WebKit i 2008, som blev kernen i browsere som Chrome, Edge, Safari. KHTML er et eksempel på, hvordan open source-fællesskabet lagde grundstenene til moderne browsermotorer, med sin teknologiske arv, der fortsætter gennem WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamisk script (tolket sprog, kræver ikke kompilering. Omfatter ASP, JSP, CGI, ColdFusion, Tcl, VBScript osv., meget brugt i tidlig webudvikling, systemadministration, automatisering af opgaver. Moderne script-sprog som Python, Ruby, JavaScript har udviklet sig til de vigtigste sprog til full-stack udvikling)"

msgid "mime_js"
msgstr "JavaScript-script (Brendan Eich skabte det på 10 dage i Netscape i 1995, browsers oprindelige programmeringssprog. ECMAScript standardiseret i 1997, fødslen af Node.js i 2009 gjorde det til et full-stack sprog, npm er verdens største pakkeadministrator. I årevis det mest populære programmeringssprog på GitHub)"

msgid "mime_py"
msgstr "Python-script (skabt af Guido van Rossum i 1991, kendt for obligatorisk indrykning og enkel syntaks. Meget brugt i webudvikling, datavidenskab, kunstig intelligens, automatiseret drift. Flere gange vinder af TIOBE prisen for årets programmeringssprog)"

msgid "mime_sh"
msgstr "Shell-script (Unix' fødsel i 1971, kommandoscriptsprog. Bruges til systemadministration, automatisering af opgaver, start af tjenester, implementeringsscripts. Nødvendig færdighed til Linux-administration)"

msgid "mime_rb"
msgstr "Ruby-script (skabt af Yukihiro Matsumoto i 1995, fokuseret på udviklerens lykke. Ruby on Rails-rammeværket indførte paradigmet konvention over konfiguration, der påvirker designet af moderne webrammeværker)"

msgid "mime_pl"
msgstr "Perl-script (skabt af Larry Wall i 1987, kendt for sin pragmatisme, kaldet 'schweizerkniven'. CPAN var pioner inden for moderne sprogpakkeadministratorer, med dyb indflydelse på tekstbehandling, systemadministration og CGI)"

msgid "mime_php"
msgstr "PHP dynamisk webside (skabt af Rasmus Lerdorf i 1995, designet specielt til webudvikling. Over 70% af verdens websteder bruger det, driver platforme som WordPress, Facebook, Wikipedia. PHP 8 introducerer JIT-kompilering, hvilket forbedrer ydeevnen markant)"

msgid "mime_image"
msgstr "Billedfil"

msgid "mime_document"
msgstr "Dokumentfil"

msgid "mime_package"
msgstr "Softwarepakke"

msgid "mime_archive"
msgstr "Gzip-komprimeret fil (GNU-projekt fra 1992, baseret på DEFLATE-algoritmen. På nettet bruges det til dynamisk komprimering af svar, kompressionsgraden er normalt 60-90%. Efter 2015 blev det i nogle scenarier erstattet af Brotli, men er stadig det mest udbredte kompressionsformat på serversiden)"

msgid "mime_audio"
msgstr "Lydfil"

msgid "mime_video"
msgstr "Videofil"

msgid "mime_jscript"
msgstr "JavaScript (udviklet af Brendan Eich i 1995)"

msgid "mime_json"
msgstr "JSON-data (foreslået af Douglas Crockford i 2001, letvægts dataudvekslingsformat, de facto standard for web-API'er)"

msgid "mime_vbs"
msgstr "VBScript (udviklet af Microsoft i 1996, Windows-scriptsprog, brugt til ASP-websider og Windows-administrationsscripts. Med udbredelsen af PowerShell og JavaScript er det gradvist ved at forsvinde)"

msgid "mime_conf"
msgstr "Konfigurationsfil (gemmer softwarekonfiguration i tekstformat, almindelige formater: INI, JSON, YAML, TOML, XML. Linux-systemkonfiguration er for det meste i /etc-mappen)"

msgid "mime_css"
msgstr "CSS-stilark (W3C udgav den første officielle standard CSS1 i december 1996, CSS2 tilføjede positionering og medietyper i 1998, fra 2011 introducerede CSS3-modularisering afrundede hjørner, animationer, fleksibel boks, gitterlayout og responsivt design. Sammen med HTML og JavaScript en af de tre primære front-end-teknologier, alle moderne browsere (Chrome, Firefox, Safari, Edge) understøtter det oprindeligt, er den eneste standard til at definere stil på websider)"

msgid "mime_xsl"
msgstr "XSL-stilark (W3C-standard fra 1999, XML-dokumenttransformationssprog, kan konvertere XML til HTML/PDF/tekst. Brugen er faldet efter udbredelsen af JSON)"

msgid "mime_runtime"
msgstr "Udførbar fil (eksekverbar format af operativsystem som EXE, ELF, Mach-O, indeholder maskinkode og indlæsningsoplysninger)"

msgid "mime_library"
msgstr "Biblioteksfil (DLL, SO, dylib osv., dynamisk linkede biblioteker, delt kode, som programmet indlæser under udførelse)"

msgid "mime_swf"
msgstr "Flash-animation (Macromedia udviklede det i 1996, senere ejet af Adobe. Interaktiv standard for webanimation, dominerede engang internetanimationer og spil. Ulemper: kræver plugin, ikke understøttet på mobile enheder, høj sikkerhedsrisiko. Adobe annoncerede udfasning i 2017, stoppede fuldstændig support i 2020, erstattet af HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD dokumenttype definition (XML-specifikation, definerer strukturen af et XML-dokument, bruges til at validere XML's gyldighed)"

msgid "mime_csv"
msgstr "CSV-dataformat (kommaseparerede værdier, almindeligt tabeldataformat, standard for import/eksport af Excel og databaser)"

msgid "mime_jnlp"
msgstr "Java Web Start (starter til Java-applikationer, teknologi til distribution af Java-skrivebordsapplikationer fra 2000'erne, nu forældet)"

msgid "mime_lit"
msgstr "Microsoft Reader e-bog (Microsoft udgav det i 2000, LIT-format, forældet)"

msgid "mime_svg"
msgstr "SVG-vektorgrafik (W3C-standard fra 1999, fordi Microsoft længe promoverede sit eget VML-format understøttede IE-browseren det først i 2011, hvilket forsinkede udbredelsen. Efter 2015, med IE's udfasning og populariseringen af højopløsningsskærme, er det blevet det foretrukne format til ikoner og logoer)"

msgid "mime_ai"
msgstr "Adobe Illustrator-vektorgrafik (lanceret i 1987, industristandard vektorgrafikformat, foretrukket til trykdesign, logoer, ikoner)"

msgid "mime_phshop"
msgstr "Photoshop-billede (Adobe udgav det i 1990, Photoshop-kildeformat PSD, industristandard for billedbehandling)"

msgid "mime_ttf"
msgstr "TrueType-skrifttype (Apple og Microsoft udviklede sammen i 1989, vektor skriftformat, visning på skærm og udskrift er ens, standard skriftformat for moderne operativsystemer)"

msgid "mime_fon"
msgstr "WOFF2 webskrifttype (W3C-anbefaling fra 2014, bruger Brotli-kompressionsalgoritmen, sammenlignet med ældre WOFF er volumen reduceret med ca. 30%, sammenlignet med TTF/OTF reduceret med over 50%, understøttes i øjeblikket af alle moderne browsere, er det foretrukne format til moderne webskrifttyper, understøttes af over 98% af browsere)"

msgid "mime_pdf"
msgstr "PDF-dokument (Adobe udviklede det i 1993, blev ISO-standard i 2008. Platformsuafhængigt dokumentformat, bevarer formatkonsistens, er den globale standard for distribution af elektroniske dokumenter)"

msgid "mime_dotnet"
msgstr "ASP.NET dynamisk side (Microsoft udgav det i 2002, teknologi til dynamiske websider på Windows-platformen, en del af .NET Framework)"

msgid "mime_mdb"
msgstr "Access-database (Microsoft Access databasefil, lanceret i 1992, Windows desktop-databaseløsning)"

msgid "mime_md"
msgstr "Markdown-dokument (oprettet af John Gruber i 2004, syntaksdesign påvirket af reStructuredText og Setext. Grundlæggende designfilosofi er 'læsbarhed betyder renderbar', den oprindelige implementering Markdown.pl bruger Perls regulære udtryk. Afledte specifikationer inkluderer GFM (2013), CommonMark (2017), Pandoc Markdown osv. Driver økosystemer som GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, og bliver standardformatet for statiske webstedsgeneratorer og udviklerdokumentation)"

msgid "mime_crystal"
msgstr "Crystal Reports-rapportformat (SAP business intelligence, standardformat for virksomhedsrapporter)"

msgid "mime_libreoffice"
msgstr "LibreOffice-dokument (The Document Foundation udviklede det i 2010, en gren af OpenOffice, implementering af ODF-standarden, den primære open source-kontorpakke)"

msgid "mime_encrypt"
msgstr "Krypteret fil (skal dekrypteres for at vises, almindelige filendelser: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS-spordata (GPS-udvekslingsformat, registrerer geografisk information, almindeligt format til sportsure og navigationsenheder)"

msgid "mime_diskimage"
msgstr "Diskbillede (disk-/CD-ROM-billedfiler som DMG, ISO, IMG, bruges til at distribuere software eller sikkerhedskopiere lagringsmedier)"

msgid "mime_vm"
msgstr "Virtuel maskine-billede (virtuelle diskfiler som VMDK, VDI, VHDX, OVA, formater til virtualiseringsplatforme som VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent torrent-fil (Bram Cohen opfandt den i 2001, indeksfil til P2P-download, indeholder filmetadata og Tracker-information)"

msgid "mime_gis"
msgstr "GIS geografiske informationssystemdata (geospatiale data som Shapefile, GeoJSON, bruges til kort og rumlig analyse)"

msgid "mime_ebook"
msgstr "E-bog (e-bogsformater som EPUB, MOBI, AZW. EPUB er den internationale standard, MOBI/AZW er formater til Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF-billede (lanceret af Alliance for Open Media i 2019, baseret på AV1-kodning, kompressionsrate 50% bedre end WebP, ny generations standard for web-billeder)"

msgid "mime_markdown"
msgstr "Markdown-dokument (designet af John Gruber i 2004, letvægts markup-sprog, almindeligt format til GitHub README, teknisk dokumentation, forumindlæg)"

msgid "mime_yaml"
msgstr "YAML-konfiguration (designet af Clark Evans i 2001, menneskeligt læsbart data-serialiseringsformat, standard for konfigurationsfiler til Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML-konfiguration (designet af Tom Preston-Werner i 2013, 'Tom's Obvious Minimal Language', konfigurationsfilformat til moderne værktøjer som Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue-komponentfil (introduceret i 2014 af Evan You, progressiv JavaScript-ramme. Gennem single-file components (SFC) kombinerer den HTML, CSS og JS perfekt, hvilket i høj grad øger udviklingseffektiviteten. Det er en af verdens mest populære frontend-rammer. Samtidig som kerne i moderne statiske site-generatorer som VitePress, bruges den bredt til at drive interaktiv teknisk dokumentation og blogs.)"

msgid "mime_wasm"
msgstr "WebAssembly-modul (W3C-standard fra 2017, højtydende udførelsesformat i browseren, C/C++/Rust/R kan kompileres til dette mål, ydeevne tæt på indbygget)"

msgid "mime_jsx"
msgstr "React JSX-komponent (Facebook udgav JavaScript XML i 2013, komponentsyntaks til React-rammen, innovativt paradigme, der bringer HTML ind i JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX-komponent (udviklet af Microsoft i 2012, TypeScript + JSX, standard måde at skrive typesikker React-udvikling på)"

msgid "mime_heif"
msgstr "HEIF-billede (MPEG-standard fra 2015, højeffektivt billedfilformat, meget brugt i Apple-økosystemet)"

msgid "mime_heic"
msgstr "HEIC-billede (Apples implementering af HEIF, standard fotograferingsformat på iPhone, oprindeligt understøttet på iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D-model (GL-overførselsformat, 'JPEG til 3D-verdenen', Khronos Group udgav i 2015, standardformat til Web 3D)"

msgid "mime_glb"
msgstr "GLB binær 3D-model (binær version af GLTF, en enkelt fil indeholder alle ressourcer, bruges til distribution af 3D-scener)"

msgid "mime_gls"
msgstr "GLOSSARY-ordliste (fil med termdefinitioner, til termstyring i dokumentsystemer)"

msgid "mime_cbz"
msgstr "CBZ-tegneserie (ZIP-komprimerede tegneseriebilleder, almindeligt format til tegneseriesamling)"

msgid "mime_cbr"
msgstr "CBR-tegneserie (RAR-komprimerede tegneseriebilleder, almindeligt format til tegneseriesamling)"

msgid "mime_fb2"
msgstr "FB2 e-bog (FictionBook 2.0, russisk e-bogsformat, XML-struktur, bredt understøttet af open source-læsere)"

msgid "mime_kepub"
msgstr "KEPUB e-bog (specielt EPUB-format til Kobo, optimeret format til Kobo e-bogslæser)"

msgid "mime_m4b"
msgstr "M4B-lydbog (MPEG-4 lydformat til bøger, understøtter bogmærker, iTunes-lydbogsformat)"

msgid "mime_kfx"
msgstr "Kindle KFX-format (Amazon udgav i 2015, specielt e-bogsformat til Kindle, understøtter avanceret layout og hurtig sideblading)"

msgid "mime_chm"
msgstr "CHM-hjælpefil (Microsoft udgav i 1997, kompileret HTML-hjælpeformat, standard til Windows-software hjælpedokumentation)"

msgid "mime_mht"
msgstr "MHT-webarkiv (Microsoft udgav i 1999, enkeltfils webformat, IE-browserens format til at gemme websider)"

msgid "mime_wml"
msgstr "WML trådløst markup-sprog (WAP-standard fra 1999, brugt til websider på tidlige funktionstelefoner, forældet)"

msgid "mime_xhtml"
msgstr "XHTML-webside (W3C-standard fra 2000, XML-version af HTML, strengere syntaks. W3C stoppede vedligeholdelse i 2009, fokuserede på HTML5)"

msgid "mime_xml"
msgstr "XML-dokument (W3C-standard fra 1998, udvidelsesbart markup-sprog, grundlæggende format til webservices, konfigurationsfiler, dataudveksling)"

msgid "mime_sgml"
msgstr "SGML-dokument (ISO-standard fra 1986, forgænger til HTML, standard generelt markup-sprog, både XML og HTML er afledt af SGML)"

msgid "mime_apng"
msgstr "APNG-animation (Mozilla udviklede i 2004, animationstilføjelse til PNG, moderne erstatning for GIF, understøtter ægte farver og gennemsigtighed)"

msgid "mime_bmp"
msgstr "BMP bitmap (Windows bitmapformat, indbygget understøttet siden Windows 1.0. Ukomprimeret, stor filstørrelse, men på grund af den enkle struktur og manglende behov for yderligere codecs, bruges det stadig i Windows 11s udklipningsværktøj, Paint-programmet, ikonressourcer i EXE/MSI-installationspakker, markørfiler og nogle ældre drivere. Ved samme billedkvalitet er filstørrelsen ca. 3-10 gange større end PNG. I de fleste tilfælde er det blevet erstattet af PNG/JPEG, men Windows-økosystemet opretholder stadig bred kompatibilitet)"

msgid "mime_cdr"
msgstr "CDR-vektorgrafik (CorelDRAW-specifikt format, canadisk virksomhed Corel, software til vektorgrafisk design)"

msgid "mime_gif"
msgstr "GIF-billede (CompuServe udviklede i 1987, 256-farve animeret billedformat. Ulemper: få farver, grov billedkvalitet, understøtter ikke gennemsigtighed, stor fil, lav billedfrekvens. Erstattet af moderne animerede formater som APNG, WebP)"

msgid "mime_ico"
msgstr "ICO-ikon (Windows-ikonformat, understøtter flere opløsninger, standardformat for favicon på websteder)"

msgid "mime_jpeg"
msgstr "JPEG-billede (ISO-standard fra 1992, tabsgivende kompressionsformat til fotos, de facto standard for fotos på internettet)"

msgid "mime_jpg"
msgstr "JPEG-billede (ISO-standard fra 1992, tabsgivende kompressionsformat til fotos, de facto standard for fotos på internettet)"

msgid "mime_png"
msgstr "PNG-billede (W3C-anbefaling fra 1996, understøtter ægte farver og gennemsigtighed, statisk erstatning for GIF, standard for tabsfri billeder på internettet)"

msgid "mime_ps"
msgstr "PostScript-sidebeskrivelsesfil (Adobe udgav i 1985, sidebeskrivelsessprog, forgænger til PDF, bruges til trykning og udgivelse)"

msgid "mime_psb"
msgstr "PSB stort dokument (Adobe Photoshop-format til ekstremt store billeder, understøtter kæmpe billeder på over 2 GB eller 30000 pixels)"

msgid "mime_psd"
msgstr "PSD-billede (Adobe Photoshop-kildekodefil, understøtter lag, kanaler, stier, industristandardformat for billedbehandling)"

msgid "mime_webp"
msgstr "WebP-billede (Google udviklede i 2010, web-billedformat, understøtter tabsgivende/tabsfri komprimering og animation, kompressionsrate 25-35% bedre end PNG og 25% bedre end JPEG)"

msgid "mime_woff"
msgstr "WOFF-webskrifttype (skabt i 2009, W3C-standard fra 2018. Komprimeret baseret på TrueType/OpenType, optimeret til indlæsning af webskrifttyper, standardformat for ikonskrifttyper på moderne websteder)"

msgid "mime_7z"
msgstr "7z-komprimeret arkiv (Igor Pavlov udviklede det i 1999, specifikt format for 7-Zip-programmet. LZMA-algoritme, høj kompressionsrate, open source og gratis. 7z-formatet er ved samme kompressionsrate normalt 30-50% mindre end ZIP, almindeligt format i open source-fællesskabet og til softwaredistribution)"

msgid "mime_ace"
msgstr "ACE-komprimeret arkiv (udviklet i 1990'erne, format for WinACE-programmet. Konkurrerede engang med RAR, kompressionsraten var ret høj. Udvikling stoppet i 2007, nu erstattet af 7z/RAR, sjældent brugt)"

msgid "mime_bz2"
msgstr "BZIP2-komprimeret arkiv (Julian Seward udviklede det i 1996, bloksorteringskompressionsalgoritme. Kompressionsraten er 15-20% højere end GZIP, men langsommere. Almindeligt format til Linux-kernens kildekode, open source-softwarepakker, filendelse .bz2)"

msgid "mime_cab"
msgstr "CAB-komprimeret arkiv (Microsoft udviklede det i 1995, Cabinet-format. Installationspakkeformat til Windows, bruges til drivere, distribution af systemfiler. Windows Installer (MSI) bruger internt CAB til at gemme filer)"

msgid "mime_dmg"
msgstr "DMG-diskbillede (Apple introducerede i 1980'erne, Disk Image-format. Standardformat til distribution af macOS-software, dobbeltklik for at montere som en virtuel disk, træk og slip for at installere applikationen. Understøtter komprimering og kryptering, er det primære format til download af Mac-software)"

msgid "mime_emz"
msgstr "EMZ-komprimeret billede (Windows komprimeret forbedret metafil, komprimeret version af EMF. Format til lagring af vektorgrafik i Office-dokumenter, i bund og grund er det en GZIP-komprimeret EMF-fil)"

msgid "mime_gz"
msgstr "GZIP-komprimeret arkiv (Jean-loup Gailly og Mark Adler udviklede i 1992, GNU-projekt. Standardværktøj til komprimering på Unix/Linux, almindeligt format til HTTP-overførselkomprimering. Filendelse .gz, bruges ofte sammen med TAR)"

msgid "mime_jar"
msgstr "JAR-komprimeret arkiv (Sun Microsystems udgav i 1997, Java ARchive-format. I bund og grund er det en ZIP-fil, bruges til at pakke Java-biblioteker og applikationer. Grundlæggende format for Java-økosystemet som Maven, Gradle. Android bruger også JAR)"

msgid "mime_lzma"
msgstr "LZMA-komprimeret arkiv (Igor Pavlov udviklede det i 1998, Lempel-Ziv-Markov chain-algoritme. Hovedkompressionsalgoritme til 7z-format, høj kompressionsrate, hurtig dekompressionshastighed. Bruges til distribution af firmware og software til indlejrede systemer)"

msgid "mime_rar"
msgstr "RAR-komprimeret arkiv (Eugene Roshal udviklede det i 1993, Roshal ARchive-format. Høj kompressionsrate, understøtter opdeling i volumener og gendannelsesposter. Format for WinRAR-programmet, kompressionsraten er bedre end ZIP, men kræver betalt software, open source-værktøjer som unrar kan dekomprimere)"

msgid "mime_tar"
msgstr "TAR-arkiv (Unix V7 introducerede det i 1979, Tape ARchive-format. Båndarkiv, pakker kun uden komprimering, bruges ofte sammen med GZIP/BZIP2/XZ. Linux-pakkers kildekode, lagring af Docker-billedlag bruger TAR-format)"

msgid "mime_tgz"
msgstr "TGZ-komprimeret arkiv (kombineret format TAR + GZIP, filendelse .tgz eller .tar.gz. Det mest almindelige format til distribution af Unix/Linux-softwarepakker, kildekodepakker, binære pakker, meget brugt, repræsenterer 'udpak og brug')"

msgid "mime_tbz2"
msgstr "TBZ2-komprimeret arkiv (kombineret format TAR + BZIP2, filendelse .tbz2 eller .tar.bz2. Kompressionsrate 15-20% højere end TGZ, velegnet til distribution af store filer, Linux-kernen har længe brugt dette format)"

msgid "mime_xz"
msgstr "XZ-komprimeret arkiv (introduceret i 2009, baseret på LZMA2-algoritmen. Ekstrem høj kompressionsrate, 30-50% bedre end GZIP, dekompressionshastighed relativt hurtig. Linux-kernen, pakkeadministratorer (som inde i Debian's .deb) bruger det i vid udstrækning, anbefalet format i det nuværende Linux-økosystem)"

msgid "mime_z"
msgstr "Z-komprimeret arkiv (format for Unix compress-kommando fra 1985, LZW-algoritme. Tidligt Unix-kompressionsformat, erstattet af GZIP. Filendelse .Z, moderne systemer bruger det sjældent)"

msgid "mime_zip"
msgstr "ZIP-komprimeret arkiv (Phil Katz udviklede det i 1989, PKZIP-format. Windows understøtter oprindeligt, det mest almindelige kompressionsformat på internettet. Understøtter flere filer, mappestruktur, kan vælge kompressionsalgoritme. JAR fra Java, APK fra Android, DOCX/XLSX fra Office-dokumenter er baseret på ZIP-format)"

msgid "mime_zst"
msgstr "Zstandard-komprimeret arkiv (Facebook udviklede i 2015, designet af Yann Collet. Kompressionsalgoritme med høj hastighed, kompressionsrate tæt på LZMA, hastighed langt overgår GZIP. Linux-kernen 5.9+ understøtter, Arch Linux pacman, Debian APT indfører gradvist, ny generation af kompressionsstandard)"

msgid "mime_lz4"
msgstr "LZ4-komprimeret arkiv (Yann Collet udviklede i 2011, ekstremt hurtig kompressionsalgoritme. Kompressionshastighed mere end 10 gange hurtigere end GZIP, velegnet til realtidskompressionsscenarier. Linux-kernen, OpenZFS, Hadoop bruger det i vid udstrækning, første valg til scenarier, hvor hastighed er prioritet)"

msgid "mime_lzo"
msgstr "LZO-komprimeret arkiv (Markus Oberhumer udviklede i 1996, Lempel-Ziv-Oberhumer-algoritme. Dekompressionshastighed er ekstremt hurtig, kompressionsraten er gennemsnitlig. Linux-kernen Squashfs, OpenWrt-firmware bruger det, velegnet til indlejrede systemer)"

msgid "mime_msi"
msgstr "MSI-installationspakke (Microsoft udgav i 1999, Windows Installer-pakkeformat. Standardinstallationsformat til Windows-applikationer, understøtter transaktionsrulning, komponentstyring, stille installation. Førstevalg til softwaredistribution på virksomhedsniveau, stadig det primære format til Windows-softwareinstallation i dag)"

msgid "mime_pkg"
msgstr "PKG-installationspakke (macOS-installationspakkeformat til applikationer, baseret på Apples Installer-teknologi. Standardformat til distribution af macOS-software, understøtter valg af komponenter, installationsscripts, afinstallationsfunktion. Dobbeltklik på .pkg-filen for at installere, almindelig distributionsmetode til software uden for Mac App Store)"

msgid "mime_apk"
msgstr "APK Android-applikationspakke (lanceret af Google i 2008, traditionelt installationsformat til Android-applikationer. APK er i bund og grund en ZIP-pakke, der indeholder kode, ressourcer og manifestfil. Fra 2021 kræver Google Play, at nye applikationer bruger AAB-formatet, men APK bruges stadig til fejlfinding, tredjepartsbutikker og sideloadning)"

msgid "mime_ipa"
msgstr "IPA iOS-applikationspakke (iOS App Store Package, installationsformat til iOS/iPadOS-applikationer. Lanceret i 2008 med iPhone SDK. Skal distribueres via App Store eller underskrives med en virksomhedscertifikat. Indeholder en eksekverbar fil, ressourcer, Info.plist og signaturinformation)"

msgid "mime_hap"
msgstr "HAP HarmonyOS-applikationspakke (HarmonyOS Ability Package, grundlæggende enhed i en HarmonyOS-applikation. Lanceret i 2020 med HarmonyOS 2.0. Understøtter to typer: entry og feature, distributionsformat til Huawei-telefoner, tablets, smartwatches og andre HarmonyOS-enheder)"

msgid "mime_har"
msgstr "HAR HarmonyOS statisk delt bibliotek (HarmonyOS Archive, statisk delt bibliotek til HarmonyOS, kan deles af flere HAP-pakker, bruges til komponentbaseret udvikling og genbrug af moduler)"

msgid "mime_aab"
msgstr "Android App Bundle (Google udgav i 2018, fra 2021 kræver Google Play, at nye applikationer bruger dette format. AAB er et distributionsformat, Google Play genererer optimerede APK'er i henhold til enhedskonfiguration (CPU-arkitektur, skærmtæthed, sprog), installationspakkens størrelse reduceres i gennemsnit med 35%. Udviklere uploader AAB, brugere downloader APK)"

msgid "mime_xapk"
msgstr "XAPK-applikationspakke (tredjeparts Android-applikationsudvidelsespakke, indeholder APK + OBB-datafiler. Bruges til store spil og komplekse applikationer, løser 100 MB-grænsen for en enkelt APK-fil. Almindelig i tredjeparts app-butikker som APKPure, APKMirror, ikke et officielt Google-format)"

msgid "mime_appx"
msgstr "Windows-applikationspakke (Microsoft udgav i 2012, installationsformat til Windows 8/10/11-applikationer. Understøtter UWP-applikationer og konvertering af desktopapplikationer, distribueres via Microsoft Store. I 2024 udgav Microsoft MSIX som efterfølgerformat, erstatter gradvist APPX)"

msgid "mime_msix"
msgstr "MSIX-applikationspakke (Microsoft udgav i 2018, ny generation af pakkeformat til Windows-applikationer. Kombinerer fordelene ved APPX og MSI, understøtter alle typer Windows-applikationer, kan distribueres via Microsoft Store eller sideloading, anbefalet format til Windows 11)"

msgid "mime_appimage"
msgstr "AppImage-applikationspakke (introduceret i 2004, Linux-applikationsformat uden installation. 'En applikation - én fil', kører direkte uden installation, understøtter de fleste Linux-distributioner, almindelig måde for udviklere at distribuere Linux-software på)"

msgid "mime_flatpak"
msgstr "Flatpak-applikationspakke (introduceret i 2015, Linux-applikationsformat i sandkasse. Fungerer på tværs af distributioner, isoleret fra værtsystemet, udvikling ledet af Fedora og Red Hat, standardformat for GNOME Software Center)"

msgid "mime_snap"
msgstr "Snap-applikationspakke (Canonical udgav i 2014, moderselskabet for Ubuntu udviklede, universelt Linux-applikationsformat. Automatisk opdatering, sandkasseisolering, understøtter 40+ Linux-distributioner, standardformat for Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Debian-softwarepakke (Debian-projektet udgav i 1993, standardinstallationsformat til Debian/Ubuntu og deres afledte. Administreres ved hjælp af dpkg, APT er dets pakkeadministratorfrontend, en af de mest modne pakkeformater i Linux-økosystemet, stadig det primære i Debian-familien i dag)"

msgid "mime_rpm"
msgstr "RPM-softwarepakke (Red Hat udgav i 1997, standardformat til distributioner som Red Hat/Fedora/CentOS/SUSE. RPM står for 'Red Hat Package Manager', sammen med DEB udgør de to primære pakkeformater i Linux, stadig det primære i RHEL-familien i dag)"

msgid "mime_pacman"
msgstr "Arch-softwarepakke (Arch Linux udgav i 2002, .pkg.tar.zst-format, som bruges af pacman-pakkeadministratoren. Kernen i Arch Linux rolling release-distributioner, kendt for sin enkelhed og KISS-princippet, AUR (Arch User Repository) er dets kendetegn)"

msgid "mime_exe"
msgstr "EXE-eksekverbar fil (Windows-eksekverbart programformat, forkortelse for 'Executable'. Oprindeligt eksekverbart format for Windows-operativsystemet, indeholder PE-strukturen. Udviklet fra MZ-formatet fra MS-DOS-æraen, Windows NT introducerede PE (Portable Executable)-formatet i 1993, som bruges den dag i dag. Softwareinstallationspakker, applikationer, systemværktøjer bruger dette format. Brugeren dobbeltklikker for at køre det, det mest udbredte eksekverbare format i verden)"

msgid "mime_dll"
msgstr "DLL-dynamisk linket bibliotek (Microsoft introducerede i 1993, Dynamic Link Library. Windows' delte kodebibliotek, programmet indlæses dynamisk under udførelse, sparer hukommelse og diskplads. Systemkomponenter, applikationsplugins, drivere bruger DLL-format. Den primære måde at implementere Windows API på, 'DLL Helvede'-problemet blev afhjulpet i .NET-æraen)"

msgid "mime_com"
msgstr "COM-eksekverbar fil (eksekverbart format fra MS-DOS-æraen, forkortelse for 'Command'. Meget simpel filstruktur, 64KB-begrænsning, primært format før Windows 3.x, forældet. Moderne Windows bruger EXE-format, COM-udvidelsen bruges stadig til nogle komponentfiler)"

msgid "mime_aac"
msgstr "AAC-lyd (MPEG-standard fra 1997, Advanced Audio Coding. Efterfølger til MP3, lydkvalitet bedre end MP3 ved samme bitrate, standard lydformat til YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC-lyd (Apple udviklede i 2004, Apple Lossless Audio Codec. Apples tabsfri format, open source i 2011, standard tabsfri format til iTunes og Apple Music)"

msgid "mime_flac"
msgstr "FLAC-lyd (Xiph.Org Foundation udviklede i 2001, Free Lossless Audio Codec. Tabsfri komprimering, lydkvalitet som CD, filstørrelse ca. halvdelen af original WAV. Open source og patentfri, foretrukket format for audiofile og digital musikindsamling)"

msgid "mime_mp3"
msgstr "MP3-lyd (Fraunhofer Institute udviklede i 1993, MPEG-1 Audio Layer 3. Tabsgivende kompressionsformat, lille fil med acceptabel lydkvalitet, det primære format for den digitale musikrevolution i 2000'erne, ansvarlig for iPod og Napster. Patenter udløb i 2017, blev offentligt domæneformat)"

msgid "mime_oga"
msgstr "Ogg Audio-lyd (udviklet af Xiph.Org Foundation, ren lydformat af Ogg-container, bruger Vorbis-kodning. Open source og patentfri, kompressions-effektivitet bedre end MP3, meget brugt i open source-projekter)"

msgid "mime_ogg"
msgstr "OGG-lyd (Xiph.Org Foundation udviklede i 2000, Ogg Vorbis-format. Open source og patentfri, kompressions-effektivitet bedre end MP3, tidlig Spotify brugte det, meget brugt til lydeffekter i spil)"

msgid "mime_opus"
msgstr "Opus-lyd (IETF standardiserede i 2012, åbent og patentfrit lydformat, kombinerer SILK- og CELT-teknologier, ekstrem lav latens, højeste kompressions-effektivitet, standard lydformat til WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV-lyd (Microsoft og IBM udviklede i 1991, Windows' oprindelige lydformat. PCM-kodning, ukomprimeret, tabsfri lydkvalitet, men filen er meget stor, standardformat til professionel lydredigering)"

msgid "mime_wma"
msgstr "WMA-lyd (Microsoft udviklede i 1999, Windows Media Audio. Har tabsgivende/tabsfri versioner, oprindeligt understøttet af Windows, spredte sig med Windows Media Player. Nu marginaliseret, erstattet af MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF-lyd (Direct Stream Digital-format, udviklet af Sony og Philips. 1-bit høj samplingsfrekvens, standard DSD-lydformat, digital version af SACD, high-end lydformat til audiofile, filen er meget stor)"

msgid "mime_ape"
msgstr "APE Lyd (udviklet af Monkey's Audio i 2000, tabsfri komprimeringsformat. Højere komprimering end FLAC men langsommere kodning, bruges stadig på Windows-platformen og blandt audio-entusiaster)"

msgid "mime_mid"
msgstr "MIDI-lyd (MIDI Association fastsatte i 1983, Musical Instrument Digital Interface. Nodeformat, ikke en optagelse, filen meget lille, standard for elektroniske musikinstrumenter, ringetoner til telefoner, lydeffekter i spil. General MIDI standardiseret i 1991, definerer 128 instrumenter)"

msgid "mime_m4a"
msgstr "M4A-lyd (MPEG-4 Audio, containerformat for AAC. Standardformat til iTunes-musikbutik, primært lydformat i Apple-økosystemet, understøtter DRM-beskyttelse)"

msgid "mime_m3u"
msgstr "M3U-spilleliste (MP3 URL-spillelisteformat, almindelig tekstfil, registrerer stier til lydfiler. Standard fra Winamp-æraen, bruges til internetradio, online musikstreaming. M3U8 er dens UTF-8-version, bruges til HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF-streaming (Microsoft udviklede i 1996, Advanced Systems Format. Windows Media-streamingcontainer, understøtter synkron transmission af lyd og video. Bruges til online live-udsendelser og video-on-demand-streaming, WMA/WMV er baseret på ASF-containeren)"

msgid "mime_avi"
msgstr "AVI-video (Microsoft udgav i 1992, tidlig Windows-videostandard. 'Audio Video Interleave', veksler lyd og video, var det mest populære videoformat i 1990-2000'erne, nu erstattet af MP4/MKV)"

msgid "mime_divx"
msgstr "DivX-video (DivX Corporation udviklede i 1998, video-kodekformat baseret på MPEG-4. Hovedformat til online videodeling i 2000'erne, den første teknologi, der komprimerede DVD-kvalitet til CD-størrelse. På grund af kontroverser om ophavsret blev det senere til en kommerciel koder)"

msgid "mime_mp4"
msgstr "MP4-video (MPEG-standard fra 2001, MPEG-4 Part 14. Det mest almindelige videoformat i verden, understøtter H.264/H.265-kodning, standardformat til internetvideo, optagelse med mobiltelefon, YouTube)"

msgid "mime_m4v"
msgstr "M4V-video (iTunes-videoformat, variant af MP4. Videoformat i Apple-økosystemet, standardformat til film og tv-programmer i iTunes Store, understøtter DRM-beskyttelse af ophavsret)"

msgid "mime_mpeg"
msgstr "MPEG-video (MPEG-organisationen fastsatte i 1988, Moving Picture Experts Group. Lagde grundlaget for standarder for komprimering af digital video, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (internetvideo) har haft dyb indflydelse)"

msgid "mime_mkv"
msgstr "MKV-video (Matroska-projektet udviklede i 2002, åben multimediecontainer. Understøtter flere lydspor, flere undertekster, kapitler, 'pakkeværktøj', foretrukket format til deling af film i høj opløsning)"

msgid "mime_mpg"
msgstr "MPEG-video (MPEG-1/MPEG-2-videoudvidelser, standardformat til VCD og DVD. Hovedformat for video på optiske diske i 1990-2000'erne, nu erstattet af H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video-video (udviklet af Xiph.Org Foundation, videoformat af Ogg-container, bruger Theora-kodning. Åben og patentfri, en af de tidlige standarder til HTML5-video, Firefox understøtter den oprindeligt)"

msgid "mime_ogx"
msgstr "Ogg-multimediecontainer (udviklet af Xiph.Org Foundation, generel udvidelse af Ogg-container, kan indeholde flere spor som lyd, video, undertekster. Åben multimediestandard, bruges til spil, streaming)"

msgid "mime_rm"
msgstr "RealMedia-video (RealNetworks udviklede i 1995, RealMedia-format. Pioner inden for internetstreaming i 1990-2000'erne, hovedformat for RealPlayer-afspilleren. Ulemper: kræver speciel afspiller, dårlig kompressionskvalitet, senere erstattet af Flash/MP4)"

msgid "mime_flv"
msgstr "Flash-video (formatet dukkede op i 2002, Flash Video-format. Var engang det primære online videoformat. Tidlig YouTube brugte det. Ulemper: behov for Flash-plugin, lav ydeevne, mange sikkerhedssårbarheder. Fra 2015 skiftede de største websider til HTML5-video, nu er det forældet)"

msgid "mime_f4v"
msgstr "F4V-video (Flash-videoformat udviklet af Adobe, efterfølger til FLV. Baseret på MPEG-4-standarden, understøtter H.264-kodning. Forældet sammen med Flash-teknologien, Adobe stoppede support i 2020)"

msgid "mime_wmv"
msgstr "WMV-video (Microsoft udviklede i 1999, Windows Media Video. Oprindeligt understøttet af Windows, optimeret til streaming, var et almindeligt format i tidlig online video, nu er det marginaliseret)"

msgid "mime_wmf"
msgstr "WMF-medieformat (Windows Media Format, Microsofts medieramme, inkluderer WMV-video, WMA-lyd, oprindeligt understøttet af Windows Media Player)"

msgid "mime_mov"
msgstr "MOV-video (Apple udviklede i 1991, QuickTime-containerformat. Standardformat til professionel videoredigering, understøtter flere kodeker, oprindeligt understøttet af Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime-video (Apple udgav i 1991, QuickTime-format. Videostandard på Mac-platformen, MOV er dens container, QuickTime-afspilleren var engang meget brugt. Apple stoppede udviklingen af Windows-versionen i 2016, erstatter den gradvist med MP4)"

msgid "mime_webm"
msgstr "WebM-video (Google udgav i 2010, åbent og patentfrit videoformat. Baseret på Matroska-containeren, VP8/VP9-kodning, standard HTML5-videoformat, standardformat til afspilning på YouTube på nettet)"

msgid "mime_3gp"
msgstr "3GP-video (3GPP fastsatte i 2000, videoformat til mobile enheder. Filen meget lille, lav kvalitet, format til videooptagelse på tidlige funktionstelefoner, brugtes til MMS-afsendelse)"

