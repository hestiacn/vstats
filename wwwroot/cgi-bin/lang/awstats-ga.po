#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Comhad téacs (caighdeánaithe ASCII i 1963, téacs simplí gan formáid. Bunús do gach cód foinse, cumraíocht agus loga. Úsáideann Unix LF, úsáideann Windows CRLF le haghaidh brislíne, fós an fhormáid sonraí is uilíche san ríomhaireacht)"

msgid "mime_log"
msgstr "Comhad loga (taifeadann sé faisnéis um fhorghníomhú córas agus feidhmchlár i dtéacs simplí, a úsáidtear le haghaidh dífhabhtaithe, anailíse feidhmíochta agus iniúchta slándála. Formáidí caighdeánacha mar Apache combined log, Nginx access log, syslog, srl.)"

msgid "mime_page"
msgstr "Leathanach HTML (cheap Tim Berners-Lee an Gréasán Domhanda i 1989, shainigh sé na trí theicneolaíocht HTML/HTTP/URL i 1990 agus chuir sé ar fáil iad saor in aisce gan phaitinn. Rinneadh HTML5 mar chaighdeán oifigiúil W3C i 2014, ag tacú le taispeáint, ilmheáin agus cló. Buateoir Ghradam Turing 2016)"

msgid "mime_khtml"
msgstr "Inneall leathanach gréasáin KHTML (seolta le KDE 2.0 i 1998, inneall rindreála an bhrabhsálaí Konqueror. I 2001, chruthaigh Apple WebKit bunaithe ar KHTML, agus i 2008 chruthaigh Google Blink ó WebKit, agus é mar chroílár na mbrabhsálaithe Chrome, Edge, Safari, srl. Is sampla é KHTML den phobal foinse oscailte a leag bunchlocha d'innill nua-aimseartha bhrabhsálaithe, agus leanann a oidhreacht theicniúil ar aghaidh trí WebKit/Blink)"

msgid "mime_script"
msgstr "Script dinimiciúil (teanga ateangaireachta, gan gá le tiomsú. Áirítear ASP, JSP, CGI, ColdFusion, Tcl, VBScript, srl., a úsáidtear go forleathan i bhforbairt gréasáin luath, riarachán córas agus tascanna uathoibrithe. Tá teangacha scripte nua-aimseartha ar nós Python, Ruby agus JavaScript tagtha chun cinn mar phríomhuirlisí forbartha iomlán an chruach)"

msgid "mime_js"
msgstr "Script JavaScript (chruthaigh Brendan Eich ag Netscape i 10 lá i 1995, teanga ríomhchlárúcháin dhúchasach an bhrabhsálaí. Caighdeánaithe mar ECMAScript i 1997, le breith Node.js i 2009 rinneadh teanga iomlán an chruach de, agus is é npm an bainisteoir pacáistí is mó ar domhan. Is í an teanga is mó a bhfuil tóir uirthi ar GitHub le roinnt blianta anuas)"

msgid "mime_py"
msgstr "Script Python (chruthaigh Guido van Rossum é i 1991, aitheanta as a eangú éigeantach agus a chomhréir bheacht. Úsáidtear go forleathan é i bhforbairt gréasáin, eolaíocht sonraí, intleacht shaorga agus uathoibriú oibríochtaí. Buaiteoir iolrach Theanga na Bliana TIOBE)"

msgid "mime_sh"
msgstr "Script Shell (a rugadh le Unix i 1971, teanga scriptithe ordaithe. Úsáidtear é le haghaidh riarachán córas, tascanna uathoibrithe, tosú seirbhísí agus scripteanna imscaradh. Inniúlacht riachtanach d'oibríochtaí Linux)"

msgid "mime_rb"
msgstr "Script Ruby (chruthaigh Yukihiro Matsumoto i 1995, díríonn sé ar shástacht an ríomhchláraitheora. Bhí creat Ruby on Rails ina cheannródaí ar pharadigm forbartha trí chomhaontú seachas cumraíocht, agus chuaigh sé i bhfeidhm go mór ar dhearadh chreatanna gréasáin nua-aimseartha)"

msgid "mime_pl"
msgstr "Script Perl (chruthaigh Larry Wall i 1987, aitheanta as a pragmatachas, ar a dtugtar 'Scian Arm na hEilvéise'. Bhí CPAN ina cheannródaí ar bhainisteoirí pacáistí teanga nua-aimseartha, le tionchar mór ar phróiseáil téacs, riarachán córas agus CGI)"

msgid "mime_php"
msgstr "Leathanach gréasáin PHP (chruthaigh Rasmus Lerdorf é i 1995, deartha go sonrach d'fhorbairt gréasáin. Úsáideann níos mó ná 70% de na láithreáin ghréasáin ar domhan PHP, ag tiomáint ardáin mar WordPress, Facebook agus Wikipedia. Thug PHP 8 isteach tiomsú JIT, ag feabhsú feidhmíochta go suntasach)"

msgid "mime_image"
msgstr "Comhad íomhá"

msgid "mime_document"
msgstr "Comhad doiciméid"

msgid "mime_package"
msgstr "Pacáiste bogearraí"

msgid "mime_archive"
msgstr "Comhad comhbhrúite Gzip (tionscadal GNU 1992, bunaithe ar algartam DEFLATE. Úsáidtear ar an ngréasán le haghaidh comhbhrú freagraí dinimiciúil, ag comhbhrú 60-90% de ghnáth. Tar éis 2015, cuireadh Brotli ina ionad go páirteach i gcásanna áirithe, ach fós is é an fhormáid chomhbhrú is mó a dtacaítear léi ar thaobh an fhreastalaí)"

msgid "mime_audio"
msgstr "Comhad fuaime"

msgid "mime_video"
msgstr "Comhad físe"

msgid "mime_jscript"
msgstr "JavaScript (d'fhorbair Brendan Eich i 1995)"

msgid "mime_json"
msgstr "Sonraí JSON (mhol Douglas Crockford i 2001, formáid idirmhalartaithe sonraí éadrom, caighdeán de facto le haghaidh APIanna gréasáin)"

msgid "mime_vbs"
msgstr "VBScript (d'fhorbair Microsoft i 1996, teanga scripte Windows, a úsáidtear i leathanaigh ghréasáin ASP agus scripteanna riaracháin Windows. Le tóiriú PowerShell agus JavaScript, tá sé ag dul i léig de réir a chéile)"

msgid "mime_conf"
msgstr "Comhad cumraíochta (stórálann sé cumraíochtaí bogearraí i bhformáid téacs, formáidí coitianta: INI, JSON, YAML, TOML, XML. Bíonn cumraíochtaí córas Linux sa chomhadlann /etc de ghnáth)"

msgid "mime_css"
msgstr "Bileog stíle CSS (D'fhoilsigh W3C an chéad chaighdeán oifigiúil CSS1 i mí na Nollag 1996, chuir CSS2 suíomh agus cineálacha meán leis i 1998, agus ó 2011 i leith thug modúlú CSS3 isteach cúinní cruinne, beochtaí, flexbox, leagan amach greille agus dearadh freagrúil. Mar aon le HTML agus JavaScript, is iad na trí phríomhtheicneolaíocht tosaigh iad, tacaithe go dúchasach ag gach brabhsálaí nua-aimseartha (Chrome, Firefox, Safari, Edge), agus is é an t-aon chaighdeán amháin é le haghaidh sainmhíniú stíle leathanach gréasáin)"

msgid "mime_xsl"
msgstr "Bileog stíle XSL (caighdeán W3C 1999, teanga chlaochlaithe doiciméad XML, is féidir XML a thiontú go HTML/PDF/téacs. Níos lú úsáide tar éis tóiriú JSON)"

msgid "mime_runtime"
msgstr "Comhad inrite (formáidí inrite an chórais oibriúcháin mar EXE, ELF, Mach-O, ina bhfuil cód meaisín agus faisnéis lódála)"

msgid "mime_library"
msgstr "Comhad leabharlainne (leabharlanna nascáil dhinimiciúil mar DLL, SO, dylib, cód roinnte a lódáiltear le linn fhorghníomhú an chláir)"

msgid "mime_swf"
msgstr "Beochan Flash (d'fhorbair Macromedia i 1996, a fuair Adobe níos déanaí. Caighdeán beochana gréasáin idirghníomhach, a bhí ceannasach ar an idirlíon i mbeochana agus i gcluichí. Fadhbanna: spleáchas ar bhreiseán, easpa tacaíochta ar ghléasanna soghluaiste, riosca ard slándála. D'fhógair Adobe deireadh tacaíochta i 2017, scor go hiomlán i 2020, agus cuireadh HTML5/CSS3/JS ina ionad)"

msgid "mime_dtd"
msgstr "DTD (Sainmhíniú Cineáil Doiciméid, sonraíocht XML a shainmhíníonn struchtúr doiciméad XML, a úsáidtear chun dlisteanacht XML a bhailíochtú)"

msgid "mime_csv"
msgstr "Formáid sonraí CSV (luachanna scartha le camóga, formáid uilíoch sonraí táblacha, caighdeán le haghaidh allmhairiú/easpórtáil in Excel agus bunachair shonraí)"

msgid "mime_jnlp"
msgstr "Java Web Start (seoltóir feidhmchlár Java, teicneolaíocht dáileacháin feidhmchlár deisce Java sna 2000í, anois as feidhm)"

msgid "mime_lit"
msgstr "Ríomhleabhar Microsoft Reader (formáid LIT a d'eisigh Microsoft i 2000, as feidhm)"

msgid "mime_svg"
msgstr "Grafaic veicteora SVG (caighdeán W3C 1999, moillithe mar gheall ar chur chun cinn formáid VML ag Microsoft, níor tacaíodh leis in Internet Explorer go dtí 2011. Tar éis 2015, le scor IE agus tóiriú scáileáin ardtaifigh, tháinig sé chun bheith ina fhormáid roghnaithe le haghaidh deilbhíní agus lógónna)"

msgid "mime_ai"
msgstr "Grafaic veicteora Adobe Illustrator (seolta i 1987, formáid veicteora chaighdeánach an tionscail, is fearr le haghaidh dearadh cló, lógónna agus deilbhíní)"

msgid "mime_phshop"
msgstr "Íomhá Photoshop (a d'eisigh Adobe i 1990, formáid PSD de chomhaid foinse Photoshop, caighdeán an tionscail um phróiseáil íomhánna)"

msgid "mime_ttf"
msgstr "Cló TrueType (d'fhorbair Apple agus Microsoft le chéile i 1989, formáid chló veicteora, comhsheasmhach idir taispeáint ar scáileán agus cló, formáid chló réamhshocraithe i gcórais oibriúcháin nua-aimseartha)"

msgid "mime_fon"
msgstr "Cló gréasáin WOFF2 (molta ag W3C i 2014, úsáideann algartam comhbhrú Brotli, laghdú thart ar 30% i gcomparáid le WOFF sean agus níos mó ná 50% i gcomparáid le TTF/OTF, tacaithe ag gach brabhsálaí nua-aimseartha faoi láthair, is é an fhormáid roghnaithe le haghaidh clónna gréasáin nua-aimseartha é, tacaithe ag níos mó ná 98% de na brabhsálaithe)"

msgid "mime_pdf"
msgstr "Doiciméad PDF (d'fhorbair Adobe i 1993, rinneadh caighdeán ISO de i 2008. Formáid doiciméid thar ardán a choinníonn comhsheasmhacht formáide, is é an caighdeán domhanda é do dháileadh doiciméad leictreonach)"

msgid "mime_dotnet"
msgstr "Leathanach dinimiciúil ASP.NET (a d'eisigh Microsoft i 2002, teicneolaíocht leathanach gréasáin dinimiciúil d'ardán Windows, cuid de .NET Framework)"

msgid "mime_mdb"
msgstr "Bunachar sonraí Access (comhad bunachar sonraí Microsoft Access, a eisíodh i 1992, réiteach bunachar sonraí deisce Windows)"

msgid "mime_md"
msgstr "Doiciméad Markdown (ceaptha ag John Gruber i 2004, faoi thionchar reStructuredText agus Setext. Fealsúnacht deartha lárnach: 'is inléite é a rindreáil', cur i bhfeidhm bunaidh Markdown.pl i Perl regex. Áirítear le sonraíochtaí díorthaithe GFM (2013), CommonMark (2017), Pandoc Markdown, srl. Cumhachtaíonn sé éiceachórais mar GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, agus é an fhormáid chaighdeánach do ghineadóirí láithreán statacha agus doiciméadú ríomhchláraitheoirí)"

msgid "mime_crystal"
msgstr "Formáid tuarascála Crystal Reports (tuarascálacha faisnéise gnó SAP, formáid chaighdeánach tuarascála fiontair)"

msgid "mime_libreoffice"
msgstr "Doiciméad LibreOffice (d'fhorbair The Document Foundation i 2010, brainse de OpenOffice, cur i bhfeidhm chaighdeán ODF, príomhshraith oifige foinse oscailte)"

msgid "mime_encrypt"
msgstr "Comhad criptithe (éilíonn díchriptiú le féachaint, síntí coitianta: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Sonraí traíochta GPS (formáid idirmhalartaithe GPS, taifeadann sé faisnéis shuíomh geografach, formáid uilíoch do uaireadóirí spóirt agus gléasanna nascleanúna)"

msgid "mime_diskimage"
msgstr "Íomhá diosca (comhaid íomhá diosca/mheán optúil mar DMG, ISO, IMG, a úsáidtear le haghaidh dáileadh bogearraí nó cúltaca meán stórála)"

msgid "mime_vm"
msgstr "Íomhá meaisín fíorúil (comhaid diosca meaisín fíorúil mar VMDK, VDI, VHDX, OVA, formáidí d'ardáin fhíorúlaithe VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "Comhad torrent BitTorrent (cumtha ag Bram Cohen i 2001, comhad innéacs aistrithe P2P, ina bhfuil meiteashonraí comhaid agus faisnéis Tracker)"

msgid "mime_gis"
msgstr "Sonraí córais faisnéise geografaí GIS (formáidí sonraí geo-spásúla mar Shapefile, GeoJSON, a úsáidtear le haghaidh léarscáileanna agus anailís spásúil)"

msgid "mime_ebook"
msgstr "Ríomhleabhar (formáidí ríomhleabhar mar EPUB, MOBI, AZW. Is caighdeán idirnáisiúnta é EPUB, is formáidí Kindle Amazon iad MOBI/AZW)"

msgid "mime_avif"
msgstr "Íomhá AVIF (a d'eisigh Open Media Alliance i 2019, bunaithe ar chódú AV1, ráta comhbhrú 50% níos airde ná WebP, caighdeán nua d'íomhánna gréasáin den chéad ghlúin eile)"

msgid "mime_markdown"
msgstr "Doiciméad Markdown (ceaptha ag John Gruber i 2004, teanga mharcála éadrom, formáid uilíoch do README GitHub, doiciméadú teicniúil, postálacha fóraim)"

msgid "mime_yaml"
msgstr "Cumraíocht YAML (ceaptha ag Clark Evans i 2001, formáid shrathaithe sonraí inléite ag an duine, caighdeán comhad cumraíochta do Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Cumraíocht TOML (ceaptha ag Tom Preston-Werner i 2013, 'Tom's Obvious Minimal Language', formáid comhad cumraíochta d'uirlisí nua-aimseartha mar Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Comhad comhpháirte Vue (a tugadh isteach in 2014 ag Evan You, creat forásach JavaScript. Trí chomhpháirteanna aonchomhaid (SFC), comhcheanglaíonn sé HTML, CSS, agus JS go foirfe, ag cur feabhas mór ar éifeachtúlacht forbartha. Tá sé ar cheann de na creataí tosaigh is mó tóir ar domhan. Chomh maith leis sin, mar chroí-ghineadóirí suíomhanna statacha nua-aimseartha cosúil le VitePress, úsáidtear go forleathan é chun doiciméadú teicniúil idirghníomhach agus blaganna a thiomáint.)"

msgid "mime_wasm"
msgstr "Modúl WebAssembly (caighdeán W3C 2017, formáid fhorghníomhaithe ardfheidhmíochta sa bhrabhsálaí, is féidir C/C++/Rust/R a thiomsú don sprioc seo, feidhmíocht gar don dúchas)"

msgid "mime_jsx"
msgstr "Comhpháirt React JSX (a d'eisigh Facebook i 2013, JavaScript XML, comhréir chomhpháirt an chreata React, paradigma nuálach a chomhtháthaíonn HTML i JavaScript)"

msgid "mime_tsx"
msgstr "Comhpháirt TypeScript TSX (d'fhorbair Microsoft i 2012, TypeScript + JSX, scríbhneoireacht chaighdeánach d'fhorbairt React le sábháilteacht chineáil)"

msgid "mime_heif"
msgstr "Íomhá HEIF (caighdeán MPEG 2015, formáid chomhaid íomhá éifeachtach, a úsáidtear go forleathan in éiceachóras Apple)"

msgid "mime_heic"
msgstr "Íomhá HEIC (cur i bhfeidhm HEIF ag Apple, formáid ghrianghraf réamhshocraithe iPhone, tacaithe go dúchasach ag iOS/macOS)"

msgid "mime_gltf"
msgstr "Samhail 3D GLTF (formáid iompair GL, 'JPEG an domhain 3D', a d'eisigh an Grúpa Khronos i 2015, formáid chaighdeánach don ngréasán 3D)"

msgid "mime_glb"
msgstr "Samhail 3D dhénártha GLB (leagan dénártha de GLTF, comhad aonair ina bhfuil gach acmhainn, a úsáidtear le haghaidh dáileadh radharc 3D)"

msgid "mime_gls"
msgstr "Gluaiseacht Téarmaí (comhad sainmhínithe téarmaí, a úsáidtear le haghaidh bainistíochta téarmaíochta i gcórais doiciméadaithe)"

msgid "mime_cbz"
msgstr "Coimic CBZ (íomhánna coimice comhbhrúite i ZIP, formáid uilíoch do bhailiúcháin coimicí)"

msgid "mime_cbr"
msgstr "Coimic CBR (íomhánna coimice comhbhrúite i RAR, formáid uilíoch do bhailiúcháin coimicí)"

msgid "mime_fb2"
msgstr "Ríomhleabhar FB2 (FictionBook 2.0, formáid ríomhleabhar Rúiseach, struchtúr XML, tacaithe go forleathan ag léitheoirí foinse oscailte)"

msgid "mime_kepub"
msgstr "Ríomhleabhar KEPUB (formáid Kobo eisiach do EPUB, formáid optamaithe do léitheoirí ríomhleabhar Kobo)"

msgid "mime_m4b"
msgstr "Closleabhar M4B (formáid fuaime MPEG-4 do leabhair, tacaíonn sé le leabharmharcanna, formáid chlosleabhar iTunes)"

msgid "mime_kfx"
msgstr "Formáid KFX Kindle (a d'eisigh Amazon i 2015, formáid ríomhleabhar eisiach Kindle, tacaíonn sé le formáidiú feabhsaithe agus le casadh tapa leathanach)"

msgid "mime_chm"
msgstr "Comhad cabhrach CHM (a d'eisigh Microsoft i 1997, formáid chabhrach HTML tiomsaithe, caighdeán doiciméadaithe cabhrach do bhogearraí Windows)"

msgid "mime_mht"
msgstr "Cartlann ghréasáin MHT (formáid leathanach gréasáin comhaid aonair a d'eisigh Microsoft i 1999, formáid shábhála leathanaigh Internet Explorer)"

msgid "mime_wml"
msgstr "Teanga mharcála WML (caighdeán WAP 1999, a úsáidtear le haghaidh comhad gréasáin ar sheanfhóin phóca, as feidhm)"

msgid "mime_xhtml"
msgstr "Leathanach gréasáin XHTML (caighdeán W3C 2000, leagan XML de HTML, comhréir níos déine. Chuir W3C stop le cothabháil i 2009, agus d'aistrigh an fócas go HTML5)"

msgid "mime_xml"
msgstr "Doiciméad XML (caighdeán W3C 1998, teanga mharcála insínte, formáid bhunúsach do sheirbhísí gréasáin, comhaid chumraíochta agus idirmhalartú sonraí)"

msgid "mime_sgml"
msgstr "Doiciméad SGML (caighdeán ISO 1986, réamhtheachtaí HTML, teanga mharcála ghinearálta chaighdeánaithe, díorthaítear XML agus HTML ó SGML)"

msgid "mime_apng"
msgstr "Beochan APNG (d'fhorbair Mozilla i 2004, síneadh beochana ar PNG, rogha eile nua-aimseartha ar GIF, tacaíonn sé le fíordhathanna agus trédhearcacht)"

msgid "mime_bmp"
msgstr "Íomhá BMP (formáid ghiotánmhapála Windows, tacaithe go dúchasach ó Windows 1.0. Gan chomhbhrú, comhaid níos mó, ach mar gheall ar struchtúr simplí agus easpa gá le cóidigh bhreise, úsáidtear fós é in Uirlis Gabhála Windows 11, Paint, acmhainní deilbhín in suiteálaithe EXE/MSI, cúrsóirí agus roinnt tiománaithe sean. Is ionann caighdeán comhionann agus comhad thart ar 3-10 n-uaire níos mó ná PNG, ionad PNG/JPEG air i bhformhór na gcásanna, ach coinníonn éiceachóras Windows comhoiriúnacht leathan fós)"

msgid "mime_cdr"
msgstr "Grafaic veicteora CDR (formáid eisiach CorelDRAW, cuideachta Corel Cheanada, bogearraí deartha grafaicí veicteora)"

msgid "mime_gif"
msgstr "Íomhá GIF (d'fhorbair CompuServe i 1987, formáid bheochana le 256 dath. Fadhbanna: beagán dathanna, cáilíocht íomhá lag, gan tacaíocht do thrédhearcacht, comhaid mhóra, ráta frámaí íseal. Tá formáidí beochana nua-aimseartha ar nós APNG agus WebP curtha ina ionad)"

msgid "mime_ico"
msgstr "Deilbhín ICO (formáid comhaid deilbhín Windows, tacaíonn sé le réitigh iolracha, formáid chaighdeánach le haghaidh favicon láithreán)"

msgid "mime_jpeg"
msgstr "Íomhá JPEG (caighdeán ISO 1992, formáid ghrianghraf le comhbhrú caillteanach, caighdeán de facto do ghrianghraif ar an idirlíon)"

msgid "mime_jpg"
msgstr "Íomhá JPEG (caighdeán ISO 1992, formáid ghrianghraf le comhbhrú caillteanach, caighdeán de facto do ghrianghraif ar an idirlíon)"

msgid "mime_png"
msgstr "Íomhá PNG (molta ag W3C i 1996, tacaíonn sé le fíordhathanna agus trédhearcacht, rogha eile statach ar GIF, caighdeán íomhánna gan chailliúint ar an idirlíon)"

msgid "mime_ps"
msgstr "Comhad tuairisceán leathanaigh PostScript (a d'eisigh Adobe i 1985, teanga tuairisceán leathanaigh, réamhtheachtaí PDF, a úsáidtear le haghaidh cló agus foilsitheoireachta)"

msgid "mime_psb"
msgstr "Doiciméad mór PSB (formáid íomhá de mhéid breise Adobe Photoshop, tacaíonn sé le híomhánna ollmhóra os cionn 2GB nó 30000 picteilín)"

msgid "mime_psd"
msgstr "Íomhá PSD (comhad foinse Adobe Photoshop, tacaíonn sé le sraitheanna, cainéil agus cosáin, formáid chaighdeánach an tionscail um phróiseáil íomhánna)"

msgid "mime_webp"
msgstr "Íomhá WebP (d'fhorbair Google i 2010, formáid íomhá gréasáin, tacaíonn sé le comhbhrú le/gan cailliúint agus beochan, ráta comhbhrú 25-35% níos airde ná PNG agus 25% níos airde ná JPEG)"

msgid "mime_woff"
msgstr "Cló gréasáin WOFF (cruthaíodh é i 2009, caighdeán W3C i 2018. Bunaithe ar chomhbhrú TrueType/OpenType, optamaithe le haghaidh lódáil clónna gréasáin, formáid chaighdeánach do chlónna deilbhín ar láithreáin nua-aimseartha)"

msgid "mime_7z"
msgstr "Pacáiste comhbhrúite 7z (d'fhorbair Igor Pavlov i 1999, formáid eisiach an chláir 7-Zip. Algartam LZMA, ardchóimheas comhbhrú, foinse oscailte agus saor in aisce. De ghnáth bíonn formáid 7z 30-50% níos lú ná ZIP don chóimheas comhbhrú céanna, agus is formáid choitianta é do dháileadh bogearraí sa phobal foinse oscailte)"

msgid "mime_ace"
msgstr "Pacáiste comhbhrúite ACE (d'fhorbair sé sna 90idí, formáid an chláir WinACE. Bhí sé in iomaíocht le RAR, le cóimheas comhbhrú réasúnta ard. Cuireadh stop le forbairt i 2007, cuireadh 7z/RAR ina ionad anois, beagán úsáide)"

msgid "mime_bz2"
msgstr "Pacáiste comhbhrúite BZIP2 (d'fhorbair Julian Seward i 1996, algartam comhbhrú trí shórtáil bhloc. Cóimheas comhbhrú 15-20% níos airde ná GZIP, ach níos moille. Formáid choitianta do chód foinse chroí Linux, pacáistí bogearraí foinse oscailte, síneadh .bz2)"

msgid "mime_cab"
msgstr "Pacáiste comhbhrúite CAB (d'fhorbair Microsoft i 1995, formáid Cabinet. Formáid phacáiste suiteála Windows, a úsáidtear le haghaidh dáileadh tiománaithe agus comhad córais. Úsáideann Suiteálaí Windows (MSI) úsáid inmheánach as CAB chun comhaid a stóráil)"

msgid "mime_dmg"
msgstr "Íomhá diosca DMG (a d'eisigh Apple sna 80idí, formáid Disk Image. Formáid chaighdeánach do dháileadh bogearraí macOS, gléasann sé mar dhiosca fíorúil nuair a chliceáiltear faoi dhó, tarraing chun an feidhmchlár a shuiteáil. Tacaíonn sé le comhbhrú agus criptiú, is é an phríomhfhormáid é do íoslódálacha bogearraí Mac)"

msgid "mime_emz"
msgstr "Íomhá chomhbhrúite EMZ (meitichomhad feabhsaithe comhbhrúite Windows, leagan comhbhrúite de EMF. Formáid stórála do ghrafaicí veicteora i ndoiciméid Office, go bunúsach comhad EMF comhbhrúite le GZIP)"

msgid "mime_gz"
msgstr "Pacáiste comhbhrúite GZIP (d'fhorbair Jean-loup Gailly agus Mark Adler i 1992, tionscadal GNU. Uirlis chomhbhrú chaighdeánach Unix/Linux, formáid choitianta do chomhbhrú aistrithe HTTP. Síneadh .gz, a úsáidtear go minic le TAR)"

msgid "mime_jar"
msgstr "Pacáiste comhbhrúite JAR (a d'eisigh Sun Microsystems i 1997, formáid Java ARchive. Go bunúsach pacáiste ZIP, a úsáidtear le haghaidh pacáistiú leabharlann agus feidhmchlár Java. Formáid lárnach d'éiceachóras Java mar Maven agus Gradle, a úsáideann Android freisin)"

msgid "mime_lzma"
msgstr "Pacáiste comhbhrúite LZMA (d'fhorbair Igor Pavlov i 1998, algartam Lempel-Ziv-Markov chain. Algartam comhbhrú lárnach formáid 7z, ardchóimheas comhbhrú, luas dí-chomhbhrú tapa. Úsáidtear é le haghaidh dáileadh bogearraí do fhirmware agus córais leabaithe)"

msgid "mime_rar"
msgstr "Pacáiste comhbhrúite RAR (d'fhorbair Eugene Roshal i 1993, formáid Roshal ARchive. Ardchóimheas comhbhrú, tacaíonn sé le himleabhair roinnte agus taifid aisghabhála. Formáid an chláir WinRAR, cóimheas comhbhrú níos airde ná ZIP, ach éilíonn sé bogearraí íoctha, is féidir le huirlisí foinse oscailte mar unrar dí-chomhbhrú)"

msgid "mime_tar"
msgstr "Cartlann TAR (a tugadh isteach in Unix V7 i 1979, formáid Tape ARchive. Formáid chartlainne téipe, ní dhéanann sé comhbhrú ach pacáistiú, a úsáidtear go minic le GZIP/BZIP2/XZ. Úsáideann cód foinse phacáistí bogearraí Linux agus stóráil sraitheanna íomhánna Docker formáid TAR)"

msgid "mime_tgz"
msgstr "Pacáiste comhbhrúite TGZ (formáid chomhcheangailte TAR + GZIP, síneadh .tgz nó .tar.gz. An fhormáid dháileacháin is uilíche do phacáistí Unix/Linux, a úsáidtear go forleathan do chód foinse agus pacáistí dénártha, ionadaí ar 'dí-chomhbhrú agus úsáid')"

msgid "mime_tbz2"
msgstr "Pacáiste comhbhrúite TBZ2 (formáid chomhcheangailte TAR + BZIP2, síneadh .tbz2 nó .tar.bz2. Cóimheas comhbhrú 15-20% níos airde ná TGZ, oiriúnach do dháileadh comhad mór, d'úsáid cód foinse chroí Linux an fhormáid seo ar feadh i bhfad)"

msgid "mime_xz"
msgstr "Pacáiste comhbhrúite XZ (a eisíodh i 2009, bunaithe ar algartam LZMA2. Cóimheas comhbhrú thar a bheith ard, 30-50% níos airde ná GZIP, luas dí-chomhbhrú réasúnta tapa. Úsáidtear go forleathan é ag croí Linux agus bainisteoirí pacáistí (mar .deb Debian go hinmheánach), is é an fhormáid mholta faoi láthair in éiceachóras Linux)"

msgid "mime_z"
msgstr "Pacáiste comhbhrúite Z (formáid an ordaithe compress Unix ó 1985, algartam LZW. Formáid chomhbhrú Unix sean, cuireadh GZIP ina ionad. Síneadh .Z, níos lú úsáide i gcórais nua-aimseartha)"

msgid "mime_zip"
msgstr "Pacáiste comhbhrúite ZIP (d'fhorbair Phil Katz i 1989, formáid PKZIP. Tacaithe go dúchasach ag Windows, an fhormáid chomhbhrú is uilíche ar an idirlíon. Tacaíonn sé le comhaid iolracha, struchtúr eolaire agus algartaim chomhbhrú roghnacha. Tá JAR Java, APK Android agus DOCX/XLSX doiciméad Office go léir bunaithe ar fhormáid ZIP)"

msgid "mime_zst"
msgstr "Pacáiste comhbhrúite Zstandard (d'fhorbair Facebook i 2015, le Yann Collet. Algartam comhbhrú ardluais, cóimheas comhbhrú gar do LZMA, luas i bhfad níos airde ná GZIP. Tacaithe ag croí Linux 5.9+, agus é á ghlacadh de réir a chéile ag Arch Linux pacman, Debian APT, is é an caighdeán nua comhbhrú don chéad ghlúin eile)"

msgid "mime_lz4"
msgstr "Pacáiste comhbhrúite LZ4 (d'fhorbair Yann Collet i 2011, algartam comhbhrú thar a bheith tapa. Luas comhbhrú níos mó ná 10 n-uaire níos airde ná GZIP, oiriúnach do chásanna comhbhrú fíor-ama. Úsáidtear go forleathan é i gcroí Linux, OpenZFS, Hadoop, is é an rogha is fearr do chásanna ina bhfuil tosaíocht ag luas)"

msgid "mime_lzo"
msgstr "Pacáiste comhbhrúite LZO (d'fhorbair Markus Oberhumer i 1996, algartam Lempel-Ziv-Oberhumer. Luas dí-chomhbhrú thar a bheith tapa, cóimheas comhbhrú meánach. Úsáideann Squashfs chroí Linux agus firmware OpenWrt LZO, oiriúnach do chórais leabaithe)"

msgid "mime_msi"
msgstr "Pacáiste suiteála MSI (a d'eisigh Microsoft i 1999, formáid Windows Installer. Formáid chaighdeánach suiteála d'fheidhmchláir Windows, tacaíonn sé le haisiompú idirbheart, bainistíocht comhpháirteanna agus suiteáil chiúin. Formáid is fearr do dháileadh bogearraí fiontair, is é an phríomhfhormáid é fós le haghaidh suiteáil bogearraí Windows)"

msgid "mime_pkg"
msgstr "Pacáiste suiteála PKG (formáid phacáiste suiteála feidhmchlár macOS, bunaithe ar theicneolaíocht Installer Apple. Formáid chaighdeánach do dháileadh bogearraí macOS, tacaíonn sé le roghnú comhpháirteanna, scripteanna suiteála agus feidhmiúlacht dhíshuiteála. Is féidir comhaid .pkg a shuiteáil le cliceáil faoi dhó, agus is foirm choitianta iad do dháileadh bogearraí lasmuigh den Mac App Store)"

msgid "mime_apk"
msgstr "Pacáiste feidhmchláir Android APK (a d'eisigh Google i 2008, formáid suiteála traidisiúnta d'fheidhmchláir Android. Is pacáiste ZIP go bunúsach é APK, ina bhfuil cód, acmhainní agus comhad an fhorais. Ó 2021 ar aghaidh, éilíonn Google Play go n-úsáidfeadh feidhmchláir nua formáid AAB, ach úsáidtear APK fós le haghaidh forbartha, dífhabhtaithe, siopaí tríú páirtí agus suiteáil thaobhach)"

msgid "mime_ipa"
msgstr "Pacáiste feidhmchláir Apple IPA (iOS App Store Package, formáid suiteála d'fheidhmchláir iOS/iPadOS. Eisithe le iOS SDK i 2008. Éilíonn dáileadh tríd an App Store nó síniú teastais fhiontair. Ina bhfuil inrite, acmhainní, Info.plist agus faisnéis shínithe)"

msgid "mime_hap"
msgstr "Pacáiste feidhmchláir HarmonyOS HAP (HarmonyOS Ability Package, aonad bunúsach feidhmchláir HarmonyOS. Eisithe le HarmonyOS 2.0 i 2020. Tacaíonn sé le cineálacha entry agus feature, formáid dháileacháin do ghutháin Huawei, taibléid, uaireadóirí cliste agus gléasanna eile HarmonyOS)"

msgid "mime_har"
msgstr "Pacáiste statach roinnte HarmonyOS HAR (HarmonyOS Archive, leabharlann statach roinnte HarmonyOS, is féidir é a roinnt le HAPanna iolracha, a úsáidtear le haghaidh forbairt bhunaithe ar chomhpháirteanna agus athúsáid modúl)"

msgid "mime_aab"
msgstr "Android App Bundle (a d'eisigh Google i 2018, ó 2021 ar aghaidh éilíonn Google Play go n-úsáidfeadh feidhmchláir nua an fhormáid seo. Is formáid dháileacháin é AAB, gineann Google Play APKanna optamaithe go dinimiciúil bunaithe ar chumraíocht an ghléis (ailtireacht LAP, dlús scáileáin, teanga), ag laghdú méid an phacáiste suiteála 35% ar an meán. Seolann forbróirí AAB, íoslódálann úsáideoirí APK)"

msgid "mime_xapk"
msgstr "Pacáiste feidhmchláir XAPK (pacáiste síneadh feidhmchláir Android tríú páirtí, ina bhfuil APK + comhaid sonraí OBB. Úsáidtear le haghaidh cluichí móra agus feidhmchláir chasta, réitíonn sé an teorainn 100MB APK. Coitianta i siopaí feidhmchlár tríú páirtí ar nós APKPure, APKMirror, ní formáid oifigiúil Google í)"

msgid "mime_appx"
msgstr "Pacáiste feidhmchláir Windows APPX (a d'eisigh Microsoft i 2012, formáid suiteála d'fheidhmchláir Windows 8/10/11. Tacaíonn sé le feidhmchláir UWP agus tiontú feidhmchlár deisce, dáilte tríd an Microsoft Store. I 2024, d'eisigh Microsoft MSIX mar fhormáid chomharbais, ag cur APPX in ionad de réir a chéile)"

msgid "mime_msix"
msgstr "Pacáiste feidhmchláir MSIX (a d'eisigh Microsoft i 2018, formáid nua phacáistiú Windows. Comhcheanglaíonn sé buntáistí APPX agus MSI, tacaíonn sé le gach cineál feidhmchlár Windows, is féidir é a dháileadh tríd an Microsoft Store nó suiteáil thaobhach, formáid mholta do Windows 11)"

msgid "mime_appimage"
msgstr "Pacáiste feidhmchláir AppImage (a eisíodh i 2004, formáid feidhmchláir Linux nach dteastaíonn suiteáil. 'Feidhmchlár amháin comhad amháin', ní gá é a shuiteáil, inrite go díreach, tacaíonn sé le formhór na ndáiltí Linux, foirm choitianta d'fhorbróirí chun bogearraí Linux a dháileadh)"

msgid "mime_flatpak"
msgstr "Pacáiste feidhmchláir Flatpak (a eisíodh i 2015, formáid feidhmchláir Linux i mbosca gainimh. Ritheann sé thar dháiltí éagsúla, iargúlta ó chóras an óstaigh, d'fhorbair Fedora agus Red Hat é, formáid réamhshocraithe ionad bogearraí GNOME)"

msgid "mime_snap"
msgstr "Pacáiste feidhmchláir Snap (a d'eisigh Canonical i 2014, máthairchuideachta Ubuntu, formáid feidhmchláir Linux uilíoch. Nuashonruithe uathoibríocha, iargúltacht i mbosca gainimh, tacaíonn sé le níos mó ná 40 dáileadh Linux, formáid réamhshocraithe ionad bogearraí Ubuntu)"

msgid "mime_deb"
msgstr "Pacáiste bogearraí Debian (a d'eisigh tionscadal Debian i 1993, formáid suiteála chaighdeánach do Debian/Ubuntu agus díorthaigh. Bainistithe le dpkg, is é APT a chomhéadan tosaigh bainisteoir pacáistí, ceann de na formáidí pacáiste is aibí in éiceachóras Linux, is é an phríomhfhormáid fós do theaghlach Debian)"

msgid "mime_rpm"
msgstr "Pacáiste bogearraí RPM (a d'eisigh Red Hat i 1997, formáid chaighdeánach do dháiltí Red Hat/Fedora/CentOS/SUSE. Ciallaíonn RPM 'Red Hat Package Manager', le DEB foirmíonn siad an dá fhormáid mhóra pacáiste Linux, is é an phríomhfhormáid fós do theaghlach RHEL)"

msgid "mime_pacman"
msgstr "Pacáiste bogearraí Arch (a d'eisigh Arch Linux i 2002, formáid .pkg.tar.zst a úsáideann an bainisteoir pacáistí pacman. Croílár na dáilte scaoilte rollta Arch Linux, aitheanta as a shimplíocht agus prionsabal KISS, is é AUR a shaintréith idirdhealaitheach)"

msgid "mime_exe"
msgstr "Comhad inrite EXE (formáid chláir inrite Windows, giorrúchán 'Executable'. Formáid fhorghníomhaithe dhúchasach chóras oibriúcháin Windows, ina bhfuil struchtúr PE. Tháinig sé chun cinn ó fhormáid MZ MS-DOS, agus thug Windows NT isteach formáid PE (Portable Executable) i 1993, fós in úsáid inniu. Úsáideann pacáistí suiteála bogearraí, feidhmchláir, uirlisí córais an fhormáid seo. Is féidir leis an úsáideoir rith le cliceáil faoi dhó, is í an fhormáid inrite is forleithne ar domhan í)"

msgid "mime_dll"
msgstr "Leabharlann nascáil dhinimiciúil DLL (a d'eisigh Microsoft i 1993, Dynamic Link Library. Cód roinnte Windows, a lódáiltear go dinimiciúil le linn fhorghníomhú an chláir, sábhálann sé cuimhne agus spás diosca. Úsáideann comhpháirteanna an chórais, breiseáin feidhmchlár, tiománaithe formáid DLL. Foirm lárnach chur i bhfeidhm API Windows, maolaíodh an fhadhb 'DLL Hell' le ré .NET)"

msgid "mime_com"
msgstr "Comhad inrite COM (formáid inrite ó ré MS-DOS, giorrúchán 'Command'. Struchtúr comhad simplí, teorainn 64KB, príomhfhormáid roimh Windows 3.x. As feidhm, úsáideann Windows nua-aimseartha formáid EXE, úsáidtear an síneadh COM fós le haghaidh comhaid chomhpháirteacha áirithe)"

msgid "mime_aac"
msgstr "Fuaim AAC (caighdeán MPEG 1997, Advanced Audio Coding. Comharba MP3, cáilíocht fuaime níos fearr ná MP3 leis an ráta giotán céanna, formáid fuaime réamhshocraithe do YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Fuaim ALAC (d'fhorbair Apple i 2004, Apple Lossless Audio Codec. Formáid gan chailliúint Apple, foinse oscailte ó 2011, formáid réamhshocraithe d'fhuaim gan chailliúint in iTunes agus Apple Music)"

msgid "mime_flac"
msgstr "Fuaim FLAC (d'fhorbair Fondúireacht Xiph.Org i 2001, Free Lossless Audio Codec. Comhbhrú gan chailliúint, cáilíocht fuaime comhionann le CD, comhad thart ar leath de WAV bunaidh. Foinse oscailte agus saor ó phaitinní, formáid is fearr le closphilí agus bailiúcháin ceoil dhigitigh)"

msgid "mime_mp3"
msgstr "Fuaim MP3 (d'fhorbair Institiúid Fraunhofer i 1993, MPEG-1 Audio Layer 3. Formáid chomhbhrúite le cailliúint, comhaid bheaga le cáilíocht inghlactha, foirm lárnach réabhlóid cheoil dhigitigh sna 2000í, á thiomáint ag iPod agus Napster. Chuaigh an phaitinn in éag i 2017, agus rinneadh formáid dhen chuid phoiblí de)"

msgid "mime_oga"
msgstr "Fuaim Ogg Audio (d'fhorbair Fondúireacht Xiph.Org, formáid fuaime íon d'umar Ogg, ag úsáid códú Vorbis. Foinse oscailte agus saor ó phaitinní, éifeachtúlacht chomhbhrú níos fearr ná MP3, a úsáidtear go forleathan i dtionscadail foinse oscailte)"

msgid "mime_ogg"
msgstr "Fuaim OGG (d'fhorbair Fondúireacht Xiph.Org i 2000, formáid Ogg Vorbis. Foinse oscailte agus saor ó phaitinní, éifeachtúlacht chomhbhrú níos fearr ná MP3, ghlac Spotify leis go luath, a úsáidtear go forleathan i bhfuaim cluichí)"

msgid "mime_opus"
msgstr "Fuaim Opus (caighdeán IETF 2012, formáid fuaime foinse oscailte agus saor ó phaitinní. Comhcheanglaíonn sé teicneolaíochtaí SILK agus CELT, latency thar a bheith íseal, an éifeachtúlacht chomhbhrú is airde, formáid fuaime chaighdeánach do WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Fuaim WAV (d'fhorbair Microsoft agus IBM i 1991, formáid fuaime dhúchasach Windows. Códú PCM gan chomhbhrú, cáilíocht fuaime gan chailliúint ach comhaid ollmhóra, formáid chaighdeánach d'eagarthóireacht fuaime ghairmiúil)"

msgid "mime_wma"
msgstr "Fuaim WMA (d'fhorbair Microsoft i 1999, Windows Media Audio. Leaganacha le/gan chailliúint, tacaithe go dúchasach ag Windows, a ndearnadh tóir air le Windows Media Player. Imillithe faoi láthair, cuireadh MP3/AAC ina ionad)"

msgid "mime_dsf"
msgstr "Fuaim DSF (formáid Direct Stream Digital, d'fhorbair Sony agus Philips. Sampláil 1 ghiotán d'ardráta, formáid chaighdeánach fuaime DSD, leagan digiteach de SACD, formáid fuaime ardcháilíochta do chlosphilí, comhaid ollmhóra)"

msgid "mime_ape"
msgstr "Fuaim APE (d'fhorbair Monkey's Audio in 2000, formáid chomhbhrúite gan chaillteanas. Comhbhrú níos airde ná FLAC ach ionchódú níos moille, fós in úsáid ar ardán Windows agus i measc díograiseoirí fuaime)"

msgid "mime_mid"
msgstr "Fuaim MIDI (caighdeán Chumann MIDI 1983, Musical Instrument Digital Interface. Formáid scóir seachas taifeadta, comhaid an-bheaga, caighdeán d'uirlisí leictreonacha, fuaimeanna fóin phóca, fuaime cluichí. Rinneadh General MIDI a chaighdeánú i 1991, ag sainmhíniú 128 timbre uirlisí)"

msgid "mime_m4a"
msgstr "Fuaim M4A (MPEG-4 Audio, formáid umar AAC. Formáid chaighdeánach iTunes Music Store, formáid fuaime phríomhúil éiceachóras Apple, tacaíonn sé le cosaint DRM)"

msgid "mime_m3u"
msgstr "Seinnliosta M3U (formáid sheinnliosta URL MP3, comhad téacs simplí, taifeadann sé cosáin chomhad fuaime. Caighdeán ré Winamp, a úsáidtear le haghaidh raidió ar an idirlíon, sruthú ceoil ar líne. Is é M3U8 a leagan UTF-8, a úsáidtear le haghaidh Sruthú Beo HTTP)"

msgid "mime_asf"
msgstr "Sruthú ASF (d'fhorbair Microsoft i 1996, Advanced Systems Format. Umar sruthú Windows Media, tacaíonn sé le tarchur comhuaineach fuaime agus físe. Úsáidtear le haghaidh craoladh beo ar an idirlíon agus físeán ar éileamh, tá WMA/WMV bunaithe ar umar ASF)"

msgid "mime_avi"
msgstr "Físeán AVI (a d'eisigh Microsoft i 1992, caighdeán físe luath Windows. 'Audio Video Interleave', stóráil idirleata fuaime agus físe, an fhormáid físe is mó tóir sna 1990-2000, anois cuireadh MP4/MKV ina ionad)"

msgid "mime_divx"
msgstr "Físeán DivX (d'fhorbair DivX Inc. i 1998, formáid chódaithe físe bunaithe ar MPEG-4. Príomhfhormáid roinnte físe ar an idirlíon sna 2000í, an chéad teicneolaíocht chun cáilíocht DVD a chomhbhrú go méid CD. Mar gheall ar chonspóidí cóipchirt, d'iompaigh sé ina chódóir tráchtála)"

msgid "mime_mp4"
msgstr "Físeán MP4 (caighdeán MPEG 2001, MPEG-4 Cuid 14. An fhormáid físe is uilíche ar domhan, tacaíonn sé le códú H.264/H.265, formáid chaighdeánach d'fhíseán ar an idirlíon, thaifeadadh ar fhón póca, YouTube)"

msgid "mime_m4v"
msgstr "Físeán M4V (formáid físe iTunes, malairt MP4. Formáid físe éiceachóras Apple, formáid chaighdeánach do scannáin agus cláir teilifíse ar an iTunes Store, tacaíonn sé le cosaint DRM cóipchirt)"

msgid "mime_mpeg"
msgstr "Físeán MPEG (caighdeán ghrúpa MPEG 1988, Moving Picture Experts Group. Bunaitheoir caighdeán comhbhrú físe digiteach, bhí tionchar mór ag MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (físeán ar an idirlíon))"

msgid "mime_mkv"
msgstr "Físeán MKV (d'fhorbair tionscadal Matroska i 2002, formáid umar ilmheáin foinse oscailte. Tacaíonn sé le rianta fuaime iolracha, fotheidil, caibidlí, 'déantóir iontas fillte', formáid is fearr le haghaidh roinnt scannán ardshainmhínithe)"

msgid "mime_mpg"
msgstr "Físeán MPEG (síneadh físe MPEG-1/MPEG-2, formáid chaighdeánach do VCD agus DVD. Príomhfhormáid físe ar dhiosca sna 1990-2000, anois cuireadh H.264/H.265 ina ionad)"

msgid "mime_ogv"
msgstr "Físeán Ogg Video (d'fhorbair Fondúireacht Xiph.Org, formáid físe d'umar Ogg, ag úsáid códú Theora. Foinse oscailte agus saor ó phaitinní, ceann de na chéad chaighdeáin físe HTML5, tacaithe go dúchasach ag Firefox)"

msgid "mime_ogx"
msgstr "Umar ilmheáin Ogg (d'fhorbair Fondúireacht Xiph.Org, síneadh ginearálta umar Ogg, is féidir leis rianta iolracha fuaime, físe, fotheidil a bheith ann. Caighdeán ilmheáin foinse oscailte, a úsáidtear i gcluichí agus sruthú)"

msgid "mime_rm"
msgstr "Físeán RealMedia (d'fhorbair RealNetworks i 1995, formáid RealMedia. Ceannródaí sruthú ar an idirlíon sna 1990-2000, formáid lárnach an tseinneora RealPlayer. Fadhbanna: gá le seinnteoir speisialaithe, cáilíocht chomhbhrú lag, cuireadh Flash/MP4 ina ionad)"

msgid "mime_flv"
msgstr "Físeán Flash (formáid 2002, Flash Video. Ba í an fhormáid cheannasach d'fhíseán ar an idirlíon, ghlac YouTube leis go luath. Fadhbanna: gá le breiseán Flash, feidhmíocht íseal, go leor leochaileachtaí slándála. Ó 2015, chuaigh mórláithreáin ar aghaidh go físeán HTML5, anois as feidhm)"

msgid "mime_f4v"
msgstr "Físeán F4V (formáid físe Flash a d'fhorbair Adobe, comharba FLV. Bunaithe ar chaighdeán MPEG-4, tacaíonn sé le códú H.264. Dífhostaithe le teicneolaíocht Flash, chuir Adobe stop le tacaíocht i 2020)"

msgid "mime_wmv"
msgstr "Físeán WMV (d'fhorbair Microsoft i 1999, Windows Media Video. Tacaithe go dúchasach ag Windows, optamaithe le haghaidh tarchur sruthú, formáid choitianta d'fhíseán ar líne sna blianta luatha, anois imillithe)"

msgid "mime_wmf"
msgstr "Formáid ilmheáin WMF (Windows Media Format, córas meán Microsoft. Áirítear físeán WMV, fuaim WMA, tacaithe go dúchasach ag Windows Media Player)"

msgid "mime_mov"
msgstr "Físeán MOV (d'fhorbair Apple i 1991, formáid umar QuickTime. Formáid chaighdeánach d'eagarthóireacht físe ghairmiúil, tacaíonn sé le cóidigh iolracha, tacaithe go dúchasach ag Final Cut Pro agus Premiere)"

msgid "mime_qt"
msgstr "Físeán QuickTime (a d'eisigh Apple i 1991, formáid QuickTime. Caighdeán físe d'ardán Mac, is é MOV a umar, bhí an seinnteoir QuickTime in úsáid go forleathan. Chuir Apple stop le forbairt do Windows i 2016, agus cuireadh MP4 ina ionad de réir a chéile)"

msgid "mime_webm"
msgstr "Físeán WebM (a d'eisigh Google i 2010, formáid físe foinse oscailte agus saor ó phaitinní. Bunaithe ar umar Matroska, códú VP8/VP9, formáid chaighdeánach físe HTML5, formáid athsheinm gréasáin chaighdeánach YouTube)"

msgid "mime_3gp"
