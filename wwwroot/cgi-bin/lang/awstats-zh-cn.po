#=============================================================================
# Main Content - 完整首页内容块
#=============================================================================
msgid "docs.home.content"
msgstr ""
"<div class='home-content'>"
""
"    <!-- ==================== Hero Section ==================== -->"
"    <div class='hero-section'>"
"        <div class='hero-content'>"
"            <h1 class='hero-title'>了解您的网站访客</h1>"
"            <p class='hero-description'>AWStats 是一个强大而免费的开源日志分析工具，将杂乱的服务器日志转化为清晰、直观的可视化报告，帮助您深入了解网站访客行为。</p>"
"            <div class='hero-stats'>已处理 <span class='stat-number'>数十亿</span> 条日志记录 | <span class='stat-number'>100+</span> 国家/地区 | <span class='stat-number'>20+</span> 年技术积累</div>"
"            <div class='hero-buttons'>"
"                <a href='awstats_setup.html' class='button button-primary'>快速开始</a>"
"                <a href='awstats_what1.html' class='button button-secondary'>查看演示</a>"
"            </div>"
"        </div>"
"        <div class='hero-image'>"
"            <img src='images/awstats_dashboard_preview.png' alt='AWStats 仪表盘预览' class='dashboard-preview'>"
"        </div>"
"    </div>"
""
"    <!-- ==================== Features Section ==================== -->"
"    <div class='features-section'>"
"        <h2 class='section-title'>为什么选择 AWStats？</h2>"
"        <p class='section-subtitle'>专业、可靠、易用——全球数百万网站的选择</p>"
""
"        <div class='features-grid'>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>📊</div>"
"                <h3>全面的统计报告</h3>"
"                <p>提供访客、页面、点击量、带宽、访问时长、来源网站、搜索引擎关键词等20+种详细报告，全方位了解网站运营状况。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>⚡</div>"
"                <h3>实时更新</h3>"
"                <p>支持命令行和浏览器两种更新方式，可集成到计划任务中，实现定时自动更新，随时查看最新统计数据。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>🌐</div>"
"                <h3>智能 DNS 解析</h3>"
"                <p>内置 DNS 缓存机制，支持静态缓存和动态解析，可将 IP 地址转换为主机名，让访客来源更清晰。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>🗺️</div>"
"                <h3>地理位置识别</h3>"
"                <p>自动启用 geoipfree 插件，无需额外配置即可识别访客所在国家/地区。支持 MaxMind GeoIP 数据库，提供更精确的地理位置信息。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>🧩</div>"
"                <h3>插件扩展</h3>"
"                <p>丰富的插件系统，支持工具提示、URL别名、用户信息、集群统计、图形图表等功能，可根据需要灵活扩展。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>📄</div>"
"                <h3>多格式支持</h3>"
"                <p>支持 Apache（common/combined）、IIS（W3C）、WebStar、Squid 等多种日志格式，以及 FTP、邮件、流媒体服务器日志。</p>"
"            </div>"
"            <div class='feature-card'>"
"                <div class='feature-icon'>🌍</div>"
"                <h3>多语言支持</h3>"
