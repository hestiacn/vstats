"            <a href='awstats_setup.html' class='button button-large button-secondary'>阅读文档</a>"
"        </div>"
"    </div>"
""
"    <!-- ==================== Footer ==================== -->"
"    <div class='home-footer'>"
"        <p>© 2000-2025 AWStats 团队 | 基于 GPL 许可证开源发布</p>"
