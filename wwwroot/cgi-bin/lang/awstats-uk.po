msgstr "  %s браузерів (%s з базою даних браузерів телефонів)"

msgid "  %s search engines (and keyphrases/keywords used from them)"
msgstr "  %s пошукових систем (і ключових фраз/слів, використаних з них)"

msgid "  All HTTP errors with last referrer"
msgstr "  Усі HTTP-помилки з останнім реферером"

msgid "  Report by day/month/year"
msgstr "  Звіт за день/місяць/рік"

msgid "  Dynamic or static HTML or XHTML reports, static PDF reports"
msgstr "  Динамічні або статичні HTML або XHTML звіти, статичні PDF-звіти"

msgid "  Indexed text or XML monthly database"
msgstr "  Індексована текстова або XML місячна база даних"

msgid "  And a lot of other advanced features and options..."
msgstr "  І багато інших розширених функцій та параметрів..."

