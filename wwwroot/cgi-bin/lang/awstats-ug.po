#------------------------------------------------------------------------------
# فورمات چۈشەندۈرۈشلىرى
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "تېكىست ھۆججىتى (1963-يىلى ASCII ئۆلچەملەشتۈرۈلگەن، فورماتسىز ساپ تېكىست. بارلىق باشلانغۇچ كودنىڭ، سەپلىمىنىڭ ۋە خاتىرىلەرنىڭ ئاساسى. Unix LF ئىشلىتىدۇ، Windows يېڭى قۇر ئۈچۈن CRLF ئىشلىتىدۇ، يەنىلا كومپيۇتېردىكى ئەڭ ئومۇمىي سانلىق مەلۇمات فورماتى)"

msgid "mime_log"
msgstr "خاتىرە ھۆججىتى (سىستېما ۋە پروگرامما مەشغۇلات ئۇچۇرلىرىنى خاتىرىلايدىغان ساپ تېكىست ھۆججىتى، كۆپىنچە خاتالىق تۈزىتىش، ئىپادىلەش ئانالىزى، بىخەتەرلىك تەكشۈرۈش ئۈچۈن ئىشلىتىلىدۇ. Apache combined log، Nginx access log، syslog قاتارلىق ئۆلچەملىك فورماتلار)"

msgid "mime_page"
msgstr "HTML تور بېتى (1989-يىلى تىم بېرنېرس-لىي WWW نى كەشىپ قىلدى، 1990-يىلى HTML/HTTP/URL ئۈچ چوڭ تېخنىكىنى بەلگىلىدى، پاتېنت تەلەپ قىلماي ھەقسىز ئېچىۋەتتى. 2014-يىلى HTML5 W3C نىڭ رەسمىي ئۆلچىمى بولدى، كۆرسىتىش، مولتىمېدىيا ۋە بېسىشنى قوللايدۇ. 2016-يىلى تۇرېڭ مۇكاپاتىغا ئېرىشتى)"

msgid "mime_khtml"
msgstr "KHTML تور بېتى ماتورى (1998-يىلى KDE 2.0 تارقىتىلدى، Konqueror كۆرۈش پروگراممىسىنىڭ رەتلەش ماتورى. 2001-يىلى Apple KHTML ئاساسىدا WebKit نى قۇردى، 2008-يىلى Google WebKit تىن Blink نى قۇردى، بۇ Chrome، Edge، Safari ۋە باشقا كۆرۈش پروگراممىلىرىنىڭ يادروسىغا ئايلاندى. KHTML ئوچۇق كود مەنبەسى جەمئىيىتىنىڭ زامانىۋى كۆرۈش پروگراممىسى ماتورلىرىغا ئاساس سالغانلىقىنىڭ بىر ئۈلگىسى، ئۇنىڭ تېخنىكىلىق مىراسى WebKit/Blink ئارقىلىق داۋاملاشماقتا)"

msgid "mime_script"
msgstr "دىنامىكىلىق پروگرامما كودى (شەرھىلەش تىلى، قۇراشتۇرۇشنى تەلەپ قىلمايدۇ. ASP، JSP، CGI، ColdFusion، Tcl، VBScript قاتارلىقلارنى ئۆز ئىچىگە ئالىدۇ، دەسلەپكى تور تەرەققىياتىدا، سىستېما باشقۇرۇشتا، ۋەزىپە ئاپتوماتلاشتۇرۇشتا كەڭ قوللىنىلىدۇ. Python، Ruby، JavaScript غا ئوخشاش زامانىۋى پروگرامما كودى تىللىرى تولۇق ئىشلەپچىقىرىش ئاساسلىق قورالىغا ئايلاندى)"

msgid "mime_js"
msgstr "JavaScript پروگرامما كودى (1995-يىلى برېندان ئېيچ Netscape تا 10 كۈندە ياراتقان، كۆرۈش پروگراممىسىنىڭ يەرلىك پروگرامما تىلى. 1997-يىلى ECMAScript ئۆلچەملەشتۈرۈلدى، 2009-يىلى Node.js پەيدا بولدى ۋە ئۇنى تولۇق ئىشلەپچىقىرىش تىلىغا ئايلاندۇردى، npm دۇنيادىكى ئەڭ چوڭ باغلىما باشقۇرغۇچى. كۆپ يىللار داۋاملىق GitHub تىكى ئەڭ ئالقىشقا ئېرىشكەن پروگرامما تىلى)"

msgid "mime_py"
msgstr "Python پروگرامما كودى (1991-يىلى گۇىدو ۋان روسسۇم تەرىپىدىن قۇرۇلغان، مەجبۇرىي چېكىنىش ۋە ئاددىي سىنتاكسىس بىلەن تونۇلغان. تور تەرەققىياتىدا، سانلىق مەلۇمات ئىلمىدە، سۈنئىي ئەقىلدە، ئاپتوماتلاشقان مەشغۇلاتتا كەڭ قوللىنىلىدۇ. TIOBE نىڭ يىل پروگرامما تىلى مۇكاپاتىنى كۆپ قېتىم قولغا كەلتۈرگەن)"

msgid "mime_sh"
msgstr "Shell پروگرامما كودى (1971-يىلى Unix پەيدا بولدى، بۇيرۇق پروگرامما كودى تىلى. سىستېما باشقۇرۇش، ۋەزىپىلەرنى ئاپتوماتلاشتۇرۇش، مۇلازىمەتلەرنى قوزغىتىش، ئورۇنلاشتۇرۇش پروگرامما كودلىرىدا ئىشلىتىلىدۇ. Linux باشقۇرغۇچىلىرى ئۈچۈن زۆرۈر ماھارەت)"

msgid "mime_rb"
msgstr "Ruby پروگرامما كودى (1995-يىلى يۇكىھىرو ماتسۇموتو تەرىپىدىن قۇرۇلغان، قۇرغۇچىلارنىڭ بەختىگە دىققەت قىلىدۇ. Ruby on Rails رامكىسى سەپلىمىدىن كۆرا ئەنئەنە تەرەققىيات پارادىگىمىسىنى ئاچتى، زامانىۋى تور رامكىلىرىنىڭ لايىھىلىنىشىگە تەسىر كۆرسەتتى)"

msgid "mime_pl"
msgstr "Perl پروگرامما كودى (1987-يىلى لاررى وال تەرىپىدىن قۇرۇلغان، پىراگماتىزىمى بىلەن تونۇلغان، «شۋېتسارىيە ئارمىيە پىچىقى» دەپ ئاتالغان. CPAN زامانىۋى تىل باغلىما باشقۇرغۇچىلىرىنىڭ ئەڭ دەسلەپكىسى بولۇپ، تېكىست بىر تەرەپ قىلىش، سىستېما باشقۇرۇش ۋە CGI ساھەسىدە چوڭقۇر تەسىرگە ئىگە)"

msgid "mime_php"
msgstr "PHP دىنامىكىلىق بېتى (1995-يىلى راسمۇس لېردورف تەرىپىدىن قۇرۇلغان، ئالاھىدە تور تەرەققىياتى ئۈچۈن لايىھەلەنگەن. دۇنيادىكى تور بېكەتلەرنىڭ %70 تىن كۆپرەكى ئۇنى ئىشلىتىدۇ، WordPress، Facebook، Wikipedia قاتارلىق سۇپىلارنى ھەرىكەتلەندۈرىدۇ. PHP 8 JIT قۇراشتۇرۇشنى يولغا قويدى، ئىپادىلەش ئۈنۈمىنى زور دەرىجىدە ياخشىلىدى)"

msgid "mime_image"
msgstr "رەسىم ھۆججىتى"

msgid "mime_document"
msgstr "پۈتۈك ھۆججىتى"

msgid "mime_package"
msgstr "يۇمشاق دېتال باغلىمىسى"

msgid "mime_archive"
msgstr "Gzip سىقىلغان ھۆججەت (1992-يىلى GNU تۈرى، DEFLATE ئالگورىتمىسىغا ئاساسلانغان. توردا ئىنكاس مەزمۇنىنى دىنامىكىلىق سىقىش ئۈچۈن ئىشلىتىلىدۇ، سىقىش نىسبىتى ئادەتتە %60-90. 2015-يىلدىن كېيىن بەزى سېنارىيلاردا Brotli بىلەن ئالماشتۇرۇلدى، ئەمما يەنىلا مۇلازىمېتىر تەرەپتە ئەڭ كەڭ قوللىنىدىغان سىقىش فورماتى)"

msgid "mime_audio"
msgstr "ئاۋاز ھۆججىتى"

msgid "mime_video"
msgstr "سىن ھۆججىتى"

msgid "mime_jscript"
msgstr "JavaScript (1995-يىلى برېندان ئېيچ تەرىپىدىن قۇرۇلغان)"

msgid "mime_json"
msgstr "JSON سانلىق مەلۇماتى (2001-يىلى دوگلاس كروكفورد تەرىپىدىن تەكلىپ قىلىنغان، يېنىك سانلىق مەلۇمات ئالماشتۇرۇش فورماتى، تور API لارنىڭ دې-فاكتو ئۆلچىمى)"

msgid "mime_vbs"
msgstr "VBScript (1996-يىلى Microsoft تەرىپىدىن قۇرۇلغان، Windows پروگرامما كودى تىلى، ASP بەتلىرى ۋە Windows باشقۇرۇش پروگرامما كودلىرى ئۈچۈن ئىشلىتىلىدۇ. PowerShell ۋە JavaScript نىڭ كەڭ تارقىلىشى بىلەن تەدرىجىي چىقىرىۋېتىلدى)"

msgid "mime_conf"
msgstr "سەپلىمە ھۆججىتى (يۇمشاق دېتال سەپلىمىسىنى ساقلاش ئۈچۈن تېكىست فورماتى، كۆپ ئۇچرايدىغان فورماتلار: INI، JSON، YAML، TOML، XML. Linux سىستېما سەپلىمىلىرى كۆپىنچە /etc قىسقۇچىدا بولىدۇ)"

msgid "mime_css"
msgstr "CSS ئۇسلۇب جەدۋىلى (1996-يىلى 12-ئايدا W3C CSS1 نى تۇنجى رەسمىي ئۆلچەم سۈپىتىدە تارقىتتى، 1998-يىلى CSS2 جايلاشتۇرۇش ۋە مېدىيا تۈرلىرىنى قوشتى، 2011-يىلىدىن باشلاپ CSS3 مودۇللۇق ھالدا تۇمىلاق بۇلۇڭلارنى، ئانىماتسىيەلەرنى، ئەگىلچان قۇتىلارنى، تور لايىھىسى ۋە ئىنكاس بېرىش لايىھىسىنى يولغا قويدى. HTML ۋە JavaScript بىلەن بىرلىكتە ئاساسىي ئۈچ چوڭ تېخنىكا، بارلىق زامانىۋى كۆرۈش پروگراممىلىرى (Chrome، Firefox، Safari، Edge) ئۇنى يەرلىك قوللايدۇ، تور ئۇسلۇبلىرىنى بەلگىلەشتىكى بىردىنبىر ئۆلچەم)"

msgid "mime_xsl"
msgstr "XSL ئۇسلۇب جەدۋىلى (1999-يىلى W3C ئۆلچىمى، XML پۈتۈكنى ئۆزگەرتىش تىلى، XML نى HTML/PDF/تېكىستكە ئايلاندۇرالايدۇ. JSON نىڭ كەڭ تارقىلىشىدىن كېيىن ئىشلىتىلىشى ئازايغان)"

msgid "mime_runtime"
msgstr "ئىجرا قىلغىلى بولىدىغان ھۆججەت (EXE، ELF، Mach-O قاتارلىق ئېپېراتسىيە سىستېمىسىنىڭ ئىجرا قىلغىلى بولىدىغان فورماتلىرى، ماشىنا كودى ۋە يۈكلەش ئۇچۇرلىرىنى ئۆز ئىچىگە ئالىدۇ)"

msgid "mime_library"
msgstr "كۇتۇپخانا ھۆججىتى (DLL، SO، dylib ۋە باشقا دىنامىكىلىق باغلانغان كۇتۇپخانىلار، پروگرامما ئىجرا قىلىنىش جەريانىدا يۈكلىنىدىغان ئورتاق كود)"

msgid "mime_swf"
msgstr "Flash ئانىماتسىيىسى (1996-يىلى Macromedia تەرىپىدىن قۇرۇلغان، كېيىن Adobe غا ئۆتكەن. ئۆز-ئارا تەسىرلىشىش تور ئانىماتسىيە ئۆلچىمى، بىر ۋاقىتلاردا تور ئانىماتسىيە ۋە ئويۇنلىرىدا ھۆكۈمرانلىق قىلغان. ئاجىزلىقلىرى: قىستۇرمىغا تايىنىدۇ، يانفون تەرىپىدىن قوللانمايدۇ، يۇقىرى بىخەتەرلىك خەۋپى. 2017-يىلى Adobe تۈگىتىلىدىغانلىقىنى جاكارلىدى، 2020-يىلى تولۇق قوللاش توختىتىلدى، HTML5/CSS3/JS بىلەن ئالماشتۇرۇلدى)"

msgid "mime_dtd"
msgstr "DTD پۈتۈك تۈرى ئېنىقلىمىسى (XML ئېنىقلىمىسى، XML پۈتۈكنىڭ قۇرۇلمىسىنى بەلگىلەيدۇ، XML نىڭ قانۇنىيلىقىنى دەلىللەش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_csv"
msgstr "CSV سانلىق مەلۇمات فورماتى (ئۈتۈر بىلەن ئايرىلغان قىممەتلەر، جەدۋەل سانلىق مەلۇماتلىرى ئۈچۈن ئومۇمىي فورمات، Excel ۋە سانلىق مەلۇمات ئامبىرىنىڭ ئىمپورت/ئېكسپورت ئۆلچىمى)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java پروگراممىسىنى قوزغاتقۇچ، 2000-يىللاردىكى Java ئۈستەل پروگراممىسى تارقىتىش تېخنىكىسى، ھازىر تۈگىتىلگەن)"

msgid "mime_lit"
msgstr "Microsoft Reader ئېلىكتىرون كىتاب (2000-يىلى Microsoft تەرىپىدىن تارقىتىلغان، LIT فورماتى، تۈگىتىلگەن)"

msgid "mime_svg"
msgstr "SVG ۋېكتور رەسىمى (1999-يىلى W3C ئۆلچىمى، Microsoft ئۇزۇن ۋاقىت ئۆزىنىڭ VML فورماتىنى تەشۋىق قىلغانلىقتىن، IE كۆرۈش پروگراممىسى 2011-يىلغىچە قوللىمىدى، بۇ تارقىلىشىنى كېچىكتۈردى. 2015-يىلدىن كېيىن، IE نىڭ تۈگىتىلىشى ۋە HD ئېكرانلارنىڭ كېڭىيىشى بىلەن بىرلىكتە، بەلگە ۋە لوگولار ئۈچۈن تاللىنىدىغان فورماتقا ئايلاندى)"

msgid "mime_ai"
msgstr "Adobe Illustrator ۋېكتور رەسىمى (1987-يىلى تارقىتىلغان، كەسپىي ئۆلچەملىك ۋېكتور رەسىم فورماتى، بېسىش لايىھىسى، لوگو ۋە بەلگىلەر ئۈچۈن تاللىنىدىغان)"

msgid "mime_phshop"
msgstr "Photoshop رەسىمى (1990-يىلى Adobe تەرىپىدىن تارقىتىلغان، Photoshop مەنبە ھۆججەت فورماتى PSD، رەسىم بىر تەرەپ قىلىش كەسپىي ئۆلچىمى)"

msgid "mime_ttf"
msgstr "TrueType خەت نۇسخىسى (1989-يىلى Apple ۋە Microsoft بىرلىكتە قۇرغان، ۋېكتور خەت نۇسخىسى فورماتى، ئېكران كۆرسىتىشى ۋە بېسىش ئوخشاش، زامانىۋى ئېپېراتسىيە سىستېمىلىرىنىڭ سۈكۈتتىكى خەت نۇسخىسى فورماتى)"

msgid "mime_fon"
msgstr "WOFF2 تور خەت نۇسخىسى (2014-يىلى W3C تەۋسىيەسى، Brotli سىقىش ئالگورىتمىسىنى ئىشلىتىدۇ، كونا WOFF بىلەن سېلىشتۇرغاندا كۆلىمى تەخمىنەن %30 ئازىيىدۇ، TTF/OTF بىلەن سېلىشتۇرغاندا %50 تىن ئارتۇق ئازىيىدۇ، ھازىر بارلىق زامانىۋى كۆرۈش پروگراممىلىرى قوللايدۇ، ھازىرقى زامان تور خەت نۇسخىلىرى ئۈچۈن تاللىنىدىغان فورمات، كۆرۈش پروگراممىلىرىنىڭ %98 تىن كۆپرەكى تەرىپىدىن قوللىنىدىغان)"

msgid "mime_pdf"
msgstr "PDF پۈتۈك (1993-يىلى Adobe تەرىپىدىن قۇرۇلغان، 2008-يىلى ISO خەلقئارا ئۆلچىمىگە ئايلاندى. سۇپا مۇستەقىل پۈتۈك فورماتى، فورمات ئىزچىللىقىنى ساقلايدۇ، ئېلىكتىرونلۇق پۈتۈك تارقىتىشنىڭ دۇنياۋى ئۆلچىمى)"

msgid "mime_dotnet"
msgstr "ASP.NET دىنامىكىلىق بېتى (2002-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Windows سۇپىسى ئۈچۈن دىنامىكىلىق تور تېخنىكىسى، .NET Framework نىڭ بىر قىسمى)"

msgid "mime_mdb"
msgstr "Access سانلىق مەلۇمات ئامبىرى (Microsoft Access سانلىق مەلۇمات ئامبىرى ھۆججىتى، 1992-يىلى تارقىتىلغان، Windows ئۈستەل سانلىق مەلۇمات ئامبىرى ھەل قىلىش چارىسى)"

msgid "mime_md"
msgstr "Markdown پۈتۈك (2004-يىلى John Gruber تەرىپىدىن قۇرۇلغان، سىنتاكسىس لايىھىسى reStructuredText ۋە Setext تەسىرىدە قالغان. ئاساسىي لايىھە پەلسەپىسى «ئوقۇغۇدەكلىكى كۆرسىتىش»، ئەسلى قوللىنىشچان پروگراممىسى Markdown.pl Perl تىلىدا يېزىلغان ۋە مۇنتىزىم ئىپادىلەرگە ئاساسلانغان تېكىست ئۆزگەرتىشنى يولغا قويغان. تارقالغان ئېنىقلىمىلار GFM (2013)، CommonMark (2017)، Pandoc Markdown قاتارلىقلارنى ئۆز ئىچىگە ئالىدۇ. GitHub، GitLab، Stack Overflow، Jupyter Notebook، Obsidian، Hugo، VitePress قاتارلىق ئېكوسىستېمىلارنى ھەرىكەتلەندۈرىدۇ، سىتاتىك تور بەت قۇرغۇچىلىرى ۋە قۇرغۇچى پۈتۈكلىرىنىڭ دې-فاكتو ئۆلچەملىك فورماتىغا ئايلانغان)"

msgid "mime_crystal"
msgstr "Crystal Reports دوكلات فورماتى (SAP سودا ئەقلىي دوكلاتى، كارخانا دوكلات ئۆلچەملىك فورماتى)"

msgid "mime_libreoffice"
msgstr "LibreOffice پۈتۈك (2010-يىلى The Document Foundation تەرىپىدىن قۇرۇلغان، OpenOffice تارمىقى، ODF ئۆلچەم قوللىنىشچان پروگراممىسى، ئاساسلىق ئوچۇق كود مەنبەلىك ئىشخانا باغلىمىسى)"

msgid "mime_encrypt"
msgstr "شىفىرلانغان ھۆججەت (كۆرۈش ئۈچۈن شىفىرىنى يېشىش كېرەك بولىدىغان ھۆججەت، كۆپ ئۇچرايدىغان كېڭەيتىلمىلەر: .enc، .crypt، .pgp، .gpg)"

msgid "mime_gpx"
msgstr "GPS ئىز سانلىق مەلۇماتى (GPS ئالماشتۇرۇش فورماتى، جۇغراپىيەلىك ئورۇن ئۇچۇرلىرىنى خاتىرىلايدۇ، تەنتەربىيە سائىتى ۋە يۆل كۆرسىتىش ئۈسكۈنىلىرى ئۈچۈن ئومۇمىي فورمات)"

msgid "mime_diskimage"
msgstr "دىسكا تەسۋىرى (DMG، ISO، IMG قاتارلىق ئوپتىكىلىق دىسكا/دىسكا تەسۋىر ھۆججەتلىرى، يۇمشاق دېتال تارقىتىش ياكى ساقلاش ۋاسىتىسىنى زاپاسلاش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_vm"
msgstr "ۋىرتىۇال ماشىنا تەسۋىرى (VMDK، VDI، VHDX، OVA قاتارلىق ۋىرتىۇال دىسكا ھۆججەتلىرى، VMware، VirtualBox، Hyper-V قاتارلىق ۋىرتىۇاللاشتۇرۇش سۇپىلىرىنىڭ فورماتلىرى)"

msgid "mime_torrent"
msgstr "BitTorrent ئۇرۇق ھۆججىتى (2001-يىلى Bram Cohen تەرىپىدىن كەشىپ قىلىنغان، P2P چۈشۈرۈش كۆرسەتكۈچ ھۆججىتى، ھۆججەت مېتا سانلىق مەلۇماتى ۋە Tracker ئۇچۇرلىرىنى ئۆز ئىچىگە ئالىدۇ)"

msgid "mime_gis"
msgstr "GIS جۇغراپىيەلىك ئۇچۇر سىستېمىسى سانلىق مەلۇماتى (Shapefile، GeoJSON ۋە باشقا گېئو فەزالىق سانلىق مەلۇمات فورماتلىرى، خەرىتە ۋە فەزا ئانالىزى ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_ebook"
msgstr "ئېلىكتىرونلۇق كىتاب (EPUB، MOBI، AZW ۋە باشقا ئېلىكتىرونلۇق كىتاب فورماتلىرى. EPUB خەلقئارا ئۆلچەم، MOBI/AZW Amazon Kindle فورماتى)"

msgid "mime_avif"
msgstr "AVIF رەسىمى (2019-يىلى ئوچۇق مېدىيا ئىتتىپاقى تەرىپىدىن تارقىتىلغان، AV1 كودلاشقا ئاساسلانغان، سىقىش نىسبىتى WebP دىن %50 ياخشى، يېڭى ئەۋلاد تور رەسىم ئۆلچىمى)"

msgid "mime_markdown"
msgstr "Markdown پۈتۈك (2004-يىلى John Gruber تەرىپىدىن لايىھەلەنگەن، يېنىك بەلگىلەش تىلى، GitHub README، تېخنىكا پۈتۈكلىرى، فورۇم يازمىلىرى ئۈچۈن ئومۇمىي فورمات)"

msgid "mime_yaml"
msgstr "YAML سەپلىمىسى (2001-يىلى Clark Evans تەرىپىدىن لايىھەلەنگەن، ئىنسان ئوقۇيالايدىغان سانلىق مەلۇمات سېرىياللاشتۇرۇش فورماتى، Kubernetes، Ansible، Docker Compose سەپلىمە ھۆججەتلىرىنىڭ ئۆلچەملىك فورماتى)"

msgid "mime_toml"
msgstr "TOML سەپلىمىسى (2013-يىلى Tom Preston-Werner تەرىپىدىن لايىھەلەنگەن، «Tom's Obvious Minimal Language»، Rust/Cargo، Python/pip، Go قاتارلىق زامانىۋى قوراللارنىڭ سەپلىمە ھۆججەت فورماتى)"

msgid "mime_vue"
msgstr "Vue قۇرۇلما ھۆججىتى (2014-يىلى Evan You تەرىپىدىن تونۇشتۇرۇلغان، progressep JavaScript رامكىسى. بىر ھۆججەتلىك قۇرۇلمىلار (SFC) ئارقىلىق HTML، CSS ۋە JS نى مۇكەممەل بىرلەشتۈرۈپ، تەرەققىي قىلدۇرۇش ئۈنۈمىنى زور دەرىجىدە ئۆستۈرىدۇ. بۇ دۇنيادىكى ئەڭ ئاممىباب frontend رامكىلارنىڭ بىرىدۇر. يەنە VitePress غا ئوخشاش زامانىۋى ستاتىك تور بەت قۇرغۇچىلارنىڭ يادروسى سۈپىتىدە، ئىنتېراكتىپ تېخنىكىلىق ھۆججەت ۋە بىلوگلارنى ھەرىكەتلەندۈرۈش ئۈچۈن كەڭ قوللىنىلىدۇ.)"

msgid "mime_wasm"
msgstr "WebAssembly مودۇلى (2017-يىلى W3C ئۆلچىمى، كۆرۈش پروگراممىسىدا يۇقىرى ئىپادىلىك ئىجرا فورماتى، C/C++/Rust/R نىشانغا قۇراشتۇرغىلى بولىدۇ، ئىپادىلىكى يەرلىككە يېقىن)"

msgid "mime_jsx"
msgstr "React JSX قىسمى (2013-يىلى Facebook JavaScript XML نى تونۇشتۇردى، React رامكىسىنىڭ قىسىم سىنتاكسىسى، HTML نى JavaScript نىڭ ئىچىدە يېزىشنىڭ يېڭىلىق يارىتىش پارادىگىمىسى)"

msgid "mime_tsx"
msgstr "TypeScript TSX قىسمى (2012-يىلى Microsoft تەرىپىدىن قۇرۇلغان، TypeScript + JSX، React تىپلىق بىخەتەرلىك تەرەققىياتىنىڭ ئۆلچەملىك يېزىلىش ئۇسۇلى)"

msgid "mime_heif"
msgstr "HEIF رەسىمى (2015-يىلى MPEG ئۆلچىمى، ئۈنۈملۈك رەسىم ھۆججەت فورماتى، Apple ئېكوسىستېمىسىدا كەڭ قوللىنىلىدۇ)"

msgid "mime_heic"
msgstr "HEIC رەسىمى (Apple نىڭ HEIF قوللىنىشچان پروگراممىسى، iPhone نىڭ سۈكۈتتىكى رەسىم فورماتى، iOS/macOS تەرىپىدىن يەرلىك قوللىنىلىدۇ)"

msgid "mime_gltf"
msgstr "GLTF 3D مودېلى (GL يەتكۈزۈش فورماتى، «3D دۇنياسىنىڭ JPEG ئى»، 2015-يىلى Khronos Group تەرىپىدىن تارقىتىلغان، تور 3D نىڭ ئۆلچەملىك فورماتى)"

msgid "mime_glb"
msgstr "GLB ئىككىلىك 3D مودېلى (GLTF نىڭ ئىككىلىك نۇسخىسى، بىر ھۆججەت بارلىق بايلىقلارنى ئۆز ئىچىگە ئالىدۇ، 3D ساخنىلىرىنى تارقىتىش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_gls"
msgstr "GLOSSARY ئاتالغۇ لۇغىتى (ئاتالغۇ ئېنىقلىمىسى ھۆججىتى، پۈتۈك سىستېمىلىرىدا ئاتالغۇ باشقۇرۇش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_cbz"
msgstr "CBZ كۆركۈم رەسىم كىتابى (ZIP سىقىلغان كۆركۈم رەسىملىرى، كۆركۈم رەسىم توپلاملىرى ئۈچۈن ئومۇمىي فورمات)"

msgid "mime_cbr"
msgstr "CBR كۆركۈم رەسىم كىتابى (RAR سىقىلغان كۆركۈم رەسىملىرى، كۆركۈم رەسىم توپلاملىرى ئۈچۈن ئومۇمىي فورمات)"

msgid "mime_fb2"
msgstr "FB2 ئېلىكتىرونلۇق كىتاب (FictionBook 2.0، رۇسىيە ئېلىكتىرونلۇق كىتاب فورماتى، XML قۇرۇلمىسى، ئوچۇق كود مەنبەلىك ئوقۇغۇچىلار تەرىپىدىن كەڭ قوللىنىلىدۇ)"

msgid "mime_kepub"
msgstr "KEPUB ئېلىكتىرونلۇق كىتاب (Kobo غا خاس EPUB فورماتى، Kobo ئېلىكتىرونلۇق كىتاب ئوقۇغۇچىلىرى ئۈچۈن ئوپتىماللاشتۇرۇلغان فورمات)"

msgid "mime_m4b"
msgstr "M4B ئاۋازلىق كىتاب (MPEG-4 ئاۋازلىق كىتاب فورماتى، بەتكۈچنى قوللايدۇ، iTunes ئاۋازلىق كىتاب فورماتى)"

msgid "mime_kfx"
msgstr "Kindle KFX فورماتى (2015-يىلى Amazon تەرىپىدىن تارقىتىلغان، Kindle ئېلىكتىرونلۇق كىتابلىرى ئۈچۈن ئالاھىدە فورمات، ياخشىلانغان تىپوگرافىيە ۋە تېز بەت ئايلاندۇرۇشنى قوللايدۇ)"

msgid "mime_chm"
msgstr "CHM ياردەم ھۆججىتى (1997-يىلى Microsoft تەرىپىدىن تارقىتىلغان، قۇراشتۇرۇلغان HTML ياردەم فورماتى، Windows يۇمشاق دېتال ياردەم پۈتۈكلىرى ئۈچۈن ئۆلچەم)"

msgid "mime_mht"
msgstr "MHT تور ئارخىپى (1999-يىلى Microsoft تەرىپىدىن تارقىتىلغان، بىر ھۆججەتلىك تور فورماتى، IE كۆرۈش پروگراممىسىنىڭ تور بېتىنى ساقلاش فورماتى)"

msgid "mime_wml"
msgstr "WML سىمسىز بەلگىلەش تىلى (1999-يىلى WAP ئۆلچىمى، دەسلەپكى ئىقتىدارلىق تېلېفونلارنىڭ تور بەت ھۆججەتلىرى ئۈچۈن ئىشلىتىلىدۇ، تۈگىتىلگەن)"

msgid "mime_xhtml"
msgstr "XHTML تور بېتى (2000-يىلى W3C ئۆلچىمى، HTML نىڭ XML نۇسخىسى، سىنتاكسىسى تېخىمۇ قاتتىق. 2009-يىلى W3C ئاسراشنى توختاتتى، دىققەت HTML5 گە يۆتكەلدى)"

msgid "mime_xml"
msgstr "XML پۈتۈك (1998-يىلى W3C ئۆلچىمى، كېڭەيتىشكە بولىدىغان بەلگىلەش تىلى، تور مۇلازىمەتلىرى، سەپلىمە ھۆججەتلىرى، سانلىق مەلۇمات ئالماشتۇرۇش ئۈچۈن ئاساسىي فورمات)"

msgid "mime_sgml"
msgstr "SGML پۈتۈك (1986-يىلى ISO ئۆلچىمى، HTML نىڭ ئالدىنقى ئەۋلادى، ئۆلچەملىك ئومۇمىي بەلگىلەش تىلى، XML ۋە HTML ھەر ئىككىلىسى SGML دىن كەلگەن)"

msgid "mime_apng"
msgstr "APNG ئانىماتسىيىسى (2004-يىلى Mozilla تەرىپىدىن قۇرۇلغان، PNG نىڭ ئانىماتسىيە كېڭەيتىلمىسى، GIF نىڭ زامانىۋى ئالماشتۇرمىسى، ھەقىقىي رەڭ ۋە سۈزۈكۈلۈكنى قوللايدۇ)"

msgid "mime_bmp"
msgstr "BMP نۇقتىلىق رەسىم (Windows نۇقتىلىق رەسىم فورماتى، Windows 1.0 دىن باشلاپ يەرلىك قوللىنىدۇ. سىقىلمىغان، ھۆججەت چوڭلۇقى چوڭ، ئەمما قۇرۇلمىسى ئاددىي ۋە قوشۇمچە كودېكلارغا ئېھتىياجى يوق بولغانلىقتىن، Windows 11 دىكى كېسىش قورالى، Paint پروگراممىسى، EXE/MSI قاچىلاش باغلىمىلىرىدىكى بەلگە بايلىقلىرى، كۆرسەتكۈچ ھۆججەتلىرى ۋە بەزى كونا يەتكۈزگۈچىلەردە يەنىلا ئىشلىتىلىۋاتىدۇ. ئوخشاش رەسىم سۈپىتىدە، ھۆججەت چوڭلۇقى PNG دىن تەخمىنەن 3-10 ھەسسە چوڭ. كۆپىنچە ئەھۋاللاردا PNG/JPEG بىلەن ئالماشتۇرۇلغان، ئەمما Windows ئېكوسىستېمىسى يەنىلا كەڭ ماسلىشىشچانلىقنى ساقلايدۇ)"

msgid "mime_cdr"
msgstr "CDR ۋېكتور رەسىمى (CorelDRAW غا خاس فورمات، كانادا Corel شىركىتى، ۋېكتور رەسىم لايىھىلەش يۇمشاق دېتالى)"

msgid "mime_gif"
msgstr "GIF رەسىمى (1987-يىلى CompuServe تەرىپىدىن قۇرۇلغان، 256 رەڭلىك ئانىماتسىيەلىك رەسىم فورماتى. ئاجىزلىقلىرى: رەڭلەر ئاز، رەسىم سۈپىتى ناچار، سۈزۈكۈلۈكنى قوللىمايدۇ، ھۆججەت چوڭ، كادر چاستوتىسى تۆۋەن. APNG، WebP قاتارلىق زامانىۋى ئانىماتسىيەلىك رەسىم فورماتلىرى بىلەن ئالماشتۇرۇلغان)"

msgid "mime_ico"
msgstr "ICO بەلگىسى (Windows بەلگە ھۆججەت فورماتى، كۆپ ئېنىقلىقنى قوللايدۇ، تور بېكەت favicon ئۆلچەملىك فورماتى)"

msgid "mime_jpeg"
msgstr "JPEG رەسىمى (1992-يىلى ISO ئۆلچىمى، زىيانلىق سىقىش فوتو رەسىم فورماتى، توردىكى فوتو رەسىملەرنىڭ دې-فاكتو ئۆلچىمى)"

msgid "mime_jpg"
msgstr "JPEG رەسىمى (1992-يىلى ISO ئۆلچىمى، زىيانلىق سىقىش فوتو رەسىم فورماتى، توردىكى فوتو رەسىملەرنىڭ دې-فاكتو ئۆلچىمى)"

msgid "mime_png"
msgstr "PNG رەسىمى (1996-يىلى W3C تەۋسىيەسى، ھەقىقىي رەڭ ۋە سۈزۈكۈلۈكنى قوللايدۇ، GIF نىڭ سىتاتىك ئالماشتۇرمىسى، توردىكى زىيانسىز رەسىم ئۆلچىمى)"

msgid "mime_ps"
msgstr "PostScript بەت تەسۋىرلەش ھۆججىتى (1985-يىلى Adobe تەرىپىدىن تارقىتىلغان، بەت تەسۋىرلەش تىلى، PDF نىڭ ئالدىنقى ئەۋلادى، بېسىش ۋە نەشرىيات ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_psb"
msgstr "PSB چوڭ پۈتۈك (Adobe Photoshop چوڭ رەسىم فورماتى، 2GB تىن ئارتۇق ياكى 30000 پىكسېلدىن چوڭ رەسىملەرنى قوللايدۇ)"

msgid "mime_psd"
msgstr "PSD رەسىمى (Adobe Photoshop مەنبە ھۆججىتى، قەۋەتلەرنى، كاناللارنى، يوللارنى قوللايدۇ، رەسىم بىر تەرەپ قىلىش كەسپىي ئۆلچەملىك فورماتى)"

msgid "mime_webp"
msgstr "WebP رەسىمى (2010-يىلى Google تەرىپىدىن قۇرۇلغان، تور رەسىم فورماتى، زىيانلىق/زىيانسىز سىقىش ۋە ئانىماتسىيەنى قوللايدۇ، سىقىش نىسبىتى PNG دىن %25-35، JPEG دىن %25 ياخشى)"

msgid "mime_woff"
msgstr "WOFF تور خەت نۇسخىسى (2009-يىلى قۇرۇلغان، 2018-يىلى W3C ئۆلچىمى. TrueType/OpenType ئاساسىدا سىقىلىدۇ، تور خەت نۇسخىسى يۈكلەش ئوپتىماللاشتۇرۇش، زامانىۋى تور بېكەت بەلگە خەت نۇسخىلىرىنىڭ ئۆلچەملىك فورماتى)"

msgid "mime_7z"
msgstr "7z سىقىلغان باغلىما (1999-يىلى Igor Pavlov تەرىپىدىن قۇرۇلغان، 7-Zip پروگراممىسىنىڭ ئالاھىدە فورماتى. LZMA ئالگورىتمىسى، يۇقىرى سىقىش نىسبىتى، ئوچۇق كود مەنبەلىك ۋە ھەقسىز. 7z فورماتى ئوخشاش سىقىش نىسبىتىدە ئادەتتە ZIP تىن %30-50 كىچىك، ئوچۇق كود مەنبەسى جەمئىيىتى ۋە يۇمشاق دېتال تارقىتىشتا كۆپ ئىشلىتىلىدىغان فورمات)"

msgid "mime_ace"
msgstr "ACE سىقىلغان باغلىما (1990-يىللاردا قۇرۇلغان، WinACE پروگراممىسىنىڭ فورماتى. بىر ۋاقىتلاردا RAR بىلەن رىقابەتلەشكەن، سىقىش نىسبىتى نىسبەتەن يۇقىرى. 2007-يىلى تەرەققىيات توختىتىلغان، ھازىر 7z/RAR بىلەن ئالماشتۇرۇلغان، ئاز ئىشلىتىلىدۇ)"

msgid "mime_bz2"
msgstr "BZIP2 سىقىلغان باغلىما (1996-يىلى Julian Seward تەرىپىدىن قۇرۇلغان، بۆلەك تەرتىپلەش سىقىش ئالگورىتمىسى. سىقىش نىسبىتى GZIP تىن %15-20 ياخشى، ئەمما سۈرئىتى ئاستا. Linux يادروسى مەنبە كودى، ئوچۇق كود مەنبەلىك باغلىمىلار كۆپىنچە بۇ فورماتنى ئىشلىتىدۇ، كېڭەيتىلمىسى .bz2)"

msgid "mime_cab"
msgstr "CAB سىقىلغان باغلىما (1995-يىلى Microsoft تەرىپىدىن قۇرۇلغان، كابىنېت فورماتى. Windows سىستېما قاچىلاش باغلىمىلىرىنىڭ فورماتى، يەتكۈزگۈچىلەر، سىستېما ھۆججەتلىرىنى تارقىتىش ئۈچۈن ئىشلىتىلىدۇ. Windows Installer (MSI) ئىچكى قىسمىدا ھۆججەت ساقلاش ئۈچۈن CAB نى ئىشلىتىدۇ)"

msgid "mime_dmg"
msgstr "DMG دىسكا تەسۋىرى (1980-يىللاردا Apple تەرىپىدىن تارقىتىلغان، Disk Image فورماتى. macOS يۇمشاق دېتال تارقىتىشنىڭ ئۆلچەملىك فورماتى، قوش چېكىش ۋىرتىۇال دىسكا سۈپىتىدە تاقىلىدۇ، سۆرەپ تاشلاش ئارقىلىق پروگرامما قاچىلىنىدۇ. سىقىش ۋە شىفىرلاشنى قوللايدۇ، Mac يۇمشاق دېتالى چۈشۈرۈشنىڭ ئاساسلىق فورماتى)"

msgid "mime_emz"
msgstr "EMZ سىقىلغان رەسىم (Windows سىقىلغان ياخشىلانغان مېتا ھۆججەت، EMF نىڭ سىقىلغان نۇسخىسى. Office پۈتۈكلىرىدە ۋېكتور رەسىم ساقلاش فورماتى، مەنىسى جەھەتتە GZIP سىقىلغان EMF ھۆججىتى)"

msgid "mime_gz"
msgstr "GZIP سىقىلغان باغلىما (1992-يىلى Jean-loup Gailly ۋە Mark Adler تەرىپىدىن قۇرۇلغان، GNU تۈرى. Unix/Linux ئۆلچەملىك سىقىش قورالى، HTTP يەتكۈزۈشتە سىقىش ئۈچۈن كۆپ ئىشلىتىلىدىغان فورمات. كېڭەيتىلمىسى .gz، كۆپىنچە TAR بىلەن بىرلىكتە ئىشلىتىلىدۇ)"

msgid "mime_jar"
msgstr "JAR سىقىلغان باغلىما (1997-يىلى Sun Microsystems تەرىپىدىن تارقىتىلغان، Java ARchive فورماتى. مەنىسى جەھەتتە ZIP سىقىلغان باغلىما، Java كىلاس كۇتۇپخانىلىرى ۋە پروگراممىلىرىنى باغلاش ئۈچۈن ئىشلىتىلىدۇ. Maven، Gradle قاتارلىق Java ئېكوسىستېمىسىنىڭ ئاساسلىق فورماتى، Android مۇ JAR نى ئىشلىتىدۇ)"

msgid "mime_lzma"
msgstr "LZMA سىقىلغان باغلىما (1998-يىلى Igor Pavlov تەرىپىدىن قۇرۇلغان، Lempel-Ziv-Markov زەنجىرى ئالگورىتمىسى. 7z فورماتىنىڭ ئاساسلىق سىقىش ئالگورىتمىسى، يۇقىرى سىقىش نىسبىتى، تېز ئېچىلىش. قاتتىق دېتال، ئورنىتىلغان سىستېما يۇمشاق دېتالى تارقىتىش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_rar"
msgstr "RAR سىقىلغان باغلىما (1993-يىلى Eugene Roshal تەرىپىدىن قۇرۇلغان، Roshal ARchive فورماتى. يۇقىرى سىقىش نىسبىتى، تومغا بۆلۈشنى، ئەسلىگە كەلتۈرۈش خاتىرىلىرىنى قوللايدۇ. WinRAR پروگراممىسىنىڭ فورماتى، سىقىش نىسبىتى ZIP تىن ئۈستۈن، ئەمما ھەقلىق يۇمشاق دېتال تەلەپ قىلىدۇ، unrar غا ئوخشاش ئوچۇق كود مەنبەلىك قوراللار ئېچەلەيدۇ)"

msgid "mime_tar"
msgstr "TAR ئارخىپ باغلىمىسى (1979-يىلى Unix V7 دا تونۇشتۇرۇلغان، Tape ARchive فورماتى. لېنتا ئارخىپ فورماتى، سىقمايدۇ پەقەت باغلايدۇ، كۆپىنچە GZIP/BZIP2/XZ بىلەن بىرلىكتە ئىشلىتىلىدۇ. Linux باغلىمىلىرىنىڭ مەنبە كودى، Docker تەسۋىر قەۋەتلىرىنى ساقلاش TAR فورماتىنى ئىشلىتىدۇ)"

msgid "mime_tgz"
msgstr "TGZ سىقىلغان باغلىما (TAR + GZIP بىرىكمە فورماتى، كېڭەيتىلمىسى .tgz ياكى .tar.gz. Unix/Linux باغلىمىلىرىنىڭ ئەڭ ئومۇمىي تارقىتىش فورماتى، مەنبە كود باغلىمىلىرى، ئىككىلىك باغلىمىلاردا كەڭ قوللىنىلىدۇ، «سىقىپ ئېچىپ ئىشلەت» نىڭ ۋەكىلى)"

msgid "mime_tbz2"
msgstr "TBZ2 سىقىلغان باغلىما (TAR + BZIP2 بىرىكمە فورماتى، كېڭەيتىلمىسى .tbz2 ياكى .tar.bz2. سىقىش نىسبىتى TGZ تىن %15-20 ياخشى، چوڭ ھۆججەت تارقىتىشقا ماس كېلىدۇ، Linux يادروسى مەنبە كودى بۇ فورماتنى ئۇزۇن ۋاقىت ئىشلەتكەن)"

msgid "mime_xz"
msgstr "XZ سىقىلغان باغلىما (2009-يىلى تارقىتىلغان، LZMA2 ئالگورىتمىسىغا ئاساسلانغان. ناھايىتى يۇقىرى سىقىش نىسبىتى، GZIP تىن %30-50 ياخشى، ئېچىلىش سۈرئىتى نىسبەتەن تېز. Linux يادروسى، باغلىما باشقۇرغۇچىلار (مەسىلەن، Debian نىڭ .deb ئىچىدە) تەرىپىدىن كەڭ قوللىنىلىدۇ، ھازىرقى Linux ئېكوسىستېمىسى ئۈچۈن تەۋسىيە قىلىنغان فورمات)"

msgid "mime_z"
msgstr "Z سىقىلغان باغلىما (1985-يىلى Unix compress بۇيرۇقىنىڭ فورماتى، LZW ئالگورىتمىسى. دەسلەپكى Unix سىقىش فورماتى، GZIP بىلەن ئالماشتۇرۇلغان. كېڭەيتىلمىسى .Z، زامانىۋى سىستېمىلاردا ئاز ئىشلىتىلىدۇ)"

msgid "mime_zip"
msgstr "ZIP سىقىلغان باغلىما (1989-يىلى Phil Katz تەرىپىدىن قۇرۇلغان، PKZIP فورماتى. Windows تەرىپىدىن يەرلىك قوللىنىدۇ، توردىكى ئەڭ ئومۇمىي سىقىش فورماتى. كۆپ ھۆججەتنى، قىسقۇچ قۇرۇلمىسىنى قوللايدۇ، سىقىش ئالگورىتمىسىنى تاللىغىلى بولىدۇ. Java نىڭ JAR، Android نىڭ APK، Office پۈتۈكلىرى DOCX/XLSX ZIP فورماتىغا ئاساسلانغان)"

msgid "mime_zst"
msgstr "Zstandard سىقىلغان باغلىما (2015-يىلى Facebook تەرىپىدىن قۇرۇلغان، Yann Collet تەرىپىدىن لايىھەلەنگەن. يۇقىرى سۈرئەتلىك سىقىش ئالگورىتمىسى، سىقىش نىسبىتى LZMA غا يېقىن، سۈرئىتى GZIP تىن ناھايىتى يۇقىرى. Linux يادروسى 5.9+ قوللايدۇ، Arch Linux pacman، Debian APT تەدرىجىي قوللىنىۋاتىدۇ، يېڭى ئەۋلاد سىقىش ئۆلچىمى)"

msgid "mime_lz4"
msgstr "LZ4 سىقىلغان باغلىما (2011-يىلى Yann Collet تەرىپىدىن قۇرۇلغان، ناھايىتى تېز سىقىش ئالگورىتمىسى. سىقىش سۈرئىتى GZIP تىن 10 ھەسسىدىن ئارتۇق تېز، رېئال ۋاقىت سىقىش سېنارىيلىرى ئۈچۈن ماس كېلىدۇ. Linux يادروسى، OpenZFS، Hadoop تەرىپىدىن كەڭ قوللىنىلىدۇ، سۈرئەتنى ئالدىنقى ئورۇنغا قويىدىغان سېنارىيلار ئۈچۈن تاللىنىدىغان)"

msgid "mime_lzo"
msgstr "LZO سىقىلغان باغلىما (1996-يىلى Markus Oberhumer تەرىپىدىن قۇرۇلغان، Lempel-Ziv-Oberhumer ئالگورىتمىسى. ئېچىش سۈرئىتى ناھايىتى تېز، سىقىش نىسبىتى ئوتتۇراھال. Linux يادروسى Squashfs، OpenWrt قاتتىق دېتالى تەرىپىدىن ئىشلىتىلىدۇ، ئورنىتىلغان سىستېمىلار ئۈچۈن ماس كېلىدۇ)"

msgid "mime_msi"
msgstr "MSI قاچىلاش باغلىمىسى (1999-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Windows Installer باغلىما فورماتى. Windows پروگراممىلىرىنى قاچىلاشنىڭ ئۆلچەملىك فورماتى، ئىش ھەرىكىتىنى قايتۇرۇش، قىسمىنى باشقۇرۇش، جىمجىت قاچىلاشنى قوللايدۇ. كارخانا دەرىجىلىك يۇمشاق دېتال تارقىتىشنىڭ تاللىنىدىغان فورماتى، بۈگۈنگە قەدەر Windows يۇمشاق دېتالى قاچىلاشنىڭ ئاساسلىق ئېقىمى)"

msgid "mime_pkg"
msgstr "PKG قاچىلاش باغلىمىسى (macOS پروگرامما قاچىلاش باغلىما فورماتى، Apple نىڭ Installer تېخنىكىسىغا ئاساسلانغان. macOS يۇمشاق دېتال تارقىتىشنىڭ ئۆلچەملىك فورماتى، قىسمىنى تاللاشنى، قاچىلاش پروگرامما كودلىرىنى، چىقىرىۋېتىش ئىقتىدارىنى قوللايدۇ. .pkg ھۆججىتىنى قوش چېكىش ئارقىلىق قاچىلىغىلى بولىدۇ، Mac App Store دىن سىرتقى يۇمشاق دېتاللار ئۈچۈن كۆپ ئىشلىتىلىدىغان تارقىتىش ئۇسۇلى)"

msgid "mime_apk"
msgstr "APK Android پروگرامما باغلىمىسى (2008-يىلى Google تەرىپىدىن تارقىتىلغان، Android سىستېمىسىنىڭ ئەنئەنىۋى پروگرامما قاچىلاش فورماتى. APK مەنىسى جەھەتتە ZIP باغلىمىسى بولۇپ، كود، بايلىقلار، كۆرسىتىش ھۆججىتىنى ئۆز ئىچىگە ئالىدۇ. 2021-يىلىدىن باشلاپ Google Play يېڭى پروگراممىلارنىڭ AAB فورماتىنى ئىشلىتىشىنى تەلەپ قىلىدۇ، ئەمما APK يەنىلا تەرەققىيات ۋە ھاتالاردىن تازىلاش، ئۈچىنچى تەرەپ دۇكانلار ۋە يان قاچىلاش ئۈچۈن ئىشلىتىلىۋاتىدۇ)"

msgid "mime_ipa"
msgstr "IPA iOS پروگرامما باغلىمىسى (iOS App Store باغلىمىسى، iOS/iPadOS پروگراممىلىرىنى قاچىلاش فورماتى. 2008-يىلى iPhone SDK بىلەن بىرلىكتە تارقىتىلغان. App Store ئارقىلىق تارقىتىلىشى ياكى كارخانا گۇۋاھنامىسى بىلەن ئىمزالىنىشى كېرەك. ئىجرا قىلغىلى بولىدىغان ھۆججەت، بايلىقلار، Info.plist ۋە ئىمزا ئۇچۇرلىرىنى ئۆز ئىچىگە ئالىدۇ)"

msgid "mime_hap"
msgstr "HAP HarmonyOS پروگرامما باغلىمىسى (HarmonyOS Ability Package، HarmonyOS پروگراممىسىنىڭ ئاساسىي بىرلىكى. 2020-يىلى HarmonyOS 2.0 بىلەن بىرلىكتە تارقىتىلغان. entry ۋە feature دەپ ئاتىلىدىغان ئىككى خىلنى قوللايدۇ، Huawei تېلېفونلىرى، پلانشېتلار، ئەقىللىق سائەتلىرى ۋە باشقا HarmonyOS ئۈسكۈنىلىرى ئۈچۈن تارقىتىش فورماتى)"

msgid "mime_har"
msgstr "HAR HarmonyOS سىتاتىك ئورتاق كۇتۇپخانا (HarmonyOS ئارخىپى، HarmonyOS نىڭ سىتاتىك ئورتاق كۇتۇپخانىسى، كۆپ HAP باغلىمىلىرى تەرىپىدىن ئورتاقلىشىغىلى بولىدۇ، قىسمىغا ئاساسلانغان تەرەققىيات ۋە مودۇللارنى قايتا ئىشلىتىش ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_aab"
msgstr "Android App Bundle (2018-يىلى Google تەرىپىدىن تارقىتىلغان، 2021-يىلىدىن باشلاپ Google Play يېڭى پروگراممىلارنىڭ بۇ فورماتنى ئىشلىتىشىنى مەجبۇرلىيدۇ. AAB تارقىتىش فورماتى بولۇپ، Google Play ئۈسكۈنە سەپلىمىسىگە (CPU قۇرۇلمىسى، ئېكران زىچلىقى، تىل) ئاساسەن ئوپتىماللاشتۇرۇلغان APK لارنى ھاسىل قىلىدۇ، قاچىلاش باغلىمىسىنىڭ چوڭلۇقى ئوتتۇرىچە %35 كېمىيىدۇ. قۇرغۇچىلار AAB نى يۈكلايدۇ، ئىشلەتكۈچىلەر APK نى چۈشۈرىدۇ)"

msgid "mime_xapk"
msgstr "XAPK پروگرامما باغلىمىسى (ئۈچىنچى تەرەپ Android پروگرامما كېڭەيتىش باغلىمىسى، APK + OBB سانلىق مەلۇمات ھۆججەتلىرىنى ئۆز ئىچىگە ئالىدۇ. چوڭ ئويۇنلار ۋە مۇرەككەپ پروگراممىلار ئۈچۈن ئىشلىتىلىدۇ، بىر ھۆججەتلىك APK نىڭ 100MB چەكلىمىسىنى ھەل قىلىدۇ. APKPure، APKMirror قاتارلىق ئۈچىنچى تەرەپ پروگرامما دۇكانلىرىدا كۆپ ئۇچرايدۇ، Google نىڭ رەسمىي فورماتى ئەمەس)"

msgid "mime_appx"
msgstr "Windows پروگرامما باغلىمىسى (2012-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Windows 8/10/11 پروگرامما قاچىلاش فورماتى. UWP ۋە ئۈستەل پروگراممىسى ئايلاندۇرۇشنى قوللايدۇ، Microsoft Store ئارقىلىق تارقىتىلىدۇ. 2024-يىلى Microsoft MSIX نى ۋارىس فورمات سۈپىتىدە تارقىتتى، تەدرىجىي APPX نى ئالماشتۇرىدۇ)"

msgid "mime_msix"
msgstr "MSIX پروگرامما باغلىمىسى (2018-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Windows ئۈچۈن يېڭى ئەۋلاد پروگرامما باغلاش فورماتى. APPX ۋە MSI نىڭ ئارتۇقچىلىقلىرىنى بىرلەشتۈرىدۇ، بارلىق Windows پروگرامما تۈرلىرىنى قوللايدۇ، Microsoft Store ئارقىلىق ياكى ياندىن قاچىلاش ئارقىلىق تارقىتىلغىلى بولىدۇ، Windows 11 تەۋسىيە قىلىنغان فورماتى)"

msgid "mime_appimage"
msgstr "AppImage پروگرامما باغلىمىسى (2004-يىلى تارقىتىلغان، Linux قاچىلاشسىز پروگرامما فورماتى. «بىر پروگرامما بىر ھۆججەت»، قاچىلاشنى تەلەپ قىلمايدۇ، بىۋاسىتە ئىجرا بولىدۇ، كۆپىنچە Linux تارقىتىشلىرىنى قوللايدۇ، قۇرغۇچىلارنىڭ Linux يۇمشاق دېتالىنى تارقىتىشنىڭ كۆپ ئىشلىتىلىدىغان ئۇسۇلى)"

msgid "mime_flatpak"
msgstr "Flatpak پروگرامما باغلىمىسى (2015-يىلى تارقىتىلغان، Linux قۇم ساندۇقى پروگرامما فورماتى. تارقىتىشلار ئارىسدا ئىشلەيدۇ، ئاساسىي سىستېمىدىن ئايرىلغان، Fedora، Red Hat تەرىپىدىن يېتەكچىلىك قىلىنىدۇ، GNOME يۇمشاق دېتال مەركىزىنىڭ سۈكۈتتىكى فورماتى)"

msgid "mime_snap"
msgstr "Snap پروگرامما باغلىمىسى (2014-يىلى Canonical تەرىپىدىن تارقىتىلغان، Ubuntu نىڭ ئانا شىركىتى، Linux ئومۇمىي پروگرامما فورماتى. ئاپتوماتىك يېڭىلاش، قۇم ساندۇقى ئايرىۋېتىش، 40 تىن ئارتۇق Linux تارقىتىشنى قوللايدۇ، Ubuntu يۇمشاق دېتال مەركىزىنىڭ سۈكۈتتىكى فورماتى)"

msgid "mime_deb"
msgstr "Debian يۇمشاق دېتال باغلىمىسى (1993-يىلى Debian تۈرى تەرىپىدىن تارقىتىلغان، Debian/Ubuntu ۋە ئۇلارنىڭ تارمىقىلىرىنىڭ ئۆلچەملىك قاچىلاش فورماتى. dpkg ئارقىلىق باشقۇرۇلىدۇ، APT ئۇنىڭ باغلىما باشقۇرغۇچىسىنىڭ ئالدى تەرىپى، Linux ئېكوسىستېمىسىدىكى ئەڭ يېتىلگەن باغلىما فورماتلىرىنىڭ بىرى، بۈگۈنگە قەدەر Debian ئائىلىسىنىڭ ئاساسلىق ئېقىمى)"

msgid "mime_rpm"
msgstr "RPM يۇمشاق دېتال باغلىمىسى (1997-يىلى Red Hat تەرىپىدىن تارقىتىلغان، Red Hat/Fedora/CentOS/SUSE ۋە باشقا تارقىتىشلارنىڭ ئۆلچەملىك فورماتى. RPM «Red Hat باغلىما باشقۇرغۇچىسى» دېگەننىڭ قىسقارتىلمىسى، DEB بىلەن بىرلىكتە Linux نىڭ ئىككى چوڭ باغلىما فورماتى، بۈگۈنگە قەدەر RHEL ئائىلىسىنىڭ ئاساسلىق ئېقىمى)"

msgid "mime_pacman"
msgstr "Arch يۇمشاق دېتال باغلىمىسى (2002-يىلى Arch Linux تەرىپىدىن تارقىتىلغان، pacman باغلىما باشقۇرغۇچىسى ئىشلىتىدىغان .pkg.tar.zst فورماتى. Arch Linux نىڭ ئايلىنىپ تۇرىدىغان تارقىتىشىنىڭ يادروسى، ئاددىيلىقى ۋە KISS پىرىنسىپى بىلەن تونۇلغان، AUR (Arch ئىشلەتكۈچى ئامبىرى) ئۇنىڭ ئالاھىدىلىكى)"

msgid "mime_exe"
msgstr "EXE ئىجرا قىلغىلى بولىدىغان ھۆججەت (Windows ئىجرا قىلغىلى بولىدىغان پروگرامما فورماتى، «Executable» نىڭ قىسقارتىلمىسى. Windows ئېپېراتسىيە سىستېمىسىنىڭ يەرلىك ئىجرا قىلغىلى بولىدىغان فورماتى، PE قۇرۇلمىسىنى ئۆز ئىچىگە ئالىدۇ. MS-DOS نىڭ MZ فورماتىدىن تەرەققىي قىلغان، 1993-يىلى Windows NT PE (Portable Executable) فورماتىنى تونۇشتۇردى ۋە بۈگۈنگە قەدەر ئىشلىتىلىۋاتىدۇ. يۇمشاق دېتال قاچىلاش باغلىمىلىرى، پروگراممىلار، سىستېما قوراللىرى بۇ فورماتنى ئىشلىتىدۇ. ئىشلەتكۈچى قوش چېكىش ئارقىلىق ئىجرا قىلالايدۇ، دۇنيادىكى ئەڭ كەڭ قوللىنىلىدىغان ئىجرا قىلغىلى بولىدىغان فورمات)"

msgid "mime_dll"
msgstr "DLL دىنامىكىلىق باغلانما كۇتۇپخانا (1993-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Dynamic Link Library. Windows ئورتاق كود كۇتۇپخانىسى، پروگرامما ئىجرا قىلىنىش جەريانىدا دىنامىكىلىق يۈكلىنىدۇ، خاتىرە ۋە دىسكا بوشلۇقىنى تېجەيدۇ. سىستېما قىسىملىرى، پروگرامما قىستۇرمىلىرى، يەتكۈزگۈچىلەر DLL فورماتىنى ئىشلىتىدۇ. Windows API نى ئەمەلگە ئاشۇرۇشنىڭ ئاساسلىق ئۇسۇلى، DLL Hell مەسىلىسى .NET دەۋرىدە يۇمشاتقان)"

msgid "mime_com"
msgstr "COM ئىجرا قىلغىلى بولىدىغان ھۆججەت (MS-DOS دەۋرىدىكى ئىجرا قىلغىلى بولىدىغان فورمات، «Command» نىڭ قىسقارتىلمىسى. ئاددىي ھۆججەت قۇرۇلمىسى، 64KB چەكلىمىسى، Windows 3.x تىن ئىلگىرىكى ئاساسلىق فورمات. تۈگىتىلگەن، زامانىۋى Windows EXE فورماتىنى ئىشلىتىدۇ، COM كېڭەيتىلمىسى يەنىلا بەزى قىسىم ھۆججەتلىرى ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_aac"
msgstr "AAC ئاۋازى (1997-يىلى MPEG ئۆلچىمى، Advanced Audio Coding. MP3 نىڭ ۋارىسى، ئوخشاش بىت نىسبىتىدە ئاۋاز سۈپىتى MP3 تىن ئۈستۈن، YouTube، iTunes، Nintendo Switch نىڭ سۈكۈتتىكى ئاۋاز فورماتى)"

msgid "mime_alac"
msgstr "ALAC ئاۋازى (2004-يىلى Apple تەرىپىدىن قۇرۇلغان، Apple Lossless Audio Codec. Apple نىڭ زىيانسىز فورماتى، 2011-يىلى ئوچۇق كود مەنبەلىك بولدى، iTunes ۋە Apple Music نىڭ زىيانسىز ئاۋاز ئۈچۈن سۈكۈتتىكى فورماتى)"

msgid "mime_flac"
msgstr "FLAC ئاۋازى (2001-يىلى Xiph.Org فوندى جەمئىيىتى تەرىپىدىن قۇرۇلغان، Free Lossless Audio Codec. زىيانسىز سىقىش، ئاۋاز سۈپىتى CD بىلەن ئوخشاش، ھۆججەت چوڭلۇقى ئەسلى WAV نىڭ تەخمىنەن يېرىمى. ئوچۇق كود مەنبەلىك پاتېنتسىز، ئاۋاز ھەۋەسكارلىرى ۋە رەقەملىك مۇزىكا توپلىغۇچىلىرى ئۈچۈن تاللىنىدىغان فورمات)"

msgid "mime_mp3"
msgstr "MP3 ئاۋازى (1993-يىلى Fraunhofer ئىنستىتۇتى تەرىپىدىن قۇرۇلغان، MPEG-1 Audio Layer 3. زىيانلىق سىقىش فورماتى، كىچىك ھۆججەت چوڭلۇقى قوبۇل قىلىشقا بولىدىغان سۈپەت، 2000-يىللاردىكى رەقەملىك مۇزىكا ئىنقىلابىنىڭ ئاساسلىق فورماتى، iPod ۋە Napster نىڭ چوڭ تۆھپىكارى. 2017-يىلى پاتېنتى توشقان، ئاممىۋى دائىرە فورماتىغا ئايلانغان)"

msgid "mime_oga"
msgstr "Ogg Audio ئاۋازى (Xiph.Org فوندى جەمئىيىتى تەرىپىدىن قۇرۇلغان، Ogg ساندۇقىنىڭ ساپ ئاۋاز فورماتى، Vorbis كودلاشنى ئىشلىتىدۇ. ئوچۇق كود مەنبەلىك پاتېنتسىز، سىقىش ئۈنۈملۈكى MP3 تىن ياخشى، ئوچۇق كود مەنبەلىك تۈرلەردە كەڭ قوللىنىلىدۇ)"

msgid "mime_ogg"
msgstr "OGG ئاۋازى (2000-يىلى Xiph.Org فوندى جەمئىيىتى تەرىپىدىن قۇرۇلغان، Ogg Vorbis فورماتى. ئوچۇق كود مەنبەلىك پاتېنتسىز، سىقىش ئۈنۈملۈكى MP3 تىن ياخشى، Spotify دەسلەپتە قوللانغان، ئويۇن ئاۋاز ئۈنۈملىرىدە كەڭ قوللىنىلىدۇ)"

msgid "mime_opus"
msgstr "Opus ئاۋازى (2012-يىلى IETF تەرىپىدىن ئۆلچەملەشتۈرۈلگەن، ئوچۇق كود مەنبەلىك پاتېنتسىز ئاۋاز فورماتى. SILK ۋە CELT تېخنىكىلىرىنى بىرلەشتۈرىدۇ، كېچىكىش ناھايىتى تۆۋەن، ئەڭ يۇقىرى سىقىش ئۈنۈملۈكى، WebRTC، WhatsApp، Discord نىڭ سۈكۈتتىكى ئاۋاز فورماتى)"

msgid "mime_wav"
msgstr "WAV ئاۋازى (1991-يىلى Microsoft ۋە IBM تەرىپىدىن قۇرۇلغان، Windows نىڭ يەرلىك ئاۋاز فورماتى. سىقىلمىغان PCM كودلاش، زىيانسىز ئاۋاز سۈپىتى، ئەمما ھۆججەت چوڭلۇقى ناھايىتى چوڭ، كەسپىي ئاۋاز تەھرىرلەش ئۆلچەملىك فورماتى)"

msgid "mime_wma"
msgstr "WMA ئاۋازى (1999-يىلى Microsoft تەرىپىدىن قۇرۇلغان، Windows Media Audio. زىيانلىق/زىيانسىز ئىككى نۇسخىسى بار، Windows تەرىپىدىن يەرلىك قوللىنىلىدۇ، Windows Media Player بىلەن بىرلىكتە كەڭ تارقالغان. ھازىر چېكىنىشكە ئۇچرىغان، MP3/AAC بىلەن ئالماشتۇرۇلغان)"

msgid "mime_dsf"
msgstr "DSF ئاۋازى (Direct Stream Digital فورماتى، Sony ۋە Philips تەرىپىدىن قۇرۇلغان. 1bit يۇقىرى ئۈلگە ئېلىش چاستوتىسى، DSD ئاۋاز ئۆلچەملىك فورماتى، SACD نىڭ رەقەملىك نۇسخىسى، ئاۋاز ھەۋەسكارلىرىنىڭ يۇقىرى دەرىجىلىك ئاۋاز فورماتى، ھۆججەت چوڭلۇقى ناھايىتى چوڭ)"

msgid "mime_ape"
msgstr "APE ئاۋاز (2000-يىلى Monkey's Audio تەرىپىدىن ياسالغان، زىيانسىز سىقىش فورماتى. FLAC دىن يۇقىرى سىقىش نىسبىتى لېكىن كودلاش ئاستا، يەنىلا Windows سۇپىسىدا ۋە ئاۋاز ھەۋەسكارلىرى ئارىسىدا ئىشلىتىلىدۇ)"

msgid "mime_mid"
msgstr "MIDI ئاۋازى (1983-يىلى MIDI جەمئىيىتى تەرىپىدىن بەلگىلەنگەن، Musical Instrument Digital Interface. نوتا فورماتى، ئاۋاز يېزىش ئەمەس، ھۆججەت چوڭلۇقى ناھايىتى كىچىك، ئېلېكتىرون ئەسۋابلار، يانفون قوڭغۇراق ئاۋازلىرى، ئويۇن ئاۋاز ئۈنۈملىرى ئۈچۈن ئۆلچەم. 1991-يىلى General MIDI ئۆلچەملەشتۈرۈلگەن، 128 خىل ئەسۋاب ئاۋازىنى بەلگىلىگەن)"

msgid "mime_m4a"
msgstr "M4A ئاۋازى (MPEG-4 Audio، AAC نىڭ ساندۇق فورماتى. iTunes مۇزىكا دۇكىنىنىڭ ئۆلچەملىك فورماتى، Apple ئېكوسىستېمىسىنىڭ ئاساسلىق ئاۋاز فورماتى، DRM قوغدىشىنى قوللايدۇ)"

msgid "mime_m3u"
msgstr "M3U قويۇش تىزىملىكى (MP3 URL قويۇش تىزىملىكى فورماتى، ساپ تېكىست ھۆججىتى، ئاۋاز ھۆججەت يوللىرىنى خاتىرىلايدۇ. Winamp دەۋرىنىڭ ئۆلچىمى، تور رادىئوسى، توردا مۇزىكا ئېقىنى ئۈچۈن ئىشلىتىلىدۇ. M3U8 ئۇنىڭ UTF-8 نۇسخىسى، HTTP تىز تور ئېقىنى ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_asf"
msgstr "ASF ئېقىنى (1996-يىلى Microsoft تەرىپىدىن قۇرۇلغان، Advanced Systems Format. Windows Media ئېقىن ساندۇقى، ئاۋاز-سىننى بىر ۋاقىتتا يەتكۈزۈشنى قوللايدۇ. تىز تارقىتىش ۋە تەلەپ بويىچە سىن ئېقىنى ئۈچۈن ئىشلىتىلىدۇ، WMA/WMV ASF ساندۇقىغا ئاساسلانغان)"

msgid "mime_avi"
msgstr "AVI سىنى (1992-يىلى Microsoft تەرىپىدىن تارقىتىلغان، Windows نىڭ دەسلەپكى سىن ئۆلچىمى. «Audio Video Interleave»، ئاۋاز-سىن ئارىلاشما ساقلاش، 1990-2000-يىللاردىكى ئەڭ ئالقىشقا ئېرىشكەن سىن فورماتى، ھازىر MP4/MKV بىلەن ئالماشتۇرۇلغان)"

msgid "mime_divx"
msgstr "DivX سىنى (1998-يىلى DivX شىركىتى تەرىپىدىن قۇرۇلغان، MPEG-4 ئاساسىدىكى سىن كودلاش فورماتى. 2000-يىللاردىكى تور سىن ئورتاقلىشىشنىڭ ئاساسلىق فورماتى، DVD سۈپىتىنى CD چوڭلۇقىغا سىققان تۇنجى تېخنىكا. كۆپەيتىش ھوقۇقى تالاش-تارتىشلىرى سەۋەبىدىن، كېيىنچە سودا كودلىغۇچىغا ئايلاندى)"

msgid "mime_mp4"
msgstr "MP4 سىنى (2001-يىلى MPEG ئۆلچىمى، MPEG-4 14-قىسمى. دۇنيادىكى ئەڭ ئومۇمىي سىن فورماتى، H.264/H.265 كودلاشنى قوللايدۇ، تور سىنى، يانفون تارتىش، YouTube نىڭ سۈكۈتتىكى فورماتى)"

msgid "mime_m4v"
msgstr "M4V سىنى (iTunes سىن فورماتى، MP4 نىڭ بىر تۈرى. Apple ئېكوسىستېمىسىدىكى سىن فورماتى، iTunes Store فىلىملىرى، تېلېۋىزور پروگراممىلىرىنىڭ ئۆلچەملىك فورماتى، DRM كۆپەيتىش ھوقۇقى قوغدىشىنى قوللايدۇ)"

msgid "mime_mpeg"
msgstr "MPEG سىنى (1988-يىلى MPEG تەشكىلاتى تەرىپىدىن بەلگىلەنگەن، Moving Picture Experts Group. رەقەملىك سىن سىقىش ئۆلچەملىرىنىڭ ئاساسلىق قۇرغۇچىسى، MPEG-1 (VCD)، MPEG-2 (DVD)، MPEG-4 (تور سىنى) چوڭقۇر تەسىر كۆرسەتكەن)"

msgid "mime_mkv"
msgstr "MKV سىنى (2002-يىلى Matroska تۈرى تەرىپىدىن قۇرۇلغان، ئوچۇق كود مەنبەلىك مولتىمېدىيا ساندۇقى. كۆپ ئاۋاز يوللىرىنى، كۆپ تەرجىمانى، بابلىرىنى قوللايدۇ، «قاچىلاش سېھىرگىرى»، HD فىلىم ئورتاقلىشىشنىڭ تاللىنىدىغان فورماتى)"

msgid "mime_mpg"
msgstr "MPEG سىنى (MPEG-1/MPEG-2 سىن كېڭەيتىلمىسى، VCD ۋە DVD نىڭ ئۆلچەملىك فورماتى. 1990-2000-يىللاردىكى ئوپتىكىلىق دىسكىلارنىڭ ئاساسلىق سىن فورماتى، ھازىر H.264/H.265 بىلەن ئالماشتۇرۇلغان)"

msgid "mime_ogv"
msgstr "Ogg Video سىنى (Xiph.Org فوندى جەمئىيىتى تەرىپىدىن قۇرۇلغان، Ogg ساندۇقىنىڭ سىن فورماتى، Theora كودلاشنى ئىشلىتىدۇ. ئوچۇق كود مەنبەلىك پاتېنتسىز، HTML5 سىنىنىڭ دەسلەپكى ئۆلچەملىرىدىن بىرى، Firefox تەرىپىدىن يەرلىك قوللىنىلىدۇ)"

msgid "mime_ogx"
msgstr "Ogg مولتىمېدىيا ساندۇقى (Xiph.Org فوندى جەمئىيىتى تەرىپىدىن قۇرۇلغان، Ogg ساندۇقىنىڭ ئومۇمىي كېڭەيتىلمىسى، ئاۋاز، سىن، تەرجىمان قاتارلىق كۆپ يوللارنى ئۆز ئىچىگە ئالالايدۇ. ئوچۇق كود مەنبەلىك مولتىمېدىيا ئۆلچىمى، ئويۇنلار، ئېقىن ئۈچۈن ئىشلىتىلىدۇ)"

msgid "mime_rm"
msgstr "RealMedia سىنى (1995-يىلى RealNetworks تەرىپىدىن قۇرۇلغان، RealMedia فورماتى. 1990-2000-يىللاردىكى تور ئېقىنىنىڭ ئىلگىرىلىگۈچىسى، RealPlayer قويغۇچنىڭ ئاساسلىق فورماتى. ئاجىزلىقلىرى: ئالاھىدە قويغۇچ تەلەپ قىلىدۇ، سىقىش سۈپىتى ئاجىز، كېيىن Flash/MP4 بىلەن ئالماشتۇرۇلغان)"

msgid "mime_flv"
msgstr "Flash سىنى (فورمات 2002-يىلى پەيدا بولغان، Flash Video فورماتى. بىر ۋاقىتلاردا تور سىنىنىڭ ئاساسلىق فورماتى بولغان، YouTube دەسلەپتە قوللانغان. ئاجىزلىقلىرى: Flash قىستۇرمىسى تەلەپ قىلىدۇ، ئىپادىلىشى ئاجىز، كۆپ بىخەتەرلىك تۆشۈكلىرى بار. 2015-يىلدىن باشلاپ ئاساسلىق تور بېكەتلەر HTML5 سىنىغا ئۆتكەن، ھازىر تۈگىتىلگەن)"

msgid "mime_f4v"
msgstr "F4V سىنى (Adobe تەرىپىدىن قۇرۇلغان Flash سىن فورماتى، FLV نىڭ ۋارىسى. MPEG-4 ئۆلچىمىگە ئاساسلانغان، H.264 كودلاشنى قوللايدۇ. Flash تېخنىكىسى بىلەن بىرلىكتە تۈگىتىلگەن، Adobe 2020-يىلى قوللاشنى توختاتقان)"

msgid "mime_wmv"
msgstr "WMV سىنى (1999-يىلى Microsoft تەرىپىدىن قۇرۇلغان، Windows Media Video. Windows تەرىپىدىن يەرلىك قوللىنىلىدۇ، ئېقىن يەتكۈزۈشكە ئوپتىماللاشتۇرۇلغان، دەسلەپكى توردىكى سىنلاردا كۆپ ئىشلىتىلگەن فورمات، ھازىر چېكىنىشكە ئۇچرىغان)"

msgid "mime_wmf"
msgstr "WMF مېدىيا فورماتى (Windows Media Format، Microsoft نىڭ مېدىيا رامكىسى. WMV سىنى ۋە WMA ئاۋازىنىڭ ئومۇمىي نامىنى ئۆز ئىچىگە ئالىدۇ، Windows Media Player تەرىپىدىن يەرلىك قوللىنىلىدۇ)"

msgid "mime_mov"
msgstr "MOV سىنى (1991-يىلى Apple تەرىپىدىن قۇرۇلغان، QuickTime ساندۇق فورماتى. كەسپىي سىن تەھرىرلەشنىڭ ئۆلچەملىك فورماتى، كۆپ كودېكلارنى قوللايدۇ، Final Cut Pro، Premiere تەرىپىدىن يەرلىك قوللىنىلىدۇ)"

msgid "mime_qt"
msgstr "QuickTime سىنى (1991-يىلى Apple تەرىپىدىن تارقىتىلغان، QuickTime فورماتى. Mac سۇپىسىنىڭ سىن ئۆلچىمى، MOV ئۇنىڭ ساندۇقى، QuickTime قويغۇچ كەڭ قوللىنىلغان. 2016-يىلى Apple Windows نۇسخىسىنىڭ تەرەققىياتىنى توختاتقان، تەدرىجىي MP4 بىلەن ئالماشتۇرۇلماقتا)"

msgid "mime_webm"
msgstr "WebM سىنى (2010-يىلى Google تەرىپىدىن تارقىتىلغان، ئوچۇق كود مەنبەلىك پاتېنتسىز سىن فورماتى. Matroska ساندۇقىغا، VP8/VP9 كودلاشقا ئاساسلانغان، HTML5 سىن ئۆلچەملىك فورماتى، YouTube نىڭ سۈكۈتتىكى تور قويۇش فورماتى)"

msgid "mime_3gp"
msgstr "3GP سىنى (2000-يىلى 3GPP تەرىپىدىن بەلگىلەنگەن، يانفون ئۈسكۈنىلىرى ئۈچۈن سىن فورماتى. ھۆججەت چوڭلۇقى ناھايىتى كىچىك، سۈپىتى تۆۋەن، دەسلەپكى ئىقتىدارلىق تېلېفونلارنىڭ سىن تارتىش فورماتى، MMS ئەۋەتىش ئۈچۈن ئىشلىتىلىدۇ)"

