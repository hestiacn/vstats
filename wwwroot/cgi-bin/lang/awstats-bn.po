msgid "mime_text"
msgstr "টেক্সট ফাইল (১৯৬৩ সালে ASCII মানীকৃত, ফরম্যাটবিহীন প্লেইন টেক্সট। সোর্স কোড, কনফিগারেশন ফাইল এবং লগের ভিত্তি। ইউনিক্স LF ব্যবহার করে, উইন্ডোজ CRLF ব্যবহার করে, এখনও কম্পিউটারের সবচেয়ে সাধারণ ডেটা ফরম্যাট)"

msgid "mime_log"
msgstr "লগ ফাইল (সিস্টেম ডেটা, অ্যাপ্লিকেশন অপারেশন তথ্য রেকর্ডকারী প্লেইন টেক্সট ফাইল, সমস্যা সমাধান, কর্মক্ষমতা বিশ্লেষণ, নিরাপত্তা অডিটের জন্য ব্যবহৃত হয়। মানক ফরম্যাট যেমন Apache combined log, Nginx access log, syslog ইত্যাদি)"

msgid "mime_page"
msgstr "HTML ওয়েব পৃষ্ঠা (টিম বার্নার্স-লি ১৯৮৯ সালে ওয়ার্ল্ড ওয়াইড ওয়েব আবিষ্কার করেন, ১৯৯০ সালে HTML/HTTP/URL তিনটি প্রযুক্তি সংজ্ঞায়িত করেন, পেটেন্ট ছাড়া বিনামূল্যে প্রদান করেন। HTML5 ২০১৪ সালে W3C মানক হয়, প্রদর্শন, মাল্টিমিডিয়া এবং মুদ্রণ সমর্থন করে। ২০১৬ সালে টুরিং পুরস্কার অর্জন)"

msgid "mime_khtml"
msgstr "KHTML ওয়েব পৃষ্ঠা ইঞ্জিন (১৯৯৮ সালে KDE 2.0 এ প্রকাশিত, Konqueror ব্রাউজারের রেন্ডারিং ইঞ্জিন। অ্যাপল ২০০১ সালে KHTML এর ভিত্তিতে WebKit তৈরি করে। গুগল ২০০৮ সালে WebKit থেকে Blink তৈরি করে, যা Chrome, Edge, Safari ব্রাউজারের মূল হয়ে ওঠে। KHTML ওপেন সোর্স সম্প্রদায়ের একটি আদর্শ যা আধুনিক ব্রাউজার ইঞ্জিনের ভিত্তি স্থাপন করেছে, এর প্রযুক্তিগত উত্তরাধিকার WebKit/Blink এর মাধ্যমে অব্যাহত রয়েছে)"

msgid "mime_script"
msgstr "ডায়নামিক স্ক্রিপ্ট (ব্যাখ্যামূলক ভাষা, কম্পাইল করার প্রয়োজন নেই। ASP, JSP, CGI, ColdFusion, Tcl, VBScript ইত্যাদি অন্তর্ভুক্ত, প্রাথমিক ওয়েব উন্নয়ন, সিস্টেম ব্যবস্থাপনা, স্বয়ংক্রিয় কাজে ব্যাপকভাবে ব্যবহৃত হয়। Python, Ruby, JavaScript এর মতো আধুনিক স্ক্রিপ্ট ভাষা full-stack উন্নয়নের মূল ভাষা হিসাবে বিকশিত হয়েছে)"

msgid "mime_js"
msgstr "JavaScript স্ক্রিপ্ট (ব্রেন্ডান আইক ১৯৯৫ সালে Netscape এ ১০ দিনে তৈরি করেন, ব্রাউজারের মূল প্রোগ্রামিং ভাষা। ECMAScript ১৯৯৭ সালে মানীকৃত হয়। Node.js ২০০৯ সালে জন্ম নেয় এবং এটিকে full-stack ভাষা বানায়। npm বিশ্বের বৃহত্তম প্যাকেজ ম্যানেজার। GitHub এ টানা কয়েক বছর ধরে সবচেয়ে জনপ্রিয় প্রোগ্রামিং ভাষা)"

msgid "mime_py"
msgstr "Python স্ক্রিপ্ট (গুইডো ভ্যান রোসাম ১৯৯১ সালে তৈরি করেন, বাধ্যতামূলক ইনডেন্টেশন, সরল সিনট্যাক্সের জন্য বিখ্যাত। ওয়েব উন্নয়ন, ডেটা সায়েন্স, কৃত্রিম বুদ্ধিমত্তা, স্বয়ংক্রিয় অপারেশনে ব্যাপকভাবে ব্যবহৃত হয়। TIOBE এর বার্ষিক প্রোগ্রামিং ভাষা পুরস্কার বহুবার অর্জন করেছে)"

msgid "mime_sh"
msgstr "শেল স্ক্রিপ্ট (ইউনিক্স ১৯৭১ সালে জন্ম নেয়, কমান্ড স্ক্রিপ্ট ভাষা। সিস্টেম ব্যবস্থাপনা, স্বয়ংক্রিয় কাজ, পরিষেবা শুরু, স্থাপনা স্ক্রিপ্টের জন্য ব্যবহৃত হয়। Linux প্রশাসনের জন্য প্রয়োজনীয় দক্ষতা)"

msgid "mime_rb"
msgstr "রুবি স্ক্রিপ্ট (ইউকিহিরো মাতসুমোতো ১৯৯৫ সালে তৈরি করেন, ডেভেলপারের সুখের উপর ফোকাস করেন। রুবি অন রেলস ফ্রেমওয়ার্ক 'কনফিগারেশনের চেয়ে কনভেনশন' উন্নয়ন দৃষ্টান্ত শুরু করে, আধুনিক ওয়েব ফ্রেমওয়ার্ক ডিজাইনকে প্রভাবিত করেছে)"

msgid "mime_pl"
msgstr "পার্ল স্ক্রিপ্ট (ল্যারি ওয়াল ১৯৮৭ সালে তৈরি করেন, ব্যবহারিকতার জন্য বিখ্যাত, 'সুইস আর্মি ছুরি' নামে পরিচিত। CPAN আধুনিক ভাষা প্যাকেজ ম্যানেজারের অগ্রদূত, টেক্সট প্রসেসিং, সিস্টেম ব্যবস্থাপনা এবং CGI তে গভীর প্রভাব রয়েছে)"

msgid "mime_php"
msgstr "PHP ডায়নামিক ওয়েব পৃষ্ঠা (রাসমাস লেরডর্ফ ১৯৯৫ সালে তৈরি করেন, বিশেষভাবে ওয়েব উন্নয়নের জন্য ডিজাইন করা হয়েছে। বিশ্বের ৭০% এর বেশি ওয়েবসাইট ব্যবহার করে, WordPress, Facebook, Wikipedia এর মতো প্ল্যাটফর্ম চালায়। PHP 8 JIT কম্পাইল প্রবর্তন করেছে, কর্মক্ষমতা উল্লেখযোগ্যভাবে উন্নত করেছে)"

msgid "mime_image"
msgstr "ছবির ফাইল"

msgid "mime_document"
msgstr "ডকুমেন্ট ফাইল"

msgid "mime_package"
msgstr "সফটওয়্যার প্যাকেজ"

msgid "mime_archive"
msgstr "Gzip সংকুচিত ফাইল (১৯৯২ সালে GNU প্রকল্প, DEFLATE অ্যালগরিদমের ভিত্তিতে। ওয়েবে ডায়নামিক প্রতিক্রিয়া বিষয়বস্তু সংকুচিত করতে ব্যবহৃত হয়, সংকোচনের হার সাধারণত ৬০-৯০%। ২০১৫ সালের পরে কিছু ক্ষেত্রে Brotli দ্বারা প্রতিস্থাপিত হয়েছে, তবে সার্ভার পাশে সবচেয়ে ব্যাপকভাবে সমর্থিত সংকোচন ফরম্যাট হিসাবে রয়ে গেছে)"

msgid "mime_audio"
msgstr "অডিও ফাইল"

msgid "mime_video"
msgstr "ভিডিও ফাইল"

msgid "mime_jscript"
msgstr "জাভাস্ক্রিপ্ট (ব্রেন্ডান আইক ১৯৯৫ সালে তৈরি করেন)"

msgid "mime_json"
msgstr "JSON ডেটা (ডগলাস ক্রকফোর্ড ২০০১ সালে প্রস্তাব করেন, হালকা ওজনের ডেটা আদানপ্রদান ফরম্যাট, Web API এর প্রকৃত মানক)"

msgid "mime_vbs"
msgstr "VBScript (মাইক্রোসফট ১৯৯৬ সালে তৈরি করে, উইন্ডোজ স্ক্রিপ্ট ভাষা, ASP ওয়েব পৃষ্ঠা এবং উইন্ডোজ ব্যবস্থাপনা স্ক্রিপ্টের জন্য ব্যবহৃত হয়। PowerShell এবং JavaScript এর বিস্তারের সাথে ধীরে ধীরে বিলুপ্ত হয়ে গেছে)"

msgid "mime_conf"
msgstr "কনফিগারেশন ফাইল (টেক্সট ফরম্যাটে সফটওয়্যার কনফিগারেশন সংরক্ষণ করে, সাধারণ ফরম্যাট: INI, JSON, YAML, TOML, XML। Linux সিস্টেম কনফিগারেশন বেশিরভাগ /etc ডিরেক্টরিতে থাকে)"

msgid "mime_css"
msgstr "CSS স্টাইল শীট (W3C ১৯৯৬ সালের ডিসেম্বরে CSS1 প্রথম আনুষ্ঠানিক মানক প্রকাশ করে, CSS2 ১৯৯৮ সালে অবস্থান নির্ধারণ এবং মিডিয়া টাইপ যোগ করে, ২০১১ সাল থেকে CSS3 মডুলার কোণ গোলাকার করা, অ্যানিমেশন, ফ্লেক্সবক্স, গ্রিড লেআউট এবং প্রতিক্রিয়াশীল ডিজাইন প্রবর্তন করে। HTML এবং JavaScript এর সাথে front-end এর তিনটি প্রধান প্রযুক্তির একটি, সমস্ত আধুনিক ব্রাউজার (Chrome, Firefox, Safari, Edge) স্থানীয়ভাবে সমর্থন করে, ওয়েব পৃষ্ঠা শৈলী সংজ্ঞায়িত করার একমাত্র মানক)"

msgid "mime_xsl"
msgstr "XSL স্টাইল শীট (১৯৯৯ সালে W3C মানক, XML ডকুমেন্ট রূপান্তর ভাষা, XML কে HTML/PDF/টেক্সট এ রূপান্তর করতে পারে। JSON এর প্রসারের পরে ব্যবহার কমেছে)"

msgid "mime_runtime"
msgstr "এক্সিকিউটেবল ফাইল (EXE, ELF, Mach-O এর মতো অপারেটিং সিস্টেমের এক্সিকিউটেবল ফরম্যাট, মেশিন কোড এবং লোডিং তথ্য অন্তর্ভুক্ত)"

msgid "mime_library"
msgstr "লাইব্রেরি ফাইল (DLL, SO, dylib ইত্যাদি ডায়নামিক লিংক লাইব্রেরি, প্রোগ্রাম চলাকালীন লোড হওয়া ভাগ করা কোড)"

msgid "mime_swf"
msgstr "Flash অ্যানিমেশন (Macromedia ১৯৯৬ সালে তৈরি করে, পরে Adobe এর মালিকানায়। ইন্টারেক্টিভ ওয়েব অ্যানিমেশন মানক, এক সময় ইন্টারনেটে গেম এবং অ্যানিমেশনে আধিপত্য বিস্তার করেছিল। দুর্বলতা: প্লাগইন নির্ভরতা, মোবাইল সমর্থনের অভাব, উচ্চ সুরক্ষা ঝুঁকি। Adobe ২০১৭ সালে বিলুপ্তির ঘোষণা দেয়, ২০২০ সালে সম্পূর্ণ সমর্থন বন্ধ করে, HTML5/CSS3/JS দ্বারা প্রতিস্থাপিত হয়)"

msgid "mime_dtd"
msgstr "DTD (ডকুমেন্ট টাইপ ডেফিনিশন) (XML স্পেসিফিকেশন, XML ডকুমেন্ট কাঠামো সংজ্ঞায়িত করে, XML এর বৈধতা যাচাই করতে ব্যবহৃত হয়)"

msgid "mime_csv"
msgstr "CSV ডেটা ফরম্যাট (কমা দ্বারা পৃথক মান, সাধারণ টেবিল ডেটা ফরম্যাট, Excel এবং ডাটাবেস আমদানি রপ্তানি মানক)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java অ্যাপ্লিকেশন লঞ্চার, ২০০০ এর দশকে Java ডেস্কটপ অ্যাপ্লিকেশন বিতরণ প্রযুক্তি, এখন বিলুপ্ত)"

msgid "mime_lit"
msgstr "Microsoft Reader ই-বুক (মাইক্রোসফট ২০০০ সালে চালু করে, LIT ফরম্যাট, বিলুপ্ত)"

msgid "mime_svg"
msgstr "SVG ভেক্টর গ্রাফিক্স (১৯৯৯ সালে W3C মানক, মাইক্রোসফট দীর্ঘ সময় নিজস্ব VML ফরম্যাট প্রচার করার কারণে, IE ব্রাউজার ২০১১ সাল পর্যন্ত সমর্থন করে, যা প্রসার বিলম্বিত করে। ২০১৫ সালের পরে IE বিলুপ্ত হওয়ার পরে এবং উচ্চ রেজোলিউশন স্ক্রিনের প্রসারের সাথে, এটি আইকন এবং লোগোর জন্য পছন্দের ফরম্যাট হয়ে উঠেছে)"

msgid "mime_ai"
msgstr "Adobe Illustrator ভেক্টর গ্রাফিক্স (১৯৮৭ সালে চালু হয়, শিল্প মানক ভেক্টর গ্রাফিক্স ফরম্যাট, মুদ্রণ নকশা, লোগো, আইকনের জন্য পছন্দের)"

msgid "mime_phshop"
msgstr "Photoshop ছবি (Adobe ১৯৯০ সালে চালু করে, Photoshop এর মূল ফাইল ফরম্যাট PSD, ছবি প্রক্রিয়াকরণ শিল্প মানক)"

msgid "mime_ttf"
msgstr "TrueType ফন্ট (Apple এবং Microsoft ১৯৮৯ সালে যৌথভাবে তৈরি করে, ভেক্টর ফন্ট ফরম্যাট, স্ক্রিন প্রদর্শন এবং মুদ্রণ একই, আধুনিক অপারেটিং সিস্টেমের ডিফল্ট ফন্ট ফরম্যাট)"

msgid "mime_fon"
msgstr "WOFF2 ওয়েব ফন্ট (W3C ২০১৪ সালে সুপারিশ করে, Brotli সংকোচন অ্যালগরিদম ব্যবহার করে, পুরানো WOFF এর তুলনায় আকার প্রায় ৩০% কমে, TTF/OTF এর তুলনায় ৫০% এর বেশি কমে, বর্তমানে সমস্ত আধুনিক ব্রাউজার সমর্থন করে, আধুনিক ওয়েব ফন্টের জন্য পছন্দের ফরম্যাট, ৯৮% এর বেশি ব্রাউজার দ্বারা সমর্থিত)"

msgid "mime_pdf"
msgstr "PDF ডকুমেন্ট (Adobe ১৯৯৩ সালে তৈরি করে, ২০০৮ সালে ISO মানক হয়। ক্রস-প্ল্যাটফর্ম ডকুমেন্ট ফরম্যাট, ফরম্যাটের সামঞ্জস্য বজায় রাখে, ইলেকট্রনিক ডকুমেন্ট বিতরণের বিশ্বব্যাপী মানক)"

msgid "mime_dotnet"
msgstr "ASP.NET ডায়নামিক পৃষ্ঠা (মাইক্রোসফট ২০০২ সালে চালু করে, উইন্ডোজ প্ল্যাটফর্মে ডায়নামিক ওয়েব পৃষ্ঠা প্রযুক্তি, .NET ফ্রেমওয়ার্কের একটি অংশ)"

msgid "mime_mdb"
msgstr "Access ডেটাবেস (Microsoft Access ডেটাবেস ফাইল, ১৯৯২ সালে চালু হয়, উইন্ডোজ ডেস্কটপ ডেটাবেস সমাধান)"

msgid "mime_md"
msgstr "Markdown ডকুমেন্ট (জন গ্রুবার ২০০৪ সালে তৈরি করেন, সিনট্যাক্স ডিজাইন reStructuredText এবং Setext দ্বারা প্রভাবিত। মূল ডিজাইন দর্শন 'পড়া যায় এমন হওয়া মানে রেন্ডার করা যায় এমন হওয়া'। মূল বাস্তবায়ন Markdown.pl পার্ল রেগুলার এক্সপ্রেশন ব্যবহার করে। উদ্ভূত স্পেসিফিকেশনগুলির মধ্যে রয়েছে GFM (২০১৩), CommonMark (২০১৭), Pandoc Markdown ইত্যাদি। GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress এর মতো ইকোসিস্টেম চালায়, স্ট্যাটিক ওয়েবসাইট জেনারেটর এবং ডেভেলপার ডকুমেন্টেশনের জন্য ডি ফ্যাক্টো মানক ফরম্যাট হয়ে উঠেছে)"

msgid "mime_crystal"
