msgstr "অনুরোধ সময়ের পরিসর - অনুরোধ সময়ের ফ্রিকোয়েন্সি"

msgid "Payload Range - Payload Frequency"
msgstr "ফাইলের আকারের পরিসর - ফাইলের সংখ্যা"

msgid "Session range - Number of visits"
msgstr "সেশনের সময়কালের পরিসর - দর্শনের সংখ্যা"

msgid "URL with %s errors - Hits"
msgstr "%s ত্রুটি সহ URL - অনুরোধের সংখ্যা"

msgid "Last URL referrer"
msgstr "শেষ URL রেফারার"

msgid "Errors - Hits - Bandwidth"
msgstr "ত্রুটি - অনুরোধের সংখ্যা - ব্যান্ডউইথ"

msgid "Search keywords - Number of search"
msgstr "কীওয়ার্ড - অনুসন্ধানের সংখ্যা"

