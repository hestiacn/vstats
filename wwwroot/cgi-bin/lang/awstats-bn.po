msgstr "JPEG ছবি (১৯৯২ সালে ISO মানক, ফটোর জন্য ক্ষতিকর সংকোচন ফরম্যাট, ইন্টারনেটে ফটোর প্রকৃত মানক)"

msgid "mime_png"
msgstr "PNG ছবি (W3C ১৯৯৬ সালে সুপারিশ করে, সত্য রঙ এবং স্বচ্ছতা সমর্থন করে, GIF এর স্থির বিকল্প, ইন্টারনেটে ক্ষতিহীন ছবির মানক)"

msgid "mime_ps"
msgstr "PostScript পৃষ্ঠা বিবরণ ফাইল (Adobe ১৯৮৫ সালে চালু করে, পৃষ্ঠা বিবরণ ভাষা, PDF এর পূর্বসূরি, মুদ্রণ এবং প্রকাশনার জন্য ব্যবহৃত হয়)"

msgid "mime_psb"
msgstr "PSB বড় ডকুমেন্ট (Adobe Photoshop এর অতি বড় ছবি ফরম্যাট, ২ জিবি বা ৩০০০০ পিক্সেলের চেয়ে বড় বিশাল ছবি সমর্থন করে)"

msgid "mime_psd"
msgstr "PSD ছবি (Adobe Photoshop এর মূল ফাইল, স্তর, চ্যানেল, পাথ সমর্থন করে, ছবি প্রক্রিয়াকরণ শিল্প মানক ফরম্যাট)"

msgid "mime_webp"
msgstr "WebP ছবি (গুগল ২০১০ সালে তৈরি করে, ওয়েব ছবি ফরম্যাট, ক্ষতিকর/ক্ষতিহীন সংকোচন এবং অ্যানিমেশন সমর্থন করে, PNG থেকে ২৫-৩৫% এবং JPEG থেকে ২৫% বেশি সংকোচনের হার)"

msgid "mime_woff"
msgstr "WOFF ওয়েব ফন্ট (২০০৯ সালে তৈরি, ২০১৮ সালে W3C মানক। TrueType/OpenType এর ভিত্তিতে সংকুচিত, ওয়েব ফন্ট লোডিং অপ্টিমাইজেশন, আধুনিক ওয়েবসাইট আইকন ফন্টের জন্য মানক ফরম্যাট)"

msgid "mime_7z"
msgstr "7z সংকুচিত ফাইল (ইগর পাভলভ ১৯৯৯ সালে তৈরি করেন, 7-Zip প্রোগ্রামের বিশেষ ফরম্যাট। LZMA অ্যালগরিদম, উচ্চ সংকোচনের হার, ওপেন সোর্স এবং বিনামূল্যে। একই সংকোচনের হারে 7z ফরম্যাট সাধারণত ZIP থেকে ৩০-৫০% ছোট হয়, ওপেন সোর্স সম্প্রদায় এবং সফটওয়্যার বিতরণের জন্য সাধারণ ফরম্যাট)"

msgid "mime_ace"
msgstr "ACE সংকুচিত ফাইল (১৯৯০ এর দশকে তৈরি, WinACE প্রোগ্রাম ফরম্যাট। এক সময় RAR এর সাথে প্রতিযোগিতা করত, সংকোচনের হার বেশ উচ্চ ছিল। ২০০৭ সালে উন্নয়ন বন্ধ হয়, এখন 7z/RAR দ্বারা প্রতিস্থাপিত, কম ব্যবহৃত হয়)"

msgid "mime_bz2"
msgstr "BZIP2 সংকুচিত ফাইল (জুলিয়ান সেওয়ার্ড ১৯৯৬ সালে তৈরি করেন, ব্লক সাজানোর সংকোচন অ্যালগরিদম। GZIP থেকে ১৫-২০% বেশি সংকোচনের হার কিন্তু ধীর। Linux kernel সোর্স কোড, ওপেন সোর্স সফটওয়্যার প্যাকেজের জন্য সাধারণ ফরম্যাট, এক্সটেনশন .bz2)"

msgid "mime_cab"
msgstr "CAB সংকুচিত ফাইল (মাইক্রোসফট ১৯৯৫ সালে তৈরি করে, ক্যাবিনেট ফরম্যাট। উইন্ডোজ ইনস্টলেশন প্যাকেজ ফরম্যাট, ড্রাইভার, সিস্টেম ফাইল বিতরণের জন্য ব্যবহৃত হয়। উইন্ডোজ ইনস্টলার (MSI) ফাইল সংরক্ষণের জন্য অভ্যন্তরীণভাবে CAB ব্যবহার করে)"

msgid "mime_dmg"
msgstr "DMG ডিস্ক ইমেজ (Apple ১৯৮০ এর দশকে চালু করে, ডিস্ক ইমেজ ফরম্যাট। macOS সফটওয়্যার বিতরণ মানক ফরম্যাট, ভার্চুয়াল ডিস্ক হিসাবে মাউন্ট করতে ডাবল-ক্লিক করুন, অ্যাপ্লিকেশন ইনস্টল করতে টেনে এনে ফেলে দিন। সংকোচন এবং এনক্রিপশন সমর্থন করে, ম্যাক সফটওয়্যার ডাউনলোডের জন্য প্রধান ফরম্যাট)"

msgid "mime_emz"
msgstr "EMZ সংকুচিত ছবি (উইন্ডোজ সংকুচিত বর্ধিত মেটাফাইল, EMF এর সংকুচিত সংস্করণ। অফিস ডকুমেন্টে ভেক্টর গ্রাফিক্স স্টোরেজ ফরম্যাট, মূলত GZIP সংকুচিত EMF ফাইল)"

msgid "mime_gz"
msgstr "GZIP সংকুচিত ফাইল (জিন-লুপ গেইলি এবং মার্ক অ্যাডলার ১৯৯২ সালে তৈরি করেন, GNU প্রকল্প। ইউনিক্স/লিনাক্সের মানক সংকোচন সরঞ্জাম, HTTP ট্রান্সমিশন সংকোচনের জন্য সাধারণ ফরম্যাট। এক্সটেনশন .gz, প্রায়শই TAR এর সাথে সংমিশ্রণে ব্যবহৃত হয়)"

msgid "mime_jar"
msgstr "JAR সংকুচিত ফাইল (সান মাইক্রোসিস্টেম ১৯৯৭ সালে চালু করে, Java ARchive ফরম্যাট। মূলত ZIP ফাইল, Java লাইব্রেরি এবং অ্যাপ্লিকেশন প্যাকেজ করতে ব্যবহৃত হয়। Maven, Gradle এর মতো Java ইকোসিস্টেমের প্রধান ফরম্যাট, Android ও JAR ব্যবহার করে)"

msgid "mime_lzma"
msgstr "LZMA সংকুচিত ফাইল (ইগর পাভলভ ১৯৯৮ সালে তৈরি করেন, Lempel-Ziv-Markov chain অ্যালগরিদম। 7z ফরম্যাটের প্রধান সংকোচন অ্যালগরিদম, উচ্চ সংকোচনের হার, ডিকম্প্রেশন গতি দ্রুত। ফার্মওয়্যার এবং এম্বেডেড সিস্টেম সফটওয়্যার বিতরণের জন্য ব্যবহৃত হয়)"

msgid "mime_rar"
msgstr "RAR সংকুচিত ফাইল (ইউজিন রোশাল ১৯৯৩ সালে তৈরি করেন, Roshal ARchive ফরম্যাট। উচ্চ সংকোচনের হার, ভলিউম বিভাজন এবং পুনরুদ্ধার রেকর্ড সমর্থন করে। WinRAR প্রোগ্রাম ফরম্যাট, সংকোচনের হার ZIP থেকে ভাল কিন্তু পেমেন্ট সফটওয়্যার প্রয়োজন, unrar এর মতো ওপেন সোর্স সরঞ্জাম ডিকম্প্রেস করতে পারে)"

msgid "mime_tar"
msgstr "TAR আর্কাইভ ফাইল (ইউনিক্স V7 ১৯৭৯ সালে প্রবর্তন করে, টেপ আর্কাইভ ফরম্যাট। টেপ আর্কাইভ ফরম্যাট, সংকুচিত করে না শুধু প্যাকেজ করে, প্রায়শই GZIP/BZIP2/XZ এর সাথে সংমিশ্রণে ব্যবহৃত হয়। Linux প্যাকেজ সোর্স কোড, ডকার ইমেজ লেয়ার স্টোরেজ সব TAR ফরম্যাট ব্যবহার করে)"

msgid "mime_tgz"
msgstr "TGZ সংকুচিত ফাইল (TAR + GZIP সংমিশ্রণ ফরম্যাট, এক্সটেনশন .tgz বা .tar.gz। ইউনিক্স/লিনাক্স সফটওয়্যার প্যাকেজের জন্য সবচেয়ে সাধারণ বিতরণ ফরম্যাট, সোর্স কোড প্যাকেজ, বাইনারি প্যাকেজ, ব্যাপকভাবে ব্যবহৃত হয়, 'ডিকম্প্রেস করুন এবং ব্যবহার করুন' এর প্রতিনিধি)"

msgid "mime_tbz2"
msgstr "TBZ2 সংকুচিত ফাইল (TAR + BZIP2 সংমিশ্রণ ফরম্যাট, এক্সটেনশন .tbz2 বা .tar.bz2। TGZ থেকে ১৫-২০% বেশি সংকোচনের হার, বড় ফাইল বিতরণের জন্য উপযুক্ত, Linux kernel দীর্ঘ সময় ধরে এই ফরম্যাট ব্যবহার করে আসছে)"

msgid "mime_xz"
msgstr "XZ সংকুচিত ফাইল (২০০৯ সালে চালু হয়, LZMA2 অ্যালগরিদমের ভিত্তিতে। অত্যন্ত উচ্চ সংকোচনের হার, GZIP থেকে ৩০-৫০% বেশি, ডিকম্প্রেশন গতি তুলনামূলকভাবে দ্রুত। Linux kernel, প্যাকেজ ম্যানেজার (যেমন ডেবিয়ানের .deb এর ভিতরে) ব্যাপকভাবে ব্যবহার করে, বর্তমান Linux ইকোসিস্টেমে সুপারিশকৃত ফরম্যাট)"

msgid "mime_z"
msgstr "Z সংকুচিত ফাইল (১৯৮৫ সালে ইউনিক্স compress কমান্ড ফরম্যাট, LZW অ্যালগরিদম। প্রাথমিক ইউনিক্স সংকোচন ফরম্যাট, GZIP দ্বারা প্রতিস্থাপিত। এক্সটেনশন .Z, আধুনিক সিস্টেমে কম ব্যবহৃত হয়)"

msgid "mime_zip"
msgstr "ZIP সংকুচিত ফাইল (ফিল কাটজ ১৯৮৯ সালে তৈরি করেন, PKZIP ফরম্যাট। উইন্ডোজে স্থানীয়ভাবে সমর্থিত, ইন্টারনেটে সবচেয়ে সাধারণ সংকোচন ফরম্যাট। একাধিক ফাইল, ডিরেক্টরি কাঠামো সমর্থন করে, সংকোচন অ্যালগরিদম নির্বাচন করতে পারে। Java এর JAR, Android এর APK, অফিস ডকুমেন্টের DOCX/XLSX সব ZIP ফরম্যাটের ভিত্তিতে তৈরি)"

msgid "mime_zst"
msgstr "Zstandard সংকুচিত ফাইল (ফেসবুক ২০১৫ সালে তৈরি করে, ইয়ান কোলেট ডিজাইন করেন। উচ্চ-গতির সংকোচন অ্যালগরিদম, সংকোচনের হার LZMA এর কাছাকাছি, গতি GZIP থেকে অনেক বেশি। লিনাক্স কার্নেল 5.9+ সমর্থন করে, আর্চ লিনাক্স pacman, ডেবিয়ান APT ধীরে ধীরে গ্রহণ করছে, নতুন প্রজন্মের সংকোচন মানক)"

msgid "mime_lz4"
msgstr "LZ4 সংকুচিত ফাইল (ইয়ান কোলেট ২০১১ সালে তৈরি করেন, অত্যন্ত দ্রুত সংকোচন অ্যালগরিদম। সংকোচনের গতি GZIP থেকে ১০ গুণের বেশি দ্রুত, রিয়েল-টাইম সংকোচন পরিস্থিতির জন্য উপযুক্ত। লিনাক্স কার্নেল, OpenZFS, Hadoop ব্যাপকভাবে ব্যবহার করে, গতি-অগ্রাধিকার পরিস্থিতির জন্য প্রথম পছন্দ)"

msgid "mime_lzo"
msgstr "LZO সংকুচিত ফাইল (মার্কাস ওবারহিউমার ১৯৯৬ সালে তৈরি করেন, Lempel-Ziv-Oberhumer অ্যালগরিদম। ডিকম্প্রেশন গতি অত্যন্ত দ্রুত, সংকোচনের হার সাধারণ। লিনাক্স কার্নেল Squashfs, OpenWrt ফার্মওয়্যার ব্যবহার করে, এম্বেডেড সিস্টেমের জন্য উপযুক্ত)"

msgid "mime_msi"
msgstr "MSI ইনস্টলেশন প্যাকেজ (মাইক্রোসফট ১৯৯৯ সালে চালু করে, উইন্ডোজ ইনস্টলার প্যাকেজ ফরম্যাট। উইন্ডোজ অ্যাপ্লিকেশন ইনস্টলেশন মানক ফরম্যাট, লেনদেন রোলব্যাক, কম্পোনেন্ট ম্যানেজমেন্ট, নীরব ইনস্টলেশন সমর্থন করে। এন্টারপ্রাইজ-স্তরের সফটওয়্যার বিতরণের জন্য প্রথম পছন্দের ফরম্যাট, এখনও উইন্ডোজ সফটওয়্যার ইনস্টলেশনের জন্য মূলধারার ফরম্যাট)"

msgid "mime_pkg"
msgstr "PKG ইনস্টলেশন প্যাকেজ (macOS অ্যাপ্লিকেশন ইনস্টলেশন প্যাকেজ ফরম্যাট, Apple এর ইনস্টলার প্রযুক্তির ভিত্তিতে। macOS সফটওয়্যার বিতরণ মানক ফরম্যাট, কম্পোনেন্ট নির্বাচন, ইনস্টলেশন স্ক্রিপ্ট, আনইনস্টল ফাংশন সমর্থন করে। .pkg ফাইল ডাবল-ক্লিক করে ইনস্টল করুন, ম্যাক অ্যাপ স্টোরের বাইরের সফটওয়্যারের জন্য সাধারণ বিতরণ পদ্ধতি)"

msgid "mime_apk"
msgstr "এপিকে অ্যান্ড্রয়েড অ্যাপ্লিকেশন প্যাকেজ (২০০৮ সালে গুগল চালু করে, অ্যান্ড্রয়েড সিস্টেমের ঐতিহ্যবাহী অ্যাপ্লিকেশন ইনস্টলেশন ফরম্যাট। এপিকে মূলত একটি জিপ প্যাকেজ, যা কোড, রিসোর্স এবং ম্যানিফেস্ট ফাইল ধারণ করে। ২০২১ সাল থেকে গুগল প্লে নতুন অ্যাপ্লিকেশনগুলিকে এএবি ফরম্যাট ব্যবহার করতে বাধ্য করে, কিন্তু এপিকে এখনও ডিবাগিং, তৃতীয়-পক্ষের স্টোর এবং সাইড-লোডিংয়ের জন্য ব্যবহৃত হয়)"

msgid "mime_ipa"
msgstr "আইপিএ অ্যাপল অ্যাপ্লিকেশন প্যাকেজ (আইওএস অ্যাপ স্টোর প্যাকেজ, আইওএস/আইপ্যাডওএস অ্যাপ্লিকেশন ইনস্টলেশন ফরম্যাট। ২০০৮ সালে আইফোন এসডিকে সহ চালু হয়। অ্যাপ স্টোরের মাধ্যমে বিতরণ করতে হবে বা এন্টারপ্রাইজ সার্টিফিকেট দিয়ে স্বাক্ষর করতে হবে। এক্সিকিউটেবল ফাইল, রিসোর্স, ইনফো.পিএলআইস্ট এবং স্বাক্ষরের তথ্য ধারণ করে)"

msgid "mime_hap"
msgstr "এইচএপি হারমনিওএস অ্যাপ্লিকেশন প্যাকেজ (হারমনিওএস অ্যাবিলিটি প্যাকেজ, হারমনিওএস অ্যাপ্লিকেশনের মৌলিক একক। ২০২০ সালে হারমনিওএস ২.০ সহ চালু হয়। এন্ট্রি এবং ফিচার নামে দুটি ধরন সমর্থন করে, হুয়াওয়ে ফোন, ট্যাবলেট, স্মার্টওয়াচ এবং অন্যান্য হারমনিওএস ডিভাইসের জন্য বিতরণ ফরম্যাট)"

msgid "mime_har"
msgstr "এইচএআর হারমনিওএস স্ট্যাটিক শেয়ার্ড লাইব্রেরি (হারমনিওএস আর্কাইভ, হারমনিওএসের স্ট্যাটিক শেয়ার্ড লাইব্রেরি, একাধিক এইচএপি প্যাকেজের দ্বারা ভাগ করা যায়, কম্পোনেন্ট-ভিত্তিক উন্নয়ন এবং মডিউল পুনঃব্যবহারের জন্য ব্যবহৃত)"

msgid "mime_aab"
msgstr "Android App Bundle (গুগল ২০১৮ সালে চালু করে, ২০২১ সাল থেকে গুগল প্লেতে নতুন অ্যাপ্লিকেশন এই ফরম্যাট ব্যবহার করতে বাধ্য। AAB বিতরণ ফরম্যাট, গুগল প্লে ডিভাইস কনফিগারেশন (সিপিইউ আর্কিটেকচার, স্ক্রিন ঘনত্ব, ভাষা) অনুসারে অনুকূলিত APK তৈরি করে, প্যাকেজের আকার গড়ে ৩৫% হ্রাস পায়। ডেভেলপার AAB আপলোড করে, ব্যবহারকারী APK ডাউনলোড করে)"

msgid "mime_xapk"
msgstr "XAPK অ্যাপ্লিকেশন প্যাকেজ (তৃতীয়-পক্ষের Android অ্যাপ্লিকেশন এক্সটেনশন প্যাকেজ, APK + OBB ডেটা ফাইল ধারণ করে। বড় গেম এবং জটিল অ্যাপ্লিকেশনের জন্য ব্যবহৃত হয়, একক-ফাইল APK এর ১০০MB সীমা সমাধান করে। APKPure, APKMirror এর মতো তৃতীয়-পক্ষের অ্যাপ্লিকেশন স্টোরে সাধারণত পাওয়া যায়, গুগলের অফিসিয়াল ফরম্যাট নয়)"

msgid "mime_appx"
msgstr "উইন্ডোজ অ্যাপ্লিকেশন প্যাকেজ (মাইক্রোসফট ২০১২ সালে চালু করে, উইন্ডোজ 8/10/11 অ্যাপ্লিকেশন ইনস্টলেশন ফরম্যাট। UWP অ্যাপ্লিকেশন এবং ডেস্কটপ অ্যাপ্লিকেশন রূপান্তর সমর্থন করে, মাইক্রোসফট স্টোরের মাধ্যমে বিতরণ করা হয়। ২০২৪ সালে মাইক্রোসফট MSIX কে উত্তরসূরি ফরম্যাট হিসাবে চালু করে, ধীরে ধীরে APPX প্রতিস্থাপন করছে)"

msgid "mime_msix"
msgstr "MSIX অ্যাপ্লিকেশন প্যাকেজ (মাইক্রোসফট ২০১৮ সালে চালু করে, উইন্ডোজের নতুন প্রজন্মের অ্যাপ্লিকেশন প্যাকেজিং ফরম্যাট। APPX এবং MSI এর সুবিধাগুলি একত্রিত করে, সমস্ত উইন্ডোজ অ্যাপ্লিকেশন টাইপ সমর্থন করে, মাইক্রোসফট স্টোর বা সাইড-লোডের মাধ্যমে বিতরণ করা যেতে পারে, উইন্ডোজ 11 এর জন্য সুপারিশকৃত ফরম্যাট)"

msgid "mime_appimage"
msgstr "AppImage অ্যাপ্লিকেশন প্যাকেজ (২০০৪ সালে চালু হয়, Linux ইনস্টলেশন-মুক্ত অ্যাপ্লিকেশন ফরম্যাট। 'এক অ্যাপ্লিকেশন একটি ফাইল', ইনস্টলেশন ছাড়াই সরাসরি চলে, অধিকাংশ Linux ডিস্ট্রিবিউশন সমর্থন করে, ডেভেলপারদের জন্য Linux সফটওয়্যার বিতরণের সাধারণ পদ্ধতি)"

msgid "mime_flatpak"
msgstr "Flatpak অ্যাপ্লিকেশন প্যাকেজ (২০১৫ সালে চালু হয়, Linux স্যান্ডবক্স অ্যাপ্লিকেশন ফরম্যাট। ডিস্ট্রিবিউশন জুড়ে চলে, হোস্ট সিস্টেম থেকে পৃথক, Fedora, Red Hat দ্বারা নেতৃত্বাধীন উন্নয়ন, GNOME সফটওয়্যার সেন্টারের ডিফল্ট ফরম্যাট)"

msgid "mime_snap"
msgstr "Snap অ্যাপ্লিকেশন প্যাকেজ (ক্যানোনিকাল ২০১৪ সালে চালু করে, উবুন্টুর মূল সংস্থা তৈরি করে, Linux সাধারণ অ্যাপ্লিকেশন ফরম্যাট। স্বয়ংক্রিয় আপডেট, স্যান্ডবক্স বিচ্ছিন্নতা, ৪০+ Linux ডিস্ট্রিবিউশন সমর্থন করে, উবুন্টু সফটওয়্যার সেন্টারের ডিফল্ট ফরম্যাট)"

msgid "mime_deb"
msgstr "Debian সফটওয়্যার প্যাকেজ (ডেবিয়ান প্রকল্প ১৯৯৩ সালে চালু করে, ডেবিয়ান/উবুন্টু এবং তাদের উদ্ভূত সংস্করণগুলির জন্য মানক ইনস্টলেশন ফরম্যাট। dpkg দ্বারা পরিচালিত, APT এর প্যাকেজ ম্যানেজার ফ্রন্ট-এন্ড, Linux ইকোসিস্টেমের সবচেয়ে পরিপক্ক প্যাকেজ ফরম্যাটগুলির মধ্যে একটি, এখনও ডেবিয়ান পরিবারে মূলধারার ফরম্যাট)"

msgid "mime_rpm"
msgstr "RPM সফটওয়্যার প্যাকেজ (রেড হ্যাট ১৯৯৭ সালে চালু করে, রেড হ্যাট/ফেডোরা/সেন্টওএস/সুসের মতো ডিস্ট্রিবিউশনের জন্য মানক ফরম্যাট। RPM এর পূর্ণরূপ 'রেড হ্যাট প্যাকেজ ম্যানেজার', DEB এর সাথে Linux এর দুটি প্রধান প্যাকেজ ফরম্যাটের একটি, এখনও RHEL পরিবারে মূলধারার ফরম্যাট)"

msgid "mime_pacman"
msgstr "Arch সফটওয়্যার প্যাকেজ (আর্চ লিনাক্স ২০০২ সালে চালু করে, pacman প্যাকেজ ম্যানেজার দ্বারা ব্যবহৃত .pkg.tar.zst ফরম্যাট। আর্চ লিনাক্স রোলিং রিলিজের মূল, সরলতা এবং KISS নীতির জন্য বিখ্যাত, AUR (Arch ব্যবহারকারী সংগ্রহস্থল) এর বৈশিষ্ট্য)"

msgid "mime_exe"
msgstr "EXE এক্সিকিউটেবল ফাইল (উইন্ডোজ এক্সিকিউটেবল প্রোগ্রাম ফরম্যাট, 'Executable' এর সংক্ষিপ্ত রূপ। উইন্ডোজ অপারেটিং সিস্টেমের স্থানীয় এক্সিকিউশন ফরম্যাট, PE কাঠামো অন্তর্ভুক্ত। MS-DOS এর MZ ফরম্যাট থেকে বিবর্তিত, ১৯৯৩ সালে উইন্ডোজ এনটি PE (পোর্টেবল এক্সিকিউটেবল) ফরম্যাট প্রবর্তন করে এবং আজ পর্যন্ত ব্যবহার করছে। সফটওয়্যার ইনস্টলেশন প্যাকেজ, অ্যাপ্লিকেশন, সিস্টেম সরঞ্জাম সব এই ফরম্যাট ব্যবহার করে। ব্যবহারকারী ডাবল-ক্লিক করে চালায়, বিশ্বের সবচেয়ে ব্যাপকভাবে ব্যবহৃত এক্সিকিউটেবল ফরম্যাট)"

msgid "mime_dll"
msgstr "DLL ডায়নামিক লিংক লাইব্রেরি (মাইক্রোসফট ১৯৯৩ সালে চালু করে, ডায়নামিক লিংক লাইব্রেরি। উইন্ডোজের ভাগ করা কোড লাইব্রেরি, প্রোগ্রাম চলাকালীন ডায়নামিকভাবে লোড হয়, মেমরি এবং ডিস্ক স্থান বাঁচায়। সিস্টেম কম্পোনেন্ট, অ্যাপ্লিকেশন প্লাগইন, ড্রাইভার সব DLL ফরম্যাট ব্যবহার করে। উইন্ডোজ এপিআই এর প্রধান বাস্তবায়ন পদ্ধতি, DLL Hell সমস্যা .NET যুগে প্রশমিত হয়েছে)"

msgid "mime_com"
msgstr "COM এক্সিকিউটেবল ফাইল (MS-DOS যুগের এক্সিকিউটেবল ফরম্যাট, 'Command' এর সংক্ষিপ্ত রূপ। ফাইল কাঠামো সরল, ৬৪KB সীমা, উইন্ডোজ 3.x এর আগে প্রধান ফরম্যাট ছিল, বিলুপ্ত। আধুনিক উইন্ডোজ EXE ফরম্যাট ব্যবহার করে, COM এক্সটেনশন এখনও কিছু কম্পোনেন্ট ফাইলের জন্য ব্যবহৃত হয়)"

msgid "mime_aac"
msgstr "AAC অডিও (১৯৯৭ সালে MPEG মানক, অ্যাডভান্সড অডিও কোডিং। MP3 এর উত্তরসূরি, একই বিট রেটে MP3 থেকে ভাল অডিও গুণমান, YouTube, iTunes, নিন্টেন্ডো সুইচের ডিফল্ট অডিও ফরম্যাট)"

msgid "mime_alac"
msgstr "ALAC অডিও (অ্যাপল ২০০৪ সালে তৈরি করে, অ্যাপল লসলেস অডিও কোডেক। অ্যাপলের ক্ষতিহীন ফরম্যাট, ২০১১ সালে ওপেন সোর্স হয়, iTunes এবং অ্যাপল মিউজিকে ক্ষতিহীন অডিওর জন্য ডিফল্ট ফরম্যাট)"

msgid "mime_flac"
msgstr "FLAC অডিও (Xiph.Org ফাউন্ডেশন ২০০১ সালে তৈরি করে, ফ্রি লসলেস অডিও কোডেক। ক্ষতিহীন সংকোচন, অডিও গুণমান সিডির সমান, ফাইলের আকার মূল WAV এর প্রায় অর্ধেক। ওপেন সোর্স এবং পেটেন্ট-মুক্ত, অডিও উত্সাহী এবং ডিজিটাল সঙ্গীত সংগ্রহের জন্য প্রথম পছন্দের ফরম্যাট)"

msgid "mime_mp3"
msgstr "MP3 অডিও (ফ্রাউনহোফার ইনস্টিটিউট ১৯৯৩ সালে তৈরি করে, MPEG-1 অডিও লেয়ার 3। ক্ষতিকর সংকোচন ফরম্যাট, ছোট ফাইল কিন্তু গ্রহণযোগ্য অডিও গুণমান, ২০০০ এর দশকের ডিজিটাল সঙ্গীত বিপ্লবের প্রধান ফরম্যাট, আইপড এবং ন্যাপস্টারের অবদানকারী। পেটেন্ট ২০১৭ সালে মেয়াদোত্তীর্ণ হয়, পাবলিক ডোমেইন ফরম্যাট হয়ে যায়)"

msgid "mime_oga"
msgstr "Ogg Audio অডিও (Xiph.Org ফাউন্ডেশন দ্বারা তৈরি, Ogg কন্টেইনারের বিশুদ্ধ অডিও ফরম্যাট, Vorbis কোডেক ব্যবহার করে। ওপেন সোর্স এবং পেটেন্ট-মুক্ত, সংকোচন দক্ষতা MP3 থেকে ভাল, ওপেন সোর্স প্রকল্পে ব্যাপকভাবে ব্যবহৃত হয়)"

msgid "mime_ogg"
msgstr "OGG অডিও (Xiph.Org ফাউন্ডেশন ২০০০ সালে তৈরি করে, Ogg Vorbis ফরম্যাট। ওপেন সোর্স এবং পেটেন্ট-মুক্ত, সংকোচন দক্ষতা MP3 থেকে ভাল, প্রাথমিক Spotify এটি ব্যবহার করত, গেম অডিও ইফেক্টে ব্যাপকভাবে ব্যবহৃত হয়)"

msgid "mime_opus"
msgstr "Opus অডিও (IETF ২০১২ সালে মানীকৃত করে, ওপেন সোর্স এবং পেটেন্ট-মুক্ত অডিও ফরম্যাট, SILK এবং CELT প্রযুক্তির সমন্বয়, খুব কম বিলম্ব, সর্বোচ্চ সংকোচন দক্ষতা, WebRTC, WhatsApp, Discord এর ডিফল্ট অডিও ফরম্যাট)"

msgid "mime_wav"
msgstr "WAV অডিও (মাইক্রোসফট এবং আইবিএম ১৯৯১ সালে তৈরি করে, উইন্ডোজের স্থানীয় অডিও ফরম্যাট। PCM এনকোডিং, সংকুচিত নয়, ক্ষতিহীন অডিও গুণমান কিন্তু ফাইল খুব বড়, পেশাদার অডিও সম্পাদনার জন্য মানক ফরম্যাট)"

msgid "mime_wma"
msgstr "WMA অডিও (মাইক্রোসফট ১৯৯৯ সালে তৈরি করে, উইন্ডোজ মিডিয়া অডিও। ক্ষতিকর/ক্ষতিহীন উভয় সংস্করণ রয়েছে, উইন্ডোজে স্থানীয়ভাবে সমর্থিত, উইন্ডোজ মিডিয়া প্লেয়ারের সাথে ছড়িয়ে পড়ে। এখন প্রান্তিক হয়ে গেছে, MP3/AAC দ্বারা প্রতিস্থাপিত)"

msgid "mime_dsf"
msgstr "DSF অডিও (ডাইরেক্ট স্ট্রিম ডিজিটাল ফরম্যাট, সনি এবং ফিলিপস দ্বারা তৈরি। ১-বিট উচ্চ নমুনা হার, DSD অডিও মানক ফরম্যাট, SACD এর ডিজিটাল সংস্করণ, অডিও উত্সাহীদের জন্য উচ্চ-স্তরের অডিও ফরম্যাট, ফাইল খুব বড়)"

msgid "mime_ape"
msgstr "APE অডিও (2000 সালে Monkey's Audio দ্বারা বিকশিত, লসলেস কম্প্রেশন ফরম্যাট। FLAC-এর চেয়ে উচ্চতর কম্প্রেশন কিন্তু ধীর এনকোডিং, এখনও উইন্ডোজ প্ল্যাটফর্ম এবং সঙ্গীত উত্সাহীদের মধ্যে ব্যবহৃত হচ্ছে)"

msgid "mime_mid"
msgstr "MIDI অডিও (MIDI অ্যাসোসিয়েশন ১৯৮৩ সালে নির্ধারণ করে, মিউজিক্যাল ইন্সট্রুমেন্ট ডিজিটাল ইন্টারফেস। রেকর্ডিং নয় বরং সঙ্গীত নোট ফরম্যাট, ফাইল খুব ছোট, ইলেকট্রনিক বাদ্যযন্ত্র, ফোন রিংটোন, গেম অডিও ইফেক্টের জন্য মানক। জেনারেল MIDI ১৯৯১ সালে মানীকৃত হয়, ১২৮টি বাদ্যযন্ত্রের শব্দ সংজ্ঞায়িত করে)"

msgid "mime_m4a"
msgstr "M4A অডিও (MPEG-4 অডিও, AAC এর কন্টেইনার ফরম্যাট। আইটিউনস মিউজিক স্টোরের মানক ফরম্যাট, অ্যাপল ইকোসিস্টেমের প্রধান অডিও ফরম্যাট, DRM সুরক্ষা সমর্থন করে)"

msgid "mime_m3u"
msgstr "M3U প্লেলিস্ট (MP3 URL প্লেলিস্ট ফরম্যাট, প্লেইন টেক্সট ফাইল, অডিও ফাইল পাথ রেকর্ড করে। উইনাম্প যুগের মানক, অনলাইন রেডিও, অনলাইন মিউজিক স্ট্রিমিংয়ের জন্য ব্যবহৃত হয়। M3U8 এর UTF-8 সংস্করণ, HTTP লাইভ স্ট্রিমিংয়ের জন্য ব্যবহৃত হয়)"

msgid "mime_asf"
msgstr "ASF স্ট্রিমিং মিডিয়া (মাইক্রোসফট ১৯৯৬ সালে তৈরি করে, অ্যাডভান্সড সিস্টেম ফরম্যাট। উইন্ডোজ মিডিয়া স্ট্রিমিং কন্টেইনার, অডিও এবং ভিডিও সমলয় ট্রান্সমিশন সমর্থন করে। অনলাইন লাইভ সম্প্রচার এবং ভিডিও-অন-ডিমান্ড স্ট্রিমিংয়ের জন্য ব্যবহৃত হয়, WMA/WMV উভয়ই ASF কন্টেইনারের ভিত্তিতে তৈরি)"

msgid "mime_avi"
msgstr "AVI ভিডিও (মাইক্রোসফট ১৯৯২ সালে চালু করে, উইন্ডোজের প্রাথমিক ভিডিও মানক। 'অডিও ভিডিও ইন্টারলিভ', অডিও এবং ভিডিও পর্যায়ক্রমে সংরক্ষণ করে, ১৯৯০-২০০০ এর দশকে সবচেয়ে জনপ্রিয় ভিডিও ফরম্যাট ছিল, এখন MP4/MKV দ্বারা প্রতিস্থাপিত)"

msgid "mime_divx"
msgstr "DivX ভিডিও (DivX কর্পোরেশন ১৯৯৮ সালে তৈরি করে, MPEG-4 এর ভিত্তিতে ভিডিও কোডেক ফরম্যাট। ২০০০ এর দশকের অনলাইন ভিডিও ভাগাভাগির প্রধান ফরম্যাট, ডিভিডি কোয়ালিটি সিডি আকারে সংকুচিত করার প্রথম প্রযুক্তি। কপিরাইট বিরোধের কারণে, পরে বাণিজ্যিক এনকোডারে রূপান্তরিত হয়)"

msgid "mime_mp4"
msgstr "MP4 ভিডিও (২০০১ সালে MPEG মানক, MPEG-4 পার্ট 14। বিশ্বের সবচেয়ে সাধারণ ভিডিও ফরম্যাট, H.264/H.265 এনকোডিং সমর্থন করে, ইন্টারনেট ভিডিও, ফোন রেকর্ডিং, ইউটিউবের ডিফল্ট ফরম্যাট)"

msgid "mime_m4v"
msgstr "M4V ভিডিও (আইটিউনসের ভিডিও ফরম্যাট, MP4 এর একটি ভিন্নতা। অ্যাপল ইকোসিস্টেমের ভিডিও ফরম্যাট, আইটিউনস স্টোরের চলচ্চিত্র এবং টেলিভিশন অনুষ্ঠানের মানক ফরম্যাট, DRM কপিরাইট সুরক্ষা সমর্থন করে)"

msgid "mime_mpeg"
msgstr "MPEG ভিডিও (MPEG সংস্থা ১৯৮৮ সালে নির্ধারণ করে, মুভিং পিকচার এক্সপার্ট গ্রুপ। ডিজিটাল ভিডিও সংকোচন মানকগুলির ভিত্তি স্থাপনকারী, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (অনলাইন ভিডিও) গভীর প্রভাব ফেলেছে)"

msgid "mime_mkv"
msgstr "MKV ভিডিও (মাত্রোস্কা প্রকল্প ২০০২ সালে তৈরি করে, ওপেন সোর্স মাল্টিমিডিয়া কন্টেইনার ফরম্যাট। একাধিক অডিও ট্র্যাক, একাধিক সাবটাইটেল, অধ্যায় সমর্থন করে, 'র্যাপার টুল', উচ্চ-রেজোলিউশন চলচ্চিত্র ভাগাভাগির জন্য প্রথম পছন্দের ফরম্যাট)"

msgid "mime_mpg"
msgstr "MPEG ভিডিও (MPEG-1/MPEG-2 ভিডিও এক্সটেনশন, VCD এবং DVD এর জন্য মানক ফরম্যাট। ১৯৯০-২০০০ এর দশকে ডিস্কে ভিডিওর প্রধান ফরম্যাট ছিল, এখন H.264/H.265 দ্বারা প্রতিস্থাপিত)"

msgid "mime_ogv"
msgstr "Ogg Video ভিডিও (Xiph.Org ফাউন্ডেশন দ্বারা তৈরি, Ogg কন্টেইনারের ভিডিও ফরম্যাট, থিওরা কোডেক ব্যবহার করে। ওপেন সোর্স এবং পেটেন্ট-মুক্ত, HTML5 ভিডিওর প্রাথমিক মানকগুলির মধ্যে একটি, ফায়ারফক্স স্থানীয়ভাবে সমর্থন করে)"

msgid "mime_ogx"
msgstr "Ogg মাল্টিমিডিয়া কন্টেইনার (Xiph.Org ফাউন্ডেশন দ্বারা তৈরি, Ogg কন্টেইনারের সাধারণ এক্সটেনশন, অডিও, ভিডিও, সাবটাইটেলের মতো একাধিক ট্র্যাক ধারণ করতে পারে। ওপেন সোর্স মাল্টিমিডিয়া মানক, গেম, স্ট্রিমিংয়ের জন্য ব্যবহৃত হয়)"

msgid "mime_rm"
msgstr "রিয়েল মিডিয়া ভিডিও (রিয়েল নেটওয়ার্কস ১৯৯৫ সালে তৈরি করে, রিয়েল মিডিয়া ফরম্যাট। ১৯৯০-২০০০ এর দশকে অনলাইন স্ট্রিমিংয়ের অগ্রদূত, রিয়েল প্লেয়ারের প্রধান ফরম্যাট। দুর্বলতা: বিশেষ প্লেয়ার প্রয়োজন, দুর্বল সংকোচনের গুণমান, পরে Flash/MP4 দ্বারা প্রতিস্থাপিত)"

msgid "mime_flv"
msgstr "Flash ভিডিও (২০০২ সালে ফরম্যাট দেখা দেয়, ফ্ল্যাশ ভিডিও ফরম্যাট। এক সময় অনলাইন ভিডিওর প্রধান ফরম্যাট ছিল, প্রাথমিক YouTube এটি ব্যবহার করত। দুর্বলতা: Flash প্লাগইনের প্রয়োজন, দুর্বল কর্মক্ষমতা, অনেক সুরক্ষা দুর্বলতা। ২০১৫ সাল থেকে প্রধান ওয়েবসাইটগুলি HTML5 ভিডিওতে স্যুইচ করেছে, এখন বিলুপ্ত)"

msgid "mime_f4v"
msgstr "F4V ভিডিও (Adobe দ্বারা তৈরি Flash ভিডিও ফরম্যাট, FLV এর উত্তরসূরি। MPEG-4 মানকের ভিত্তিতে, H.264 এনকোডিং সমর্থন করে। Flash প্রযুক্তির সাথে বিলুপ্ত, Adobe ২০২০ সালে সমর্থন বন্ধ করে)"

msgid "mime_wmv"
msgstr "WMV ভিডিও (মাইক্রোসফট ১৯৯৯ সালে তৈরি করে, উইন্ডোজ মিডিয়া ভিডিও। উইন্ডোজে স্থানীয়ভাবে সমর্থিত, স্ট্রিমিং ট্রান্সমিশনের জন্য অনুকূলিত, প্রাথমিক অনলাইন ভিডিওতে সাধারণ ফরম্যাট ছিল, এখন প্রান্তিক হয়ে গেছে)"

msgid "mime_wmf"
msgstr "WMF মিডিয়া ফরম্যাট (উইন্ডোজ মিডিয়া ফরম্যাট, মাইক্রোসফটের মিডিয়া ফ্রেমওয়ার্ক, WMV ভিডিও, WMA অডিও অন্তর্ভুক্ত, উইন্ডোজ মিডিয়া প্লেয়ার দ্বারা স্থানীয়ভাবে সমর্থিত)"

msgid "mime_mov"
msgstr "MOV ভিডিও (অ্যাপল ১৯৯১ সালে তৈরি করে, কুইকটাইম কন্টেইনার ফরম্যাট। পেশাদার ভিডিও সম্পাদনার জন্য মানক ফরম্যাট, একাধিক কোডেক সমর্থন করে, ফাইনাল কাট প্রো, প্রিমিয়ার দ্বারা স্থানীয়ভাবে সমর্থিত)"

msgid "mime_qt"
msgstr "কুইকটাইম ভিডিও (অ্যাপল ১৯৯১ সালে চালু করে, কুইকটাইম ফরম্যাট। ম্যাক প্ল্যাটফর্মের ভিডিও মানক, MOV এর কন্টেইনার, কুইকটাইম প্লেয়ার এক সময় ব্যাপকভাবে ব্যবহৃত হত। অ্যাপল ২০১৬ সালে উইন্ডোজ সংস্করণ উন্নয়ন বন্ধ করে, ধীরে ধীরে MP4 দ্বারা প্রতিস্থাপিত)"

msgid "mime_webm"
msgstr "WebM ভিডিও (গুগল ২০১০ সালে চালু করে, ওপেন সোর্স এবং পেটেন্ট-মুক্ত ভিডিও ফরম্যাট। মাত্রোস্কা কন্টেইনারের ভিত্তিতে, VP8/VP9 এনকোডিং, HTML5 ভিডিও মানক ফরম্যাট, ইউটিউবের ওয়েবে ডিফল্ট প্লেব্যাক ফরম্যাট)"

msgid "mime_3gp"
msgstr "3GP ভিডিও (3GPP ২০০০ সালে নির্ধারণ করে, মোবাইল ডিভাইসের জন্য ভিডিও ফরম্যাট। ফাইল খুব ছোট, কম গুণমান, প্রাথমিক ফিচার ফোনের ভিডিও রেকর্ডিং ফরম্যাট, MMS পাঠানোর জন্য ব্যবহৃত হত)"

