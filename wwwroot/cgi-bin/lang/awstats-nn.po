#------------------------------------------------------------------------------
# Formatbeskrivingar
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstfil (ASCII-standardisering i 1963, uformatert rein tekst. Grunnlaget for all kjeldkode, konfigurasjon og loggar. Unix bruker LF, Windows bruker CRLF for linjeskift, framleis det mest universelle dataformatet i datamaskinar)"

msgid "mime_log"
msgstr "Loggfil (rein tekstfil som registrerer informasjon om system- og applikasjonsdrift, ofte brukt for feilsøking, ytingsanalyse og tryggingsrevisjon. Standardformat som Apache combined log, Nginx access log, syslog osv.)"

msgid "mime_page"
msgstr "HTML-nettside (Tim Berners-Lee oppfann WWW i 1989, definerte HTML/HTTP/URL-teknologiane i 1990, gav dei ut gratis utan patent. I 2014 vart HTML5 ein offisiell W3C-standard, støttar vising, multimedia og utskrift. Vann Turing-prisen i 2016)"

msgid "mime_khtml"
msgstr "KHTML nettsidemotor (KDE 2.0 vart utgitt i 1998, Konqueror-nettlesaren sin gjengjevingsmotor. I 2001 laga Apple WebKit basert på KHTML, i 2008 oppretta Google Blink frå WebKit, som vart kjernen i Chrome, Edge, Safari og andre nettlesarar. KHTML er eit døme på korleis open kjeldekode-samfunnet la grunnlaget for moderne nettlesarmotorar, den teknologiske arven held fram gjennom WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamisk skript (tolka språk, treng ikkje kompilering. Inkluderer ASP, JSP, CGI, ColdFusion, Tcl, VBScript osv., mykje brukt i tidleg nettutvikling, systemadministrasjon, automatisering av oppgåver. Moderne skriptspråk som Python, Ruby, JavaScript har utvikla seg til hovudverktøy for fullstack-utvikling)"

msgid "mime_js"
msgstr "JavaScript-skript (Brendan Eich laga det på 10 dagar i Netscape i 1995, nettlesarane sitt opphavlege programmeringsspråk. I 1997 vart ECMAScript standardisert, i 2009 vart Node.js fødd og gjorde det til eit fullstackspråk, npm er den største pakkebehandlaren i verda. Fleire år på rad det mest populære programmeringsspråket på GitHub)"

msgid "mime_py"
msgstr "Python-skript (skapt av Guido van Rossum i 1991, kjend for tvungen innrykk og rein syntaks. Mykje brukt i nettutvikling, datavitskap, kunstig intelligens, automatisert drift. Vann TIOBEs programmeringsspråk-år fleire gonger)"

msgid "mime_sh"
msgstr "Shell-skript (Unix vart født i 1971, kommandoskriptspråk. Brukt til systemadministrasjon, automatisering av oppgåver, start av tenester, utplasseringsskript. Grunnleggjande ferdigskap for Linux-administratorar)"

msgid "mime_rb"
msgstr "Ruby-skript (skapt av Yukihiro Matsumoto i 1995, fokuserer på utviklaren si lukke. Ruby on Rails-rammeverket innførte konvensjon framfor konfigurasjon-paradigmet, påverka designet av moderne nettrammeverk)"

msgid "mime_pl"
msgstr "Perl-skript (skapt av Larry Wall i 1987, kjend for sin praktiske tilnærming, kalla \"sveitsisk armékneiv\". CPAN var pioneren for moderne pakkebehandlarar, hadde stor innverknad innan teksthandsaming, systemadministrasjon og CGI-området)"

msgid "mime_php"
msgstr "PHP-dynamisk side (skapt av Rasmus Lerdorf i 1995, spesialdesigna for nettutvikling. Over 70% av nettstadene i verda bruker det, driv plattformer som WordPress, Facebook, Wikipedia. PHP 8 innførte JIT-kompilering, betydeleg ytingsforbetring)"

msgid "mime_image"
msgstr "Biletfil"

msgid "mime_document"
msgstr "Dokumentfil"

msgid "mime_package"
msgstr "Programvarepakke"

msgid "mime_archive"
msgstr "Gzip-komprimert fil (GNU-prosjekt frå 1992, basert på DEFLATE-algoritme. På nettet brukt til dynamisk komprimering av svar, komprimeringsgrad vanlegvis 60-90%. Etter 2015 vart han i nokre scenario erstatta av Brotli, men er framleis den mest støtta komprimeringsformatet på tenarsida)"

msgid "mime_audio"
msgstr "Lydfil"

msgid "mime_video"
msgstr "Videofil"

msgid "mime_jscript"
msgstr "JavaScript (utvikla av Brendan Eich i 1995)"

msgid "mime_json"
msgstr "JSON-data (føreslått av Douglas Crockford i 2001, lettvekts datautvekslingsformat, de facto-standard for nett-API)"

msgid "mime_vbs"
msgstr "VBScript (utvikla av Microsoft i 1996, Windows-skriptspråk, brukt til ASP-nettsider og Windows-administrasjonsskript. Med utbreiinga av PowerShell og JavaScript, er det gradvis fasa ut)"

msgid "mime_conf"
msgstr "Konfigurasjonsfil (tekstformat for lagring av programvarekonfigurasjon, vanlege format: INI, JSON, YAML, TOML, XML. Linux-systemkonfigurasjonar er ofte i /etc-katalogen)"

msgid "mime_css"
msgstr "CSS-stilark (W3C gav ut CSS1 som første offisielle standard i desember 1996, CSS2 la til plassering og medietypar i 1998, frå 2011 innførte CSS3 modulært avrunda hjørne, animasjonar, fleksibokser, rutenettoppsett og responsivt design. Saman med HTML og JavaScript er dei dei tre kjerneteknologiane for frontend-utvikling, alle moderne nettlesarar (Chrome, Firefox, Safari, Edge) støttar det innfødd, det er den einaste standarden for definisjon av nettstilar)"

msgid "mime_xsl"
msgstr "XSL-stilark (W3C-standard frå 1999, XML-dokumentomformingsspråk, kan konvertere XML til HTML/PDF/tekst. Etter at JSON vart utbreidd, har bruken avtatt)"

msgid "mime_runtime"
msgstr "Køyrbar fil (EXE, ELF, Mach-O og andre køyrare format for operativsystem, inneheld maskinkode og innlastingsinformasjon)"

msgid "mime_library"
msgstr "Bibliotekfil (DLL, SO, dylib og andre dynamisk kopla bibliotek, kode som vert lasta inn under programkøyring)"

msgid "mime_swf"
msgstr "Flash-animasjon (utvikla av Macromedia i 1996, seinare overteke av Adobe. Standard for interaktive nettanimasjonar, dominerte internettanimasjon og -spel. Ulemper: avhengig av programtillegg, ikkje støtta på mobil, høg tryggingsrisiko. I 2017 kunngjorde Adobe at det skulle fases ut, støtta opphøyrde fullstendig i 2020, erstatta av HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD-dokumenttypebeskriving (XML-spesifikasjon, definerer strukturen til eit XML-dokument, brukt til å validere XML-validitet)"

msgid "mime_csv"
msgstr "CSV-dataformat (kommaseparerte verdiar, universelt format for tabelldata, standard for import/eksport i Excel og databasar)"

msgid "mime_jnlp"
msgstr "Java Web Start (startar for Java-applikasjonar, teknologi for distribusjon av Java-skrivebordsapplikasjonar frå 2000-talet, no nedlagt)"

msgid "mime_lit"
msgstr "Microsoft Reader e-bok (introdusert av Microsoft i 2000, LIT-format, nedlagt)"

msgid "mime_svg"
msgstr "SVG-vektorgrafikk (W3C-standard frå 1999, fordi Microsoft lenge fremja sitt eige VML-format, støtta IE-nettlesaren det først i 2011, noko som forseinka utbreiinga. Etter 2015, med avviklinga av IE og utbreiinga av HD-skjermar, vart det det føretrekte formatet for ikon og logoar)"

msgid "mime_ai"
msgstr "Adobe Illustrator-vektorgrafikk (introdusert i 1987, bransjestandard for vektorgrafikkformat, førsteval for trykkedesign, logoar og ikon)"

msgid "mime_phshop"
msgstr "Photoshop-bilete (introdusert av Adobe i 1990, Photoshop-kjeldeformat PSD, bransjestandard for biletehandsaming)"

msgid "mime_ttf"
msgstr "TrueType-font (utvikla i fellesskap av Apple og Microsoft i 1989, vektorfontformat, konsistent vising på skjerm og utskrift, standard fontformat på moderne operativsystem)"

msgid "mime_fon"
msgstr "WOFF2-webfont (W3C-tilråding frå 2014, bruker Brotli-komprimeringsalgoritme, samanlikna med eldre WOFF er storleiken redusert med omtrent 30%, samanlikna med TTF/OTF redusert med over 50%, alle moderne nettlesarar støttar det, føretrekt format for moderne webfontar, støtta av over 98% av nettlesarane)"

msgid "mime_pdf"
msgstr "PDF-dokument (utvikla av Adobe i 1993, vart ISO internasjonal standard i 2008. Plattformuavhengig dokumentformat, held formatkonsistens, global standard for distribusjon av elektroniske dokument)"

msgid "mime_dotnet"
msgstr "ASP.NET-dynamisk side (introdusert av Microsoft i 2002, dynamisk nettteknologi for Windows-plattform, ein del av .NET Framework)"

msgid "mime_mdb"
msgstr "Access-database (Microsoft Access-databasefil, introdusert i 1992, Windows skrivebordsdatabase-løysing)"

msgid "mime_md"
msgstr "Markdown-dokument (oppretta av John Gruber i 2004, syntaksdesignet er påverka av reStructuredText og Setext. Den sentrale designfilosofien er 'lesbarheit er gjengjeving', den opphavlege implementeringa Markdown.pl er skriven på Perl og utfører teksttransformasjon basert på regulære uttrykk. Avleidde spesifikasjonar inkluderer GFM (2013), CommonMark (2017), Pandoc Markdown osv. Driv økosystem som GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, og har blitt standardformatet for statiske nettstadgeneratorar og utviklardokumentasjon)"

msgid "mime_crystal"
msgstr "Crystal Reports-rapportformat (SAP business intelligence-rapportar, standardformat for bedriftsrapportar)"

msgid "mime_libreoffice"
msgstr "LibreOffice-dokument (utvikla av The Document Foundation i 2010, ei grein av OpenOffice, ODF-standardimplementering, ein mainstream open kjeldekode-kontorpakke)"

msgid "mime_encrypt"
msgstr "Kryptert fil (fil som må dekrypterast for å visast, vanlege utvidingar: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS-spordata (GPS-utvekslingsformat, registrerer geografisk posisjonsinformasjon, universelt format for sportsklokker og navigasjonseiningar)"

msgid "mime_diskimage"
msgstr "Diskavbilding (DMG, ISO, IMG og andre optiske disk-/diskavbildingsfiler, brukt til programvare-distribusjon eller tryggingskopiering av lagringsmedia)"

msgid "mime_vm"
msgstr "Virtuell maskin-avbilding (VMDK, VDI, VHDX, OVA og andre virtuelle diskfiler, format for virtualiseringsplattformer som VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent-seedfil (oppfunnen av Bram Cohen i 2001, P2P-nedlastingsindeksfil, inneheld metadata om fil og Tracker-informasjon)"

msgid "mime_gis"
msgstr "GIS geografisk informasjonssystem-data (Shapefile, GeoJSON og andre geospatiale dataformat, brukt for kart og romleg analyse)"

msgid "mime_ebook"
msgstr "E-bok (EPUB, MOBI, AZW og andre e-bokformat. EPUB er internasjonal standard, MOBI/AZW er Amazon sitt Kindle-format)"

msgid "mime_avif"
msgstr "AVIF-bilete (introdusert av Alliance for Open Media i 2019, basert på AV1-koding, komprimeringsgraden er 50% betre enn WebP, ein ny generasjons standard for nett bilete)"

msgid "mime_markdown"
msgstr "Markdown-dokument (designa av John Gruber i 2004, lettvekts markeringsspråk, universelt format for GitHub README, teknisk dokumentasjon, foruminlegg)"

msgid "mime_yaml"
msgstr "YAML-konfigurasjon (designa av Clark Evans i 2001, menneskelesbart dataserialiseringsformat, standard format for konfigurasjonsfiler som Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML-konfigurasjon (designa av Tom Preston-Werner i 2013, \"Tom's Obvious Minimal Language\", konfigurasjonsfilformat for moderne verktøy som Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue-komponentfil (introdusert i 2014 av Evan You, progressivt JavaScript-rammeverk. Gjennom ein-fils-komponentar (SFC) kombinerer det HTML, CSS og JS perfekt, noko som i stor grad aukar utviklingseffektiviteten. Det er eit av dei mest populære frontend-rammeverka i verda. Òg som kjerne i moderne statiske nettstadsgeneratorar som VitePress, vert det mykje brukt til å drive interaktiv teknisk dokumentasjon og bloggar.)"

msgid "mime_wasm"
msgstr "WebAssembly-modul (W3C-standard frå 2017, høgytings utføringsformat i nettlesar, C/C++/Rust/R kan kompilere til mål, yting nær det opphavlege)"

msgid "mime_jsx"
msgstr "React JSX-komponent (Facebook introduserte JavaScript XML i 2013, komponentsyntaks for React-rammeverket, ein innovativ paradigm for å skrive HTML i JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX-komponent (utvikla av Microsoft i 2012, TypeScript + JSX, standardmodus for React-utvikling med typesikkerheit)"

msgid "mime_heif"
msgstr "HEIF-bilete (MPEG-standard frå 2015, effektivt biletfilformat, mykje brukt i Apple sitt økosystem)"

msgid "mime_heic"
msgstr "HEIC-bilete (Apple si implementering av HEIF, standard biletformat for iPhone, innfødd støtta på iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D-modell (GL-overføringsformat, \"JPEG for 3D-verda\", utgitt av Khronos Group i 2015, standardformat for web 3D)"

msgid "mime_glb"
msgstr "GLB binær 3D-modell (binær versjon av GLTF, éi fil inneheld alle ressursar, brukt for distribusjon av 3D-scener)"

msgid "mime_gls"
msgstr "GLOSSARY-ordliste (termdefinisjonsfil, brukt for terminologihandsaming i dokumentsystem)"

msgid "mime_cbz"
msgstr "CBZ-teikneserie (ZIP-komprimerte teikneseriebilete, universelt format for teikneseriesamlingar)"

msgid "mime_cbr"
msgstr "CBR-teikneserie (RAR-komprimerte teikneseriebilete, universelt format for teikneseriesamlingar)"

msgid "mime_fb2"
msgstr "FB2 e-bok (FictionBook 2.0, russisk e-bokformat, XML-struktur, mykje støtta av lesarar med open kjeldekode)"

msgid "mime_kepub"
msgstr "KEPUB e-bok (Kobo-spesifikt EPUB-format, optimalisert format for Kobo e-boklesarar)"

msgid "mime_m4b"
msgstr "M4B lydbok (MPEG-4 lydbokformat, støttar bokmerke, iTunes-lydbokformat)"

msgid "mime_kfx"
msgstr "Kindle KFX-format (introdusert av Amazon i 2015, spesialformat for Kindle e-bøker, støttar forbetra typografi og rask blading)"

msgid "mime_chm"
msgstr "CHM-hjelpefil (introdusert av Microsoft i 1997, kompilert HTML-hjelpeformat, standard for Windows-programvarehjelpedokumentasjon)"

msgid "mime_mht"
msgstr "MHT nettsidearkiv (introdusert av Microsoft i 1999, einfils nettsideformat, format for lagring av nettsider i IE-nettlesaren)"

msgid "mime_wml"
msgstr "WML trådlaus markeringsspråk (WAP-standard frå 1999, brukt for nettsider på eldre mobiltelefonar, nedlagt)"

msgid "mime_xhtml"
msgstr "XHTML-side (W3C-standard frå 2000, XML-versjon av HTML, strengare syntaks. I 2009 avslutta W3C vedlikehaldet, fokuset flytta til HTML5)"

msgid "mime_xml"
msgstr "XML-dokument (W3C-standard frå 1998, utvidbart markeringsspråk, basisformat for nettenester, konfigurasjonsfiler, datautveksling)"

msgid "mime_sgml"
msgstr "SGML-dokument (ISO-standard frå 1986, forgjengaren til HTML, standard universelt markeringsspråk, både XML og HTML stammar frå SGML)"

msgid "mime_apng"
msgstr "APNG-animasjon (utvikla av Mozilla i 2004, animasjonsutviding av PNG, moderne erstatning for GIF, støttar ekte fargar og gjennomsiktigheit)"

msgid "mime_bmp"
msgstr "BMP-bitmap (Windows bitmap-format, innfødd støtta sidan Windows 1.0. Ukomprimert, stor filstorleik, men på grunn av sin enkle struktur og manglande behov for ekstra kodekar, vert han framleis brukt i Windows 11 sitt utklippsverktøy, Paint-programmet, ikonressursar i EXE/MSI-installasjonspakker, markørfiler og nokre eldre driverar. Ved same biletkvalitet er filstorleiken omtrent 3-10 gonger større enn PNG. I dei fleste tilfella er han erstatta av PNG/JPEG, men Windows-økosystemet held framleis på brei kompatibilitet)"

msgid "mime_cdr"
msgstr "CDR-vektorgrafikk (CorelDRAW-spesialformat, Corel Corporation, Canada, vektorgrafikkdesignprogramvare)"

msgid "mime_gif"
msgstr "GIF-bilete (CompuServe utvikla i 1987, 256-farge animert format. Ulemper: lite fargar, grovkorna biletkvalitet, støttar ikkje gjennomsiktigheit, stor fil, låg biletfrekvens. Erstatt av moderne animerte format som APNG, WebP)"

msgid "mime_ico"
msgstr "ICO-ikon (Windows ikonfilformat, støttar fleire oppløysingar, standardformat for favicon på nettstader)"

msgid "mime_jpeg"
msgstr "JPEG-bilete (ISO-standard frå 1992, bileteformat med tapt kvalitet, de facto standard for bilete på internett)"

msgid "mime_jpg"
msgstr "JPEG-bilete (ISO-standard frå 1992, bileteformat med tapt kvalitet, de facto standard for bilete på internett)"

msgid "mime_png"
msgstr "PNG-bilete (W3C-tilråding frå 1996, støttar ekte fargar og gjennomsiktigheit, statisk erstatning for GIF, internettstandard for bilete utan tap)"

msgid "mime_ps"
msgstr "PostScript-sidebeskrivingsfil (introdusert av Adobe i 1985, sidebeskrivingsspråk, forgjengaren til PDF, brukt for utskrift og publisering)"

msgid "mime_psb"
msgstr "PSB stort dokument (Adobe Photoshop ekstra stort bileteformat, støttar bilete større enn 2GB eller 30000 pikslar)"

msgid "mime_psd"
msgstr "PSD-bilete (Adobe Photoshop-kjeldeformat, støttar lag, kanalar, stiar, bransjestandard for biletehandsaming)"

msgid "mime_webp"
msgstr "WebP-bilete (utvikla av Google i 2010, nettverksbileteformat, støttar komprimering med/tap og animasjon, komprimeringsgraden er 25-35% betre enn PNG, 25% betre enn JPEG)"

msgid "mime_woff"
msgstr "WOFF-webfont (oppretta i 2009, W3C-standard frå 2018. Komprimering basert på TrueType/OpenType, optimalisering av lasting av webfontar, standardformat for ikon på moderne nettstader)"

msgid "mime_7z"
msgstr "7z-komprimert pakke (utvikla av Igor Pavlov i 1999, spesialformat for 7-Zip-programmet. LZMA-algoritme, høg komprimering, open kjeldekode og gratis. 7z-formatet ved same komprimeringsgrad er vanlegvis 30-50% mindre enn ZIP, vanleg format i open kjeldekode-miljøet og for programvare-distribusjon)"

msgid "mime_ace"
msgstr "ACE-komprimert pakke (utvikla på 1990-talet, format for WinACE-programmet. Konkurrerte med RAR, relativt høg komprimering. Utviklinga stoppa i 2007, erstatta av 7z/RAR, brukt sjeldan)"

msgid "mime_bz2"
msgstr "BZIP2-komprimert pakke (utvikla av Julian Seward i 1996, blokksorteringsalgoritme. Komprimeringsgraden er 15-20% betre enn GZIP, men tregare. Vanleg format for Linux-kjernen sin kjeldekode, open kjeldekode-pakkar, filendelse .bz2)"

msgid "mime_cab"
msgstr "CAB-komprimert pakke (utvikla av Microsoft i 1995, Cabinet-format. Format for installasjonspakker for Windows-systemet, brukt for driverar, distribusjon av systemfiler. Windows Installer (MSI) bruker internt CAB for lagring av filer)"

msgid "mime_dmg"
msgstr "DMG-diskavbilding (introdusert av Apple på 1980-talet, Disk Image-format. Standardformat for distribusjon av programvare på macOS, dobbeltklikk monterast som virtuell disk, dra og slepp for å installere. Støttar komprimering og kryptering, det dominerande formatet for nedlasting av Mac-programvare)"

msgid "mime_emz"
msgstr "EMZ-komprimert bilete (Windows komprimert forbetra metafil, komprimert versjon av EMF. Format for lagring av vektorgrafikk i Office-dokument, er i hovudsak ein GZIP-komprimert EMF-fil)"

msgid "mime_gz"
msgstr "GZIP-komprimert pakke (utvikla av Jean-loup Gailly og Mark Adler i 1992, GNU-prosjekt. Standard komprimeringsverktøy på Unix/Linux, vanleg format for HTTP-overføring med komprimering. Filendelse .gz, brukt ofte saman med TAR)"

msgid "mime_jar"
msgstr "JAR-komprimert pakke (introdusert av Sun Microsystems i 1997, Java ARchive-format. Er i hovudsak ein ZIP-komprimert pakke, brukt for pakking av Java-klassebibliotek og applikasjonar. Kjerneformat i Java-økosystemet som Maven, Gradle, Android bruker også JAR)"

msgid "mime_lzma"
msgstr "LZMA-komprimert pakke (utvikla av Igor Pavlov i 1998, Lempel-Ziv-Markov chain-algoritme. Kjernekomprimeringsalgoritme for 7z-format, høg komprimering, rask dekomprimering. Brukt for fastvare, distribusjon av programvare for innebygde system)"

msgid "mime_rar"
msgstr "RAR-komprimert pakke (utvikla av Eugene Roshal i 1993, Roshal ARchive-format. Høg komprimering, støttar oppdeling i volum, gjenopprettingspostar. Format for WinRAR-programmet, komprimering betre enn ZIP, men krev betalt programvare, verktøy med open kjeldekode som unrar kan dekomprimere)"

msgid "mime_tar"
msgstr "TAR-arkiv (introdusert i Unix V7 i 1979, Tape ARchive-format. Tape-arkivformat, komprimerer ikkje, berre pakkar, brukt ofte saman med GZIP/BZIP2/XZ. Kjeldekoden til Linux-pakkar, lagring av lag i Docker-avbildingar bruker TAR-format)"

msgid "mime_tgz"
msgstr "TGZ-komprimert pakke (kombinasjon av TAR + GZIP, filendelse .tgz eller .tar.gz. Det mest universelle distribusjonsformatet for Unix/Linux-pakkar, mykje brukt for kjeldekodepakkar, binærpakkar, representant for \"pakk ut og bruk\")"

msgid "mime_tbz2"
msgstr "TBZ2-komprimert pakke (kombinasjon av TAR + BZIP2, filendelse .tbz2 eller .tar.bz2. Komprimeringsgraden er 15-20% betre enn TGZ, eigna for distribusjon av store filer, Linux-kjernen sin kjeldekode har lenge brukt dette formatet)"

msgid "mime_xz"
msgstr "XZ-komprimert pakke (introdusert i 2009, basert på LZMA2-algoritme. Ekstremt høg komprimering, 30-50% betre enn GZIP, relativt rask dekomprimering. Mykje brukt i Linux-kjernen, pakkebehandlarar (som internt i Debian sin .deb), tilrådd format for det noverande Linux-økosystemet)"

msgid "mime_z"
msgstr "Z-komprimert pakke (Unix compress-kommandoformat frå 1985, LZW-algoritme. Tidleg Unix-komprimeringsformat, erstatta av GZIP. Filendelse .Z, sjeldan brukt på moderne system)"

msgid "mime_zip"
msgstr "ZIP-komprimert pakke (utvikla av Phil Katz i 1989, PKZIP-format. Innfødd støtta av Windows, det mest universelle komprimeringsformatet på internett. Støttar fleire filer, katalogstruktur, kan velje komprimeringsalgoritme. Java JAR, Android APK, Office-dokument DOCX/XLSX er basert på ZIP-format)"

msgid "mime_zst"
msgstr "Zstandard-komprimert pakke (utvikla av Facebook i 2015, designa av Yann Collet. Høghastigheits komprimeringsalgoritme, komprimeringsgrad nær LZMA, hastigheit langt over GZIP. Støtta av Linux-kjerne 5.9+, Arch Linux pacman, Debian APT tar det gradvis i bruk, ein ny generasjons komprimeringsstandard)"

msgid "mime_lz4"
msgstr "LZ4-komprimert pakke (utvikla av Yann Collet i 2011, ekstremt rask komprimeringsalgoritme. Komprimeringshastigheita er over 10 gonger raskare enn GZIP, eigna for sanntidskomprimering. Mykje brukt i Linux-kjernen, OpenZFS, Hadoop, førsteval for scenario der hastigheit er prioritet)"

msgid "mime_lzo"
msgstr "LZO-komprimert pakke (utvikla av Markus Oberhumer i 1996, Lempel-Ziv-Oberhumer-algoritme. Ekstremt rask dekomprimeringshastigheit, moderat komprimeringsgrad. Brukt i Linux-kjernen sin Squashfs, OpenWrt-fastvare, eigna for innebygde system)"

msgid "mime_msi"
msgstr "MSI-installasjonspakke (introdusert av Microsoft i 1999, Windows Installer-pakkeformat. Standard installasjonsformat for Windows-applikasjonar, støttar transaksjonsrulling, komponentadministrasjon, stille installasjon. Føretrekt format for distribusjon av bedriftsprogramvare, framleis det dominerande formatet for installasjon av Windows-programvare)"

msgid "mime_pkg"
msgstr "PKG-installasjonspakke (format for installasjonspakke for macOS-applikasjonar, basert på Apple sin Installer-teknologi. Standardformat for distribusjon av macOS-programvare, støttar komponentval, installasjonsskript, avinstalleringsfunksjon. Dobbeltklikk på .pkg-fila for å installere, vanleg distribusjonsmetode for programvare utanfor Mac App Store)"

msgid "mime_apk"
msgstr "APK Android-applikasjonspakke (introdusert av Google i 2008, tradisjonell installasjonsformat for Android-applikasjonar. APK er i hovudsak ein ZIP-pakke, inneheld kode, ressursar og manifestfil. Frå 2021 krev Google Play at nye applikasjonar brukar AAB-format, men APK vert framleis brukt for utvikling og feilsøking, tredjepartsbutikkar og sidelasting)"

msgid "mime_ipa"
msgstr "IPA iOS-applikasjonspakke (iOS App Store Package, installasjonsformat for iOS/iPadOS-applikasjonar. Introdusert i 2008 med iPhone SDK. Må distribuerast via App Store eller signerast med bedriftssertifikat. Inneheld køyrdør fil, ressursar, Info.plist og signaturinformasjon)"

msgid "mime_hap"
msgstr "HAP HarmonyOS-applikasjonspakke (HarmonyOS Ability Package, grunnleggjande eining for HarmonyOS-applikasjonar. Introdusert i 2020 med HarmonyOS 2.0. Støttar to typar: entry og feature, distribusjonsformat for Huawei-telefonar, nettbrett, smartklokker og andre HarmonyOS-einingar)"

msgid "mime_har"
msgstr "HAR HarmonyOS statisk delt bibliotek (HarmonyOS Archive, statisk delt bibliotek for HarmonyOS, kan delast av fleire HAP-pakkar, brukt for komponentbasert utvikling og gjenbruk av modular)"

msgid "mime_aab"
msgstr "Android App Bundle (introdusert av Google i 2018, frå 2021 gjer Google Play dette formatet obligatorisk for nye applikasjonar. AAB er eit distribusjonsformat, Google Play genererer optimaliserte APK-ar basert på einingkonfigurasjon (CPU-arkitektur, skjermtettleik, språk), installasjonspakken sin storleik reduserast i gjennomsnitt med 35%. Utviklarar lastar opp AAB, brukarar lastar ned APK)"

msgid "mime_xapk"
msgstr "XAPK-applikasjonspakke (tredjeparts Android-applikasjonsutvidingspakke, inneheld APK + OBB-datafiler. Brukt for store spel og komplekse applikasjonar, løyser 100 MB-grensa for ei enkelt APK-fil. Vanleg i tredjeparts app-butikkar som APKPure, APKMirror, ikkje eit offisielt Google-format)"

msgid "mime_appx"
msgstr "Windows-applikasjonspakke (introdusert av Microsoft i 2012, installasjonsformat for Windows 8/10/11-applikasjonar. Støttar UWP- og skrivebordsapplikasjonskonvertering, distribuerast via Microsoft Store. I 2024 introduserte Microsoft MSIX som etterfølgjarformat, gradvis erstattar APPX)"

msgid "mime_msix"
msgstr "MSIX-applikasjonspakke (introdusert av Microsoft i 2018, ein ny generasjons pakkeformat for Windows. Kombinerer fordelane med APPX og MSI, støttar alle typar Windows-applikasjonar, kan distribuerast via Microsoft Store eller sidelastast, tilrådd format for Windows 10 1809 og nyare versjonar)"

msgid "mime_appimage"
msgstr "AppImage-applikasjonspakke (introdusert i 2004, Linux-installasjonsfritt applikasjonsformat. \"Éin applikasjon, éi fil\", ingen installasjon naudsynt, køyrer direkte, støttar dei fleste Linux-distribusjonane, vanleg distribusjonsmåte for Linux-programvare for utviklarar)"

msgid "mime_flatpak"
msgstr "Flatpak-applikasjonspakke (introdusert i 2015, Linux-sandkasseapplikasjonsformat. Køyrer på tvers av distribusjonar, isolert from vertssystemet, leia av Fedora, Red Hat, standardformat for GNOME Software Center)"

msgid "mime_snap"
msgstr "Snap-applikasjonspakke (introdusert av Canonical i 2014, morselskapet til Ubuntu, Linux universelt applikasjonsformat. Automatiske oppdateringar, sandkasseisolering, støttar 40+ Linux-distribusjonar, standardformat for Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Debian-programvarepakke (introdusert av Debian-prosjektet i 1993, standard installasjonsformat for Debian/Ubuntu og deira derivat. Administrerast med dpkg, APT er grensesnittet for pakkebehandlar, eit av dei mest modne pakkeformata i Linux-økosystemet, framleis det dominerande formatet i Debian-familien)"

msgid "mime_rpm"
msgstr "RPM-programvarepakke (introdusert av Red Hat i 1997, standardformat for Red Hat/Fedora/CentOS/SUSE og andre distribusjonar. RPM står for \"Red Hat Package Manager\", saman med DEB eit av dei to store pakkeformata i Linux, framleis dominerande i RHEL-familien)"

msgid "mime_pacman"
msgstr "Arch-programvarepakke (introdusert av Arch Linux i 2002, .pkg.tar.zst-format som vert brukt av pacman-pakkebehandlar. Kjernen i Arch Linux med rullande utgjevingar, kjend for eigenskapane enkelheit og KISS-prinsippet, AUR (Arch User Repository) er dens særeigenheit)"

msgid "mime_exe"
msgstr "EXE-køyrdør fil (Windows køyrdørt programformat, forkorting for \"Executable\". Innfødd køyrdørt format for Windows-operativsystemet, inneheld PE-struktur. Utvikla seg frå MZ-formatet frå MS-DOS, i 1993 introduserte Windows NT PE-formatet (Portable Executable) og vert framleis brukt. Programvareinstallasjonspakkar, applikasjonar, systemverktøy brukar dette formatet. Brukaren dobbeltklikkar for å køyre, det mest brukte køyrdøre formatet i verda)"

msgid "mime_dll"
msgstr "DLL-dynamisk koplingbibliotek (introdusert av Microsoft i 1993, Dynamic Link Library. Windows delt kodebibliotek, lastast dynamisk under programkøyring, sparar minne og diskplass. Systemkomponentar, applikasjonsprogramtillegg, driverar brukar DLL-format. Kjernemåten å implementere Windows API på, DLL Hell-problemet er mildna i .NET-tida)"

msgid "mime_com"
msgstr "COM-køyrdør fil (køyrdørt format frå MS-DOS-tida, forkorting for \"Command\". Enkel filstruktur, 64KB-grense, mainstream-format før Windows 3.x. Nedlagt, moderne Windows brukar EXE-format, COM-filendelse vert framleis brukt for nokre komponentfiler)"

msgid "mime_aac"
msgstr "AAC-lyd (MPEG-standard frå 1997, Advanced Audio Coding. Etterfølgjaren til MP3, lydkvaliteten betre enn MP3 ved same bithastigheit, standard lydformat for YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC-lyd (utvikla av Apple i 2004, Apple Lossless Audio Codec. Apple sitt tapsefrie format, open kjeldekode i 2011, standardformat for iTunes og Apple Music tapsefri lyd)"

msgid "mime_flac"
msgstr "FLAC-lyd (utvikla av Xiph.Org Foundation i 2001, Free Lossless Audio Codec. Tapsefri komprimering, lydkvalitet som CD, filstorleik omtrent halvparten av original WAV. Open kjeldekode utan patent, føretrekt format for audiofilar og digitale musikksamlingar)"

msgid "mime_mp3"
msgstr "MP3-lyd (utvikla av Fraunhofer Institute i 1993, MPEG-1 Audio Layer 3. Format med tapt kvalitet, lita filstorleik akseptabel kvalitet, kjernen i den digitale musikkrevolusjonen på 2000-talet, hovudårsaka til iPod og Napster. Patentet utløpte i 2017, vart offentleg domene filmformat)"

msgid "mime_oga"
msgstr "Ogg Audio-lyd (utvikla av Xiph.Org Foundation, reint lydformat for Ogg-behaldaren, brukar Vorbis-koding. Open kjeldekode utan patent, komprimeringskvalitet betre enn MP3, mykje brukt i open kjeldekode-prosjekt)"

msgid "mime_ogg"
msgstr "OGG-lyd (utvikla av Xiph.Org Foundation i 2000, Ogg Vorbis-format. Open kjeldekode utan patent, komprimeringskvalitet betre enn MP3, tidleg brukar var Spotify, mykje brukt for lydeffektar i spel)"

msgid "mime_opus"
msgstr "Opus-lyd (standardisert av IETF i 2012, open kjeldekode utan patent lydformat. Kombinerer SILK- og CELT-teknologi, ekstremt låg latenstid, høgast komprimeringskvalitet, standard lydformat for WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV-lyd (utvikla av Microsoft og IBM i 1991, innfødd Windows-lydformat. PCM-koding utan komprimering, tapsefri lydkvalitet, men enorme filer, standardformat for profesjonell lydredigering)"

msgid "mime_wma"
msgstr "WMA-lyd (utvikla av Microsoft i 1999, Windows Media Audio. To versjonar: med og utan tap, innfødd støtta av Windows, vart utbreidd med Windows Media Player. Er no marginalisert, erstatta av MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF-lyd (Direct Stream Digital-format, utvikla av Sony og Philips, 1-bit høg samplingsfrekvens, standardformat for DSD-lyd, digital versjon av SACD, audiophile high-end-lydformat, enorme filer)"

msgid "mime_ape"
msgstr "APE Lyd (utvikla av Monkey's Audio i 2000, tapsfritt komprimeringsformat. Høgare komprimering enn FLAC, men seinare koding, framleis i bruk på Windows-plattforma og blant audio-entusiastar)"

msgid "mime_mid"
msgstr "MIDI-lyd (oppretta av MIDI Association i 1983, Musical Instrument Digital Interface. Noteformat snarare enn opptak, svært små filer, standard for elektroniske instrument, ringetonar for mobiltelefonar, lydeffektar i spel. I 1991 vart General MIDI standardisert, definerte 128 instrumentlydar)"

msgid "mime_m4a"
msgstr "M4A-lyd (MPEG-4 Audio, behaldarformat for AAC. Standardformat for iTunes Music Store, mainstream-lydformat i Apple sitt økosystem, støttar DRM-beskyttelse)"

msgid "mime_m3u"
msgstr "M3U-spilleliste (MP3 URL-spillelisteformat, rein tekstfil, registrerer stiar til lydfiler. Standard frå Winamp-tida, brukt for nettradio, online musikkstrøyming. M3U8 er dens UTF-8-versjon, brukt for HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF-strøyming (utvikla av Microsoft i 1996, Advanced Systems Format. Windows Media-behaldar for strøyming, støttar synkronisert lyd- og videooverføring. Brukt for direktesendingar og strøyming på førespurnad, WMA/WMV er basert på ASF-behaldaren)"

msgid "mime_avi"
msgstr "AVI-video (introdusert av Microsoft i 1992, tidleg Windows-videostandard. \"Audio Video Interleave\", lyd- og vekselvis lagring, det mest populære videoformatet på 1990-2000-talet, erstatta av MP4/MKV)"

msgid "mime_divx"
msgstr "DivX-video (utvikla av DivX-selskapet i 1998, videokodingsformat basert på MPEG-4. Hovudformat for fildeling av videoar på internett på 2000-talet, den første teknologien som komprimerte DVD-kvalitet til CD-storleik. På grunn av opphavsrettskonfliktar, vart det seinare kommersielt kodingsverktøy)"

msgid "mime_mp4"
msgstr "MP4-video (MPEG-standard frå 2001, MPEG-4 Part 14. Det mest universelle videoformatet i verda, støttar H.264/H.265-koding, standardformat for nettvideo, mobilopptak, YouTube)"

msgid "mime_m4v"
msgstr "M4V-video (iTunes-videoformat, variant av MP4. Videoformat i Apple sitt økosystem, standardformat for filmar og TV-seriar på iTunes Store, støttar DRM-opphavsrettsbeskyttelse)"

msgid "mime_mpeg"
msgstr "MPEG-video (oppretta av MPEG-organisasjonen i 1988, Moving Picture Experts Group. Grunnleggjar av standardar for digital videokomprimering, stor innverknad frå MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (nettvideo))"

msgid "mime_mkv"
msgstr "MKV-video (utvikla av Matroska-prosjektet i 2002, open kjeldekode multimediebehaldar. Støttar fleire lydspor, fleire undertekstar, kapittel, \"innpakningsverktøy\", føretrekt format for fildeling av HD-filmar)"

msgid "mime_mpg"
msgstr "MPEG-video (MPEG-1/MPEG-2 videofilendelse, standardformat for VCD og DVD. Hovudformat for videoar på optiske plater på 1990-2000-talet, erstatta av H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video-video (utvikla av Xiph.Org Foundation, videoformat for Ogg-behaldaren, brukar Theora-koding. Open kjeldekode utan patent, tidleg standard for HTML5-video, innfødd støtta av Firefox)"

msgid "mime_ogx"
msgstr "Ogg-multimediebehaldar (utvikla av Xiph.Org Foundation, universell utviding av Ogg-behaldaren, kan innehalde fleire spor: lyd, video, undertekstar osv. Open kjeldekode-multimediastandard, brukt for spel, strøyming)"

msgid "mime_rm"
msgstr "RealMedia-video (utvikla av RealNetworks i 1995, RealMedia-format. Pioner innan internettstrøyming på 1990-2000-talet, kjerna format for RealPlayer-avspelaren. Ulemper: krev spesialavspelar, dårleg komprimeringskvalitet, vart erstatta av Flash/MP4)"

msgid "mime_flv"
msgstr "Flash-video (formatet dukka opp i 2002, Flash Video-format. Var ein gong mainstream for nettvideo, tidleg brukar var YouTube. Ulemper: krev Flash-programtillegg, dårleg yting, mange tryggingshol. Frå 2015 gjekk mainstream-nettstader over til HTML5-video, no nedlagt)"

msgid "mime_f4v"
msgstr "F4V-video (Flash-videoformat utvikla av Adobe, etterfølgjar til FLV. Basert på MPEG-4-standarden, støttar H.264-koding. Saman med Flash-teknologien vart han nedlagt, Adobe avslutta støtta i 2020)"

msgid "mime_wmv"
msgstr "WMV-video (utvikla av Microsoft i 1999, Windows Media Video. Innfødd støtta av Windows, optimalisert for strøyming, vanleg format for online-videoar i dei tidlege dagane, no marginalisert)"

msgid "mime_wmf"
msgstr "WMF-medieformat (Windows Media Format, Microsoft sin medierammeverk. Omfattar WMV-video og WMA-lyd, innfødd støtta av Windows Media Player)"

msgid "mime_mov"
msgstr "MOV-video (utvikla av Apple i 1991, QuickTime-behaldarformat. Standardformat for profesjonell videoredigering, støttar fleire kodekar, innfødd støtta av Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime-video (introdusert av Apple i 1991, QuickTime-format. Videostandard for Mac-plattforma, MOV er dens behaldar, QuickTime-avspelaren var mykje brukt. I 2016 avslutta Apple utviklinga av Windows-versjonen, gradvis erstatta av MP4)"

msgid "mime_webm"
msgstr "WebM-video (introdusert av Google i 2010, open kjeldekode utan patent videoformat. Basert på Matroska-behaldaren, VP8/VP9-koding, standardformat for HTML5-video, YouTube sin standard web-avspelingsformat)"

msgid "mime_3gp"
msgstr "3GP-video (oppretta av 3GPP i 2000, videoformat for mobile einingar. Svært små filer, låg kvalitet, format for videoopptak på tidlege mobiltelefonar, brukt for MMS-sending)"

