#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "ಪಠ್ಯ ಫೈಲ್ (1963 ರಲ್ಲಿ ASCII ಮಾನಕೀಕರಿಸಲಾಗಿದೆ, ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ಇಲ್ಲದೆ ಸರಳ ಪಠ್ಯ. ಎಲ್ಲಾ ಮೂಲ ಕೋಡ್, ಸಂರಚನೆ, ಲಾಗ್ಗಳ ಆಧಾರ. Unix ನಲ್ಲಿ LF, Windows ನಲ್ಲಿ CRLF ಬಳಸುತ್ತದೆ, ಇಂದಿಗೂ ಕಂಪ್ಯೂಟರ್ಗಳಲ್ಲಿ ಅತ್ಯಂತ ಸಾಮಾನ್ಯ ಡೇಟಾ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_log"
msgstr "ಲಾಗ್ ಫೈಲ್ (ಸಿಸ್ಟಮ್, ಅಪ್ಲಿಕೇಶನ್ನ ಮಾಹಿತಿಯನ್ನು ದಾಖಲಿಸುತ್ತದೆ, ಸಾಮಾನ್ಯವಾಗಿ ದೋಷನಿವಾರಣೆ, ಕಾರ್ಯಕ್ಷಮತಾ ವಿಶ್ಲೇಷಣೆ, ಭದ್ರತಾ ಲೆಕ್ಕಪರಿಶೋಧನೆಗೆ ಬಳಸಲಾಗುತ್ತದೆ. ಪ್ರಮಾಣಿತ ಸ್ವರೂಪಗಳು: Apache combined log, Nginx access log, syslog)"

msgid "mime_page"
msgstr "HTML ವೆಬ್ ಪುಟ (1989 ರಲ್ಲಿ ಟಿಮ್ ಬರ್ನರ್ಸ್-ಲೀ ವರ್ಲ್ಡ್ ವೈಡ್ ವೆಬ್ ಅನ್ನು ಕಂಡುಹಿಡಿದರು, 1990 ರಲ್ಲಿ ಮೂರು ಮೂಲ ತಂತ್ರಜ್ಞಾನಗಳಾದ HTML/HTTP/URL ಅನ್ನು ವ್ಯಾಖ್ಯಾನಿಸಿದರು, ಪೇಟೆಂಟ್ ಇಲ್ಲದೆ ಉಚಿತವಾಗಿ ತೆರೆದರು. 2014 ರಲ್ಲಿ HTML5 W3C ಅಧಿಕೃತ ಮಾನಕವಾಯಿತು. 2016 ರಲ್ಲಿ ಟ್ಯೂರಿಂಗ್ ಪ್ರಶಸ್ತಿಯನ್ನು ಪಡೆದರು)"

msgid "mime_khtml"
msgstr "KHTML ವೆಬ್ ಎಂಜಿನ್ (1998 ರಲ್ಲಿ KDE 2.0 ನಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, Konqueror ಬ್ರೌಸರ್ನ ರೆಂಡರಿಂಗ್ ಎಂಜಿನ್. 2001 ರಲ್ಲಿ ಆಪಲ್ KHTML ಆಧರಿಸಿ WebKit ಅನ್ನು ರಚಿಸಿತು, 2008 ರಲ್ಲಿ ಗೂಗಲ್ WebKit ನಿಂದ Blink ಅನ್ನು ಫೋರ್ಕ್ ಮಾಡಿತು, ಇದು Chrome, Edge, Safari ಬ್ರೌಸರ್ಗಳ ಕೋರ್ ಆಯಿತು. KHTML ಓಪನ್ ಸೋರ್ಸ್ ಸಮುದಾಯದ ಉದಾಹರಣೆಯಾಗಿದೆ, ಇದು ಆಧುನಿಕ ಬ್ರೌಸರ್ ಎಂಜಿನ್ಗಳಿಗೆ ಅಡಿಪಾಯ ಹಾಕಿತು)"

msgid "mime_script"
msgstr "ಡೈನಾಮಿಕ್ ಸ್ಕ್ರಿಪ್ಟ್ (ಕಂಪೈಲ್ ಮಾಡದೆಯೇ, ಇಂಟರ್ಪ್ರಿಟ್ ಮಾಡಲಾದ ಭಾಷೆ. ASP, JSP, CGI, ColdFusion, Tcl, VBScript ಅನ್ನು ಒಳಗೊಂಡಿದೆ, ಆರಂಭಿಕ ವೆಬ್ ಅಭಿವೃದ್ಧಿಯಲ್ಲಿ, ಸಿಸ್ಟಮ್ ನಿರ್ವಹಣೆಯಲ್ಲಿ, ಸ್ವಯಂಚಾಲನಾ ಕಾರ್ಯಗಳಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗಿದೆ. ಆಧುನಿಕ ಸ್ಕ್ರಿಪ್ಟಿಂಗ್ ಭಾಷೆಗಳಾದ Python, Ruby, JavaScript ಈಗ ಪೂರ್ಣ ಪ್ರಮಾಣದ ಪ್ರೋಗ್ರಾಮಿಂಗ್ ಭಾಷೆಗಳಾಗಿವೆ)"

msgid "mime_js"
msgstr "JavaScript ಸ್ಕ್ರಿಪ್ಟ್ (1995 ರಲ್ಲಿ Brendan Eich Netscape ನಲ್ಲಿ 10 ದಿನಗಳಲ್ಲಿ ರಚಿಸಿದರು, ಬ್ರೌಸರ್ನ ಮೂಲ ಪ್ರೋಗ್ರಾಮಿಂಗ್ ಭಾಷೆ. 1997 ರಲ್ಲಿ ECMAScript ಮಾನಕೀಕರಿಸಲಾಯಿತು, 2009 ರಲ್ಲಿ Node.js ರಚನೆಯು ಇದನ್ನು ಪೂರ್ಣ ಪ್ರಮಾಣದ ಭಾಷೆಯನ್ನಾಗಿ ಮಾಡಿತು, npm ವಿಶ್ವದ ಅತಿದೊಡ್ಡ ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ ಆಗಿದೆ. GitHub ನಲ್ಲಿ ಅತ್ಯಂತ ಜನಪ್ರಿಯ ಪ್ರೋಗ್ರಾಮಿಂಗ್ ಭಾಷೆ)"

msgid "mime_py"
msgstr "Python ಸ್ಕ್ರಿಪ್ಟ್ (1991 ರಲ್ಲಿ Guido van Rossum ರಚಿಸಿದರು, ಕಡ್ಡಾಯ ಇಂಡೆಂಟೇಶನ್ ಮತ್ತು ಸರಳ ಸಿಂಟ್ಯಾಕ್ಸ್ನಿಂದ ಗುರುತಿಸಲ್ಪಡುತ್ತದೆ. ವೆಬ್ ಅಭಿವೃದ್ಧಿ, ಡೇಟಾ ವಿಜ್ಞಾನ, ಕೃತಕ ಬುದ್ಧಿಮತ್ತೆ, ಸ್ವಯಂಚಾಲನೆಗಳಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ. TIOBE ವಾರ್ಷಿಕ ಪ್ರೋಗ್ರಾಮಿಂಗ್ ಭಾಷೆ ಪ್ರಶಸ್ತಿಯನ್ನು ಅನೇಕ ಬಾರಿ ಪಡೆದಿದೆ)"

msgid "mime_sh"
msgstr "ಶೆಲ್ ಸ್ಕ್ರಿಪ್ಟ್ (1971 ರಲ್ಲಿ Unix ಜೊತೆಗೆ, ಕಮಾಂಡ್ ಸ್ಕ್ರಿಪ್ಟಿಂಗ್ ಭಾಷೆ. ಸಿಸ್ಟಮ್ ನಿರ್ವಹಣೆ, ಸ್ವಯಂಚಾಲನಾ ಕಾರ್ಯಗಳು, ಸೇವೆಗಳನ್ನು ಪ್ರಾರಂಭಿಸುವುದು, ನಿಯೋಜನೆ ಸ್ಕ್ರಿಪ್ಟ್ಗಳಿಗೆ ಬಳಸಲಾಗುತ್ತದೆ. Linux ನಿರ್ವಹಣೆಯ ಅಗತ್ಯ ಕೌಶಲ್ಯ)"

msgid "mime_rb"
msgstr "Ruby ಸ್ಕ್ರಿಪ್ಟ್ (1995 ರಲ್ಲಿ Yukihiro Matsumoto ರಚಿಸಿದರು, ಡೆವಲಪರ್ಗಳ ಸಂತೋಷದ ಮೇಲೆ ಕೇಂದ್ರೀಕರಿಸುತ್ತಾರೆ. Ruby on Rails ಚೌಕಟ್ಟು "ಸಂಪ್ರದಾಯಕ್ಕಿಂತ ಸಂರಚನೆ ಉತ್ತಮ" ಎಂಬ ಮಾದರಿಯನ್ನು ಪರಿಚಯಿಸಿತು, ಇದು ಆಧುನಿಕ ವೆಬ್ ಚೌಕಟ್ಟುಗಳ ವಿನ್ಯಾಸದ ಮೇಲೆ ಪ್ರಭಾವ ಬೀರಿತು)"

msgid "mime_pl"
msgstr "Perl ಸ್ಕ್ರಿಪ್ಟ್ (1987 ರಲ್ಲಿ Larry Wall ರಚಿಸಿದರು, ಪ್ರಾಯೋಗಿಕತೆಗೆ ಹೆಸರುವಾಸಿಯಾಗಿದೆ, "ಸ್ವಿಸ್ ಆರ್ಮಿ ಚಾಕು" ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ. CPAN ಆಧುನಿಕ ಭಾಷಾ ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ಗಳ ಮುಂಚೂಣಿಯಲ್ಲಿತ್ತು, ಪಠ್ಯ ಸಂಸ್ಕರಣೆ, ಸಿಸ್ಟಮ್ ನಿರ್ವಹಣೆ, CGI ಕ್ಷೇತ್ರಗಳಲ್ಲಿ ಪ್ರಮುಖ ಪ್ರಭಾವ ಬೀರಿದೆ)"

msgid "mime_php"
msgstr "PHP ಡೈನಾಮಿಕ್ ಪುಟ (1995 ರಲ್ಲಿ Rasmus Lerdorf ರಚಿಸಿದರು, ವಿಶೇಷವಾಗಿ ವೆಬ್ ಅಭಿವೃದ್ಧಿಗಾಗಿ. ವಿಶ್ವದ ವೆಬ್ಸೈಟ್ಗಳಲ್ಲಿ 70% ಬಳಸುತ್ತವೆ, WordPress, Facebook, Wikipedia ಸೇರಿದಂತೆ. PHP 8 JIT ಕಂಪೈಲೇಶನ್ ಅನ್ನು ಪರಿಚಯಿಸಿತು, ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಗಮನಾರ್ಹವಾಗಿ ಸುಧಾರಿಸಿತು)"

msgid "mime_image"
msgstr "ಚಿತ್ರ ಫೈಲ್"

msgid "mime_document"
msgstr "ದಾಖಲೆ ಫೈಲ್"

msgid "mime_package"
msgstr "ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್"

msgid "mime_archive"
msgstr "Gzip ಸಂಕುಚಿತ ಫೈಲ್ (1992 ರಲ್ಲಿ GNU ಯೋಜನೆ, DEFLATE ಅಲ್ಗಾರಿದಮ್ ಆಧರಿಸಿದೆ. ವೆಬ್ನಲ್ಲಿ ಡೈನಾಮಿಕ್ ಸಂಕುಚನಕ್ಕಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, ಸಂಕುಚನ ದರವು ಸಾಮಾನ್ಯವಾಗಿ 60-90%. 2015 ರ ನಂತರ Brotli ದಿಂದ ಭಾಗಶಃ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ, ಆದರೆ ಇನ್ನೂ ಸರ್ವರ್ಗಳಲ್ಲಿ ಅತ್ಯಂತ ಸಾಮಾನ್ಯ ಸಂಕುಚನ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_audio"
msgstr "ಆಡಿಯೋ ಫೈಲ್"

msgid "mime_video"
msgstr "ವಿಡಿಯೋ ಫೈಲ್"

msgid "mime_jscript"
msgstr "JavaScript (1995 ರಲ್ಲಿ Brendan Eich ರಚಿಸಿದರು)"

msgid "mime_json"
msgstr "JSON ಡೇಟಾ (2001 ರಲ್ಲಿ Douglas Crockford ಪ್ರಸ್ತಾಪಿಸಿದರು, ಹಗುರವಾದ ಡೇಟಾ ವಿನಿಮಯ ಸ್ವರೂಪ, Web API ಯ ವಾಸ್ತವಿಕ ಮಾನಕ)"

msgid "mime_vbs"
msgstr "VBScript (1996 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ವಿಂಡೋಸ್ ಸ್ಕ್ರಿಪ್ಟಿಂಗ್ ಭಾಷೆ, ASP ಪುಟಗಳು ಮತ್ತು ವಿಂಡೋಸ್ ನಿರ್ವಹಣೆ ಸ್ಕ್ರಿಪ್ಟ್ಗಳಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ. PowerShell ಮತ್ತು JavaScript ಹರಡುವಿಕೆಯೊಂದಿಗೆ, ಕ್ರಮೇಣ ಹಳೆಯದಾಗಿದೆ)"

msgid "mime_conf"
msgstr "ಸಂರಚನಾ ಫೈಲ್ (ಸಾಫ್ಟ್ವೇರ್ ಸಂರಚನೆಯನ್ನು ಟೆಕ್ಸ್ಟ್ ಸ್ವರೂಪದಲ್ಲಿ ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಸಾಮಾನ್ಯ ಸ್ವರೂಪಗಳು: INI, JSON, YAML, TOML, XML. Linux ಸಿಸ್ಟಮ್ ಸಂರಚನೆಗಳು ಹೆಚ್ಚಾಗಿ /etc ಡೈರೆಕ್ಟರಿಯಲ್ಲಿವೆ)"

msgid "mime_css"
msgstr "CSS ಸ್ಟೈಲ್ ಶೀಟ್ (1996 ರ ಡಿಸೆಂಬರ್ನಲ್ಲಿ W3C ಮೊದಲ ಅಧಿಕೃತ ಮಾನಕ CSS1 ಅನ್ನು ಪ್ರಕಟಿಸಿತು, 1998 ರಲ್ಲಿ CSS2 ಲೇಔಟ್ ಮತ್ತು ಮೀಡಿಯಾ ಪ್ರಕಾರಗಳನ್ನು ಸೇರಿಸಿತು, 2011 ರಿಂದ CSS3 ಮಾಡ್ಯುಲರ್ ಆವೃತ್ತಿಯು ದುಂಡಾದ ಮೂಲೆಗಳು, ಅನಿಮೇಶನ್, Flexbox, Grid ಲೇಔಟ್ ಮತ್ತು ಸ್ಪಂದಿಸುವ ವಿನ್ಯಾಸವನ್ನು ಪರಿಚಯಿಸಿತು. HTML ಮತ್ತು JavaScript ಜೊತೆಗೆ ಫ್ರಂಟ್-ಎಂಡ್ನ ಮೂರು ಮುಖ್ಯ ತಂತ್ರಜ್ಞಾನಗಳಲ್ಲಿ ಒಂದಾಗಿದೆ, ಎಲ್ಲಾ ಆಧುನಿಕ ಬ್ರೌಸರ್ಗಳು (Chrome, Firefox, Safari, Edge) ಸ್ಥಳೀಯವಾಗಿ ಬೆಂಬಲಿಸುತ್ತವೆ, ಪುಟದ ಶೈಲಿಯನ್ನು ವ್ಯಾಖ್ಯಾನಿಸುವ ಏಕೈಕ ಮಾನಕವಾಗಿದೆ)"

msgid "mime_xsl"
msgstr "XSL ಸ್ಟೈಲ್ ಶೀಟ್ (1999 ರಲ್ಲಿ W3C ಮಾನಕ, XML ಡಾಕ್ಯುಮೆಂಟ್ ರೂಪಾಂತರ ಭಾಷೆ, XML ಅನ್ನು HTML/PDF/ಪಠ್ಯಕ್ಕೆ ಪರಿವರ್ತಿಸಬಹುದು. JSON ಹರಡಿದ ನಂತರ ಬಳಕೆ ಕಡಿಮೆಯಾಗಿದೆ)"

msgid "mime_runtime"
msgstr "ರನ್ ಮಾಡಬಹುದಾದ ಫೈಲ್ (EXE, ELF, Mach-O ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಮ್ ರನ್ ಮಾಡಬಹುದಾದ ಸ್ವರೂಪಗಳು, ಯಂತ್ರ ಕೋಡ್ ಮತ್ತು ಲೋಡಿಂಗ್ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ)"

msgid "mime_library"
msgstr "ಲೈಬ್ರರಿ ಫೈಲ್ (DLL, SO, dylib ಡೈನಾಮಿಕ್ ಲಿಂಕ್ ಲೈಬ್ರರಿಗಳು, ಪ್ರೋಗ್ರಾಂ ರನ್ ಆಗುವಾಗ ಲೋಡ್ ಆಗುತ್ತವೆ)"

msgid "mime_swf"
msgstr "Flash ಅನಿಮೇಶನ್ (1996 ರಲ್ಲಿ Macromedia ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ನಂತರ Adobe ಸ್ವಾಧೀನಪಡಿಸಿಕೊಂಡಿತು. ಸಂವಾದಾತ್ಮಕ ವೆಬ್ ಅನಿಮೇಶನ್ನ ಮಾನಕ, ಇಂಟರ್ನೆಟ್ ಅನಿಮೇಶನ್ ಮತ್ತು ಆಟಗಳಲ್ಲಿ ಪ್ರಾಬಲ್ಯ ಸಾಧಿಸಿತು. ನ್ಯೂನತೆಗಳು: ಪ್ಲಗಿನ್ ಮೇಲೆ ಅವಲಂಬಿತ, ಮೊಬೈಲ್ ಸಾಧನಗಳಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸಲಿಲ್ಲ, ಹೆಚ್ಚಿನ ಭದ್ರತಾ ಅಪಾಯ. 2017 ರಲ್ಲಿ Adobe ಬೆಂಬಲವನ್ನು ನಿಲ್ಲಿಸುವುದಾಗಿ ಘೋಷಿಸಿತು, 2020 ರಲ್ಲಿ ಸಂಪೂರ್ಣವಾಗಿ ನಿಲ್ಲಿಸಲಾಯಿತು, HTML5/CSS3/JS ನಿಂದ ಬದಲಾಯಿಸಲಾಯಿತು)"

msgid "mime_dtd"
msgstr "DTD ಡಾಕ್ಯುಮೆಂಟ್ ಪ್ರಕಾರದ ವ್ಯಾಖ್ಯಾನ (XML ವಿವರಣೆ, XML ಡಾಕ್ಯುಮೆಂಟ್ ರಚನೆಯನ್ನು ವ್ಯಾಖ್ಯಾನಿಸುತ್ತದೆ, XML ನ ಸಿಂಧುತ್ವವನ್ನು ಪರಿಶೀಲಿಸಲು)"

msgid "mime_csv"
msgstr "CSV ಡೇಟಾ ಸ್ವರೂಪ (ಅಲ್ಪವಿರಾಮದಿಂದ ಪ್ರತ್ಯೇಕಿಸಲಾದ ಮೌಲ್ಯಗಳು, ಕೋಷ್ಟಕ ಡೇಟಾದ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ, ಎಕ್ಸೆಲ್ ಮತ್ತು ಡೇಟಾಬೇಸ್ ಆಮದು/ರಫ್ತು ಮಾನಕ)"

msgid "mime_jnlp"
msgstr "Java Web Start (ಜಾವಾ ಅಪ್ಲಿಕೇಶನ್ ಲಾಂಚರ್, 2000 ರ ದಶಕದಲ್ಲಿ ಜಾವಾ ಡೆಸ್ಕ್ಟಾಪ್ ಅಪ್ಲಿಕೇಶನ್ಗಳನ್ನು ವಿತರಿಸುವ ತಂತ್ರಜ್ಞಾನ, ಈಗ ಹಳೆಯದಾಗಿದೆ)"

msgid "mime_lit"
msgstr "Microsoft Reader ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ (2000 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, LIT ಸ್ವರೂಪ, ಈಗ ಹಳೆಯದಾಗಿದೆ)"

msgid "mime_svg"
msgstr "SVG ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ (1999 ರಲ್ಲಿ W3C ಮಾನಕ, Microsoft ತನ್ನದೇ ಆದ VML ಸ್ವರೂಪವನ್ನು ದೀರ್ಘಕಾಲ ಪ್ರಚಾರ ಮಾಡಿದ ಕಾರಣ, IE ಬ್ರೌಸರ್ 2011 ರವರೆಗೆ ಬೆಂಬಲಿಸಲಿಲ್ಲ, ಇದು ಹರಡುವಿಕೆಯನ್ನು ವಿಳಂಬಗೊಳಿಸಿತು. 2015 ರ ನಂತರ, IE ನಿಲುಗಡೆ ಮತ್ತು ಹೆಚ್ಚಿನ ರೆಸಲ್ಯೂಶನ್ ಪರದೆಗಳ ಹರಡುವಿಕೆಯೊಂದಿಗೆ, ಐಕಾನ್ಗಳು, ಲೋಗೋಗಳ ಆದ್ಯತೆಯ ಸ್ವರೂಪವಾಯಿತು)"

msgid "mime_ai"
msgstr "Adobe Illustrator ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ (1987 ರಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, ಉದ್ಯಮ ಮಾನಕ ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ ಸ್ವರೂಪ, ಮುದ್ರಣ ವಿನ್ಯಾಸ, ಲೋಗೋಗಳು, ಐಕಾನ್ಗಳಿಗೆ ಆದ್ಯತೆ)"

msgid "mime_phshop"
msgstr "ಫೋಟೋಶಾಪ್ ಚಿತ್ರ (1990 ರಲ್ಲಿ Adobe ಬಿಡುಗಡೆ ಮಾಡಿತು, ಫೋಟೋಶಾಪ್ನ ಮೂಲ ಫೈಲ್ PSD, ಚಿತ್ರ ಸಂಸ್ಕರಣಾ ಉದ್ಯಮದ ಮಾನಕ)"

msgid "mime_ttf"
msgstr "TrueType ಫಾಂಟ್ (1989 ರಲ್ಲಿ Apple ಮತ್ತು Microsoft ಜಂಟಿಯಾಗಿ ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, ವೆಕ್ಟರ್ ಫಾಂಟ್ ಸ್ವರೂಪ, ಪರದೆಯ ಪ್ರದರ್ಶನ ಮತ್ತು ಮುದ್ರಣವು ಒಂದೇ ಆಗಿರುತ್ತದೆ, ಆಧುನಿಕ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಮ್ಗಳ ಪ್ರಮಾಣಿತ ಫಾಂಟ್ ಸ್ವರೂಪ)"

msgid "mime_fon"
msgstr "WOFF2 ವೆಬ್ ಫಾಂಟ್ (2014 ರಲ್ಲಿ W3C ಅನುಮೋದಿಸಿತು, Brotli ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್ ಬಳಸುತ್ತದೆ, ಹಿಂದಿನ WOFF ಸ್ವರೂಪಕ್ಕಿಂತ ಸುಮಾರು 30% ಚಿಕ್ಕದಾಗಿದೆ, TTF/OTF ಗಿಂತ 50% ಕ್ಕಿಂತ ಹೆಚ್ಚು, ಎಲ್ಲಾ ಆಧುನಿಕ ಬ್ರೌಸರ್ಗಳು ಬೆಂಬಲಿಸುತ್ತವೆ, ಆಧುನಿಕ ವೆಬ್ ಫಾಂಟ್ಗಳ ಆದ್ಯತೆಯ ಸ್ವರೂಪವಾಗಿದೆ, ಬ್ರೌಸರ್ಗಳ 98% ಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಳಸುತ್ತವೆ)"

msgid "mime_pdf"
msgstr "PDF ದಾಖಲೆ (1993 ರಲ್ಲಿ Adobe ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, 2008 ರಲ್ಲಿ ISO ಅಂತಾರಾಷ್ಟ್ರೀಯ ಮಾನಕವಾಯಿತು. ಕ್ರಾಸ್-ಪ್ಲಾಟ್ಫಾರ್ಮ್ ಡಾಕ್ಯುಮೆಂಟ್ ಸ್ವರೂಪ, ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ಸ್ಥಿರತೆಯನ್ನು ಕಾಪಾಡುತ್ತದೆ, ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಡಾಕ್ಯುಮೆಂಟ್ಗಳ ವಿತರಣೆಯ ಜಾಗತಿಕ ಮಾನಕವಾಗಿದೆ)"

msgid "mime_dotnet"
msgstr "ASP.NET ಡೈನಾಮಿಕ್ ಪುಟ (2002 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ವಿಂಡೋಸ್ ಪ್ಲಾಟ್ಫಾರ್ಮ್ನ ಡೈನಾಮಿಕ್ ವೆಬ್ ಪುಟ ತಂತ್ರಜ್ಞಾನ, .NET Framework ನ ಭಾಗ)"

msgid "mime_mdb"
msgstr "Access ಡೇಟಾಬೇಸ್ (Microsoft Access database file, 1992 ರಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, ವಿಂಡೋಸ್ ಡೆಸ್ಕ್ಟಾಪ್ ಡೇಟಾಬೇಸ್ ಪರಿಹಾರ)"

msgid "mime_md"
msgstr "Markdown ದಾಖಲೆ (2004 ರಲ್ಲಿ John Gruber ರಚಿಸಿದರು, ರೀಡಬಲ್ ಆಗಿರುವಂತೆ ರೆಂಡರ್ ಮಾಡಬಹುದು, GitHub README, ತಾಂತ್ರಿಕ ದಾಖಲೆಗಳು, ವೇದಿಕೆ ಪೋಸ್ಟ್ಗಳ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ)"

msgid "mime_crystal"
msgstr "Crystal Reports ವರದಿ ಸ್ವರೂಪ (SAP ವ್ಯಾಪಾರ ಬುದ್ಧಿವಂತಿಕೆಯ ವರದಿಗಳು, ಕಾರ್ಪೊರೇಟ್ ವರದಿಗಳ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_libreoffice"
msgstr "LibreOffice ದಾಖಲೆ (2010 ರಲ್ಲಿ The Document Foundation ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, OpenOffice ಫೋರ್ಕ್, ODF ಮಾನಕದ ಅನುಷ್ಠಾನ, ಮುಖ್ಯ ಓಪನ್ ಸೋರ್ಸ್ ಕಚೇರಿ ಸೂಟ್)"

msgid "mime_encrypt"
msgstr "ಎನ್ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾದ ಫೈಲ್ (ನೋಡಲು ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ, ಸಾಮಾನ್ಯ ವಿಸ್ತರಣೆಗಳು: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS ಟ್ರ್ಯಾಕ್ ಡೇಟಾ (GPS ವಿನಿಮಯ ಸ್ವರೂಪ, ಭೌಗೋಳಿಕ ಸ್ಥಾನ ಮಾಹಿತಿಯನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಕ್ರೀಡಾ ವಾಚ್ಗಳು, ನ್ಯಾವಿಗೇಷನ್ ಸಾಧನಗಳ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ)"

msgid "mime_diskimage"
msgstr "ಡಿಸ್ಕ್ ಇಮೇಜ್ (DMG, ISO, IMG ಮತ್ತು ಇತರ ಡಿಸ್ಕ್ ಇಮೇಜ್ ಫೈಲ್ಗಳು, ಸಾಫ್ಟ್ವೇರ್ ವಿತರಿಸಲು ಅಥವಾ ಮಾಧ್ಯಮ ಬ್ಯಾಕಪ್ಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_vm"
msgstr "ವರ್ಚುವಲ್ ಮಷೀನ್ ಇಮೇಜ್ (VMDK, VDI, VHDX, OVA ಮತ್ತು ಇತರ ವರ್ಚುವಲ್ ಮೆಷಿನ್ ಡಿಸ್ಕ್ ಫೈಲ್ಗಳು, VMware, VirtualBox, Hyper-V ವರ್ಚುವಲೈಸೇಶನ್ ಪ್ಲಾಟ್ಫಾರ್ಮ್ಗಳ ಸ್ವರೂಪಗಳು)"

msgid "mime_torrent"
msgstr "BitTorrent ಟೊರೆಂಟ್ ಫೈಲ್ (2001 ರಲ್ಲಿ Bram Cohen ಕಂಡುಹಿಡಿದರು, P2P ಡೌನ್ಲೋಡ್ ಸೂಚ್ಯಂಕ ಫೈಲ್, ಫೈಲ್ ಮೆಟಾಡೇಟಾ ಮತ್ತು ಟ್ರ್ಯಾಕರ್ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿರುತ್ತದೆ)"

msgid "mime_gis"
msgstr "GIS ಭೌಗೋಳಿಕ ಮಾಹಿತಿ ವ್ಯವಸ್ಥೆಯ ಡೇಟಾ (Shapefile, GeoJSON ಮತ್ತು ಇತರ ಭೌಗೋಳಿಕ ಪ್ರಾದೇಶಿಕ ಡೇಟಾ ಸ್ವರೂಪಗಳು, ನಕ್ಷೆಗಳು ಮತ್ತು ಪ್ರಾದೇಶಿಕ ವಿಶ್ಲೇಷಣೆಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_ebook"
msgstr "ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ (EPUB, MOBI, AZW ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ ಸ್ವರೂಪಗಳು. EPUB ಅಂತಾರಾಷ್ಟ್ರೀಯ ಮಾನಕವಾಗಿದೆ, MOBI/AZW Amazon Kindle ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_avif"
msgstr "AVIF ಚಿತ್ರ (2019 ರಲ್ಲಿ ಓಪನ್ ಮೀಡಿಯಾ ಅಲೈಯನ್ಸ್ ಬಿಡುಗಡೆ ಮಾಡಿತು, AV1 ಆಧರಿಸಿದೆ, ಸಂಕುಚನ ದರವು WebP ಗಿಂತ 50% ಉತ್ತಮವಾಗಿದೆ, ಹೊಸ ಪೀಳಿಗೆಯ ವೆಬ್ ಚಿತ್ರಗಳ ಮಾನಕ)"

msgid "mime_markdown"
msgstr "Markdown ದಾಖಲೆ (2004 ರಲ್ಲಿ John Gruber ವಿನ್ಯಾಸಗೊಳಿಸಿದರು, ಹಗುರವಾದ ಮಾರ್ಕ್ಅಪ್ ಭಾಷೆ, GitHub README, ತಾಂತ್ರಿಕ ದಾಖಲೆಗಳು, ವೇದಿಕೆ ಪೋಸ್ಟ್ಗಳ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ)"

msgid "mime_yaml"
msgstr "YAML ಸಂರಚನೆ (2001 ರಲ್ಲಿ Clark Evans ವಿನ್ಯಾಸಗೊಳಿಸಿದರು, ಮಾನವ ಓದಬಲ್ಲ ಡೇಟಾ ಸೀರಿಯಲೈಸೇಶನ್ ಸ್ವರೂಪ, Kubernetes, Ansible, Docker Compose ಸಂರಚನಾ ಫೈಲ್ಗಳ ಮಾನಕ)"

msgid "mime_toml"
msgstr "TOML ಸಂರಚನೆ (2013 ರಲ್ಲಿ Tom Preston-Werner ವಿನ್ಯಾಸಗೊಳಿಸಿದರು, 'Tom's Obvious Minimal Language', Rust/Cargo, Python/pip, Go ನಂತಹ ಆಧುನಿಕ ಉಪಕರಣಗಳ ಸಂರಚನಾ ಫೈಲ್ ಸ್ವರೂಪ)"

msgid "mime_vue"
msgstr "Vue ಕಾಂಪೊನೆಂಟ್ ಫೈಲ್ (2014 ರಲ್ಲಿ ಇವಾನ್ ಯು ಅವರು ಪರಿಚಯಿಸಿದರು, ಪ್ರಗತಿಪರ JavaScript ಫ್ರೇಮ್ವರ್ಕ್. ಸಿಂಗಲ್-ಫೈಲ್ ಕಾಂಪೊನೆಂಟ್ಗಳ (SFC) ಮೂಲಕ ಇದು HTML, CSS ಮತ್ತು JS ಅನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಂಯೋಜಿಸುತ್ತದೆ, ಅಭಿವೃದ್ಧಿಯ ದಕ್ಷತೆಯನ್ನು ಬಹಳವಾಗಿ ಹೆಚ್ಚಿಸುತ್ತದೆ. ಇದು ವಿಶ್ವದ ಅತ್ಯಂತ ಜನಪ್ರಿಯ ಫ್ರಂಟ್ಎಂಡ್ ಫ್ರೇಮ್ವರ್ಕ್ಗಳಲ್ಲಿ ಒಂದಾಗಿದೆ. ಅಲ್ಲದೆ, VitePress ನಂತಹ ಆಧುನಿಕ ಸ್ಟ್ಯಾಟಿಕ್ ಸೈಟ್ ಜನರೇಟರ್ಗಳ ಮೂಲವಾಗಿ, ಸಂವಾದಾತ್ಮಕ ತಾಂತ್ರಿಕ ದಸ್ತಾವೇಜು ಮತ್ತು ಬ್ಲಾಗ್ಗಳನ್ನು ಚಾಲನೆ ಮಾಡಲು ಇದನ್ನು ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ.)"

msgid "mime_wasm"
msgstr "WebAssembly ಮಾಡ್ಯೂಲ್ (2017 ರಲ್ಲಿ W3C ಮಾನಕ, ಬ್ರೌಸರ್ನ ಹೆಚ್ಚಿನ ಕಾರ್ಯಕ್ಷಮತೆಯ ರನ್ ಸ್ವರೂಪ, C/C++/Rust/R ಕಂಪೈಲ್ ಮಾಡಬಹುದು, ಕಾರ್ಯಕ್ಷಮತೆ ಸ್ಥಳೀಯ ಕೋಡ್ಗೆ ಹತ್ತಿರದಲ್ಲಿದೆ)"

msgid "mime_jsx"
msgstr "React JSX ಕಾಂಪೊನೆಂಟ್ (2013 ರಲ್ಲಿ Facebook ಬಿಡುಗಡೆ ಮಾಡಿತು, JavaScript XML, React ಫ್ರೇಮ್ವರ್ಕ್ ಕಾಂಪೊನೆಂಟ್ ಸಿಂಟ್ಯಾಕ್ಸ್, HTML ಅನ್ನು JavaScript ನಲ್ಲಿ ಬರೆಯುವ ನವೀನ ಮಾದರಿ)"

msgid "mime_tsx"
msgstr "TypeScript TSX ಕಾಂಪೊನೆಂಟ್ (2012 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, TypeScript + JSX, React ನ ಟೈಪ್ ಸುರಕ್ಷಿತ ಅಭಿವೃದ್ಧಿಯ ಪ್ರಮಾಣಿತ ಬರವಣಿಗೆ)"

msgid "mime_heif"
msgstr "HEIF ಚಿತ್ರ (2015 ರಲ್ಲಿ MPEG ಮಾನಕ, ಹೆಚ್ಚಿನ ದಕ್ಷತೆಯ ಚಿತ್ರ ಫೈಲ್ ಸ್ವರೂಪ, ಆಪಲ್ ಪರಿಸರ ವ್ಯವಸ್ಥೆಯಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_heic"
msgstr "HEIC ಚಿತ್ರ (Apple ನ HEIF ಅನುಷ್ಠಾನ, iPhone ನ ಡೀಫಾಲ್ಟ್ ಫೋಟೋ ಸ್ವರೂಪ, iOS/macOS ಸ್ಥಳೀಯ ಬೆಂಬಲ)"

msgid "mime_gltf"
msgstr "GLTF 3D ಮಾಡೆಲ್ (GL ಪ್ರಸರಣ ಸ್ವರೂಪ, '3D ನ JPEG', 2015 ರಲ್ಲಿ Khronos Group ಬಿಡುಗಡೆ ಮಾಡಿತು, ವೆಬ್ 3D ನ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_glb"
msgstr "GLB ಬೈನರಿ 3D ಮಾಡೆಲ್ (GLTF ನ ಬೈನರಿ ಆವೃತ್ತಿ, ಒಂದೇ ಫೈಲ್ ಎಲ್ಲಾ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಒಳಗೊಂಡಿದೆ, 3D ದೃಶ್ಯಗಳನ್ನು ವಿತರಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_gls"
msgstr "GLOSSARY ಪದಕೋಶ (ಪದ ವ್ಯಾಖ್ಯಾನ ಫೈಲ್, ದಾಖಲಾತಿ ವ್ಯವಸ್ಥೆಗಳ ಪದ ನಿರ್ವಹಣೆಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_cbz"
msgstr "CBZ ಕಾಮಿಕ್ ಪುಸ್ತಕ (ZIP ನಲ್ಲಿ ಸಂಕುಚಿತಗೊಳಿಸಲಾದ ಕಾಮಿಕ್ ಚಿತ್ರಗಳು, ಕಾಮಿಕ್ ಸಂಗ್ರಹದ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ)"

msgid "mime_cbr"
msgstr "CBR ಕಾಮಿಕ್ ಪುಸ್ತಕ (RAR ನಲ್ಲಿ ಸಂಕುಚಿತಗೊಳಿಸಲಾದ ಕಾಮಿಕ್ ಚಿತ್ರಗಳು, ಕಾಮಿಕ್ ಸಂಗ್ರಹದ ಸಾರ್ವತ್ರಿಕ ಸ್ವರೂಪ)"

msgid "mime_fb2"
msgstr "FB2 ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ (FictionBook 2.0, ರಷ್ಯನ್ ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ ಸ್ವರೂಪ, XML ರಚನೆ, ಓಪನ್ ಸೋರ್ಸ್ ರೀಡರ್ಗಳಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬೆಂಬಲಿತವಾಗಿದೆ)"

msgid "mime_kepub"
msgstr "KEPUB ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ (Kobo ನ ವಿಶೇಷ EPUB ಸ್ವರೂಪ, Kobo ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ ರೀಡರ್ನ ಆಪ್ಟಿಮೈಸ್ಡ್ ಸ್ವರೂಪ)"

msgid "mime_m4b"
msgstr "M4B ಆಡಿಯೋ ಪುಸ್ತಕ (MPEG-4 ಆಡಿಯೋ ಪುಸ್ತಕ ಸ್ವರೂಪ, ಬುಕ್ಮಾರ್ಕ್ಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, iTunes ಆಡಿಯೋ ಪುಸ್ತಕ ಸ್ವರೂಪ)"

msgid "mime_kfx"
msgstr "Kindle KFX ಸ್ವರೂಪ (2015 ರಲ್ಲಿ Amazon ಬಿಡುಗಡೆ ಮಾಡಿತು, Kindle ನ ವಿಶೇಷ ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಪುಸ್ತಕ ಸ್ವರೂಪ, ಸುಧಾರಿತ ಲೇಔಟ್ ಮತ್ತು ತ್ವರಿತ ಪುಟ ತಿರುಗಿಸುವಿಕೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ)"

msgid "mime_chm"
msgstr "CHM ಸಹಾಯ ಫೈಲ್ (1997 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ಕಂಪೈಲ್ ಮಾಡಲಾದ HTML ಸಹಾಯ ಸ್ವರೂಪ, ವಿಂಡೋಸ್ ಸಾಫ್ಟ್ವೇರ್ ಸಹಾಯ ದಸ್ತಾವೇಜಿನ ಮಾನಕ)"

msgid "mime_mht"
msgstr "MHT ವೆಬ್ ಆರ್ಕೈವ್ (1999 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ಏಕ ಫೈಲ್ ವೆಬ್ ಪುಟ ಸ್ವರೂಪ, IE ಬ್ರೌಸರ್ ಪುಟಗಳನ್ನು ಉಳಿಸಲು ಬಳಸುವ ಸ್ವರೂಪ)"

msgid "mime_wml"
msgstr "WML ವೈರ್ಲೆಸ್ ಮಾರ್ಕ್ಅಪ್ ಲಾಂಗ್ವೇಜ್ (1999 ರಲ್ಲಿ WAP ಮಾನಕ, ಆರಂಭಿಕ ಫೀಚರ್ ಫೋನ್ಗಳ ವೆಬ್ ಪುಟಗಳಿಗಾಗಿ ಬಳಸಲಾಗುತ್ತಿತ್ತು, ಈಗ ಹಳೆಯದಾಗಿದೆ)"

msgid "mime_xhtml"
msgstr "XHTML ವೆಬ್ ಪುಟ (2000 ರಲ್ಲಿ W3C ಮಾನಕ, HTML ನ XML ಆವೃತ್ತಿ, ಹೆಚ್ಚು ಕಟ್ಟುನಿಟ್ಟಾದ ಸಿಂಟ್ಯಾಕ್ಸ್ನೊಂದಿಗೆ. 2009 ರಲ್ಲಿ W3C ಬೆಂಬಲವನ್ನು ನಿಲ್ಲಿಸಿತು, ಗಮನವನ್ನು HTML5 ಗೆ ಬದಲಾಯಿಸಿತು)"

msgid "mime_xml"
msgstr "XML ದಾಖಲೆ (1998 ರಲ್ಲಿ W3C ಮಾನಕ, ಎಕ್ಸ್ಟೆನ್ಸಿಬಲ್ ಮಾರ್ಕ್ಅಪ್ ಲಾಂಗ್ವೇಜ್, ವೆಬ್ ಸೇವೆಗಳು, ಸಂರಚನಾ ಫೈಲ್ಗಳು, ಡೇಟಾ ವಿನಿಮಯದ ಮೂಲ ಸ್ವರೂಪ)"

msgid "mime_sgml"
msgstr "SGML ದಾಖಲೆ (1986 ರಲ್ಲಿ ISO ಮಾನಕ, HTML ನ ಪೂರ್ವವರ್ತಿ, ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಜನರಲೈಸ್ಡ್ ಮಾರ್ಕ್ಅಪ್ ಲಾಂಗ್ವೇಜ್, XML ಮತ್ತು HTML ಎರಡೂ SGML ನಿಂದ ಹುಟ್ಟಿಕೊಂಡಿವೆ)"

msgid "mime_apng"
msgstr "APNG ಅನಿಮೇಶನ್ (2004 ರಲ್ಲಿ Mozilla ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, PNG ಯ ಅನಿಮೇಟೆಡ್ ವಿಸ್ತರಣೆ, GIF ನ ಆಧುನಿಕ ಬದಲಿ, ನಿಜವಾದ ಬಣ್ಣಗಳು ಮತ್ತು ಅರೆಪಾರದರ್ಶಕತೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ)"

msgid "mime_bmp"
msgstr "BMP ಬಿಟ್ಮ್ಯಾಪ್ (ವಿಂಡೋಸ್ ಬಿಟ್ಮ್ಯಾಪ್ ಸ್ವರೂಪ, Windows 1.0 ರಿಂದ ಸ್ಥಳೀಯ ಬೆಂಬಲ. ಸಂಕುಚಿತಗೊಳಿಸಲಾಗಿಲ್ಲ, ಫೈಲ್ ತುಲನಾತ್ಮಕವಾಗಿ ದೊಡ್ಡದಾಗಿದೆ, ಆದರೆ ಸರಳ ರಚನೆಯ ಕಾರಣ ಮತ್ತು ಹೆಚ್ಚುವರಿ ಕೊಡೆಕ್ಗಳ ಅಗತ್ಯವಿಲ್ಲದ ಕಾರಣ, Windows 11 ಸ್ಕ್ರೀನ್ಶಾಟ್ ಟೂಲ್, ಪೇಂಟ್ ಪ್ರೋಗ್ರಾಂ, EXE/MSI ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ ಐಕಾನ್ ಸಂಪನ್ಮೂಲಗಳು, ಕರ್ಸರ್ ಫೈಲ್ಗಳು ಮತ್ತು ಕೆಲವು ಹಳೆಯ ಡ್ರೈವರ್ಗಳು ಇನ್ನೂ ಬಳಸುತ್ತವೆ. ಅದೇ ಗುಣಮಟ್ಟದ ಚಿತ್ರಕ್ಕೆ ಫೈಲ್ PNG ಗಿಂತ ಸುಮಾರು 3-10 ಪಟ್ಟು ದೊಡ್ಡದಾಗಿದೆ, ಹೆಚ್ಚಿನ ಸಂದರ್ಭಗಳಲ್ಲಿ PNG/JPEG ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ, ಆದರೆ Windows ಪರಿಸರ ವ್ಯವಸ್ಥೆಯಲ್ಲಿ ಇನ್ನೂ ವಿಶಾಲ ಹೊಂದಾಣಿಕೆಯನ್ನು ಉಳಿಸಿಕೊಂಡಿದೆ)"

msgid "mime_cdr"
msgstr "CDR ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ (CorelDRAW ನ ವಿಶೇಷ ಸ್ವರೂಪ, ಕೆನಡಾದ Corel ಕಂಪನಿ, ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ ವಿನ್ಯಾಸ ಸಾಫ್ಟ್ವೇರ್)"

msgid "mime_gif"
msgstr "GIF ಚಿತ್ರ (1987 ರಲ್ಲಿ CompuServe ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, 256 ಬಣ್ಣದ ಚಲಿಸುವ ಚಿತ್ರ ಸ್ವರೂಪ. ನ್ಯೂನತೆಗಳು: ಕಡಿಮೆ ಬಣ್ಣಗಳು, ಕಡಿಮೆ ಗುಣಮಟ್ಟ, ಅರೆಪಾರದರ್ಶಕತೆ ಇಲ್ಲ, ದೊಡ್ಡ ಫೈಲ್, ಕಡಿಮೆ ಫ್ರೇಮ್ ದರ. APNG, WebP ನಂತಹ ಆಧುನಿಕ ಚಲಿಸುವ ಚಿತ್ರ ಸ್ವರೂಪಗಳಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_ico"
msgstr "ICO ಐಕಾನ್ (ವಿಂಡೋಸ್ ಐಕಾನ್ ಫೈಲ್ ಸ್ವರೂಪ, ಬಹು ರೆಸಲ್ಯೂಶನ್ಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ವೆಬ್ಸೈಟ್ favicon ನ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_jpeg"
msgstr "JPEG ಚಿತ್ರ (1992 ರಲ್ಲಿ ISO ಮಾನಕ, ನಷ್ಟದ ಸಂಕುಚನ ಫೋಟೋ ಸ್ವರೂಪ, ಇಂಟರ್ನೆಟ್ ಫೋಟೋಗಳ ವಾಸ್ತವಿಕ ಮಾನಕ)"

msgid "mime_jpg"
msgstr "JPEG ಚಿತ್ರ (1992 ರಲ್ಲಿ ISO ಮಾನಕ, ನಷ್ಟದ ಸಂಕುಚನ ಫೋಟೋ ಸ್ವರೂಪ, ಇಂಟರ್ನೆಟ್ ಫೋಟೋಗಳ ವಾಸ್ತವಿಕ ಮಾನಕ)"

msgid "mime_png"
msgstr "PNG ಚಿತ್ರ (1996 ರಲ್ಲಿ W3C ಶಿಫಾರಸು, ನಿಜವಾದ ಬಣ್ಣಗಳು ಮತ್ತು ಅರೆಪಾರದರ್ಶಕತೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, GIF ನ ಸ್ಥಿರ ಬದಲಿ, ಇಂಟರ್ನೆಟ್ನ ನಷ್ಟರಹಿತ ಚಿತ್ರ ಮಾನಕ)"

msgid "mime_ps"
msgstr "PostScript ಪುಟ ವಿವರಣೆ ಫೈಲ್ (1985 ರಲ್ಲಿ Adobe ಬಿಡುಗಡೆ ಮಾಡಿತು, ಪುಟ ವಿವರಣೆ ಭಾಷೆ, PDF ನ ಪೂರ್ವವರ್ತಿ, ಮುದ್ರಣ ಮತ್ತು ಪ್ರಕಾಶನಕ್ಕಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_psb"
msgstr "PSB ದೊಡ್ಡ ದಾಖಲೆ (Adobe Photoshop ನ ಅತಿದೊಡ್ಡ ಚಿತ್ರ ಸ್ವರೂಪ, 2GB ಅಥವಾ 30000 ಪಿಕ್ಸೆಲ್ಗಳಿಗಿಂತ ದೊಡ್ಡ ಚಿತ್ರಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ)"

msgid "mime_psd"
msgstr "PSD ಚಿತ್ರ (Adobe Photoshop ನ ಮೂಲ ಫೈಲ್, ಲೇಯರ್ಗಳು, ಚಾನೆಲ್ಗಳು, ಪಥಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಚಿತ್ರ ಸಂಸ್ಕರಣಾ ಉದ್ಯಮದ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_webp"
msgstr "WebP ಚಿತ್ರ (2010 ರಲ್ಲಿ Google ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ವೆಬ್ ಚಿತ್ರ ಸ್ವರೂಪ, ನಷ್ಟ/ನಷ್ಟರಹಿತ ಸಂಕುಚನ ಮತ್ತು ಅನಿಮೇಶನ್ ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಸಂಕುಚನ ದರವು PNG ಗಿಂತ 25-35% ಉತ್ತಮವಾಗಿದೆ, JPEG ಗಿಂತ 25% ಉತ್ತಮವಾಗಿದೆ)"

msgid "mime_woff"
msgstr "WOFF ವೆಬ್ ಫಾಂಟ್ (2009 ರಲ್ಲಿ ರಚಿಸಲಾಯಿತು, 2018 ರಲ್ಲಿ W3C ಮಾನಕ. TrueType/OpenType ಆಧರಿಸಿ ಸಂಕುಚಿತಗೊಳಿಸಲಾಗಿದೆ, ವೆಬ್ ಫಾಂಟ್ ಲೋಡಿಂಗ್ ಆಪ್ಟಿಮೈಸೇಶನ್, ಆಧುನಿಕ ವೆಬ್ಸೈಟ್ ಐಕಾನ್ ಫಾಂಟ್ಗಳ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_7z"
msgstr "7z ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1999 ರಲ್ಲಿ Igor Pavlov ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, 7-Zip ಪ್ರೋಗ್ರಾಂನ ವಿಶೇಷ ಸ್ವರೂಪ. LZMA ಅಲ್ಗಾರಿದಮ್, ಹೆಚ್ಚಿನ ಸಂಕುಚನ ದರ, ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಉಚಿತ. 7z ಸ್ವರೂಪವು ಅದೇ ಸಂಕುಚನ ಮಟ್ಟದಲ್ಲಿ ಸಾಮಾನ್ಯವಾಗಿ ZIP ಗಿಂತ 30-50% ಚಿಕ್ಕದಾಗಿದೆ, ಓಪನ್ ಸೋರ್ಸ್ ಸಮುದಾಯ ಮತ್ತು ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಯ ಸಾಮಾನ್ಯ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_ace"
msgstr "ACE ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1990 ರ ದಶಕದಲ್ಲಿ ರಚಿಸಲಾಯಿತು, WinACE ಪ್ರೋಗ್ರಾಂ ಸ್ವರೂಪ. RAR ನೊಂದಿಗೆ ಸ್ಪರ್ಧಿಸಿತು, ಸಂಕುಚನ ದರವು ಸಾಕಷ್ಟು ಹೆಚ್ಚಿತ್ತು. 2007 ರಲ್ಲಿ ಅಭಿವೃದ್ಧಿಯನ್ನು ನಿಲ್ಲಿಸಲಾಯಿತು, ಈಗ 7z/RAR ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ, ವಿರಳವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_bz2"
msgstr "BZIP2 ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1996 ರಲ್ಲಿ Julian Seward ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, ಬ್ಲಾಕ್ ವಿಂಗಡಣೆ ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್. ಸಂಕುಚನ ದರವು GZIP ಗಿಂತ 15-20% ಉತ್ತಮವಾಗಿದೆ, ಆದರೆ ವೇಗವು ನಿಧಾನವಾಗಿದೆ. Linux ಕರ್ನಲ್ ಮೂಲ ಕೋಡ್, ಓಪನ್ ಸೋರ್ಸ್ ಪ್ಯಾಕೇಜ್ಗಳ ಸಾಮಾನ್ಯ ಸ್ವರೂಪ, ವಿಸ್ತರಣೆ .bz2)"

msgid "mime_cab"
msgstr "CAB ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1995 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಕ್ಯಾಬಿನೆಟ್ ಸ್ವರೂಪ. ವಿಂಡೋಸ್ ಸಿಸ್ಟಮ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ ಸ್ವರೂಪ, ಡ್ರೈವರ್ಗಳು, ಸಿಸ್ಟಮ್ ಫೈಲ್ಗಳನ್ನು ವಿತರಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ. Windows Installer (MSI) ಆಂತರಿಕವಾಗಿ ಫೈಲ್ಗಳನ್ನು ಸಂಗ್ರಹಿಸಲು CAB ಅನ್ನು ಬಳಸುತ್ತದೆ)"

msgid "mime_dmg"
msgstr "DMG ಡಿಸ್ಕ್ ಇಮೇಜ್ (1980 ರ ದಶಕದಲ್ಲಿ Apple ಬಿಡುಗಡೆ ಮಾಡಿತು, ಡಿಸ್ಕ್ ಇಮೇಜ್ ಸ್ವರೂಪ. macOS ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಯ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, ಡಬಲ್ ಕ್ಲಿಕ್ ಮಾಡುವುದರಿಂದ ವರ್ಚುವಲ್ ಡಿಸ್ಕ್ ಆಗಿ ಮೌಂಟ್ ಆಗುತ್ತದೆ, ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಸ್ಥಾಪಿಸಲು ಎಳೆದು ಬಿಡುವುದು ಸಾಕು. ಸಂಕುಚನ ಮತ್ತು ಎನ್ಕ್ರಿಪ್ಶನ್ ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಮ್ಯಾಕ್ ಸಾಫ್ಟ್ವೇರ್ ಡೌನ್ಲೋಡ್ಗಳ ಪ್ರಮುಖ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_emz"
msgstr "EMZ ಸಂಕುಚಿತ ಚಿತ್ರ (ವಿಂಡೋಸ್ ಸಂಕುಚಿತ ಸುಧಾರಿತ ಮೆಟಾಫೈಲ್, EMF ನ ಸಂಕುಚಿತ ಆವೃತ್ತಿ. Office ದಾಖಲೆಗಳಲ್ಲಿ ವೆಕ್ಟರ್ ಗ್ರಾಫಿಕ್ಸ್ ಸಂಗ್ರಹಿಸುವ ಸ್ವರೂಪ, ಮೂಲಭೂತವಾಗಿ GZIP ನಿಂದ ಸಂಕುಚಿತಗೊಳಿಸಲಾದ EMF ಫೈಲ್ ಆಗಿದೆ)"

msgid "mime_gz"
msgstr "GZIP ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1992 ರಲ್ಲಿ Jean-loup Gailly ಮತ್ತು Mark Adler ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, GNU ಯೋಜನೆ. Unix/Linux ನ ಪ್ರಮಾಣಿತ ಸಂಕುಚನ ಉಪಕರಣ, HTTP ಪ್ರಸರಣ ಸಂಕುಚನದ ಸಾಮಾನ್ಯ ಸ್ವರೂಪ. ವಿಸ್ತರಣೆ .gz, ಸಾಮಾನ್ಯವಾಗಿ TAR ಜೊತೆಗೆ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_jar"
msgstr "JAR ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1997 ರಲ್ಲಿ Sun Microsystems ಬಿಡುಗಡೆ ಮಾಡಿತು, Java ARchive ಸ್ವರೂಪ. ಮೂಲಭೂತವಾಗಿ ZIP ಸಂಕುಚಿತ ಆರ್ಕೈವ್, ಜಾವಾ ಕ್ಲಾಸ್ ಲೈಬ್ರರಿಗಳು ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್ಗಳನ್ನು ಪ್ಯಾಕೇಜ್ ಮಾಡಲು ಬಳಸಲಾಗುತ್ತದೆ. ಮಾವೆನ್, ಗ್ರೇಡಲ್ ನಂತಹ ಜಾವಾ ಪರಿಸರ ವ್ಯವಸ್ಥೆಯ ಮೂಲ ಸ್ವರೂಪ, ಆಂಡ್ರಾಯ್ಡ್ ಸಹ JAR ಅನ್ನು ಬಳಸುತ್ತದೆ)"

msgid "mime_lzma"
msgstr "LZMA ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1998 ರಲ್ಲಿ Igor Pavlov ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, Lempel-Ziv-Markov chain ಅಲ್ಗಾರಿದಮ್. 7z ಸ್ವರೂಪದ ಮೂಲ ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್, ಹೆಚ್ಚಿನ ಸಂಕುಚನ ದರ, ಡಿಕಂಪ್ರೆಶನ್ ವೇಗವು ವೇಗವಾಗಿದೆ. ಫರ್ಮ್ವೇರ್, ಎಂಬೆಡೆಡ್ ಸಿಸ್ಟಮ್ಗಳ ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_rar"
msgstr "RAR ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1993 ರಲ್ಲಿ Eugene Roshal ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, Roshal ARchive ಸ್ವರೂಪ. ಹೆಚ್ಚಿನ ಸಂಕುಚನ ದರ, ಬಹುಭಾಗದ ಸಂಕುಚನ, ಮರುಸ್ಥಾಪನೆ ದಾಖಲೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. WinRAR ಪ್ರೋಗ್ರಾಂ ಸ್ವರೂಪ, ಸಂಕುಚನ ದರವು ZIP ಗಿಂತ ಉತ್ತಮವಾಗಿದೆ, ಆದರೆ ಪಾವತಿಸಿದ ಸಾಫ್ಟ್ವೇರ್ ಅಗತ್ಯವಿದೆ, unrar ನಂತಹ ಓಪನ್ ಸೋರ್ಸ್ ಉಪಕರಣಗಳು ಅದನ್ನು ಡಿಕಂಪ್ರೆಸ್ ಮಾಡಬಹುದು)"

msgid "mime_tar"
msgstr "TAR ಆರ್ಕೈವ್ (1979 ರಲ್ಲಿ Unix V7 ನಲ್ಲಿ ಪರಿಚಯಿಸಲಾಯಿತು, ಟೇಪ್ ಆರ್ಕೈವ್ ಸ್ವರೂಪ. ಟೇಪ್ ಆರ್ಕೈವ್ ಸ್ವರೂಪ, ಸಂಕುಚನಗೊಳಿಸುವುದಿಲ್ಲ, ಕೇವಲ ಪ್ಯಾಕ್ ಮಾಡುತ್ತದೆ, ಸಾಮಾನ್ಯವಾಗಿ GZIP/BZIP2/XZ ಜೊತೆಗೆ ಬಳಸಲಾಗುತ್ತದೆ. Linux ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್ಗಳ ಮೂಲ ಕೋಡ್, ಡಾಕರ್ ಕಂಟೇನರ್ ಲೇಯರ್ಗಳ ಸಂಗ್ರಹಣೆ TAR ಸ್ವರೂಪವನ್ನು ಬಳಸುತ್ತದೆ)"

msgid "mime_tgz"
msgstr "TGZ ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (TAR + GZIP ಸಂಯೋಜನೆಯ ಸ್ವರೂಪ, ವಿಸ್ತರಣೆ .tgz ಅಥವಾ .tar.gz. Unix/Linux ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್ಗಳ ಅತ್ಯಂತ ಸಾಮಾನ್ಯ ವಿತರಣಾ ಸ್ವರೂಪ, ಮೂಲ ಕೋಡ್ ಪ್ಯಾಕೇಜ್ಗಳು, ಬೈನರಿ ಪ್ಯಾಕೇಜ್ಗಳನ್ನು ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, 'ಅನ್ಪ್ಯಾಕ್ ಮಾಡಿ ಮತ್ತು ಬಳಸಿ' ಪ್ರತಿನಿಧಿ)"

msgid "mime_tbz2"
msgstr "TBZ2 ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (TAR + BZIP2 ಸಂಯೋಜನೆಯ ಸ್ವರೂಪ, ವಿಸ್ತರಣೆ .tbz2 ಅಥವಾ .tar.bz2. ಸಂಕುಚನ ದರವು TGZ ಗಿಂತ 15-20% ಉತ್ತಮವಾಗಿದೆ, ದೊಡ್ಡ ಫೈಲ್ಗಳಿಗೆ ಸೂಕ್ತವಾಗಿದೆ, Linux ಕರ್ನಲ್ ಮೂಲ ಕೋಡ್ ದೀರ್ಘಕಾಲದವರೆಗೆ ಈ ಸ್ವರೂಪವನ್ನು ಬಳಸುತ್ತಿತ್ತು)"

msgid "mime_xz"
msgstr "XZ ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (2009 ರಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, LZMA2 ಅಲ್ಗಾರಿದಮ್ ಆಧರಿಸಿದೆ. ಸಂಕುಚನ ದರವು ತುಂಬಾ ಹೆಚ್ಚಾಗಿದೆ, GZIP ಗಿಂತ 30-50% ಉತ್ತಮವಾಗಿದೆ, ಡಿಕಂಪ್ರೆಶನ್ ವೇಗವು ತುಲನಾತ್ಮಕವಾಗಿ ವೇಗವಾಗಿದೆ. Linux ಕರ್ನಲ್, ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ಗಳು (ಉದಾ. ಡೆಬಿಯನ್ .deb ಒಳಗೆ) ವ್ಯಾಪಕವಾಗಿ ಬಳಸುತ್ತಾರೆ, ಪ್ರಸ್ತುತ Linux ಪರಿಸರ ವ್ಯವಸ್ಥೆಯ ಶಿಫಾರಸು ಮಾಡಲಾದ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_z"
msgstr "Z ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1985 ರಲ್ಲಿ Unix ಕಂಪ್ರೆಸ್ ಆಜ್ಞೆಯ ಸ್ವರೂಪ, LZW ಅಲ್ಗಾರಿದಮ್. ಆರಂಭಿಕ Unix ಸಂಕುಚನ ಸ್ವರೂಪ, ಈಗಾಗಲೇ GZIP ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ. ವಿಸ್ತರಣೆ .Z, ಆಧುನಿಕ ವ್ಯವಸ್ಥೆಗಳಲ್ಲಿ ವಿರಳವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_zip"
msgstr "ZIP ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1989 ರಲ್ಲಿ Phil Katz ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, PKZIP ಸ್ವರೂಪ. ವಿಂಡೋಸ್ ಸ್ಥಳೀಯ ಬೆಂಬಲ, ಇಂಟರ್ನೆಟ್ನ ಅತ್ಯಂತ ಸಾಮಾನ್ಯ ಸಂಕುಚನ ಸ್ವರೂಪ. ಬಹು ಫೈಲ್ಗಳು, ಡೈರೆಕ್ಟರಿ ರಚನೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡುವ ಸಾಮರ್ಥ್ಯವಿದೆ. ಜಾವಾದ JAR, ಆಂಡ್ರಾಯ್ಡ್ನ APK, ಆಫೀಸ್ ದಾಖಲೆಗಳ DOCX/XLSX ಎಲ್ಲಾ ZIP ಸ್ವರೂಪವನ್ನು ಆಧರಿಸಿವೆ)"

msgid "mime_zst"
msgstr "Zstandard ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (2015 ರಲ್ಲಿ Facebook ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, Yann Collet ವಿನ್ಯಾಸ. ಹೆಚ್ಚಿನ ವೇಗದ ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್, ಸಂಕುಚನ ದರವು LZMA ಗೆ ಹತ್ತಿರದಲ್ಲಿದೆ, ವೇಗದಲ್ಲಿ GZIP ಗಿಂತ ಬಹಳಷ್ಟು ಮೀರಿಸುತ್ತದೆ. Linux ಕರ್ನಲ್ 5.9+ ಬೆಂಬಲಿಸುತ್ತದೆ, Arch Linux pacman, Debian APT ಕ್ರಮೇಣ ಅಳವಡಿಸಿಕೊಳ್ಳುತ್ತಿವೆ, ಹೊಸ ಪೀಳಿಗೆಯ ಸಂಕುಚನ ಮಾನಕವಾಗಿದೆ)"

msgid "mime_lz4"
msgstr "LZ4 ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (2011 ರಲ್ಲಿ Yann Collet ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, ಎಕ್ಸ್ಟ್ರಾ ವೇಗದ ಸಂಕುಚನ ಅಲ್ಗಾರಿದಮ್. ಸಂಕುಚನ ವೇಗವು GZIP ಗಿಂತ 10 ಪಟ್ಟು ವೇಗವಾಗಿದೆ, ನೈಜ ಸಮಯದ ಸಂಕುಚನಕ್ಕೆ ಸೂಕ್ತವಾಗಿದೆ. Linux ಕರ್ನಲ್, OpenZFS, Hadoop ವ್ಯಾಪಕವಾಗಿ ಬಳಸುತ್ತವೆ, ವೇಗದ ಆದ್ಯತೆಯ ಸಂದರ್ಭಗಳಲ್ಲಿ ಆದ್ಯತೆಯ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_lzo"
msgstr "LZO ಸಂಕುಚಿತ ಆರ್ಕೈವ್ (1996 ರಲ್ಲಿ Markus Oberhumer ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, Lempel-Ziv-Oberhumer ಅಲ್ಗಾರಿದಮ್. ಡಿಕಂಪ್ರೆಶನ್ ವೇಗವು ತುಂಬಾ ವೇಗವಾಗಿದೆ, ಸಂಕುಚನ ದರವು ಮಧ್ಯಮವಾಗಿದೆ. Linux ಕರ್ನಲ್ನ Squashfs, OpenWrt ಫರ್ಮ್ವೇರ್ ಬಳಸುತ್ತದೆ, ಎಂಬೆಡೆಡ್ ಸಿಸ್ಟಮ್ಗಳಿಗೆ ಸೂಕ್ತವಾಗಿದೆ)"

msgid "mime_msi"
msgstr "MSI ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ (1999 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ವಿಂಡೋಸ್ ಇನ್ಸ್ಟಾಲರ್ ಪ್ಯಾಕೇಜ್ ಸ್ವರೂಪ. ವಿಂಡೋಸ್ ಅಪ್ಲಿಕೇಶನ್ಗಳ ಪ್ರಮಾಣಿತ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ, ಟ್ರಾನ್ಸಾಕ್ಷನ್ ರೋಲ್ಬ್ಯಾಕ್, ಕಾಂಪೊನೆಂಟ್ ನಿರ್ವಹಣೆ, ಮೂಕ ಇನ್ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. ಕಾರ್ಪೊರೇಟ್ ಮಟ್ಟದ ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಯ ಆದ್ಯತೆಯ ಸ್ವರೂಪ, ಇಂದಿಗೂ ವಿಂಡೋಸ್ ಸಾಫ್ಟ್ವೇರ್ ಇನ್ಸ್ಟಾಲೇಶನ್ನ ಪ್ರಮುಖ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_pkg"
msgstr "PKG ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ (macOS ಅಪ್ಲಿಕೇಶನ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ, Apple ನ ಇನ್ಸ್ಟಾಲರ್ ತಂತ್ರಜ್ಞಾನವನ್ನು ಆಧರಿಸಿದೆ. macOS ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಯ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, ಕಾಂಪೊನೆಂಟ್ ಆಯ್ಕೆ, ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ಕ್ರಿಪ್ಟ್ಗಳು, ಅನ್ಇನ್ಸ್ಟಾಲೇಶನ್ ಕಾರ್ಯವನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. .pkg ಫೈಲ್ ಅನ್ನು ಡಬಲ್ ಕ್ಲಿಕ್ ಮಾಡುವುದರಿಂದ ಸ್ಥಾಪಿಸಬಹುದು, Mac App Store ಹೊರಗೆ ಸಾಫ್ಟ್ವೇರ್ ವಿತರಣೆಯ ಸಾಮಾನ್ಯ ವಿಧಾನವಾಗಿದೆ)"

msgid "mime_apk"
msgstr "APK ಆಂಡ್ರಾಯ್ಡ್ ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2008 ರಲ್ಲಿ Google ಬಿಡುಗಡೆ ಮಾಡಿತು, ಆಂಡ್ರಾಯ್ಡ್ ಸಿಸ್ಟಮ್ನ ಸಾಂಪ್ರದಾಯಿಕ ಅಪ್ಲಿಕೇಶನ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ. APK ಮೂಲಭೂತವಾಗಿ ZIP ಸಂಕುಚಿತ ಆರ್ಕೈವ್ ಆಗಿದೆ, ಕೋಡ್, ಸಂಪನ್ಮೂಲಗಳು, ಮ್ಯಾನಿಫೆಸ್ಟ್ ಫೈಲ್ ಅನ್ನು ಒಳಗೊಂಡಿದೆ. 2021 ರಿಂದ Google Play ಹೊಸ ಅಪ್ಲಿಕೇಶನ್ಗಳು AAB ಸ್ವರೂಪಕ್ಕೆ ಬದಲಾಯಿಸಬೇಕೆಂದು ಒತ್ತಾಯಿಸುತ್ತದೆ, ಆದರೆ APK ಅನ್ನು ಅಭಿವೃದ್ಧಿ ಮತ್ತು ಡೀಬಗ್ ಮಾಡುವಿಕೆ, ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಅಂಗಡಿಗಳು ಮತ್ತು ಸೈಡ್ಲೋಡಿಂಗ್ಗಾಗಿ ಇನ್ನೂ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_ipa"
msgstr "IPA ಆಪಲ್ ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (iOS App Store Package, iOS/iPadOS ಅಪ್ಲಿಕೇಶನ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ. 2008 ರಲ್ಲಿ iPhone SDK ನೊಂದಿಗೆ ಬಿಡುಗಡೆಯಾಯಿತು. App Store ಮೂಲಕ ವಿತರಿಸಬೇಕು ಅಥವಾ ಕಾರ್ಪೊರೇಟ್ ಪ್ರಮಾಣೀಕರಣದೊಂದಿಗೆ ಸಹಿ ಮಾಡಬೇಕಾಗುತ್ತದೆ. ರನ್ ಮಾಡಬಹುದಾದ ಫೈಲ್, ಸಂಪನ್ಮೂಲಗಳು, Info.plist, ಸಹಿ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿದೆ)"

msgid "mime_hap"
msgstr "HAP ಹಾರ್ಮೊನಿ OS ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (HarmonyOS ಎಬಿಲಿಟಿ ಪ್ಯಾಕೇಜ್, ಹಾರ್ಮೊನಿ OS ಅಪ್ಲಿಕೇಶನ್ನ ಮೂಲ ಘಟಕ. 2020 ರಲ್ಲಿ ಹಾರ್ಮೊನಿ OS 2.0 ನೊಂದಿಗೆ ಬಿಡುಗಡೆಯಾಯಿತು. ಎಂಟ್ರಿ ಮತ್ತು ಫೀಚರ್ ಎರಡು ಪ್ರಕಾರಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಹುವಾವೇ ಫೋನ್ಗಳು, ಟ್ಯಾಬ್ಲೆಟ್ಗಳು, ಸ್ಮಾರ್ಟ್ ವಾಚ್ಗಳು ಮುಂತಾದ ಹಾರ್ಮೊನಿ OS ಸಾಧನಗಳ ವಿತರಣಾ ಸ್ವರೂಪ)"

msgid "mime_har"
msgstr "HAR ಹಾರ್ಮೊನಿ OS ಸ್ಥಿರ ಹಂಚಿಕೆ ಪ್ಯಾಕೇಜ್ (HarmonyOS Archive, ಹಾರ್ಮೊನಿ OS ಸ್ಥಿರ ಹಂಚಿಕೆ ಲೈಬ್ರರಿ, ಅನೇಕ HAP ಗಳ ನಡುವೆ ಹಂಚಿಕೊಳ್ಳಬಹುದು, ಕಾಂಪೊನೆಂಟ್-ಆಧಾರಿತ ಅಭಿವೃದ್ಧಿ ಮತ್ತು ಮಾಡ್ಯೂಲ್ ಮರುಬಳಕೆಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_aab"
msgstr "Android App Bundle (2018 ರಲ್ಲಿ Google ಬಿಡುಗಡೆ ಮಾಡಿತು, 2021 ರಿಂದ Google Play ಹೊಸ ಅಪ್ಲಿಕೇಶನ್ಗಳು ಈ ಸ್ವರೂಪವನ್ನು ಬಳಸಬೇಕೆಂದು ಒತ್ತಾಯಿಸುತ್ತದೆ. AAB ವಿತರಣಾ ಸ್ವರೂಪವಾಗಿದೆ, Google Play ಸಾಧನದ ಸಂರಚನೆಯ ಆಧಾರದಲ್ಲಿ (CPU ಆರ್ಕಿಟೆಕ್ಚರ್, ಪರದೆಯ ಸಾಂದ್ರತೆ, ಭಾಷೆ) ಡೈನಾಮಿಕ್ ಆಗಿ ಆಪ್ಟಿಮೈಸ್ಡ್ APK ಅನ್ನು ರಚಿಸುತ್ತದೆ, ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ ಗಾತ್ರವು ಸರಾಸರಿ 35% ರಷ್ಟು ಕಡಿಮೆಯಾಗುತ್ತದೆ. ಡೆವಲಪರ್ AAB ಅನ್ನು ಅಪ್ಲೋಡ್ ಮಾಡುತ್ತಾರೆ, ಬಳಕೆದಾರರು APK ಅನ್ನು ಡೌನ್ಲೋಡ್ ಮಾಡುತ್ತಾರೆ)"

msgid "mime_xapk"
msgstr "XAPK ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಆಂಡ್ರಾಯ್ಡ್ ಅಪ್ಲಿಕೇಶನ್ ವಿಸ್ತೃತ ಪ್ಯಾಕೇಜ್, APK + OBB ಡೇಟಾ ಫೈಲ್ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ. ದೊಡ್ಡ ಆಟಗಳು ಮತ್ತು ಸಂಕೀರ್ಣ ಅಪ್ಲಿಕೇಶನ್ಗಳಿಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, APK ಯ 100MB ಮಿತಿ ಸಮಸ್ಯೆಯನ್ನು ಪರಿಹರಿಸುತ್ತದೆ. APKPure, APKMirror ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಅಪ್ಲಿಕೇಶನ್ ಅಂಗಡಿಗಳಲ್ಲಿ ಸಾಮಾನ್ಯವಾಗಿದೆ, Google ನ ಅಧಿಕೃತ ಸ್ವರೂಪವಲ್ಲ)"

msgid "mime_appx"
msgstr "ವಿಂಡೋಸ್ ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2012 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, Windows 8/10/11 ಅಪ್ಲಿಕೇಶನ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ. UWP ಮತ್ತು ಡೆಸ್ಕ್ಟಾಪ್ ಅಪ್ಲಿಕೇಶನ್ ರೂಪಾಂತರವನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, Microsoft Store ಮೂಲಕ ವಿತರಿಸಲಾಗುತ್ತದೆ. 2024 ರಲ್ಲಿ Microsoft MSIX ಅನ್ನು ಉತ್ತರಾಧಿಕಾರಿ ಸ್ವರೂಪವಾಗಿ ಬಿಡುಗಡೆ ಮಾಡಿತು, ಕ್ರಮೇಣ APPX ಅನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ)"

msgid "mime_msix"
msgstr "MSIX ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2018 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ವಿಂಡೋಸ್ನ ಹೊಸ ಪೀಳಿಗೆಯ ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜಿಂಗ್ ಸ್ವರೂಪ. APPX ಮತ್ತು MSI ಯ ಅನುಕೂಲಗಳನ್ನು ಸಂಯೋಜಿಸುತ್ತದೆ, ಎಲ್ಲಾ ವಿಂಡೋಸ್ ಅಪ್ಲಿಕೇಶನ್ ಪ್ರಕಾರಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, Microsoft Store ಮೂಲಕ ಅಥವಾ ಸೈಡ್ಲೋಡಿಂಗ್ ಮೂಲಕ ಸ್ಥಾಪಿಸಬಹುದು, Windows 11 ರ ಶಿಫಾರಸು ಮಾಡಲಾದ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_appimage"
msgstr "AppImage ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2004 ರಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, Linux ನ ಅನ್ಸ್ಥಾಲಿಸದ ಅಪ್ಲಿಕೇಶನ್ ಸ್ವರೂಪ. 'ಒಂದು ಅಪ್ಲಿಕೇಶನ್ ಒಂದು ಫೈಲ್', ಸ್ಥಾಪಿಸದೆಯೇ ನೇರವಾಗಿ ರನ್ ಆಗುತ್ತದೆ, ಹೆಚ್ಚಿನ Linux ವಿತರಣೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಡೆವಲಪರ್ಗಳು Linux ಸಾಫ್ಟ್ವೇರ್ ಅನ್ನು ವಿತರಿಸುವ ಸಾಮಾನ್ಯ ವಿಧಾನವಾಗಿದೆ)"

msgid "mime_flatpak"
msgstr "Flatpak ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2015 ರಲ್ಲಿ ಬಿಡುಗಡೆಯಾಯಿತು, Linux ನ ಸ್ಯಾಂಡ್ಬಾಕ್ಸ್ ಮಾಡಲಾದ ಅಪ್ಲಿಕೇಶನ್ ಸ್ವರೂಪ. ವಿತರಣೆಗಳ ನಡುವೆ ರನ್ ಆಗುತ್ತದೆ, ಹೋಸ್ಟ್ ಸಿಸ್ಟಮ್ನಿಂದ ಪ್ರತ್ಯೇಕಿಸಲಾಗಿದೆ, Fedora, Red Hat ಅಭಿವೃದ್ಧಿಯಲ್ಲಿ ಮುನ್ನಡೆಸುತ್ತವೆ, GNOME ಸಾಫ್ಟ್ವೇರ್ ಸೆಂಟರ್ನ ಡೀಫಾಲ್ಟ್ ಸ್ವರೂಪ)"

msgid "mime_snap"
msgstr "Snap ಅಪ್ಲಿಕೇಶನ್ ಪ್ಯಾಕೇಜ್ (2014 ರಲ್ಲಿ Canonical ಬಿಡುಗಡೆ ಮಾಡಿತು, ಉಬುಂಟು ಮೂಲ ಕಂಪನಿ, Linux ನ ಸಾರ್ವತ್ರಿಕ ಅಪ್ಲಿಕೇಶನ್ ಸ್ವರೂಪ. ಸ್ವಯಂಚಾಲಿತ ಅಪ್ಡೇಟ್, ಸ್ಯಾಂಡ್ಬಾಕ್ಸ್ ಪ್ರತ್ಯೇಕತೆ, 40+ Linux ವಿತರಣೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಉಬುಂಟು ಸಾಫ್ಟ್ವೇರ್ ಸೆಂಟರ್ನ ಡೀಫಾಲ್ಟ್ ಸ್ವರೂಪ)"

msgid "mime_deb"
msgstr "ಡೆಬಿಯನ್ ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್ (1993 ರಲ್ಲಿ ಡೆಬಿಯನ್ ಯೋಜನೆ ಬಿಡುಗಡೆ ಮಾಡಿತು, Debian/Ubuntu ಮತ್ತು ಅವುಗಳ ಉತ್ಪನ್ನಗಳ ಪ್ರಮಾಣಿತ ಇನ್ಸ್ಟಾಲೇಶನ್ ಸ್ವರೂಪ. dpkg ನಿಂದ ನಿರ್ವಹಿಸಲ್ಪಡುತ್ತದೆ, APT ಅದರ ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ ಫ್ರಂಟ್-ಎಂಡ್ ಆಗಿದೆ, Linux ಪರಿಸರ ವ್ಯವಸ್ಥೆಯ ಅತ್ಯಂತ ಪ್ರಬುದ್ಧ ಪ್ಯಾಕೇಜ್ ಸ್ವರೂಪಗಳಲ್ಲಿ ಒಂದಾಗಿದೆ, ಇಂದಿಗೂ Debian ಕುಟುಂಬದ ಪ್ರಮುಖ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_rpm"
msgstr "RPM ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್ (1997 ರಲ್ಲಿ Red Hat ಬಿಡುಗಡೆ ಮಾಡಿತು, Red Hat/Fedora/CentOS/SUSE ಮತ್ತು ಇತರ ವಿತರಣೆಗಳ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ. RPM ಪೂರ್ಣವಾಗಿ 'Red Hat Package Manager' ಆಗಿದೆ, DEB ಜೊತೆಗೆ Linux ನ ಎರಡು ಪ್ರಮುಖ ಪ್ಯಾಕೇಜ್ ಸ್ವರೂಪಗಳಲ್ಲಿ ಒಂದಾಗಿದೆ, ಇಂದಿಗೂ RHEL ಕುಟುಂಬದ ಪ್ರಮುಖ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_pacman"
msgstr "ಆರ್ಚ್ ಸಾಫ್ಟ್ವೇರ್ ಪ್ಯಾಕೇಜ್ (2002 ರಲ್ಲಿ Arch Linux ಬಿಡುಗಡೆ ಮಾಡಿತು, pacman ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ ಬಳಸುವ .pkg.tar.zst ಸ್ವರೂಪ. Arch Linux ನ ರೋಲಿಂಗ್ ರಿಲೀಸ್ನ ಕರ್ನಲ್, ಸರಳತೆ ಮತ್ತು KISS ತತ್ವಕ್ಕೆ ಹೆಸರುವಾಸಿಯಾಗಿದೆ, AUR (Arch User Repository) ಇದರ ವಿಶೇಷ ಲಕ್ಷಣವಾಗಿದೆ)"

msgid "mime_exe"
msgstr "EXE ರನ್ ಮಾಡಬಹುದಾದ ಫೈಲ್ (ವಿಂಡೋಸ್ ರನ್ ಮಾಡಬಹುದಾದ ಪ್ರೋಗ್ರಾಂ ಸ್ವರೂಪ, 'ಎಕ್ಸಿಕ್ಯೂಟಬಲ್' ನ ಸಂಕ್ಷಿಪ್ತ ರೂಪ. ವಿಂಡೋಸ್ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಮ್ನ ಸ್ಥಳೀಯ ರನ್ ಸ್ವರೂಪ, PE ರಚನೆಯನ್ನು ಒಳಗೊಂಡಿದೆ. MS-DOS ನ MZ ಸ್ವರೂಪದಿಂದ ಹುಟ್ಟಿಕೊಂಡಿದೆ, 1993 ರಲ್ಲಿ Windows NT PE (Portable Executable) ಸ್ವರೂಪವನ್ನು ಪರಿಚಯಿಸಿತು, ಇದು ಇಂದಿಗೂ ಬಳಸಲ್ಪಡುತ್ತದೆ. ಸಾಫ್ಟ್ವೇರ್ ಇನ್ಸ್ಟಾಲೇಶನ್ ಪ್ಯಾಕೇಜ್ಗಳು, ಅಪ್ಲಿಕೇಶನ್ಗಳು, ಸಿಸ್ಟಮ್ ಉಪಕರಣಗಳು ಈ ಸ್ವರೂಪವನ್ನು ಬಳಸುತ್ತವೆ. ಬಳಕೆದಾರರು ಡಬಲ್ ಕ್ಲಿಕ್ ಮಾಡುವುದರಿಂದ ರನ್ ಆಗುತ್ತದೆ, ವಿಶ್ವದ ಅತ್ಯಂತ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲ್ಪಡುವ ರನ್ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_dll"
msgstr "DLL ಡೈನಾಮಿಕ್ ಲಿಂಕ್ ಲೈಬ್ರರಿ (1993 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ಡೈನಾಮಿಕ್ ಲಿಂಕ್ ಲೈಬ್ರರಿ. ವಿಂಡೋಸ್ನ ಹಂಚಿಕೊಂಡ ಕೋಡ್ ಲೈಬ್ರರಿ, ಪ್ರೋಗ್ರಾಂ ರನ್ ಆಗುವಾಗ ಡೈನಾಮಿಕ್ ಆಗಿ ಲೋಡ್ ಆಗುತ್ತದೆ, ಮೆಮೊರಿ ಮತ್ತು ಡಿಸ್ಕ್ ಜಾಗವನ್ನು ಉಳಿಸುತ್ತದೆ. ಸಿಸ್ಟಮ್ ಕಾಂಪೊನೆಂಟ್ಗಳು, ಅಪ್ಲಿಕೇಶನ್ ಪ್ಲಗಿನ್ಗಳು, ಡ್ರೈವರ್ಗಳು ಎಲ್ಲಾ DLL ಸ್ವರೂಪವನ್ನು ಬಳಸುತ್ತವೆ. Windows API ಯ ಮೂಲ ಅನುಷ್ಠಾನದ ವಿಧಾನ, DLL Hell ಸಮಸ್ಯೆಯು .NET ಯುಗದಲ್ಲಿ ನಿವಾರಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_com"
msgstr "COM ರನ್ ಮಾಡಬಹುದಾದ ಫೈಲ್ (MS-DOS ಯುಗದ ರನ್ ಸ್ವರೂಪ, 'ಕಮಾಂಡ್' ನ ಸಂಕ್ಷಿಪ್ತ ರೂಪ. ಫೈಲ್ ರಚನೆಯು ಸರಳವಾಗಿದೆ, 64KB ಮಿತಿಯೊಂದಿಗೆ, Windows 3.x ವರೆಗೆ ಸಾಮಾನ್ಯವಾಗಿತ್ತು. ಈಗ ಹಳೆಯದಾಗಿದೆ, ಆಧುನಿಕ Windows EXE ಸ್ವರೂಪವನ್ನು ಬಳಸುತ್ತದೆ, COM ವಿಸ್ತರಣೆಯನ್ನು ಇನ್ನೂ ಕೆಲವು ಕಾಂಪೊನೆಂಟ್ ಫೈಲ್ಗಳಿಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_aac"
msgstr "AAC ಆಡಿಯೋ (1997 ರಲ್ಲಿ MPEG ಮಾನಕ, ಅಡ್ವಾನ್ಸ್ಡ್ ಆಡಿಯೋ ಕೋಡಿಂಗ್. MP3 ಯ ಉತ್ತರಾಧಿಕಾರಿ, ಅದೇ ಬಿಟ್ರೇಟ್ನಲ್ಲಿ ಗುಣಮಟ್ಟದಲ್ಲಿ MP3 ಗಿಂತ ಉತ್ತಮವಾಗಿದೆ, YouTube, iTunes, ನಿಂಟೆಂಡೋ ಸ್ವಿಚ್ನ ಡೀಫಾಲ್ಟ್ ಆಡಿಯೋ ಸ್ವರೂಪ)"

msgid "mime_alac"
msgstr "ALAC ಆಡಿಯೋ (2004 ರಲ್ಲಿ Apple ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಆಪಲ್ ಲಾಸ್ಲೆಸ್ ಆಡಿಯೋ ಕೊಡೆಕ್. Apple ನ ನಷ್ಟರಹಿತ ಸ್ವರೂಪ, 2011 ರಲ್ಲಿ ಓಪನ್ ಸೋರ್ಸ್ ಆಯಿತು, iTunes ಮತ್ತು Apple Music ನ ನಷ್ಟರಹಿತ ಆಡಿಯೋದ ಡೀಫಾಲ್ಟ್ ಸ್ವರೂಪ)"

msgid "mime_flac"
msgstr "FLAC ಆಡಿಯೋ (2001 ರಲ್ಲಿ Xiph.Org ಫೌಂಡೇಶನ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಫ್ರೀ ಲಾಸ್ಲೆಸ್ ಆಡಿಯೋ ಕೊಡೆಕ್. ನಷ್ಟರಹಿತ ಸಂಕುಚನ, ಗುಣಮಟ್ಟವು CD ಯಂತೆಯೇ ಇರುತ್ತದೆ, ಫೈಲ್ ಸರಿಸುಮಾರು WAV ನ ಅರ್ಧದಷ್ಟು ಇರುತ್ತದೆ. ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತವಾಗಿದೆ, ಆಡಿಯೋಫೈಲ್ಗಳು ಮತ್ತು ಡಿಜಿಟಲ್ ಸಂಗೀತ ಸಂಗ್ರಾಹಕರ ಆದ್ಯತೆಯ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_mp3"
msgstr "MP3 ಆಡಿಯೋ (1993 ರಲ್ಲಿ Fraunhofer ಇನ್ಸ್ಟಿಟ್ಯೂಟ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, MPEG-1 ಆಡಿಯೋ ಲೇಯರ್ 3. ನಷ್ಟದ ಸಂಕುಚನ ಸ್ವರೂಪ, ಫೈಲ್ ಚಿಕ್ಕದಾಗಿದೆ ಗುಣಮಟ್ಟವು ಸ್ವೀಕಾರಾರ್ಹವಾಗಿದೆ, 2000 ರ ದಶಕದಲ್ಲಿ ಡಿಜಿಟಲ್ ಸಂಗೀತ ಕ್ರಾಂತಿಯ ಮೂಲ ಸ್ವರೂಪ, iPod ಮತ್ತು ನ್ಯಾಪ್ಸ್ಟರ್ನ ಸಾಧನೆ. 2017 ರಲ್ಲಿ ಪೇಟೆಂಟ್ ಅವಧಿ ಮುಗಿದಿದೆ, ಸಾರ್ವಜನಿಕ ಡೊಮೇನ್ ಸ್ವರೂಪವಾಗಿದೆ)"

msgid "mime_oga"
msgstr "Ogg Audio ಆಡಿಯೋ (Xiph.Org ಫೌಂಡೇಶನ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, Ogg ಕಂಟೇನರ್ನ ಶುದ್ಧ ಆಡಿಯೋ ಸ್ವರೂಪ, Vorbis ಎನ್ಕೋಡಿಂಗ್ ಅನ್ನು ಬಳಸುತ್ತದೆ. ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತವಾಗಿದೆ, ಸಂಕುಚನ ದಕ್ಷತೆಯು MP3 ಗಿಂತ ಉತ್ತಮವಾಗಿದೆ, ಓಪನ್ ಸೋರ್ಸ್ ಯೋಜನೆಗಳಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_ogg"
msgstr "OGG ಆಡಿಯೋ (2000 ರಲ್ಲಿ Xiph.Org ಫೌಂಡೇಶನ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, Ogg Vorbis ಸ್ವರೂಪ. ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತವಾಗಿದೆ, ಸಂಕುಚನ ದಕ್ಷತೆಯು MP3 ಗಿಂತ ಉತ್ತಮವಾಗಿದೆ, Spotify ಆರಂಭಿಕ ಹಂತದಲ್ಲಿ ಬಳಸಿತು, ಆಟಗಳ ಧ್ವನಿ ಪರಿಣಾಮಗಳಲ್ಲಿ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_opus"
msgstr "Opus ಆಡಿಯೋ (2012 ರಲ್ಲಿ IETF ಮಾನಕೀಕರಿಸಿತು, ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತ ಆಡಿಯೋ ಸ್ವರೂಪ. SILK ಮತ್ತು CELT ತಂತ್ರಜ್ಞಾನಗಳನ್ನು ಸಂಯೋಜಿಸುತ್ತದೆ, ತುಂಬಾ ಕಡಿಮೆ ಸುಪ್ತತೆ, ಅತ್ಯಧಿಕ ಸಂಕುಚನ ದಕ್ಷತೆ, WebRTC, WhatsApp, ಡಿಸ್ಕಾರ್ಡ್ನ ಡೀಫಾಲ್ಟ್ ಆಡಿಯೋ ಸ್ವರೂಪ)"

msgid "mime_wav"
msgstr "WAV ಆಡಿಯೋ (1991 ರಲ್ಲಿ Microsoft ಮತ್ತು IBM ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು, ವಿಂಡೋಸ್ನ ಸ್ಥಳೀಯ ಆಡಿಯೋ ಸ್ವರೂಪ. ಸಂಕುಚನವಿಲ್ಲದ PCM ಎನ್ಕೋಡಿಂಗ್, ಗುಣಮಟ್ಟವು ನಷ್ಟರಹಿತವಾಗಿದೆ ಆದರೆ ಫೈಲ್ ತುಂಬಾ ದೊಡ್ಡದಾಗಿದೆ, ವೃತ್ತಿಪರ ಆಡಿಯೋ ಸಂಪಾದನೆಯ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ)"

msgid "mime_wma"
msgstr "WMA ಆಡಿಯೋ (1999 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ವಿಂಡೋಸ್ ಮೀಡಿಯಾ ಆಡಿಯೋ. ನಷ್ಟ/ನಷ್ಟರಹಿತ ಎರಡೂ ಆವೃತ್ತಿಗಳು, ವಿಂಡೋಸ್ನ ಸ್ಥಳೀಯ ಬೆಂಬಲ, ವಿಂಡೋಸ್ ಮೀಡಿಯಾ ಪ್ಲೇಯರ್ನೊಂದಿಗೆ ಹರಡಿತು. ಈಗ ಅಂಚಿಗೆ ಸರಿಯಿತು, MP3/AAC ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_dsf"
msgstr "DSF ಆಡಿಯೋ (ಡೈರೆಕ್ಟ್ ಸ್ಟ್ರೀಮ್ ಡಿಜಿಟಲ್ ಸ್ವರೂಪ, ಸೋನಿ ಮತ್ತು ಫಿಲಿಪ್ಸ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿದರು. 1bit ಹೆಚ್ಚಿನ ಮಾದರಿ ದರ, DSD ಆಡಿಯೋದ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, SACD ಯ ಡಿಜಿಟಲ್ ಆವೃತ್ತಿ, ಆಡಿಯೋಫೈಲ್ಗಳ ಹೆಚ್ಚಿನ ದರ್ಜೆಯ ಸ್ವರೂಪ, ಫೈಲ್ ಅಗಾಧವಾಗಿದೆ)"

msgid "mime_ape"
msgstr "APE ಆಡಿಯೋ (2000 ರಲ್ಲಿ Monkey's Audio ಅಭಿವೃದ್ಧಿಪಡಿಸಿದೆ, ನಷ್ಟರಹಿತ ಸಂಕುಚನ ಸ್ವರೂಪ. FLAC ಗಿಂತ ಹೆಚ್ಚಿನ ಸಂಕುಚನ ಆದರೆ ನಿಧಾನ ಎನ್ಕೋಡಿಂಗ್, ಇನ್ನೂ Windows ಪ್ಲಾಟ್ಫಾರ್ಮ್ ಮತ್ತು ಆಡಿಯೋ ಉತ್ಸಾಹಿಗಳಲ್ಲಿ ಬಳಕೆಯಲ್ಲಿದೆ)"

msgid "mime_mid"
msgstr "MIDI ಆಡಿಯೋ (1983 ರಲ್ಲಿ MIDI ಅಸೋಸಿಯೇಷನ್ ನಿಗದಿಪಡಿಸಿತು, ಮ್ಯೂಸಿಕಲ್ ಇನ್ಸ್ಟ್ರುಮೆಂಟ್ ಡಿಜಿಟಲ್ ಇಂಟರ್ಫೇಸ್. ನೋಟ್ ಸ್ವರೂಪ, ಆಡಿಯೋ ರೆಕಾರ್ಡಿಂಗ್ ಅಲ್ಲ, ಫೈಲ್ ತುಂಬಾ ಚಿಕ್ಕದಾಗಿದೆ, ಎಲೆಕ್ಟ್ರಾನಿಕ್ ಸಾಧನಗಳು, ಮೊಬೈಲ್ ಫೋನ್ ರಿಂಗ್ಟೋನ್ಗಳು, ಆಟದ ಧ್ವನಿ ಪರಿಣಾಮಗಳ ಮಾನಕ. 1991 ರಲ್ಲಿ ಜನರಲ್ MIDI ಮಾನಕೀಕರಿಸಲಾಯಿತು, 128 ವಾದ್ಯಗಳ ಟಿಂಬ್ರೆ ಅನ್ನು ವ್ಯಾಖ್ಯಾನಿಸಿತು)"

msgid "mime_m4a"
msgstr "M4A ಆಡಿಯೋ (MPEG-4 ಆಡಿಯೋ, AAC ಯ ಕಂಟೇನರ್ ಸ್ವರೂಪ. iTunes ಮ್ಯೂಸಿಕ್ ಸ್ಟೋರ್ನ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, Apple ಪರಿಸರ ವ್ಯವಸ್ಥೆಯ ಪ್ರಮುಖ ಆಡಿಯೋ ಸ್ವರೂಪ, DRM ರಕ್ಷಣೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ)"

msgid "mime_m3u"
msgstr "M3U ಪ್ಲೇಲಿಸ್ಟ್ (MP3 URL ಪ್ಲೇಲಿಸ್ಟ್ ಸ್ವರೂಪ, ಸರಳ ಪಠ್ಯ ಫೈಲ್, ಆಡಿಯೋ ಫೈಲ್ ಮಾರ್ಗಗಳನ್ನು ದಾಖಲಿಸುತ್ತದೆ. ವಿನಾಂಪ್ ಯುಗದ ಮಾನಕ, ಇಂಟರ್ನೆಟ್ ರೇಡಿಯೋ, ಆನ್ಲೈನ್ ಸಂಗೀತ ಸ್ಟ್ರೀಮಿಂಗ್ಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ. M3U8 ಅದರ UTF-8 ಆವೃತ್ತಿಯಾಗಿದೆ, HTTP ಲೈವ್ ಸ್ಟ್ರೀಮಿಂಗ್ಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_asf"
msgstr "ASF ಸ್ಟ್ರೀಮಿಂಗ್ ಸ್ವರೂಪ (1996 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಅಡ್ವಾನ್ಸ್ಡ್ ಸಿಸ್ಟಮ್ಸ್ ಫಾರ್ಮ್ಯಾಟ್. ವಿಂಡೋಸ್ ಮೀಡಿಯಾದ ಸ್ಟ್ರೀಮಿಂಗ್ ಕಂಟೇನರ್, ಆಡಿಯೋ ಮತ್ತು ವಿಡಿಯೋ ಸಿಂಕ್ರೊನಸ್ ಪ್ರಸರಣವನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. ಇಂಟರ್ನೆಟ್ ಪ್ರಸಾರಗಳು ಮತ್ತು ಸ್ಟ್ರೀಮಿಂಗ್ಗಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, WMA/WMV ಎರಡೂ ASF ಕಂಟೇನರ್ ಅನ್ನು ಆಧರಿಸಿವೆ)"

msgid "mime_avi"
msgstr "AVI ವಿಡಿಯೋ (1992 ರಲ್ಲಿ Microsoft ಬಿಡುಗಡೆ ಮಾಡಿತು, ವಿಂಡೋಸ್ನ ಆರಂಭಿಕ ವಿಡಿಯೋ ಮಾನಕ. 'ಆಡಿಯೋ ವಿಡಿಯೋ ಇಂಟರ್ಲೀವ್', ಆಡಿಯೋ ಮತ್ತು ವಿಡಿಯೋವನ್ನು ಪರ್ಯಾಯವಾಗಿ ಸಂಗ್ರಹಿಸುತ್ತದೆ, 1990-2000 ರ ದಶಕದಲ್ಲಿ ಅತ್ಯಂತ ಜನಪ್ರಿಯ ವಿಡಿಯೋ ಸ್ವರೂಪ, ಈಗ MP4/MKV ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_divx"
msgstr "DivX ವಿಡಿಯೋ (1998 ರಲ್ಲಿ DivX ಕಂಪನಿ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, MPEG-4 ಆಧರಿಸಿದ ವಿಡಿಯೋ ಎನ್ಕೋಡಿಂಗ್ ಸ್ವರೂಪ. 2000 ರ ದಶಕದಲ್ಲಿ ಇಂಟರ್ನೆಟ್ ವಿಡಿಯೋ ಹಂಚಿಕೆಯ ಪ್ರಮುಖ ಸ್ವರೂಪ, DVD ಗುಣಮಟ್ಟವನ್ನು CD ಗಾತ್ರಕ್ಕೆ ಸಂಕುಚಿಸಿದ ಮೊದಲ ತಂತ್ರಜ್ಞಾನ. ಹಕ್ಕುಸ್ವಾಮ್ಯ ವಿವಾದಗಳಿಂದಾಗಿ, ನಂತರ ವಾಣಿಜ್ಯ ಎನ್ಕೋಡಿಂಗ್ಗೆ ಬದಲಾಯಿತು)"

msgid "mime_mp4"
msgstr "MP4 ವಿಡಿಯೋ (2001 ರಲ್ಲಿ MPEG ಮಾನಕ, MPEG-4 ಭಾಗ 14. ವಿಶ್ವದ ಅತ್ಯಂತ ಸಾಮಾನ್ಯ ವಿಡಿಯೋ ಸ್ವರೂಪ, H.264/H.265 ಎನ್ಕೋಡಿಂಗ್ ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಇಂಟರ್ನೆಟ್ ವಿಡಿಯೋಗಳು, ಮೊಬೈಲ್ ಫೋನ್ ರೆಕಾರ್ಡಿಂಗ್ಗಳು, YouTube ನ ಡೀಫಾಲ್ಟ್ ಸ್ವರೂಪ)"

msgid "mime_m4v"
msgstr "M4V ವಿಡಿಯೋ (iTunes ವಿಡಿಯೋ ಸ್ವರೂಪ, MP4 ನ ಮಾರ್ಪಾಡು. Apple ಪರಿಸರ ವ್ಯವಸ್ಥೆಯ ವಿಡಿಯೋ ಸ್ವರೂಪ, iTunes Store ಚಲನಚಿತ್ರಗಳು, ದೂರದರ್ಶನ ಕಾರ್ಯಕ್ರಮಗಳ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, DRM ಹಕ್ಕುಸ್ವಾಮ್ಯ ರಕ್ಷಣೆಯನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ)"

msgid "mime_mpeg"
msgstr "MPEG ವಿಡಿಯೋ (1988 ರಲ್ಲಿ MPEG ಸಂಸ್ಥೆ ನಿಗದಿಪಡಿಸಿತು, ಮೂವಿಂಗ್ ಪಿಕ್ಚರ್ ಎಕ್ಸ್ಪರ್ಟ್ಸ್ ಗ್ರೂಪ್. ಡಿಜಿಟಲ್ ವಿಡಿಯೋ ಸಂಕುಚನ ಮಾನಕದ ಸ್ಥಾಪಕ, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (ಇಂಟರ್ನೆಟ್ ವಿಡಿಯೋ) ಪ್ರಮುಖ ಪ್ರಭಾವ ಬೀರಿತು)"

msgid "mime_mkv"
msgstr "MKV ವಿಡಿಯೋ (2002 ರಲ್ಲಿ Matroska ಯೋಜನೆ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಓಪನ್ ಸೋರ್ಸ್ ಮಲ್ಟಿಮೀಡಿಯಾ ಕಂಟೇನರ್ ಸ್ವರೂಪ. ಬಹು ಆಡಿಯೋ ಟ್ರ್ಯಾಕ್ಗಳು, ಬಹು ಉಪಶೀರ್ಷಿಕೆಗಳು, ಅಧ್ಯಾಯಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, 'ಪ್ಯಾಕೇಜಿಂಗ್ ನ ಮಾಂತ್ರಿಕ', ಹೆಚ್ಚಿನ ರೆಸಲ್ಯೂಶನ್ ಚಲನಚಿತ್ರಗಳ ಹಂಚಿಕೆಯ ಆದ್ಯತೆಯ ಸ್ವರೂಪ)"

msgid "mime_mpg"
msgstr "MPEG ವಿಡಿಯೋ (MPEG-1/MPEG-2 ವಿಡಿಯೋ ವಿಸ್ತರಣೆ, VCD ಮತ್ತು DVD ಯ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ. 1990-2000 ರ ದಶಕದಲ್ಲಿ ಆಪ್ಟಿಕಲ್ ಡಿಸ್ಕ್ ವಿಡಿಯೋದ ಪ್ರಮುಖ ಸ್ವರೂಪ, ಈಗ H.264/H.265 ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_ogv"
msgstr "Ogg Video ವಿಡಿಯೋ (Xiph.Org ಫೌಂಡೇಶನ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, Ogg ಕಂಟೇನರ್ನ ವಿಡಿಯೋ ಸ್ವರೂಪ, Theora ಎನ್ಕೋಡಿಂಗ್ ಅನ್ನು ಬಳಸುತ್ತದೆ. ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತವಾಗಿದೆ, HTML5 ವಿಡಿಯೋದ ಆರಂಭಿಕ ಮಾನಕ, Firefox ನ ಸ್ಥಳೀಯ ಬೆಂಬಲ)"

msgid "mime_ogx"
msgstr "Ogg ಮಲ್ಟಿಮೀಡಿಯಾ ಕಂಟೇನರ್ (Xiph.Org ಫೌಂಡೇಶನ್ ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, Ogg ಕಂಟೇನರ್ನ ಸಾರ್ವತ್ರಿಕ ವಿಸ್ತರಣೆ, ಆಡಿಯೋ, ವಿಡಿಯೋ, ಉಪಶೀರ್ಷಿಕೆಗಳ ಬಹು ಟ್ರ್ಯಾಕ್ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ಓಪನ್ ಸೋರ್ಸ್ ಮಲ್ಟಿಮೀಡಿಯಾ ಮಾನಕ, ಆಟಗಳು, ಸ್ಟ್ರೀಮಿಂಗ್ನಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ)"

msgid "mime_rm"
msgstr "RealMedia ವಿಡಿಯೋ (1995 ರಲ್ಲಿ RealNetworks ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, RealMedia ಸ್ವರೂಪ. 1990-2000 ರ ದಶಕದಲ್ಲಿ ಇಂಟರ್ನೆಟ್ ಸ್ಟ್ರೀಮಿಂಗ್ನ ಪ್ರವರ್ತಕ, RealPlayer ನ ಪ್ರಮುಖ ಸ್ವರೂಪ. ನ್ಯೂನತೆಗಳು: ವಿಶೇಷ ಪ್ಲೇಯರ್ ಅಗತ್ಯವಿತ್ತು, ಸಂಕುಚನ ಗುಣಮಟ್ಟ ಕಡಿಮೆ, ನಂತರ Flash/MP4 ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿತು)"

msgid "mime_flv"
msgstr "Flash ವಿಡಿಯೋ (2002 ರಲ್ಲಿ ಸ್ವರೂಪ ಕಾಣಿಸಿಕೊಂಡಿತು, ಫ್ಲ್ಯಾಶ್ ವಿಡಿಯೋ ಸ್ವರೂಪ. ಒಮ್ಮೆ ಇಂಟರ್ನೆಟ್ ವಿಡಿಯೋದ ಪ್ರಮುಖ ಸ್ವರೂಪ, YouTube ಆರಂಭಿಕ ಹಂತದಲ್ಲಿ ಬಳಸಿತು. ನ್ಯೂನತೆಗಳು: ಫ್ಲ್ಯಾಶ್ ಪ್ಲಗಿನ್ ಅಗತ್ಯವಿತ್ತು, ಕಾರ್ಯಕ್ಷಮತೆ ಕಳಪೆಯಾಗಿತ್ತು, ಭದ್ರತಾ ದೋಷಗಳಿದ್ದವು. 2015 ರಿಂದ ಪ್ರಮುಖ ವೆಬ್ಸೈಟ್ಗಳು HTML5 ವಿಡಿಯೋಗೆ ಬದಲಾಯಿತು, ಈಗ ಹಳೆಯದಾಗಿದೆ)"

msgid "mime_f4v"
msgstr "F4V ವಿಡಿಯೋ (Adobe ಅಭಿವೃದ್ಧಿಪಡಿಸಿದ ಫ್ಲ್ಯಾಶ್ ವಿಡಿಯೋ ಸ್ವರೂಪ, FLV ಯ ಉತ್ತರಾಧಿಕಾರಿ. MPEG-4 ಮಾನಕವನ್ನು ಆಧರಿಸಿದೆ, H.264 ಎನ್ಕೋಡಿಂಗ್ ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. ಫ್ಲ್ಯಾಶ್ ತಂತ್ರಜ್ಞಾನದೊಂದಿಗೆ ಹಳೆಯದಾಯಿತು, Adobe 2020 ರಲ್ಲಿ ಬೆಂಬಲವನ್ನು ನಿಲ್ಲಿಸಿತು)"

msgid "mime_wmv"
msgstr "WMV ವಿಡಿಯೋ (1999 ರಲ್ಲಿ Microsoft ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ವಿಂಡೋಸ್ ಮೀಡಿಯಾ ವಿಡಿಯೋ. ವಿಂಡೋಸ್ನ ಸ್ಥಳೀಯ ಬೆಂಬಲ, ಸ್ಟ್ರೀಮಿಂಗ್ಗೆ ಆಪ್ಟಿಮೈಸ್ ಮಾಡಲಾಗಿದೆ, ಆರಂಭಿಕ ಆನ್ಲೈನ್ ವಿಡಿಯೋಗಳಲ್ಲಿ ಸಾಮಾನ್ಯ ಸ್ವರೂಪವಾಗಿತ್ತು, ಈಗ ಅಂಚಿಗೆ ಸರಿಯಿತು)"

msgid "mime_wmf"
msgstr "WMF ಮೀಡಿಯಾ ಸ್ವರೂಪ (ವಿಂಡೋಸ್ ಮೀಡಿಯಾ ಫಾರ್ಮ್ಯಾಟ್, Microsoft ನ ಮೀಡಿಯಾ ಚೌಕಟ್ಟು. WMV ವಿಡಿಯೋ, WMA ಆಡಿಯೋವನ್ನು ಒಳಗೊಂಡಿದೆ, ವಿಂಡೋಸ್ ಮೀಡಿಯಾ ಪ್ಲೇಯರ್ನ ಸ್ಥಳೀಯ ಬೆಂಬಲ)"

msgid "mime_mov"
msgstr "MOV ವಿಡಿಯೋ (1991 ರಲ್ಲಿ Apple ಅಭಿವೃದ್ಧಿಪಡಿಸಿತು, ಕ್ವಿಕ್ಟೈಮ್ ಕಂಟೇನರ್ ಸ್ವರೂಪ. ವೃತ್ತಿಪರ ವಿಡಿಯೋ ಸಂಪಾದನೆಯ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, ಬಹು ಕೊಡೆಕ್ಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ, ಫೈನಲ್ ಕಟ್ ಪ್ರೊ, ಪ್ರೀಮಿಯರ್ನ ಸ್ಥಳೀಯ ಬೆಂಬಲ)"

msgid "mime_qt"
msgstr "ಕ್ವಿಕ್ಟೈಮ್ ವಿಡಿಯೋ (1991 ರಲ್ಲಿ Apple ಬಿಡುಗಡೆ ಮಾಡಿತು, ಕ್ವಿಕ್ಟೈಮ್ ಸ್ವರೂಪ. ಮ್ಯಾಕ್ ಪ್ಲಾಟ್ಫಾರ್ಮ್ನ ವಿಡಿಯೋ ಮಾನಕ, MOV ಅದರ ಕಂಟೇನರ್, ಕ್ವಿಕ್ಟೈಮ್ ಪ್ಲೇಯರ್ ವ್ಯಾಪಕವಾಗಿ ಬಳಸಲ್ಪಡುತ್ತಿತ್ತು. 2016 ರಲ್ಲಿ Apple ವಿಂಡೋಸ್ ಆವೃತ್ತಿಯ ಅಭಿವೃದ್ಧಿಯನ್ನು ನಿಲ್ಲಿಸಿತು, ಕ್ರಮೇಣ MP4 ನಿಂದ ಬದಲಾಯಿಸಲ್ಪಟ್ಟಿದೆ)"

msgid "mime_webm"
msgstr "WebM ವಿಡಿಯೋ (2010 ರಲ್ಲಿ Google ಬಿಡುಗಡೆ ಮಾಡಿತು, ಓಪನ್ ಸೋರ್ಸ್ ಮತ್ತು ಪೇಟೆಂಟ್ ಮುಕ್ತ ವಿಡಿಯೋ ಸ್ವರೂಪ. Matroska ಕಂಟೇನರ್ ಅನ್ನು ಆಧರಿಸಿದೆ, VP8/VP9 ಎನ್ಕೋಡಿಂಗ್, HTML5 ವಿಡಿಯೋದ ಪ್ರಮಾಣಿತ ಸ್ವರೂಪ, YouTube ನ ಡೀಫಾಲ್ಟ್ ವೆಬ್ ಪ್ಲೇಯರ್ ಸ್ವರೂಪ)"

msgid "mime_3gp"
msgstr "3GP ವಿಡಿಯೋ (2000 ರಲ್ಲಿ 3GPP ನಿಗದಿಪಡಿಸಿತು, ಮೊಬೈಲ್ ಸಾಧನಗಳ ವಿಡಿಯೋ ಸ್ವರೂಪ. ಫೈಲ್ ತುಂಬಾ ಚಿಕ್ಕದಾಗಿದೆ, ಗುಣಮಟ್ಟ ಕಡಿಮೆಯಾಗಿದೆ, ಆರಂಭಿಕ ಫೀಚರ್ ಫೋನ್ಗಳ ವಿಡಿಯೋ ರೆಕಾರ್ಡಿಂಗ್ ಸ್ವರೂಪ, MMS ಸಂದೇಶಗಳನ್ನು ಕಳುಹಿಸಲು ಬಳಸಲಾಗುತ್ತಿತ್ತು)"

