# Opisi formatov datotek
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Besedilna datoteka (ASCII standardizacija leta 1963, neoblikovano golo besedilo. Osnova za vso izvorno kodo, konfiguracije, dnevnike. Unix uporablja LF, Windows CRLF za prelom vrstic, še vedno najbolj univerzalni format podatkov na računalnikih)"

msgid "mime_log"
msgstr "Dnevniška datoteka (besedilna datoteka, ki beleži informacije o delovanju sistema in aplikacij, pogosto se uporablja za odpravljanje napak, analizo zmogljivosti in varnostne revizije. Standardni formati vključujejo Apache combined log, Nginx access log, syslog itd.)"

msgid "mime_page"
msgstr "HTML spletna stran (Tim Berners-Lee je izumil World Wide Web leta 1989, definiral tri glavne tehnologije HTML/HTTP/URL leta 1990, jih brezplačno ponudil brez patentiranja. HTML5 je postal uradni W3C standard leta 2014, podpira prikaz, večpredstavnost in tiskanje. Prejemnik Turingove nagrade 2016)"

msgid "mime_khtml"
msgstr "KHTML spletni pogon (KDE 2.0 izdan leta 1998, Konqueror brskalnikov pogon za prikaz. Apple je leta 2001 na podlagi KHTML ustvaril WebKit, Google pa je leta 2008 iz WebKita naredil Blink, ki postaja jedro brskalnikov, kot so Chrome, Edge, Safari. KHTML je primer, kako je open source skupnost postavila temelje sodobnim brskalniškim pogonom, njegova tehnološka dediščina se nadaljuje prek WebKit/Blink do danes)"

msgid "mime_script"
msgstr "Dinamični skriptni jezik (interpretirani jezik, brez potrebe po prevajanju. Vključuje ASP, JSP, CGI, ColdFusion, Tcl, VBScript itd., široko uporabljan v zgodnjem spletnem razvoju, administraciji sistema, avtomatizaciji nalog. Sodobni skriptni jeziki, kot so Python, Ruby, JavaScript, so se razvili v glavna orodja za celoten razvoj)"

msgid "mime_js"
msgstr "JavaScript skripta (Brendan Eich ga je ustvaril v 10 dneh v Netscapu leta 1995, izvorni programski jezik brskalnikov. ECMAScript je bil standardiziran leta 1997, Node.js je bil rojen leta 2009, zaradi česar je večplatformski jezik, npm je največji upravitelj paketov na svetu. Že leta najbolj priljubljen programski jezik na GitHubu)"

msgid "mime_py"
msgstr "Python skripta (Guido van Rossum ga je ustvaril leta 1991, znan po obveznem zamikanju in preprosti sintaksi. Široko se uporablja v spletnem razvoju, znanosti o podatkih, umetni inteligenci, avtomatizaciji administracije. Večkratni dobitnik TIOBE nagrade za programski jezik leta)"

msgid "mime_sh"
msgstr "Shell skripta (Unix se je rodil leta 1971, jezik ukazne vrstice. Uporablja se za administracijo sistema, avtomatizacijo nalog, zagon storitev, namestitvene skripte. Nujna veščina za Linux administracijo)"

msgid "mime_rb"
msgstr "Ruby skripta (Yukihiro Matsumoto ga je ustvaril leta 1995, osredotočen na zadovoljstvo razvijalcev. Ruby on Rails ogrodje je pionir paradigme konvencije nad konfiguracijo, ki vpliva na zasnovo sodobnih spletnih ogrodij)"

msgid "mime_pl"
msgstr "Perl skripta (Larry Wall ga je ustvaril leta 1987, znan po pragmatičnosti, pogosto imenovan 'švicarski nož'. CPAN je predhodnik sodobnih upraviteljev paketov programskih jezikov, z globokim vplivom na področju obdelave besedila, administracije sistema in CGI-ja)"

msgid "mime_php"
msgstr "PHP dinamična spletna stran (Rasmus Lerdorf ga je ustvaril leta 1995, posebej zasnovan za spletni razvoj. Več kot 70% spletnih strani na svetu ga uporablja, poganja platforme, kot so WordPress, Facebook, Wikipedia. PHP 8 uvaja JIT prevajanje, znatno izboljšuje zmogljivost)"

msgid "mime_image"
msgstr "Slikovna datoteka"

msgid "mime_document"
msgstr "Dokumentna datoteka"

msgid "mime_package"
msgstr "Programski paket"

msgid "mime_archive"
msgstr "Gzip stisnjena datoteka (GNU projekt 1992, na podlagi DEFLATE algoritma. Uporablja se v Web-u za dinamično stiskanje odgovorov, stopnja stiskanja je običajno 60-90%. Po letu 2015 ga je Brotli zamenjal v nekaterih scenarijih, vendar je še vedno najbolj široko podprt format stiskanja na strani strežnika)"

msgid "mime_audio"
msgstr "Avdio datoteka"

msgid "mime_video"
msgstr "Video datoteka"

msgid "mime_jscript"
msgstr "JavaScript (razvil Brendan Eich leta 1995)"

msgid "mime_json"
msgstr "JSON podatki (predlagal Douglas Crockford leta 2001, lahek format za izmenjavo podatkov, dejanski standard za spletne API-je)"

msgid "mime_vbs"
msgstr "VBScript (razvil Microsoft leta 1996, skriptni jezik za Windows, uporabljen za ASP spletne strani in Windows administratorske skripte. S porastom PowerShell in JavaScript priljubljenosti se postopoma opušča)"

msgid "mime_conf"
msgstr "Konfiguracijska datoteka (shranjuje konfiguracije programske opreme v besedilni obliki, pogosti formati: INI, JSON, YAML, TOML, XML. Konfiguracije Linux sistema so večinoma v /etc imeniku)"

msgid "mime_css"
msgstr "CSS slogovni list (Prvi uradni standard CSS1 s strani W3C je bil objavljen decembra 1996, CSS2 je dodal pozicioniranje in medijske tipe leta 1998, od leta 2011 je CSS3 modularno uveden z zaobljenimi vogali, animacijami, prožnimi škatlami, mrežno postavitvijo in odzivnim oblikovanjem. Skupaj s HTML in JavaScript tvori tri glavne osnovne tehnologije frontenda, vsi sodobni brskalniki (Chrome, Firefox, Safari, Edge) ga izvorno podpirajo, edini je standard za definiranje spletnih slogov)"

msgid "mime_xsl"
msgstr "XSL slogovni list (W3C standard 1999, jezik za transformacijo XML dokumentov, lahko pretvori XML v HTML/PDF/besedilo. Po popularizaciji JSON-a se je uporaba zmanjšala)"

msgid "mime_runtime"
msgstr "Izvedljiva datoteka (izvedljivi formati operacijskega sistema, kot so EXE, ELF, Mach-O, vsebuje strojno kodo in informacije za nalaganje)"

msgid "mime_library"
msgstr "Knjižnična datoteka (DLL, SO, dylib itd. dinamično povezane knjižnice, deljena koda, ki se naloži ob zagonu programa)"

msgid "mime_swf"
msgstr "Flash animacija (razvil Macromedia leta 1996, pozneje v lasti Adobe. Standard za interaktivne spletne animacije, nekoč prevladoval na internetu z animacijami in igrami. Pomanjkljivosti: odvisnost od vtičnika, nepodprtost na mobilnih napravah, visoko tveganje za varnost. Adobe je leta 2017 napovedal umik, popolna podpora je bila ukinjena leta 2020, zamenjan s HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD definicija vrste dokumenta (XML specifikacija, definira strukturo XML dokumenta, uporablja se za preverjanje pravilnosti XML)"

msgid "mime_csv"
msgstr "CSV podatkovni format (vrednosti, ločene z vejicami, univerzalni format za tabelarne podatke, standard za uvoz/izvoz v Excel in podatkovne baze)"

msgid "mime_jnlp"
msgstr "Java Web Start (zagonski program Java aplikacij, tehnologija distribucije Java namiznih aplikacij v 2000-ih, danes umaknjena)"

msgid "mime_lit"
msgstr "Microsoft Reader e-knjiga (Microsoft jo je predstavil leta 2000, LIT format, umaknjen)"

msgid "mime_svg"
msgstr "SVG vektorska grafika (W3C standard 1999, Microsoft je dolgo promoviral svoj lastni VML format, IE brskalnik ga je podpiral šele od leta 2011, kar je povzročilo zamudo pri popularizaciji. Po letu 2015, z umikom IE in popularizacijo zaslonov visoke ločljivosti, je postal prva izbira za ikone in logotipe)"

msgid "mime_ai"
msgstr "Adobe Illustrator vektorska grafika (predstavljen leta 1987, industrijski standardni vektorski grafični format, prva izbira za tiskanje oblikovanja, logotipov, ikon)"

msgid "mime_phshop"
msgstr "Photoshop slika (Adobe je predstavil leta 1990, PSD format izvorne Photoshop datoteke, industrijski standard za obdelavo slik)"

msgid "mime_ttf"
msgstr "TrueType pisava (skupni razvoj Apple in Microsoft leta 1989, vektorski format pisave, dosleden prikaz na zaslonu in v tisku, privzeti format pisave v sodobnih operacijskih sistemih)"

msgid "mime_fon"
msgstr "WOFF2 spletna pisava (W3C priporočilo 2014, uporablja Brotli algoritem stiskanja, velikost se je zmanjšala za približno 30% v primerjavi s starejšim WOFF, za več kot 50% v primerjavi s TTF/OTF. Trenutno ga podpirajo vsi sodobni brskalniki, najboljša izbira za spletne pisave danes, podpira ga več kot 98% brskalnikov)"

msgid "mime_pdf"
msgstr "PDF dokument (Adobe razvit leta 1993, postal ISO mednarodni standard leta 2008. Medplatformski format dokumenta, ohranja doslednost formata, globalni standard za distribucijo elektronskih dokumentov)"

msgid "mime_dotnet"
msgstr "ASP.NET dinamična stran (Microsoft predstavil leta 2002, tehnologija dinamičnih spletnih strani za platformo Windows, del .NET Framework-a)"

msgid "mime_mdb"
msgstr "Access podatkovna baza (Microsoft Access datoteka podatkovne baze, predstavljena leta 1992, rešitev za namizno podatkovno bazo na Windows-u)"

msgid "mime_md"
msgstr "Markdown dokument (Ustvaril John Gruber leta 2004, na oblikovanje sintakse so vplivali reStructuredText in Setext. Osnovna oblikovalska filozofija je 'berljivost enaka prikazu', prvotna implementacija Markdown.pl uporablja Perl regularne izraze. Izpeljane specifikacije vključujejo GFM (2013), CommonMark (2017), Pandoc Markdown itd. Poganja ekosisteme GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, postal je dejanski standardni format za generatorje statičnih spletnih strani in programersko dokumentacijo)"

msgid "mime_crystal"
msgstr "Crystal Reports format poročila (SAP poslovna poročila, standardni format za poročila v podjetjih)"

msgid "mime_libreoffice"
msgstr "LibreOffice dokument (Razvila The Document Foundation leta 2010, odcep OpenOffice, implementacija ODF standarda, glavni open source pisarniški paket)"

msgid "mime_encrypt"
msgstr "Šifrirana datoteka (potrebno je dešifriranje za ogled, pogoste končnice: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS sled podatki (GPS Exchange Format, beleži informacije o geografski lokaciji, univerzalni format za športne ure in navigacijske naprave)"

msgid "mime_diskimage"
msgstr "Disk slika (DMG, ISO, IMG itd., datoteke za branje diskov/CD-jev, uporabljajo se za distribucijo programske opreme ali varnostno kopijo medijev za shranjevanje)"

msgid "mime_vm"
msgstr "Slika navideznega stroja (VMDK, VDI, VHDX, OVA itd., datoteke navideznega diska, formati za platforme virtualizacije, kot so VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent torrent datoteka (Bram Cohen je izumil leta 2001, P2P indeksna datoteka za prenos, vsebuje metapodatke datoteke in informacije o Trackerju)"

msgid "mime_gis"
msgstr "GIS geografski informacijski sistem podatkov (formati geoprostorskih podatkov, kot so Shapefile, GeoJSON, uporabljajo se za zemljevide in prostorsko analizo)"

msgid "mime_ebook"
msgstr "E-knjiga (formati e-knjig, kot so EPUB, MOBI, AZW. EPUB je mednarodni standard, MOBI/AZW so formati za Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF slika (Alliance for Open Media ga je predstavila leta 2019, na podlagi AV1 kodeka, stopnja stiskanja je 50% večja od WebP, novi standard spletnih slik)"

msgid "mime_markdown"
msgstr "Markdown dokument (John Gruber ga je oblikoval leta 2004, lahek jezik za označevanje, univerzalni format za GitHub README, tehnično dokumentacijo, forume)"

msgid "mime_yaml"
msgstr "YAML konfiguracija (Clark Evans ga je oblikoval leta 2001, človeku berljiv format za serializacijo podatkov, standardni format konfiguracijske datoteke za Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML konfiguracija (Tom Preston-Werner ga je oblikoval leta 2013, 'Tom's Obvious Minimal Language', format konfiguracijske datoteke za sodobna orodja, kot so Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Datoteka komponente Vue (predstavil Evan You leta 2014, progresivni JavaScript okvir. Prek enodatotečnih komponent (SFC) popolnoma združuje HTML, CSS in JS, kar močno poveča učinkovitost razvoja. Je eden najbolj priljubljenih frontend okvirov na svetu. Prav tako se kot jedro sodobnih generatorjev statičnih spletnih mest, kot je VitePress, pogosto uporablja za poganjanje interaktivne tehnične dokumentacije in blogov.)"

msgid "mime_wasm"
msgstr "WebAssembly modul (W3C standard 2017, format za visoke zmogljivosti v brskalniku, C/C++/Rust/R se lahko prevedejo vanj, zmogljivosti blizu izvorni kodi)"

msgid "mime_jsx"
msgstr "React JSX komponenta (Facebook je predstavil JavaScript XML leta 2013, sintaksa komponente React okvira, inovativna paradigma pisanja HTML znotraj JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX komponenta (Microsoft ga je razvil leta 2012, TypeScript + JSX, standardni način za razvoj React aplikacij z varnostjo tipov)"

msgid "mime_heif"
msgstr "HEIF slika (MPEG standard 2015, učinkoviti format slikovne datoteke, široko se uporablja v Apple ekosistemu)"

msgid "mime_heic"
msgstr "HEIC slika (Apple-ova implementacija HEIF, privzeti format fotografije na iPhone, izvorno podprt na iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D model (GL Transport Format, 'JPEG sveta 3D', objavil Khronos Group leta 2015, standardni format za spletni 3D)"

msgid "mime_glb"
msgstr "GLB binarni 3D model (binarna različica GLTF, ena datoteka vsebuje vse vire, uporablja se za distribucijo 3D prizorov)"

msgid "mime_gls"
msgstr "GLOSSARY slovar pojmov (datoteka definicije izrazov, uporablja se za upravljanje izrazov v dokumentacijskih sistemih)"

msgid "mime_cbz"
msgstr "CBZ strip knjiga (stisnjene strip slike v ZIP formatu, univerzalni format za zbiratelje stripov)"

msgid "mime_cbr"
msgstr "CBR strip knjiga (stisnjene strip slike v RAR formatu, univerzalni format za zbiratelje stripov)"

msgid "mime_fb2"
msgstr "FB2 e-knjiga (FictionBook 2.0, ruski format e-knjige, XML struktura, široko podprt s strani open source bralnikov)"

msgid "mime_kepub"
msgstr "KEPUB e-knjiga (Kobo posebni EPUB format, optimizirani format za Kobo bralnike e-knjig)"

msgid "mime_m4b"
msgstr "M4B zvočna knjiga (MPEG-4 zvočni format knjige, podpira zaznamke, format za iTunes zvočne knjige)"

msgid "mime_kfx"
msgstr "Kindle KFX format (Amazon ga je predstavil leta 2015, posebni format e-knjige za Kindle, podpira izboljšano oblikovanje in hitro listanje strani)"

msgid "mime_chm"
msgstr "CHM datoteka pomoči (Microsoft ga je predstavil leta 1997, prevedeni HTML format pomoči, standard za dokumentacijo pomoči v Windows programski opremi)"

msgid "mime_mht"
msgstr "MHT spletna arhiva (Microsoft ga je predstavil leta 1999, format spletne strani v eni datoteki, format za shranjevanje spletnih strani v IE brskalniku)"

msgid "mime_wml"
msgstr "WML (Wireless Markup Language, WAP standard 1999, uporabljen za spletne strani na starih mobilnih telefonih, ukinjen)"

msgid "mime_xhtml"
msgstr "XHTML spletna stran (W3C standard 2000, XML različica HTML-a, strožja sintaksa. W3C je ustavil vzdrževanje leta 2009, fokus se je preusmeril na HTML5)"

msgid "mime_xml"
msgstr "XML dokument (W3C standard 1998, razširljiv jezik za označevanje, osnovni format za spletne storitve, konfiguracijske datoteke, izmenjavo podatkov)"

msgid "mime_sgml"
msgstr "SGML dokument (ISO standard 1986, predhodnik HTML, standardni splošni jezik za označevanje, XML in HTML izvirata iz SGML)"

msgid "mime_apng"
msgstr "APNG animacija (Mozilla ga je razvila leta 2004, razširitev PNG za animacijo, sodobna zamenjava za GIF, podpira prave barve in prosojnost)"

msgid "mime_bmp"
msgstr "BMP bitna slika (Windows bitni format, izvorno podprt od Windows 1.0. Nestisnjen, velike velikosti datotek, vendar zaradi preproste strukture in brez potrebe po dodatnih kodekih, Windows 11 orodje za zajem zaslona, program za risanje, viri ikon v EXE/MSI namestitvenih paketih, datoteke kazalcev in nekateri stari gonilniki ga še vedno uporabljajo. Za enako kakovost slike je datoteka približno 3-10 krat večja od PNG, v večini scenarijev ga je zamenjal PNG/JPEG, vendar Windows ekosistem še vedno ohranja široko združljivost)"

msgid "mime_cdr"
msgstr "CDR vektorska grafika (posebni format za CorelDRAW, Corel Corporation iz Kanade, programska oprema za vektorsko grafično oblikovanje)"

msgid "mime_gif"
msgstr "GIF slika (CompuServe ga je razvil leta 1987, 256-barvni format za animacijo. Pomanjkljivosti: omejeno število barv, groba kakovost slike, ne podpira prosojnosti, velike datoteke, nizka hitrost sličic. Zamenjan je s sodobnimi animacijskimi formati, kot so APNG, WebP)"

msgid "mime_ico"
msgstr "ICO ikona (Windows format ikonske datoteke, podpira več ločljivosti, standardni format za favicon spletne strani)"

msgid "mime_jpeg"
msgstr "JPEG slika (ISO standard 1992, format za fotografije z izgubo kakovosti, dejanski standard za fotografije na internetu)"

msgid "mime_jpg"
msgstr "JPEG slika (ISO standard 1992, format za fotografije z izgubo kakovosti, dejanski standard za fotografije na internetu)"

msgid "mime_png"
msgstr "PNG slika (W3C priporočilo 1996, podpira prave barve in prosojnost, statična zamenjava za GIF, standard za brezizgubne slike na internetu)"

msgid "mime_ps"
msgstr "PostScript datoteka opisa strani (Adobe ga je predstavil leta 1985, jezik za opis strani, predhodnik PDF, uporablja se za tiskanje in založništvo)"

msgid "mime_psb"
msgstr "PSB velik dokument (Adobe Photoshop format za izjemno velike slike, podpira slike večje od 2GB ali 30000 slikovnih pik)"

msgid "mime_psd"
msgstr "PSD slika (Adobe Photoshop izvorna datoteka, podpira plasti, kanale, poti, industrijski standardni format za obdelavo slik)"

msgid "mime_webp"
msgstr "WebP slika (Google ga je razvil leta 2010, format spletne slike, podpira stiskanje z izgubo/brez izgube in animacijo, stopnja stiskanja 25-35% večja od PNG in 25% večja od JPEG)"

msgid "mime_woff"
msgstr "WOFF spletna pisava (ustvarjena leta 2009, W3C standard 2018. Na podlagi TrueType/OpenType stiskanja, optimizacija nalaganja spletnih pisav, standardni format za ikone pisav na sodobnih spletnih straneh)"

msgid "mime_7z"
msgstr "7z stisnjeni paket (Igor Pavlov ga je razvil leta 1999, posebni format 7-Zip programa. LZMA algoritem, visoka stopnja stiskanja, open source in brezplačen. 7z format je običajno 30-50% manjši od ZIP pri enaki stopnji stiskanja, običajen format v open source skupnosti in za distribucijo programske opreme)"

msgid "mime_ace"
msgstr "ACE stisnjeni paket (razvit v 1990-ih, format WinACE programa. Nekoč se je tekmoval z RAR, imel je razmeroma visoko stopnjo stiskanja. Razvoj je bil ustavljen leta 2007, danes ga je zamenjal 7z/RAR, redko se uporablja)"

msgid "mime_bz2"
msgstr "BZIP2 stisnjeni paket (Julian Seward ga je razvil leta 1996, algoritem stiskanja z razvrščanjem blokov. Stopnja stiskanja je 15-20% večja od GZIP, vendar je hitrost manjša. Običajen format za izvorno kodo Linux jedra, open source programske pakete, končnica .bz2)"

msgid "mime_cab"
msgstr "CAB stisnjeni paket (Microsoft ga je razvil leta 1995, Cabinet format. Format namestitvenega paketa za Windows, uporablja se za distribucijo gonilnikov in sistemskih datotek. Windows Installer (MSI) interno uporablja CAB za shranjevanje datotek)"

msgid "mime_dmg"
msgstr "DMG diskovna slika (Apple ga je predstavil v 1980-ih, Disk Image format. Standardni format za distribucijo programske opreme na macOS, s klikom se pripne kot navidezni disk, s povlečenjem se namesti aplikacija. Podpira stiskanje in šifriranje, glavni je format za prenos Mac programske opreme)"

msgid "mime_emz"
msgstr "EMZ stisnjena slika (Windows stisnjena Enhanced Metafile, stisnjena različica EMF. Format za shranjevanje vektorske grafike v Office dokumentih, v bistvu GZIP stisnjena EMF datoteka)"

msgid "mime_gz"
msgstr "GZIP stisnjeni paket (Jean-loup Gailly in Mark Adler sta ga razvila leta 1992, GNU projekt. Standardno orodje za stiskanje na Unix/Linux sistemih, običajni format za HTTP stiskanje pri prenosu. Končnica .gz, pogosto se uporablja v kombinaciji s TAR)"

msgid "mime_jar"
msgstr "JAR stisnjeni paket (Sun Microsystems ga je predstavil leta 1997, Java ARchive format. V bistvu ZIP stisnjeni paket, uporablja se za pakiranje Java razredov in aplikacij. Osnovni format v Java ekosistemu, kot so Maven, Gradle, Android prav tako uporablja JAR)"

msgid "mime_lzma"
msgstr "LZMA stisnjeni paket (Igor Pavlov ga je razvil leta 1998, Lempel-Ziv-Markov chain algoritem. Osnovni algoritem stiskanja 7z formata, visoka stopnja stiskanja, hitra dekompresija. Uporablja se za distribucijo vdelane programske opreme in programske opreme za vgrajene sisteme)"

msgid "mime_rar"
msgstr "RAR stisnjeni paket (Eugene Roshal ga je razvil leta 1993, Roshal ARchive format. Visoka stopnja stiskanja, podpira delitev na zvezke in obnovitev zapisov. Format WinRAR programa, stopnja stiskanja je boljša od ZIP, vendar je potrebna plačljiva programska oprema, open source orodja, kot je unrar, lahko dekompresirajo)"

msgid "mime_tar"
msgstr "TAR arhivski paket (Uveden v Unix V7 leta 1979, Tape ARchive format. Format tračne arhive, samo pakiranje brez stiskanja, pogosto se uporablja v kombinaciji z GZIP/BZIP2/XZ. Izvorna koda programskega paketa za Linux, večplastno shranjevanje Docker slik uporablja TAR format)"

msgid "mime_tgz"
msgstr "TGZ stisnjeni paket (kombinacija TAR + GZIP formata, končnica .tgz ali .tar.gz. Najbolj univerzalni format distribucije za Unix/Linux programske pakete, široko se uporablja za izvorno kodo in binarne pakete, predstavnik 'razpakiraj in uporabi' koncepta)"

msgid "mime_tbz2"
msgstr "TBZ2 stisnjeni paket (kombinacija TAR + BZIP2 formata, končnica .tbz2 ali .tar.bz2. Stopnja stiskanja je 15-20% večja od TGZ, primeren za distribucijo velikih datotek, izvorna koda Linux jedra je dolgo uporabljala ta format)"

msgid "mime_xz"
msgstr "XZ stisnjeni paket (predstavljen leta 2009, na podlagi LZMA2 algoritma. Izjemno visoka stopnja stiskanja, 30-50% večja od GZIP, hitrost dekompresije je relativno velika. Široko se uporablja v Linux jedru, upraviteljih paketov (kot je notranja struktura Debian .deb paketov), priporočeni je format v Linux ekosistemu danes)"

msgid "mime_z"
msgstr "Z stisnjeni paket (Unix compress ukazni format iz leta 1985, LZW algoritem. Zgodnji Unix format stiskanja, zamenjal ga je GZIP. Končnica .Z, redko se uporablja na sodobnih sistemih)"

msgid "mime_zip"
msgstr "ZIP stisnjeni paket (Phil Katz ga je razvil leta 1989, PKZIP format. Windows izvorno podpira, najbolj univerzalni format stiskanja na internetu. Podpira več datotek, strukturo imenikov, lahko izbira algoritem stiskanja. JAR v Javi, APK na Android, DOCX/XLSX za Office dokumente temeljijo na ZIP formatu)"

msgid "mime_zst"
msgstr "Zstandard stisnjeni paket (Facebook ga je razvil leta 2015, oblikoval Yann Collet. Algoritem stiskanja velike hitrosti, stopnja stiskanja blizu LZMA, hitrost znatno večja od GZIP. Linux kernel 5.9+ ga podpira, Arch Linux pacman, Debian APT ga postopoma sprejemajo, novi je standard stiskanja naslednje generacije)"

msgid "mime_lz4"
msgstr "LZ4 stisnjeni paket (Yann Collet ga je razvil leta 2011, izjemno hiter algoritem stiskanja. Hitrost stiskanja je več kot 10-krat večja od GZIP, primeren za scenarije stiskanja v realnem času. Široko se uporablja v Linux jedru, OpenZFS, Hadoop, prva izbira za scenarije, kjer je hitrost prednostna naloga)"

msgid "mime_lzo"
msgstr "LZO stisnjeni paket (Markus Oberhumer ga je razvil leta 1996, Lempel-Ziv-Oberhumer algoritem. Izjemno hitra dekompresija, povprečna stopnja stiskanja. Linux kernel Squashfs, OpenWrt vdelana programska oprema ga uporabljajo, primeren za vgrajene sisteme)"

msgid "mime_msi"
msgstr "MSI namestitveni paket (Microsoft ga je predstavil leta 1999, Windows Installer format paketa. Standardni format namestitve za Windows aplikacije, podpira vračanje transakcij, upravljanje komponent, tiho nameščanje. Prva izbira za distribucijo programske opreme v podjetjih, še vedno je glavni format za namestitev Windows programske opreme)"

msgid "mime_pkg"
msgstr "PKG namestitveni paket (macOS aplikacijski namestitveni format, na podlagi Apple-ove Installer tehnologije. Standardni format za distribucijo programske opreme na macOS, podpira izbiro komponent, namestitvene skripte, funkcijo odstranitve. Dvoklik na .pkg datoteko zažene namestitev, običajna metoda distribucije programske opreme zunaj Mac App Store)"

msgid "mime_apk"
msgstr "APK Android aplikacijski paket (Google ga je predstavil leta 2008, tradicionalni format namestitve za Android sistem. APK je v bistvu ZIP stisnjeni paket, vsebuje kodo, vire, manifestno datoteko. Od leta 2021 Google Play zahteva, da nove aplikacije uporabljajo AAB format, vendar se APK še vedno uporablja za razvoj, odpravljanje napak, distribucijo prek tretjih trgovin in stransko nameščanje)"

msgid "mime_ipa"
msgstr "IPA Apple aplikacijski paket (iOS App Store Package, format namestitve za iOS/iPadOS aplikacije. Predstavljen leta 2008 z iPhone SDK. Zahteva distribucijo prek App Store ali podpisovanje s podjetniškim certifikatom. Vsebuje izvedljivo datoteko, vire, Info.plist podpisane informacije)"

msgid "mime_hap"
msgstr "HAP HarmonyOS aplikacijski paket (HarmonyOS Ability Package, osnovna enota HarmonyOS aplikacije. Predstavljen s HarmonyOS 2.0 leta 2020. Podpira entry in feature tipi, format distribucije za Huawei telefone, tablice, pametne ure in druge HarmonyOS naprave)"

msgid "mime_har"
msgstr "HAR HarmonyOS statični deljeni paket (HarmonyOS Archive, statična deljena knjižnica za HarmonyOS, se lahko deli med več HAP, uporablja se za komponentni razvoj in ponovno uporabo modulov)"

msgid "mime_aab"
msgstr "Android App Bundle (Google ga je predstavil leta 2018, od leta 2021 Google Play zahteva, da nove aplikacije uporabljajo ta format. AAB je format za distribucijo, Google Play dinamično generira optimizirane APK na podlagi konfiguracije naprave (arhitektura CPU, gostota slikovnih pik zaslona, jezik), povprečna velikost namestitvenega paketa se zmanjša za 35%. Razvijalci naložijo AAB, uporabniki prenesejo APK)"

msgid "mime_xapk"
msgstr "XAPK aplikacijski paket (razširjeni Android aplikacijski paket tretje strani, vsebuje APK + OBB podatkovne datoteke. Uporablja se za velike igre in zapletene aplikacije, rešuje omejitev 100 MB posamezne APK datoteke. Pogosto v trgovinah z aplikacijami tretjih strani, kot so APKPure, APKMirror, ni uradni Google format)"

msgid "mime_appx"
msgstr "Windows aplikacijski paket (Microsoft ga je predstavil leta 2012, format namestitve aplikacij za Windows 8/10/11. Podpira UWP in pretvorbo namiznih aplikacij, distribuira se prek Microsoft Store. Microsoft je leta 2024 predstavil MSIX kot naslednji format, postopoma nadomešča APPX)"

msgid "mime_msix"
msgstr "MSIX aplikacijski paket (Microsoft ga je predstavil leta 2018, novi Windows format za pakiranje aplikacij. Združuje prednosti APPX in MSI, podpira vse tipe Windows aplikacij, se lahko distribuira prek Microsoft Store ali stransko namesti, priporočeni format za Windows 11)"

msgid "mime_appimage"
msgstr "AppImage aplikacijski paket (predstavljen leta 2004, Linux format aplikacije brez namestitve. 'Ena aplikacija = ena datoteka', zažene se neposredno brez namestitve, podpira večino Linux distribucij, običajni način za razvijalce za distribucijo Linux programske opreme)"

msgid "mime_flatpak"
msgstr "Flatpak aplikacijski paket (predstavljen leta 2015, Linux format aplikacije v peskovniku. Zažene se navzkrižno distribucijami, izoliran od sistemskega okolja, razvijata ga Fedora, Red Hat, privzeti format v GNOME Software centru)"

msgid "mime_snap"
msgstr "Snap aplikacijski paket (Canonical ga je predstavil leta 2014, razvija ga Ubuntu matična družba, Linux univerzalni format aplikacije. Samodejno posodabljanje, peskovnik izolacije, podpira 40+ Linux distribucij, privzeti format v Ubuntu Software centru)"

msgid "mime_deb"
msgstr "Debian programski paket (Debian projekt ga je predstavil leta 1993, standardni namestitveni format za Debian/Ubuntu in njihove izpeljanke. Upravlja ga dpkg, APT je njegov frontend upravitelj paketov, eden najbolj zrelih formatov paketov v Linux ekosistemu, še vedno je glavni za Debian družino)"

msgid "mime_rpm"
msgstr "RPM programski paket (Red Hat ga je predstavil leta 1997, standardni format za Red Hat/Fedora/CentOS/SUSE in druge distribucije. RPM je okrajšava za 'Red Hat Package Manager', poleg DEB eden od dveh velikih formatov paketov v Linux, še vedno je glavni za RHEL družino)"

msgid "mime_pacman"
msgstr "Arch programski paket (Arch Linux ga je predstavil leta 2002, .pkg.tar.zst format, ki ga uporablja pacman upravitelj paketov. Jedro Arch Linux distribucije, ki se valja, znan po preprostosti in KISS principu, AUR (Arch User Repository) je njegova posebnost)"

msgid "mime_exe"
msgstr "EXE izvedljiva datoteka (Windows izvedljivi programski format, okrajšava za 'Executable'. Izvorni izvedljivi format Windows operacijskega sistema, vsebuje PE strukturo. Razvil se je iz MZ formata iz MS-DOS, PE (Portable Executable) format je bil uveden z Windows NT leta 1993 in se uporablja še danes. Namestitveni paketi programske opreme, aplikacije, sistemska orodja uporabljajo ta format. Uporabnik jih zažene z dvojnim klikom, najbolj razširjeni izvedljivi format na svetu)"

msgid "mime_dll"
msgstr "DLL dinamična knjižnica (Microsoft jo je predstavil leta 1993, Dynamic Link Library. Windows deljena knjižnica kode, naloži se dinamično med zagonom programa, prihrani pomnilnik in prostor na disku. Sistemske komponente, dodatki aplikacij, gonilniki uporabljajo DLL format. Osnovni način implementacije Windows API, problem 'DLL Hell' je bil ublažen v .NET eri)"

msgid "mime_com"
msgstr "COM izvedljiva datoteka (izvedljivi format iz MS-DOS ere, okrajšava za 'Command'. Preprosta struktura datoteke, omejitev 64KB, bil je glavni format pred Windows 3.x. Umaknjen, sodobni Windows uporabljajo EXE format, končnica COM se še vedno uporablja za nekatere komponentne datoteke)"

msgid "mime_aac"
msgstr "AAC avdio (MPEG standard 1997, Advanced Audio Coding. Naslednik MP3, kakovost zvoka je boljša od MP3 pri enaki bitni hitrosti, privzeti avdio format za YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC avdio (Apple ga je razvil leta 2004, Apple Lossless Audio Codec. Apple brezizgubni format, postal odprtokoden leta 2011, privzeti format za brezžični avdio v iTunes in Apple Music)"

msgid "mime_flac"
msgstr "FLAC avdio (razvila Xiph.Org fundacija leta 2001, Free Lossless Audio Codec. Brezizgubno stiskanje, kakovost zvoka je enaka kot na CD, datoteka je približno polovica manjša od originalnega WAV. Odprtokoden in brez patenta, prva izbira za ljubitelje zvoka in zbiratelje digitalne glasbe)"

msgid "mime_mp3"
msgstr "MP3 avdio (razvil Fraunhofer inštitut leta 1993, MPEG-1 Audio Layer 3. Format stiskanja z izgubo, majhne datoteke s spodobno kakovostjo zvoka, bil je osnovni format digitalne glasbene revolucije v 2000-ih, zaslužen za iPod in Napster. Patent je potekel leta 2017, postal je javno dobro)"

msgid "mime_oga"
msgstr "Ogg Audio avdio (razvila Xiph.Org fundacija, čisti avdio format Ogg vsebnika, uporablja Vorbis kodek. Odprtokoden in brez patenta, učinkovitost stiskanja je boljša od MP3, široko se uporablja v odprtokodnih projektih)"

msgid "mime_ogg"
msgstr "OGG avdio (razvila Xiph.Org fundacija leta 2000, Ogg Vorbis format. Odprtokoden in brez patenta, učinkovitost stiskanja je boljša od MP3, zgodaj ga je uporabljal Spotify, široko se uporablja v zvočnih učinkih za igre)"

msgid "mime_opus"
msgstr "Opus avdio (IETF standardiziran leta 2012, odprtokoden in brez patenta. Kombinira SILK in CELT tehnologiji, izjemno nizka zakasnitev, največja učinkovitost stiskanja, privzeti avdio format za WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV avdio (razvila Microsoft in IBM leta 1991, Windows izvorni avdio format. PCM kodiranje brez stiskanja, brezhibna kakovost, vendar so datoteke ogromne, standardni format za profesionalno avdio montažo)"

msgid "mime_wma"
msgstr "WMA avdio (Microsoft ga je razvil leta 1999, Windows Media Audio. Ima različici z izgubo in brez izgube, Windows izvorno podpira, postal je priljubljen z Windows Media Player. Danes je na robu, zamenjala sta ga MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF avdio (Direct Stream Digital format, razvila sta ga Sony in Philips. 1-bit visoka hitrost vzorčenja, standardni format DSD avdio, digitalna različica SACD, vrhunski avdio format za ljubitelje zvoka, ogromne datoteke)"

msgid "mime_ape"
msgstr "APE Avdio (razvil Monkey's Audio leta 2000, format stiskanja brez izgub. Višje stiskanje kot FLAC, vendar počasnejše kodiranje, še vedno v uporabi na platformi Windows in med avdio navdušenci)"

msgid "mime_mid"
msgstr "MIDI avdio (MIDI združenje je vzpostavilo standard leta 1983, Musical Instrument Digital Interface. Format notnega zapisa, ne posnetka, izjemno majhne datoteke, standard za elektronske glasbene instrumente, melodije mobilnih telefonov, zvočne učinke v igrah. General MIDI je bil standardiziran leta 1991, definira 128 instrumentov)"

msgid "mime_m4a"
msgstr "M4A avdio (MPEG-4 Audio, vsebniški format za AAC. Standardni format za iTunes Music Store, glavni avdio format v Apple ekosistemu, podpira DRM zaščito)"

msgid "mime_m3u"
msgstr "M3U predvajalni seznam (seznam za predvajanje MP3 URL, običajna besedilna datoteka, beleži poti avdio datotek. Standard iz ere Winamp, uporablja se za internetni radio, spletno pretakanje glasbe. M3U8 je njegova UTF-8 različica, uporablja se za HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF pretakanje medijev (Microsoft ga je razvil leta 1996, Advanced Systems Format. Windows Media pretakalni vsebnik, podpira sinhroniziran prenos avdio in video zapisov. Uporablja se za spletni prenos v živo in pretakanje videa na zahtevo, WMA/WMV temeljijo na ASF vsebniku)"

msgid "mime_avi"
msgstr "AVI video (Microsoft ga je predstavil leta 1992, zgodnji Windows video standard. 'Audio Video Interleave', avdio in video zapis sta prepletena, bil je najbolj priljubljen video format v 1990-ih in 2000-ih, danes ga je zamenjal MP4/MKV)"

msgid "mime_divx"
msgstr "DivX video (razvila DivX družba leta 1998, video kodek na podlagi MPEG-4. Bil je glavni format za deljenje video posnetkov na internetu v 2000-ih, prvič je omogočil stiskanje DVD kakovosti na velikost CD. Zaradi avtorskih sporov se je pozneje preoblikoval v komercialni kodek)"

msgid "mime_mp4"
msgstr "MP4 video (MPEG standard 2001, MPEG-4 Part 14. Najbolj univerzalni video format na svetu, podpira H.264/H.265 kodiranje, privzeti format za spletni video, snemanje z mobilnim telefonom, YouTube)"

msgid "mime_m4v"
msgstr "M4V video (iTunes video format, različica MP4. Video format v Apple ekosistemu, standardni format za filme in TV serije v iTunes Store, podpira DRM zaščito avtorskih pravic)"

msgid "mime_mpeg"
msgstr "MPEG video (MPEG organizacija je vzpostavila standard leta 1988, Moving Picture Experts Group. Temeljni standardi za stiskanje digitalnega videa, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (spletni video) so imeli globok vpliv)"

msgid "mime_mkv"
msgstr "MKV video (razvil Matroska projekt leta 2002, odprtokodni večpredstavnostni vsebniški format. Podpira več avdio posnetkov, več podnapisov, poglavja, 'sposoben pakirati vse', prva izbira za deljenje filmov visoke ločljivosti)"

msgid "mime_mpg"
msgstr "MPEG video (končnica za MPEG-1/MPEG-2 video, standardni format za VCD in DVD. Bil je glavni format za video na CD-jih v 1990-ih in 2000-ih, danes ga je zamenjala H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video video (razvila Xiph.Org fundacija, video format Ogg vsebnika, uporablja Theora kodek. Odprtokoden in brez patenta, bil je eden od zgodnjih standardov za HTML5 video, Firefox ga izvorno podpira)"

msgid "mime_ogx"
msgstr "Ogg večpredstavnostni vsebnik (razvila Xiph.Org fundacija, univerzalna razširitev Ogg vsebnika, lahko vsebuje več posnetkov, kot so avdio, video, podnapisi. Odprtokodni večpredstavnostni standard, uporablja se v igrah in pretakanju medijev)"

msgid "mime_rm"
msgstr "RealMedia video (RealNetworks ga je razvil leta 1995, RealMedia format. Bil je pionir pretakanja medijev na internetu v 1990-ih in 2000-ih, osnovni format RealPlayer. Pomanjkljivosti: potreben je specializiran predvajalnik, slaba kakovost stiskanja, zamenjala sta ga Flash/MP4)"

msgid "mime_flv"
msgstr "Flash video (format se je pojavil leta 2002, Flash Video format. Nekoč je bil glavna oblika spletnega videa, zgodaj ga je uporabljal YouTube. Pomanjkljivosti: potreben Flash vtičnik, slabe zmogljivosti, veliko varnostnih lukenj. Od leta 2015 so glavne spletne strani prešle na HTML5 video, danes je ukinjen)"

msgid "mime_f4v"
msgstr "F4V video (Flash video format, ki ga je razvil Adobe, naslednik FLV. Na podlagi MPEG-4 standarda, podpira H.264 kodiranje. Umaknjen je skupaj s Flash tehnologijo, Adobe je ukinil podporo leta 2020)"

msgid "mime_wmv"
msgstr "WMV video (Microsoft ga je razvil leta 1999, Windows Media Video. Windows izvorno podpira, optimiziran za prenos pretakanja medijev, bil je pogost format za spletne videe v 2000-ih, danes je na robu)"

msgid "mime_wmf"
msgstr "WMF medijski format (Windows Media Format, Microsoftov okvir za medije. Vključuje WMV video, WMA avdio, Windows Media Player ga izvorno podpira)"

msgid "mime_mov"
msgstr "MOV video (Apple ga je razvil leta 1991, QuickTime vsebniški format. Standardni format za profesionalno video montažo, podpira več kodekov, izvorno ga podpirata Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime video (Apple ga je predstavil leta 1991, QuickTime format. Standard za video na Mac platformi, MOV je njegov vsebnik, QuickTime predvajalnik je bil široko uporabljen. Apple je leta 2016 ukinil razvoj Windows različice, postopoma ga zamenjuje MP4)"

msgid "mime_webm"
msgstr "WebM video (Google ga je predstavil leta 2010, odprtokoden in brez patenta. Na podlagi Matroska vsebnika, VP8/VP9 kodiranje, standardni format za HTML5 video, privzeti format za YouTube Web predvajalnik)"

msgid "mime_3gp"
msgstr "3GP video (vzpostavil 3GPP leta 2000, video format za mobilne naprave. Izjemno majhne datoteke, nizka kakovost, format za snemanje na starih mobilnih telefonih, uporabljen za pošiljanje prek MMS)"

