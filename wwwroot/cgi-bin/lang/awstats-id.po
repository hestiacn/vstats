#------------------------------------------------------------------------------
# Deskripsi format
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "File teks (standarisasi ASCII 1963, teks biasa tanpa format. Dasar dari semua kode sumber, konfigurasi, log. Unix menggunakan LF, Windows menggunakan CRLF untuk baris baru, masih format data paling umum dalam komputasi)"

msgid "mime_log"
msgstr "File log (file teks biasa yang merekam informasi sistem dan eksekusi aplikasi, sering digunakan untuk pemecahan masalah, analisis kinerja, audit keamanan. Format standar seperti Apache combined log, Nginx access log, syslog, dll.)"

msgid "mime_page"
msgstr "Halaman web HTML (Tim Berners-Lee menemukan World Wide Web pada tahun 1989, mendefinisikan tiga teknologi HTML/HTTP/URL pada tahun 1990, menawarkannya secara gratis tanpa paten. HTML5 menjadi standar resmi W3C pada tahun 2014, mendukung tampilan, multimedia, dan pencetakan. Pemenang Hadiah Turing 2016)"

msgid "mime_khtml"
msgstr "Mesin web KHTML (dirilis dengan KDE 2.0 pada tahun 1998, mesin render peramban Konqueror. Apple membuat WebKit berdasarkan KHTML pada tahun 2001, Google membuat Blink dari WebKit pada tahun 2008, yang menjadi inti peramban Chrome, Edge, Safari. KHTML adalah contoh bagaimana komunitas open source meletakkan dasar bagi mesin peramban modern, warisan teknologinya berlanjut melalui WebKit/Blink)"

msgid "mime_script"
msgstr "Skrip dinamis (bahasa interpretasi, tidak memerlukan kompilasi. Termasuk ASP, JSP, CGI, ColdFusion, Tcl, VBScript, dll., banyak digunakan dalam pengembangan web awal, administrasi sistem, otomatisasi tugas. Bahasa skrip modern seperti Python, Ruby, JavaScript telah berkembang menjadi bahasa utama untuk pengembangan full-stack)"

msgid "mime_js"
msgstr "Skrip JavaScript (Brendan Eich membuatnya dalam 10 hari di Netscape pada tahun 1995, bahasa pemrograman asli peramban. ECMAScript distandarisasi pada tahun 1997, kelahiran Node.js pada tahun 2009 menjadikannya bahasa full-stack, npm adalah manajer paket terbesar di dunia. Bertahun-tahun menjadi bahasa pemrograman paling populer di GitHub)"

msgid "mime_py"
msgstr "Skrip Python (dibuat oleh Guido van Rossum pada tahun 1991, dikenal dengan indentasi wajib dan sintaks sederhana. Banyak digunakan dalam pengembangan web, ilmu data, kecerdasan buatan, otomatisasi operasi. Beberapa kali pemenang penghargaan TIOBE untuk Bahasa Pemrograman Tahun Ini)"

msgid "mime_sh"
msgstr "Skrip Shell (kelahiran Unix pada tahun 1971, bahasa skrip perintah. Digunakan untuk administrasi sistem, otomatisasi tugas, memulai layanan, skrip deployment. Keterampilan penting untuk administrasi Linux)"

msgid "mime_rb"
msgstr "Skrip Ruby (dibuat oleh Yukihiro Matsumoto pada tahun 1995, berfokus pada kebahagiaan pengembang. Kerangka Ruby on Rails memperkenalkan paradigma konvensi daripada konfigurasi, mempengaruhi desain kerangka web modern)"

msgid "mime_pl"
msgstr "Skrip Perl (dibuat oleh Larry Wall pada tahun 1987, dikenal karena pragmatismenya, dijuluki 'pisau Swiss army'. CPAN adalah pelopor manajer paket bahasa modern, memiliki pengaruh mendalam dalam pemrosesan teks, administrasi sistem, dan CGI)"

msgid "mime_php"
msgstr "Halaman web dinamis PHP (dibuat oleh Rasmus Lerdorf pada tahun 1995, dirancang khusus untuk pengembangan web. Lebih dari 70% situs web dunia menggunakannya, mendukung platform seperti WordPress, Facebook, Wikipedia. PHP 8 memperkenalkan kompilasi JIT, meningkatkan kinerja secara signifikan)"

msgid "mime_image"
msgstr "File gambar"

msgid "mime_document"
msgstr "File dokumen"

msgid "mime_package"
msgstr "Paket perangkat lunak"

msgid "mime_archive"
msgstr "File terkompresi Gzip (proyek GNU 1992, berdasarkan algoritma DEFLATE. Di web digunakan untuk kompresi dinamis konten respons, rasio kompresi biasanya 60-90%. Setelah 2015 digantikan oleh Brotli dalam beberapa skenario, tetapi tetap menjadi format kompresi paling luas didukung di sisi server)"

msgid "mime_audio"
msgstr "File audio"

msgid "mime_video"
msgstr "File video"

msgid "mime_jscript"
msgstr "JavaScript (dikembangkan oleh Brendan Eich pada tahun 1995)"

msgid "mime_json"
msgstr "Data JSON (diusulkan oleh Douglas Crockford pada tahun 2001, format pertukaran data ringan, standar de facto untuk API web)"

msgid "mime_vbs"
msgstr "VBScript (dikembangkan oleh Microsoft pada tahun 1996, bahasa skrip Windows, digunakan untuk halaman web ASP dan skrip administrasi Windows. Dengan popularitas PowerShell dan JavaScript, perlahan-lahan ditinggalkan)"

msgid "mime_conf"
msgstr "File konfigurasi (menyimpan konfigurasi perangkat lunak dalam format teks, format umum: INI, JSON, YAML, TOML, XML. Konfigurasi sistem Linux sebagian besar berada di direktori /etc)"

msgid "mime_css"
msgstr "Lembar gaya CSS (W3C merilis standar resmi pertama CSS1 pada Desember 1996, CSS2 menambahkan posisi dan tipe media pada tahun 1998, mulai 2011 modularisasi CSS3 memperkenalkan sudut membulat, animasi, kotak fleksibel, tata letak grid, dan desain responsif. Bersama HTML dan JavaScript, merupakan tiga teknologi utama front-end, semua peramban modern (Chrome, Firefox, Safari, Edge) mendukungnya secara native, satu-satunya standar untuk mendefinisikan gaya halaman web)"

msgid "mime_xsl"
msgstr "Lembar gaya XSL (standar W3C 1999, bahasa transformasi dokumen XML, dapat mengubah XML menjadi HTML/PDF/teks. Penggunaannya menurun setelah popularitas JSON)"

msgid "mime_runtime"
msgstr "File yang dapat dieksekusi (format eksekusi sistem operasi seperti EXE, ELF, Mach-O, berisi kode mesin dan informasi pemuatan)"

msgid "mime_library"
msgstr "File pustaka (DLL, SO, dylib, dll., pustaka yang ditautkan secara dinamis, kode bersama yang dimuat program selama eksekusi)"

msgid "mime_swf"
msgstr "Animasi Flash (Macromedia mengembangkannya pada tahun 1996, kemudian menjadi milik Adobe. Standar animasi web interaktif, pernah mendominasi animasi dan game internet. Kekurangan: memerlukan plugin, tidak didukung di perangkat seluler, risiko keamanan tinggi. Adobe mengumumkan penghentian pada tahun 2017, menghentikan dukungan sepenuhnya pada tahun 2020, digantikan oleh HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD definisi tipe dokumen (spesifikasi XML, mendefinisikan struktur dokumen XML, digunakan untuk memvalidasi legitimasi XML)"

msgid "mime_csv"
msgstr "Format data CSV (nilai dipisah koma, format data tabular umum, standar untuk impor/ekspor Excel dan basis data)"

msgid "mime_jnlp"
msgstr "Java Web Start (peluncur aplikasi Java, teknologi distribusi aplikasi desktop Java tahun 2000-an, sekarang usang)"

msgid "mime_lit"
msgstr "Buku elektronik Microsoft Reader (Microsoft merilisnya pada tahun 2000, format LIT, usang)"

msgid "mime_svg"
msgstr "Grafik vektor SVG (standar W3C 1999, karena Microsoft lama mempromosikan format VML sendiri, peramban IE mendukungnya baru pada tahun 2011, yang menunda adopsi. Setelah 2015, dengan hilangnya IE dan popularisasi layar resolusi tinggi, menjadi format pilihan untuk ikon dan logo)"

msgid "mime_ai"
msgstr "Grafik vektor Adobe Illustrator (dirilis pada tahun 1987, format grafik vektor standar industri, pilihan untuk desain cetak, logo, ikon)"

msgid "mime_phshop"
msgstr "Gambar Photoshop (Adobe merilisnya pada tahun 1990, format file sumber Photoshop PSD, standar industri untuk pemrosesan gambar)"

msgid "mime_ttf"
msgstr "Font TrueType (Apple dan Microsoft bersama-sama mengembangkan pada tahun 1989, format font vektor, tampilan layar dan cetak konsisten, format font default sistem operasi modern)"

msgid "mime_fon"
msgstr "Font web WOFF2 (rekomendasi W3C 2014, menggunakan algoritma kompresi Brotli, dibandingkan dengan WOFF lama volumenya berkurang sekitar 30%, dibandingkan dengan TTF/OTF berkurang lebih dari 50%, saat ini didukung oleh semua peramban modern, menjadikannya format pilihan untuk font web modern, didukung oleh lebih dari 98% peramban)"

msgid "mime_pdf"
msgstr "Dokumen PDF (Adobe mengembangkannya pada tahun 1993, menjadi standar ISO pada tahun 2008. Format dokumen lintas platform, menjaga konsistensi format, merupakan standar global untuk distribusi dokumen elektronik)"

msgid "mime_dotnet"
msgstr "Halaman dinamis ASP.NET (Microsoft merilisnya pada tahun 2002, teknologi halaman web dinamis pada platform Windows, bagian dari .NET Framework)"

msgid "mime_mdb"
msgstr "Basis data Access (file basis data Microsoft Access, dirilis pada tahun 1992, solusi basis data desktop Windows)"

msgid "mime_md"
msgstr "Dokumen Markdown (dibuat oleh John Gruber pada tahun 2004, desain sintaks dipengaruhi oleh reStructuredText dan Setext. Filosofi desain dasar adalah 'keterbacaan berarti dapat dirender', implementasi asli Markdown.pl menggunakan ekspresi reguler Perl. Spesifikasi turunan termasuk GFM (2013), CommonMark (2017), Pandoc Markdown, dll. Mendukung ekosistem seperti GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, menjadi format standar de facto untuk generator situs statis dan dokumentasi pengembang)"

msgid "mime_crystal"
msgstr "Format laporan Crystal Reports (intelijen bisnis SAP, format standar untuk laporan perusahaan)"

msgid "mime_libreoffice"
msgstr "Dokumen LibreOffice (The Document Foundation mengembangkannya pada tahun 2010, cabang OpenOffice, implementasi standar ODF, paket kantor open source utama)"

msgid "mime_encrypt"
msgstr "File terenkripsi (perlu didekripsi untuk dilihat, ekstensi umum: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Data jalur GPS (format pertukaran GPS, merekam informasi geografis, format umum untuk jam olahraga dan perangkat navigasi)"

msgid "mime_diskimage"
msgstr "Citra disk (file citra disk/CD-ROM seperti DMG, ISO, IMG, digunakan untuk distribusi perangkat lunak atau pencadangan media penyimpanan)"

msgid "mime_vm"
msgstr "Citra mesin virtual (file disk virtual seperti VMDK, VDI, VHDX, OVA, format untuk platform virtualisasi seperti VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "File torrent BitTorrent (Bram Cohen menemukannya pada tahun 2001, file indeks untuk unduhan P2P, berisi metadata file dan informasi Tracker)"

msgid "mime_gis"
msgstr "Data sistem informasi geografis GIS (data geospasial seperti Shapefile, GeoJSON, digunakan untuk peta dan analisis spasial)"

msgid "mime_ebook"
msgstr "Buku elektronik (format buku elektronik seperti EPUB, MOBI, AZW. EPUB adalah standar internasional, MOBI/AZW adalah format untuk Amazon Kindle)"

msgid "mime_avif"
msgstr "Gambar AVIF (diluncurkan oleh Alliance for Open Media pada tahun 2019, berdasarkan pengkodean AV1, rasio kompresi 50% lebih baik dari WebP, standar gambar web generasi baru)"

msgid "mime_markdown"
msgstr "Dokumen Markdown (dirancang oleh John Gruber pada tahun 2004, bahasa markup ringan, format umum untuk README GitHub, dokumentasi teknis, posting forum)"

msgid "mime_yaml"
msgstr "Konfigurasi YAML (dirancang oleh Clark Evans pada tahun 2001, format serialisasi data yang dapat dibaca manusia, standar untuk file konfigurasi Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Konfigurasi TOML (dirancang oleh Tom Preston-Werner pada tahun 2013, 'Tom's Obvious Minimal Language', format file konfigurasi untuk alat modern seperti Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "File komponen Vue (diperkenalkan pada tahun 2014 oleh Evan You, kerangka kerja JavaScript progresif. Melalui komponen satu file (SFC), ia menggabungkan HTML, CSS, dan JS dengan sempurna, sangat meningkatkan efisiensi pengembangan. Ini adalah salah satu kerangka kerja frontend paling populer di dunia. Juga sebagai inti dari generator situs statis modern seperti VitePress, ini banyak digunakan untuk mendorong dokumentasi teknis interaktif dan blog.)"

msgid "mime_wasm"
msgstr "Modul WebAssembly (standar W3C 2017, format eksekusi berkinerja tinggi di peramban, C/C++/Rust/R dapat dikompilasi sebagai target, kinerja mendekati native)"

msgid "mime_jsx"
msgstr "Komponen React JSX (Facebook merilis JavaScript XML pada tahun 2013, sintaks komponen kerangka React, paradigma inovatif yang membawa HTML ke dalam JavaScript)"

msgid "mime_tsx"
msgstr "Komponen TypeScript TSX (dikembangkan oleh Microsoft pada tahun 2012, TypeScript + JSX, cara penulisan standar untuk pengembangan React dengan keamanan tipe)"

msgid "mime_heif"
msgstr "Gambar HEIF (standar MPEG 2015, format file gambar efisien, banyak digunakan di ekosistem Apple)"

msgid "mime_heic"
msgstr "Gambar HEIC (implementasi Apple dari HEIF, format foto default di iPhone, didukung secara native di iOS/macOS)"

msgid "mime_gltf"
msgstr "Model 3D GLTF (format transfer GL, 'JPEG dari dunia 3D', Khronos Group merilis pada tahun 2015, format standar untuk Web 3D)"

msgid "mime_glb"
msgstr "Model 3D biner GLB (versi biner dari GLTF, satu file berisi semua sumber daya, digunakan untuk distribusi adegan 3D)"

msgid "mime_gls"
msgstr "GLOSARIUM (file definisi istilah, untuk manajemen istilah dalam sistem dokumentasi)"

msgid "mime_cbz"
msgstr "Buku komik CBZ (gambar komik dikompres dengan ZIP, format umum untuk koleksi komik)"

msgid "mime_cbr"
msgstr "Buku komik CBR (gambar komik dikompres dengan RAR, format umum untuk koleksi komik)"

msgid "mime_fb2"
msgstr "Buku elektronik FB2 (FictionBook 2.0, format buku elektronik Rusia, struktur XML, didukung secara luas oleh pembaca open source)"

msgid "mime_kepub"
msgstr "Buku elektronik KEPUB (format EPUB khusus untuk Kobo, format dioptimalkan untuk pembaca buku elektronik Kobo)"

msgid "mime_m4b"
msgstr "Buku audio M4B (format audio MPEG-4 untuk buku, mendukung bookmark, format buku audio iTunes)"

msgid "mime_kfx"
msgstr "Format Kindle KFX (Amazon merilis pada tahun 2015, format buku elektronik khusus untuk Kindle, mendukung tata letak canggih dan pembalikan halaman cepat)"

msgid "mime_chm"
msgstr "File bantuan CHM (Microsoft merilis pada tahun 1997, format bantuan HTML terkompilasi, standar untuk dokumentasi bantuan perangkat lunak Windows)"

msgid "mime_mht"
msgstr "Arsip web MHT (Microsoft merilis pada tahun 1999, format halaman web file tunggal, format penyimpanan halaman web peramban IE)"

msgid "mime_wml"
msgstr "Bahasa markup nirkabel WML (standar WAP 1999, digunakan untuk halaman web di ponsel awal, usang)"

msgid "mime_xhtml"
msgstr "Halaman web XHTML (standar W3C 2000, versi XML dari HTML, sintaks lebih ketat. W3C menghentikan pemeliharaan pada tahun 2009, fokus beralih ke HTML5)"

msgid "mime_xml"
msgstr "Dokumen XML (standar W3C 1998, bahasa markup yang dapat diperluas, format dasar untuk layanan web, file konfigurasi, pertukaran data)"

msgid "mime_sgml"
msgstr "Dokumen SGML (standar ISO 1986, pendahulu HTML, bahasa markup umum standar, baik XML maupun HTML diturunkan dari SGML)"

msgid "mime_apng"
msgstr "Animasi APNG (Mozilla mengembangkannya pada tahun 2004, ekstensi animasi PNG, pengganti modern untuk GIF, mendukung warna asli dan transparansi)"

msgid "mime_bmp"
msgstr "BMP bitmap (Format bitmap Windows, didukung secara native sejak Windows 1.0. Tidak terkompresi, ukuran file besar, tetapi karena strukturnya yang sederhana dan tidak memerlukan codec tambahan, masih digunakan di alat Snipping Tool Windows 11, program Paint, sumber daya ikon dalam paket instalasi EXE/MSI, file kursor, dan beberapa driver lama. Pada kualitas gambar yang sama, ukuran file sekitar 3-10 kali lebih besar dari PNG. Di sebagian besar kasus telah digantikan oleh PNG/JPEG, tetapi ekosistem Windows masih mempertahankan kompatibilitas yang luas)"

msgid "mime_cdr"
msgstr "Grafik vektor CDR (format khusus CorelDRAW, perusahaan Kanada Corel, perangkat lunak desain grafis vektor)"

msgid "mime_gif"
msgstr "Gambar GIF (CompuServe mengembangkannya pada tahun 1987, format gambar animasi 256 warna. Kekurangan: sedikit warna, kualitas gambar kasar, tidak mendukung transparansi, file besar, frekuensi bingkai rendah. Digantikan oleh format animasi modern seperti APNG, WebP)"

msgid "mime_ico"
msgstr "Ikon ICO (format ikon Windows, mendukung beberapa resolusi, format standar untuk favicon situs web)"

msgid "mime_jpeg"
msgstr "Gambar JPEG (standar ISO 1992, format kompresi lossy untuk foto, standar de facto untuk foto di internet)"

msgid "mime_jpg"
msgstr "Gambar JPEG (standar ISO 1992, format kompresi lossy untuk foto, standar de facto untuk foto di internet)"

msgid "mime_png"
msgstr "Gambar PNG (rekomendasi W3C 1996, mendukung warna asli dan transparansi, pengganti statis untuk GIF, standar untuk gambar lossless di internet)"

msgid "mime_ps"
msgstr "File deskripsi halaman PostScript (Adobe merilis pada tahun 1985, bahasa deskripsi halaman, pendahulu PDF, digunakan untuk pencetakan dan penerbitan)"

msgid "mime_psb"
msgstr "Dokumen besar PSB (format Adobe Photoshop untuk gambar yang sangat besar, mendukung gambar raksasa lebih dari 2 GB atau 30000 piksel)"

msgid "mime_psd"
msgstr "Gambar PSD (file sumber Adobe Photoshop, mendukung lapisan, saluran, jalur, format standar industri untuk pemrosesan gambar)"

msgid "mime_webp"
msgstr "Gambar WebP (Google mengembangkannya pada tahun 2010, format gambar web, mendukung kompresi lossy/lossless dan animasi, rasio kompresi 25-35% lebih baik dari PNG dan 25% lebih baik dari JPEG)"

msgid "mime_woff"
msgstr "Font web WOFF (dibuat pada tahun 2009, standar W3C 2018. Dikompres berdasarkan TrueType/OpenType, dioptimalkan untuk pemuatan font web, format standar untuk font ikon situs web modern)"

msgid "mime_7z"
msgstr "Arsip terkompresi 7z (Igor Pavlov mengembangkannya pada tahun 1999, format khusus program 7-Zip. Algoritma LZMA, rasio kompresi tinggi, open source dan gratis. Format 7z biasanya 30-50% lebih kecil dari ZIP pada rasio kompresi yang sama, format umum di komunitas open source dan untuk distribusi perangkat lunak)"

msgid "mime_ace"
msgstr "Arsip terkompresi ACE (dikembangkan pada tahun 1990-an, format program WinACE. Dulu bersaing dengan RAR, rasio kompresinya cukup tinggi. Pengembangan dihentikan pada tahun 2007, sekarang digantikan oleh 7z/RAR, jarang digunakan)"

msgid "mime_bz2"
msgstr "Arsip terkompresi BZIP2 (Julian Seward mengembangkannya pada tahun 1996, algoritma kompresi pengurutan blok. Rasio kompresi 15-20% lebih tinggi dari GZIP tetapi lebih lambat. Format umum untuk kode sumber kernel Linux, paket perangkat lunak open source, ekstensi .bz2)"

msgid "mime_cab"
msgstr "Arsip terkompresi CAB (Microsoft mengembangkannya pada tahun 1995, format Cabinet. Format paket instalasi untuk Windows, digunakan untuk driver, distribusi file sistem. Windows Installer (MSI) secara internal menggunakan CAB untuk menyimpan file)"

msgid "mime_dmg"
msgstr "Citra disk DMG (Apple memperkenalkannya pada tahun 1980-an, format Disk Image. Format standar untuk distribusi perangkat lunak macOS, klik dua kali untuk memasang sebagai disk virtual, seret dan lepas untuk menginstal aplikasi. Mendukung kompresi dan enkripsi, merupakan format utama untuk unduhan perangkat lunak Mac)"

msgid "mime_emz"
msgstr "Gambar terkompresi EMZ (metafile ditingkatkan terkompresi Windows, versi terkompresi dari EMF. Format penyimpanan grafik vektor di dokumen Office, pada dasarnya adalah file EMF yang dikompres dengan GZIP)"

msgid "mime_gz"
msgstr "Arsip terkompresi GZIP (Jean-loup Gailly dan Mark Adler mengembangkannya pada tahun 1992, proyek GNU. Alat kompresi standar di Unix/Linux, format umum untuk kompresi transmisi HTTP. Ekstensi .gz, sering digunakan bersama dengan TAR)"

msgid "mime_jar"
msgstr "Arsip terkompresi JAR (Sun Microsystems merilisnya pada tahun 1997, format Java ARchive. Pada dasarnya adalah file ZIP, digunakan untuk mengemas pustaka dan aplikasi Java. Format dasar ekosistem Java seperti Maven, Gradle. Android juga menggunakan JAR)"

msgid "mime_lzma"
msgstr "Arsip terkompresi LZMA (Igor Pavlov mengembangkannya pada tahun 1998, algoritma Lempel-Ziv-Markov chain. Algoritma kompresi utama format 7z, rasio kompresi tinggi, kecepatan dekompresi cepat. Digunakan untuk distribusi firmware dan perangkat lunak untuk sistem tertanam)"

msgid "mime_rar"
msgstr "Arsip terkompresi RAR (Eugene Roshal mengembangkannya pada tahun 1993, format Roshal ARchive. Rasio kompresi tinggi, mendukung pemisahan volume dan catatan pemulihan. Format program WinRAR, rasio kompresi lebih baik dari ZIP tetapi memerlukan perangkat lunak berbayar, alat open source seperti unrar dapat mendekompres)"

msgid "mime_tar"
msgstr "Arsip TAR (Unix V7 memperkenalkannya pada tahun 1979, format Tape ARchive. Arsip pita, hanya mengemas tanpa kompresi, sering digunakan bersama dengan GZIP/BZIP2/XZ. Kode sumber paket Linux, penyimpanan lapisan gambar Docker menggunakan format TAR)"

msgid "mime_tgz"
msgstr "Arsip terkompresi TGZ (format kombinasi TAR + GZIP, ekstensi .tgz atau .tar.gz. Format paling umum untuk distribusi paket perangkat lunak Unix/Linux, paket kode sumber, paket biner, banyak digunakan, mewakili 'ekstrak dan gunakan')"

msgid "mime_tbz2"
msgstr "Arsip terkompresi TBZ2 (format kombinasi TAR + BZIP2, ekstensi .tbz2 atau .tar.bz2. Rasio kompresi 15-20% lebih tinggi dari TGZ, cocok untuk distribusi file besar, kernel Linux telah lama menggunakan format ini)"

msgid "mime_xz"
msgstr "Arsip terkompresi XZ (diperkenalkan pada tahun 2009, berdasarkan algoritma LZMA2. Rasio kompresi sangat tinggi, 30-50% lebih baik dari GZIP, kecepatan dekompresi relatif cepat. Kernel Linux, manajer paket (seperti di dalam .deb Debian) banyak menggunakannya, format yang direkomendasikan di ekosistem Linux saat ini)"

msgid "mime_z"
msgstr "Arsip terkompresi Z (format perintah Unix compress dari tahun 1985, algoritma LZW. Format kompresi Unix awal, digantikan oleh GZIP. Ekstensi .Z, sistem modern jarang menggunakannya)"

msgid "mime_zip"
msgstr "Arsip terkompresi ZIP (Phil Katz mengembangkannya pada tahun 1989, format PKZIP. Windows mendukung secara native, format kompresi paling umum di internet. Mendukung beberapa file, struktur direktori, dapat memilih algoritma kompresi. JAR dari Java, APK dari Android, DOCX/XLSX dari dokumen Office didasarkan pada format ZIP)"

msgid "mime_zst"
msgstr "Arsip terkompresi Zstandard (Facebook mengembangkannya pada tahun 2015, dirancang oleh Yann Collet. Algoritma kompresi kecepatan tinggi, rasio kompresi mendekati LZMA, kecepatan jauh melampaui GZIP. Kernel Linux 5.9+ mendukung, Arch Linux pacman, Debian APT secara bertahap mengadopsi, standar kompresi generasi baru)"

msgid "mime_lz4"
msgstr "Arsip terkompresi LZ4 (Yann Collet mengembangkannya pada tahun 2011, algoritma kompresi sangat cepat. Kecepatan kompresi lebih dari 10 kali lebih cepat dari GZIP, cocok untuk skenario kompresi real-time. Kernel Linux, OpenZFS, Hadoop banyak menggunakannya, pilihan pertama untuk skenario di mana kecepatan menjadi prioritas)"

msgid "mime_lzo"
msgstr "Arsip terkompresi LZO (Markus Oberhumer mengembangkannya pada tahun 1996, algoritma Lempel-Ziv-Oberhumer. Kecepatan dekompresi sangat cepat, rasio kompresi rata-rata. Kernel Linux Squashfs, firmware OpenWrt menggunakannya, cocok untuk sistem tertanam)"

msgid "mime_msi"
msgstr "Paket instalasi MSI (Microsoft merilisnya pada tahun 1999, format paket Windows Installer. Format instalasi standar untuk aplikasi Windows, mendukung rollback transaksi, manajemen komponen, instalasi senyap. Pilihan pertama untuk distribusi perangkat lunak tingkat perusahaan, hingga kini masih menjadi format utama untuk instalasi perangkat lunak Windows)"

msgid "mime_pkg"
msgstr "Paket instalasi PKG (format paket instalasi aplikasi macOS, berdasarkan teknologi Installer Apple. Format standar untuk distribusi perangkat lunak macOS, mendukung pemilihan komponen, skrip instalasi, fungsi penghapusan. Klik dua kali file .pkg untuk menginstal, metode distribusi umum untuk perangkat lunak di luar Mac App Store)"

msgid "mime_apk"
msgstr "Paket aplikasi Android APK (diperkenalkan oleh Google pada tahun 2008, format instalasi tradisional untuk aplikasi Android. APK pada dasarnya adalah paket ZIP yang berisi kode, sumber daya, dan file manifes. Mulai tahun 2021, Google Play mewajibkan aplikasi baru menggunakan format AAB, tetapi APK masih digunakan untuk debugging, toko pihak ketiga, dan pemasangan sisi)"

msgid "mime_ipa"
msgstr "Paket aplikasi iOS IPA (iOS App Store Package, format instalasi untuk aplikasi iOS/iPadOS. Diperkenalkan pada tahun 2008 dengan iPhone SDK. Harus didistribusikan melalui App Store atau ditandatangani dengan sertifikat perusahaan. Berisi file yang dapat dieksekusi, sumber daya, Info.plist, dan informasi tanda tangan)"

msgid "mime_hap"
msgstr "Paket aplikasi HarmonyOS HAP (HarmonyOS Ability Package, unit dasar aplikasi HarmonyOS. Diperkenalkan pada tahun 2020 dengan HarmonyOS 2.0. Mendukung dua tipe: entry dan feature, format distribusi untuk ponsel Huawei, tablet, jam pintar, dan perangkat HarmonyOS lainnya)"

msgid "mime_har"
msgstr "Pustaka bersama statis HarmonyOS HAR (HarmonyOS Archive, pustaka bersama statis HarmonyOS, dapat dibagikan oleh beberapa paket HAP, digunakan untuk pengembangan berbasis komponen dan penggunaan ulang modul)"

msgid "mime_aab"
msgstr "Android App Bundle (Google merilisnya pada tahun 2018, mulai 2021 Google Play mewajibkan aplikasi baru menggunakan format ini. AAB adalah format distribusi, Google Play menghasilkan APK yang dioptimalkan berdasarkan konfigurasi perangkat (arsitektur CPU, kepadatan layar, bahasa), ukuran paket instalasi rata-rata berkurang 35%. Pengembang mengunggah AAB, pengguna mengunduh APK)"

msgid "mime_xapk"
msgstr "Paket aplikasi XAPK (paket ekstensi aplikasi Android pihak ketiga, berisi APK + file data OBB. Digunakan untuk game besar dan aplikasi kompleks, mengatasi batasan 100 MB untuk satu file APK. Umum di toko aplikasi pihak ketiga seperti APKPure, APKMirror, bukan format resmi Google)"

msgid "mime_appx"
msgstr "Paket aplikasi Windows (Microsoft merilisnya pada tahun 2012, format instalasi untuk aplikasi Windows 8/10/11. Mendukung aplikasi UWP dan konversi aplikasi desktop, didistribusikan melalui Microsoft Store. Pada tahun 2024, Microsoft merilis MSIX sebagai penerus, secara bertahap menggantikan APPX)"

msgid "mime_msix"
msgstr "Paket aplikasi MSIX (Microsoft merilisnya pada tahun 2018, generasi baru format pengemasan untuk aplikasi Windows. Menggabungkan keunggulan APPX dan MSI, mendukung semua jenis aplikasi Windows, dapat didistribusikan melalui Microsoft Store atau pemasangan sisi, format yang direkomendasikan untuk Windows 11)"

msgid "mime_appimage"
msgstr "Paket aplikasi AppImage (diperkenalkan pada tahun 2004, format aplikasi Linux tanpa instalasi. 'Satu aplikasi - satu file', berjalan langsung tanpa instalasi, mendukung sebagian besar distribusi Linux, metode umum bagi pengembang untuk mendistribusikan perangkat lunak Linux)"

msgid "mime_flatpak"
msgstr "Paket aplikasi Flatpak (diperkenalkan pada tahun 2015, format aplikasi Linux dalam sandbox. Berjalan di berbagai distribusi, terisolasi dari sistem host, pengembangan dipimpin oleh Fedora dan Red Hat, format default Pusat Perangkat Lunak GNOME)"

msgid "mime_snap"
msgstr "Paket aplikasi Snap (Canonical merilisnya pada tahun 2014, perusahaan induk Ubuntu mengembangkannya, format aplikasi Linux universal. Pembaruan otomatis, isolasi sandbox, mendukung 40+ distribusi Linux, format default Pusat Perangkat Lunak Ubuntu)"

msgid "mime_deb"
msgstr "Paket perangkat lunak Debian (proyek Debian merilisnya pada tahun 1993, format instalasi standar untuk Debian/Ubuntu dan turunannya. Dikelola menggunakan dpkg, APT adalah manajer paket frontend-nya, salah satu format paket paling matang di ekosistem Linux, masih menjadi format utama di keluarga Debian hingga saat ini)"

msgid "mime_rpm"
msgstr "Paket perangkat lunak RPM (Red Hat merilisnya pada tahun 1997, format standar untuk distribusi seperti Red Hat/Fedora/CentOS/SUSE. RPM adalah singkatan dari 'Red Hat Package Manager', bersama DEB membentuk dua format paket utama Linux, masih menjadi format utama di keluarga RHEL hingga saat ini)"

msgid "mime_pacman"
msgstr "Paket perangkat lunak Arch (Arch Linux merilisnya pada tahun 2002, format .pkg.tar.zst yang digunakan oleh manajer paket pacman. Inti dari distribusi rolling release Arch Linux, dikenal karena kesederhanaannya dan prinsip KISS, AUR (Arch User Repository) adalah ciri khasnya)"

msgid "mime_exe"
msgstr "File yang dapat dieksekusi EXE (format program eksekusi Windows, singkatan dari 'Executable'. Format eksekusi asli sistem operasi Windows, berisi struktur PE. Berevolusi dari format MZ dari era MS-DOS, Windows NT memperkenalkan format PE (Portable Executable) pada tahun 1993 yang digunakan hingga saat ini. Paket instalasi perangkat lunak, aplikasi, alat sistem menggunakan format ini. Pengguna klik dua kali untuk menjalankannya, format eksekusi paling luas digunakan di dunia)"

msgid "mime_dll"
msgstr "Pustaka tertaut dinamis DLL (Microsoft memperkenalkannya pada tahun 1993, Dynamic Link Library. Pustaka kode bersama Windows, program dimuat secara dinamis selama eksekusi, menghemat memori dan ruang disk. Komponen sistem, plugin aplikasi, driver menggunakan format DLL. Cara utama implementasi API Windows, masalah 'DLL Hell' berkurang di era .NET)"

msgid "mime_com"
msgstr "File yang dapat dieksekusi COM (format eksekusi dari era MS-DOS, singkatan dari 'Command'. Struktur file sangat sederhana, batasan 64KB, format utama sebelum Windows 3.x, usang. Windows modern menggunakan format EXE, ekstensi COM masih digunakan untuk beberapa file komponen)"

msgid "mime_aac"
msgstr "Audio AAC (standar MPEG 1997, Advanced Audio Coding. Penerus MP3, kualitas audio lebih baik dari MP3 pada bitrate yang sama, format audio default untuk YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Audio ALAC (Apple mengembangkannya pada tahun 2004, Apple Lossless Audio Codec. Format lossless Apple, open source pada tahun 2011, format lossless default untuk iTunes dan Apple Music)"

msgid "mime_flac"
msgstr "Audio FLAC (Yayasan Xiph.Org mengembangkannya pada tahun 2001, Free Lossless Audio Codec. Kompresi lossless, kualitas audio sama seperti CD, ukuran file sekitar setengah dari WAV asli. Open source dan bebas paten, format pilihan untuk audiofil dan koleksi musik digital)"

msgid "mime_mp3"
msgstr "Audio MP3 (Institut Fraunhofer mengembangkannya pada tahun 1993, MPEG-1 Audio Layer 3. Format kompresi lossy, file kecil dengan kualitas audio yang dapat diterima, format utama revolusi musik digital tahun 2000-an, berjasa untuk iPod dan Napster. Paten berakhir pada tahun 2017, menjadi format domain publik)"

msgid "mime_oga"
msgstr "Audio Ogg Audio (dikembangkan oleh Yayasan Xiph.Org, format audio murni dari wadah Ogg, menggunakan pengkodean Vorbis. Open source dan bebas paten, efisiensi kompresi lebih baik dari MP3, banyak digunakan dalam proyek open source)"

msgid "mime_ogg"
msgstr "Audio OGG (Yayasan Xiph.Org mengembangkannya pada tahun 2000, format Ogg Vorbis. Open source dan bebas paten, efisiensi kompresi lebih baik dari MP3, Spotify awal menggunakannya, banyak digunakan untuk efek suara dalam game)"

msgid "mime_opus"
msgstr "Audio Opus (IETF menstandarkannya pada tahun 2012, format audio terbuka dan bebas paten, menggabungkan teknologi SILK dan CELT, latensi sangat rendah, efisiensi kompresi tertinggi, format audio default untuk WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Audio WAV (Microsoft dan IBM mengembangkannya pada tahun 1991, format audio asli Windows. Pengkodean PCM, tidak terkompresi, kualitas audio lossless tetapi file sangat besar, format standar untuk pengeditan audio profesional)"

msgid "mime_wma"
msgstr "Audio WMA (Microsoft mengembangkannya pada tahun 1999, Windows Media Audio. Memiliki versi lossy/lossless, didukung secara native oleh Windows, menyebar dengan Windows Media Player. Sekarang terpinggirkan, digantikan oleh MP3/AAC)"

msgid "mime_dsf"
msgstr "Audio DSF (format Direct Stream Digital, dikembangkan oleh Sony dan Philips. Kecepatan sampel tinggi 1-bit, format audio DSD standar, versi digital dari SACD, format audio kelas atas untuk audiofil, file sangat besar)"

msgid "mime_ape"
msgstr "Audio APE (dikembangkan oleh Monkey's Audio pada tahun 2000, format kompresi lossless. Kompresi lebih tinggi dari FLAC tetapi encoding lebih lambat, masih digunakan di platform Windows dan di kalangan penggemar audio)"

msgid "mime_mid"
msgstr "Audio MIDI (Asosiasi MIDI menetapkannya pada tahun 1983, Musical Instrument Digital Interface. Format partitur, bukan rekaman, file sangat kecil, standar untuk instrumen musik elektronik, nada dering telepon, efek suara dalam game. General MIDI distandarisasi pada tahun 1991, mendefinisikan 128 instrumen)"

msgid "mime_m4a"
msgstr "Audio M4A (MPEG-4 Audio, format wadah untuk AAC. Format standar toko musik iTunes, format audio utama di ekosistem Apple, mendukung perlindungan DRM)"

msgid "mime_m3u"
msgstr "Daftar putar M3U (format daftar putar URL MP3, file teks biasa, mencatat jalur file audio. Standar dari era Winamp, digunakan untuk radio internet, streaming musik online. M3U8 adalah versi UTF-8-nya, digunakan untuk HTTP Live Streaming)"

msgid "mime_asf"
msgstr "Streaming ASF (Microsoft mengembangkannya pada tahun 1996, Advanced Systems Format. Wadah streaming Windows Media, mendukung transmisi sinkron audio dan video. Digunakan untuk siaran langsung online dan streaming video on-demand, WMA/WMV didasarkan pada wadah ASF)"

msgid "mime_avi"
msgstr "Video AVI (Microsoft merilisnya pada tahun 1992, standar video awal Windows. 'Audio Video Interleave', menyimpan audio dan video secara bergantian, adalah format video paling populer pada tahun 1990-2000, sekarang digantikan oleh MP4/MKV)"

msgid "mime_divx"
msgstr "Video DivX (Perusahaan DivX mengembangkannya pada tahun 1998, format codec video berdasarkan MPEG-4. Format utama untuk berbagi video online pada tahun 2000-an, teknologi pertama yang mengompres kualitas DVD ke ukuran CD. Karena kontroversi hak cipta, kemudian berubah menjadi encoder komersial)"

msgid "mime_mp4"
msgstr "Video MP4 (standar MPEG 2001, MPEG-4 Part 14. Format video paling umum di dunia, mendukung pengkodean H.264/H.265, format default untuk video internet, rekaman ponsel, YouTube)"

msgid "mime_m4v"
msgstr "Video M4V (format video iTunes, varian MP4. Format video di ekosistem Apple, format standar untuk film dan acara TV di iTunes Store, mendukung perlindungan hak cipta DRM)"

msgid "mime_mpeg"
msgstr "Video MPEG (organisasi MPEG menetapkannya pada tahun 1988, Moving Picture Experts Group. Meletakkan dasar standar kompresi video digital, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (video internet) memiliki pengaruh mendalam)"

msgid "mime_mkv"
msgstr "Video MKV (proyek Matroska mengembangkannya pada tahun 2002, wadah multimedia open source. Mendukung beberapa trek audio, beberapa subtitle, bab, 'alat pembungkus', format pilihan untuk berbagi film beresolusi tinggi)"

msgid "mime_mpg"
msgstr "Video MPEG (ekstensi video MPEG-1/MPEG-2, format standar untuk VCD dan DVD. Format utama untuk video pada cakram optik tahun 1990-2000, sekarang digantikan oleh H.264/H.265)"

msgid "mime_ogv"
msgstr "Video Ogg Video (dikembangkan oleh Yayasan Xiph.Org, format video dari wadah Ogg, menggunakan pengkodean Theora. Terbuka dan bebas paten, salah satu standar awal untuk video HTML5, Firefox mendukungnya secara native)"

msgid "mime_ogx"
msgstr "Wadah multimedia Ogg (dikembangkan oleh Yayasan Xiph.Org, ekstensi umum wadah Ogg, dapat berisi beberapa trek seperti audio, video, subtitle. Standar multimedia terbuka, digunakan untuk game, streaming)"

msgid "mime_rm"
msgstr "Video RealMedia (RealNetworks mengembangkannya pada tahun 1995, format RealMedia. Pelopor streaming internet pada tahun 1990-2000, format utama pemutar RealPlayer. Kekurangan: memerlukan pemutar khusus, kualitas kompresi buruk, kemudian digantikan oleh Flash/MP4)"

msgid "mime_flv"
msgstr "Video Flash (format muncul pada tahun 2002, format Flash Video. Dulu merupakan format video online utama. YouTube awal menggunakannya. Kekurangan: memerlukan plugin Flash, kinerja buruk, banyak kerentanan keamanan. Sejak 2015 situs web utama beralih ke video HTML5, sekarang usang)"

msgid "mime_f4v"
msgstr "Video F4V (format video Flash yang dikembangkan oleh Adobe, penerus FLV. Berdasarkan standar MPEG-4, mendukung pengkodean H.264. Usang bersama teknologi Flash, Adobe menghentikan dukungan pada tahun 2020)"

msgid "mime_wmv"
msgstr "Video WMV (Microsoft mengembangkannya pada tahun 1999, Windows Media Video. Didukung secara native oleh Windows, dioptimalkan untuk streaming, adalah format umum dalam video online awal, sekarang terpinggirkan)"

msgid "mime_wmf"
msgstr "Format media WMF (Windows Media Format, kerangka media Microsoft, mencakup video WMV, audio WMA, didukung secara native oleh Windows Media Player)"

msgid "mime_mov"
msgstr "Video MOV (Apple mengembangkannya pada tahun 1991, format wadah QuickTime. Format standar untuk pengeditan video profesional, mendukung beberapa codec, didukung secara native oleh Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "Video QuickTime (Apple merilisnya pada tahun 1991, format QuickTime. Standar video pada platform Mac, MOV adalah wadahnya, pemutar QuickTime dulu banyak digunakan. Apple menghentikan pengembangan versi Windows pada tahun 2016, secara bertahap menggantinya dengan MP4)"

msgid "mime_webm"
msgstr "Video WebM (Google merilisnya pada tahun 2010, format video terbuka dan bebas paten. Berdasarkan wadah Matroska, pengkodean VP8/VP9, format video standar HTML5, format default untuk pemutaran YouTube di web)"

msgid "mime_3gp"
msgstr "Video 3GP (3GPP menetapkannya pada tahun 2000, format video untuk perangkat seluler. File sangat kecil, kualitas rendah, format untuk perekaman video di ponsel awal, digunakan untuk pengiriman MMS)"

