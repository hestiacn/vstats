#------------------------------------------------------------------------------
# प्रारूप विवरण
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "पाठ फ़ाइल (1963 में ASCII मानकीकृत, बिना प्रारूप वाला सादा पाठ। स्रोत कोड, कॉन्फ़िगरेशन फ़ाइल और लॉग का आधार। Unix LF का उपयोग करता है, Windows CRLF का उपयोग करता है, आज भी कंप्यूटर का सबसे सामान्य डेटा प्रारूप)"

msgid "mime_log"
msgstr "लॉग फ़ाइल (सिस्टम डेटा, एप्लिकेशन संचालन जानकारी रिकॉर्ड करने वाली सादा पाठ फ़ाइल, समस्या निवारण, प्रदर्शन विश्लेषण, सुरक्षा ऑडिट के लिए उपयोग की जाती है। मानक प्रारूप जैसे Apache combined log, Nginx access log, syslog आदि)"

msgid "mime_page"
msgstr "HTML वेब पृष्ठ (Tim Berners-Lee ने 1989 में वर्ल्ड वाइड वेब का आविष्कार किया, 1990 में HTML/HTTP/URL तीन प्रौद्योगिकियों को परिभाषित किया, बिना पेटेंट के मुफ्त प्रदान किया। HTML5 2014 में W3C मानक बना, प्रदर्शन, मल्टीमीडिया और मुद्रण का समर्थन करता है। 2016 में ट्यूरिंग पुरस्कार प्राप्त)"

msgid "mime_khtml"
msgstr "KHTML वेब पृष्ठ इंजन (1998 में KDE 2.0 में प्रकाशित, Konqueror ब्राउज़र का रेंडरिंग इंजन। Apple ने 2001 में KHTML के आधार पर WebKit बनाया। Google ने 2008 में WebKit से Blink बनाया, जो Chrome, Edge, Safari ब्राउज़र का मूल बन गया। KHTML ओपन सोर्स समुदाय का आदर्श है जिसने आधुनिक ब्राउज़र इंजन की नींव रखी, इसकी प्रौद्योगिकी विरासत WebKit/Blink के माध्यम से जारी है)"

msgid "mime_script"
msgstr "डायनामिक स्क्रिप्ट (व्याख्यात्मक भाषा, संकलन की आवश्यकता नहीं। ASP, JSP, CGI, ColdFusion, Tcl, VBScript आदि शामिल हैं, प्रारंभिक वेब विकास, प्रणाली प्रबंधन, स्वचालित कार्यों में व्यापक रूप से उपयोग की जाती हैं। Python, Ruby, JavaScript जैसी आधुनिक स्क्रिप्ट भाषाएँ full-stack विकास की मुख्य भाषाओं के रूप में विकसित हो गई हैं)"

msgid "mime_js"
msgstr "JavaScript स्क्रिप्ट (Brendan Eich ने 1995 में Netscape में 10 दिनों में बनाई, ब्राउज़र की मूल प्रोग्रामिंग भाषा। ECMAScript 1997 में मानकीकृत हुआ। Node.js 2009 में जन्मा और इसे full-stack भाषा बना दिया। npm विश्व का सबसे बड़ा पैकेज प्रबंधक है। GitHub पर लगातार वर्षों तक सबसे लोकप्रिय प्रोग्रामिंग भाषा)"

msgid "mime_py"
msgstr "Python स्क्रिप्ट (Guido van Rossum ने 1991 में बनाई, अनिवार्य इंडेंटेशन, सरल वाक्य रचना के लिए प्रसिद्ध। वेब विकास, डेटा विज्ञान, कृत्रिम बुद्धिमत्ता, स्वचालित संचालन में व्यापक रूप से उपयोग की जाती है। TIOBE का वार्षिक प्रोग्रामिंग भाषा पुरस्कार कई बार प्राप्त)"

msgid "mime_sh"
msgstr "Shell स्क्रिप्ट (Unix 1971 में जन्मा, कमांड स्क्रिप्ट भाषा। प्रणाली प्रबंधन, स्वचालित कार्य, सेवा प्रारंभ, परिनियोजन स्क्रिप्ट के लिए उपयोग की जाती है। Linux प्रशासन के लिए आवश्यक कौशल)"

msgid "mime_rb"
msgstr "Ruby स्क्रिप्ट (Yukihiro Matsumoto ने 1995 में बनाई, डेवलपर की खुशी पर केंद्रित है। Ruby on Rails फ्रेमवर्क ने 'कॉन्फ़िगरेशन से अधिक कन्वेंशन' के विकास प्रतिमान की शुरुआत की, आधुनिक वेब फ्रेमवर्क डिजाइन को प्रभावित किया)"

msgid "mime_pl"
msgstr "Perl स्क्रिप्ट (Larry Wall ने 1987 में बनाई, व्यावहारिकता के लिए प्रसिद्ध, 'स्विस आर्मी चाकू' के रूप में जानी जाती है। CPAN आधुनिक भाषा पैकेज प्रबंधक का अग्रदूत है, पाठ प्रसंस्करण, प्रणाली प्रबंधन और CGI में गहरा प्रभाव है)"

msgid "mime_php"
msgstr "PHP डायनामिक वेब पृष्ठ (Rasmus Lerdorf ने 1995 में बनाया, विशेष रूप से वेब विकास के लिए डिज़ाइन किया गया। विश्व के 70% से अधिक वेबसाइट इसका उपयोग करते हैं, WordPress, Facebook, Wikipedia जैसे प्लेटफार्मों को चलाता है। PHP 8 ने JIT संकलन पेश किया, प्रदर्शन में उल्लेखनीय सुधार किया)"

msgid "mime_image"
msgstr "छवि फ़ाइल"

msgid "mime_document"
msgstr "दस्तावेज़ फ़ाइल"

msgid "mime_package"
msgstr "सॉफ़्टवेयर पैकेज"

msgid "mime_archive"
msgstr "Gzip संपीड़ित फ़ाइल (1992 में GNU परियोजना, DEFLATE एल्गोरिदम पर आधारित। वेब में गतिशील प्रतिक्रिया सामग्री को संपीड़ित करने के लिए उपयोग की जाती है, संपीड़न दर आमतौर पर 60-90%। 2015 के बाद कुछ स्थितियों में Brotli द्वारा प्रतिस्थापित किया गया, लेकिन सर्वर पक्ष पर अभी भी सबसे व्यापक रूप से समर्थित संपीड़न प्रारूप है)"

msgid "mime_audio"
msgstr "ऑडियो फ़ाइल"

msgid "mime_video"
msgstr "वीडियो फ़ाइल"

msgid "mime_jscript"
msgstr "JavaScript (Brendan Eich द्वारा 1995 में विकसित)"

msgid "mime_json"
msgstr "JSON डेटा (Douglas Crockford ने 2001 में प्रस्तावित किया, हल्का डेटा विनिमय प्रारूप, Web API का वास्तविक मानक)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft ने 1996 में विकसित किया, Windows स्क्रिप्ट भाषा, ASP वेब पृष्ठों और Windows प्रबंधन स्क्रिप्ट के लिए उपयोग की जाती है। PowerShell और JavaScript के प्रसार के साथ धीरे-धीरे समाप्त हो गई है)"

msgid "mime_conf"
msgstr "कॉन्फ़िगरेशन फ़ाइल (पाठ प्रारूप में सॉफ़्टवेयर कॉन्फ़िगरेशन संग्रहीत करती है, सामान्य प्रारूप: INI, JSON, YAML, TOML, XML। Linux सिस्टम कॉन्फ़िगरेशन अधिकतर /etc निर्देशिका में होती है)"

msgid "mime_css"
msgstr "CSS स्टाइल शीट (W3C ने दिसंबर 1996 में CSS1 पहला आधिकारिक मानक प्रकाशित किया, CSS2 ने 1998 में स्थिति निर्धारण और मीडिया प्रकार जोड़े, 2011 से CSS3 मॉड्यूलर ने कोनों को गोल करना, एनीमेशन, फ्लेक्सबॉक्स, ग्रिड लेआउट और प्रतिक्रियाशील डिजाइन पेश किया। HTML और JavaScript के साथ front-end की तीन मुख्य प्रौद्योगिकियों में से एक है, सभी आधुनिक ब्राउज़र (Chrome, Firefox, Safari, Edge) मूल रूप से समर्थन करते हैं, वेब पृष्ठ शैली परिभाषित करने का एकमात्र मानक है)"

msgid "mime_xsl"
msgstr "XSL स्टाइल शीट (1999 में W3C मानक, XML दस्तावेज़ रूपांतरण भाषा, XML को HTML/PDF/पाठ में बदल सकती है। JSON के प्रसार के बाद उपयोग कम हो गया)"

msgid "mime_runtime"
msgstr "निष्पादन योग्य फ़ाइल (EXE, ELF, Mach-O आदि ऑपरेटिंग सिस्टम के निष्पादन योग्य प्रारूप, मशीन कोड और लोडिंग जानकारी शामिल है)"

msgid "mime_library"
msgstr "लाइब्रेरी फ़ाइल (DLL, SO, dylib आदि गतिशील लिंक लाइब्रेरी, प्रोग्राम चलने पर लोड होने वाला साझा कोड)"

msgid "mime_swf"
msgstr "Flash एनीमेशन (Macromedia ने 1996 में विकसित किया, बाद में Adobe के स्वामित्व में। इंटरैक्टिव वेब एनीमेशन मानक, एक समय इंटरनेट पर गेम और एनीमेशन पर हावी था। कमजोरियाँ: प्लगइन पर निर्भरता, मोबाइल समर्थन की कमी, उच्च सुरक्षा जोखिम। Adobe ने 2017 में हटाने की घोषणा की, 2020 में पूर्ण रूप से समर्थन बंद कर दिया, HTML5/CSS3/JS द्वारा प्रतिस्थापित)"

msgid "mime_dtd"
msgstr "DTD (दस्तावेज़ प्रकार परिभाषा) (XML विशिष्टता, XML दस्तावेज़ संरचना परिभाषित करती है, XML की वैधता सत्यापित करने के लिए उपयोग की जाती है)"

msgid "mime_csv"
msgstr "CSV डेटा प्रारूप (अल्पविराम से अलग मान, सामान्य तालिका डेटा प्रारूप, Excel और डेटाबेस आयात निर्यात मानक)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java एप्लिकेशन लॉन्चर, 2000 के दशक में Java डेस्कटॉप एप्लिकेशन वितरण तकनीक, अब हटा दी गई है)"

msgid "mime_lit"
msgstr "Microsoft Reader ई-पुस्तक (Microsoft ने 2000 में लॉन्च किया, LIT प्रारूप, हटा दिया गया)"

msgid "mime_svg"
msgstr "SVG वेक्टर ग्राफिक्स (1999 में W3C मानक, Microsoft ने लंबे समय तक अपने VML प्रारूप को बढ़ावा देने के कारण, IE ब्राउज़र ने 2011 तक समर्थन किया, जिससे प्रसार में देरी हुई। 2015 के बाद IE हटाए जाने और उच्च रिज़ॉल्यूशन स्क्रीन के प्रसार के साथ, यह आइकन और लोगो के लिए पसंदीदा प्रारूप बन गया)"

msgid "mime_ai"
msgstr "Adobe Illustrator वेक्टर ग्राफिक्स (1987 में लॉन्च किया गया, उद्योग मानक वेक्टर ग्राफिक्स प्रारूप, मुद्रण डिजाइन, लोगो, आइकन के लिए पसंदीदा)"

msgid "mime_phshop"
msgstr "Photoshop छवि (Adobe ने 1990 में लॉन्च किया, Photoshop की मूल फ़ाइल प्रारूप PSD, छवि प्रसंस्करण उद्योग मानक)"

msgid "mime_ttf"
msgstr "TrueType फ़ॉन्ट (Apple और Microsoft ने 1989 में संयुक्त रूप से विकसित किया, वेक्टर फ़ॉन्ट प्रारूप, स्क्रीन प्रदर्शन और मुद्रण एक समान, आधुनिक ऑपरेटिंग सिस्टम की डिफ़ॉल्ट फ़ॉन्ट प्रारूप)"

msgid "mime_fon"
msgstr "WOFF2 वेब फ़ॉन्ट (W3C ने 2014 में अनुशंसित किया, Brotli संपीड़न एल्गोरिदम का उपयोग करता है, पुराने WOFF की तुलना में आकार लगभग 30% कम, TTF/OTF की तुलना में 50% से अधिक कम, वर्तमान में सभी आधुनिक ब्राउज़र समर्थन करते हैं, आधुनिक वेब फ़ॉन्ट के लिए पसंदीदा प्रारूप है, 98% से अधिक ब्राउज़र द्वारा समर्थित)"

msgid "mime_pdf"
msgstr "PDF दस्तावेज़ (Adobe ने 1993 में विकसित किया, 2008 में ISO मानक बना। क्रॉस-प्लेटफॉर्म दस्तावेज़ प्रारूप, प्रारूप एकरूपता बनाए रखता है, इलेक्ट्रॉनिक दस्तावेज़ वितरण का वैश्विक मानक है)"

msgid "mime_dotnet"
msgstr "ASP.NET डायनामिक पृष्ठ (Microsoft ने 2002 में लॉन्च किया, Windows प्लेटफॉर्म पर डायनामिक वेब पृष्ठ प्रौद्योगिकी, .NET Framework का एक भाग)"

msgid "mime_mdb"
msgstr "Access डेटाबेस (Microsoft Access डेटाबेस फ़ाइल, 1992 में लॉन्च की गई, Windows डेस्कटॉप डेटाबेस समाधान)"

msgid "mime_md"
msgstr "Markdown दस्तावेज़ (John Gruber ने 2004 में बनाया, वाक्य रचना डिजाइन reStructuredText और Setext से प्रभावित है। मुख्य डिजाइन दर्शन 'पढ़ने योग्य है तो प्रस्तुत करने योग्य है' है। मूल कार्यान्वयन Markdown.pl Perl नियमित अभिव्यक्ति का उपयोग करता है। व्युत्पन्न विशिष्टताओं में GFM (2013), CommonMark (2017), Pandoc Markdown आदि शामिल हैं। GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress जैसे पारिस्थितिकी तंत्रों को चलाता है, स्थिर वेबसाइट जनरेटर और डेवलपर दस्तावेज़ीकरण के लिए वास्तविक मानक प्रारूप बन गया है)"

msgid "mime_crystal"
msgstr "Crystal Reports रिपोर्ट प्रारूप (SAP का व्यावसायिक बुद्धिमत्ता रिपोर्ट, उद्यम रिपोर्ट मानक प्रारूप)"

msgid "mime_libreoffice"
msgstr "LibreOffice दस्तावेज़ (The Document Foundation ने 2010 में विकसित किया, OpenOffice की शाखा, ODF मानक का कार्यान्वयन, मुख्यधारा ओपन सोर्स कार्यालय सुइट)"

msgid "mime_encrypt"
msgstr "एन्क्रिप्टेड फ़ाइल (फ़ाइल देखने के लिए डिक्रिप्ट करना आवश्यक है, सामान्य एक्सटेंशन: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS ट्रैक डेटा (GPS विनिमय प्रारूप, भौगोलिक स्थिति डेटा रिकॉर्ड करता है, खेल घड़ियों और नेविगेशन उपकरणों के लिए सामान्य प्रारूप)"

msgid "mime_diskimage"
msgstr "डिस्क छवि (DMG, ISO, IMG आदि ऑप्टिकल डिस्क/डिस्क छवि फ़ाइलें, सॉफ़्टवेयर वितरण या भंडारण मीडिया बैकअप के लिए उपयोग की जाती हैं)"

msgid "mime_vm"
msgstr "वर्चुअल मशीन छवि (VMDK, VDI, VHDX, OVA आदि वर्चुअल मशीन डिस्क फ़ाइलें, VMware, VirtualBox, Hyper-V जैसे वर्चुअलाइजेशन प्लेटफार्मों के लिए प्रारूप)"

msgid "mime_torrent"
msgstr "BitTorrent बीज फ़ाइल (Bram Cohen ने 2001 में आविष्कार किया, P2P डाउनलोड सूचकांक फ़ाइल, फ़ाइल मेटाडेटा और ट्रैकर जानकारी शामिल है)"

msgid "mime_gis"
msgstr "GIS भौगोलिक सूचना प्रणाली डेटा (Shapefile, GeoJSON आदि भौगोलिक स्थान डेटा प्रारूप, मानचित्र और स्थानिक विश्लेषण के लिए उपयोग किए जाते हैं)"

msgid "mime_ebook"
msgstr "ई-पुस्तक (EPUB, MOBI, AZW आदि ई-पुस्तक प्रारूप। EPUB अंतर्राष्ट्रीय मानक है, MOBI/AZW Amazon Kindle के लिए प्रारूप है)"

msgid "mime_avif"
msgstr "AVIF छवि (Alliance for Open Media ने 2019 में लॉन्च किया, AV1 कोडेक पर आधारित, WebP से 50% अधिक संपीड़न दर, नई पीढ़ी का वेब छवि मानक)"

msgid "mime_markdown"
msgstr "Markdown दस्तावेज़ (John Gruber ने 2004 में डिज़ाइन किया, हल्की मार्कअप भाषा, GitHub README, तकनीकी दस्तावेज़ीकरण, फोरम पोस्ट के लिए सामान्य प्रारूप)"

msgid "mime_yaml"
msgstr "YAML कॉन्फ़िगरेशन (Clark Evans ने 2001 में डिज़ाइन किया, मानव-पठनीय डेटा क्रमांकन प्रारूप, Kubernetes, Ansible, Docker Compose के लिए कॉन्फ़िगरेशन फ़ाइल मानक)"

msgid "mime_toml"
msgstr "TOML कॉन्फ़िगरेशन (Tom Preston-Werner ने 2013 में डिज़ाइन किया, 'टॉम की स्पष्ट न्यूनतम भाषा', Rust/Cargo, Python/pip, Go जैसे आधुनिक उपकरणों के लिए कॉन्फ़िगरेशन फ़ाइल प्रारूप)"

msgid "mime_vue"
msgstr "Vue कंपोनेंट फ़ाइल (2014 में इवान यू द्वारा प्रस्तुत, एक प्रोग्रेसिव JavaScript फ्रेमवर्क। सिंगल-फ़ाइल कंपोनेंट्स (SFC) के माध्यम से यह HTML, CSS और JS को पूरी तरह से जोड़ता है, जिससे विकास दक्षता में बहुत वृद्धि होती है। यह दुनिया के सबसे लोकप्रिय फ्रंटएंड फ्रेमवर्क में से एक है। साथ ही, VitePress जैसे आधुनिक स्टैटिक साइट जनरेटर के मूल के रूप में, इसका व्यापक रूप से इंटरैक्टिव तकनीकी दस्तावेज़ीकरण और ब्लॉग को चलाने के लिए उपयोग किया जाता है।)"

msgid "mime_wasm"
msgstr "WebAssembly मॉड्यूल (2017 में W3C मानक, ब्राउज़र में उच्च प्रदर्शन निष्पादन प्रारूप, C/C++/Rust/R को लक्ष्य के रूप में संकलित किया जा सकता है, प्रदर्शन मूल के करीब)"

msgid "mime_jsx"
msgstr "React JSX घटक (Facebook ने 2013 में JavaScript XML लॉन्च किया, React फ्रेमवर्क का घटक वाक्य रचना, HTML को JavaScript में लिखने का अभिनव प्रतिमान)"

msgid "mime_tsx"
msgstr "TypeScript TSX घटक (Microsoft ने 2012 में विकसित किया, TypeScript + JSX, React प्रकार-सुरक्षित विकास के लिए मानक लेखन विधि)"

msgid "mime_heif"
msgstr "HEIF छवि (2015 में MPEG मानक, उच्च दक्षता छवि फ़ाइल प्रारूप, Apple पारिस्थितिकी तंत्र में व्यापक रूप से उपयोग किया जाता है)"

msgid "mime_heic"
msgstr "HEIC छवि (Apple का HEIF कार्यान्वयन, iPhone का डिफ़ॉल्ट फ़ोटो प्रारूप, iOS/macOS पर मूल रूप से समर्थित)"

msgid "mime_gltf"
msgstr "GLTF 3D मॉडल (GL संचरण प्रारूप, '3D का JPEG', Khronos Group ने 2015 में प्रकाशित किया, Web 3D मानक प्रारूप)"

msgid "mime_glb"
msgstr "GLB बाइनरी 3D मॉडल (GLTF का बाइनरी संस्करण, एकल फ़ाइल में सभी संसाधन शामिल हैं, 3D दृश्य वितरण के लिए उपयोग किया जाता है)"

msgid "mime_gls"
msgstr "GLOSSARY शब्दावली (शब्द परिभाषा फ़ाइल, दस्तावेज़ प्रणाली में शब्द प्रबंधन के लिए उपयोग की जाती है)"

msgid "mime_cbz"
msgstr "CBZ कॉमिक पुस्तक (ZIP संपीड़ित कॉमिक छवियाँ, कॉमिक संग्रह के लिए सामान्य प्रारूप)"

msgid "mime_cbr"
msgstr "CBR कॉमिक पुस्तक (RAR संपीड़ित कॉमिक छवियाँ, कॉमिक संग्रह के लिए सामान्य प्रारूप)"

msgid "mime_fb2"
msgstr "FB2 ई-पुस्तक (FictionBook 2.0, रूसी ई-पुस्तक प्रारूप, XML संरचना, ओपन सोर्स पाठकों द्वारा व्यापक रूप से समर्थित)"

msgid "mime_kepub"
msgstr "KEPUB ई-पुस्तक (Kobo के लिए विशेष EPUB प्रारूप, Kobo ई-पुस्तक रीडर के लिए अनुकूलित प्रारूप)"

msgid "mime_m4b"
msgstr "M4B ऑडियो पुस्तक (MPEG-4 ऑडियो पुस्तक प्रारूप, बुकमार्क समर्थन करता है, iTunes ऑडियो पुस्तक प्रारूप)"

msgid "mime_kfx"
msgstr "Kindle KFX प्रारूप (Amazon ने 2015 में लॉन्च किया, Kindle के लिए विशेष ई-पुस्तक प्रारूप, उन्नत लेआउट और तीव्र पृष्ठ पलटने का समर्थन करता है)"

msgid "mime_chm"
msgstr "CHM सहायता फ़ाइल (Microsoft ने 1997 में लॉन्च किया, संकलित HTML सहायता प्रारूप, Windows सॉफ़्टवेयर सहायता दस्तावेज़ीकरण मानक)"

msgid "mime_mht"
msgstr "MHT वेब पुरालेख (Microsoft ने 1999 में लॉन्च किया, एकल फ़ाइल वेब पृष्ठ प्रारूप, IE ब्राउज़र का वेब पृष्ठ सहेजने का प्रारूप)"

msgid "mime_wml"
msgstr "WML वायरलेस मार्कअप भाषा (1999 में WAP मानक, प्रारंभिक फीचर फोन के वेब पृष्ठ फ़ाइलों के लिए उपयोग किया जाता था, हटा दिया गया)"

msgid "mime_xhtml"
msgstr "XHTML वेब पृष्ठ (2000 में W3C मानक, HTML का XML संस्करण, अधिक सख्त वाक्य रचना। W3C ने 2009 में रखरखाव बंद कर दिया, ध्यान HTML5 पर केंद्रित किया)"

msgid "mime_xml"
msgstr "XML दस्तावेज़ (1998 में W3C मानक, विस्तार योग्य मार्कअप भाषा, वेब सेवाओं, कॉन्फ़िगरेशन फ़ाइलों, डेटा विनिमय के लिए मूलभूत प्रारूप)"

msgid "mime_sgml"
msgstr "SGML दस्तावेज़ (1986 में ISO मानक, HTML का अग्रदूत, मानक सामान्य मार्कअप भाषा, XML और HTML दोनों SGML से व्युत्पन्न हैं)"

msgid "mime_apng"
msgstr "APNG एनीमेशन (Mozilla ने 2004 में विकसित किया, PNG का एनीमेशन एक्सटेंशन, GIF का आधुनिक विकल्प, सही रंग और पारदर्शिता समर्थन करता है)"

msgid "mime_bmp"
msgstr "BMP बिटमैप (Windows बिटमैप प्रारूप, Windows 1.0 से मूल रूप से समर्थित। असम्पीडित, फ़ाइल का आकार बड़ा, लेकिन सरल संरचना और अतिरिक्त कोडेक्स की आवश्यकता न होने के कारण, यह अभी भी Windows 11 के स्निपिंग टूल, पेंट प्रोग्राम, EXE/MSI इंस्टॉलेशन पैकेज में आइकन संसाधनों, कर्सर फ़ाइलों और कुछ पुराने ड्राइवरों में उपयोग किया जाता है। समान छवि गुणवत्ता पर, फ़ाइल का आकार PNG से लगभग 3-10 गुना बड़ा होता है। अधिकांश मामलों में इसे PNG/JPEG द्वारा प्रतिस्थापित कर दिया गया है, लेकिन Windows पारिस्थितिकी तंत्र अभी भी व्यापक संगतता बनाए रखता है)"

msgid "mime_cdr"
msgstr "CDR वेक्टर ग्राफिक्स (CorelDRAW के लिए विशेष प्रारूप, कनाडा की Corel कंपनी, वेक्टर ग्राफिक्स डिजाइन सॉफ़्टवेयर)"

msgid "mime_gif"
msgstr "GIF छवि (CompuServe ने 1987 में विकसित की, 256 रंग एनिमेटेड छवि प्रारूप। कमजोरियाँ: कम रंग, खराब छवि गुणवत्ता, पारदर्शिता समर्थन नहीं, बड़ी फ़ाइल, कम फ्रेम दर। APNG, WebP जैसे आधुनिक एनिमेटेड छवि प्रारूपों द्वारा प्रतिस्थापित)"

msgid "mime_ico"
msgstr "ICO आइकन (Windows आइकन फ़ाइल प्रारूप, बहु-रिज़ॉल्यूशन समर्थन करता है, वेबसाइट favicon के लिए मानक प्रारूप)"

msgid "mime_jpeg"
msgstr "JPEG छवि (1992 में ISO मानक, फ़ोटो के लिए हानिपूर्ण संपीड़न प्रारूप, इंटरनेट पर फ़ोटो का वास्तविक मानक)"

msgid "mime_jpg"
msgstr "JPEG छवि (1992 में ISO मानक, फ़ोटो के लिए हानिपूर्ण संपीड़न प्रारूप, इंटरनेट पर फ़ोटो का वास्तविक मानक)"

msgid "mime_png"
msgstr "PNG छवि (W3C ने 1996 में अनुशंसित की, सही रंग और पारदर्शिता समर्थन करती है, GIF का स्थिर विकल्प, इंटरनेट पर हानिरहित छवि मानक)"

msgid "mime_ps"
msgstr "PostScript पृष्ठ विवरण फ़ाइल (Adobe ने 1985 में लॉन्च की, पृष्ठ विवरण भाषा, PDF का अग्रदूत, मुद्रण और प्रकाशन के लिए उपयोग की जाती है)"

msgid "mime_psb"
msgstr "PSB बड़ा दस्तावेज़ (Adobe Photoshop का अति बड़ी छवि प्रारूप, 2 GB या 30000 पिक्सेल से बड़ी विशाल छवियों का समर्थन करता है)"

msgid "mime_psd"
msgstr "PSD छवि (Adobe Photoshop की मूल फ़ाइल, परतों, चैनलों, पथों का समर्थन करती है, छवि प्रसंस्करण उद्योग मानक प्रारूप)"

msgid "mime_webp"
msgstr "WebP छवि (Google ने 2010 में विकसित की, वेब छवि प्रारूप, हानिपूर्ण/हानिरहित संपीड़न और एनीमेशन समर्थन करता है, PNG से 25-35% और JPEG से 25% अधिक संपीड़न दर)"

msgid "mime_woff"
msgstr "WOFF वेब फ़ॉन्ट (2009 में बनाया गया, 2018 में W3C मानक। TrueType/OpenType पर आधारित संपीड़ित, वेब फ़ॉन्ट लोडिंग अनुकूलन, आधुनिक वेबसाइट आइकन फ़ॉन्ट के लिए मानक प्रारूप)"

msgid "mime_7z"
msgstr "7z संपीड़ित फ़ाइल (Igor Pavlov ने 1999 में विकसित की, 7-Zip प्रोग्राम का विशेष प्रारूप। LZMA एल्गोरिदम, उच्च संपीड़न दर, ओपन सोर्स और मुफ्त। समान संपीड़न दर पर 7z प्रारूप आमतौर पर ZIP से 30-50% छोटा होता है, ओपन सोर्स समुदाय और सॉफ़्टवेयर वितरण के लिए सामान्य प्रारूप है)"

msgid "mime_ace"
msgstr "ACE संपीड़ित फ़ाइल (1990 के दशक में विकसित, WinACE प्रोग्राम प्रारूप। एक समय RAR के साथ प्रतिस्पर्धा करता था, संपीड़न दर काफी अच्छी थी। 2007 में विकास बंद हो गया, अब 7z/RAR द्वारा प्रतिस्थापित, कम उपयोग किया जाता है)"

msgid "mime_bz2"
msgstr "BZIP2 संपीड़ित फ़ाइल (Julian Seward ने 1996 में विकसित की, ब्लॉक क्रमबद्ध संपीड़न एल्गोरिदम। GZIP से 15-20% अधिक संपीड़न दर लेकिन धीमी। Linux kernel स्रोत कोड, ओपन सोर्स सॉफ़्टवेयर पैकेज के लिए सामान्य प्रारूप, एक्सटेंशन .bz2)"

msgid "mime_cab"
msgstr "CAB संपीड़ित फ़ाइल (Microsoft ने 1995 में विकसित की, Cabinet प्रारूप। Windows स्थापना पैकेज प्रारूप, ड्राइवरों, सिस्टम फ़ाइल वितरण के लिए उपयोग किया जाता है। Windows Installer (MSI) आंतरिक रूप से फ़ाइलों को संग्रहीत करने के लिए CAB का उपयोग करता है)"

msgid "mime_dmg"
msgstr "DMG डिस्क छवि (Apple ने 1980 के दशक में लॉन्च की, Disk Image प्रारूप। macOS सॉफ़्टवेयर वितरण मानक प्रारूप, वर्चुअल डिस्क के रूप में माउंट करने के लिए डबल-क्लिक करें, एप्लिकेशन स्थापित करने के लिए खींचें और छोड़ें। संपीड़न और एन्क्रिप्शन समर्थन करता है, Mac सॉफ़्टवेयर डाउनलोड के लिए मुख्य प्रारूप है)"

msgid "mime_emz"
msgstr "EMZ संपीड़ित छवि (Windows संपीड़ित संवर्धित मेटाफ़ाइल, EMF का संपीड़ित संस्करण। Office दस्तावेज़ों में वेक्टर ग्राफिक्स भंडारण प्रारूप, मूलतः GZIP संपीड़ित EMF फ़ाइल है)"

msgid "mime_gz"
msgstr "GZIP संपीड़ित फ़ाइल (Jean-loup Gailly और Mark Adler ने 1992 में विकसित की, GNU परियोजना। Unix/Linux की मानक संपीड़न उपकरण, HTTP संचरण संपीड़न के लिए सामान्य प्रारूप। एक्सटेंशन .gz, अक्सर TAR के साथ संयोजन में उपयोग किया जाता है)"

msgid "mime_jar"
msgstr "JAR संपीड़ित फ़ाइल (Sun Microsystems ने 1997 में लॉन्च की, Java ARchive प्रारूप। मूलतः ZIP फ़ाइल है, Java पुस्तकालयों और एप्लिकेशन को पैकेज करने के लिए उपयोग की जाती है। Maven, Gradle जैसे Java पारिस्थितिकी तंत्र का मुख्य प्रारूप, Android भी JAR का उपयोग करता है)"

msgid "mime_lzma"
msgstr "LZMA संपीड़ित फ़ाइल (Igor Pavlov ने 1998 में विकसित की, Lempel-Ziv-Markov chain एल्गोरिदम। 7z प्रारूप की मुख्य संपीड़न एल्गोरिदम, उच्च संपीड़न दर, विघटन गति तेज। फ़र्मवेयर और एम्बेडेड सिस्टम सॉफ़्टवेयर वितरण के लिए उपयोग की जाती है)"

msgid "mime_rar"
msgstr "RAR संपीड़ित फ़ाइल (Eugene Roshal ने 1993 में विकसित की, Roshal ARchive प्रारूप। उच्च संपीड़न दर, वॉल्यूम विभाजन और पुनर्प्राप्ति रिकॉर्ड समर्थन करता है। WinRAR प्रोग्राम प्रारूप, संपीड़न दर ZIP से बेहतर लेकिन भुगतान सॉफ़्टवेयर की आवश्यकता है, unrar जैसे ओपन सोर्स उपकरण विघटन कर सकते हैं)"

msgid "mime_tar"
msgstr "TAR संग्रह फ़ाइल (Unix V7 ने 1979 में पेश की, Tape ARchive प्रारूप। टेप संग्रह प्रारूप, संपीड़ित नहीं करता केवल पैकेज करता है, अक्सर GZIP/BZIP2/XZ के साथ संयोजन में उपयोग किया जाता है। Linux पैकेज स्रोत कोड, Docker छवि परत भंडारण TAR प्रारूप का उपयोग करते हैं)"

msgid "mime_tgz"
msgstr "TGZ संपीड़ित फ़ाइल (TAR + GZIP संयोजन प्रारूप, एक्सटेंशन .tgz या .tar.gz। Unix/Linux सॉफ़्टवेयर पैकेज के लिए सबसे सामान्य वितरण प्रारूप, स्रोत कोड पैकेज, बाइनरी पैकेज, व्यापक रूप से उपयोग किया जाता है, 'विघटित करें और उपयोग करें' का प्रतिनिधि)"

msgid "mime_tbz2"
msgstr "TBZ2 संपीड़ित फ़ाइल (TAR + BZIP2 संयोजन प्रारूप, एक्सटेंशन .tbz2 या .tar.bz2। TGZ से 15-20% अधिक संपीड़न दर, बड़ी फ़ाइलों के वितरण के लिए उपयुक्त, Linux kernel ने लंबे समय से इस प्रारूप का उपयोग किया है)"

msgid "mime_xz"
msgstr "XZ संपीड़ित फ़ाइल (2009 में लॉन्च की गई, LZMA2 एल्गोरिदम पर आधारित। अत्यधिक उच्च संपीड़न दर, GZIP से 30-50% अधिक, विघटन गति अपेक्षाकृत तेज। Linux kernel, पैकेज प्रबंधक (जैसे Debian के .deb के अंदर) व्यापक रूप से उपयोग करते हैं, वर्तमान Linux पारिस्थितिकी तंत्र में अनुशंसित प्रारूप है)"

msgid "mime_z"
msgstr "Z संपीड़ित फ़ाइल (1985 में Unix compress कमांड प्रारूप, LZW एल्गोरिदम। प्रारंभिक Unix संपीड़न प्रारूप, GZIP द्वारा प्रतिस्थापित किया गया। एक्सटेंशन .Z, आधुनिक प्रणालियों में कम उपयोग किया जाता है)"

msgid "mime_zip"
msgstr "ZIP संपीड़ित फ़ाइल (Phil Katz ने 1989 में विकसित की, PKZIP प्रारूप। Windows पर मूल रूप से समर्थित, इंटरनेट पर सबसे सामान्य संपीड़न प्रारूप। कई फ़ाइलों, निर्देशिका संरचना का समर्थन करता है, संपीड़न एल्गोरिदम चुन सकते हैं। Java का JAR, Android का APK, Office दस्तावेज़ों का DOCX/XLSX सभी ZIP प्रारूप पर आधारित हैं)"

msgid "mime_zst"
msgstr "Zstandard संपीड़ित फ़ाइल (Facebook ने 2015 में विकसित की, Yann Collet द्वारा डिज़ाइन की गई। उच्च-गति संपीड़न एल्गोरिदम, संपीड़न दर LZMA के करीब, गति GZIP से बहुत अधिक। Linux kernel 5.9+ समर्थन करता है, Arch Linux pacman, Debian APT धीरे-धीरे अपना रहे हैं, नई पीढ़ी का संपीड़न मानक है)"

msgid "mime_lz4"
msgstr "LZ4 संपीड़ित फ़ाइल (Yann Collet ने 2011 में विकसित की, अत्यंत तीव्र संपीड़न एल्गोरिदम। संपीड़न गति GZIP से 10 गुना से अधिक तेज, वास्तविक समय संपीड़न परिदृश्यों के लिए उपयुक्त। Linux kernel, OpenZFS, Hadoop व्यापक रूप से उपयोग करते हैं, गति-प्राथमिकता परिदृश्यों के लिए पहली पसंद है)"

msgid "mime_lzo"
msgstr "LZO संपीड़ित फ़ाइल (Markus Oberhumer ने 1996 में विकसित की, Lempel-Ziv-Oberhumer एल्गोरिदम। विघटन गति अत्यंत तीव्र, संपीड़न दर सामान्य। Linux kernel Squashfs, OpenWrt फ़र्मवेयर उपयोग करते हैं, एम्बेडेड सिस्टम के लिए उपयुक्त)"

msgid "mime_msi"
msgstr "MSI स्थापना पैकेज (Microsoft ने 1999 में लॉन्च किया, Windows Installer पैकेज प्रारूप। Windows एप्लिकेशन स्थापना मानक प्रारूप, लेन-देन रोलबैक, घटक प्रबंधन, मूक स्थापना समर्थन करता है। उद्यम-स्तरीय सॉफ़्टवेयर वितरण के लिए पहली पसंद प्रारूप, आज भी Windows सॉफ़्टवेयर स्थापना के लिए मुख्यधारा है)"

msgid "mime_pkg"
msgstr "PKG स्थापना पैकेज (macOS एप्लिकेशन स्थापना पैकेज प्रारूप, Apple के इंस्टॉलर प्रौद्योगिकी पर आधारित। macOS सॉफ़्टवेयर वितरण मानक प्रारूप, घटक चयन, स्थापना स्क्रिप्ट, अनइंस्टॉल फ़ंक्शन समर्थन करता है। .pkg फ़ाइल पर डबल-क्लिक करके स्थापित करें, Mac App Store के बाहर सॉफ़्टवेयर के लिए सामान्य वितरण विधि)"

msgid "mime_apk"
msgstr "APK Android एप्लिकेशन पैकेज (2008 में Google द्वारा पेश किया गया, Android सिस्टम के लिए पारंपरिक एप्लिकेशन इंस्टॉलेशन प्रारूप। APK मूल रूप से एक ZIP पैकेज होता है जिसमें कोड, संसाधन और मैनिफेस्ट फ़ाइल होती है। 2021 से, Google Play नई एप्लिकेशन को AAB प्रारूप का उपयोग करने की आवश्यकता रखता है, लेकिन APK अभी भी डीबगिंग, तृतीय-पक्ष स्टोर और साइड-लोडिंग के लिए उपयोग किया जाता है)"

msgid "mime_ipa"
msgstr "IPA iOS एप्लिकेशन पैकेज (iOS App Store Package, iOS/iPadOS एप्लिकेशन के लिए इंस्टॉलेशन प्रारूप। 2008 में iPhone SDK के साथ पेश किया गया। App Store के माध्यम से वितरित किया जाना चाहिए या एंटरप्राइज़ प्रमाणपत्र के साथ हस्ताक्षरित होना चाहिए। इसमें निष्पादन योग्य फ़ाइल, संसाधन, Info.plist और हस्ताक्षर जानकारी होती है)"

msgid "mime_hap"
msgstr "HAP HarmonyOS एप्लिकेशन पैकेज (HarmonyOS Ability Package, HarmonyOS एप्लिकेशन की मूल इकाई। 2020 में HarmonyOS 2.0 के साथ पेश किया गया। दो प्रकारों का समर्थन करता है: entry और feature, Huawei फोन, टैबलेट, स्मार्टवॉच और अन्य HarmonyOS उपकरणों के लिए वितरण प्रारूप)"

msgid "mime_har"
msgstr "HAR HarmonyOS स्थिर साझा लाइब्रेरी (HarmonyOS Archive, HarmonyOS की स्थिर साझा लाइब्रेरी, कई HAP पैकेजों द्वारा साझा की जा सकती है, घटक-आधारित विकास और मॉड्यूल पुनः उपयोग के लिए उपयोग की जाती है)"

msgid "mime_aab"
msgstr "Android App Bundle (Google ने 2018 में लॉन्च किया, 2021 से Google Play पर नए एप्लिकेशन के लिए इस प्रारूप का उपयोग अनिवार्य कर दिया। AAB वितरण प्रारूप है, Google Play डिवाइस कॉन्फ़िगरेशन (CPU आर्किटेक्चर, स्क्रीन घनत्व, भाषा) के अनुसार अनुकूलित APK उत्पन्न करता है, पैकेज आकार औसतन 35% कम करता है। डेवलपर AAB अपलोड करते हैं, उपयोगकर्ता APK डाउनलोड करते हैं)"

msgid "mime_xapk"
msgstr "XAPK एप्लिकेशन पैकेज (तृतीय-पक्ष Android एप्लिकेशन एक्सटेंशन पैकेज, APK + OBB डेटा फ़ाइलें शामिल हैं। बड़े गेम और जटिल एप्लिकेशन के लिए उपयोग किया जाता है, एकल-फ़ाइल APK की 100MB सीमा को हल करता है। APKPure, APKMirror जैसे तृतीय-पक्ष एप्लिकेशन स्टोर में आमतौर पर पाया जाता है, Google का आधिकारिक प्रारूप नहीं है)"

msgid "mime_appx"
msgstr "Windows एप्लिकेशन पैकेज (Microsoft ने 2012 में लॉन्च किया, Windows 8/10/11 एप्लिकेशन स्थापना प्रारूप। UWP एप्लिकेशन और डेस्कटॉप एप्लिकेशन रूपांतरण समर्थन करता है, Microsoft Store के माध्यम से वितरित किया जाता है। 2024 में Microsoft ने MSIX को उत्तराधिकारी प्रारूप के रूप में लॉन्च किया, धीरे-धीरे APPX को प्रतिस्थापित कर रहा है)"

msgid "mime_msix"
msgstr "MSIX एप्लिकेशन पैकेज (Microsoft ने 2018 में लॉन्च किया, Windows नई पीढ़ी एप्लिकेशन पैकेजिंग प्रारूप। APPX और MSI के लाभों को जोड़ता है, सभी Windows एप्लिकेशन प्रकारों का समर्थन करता है, Microsoft Store या साइड-लोड के माध्यम से वितरित किया जा सकता है, Windows 11 के लिए अनुशंसित प्रारूप)"

msgid "mime_appimage"
msgstr "AppImage एप्लिकेशन पैकेज (2004 में लॉन्च किया गया, Linux स्थापना-रहित एप्लिकेशन प्रारूप। 'एक एप्लिकेशन एक फ़ाइल', बिना स्थापना के सीधे चलता है, अधिकांश Linux वितरणों का समर्थन करता है, डेवलपर्स के लिए Linux सॉफ़्टवेयर वितरण की सामान्य विधि है)"

msgid "mime_flatpak"
msgstr "Flatpak एप्लिकेशन पैकेज (2015 में लॉन्च किया गया, Linux सैंडबॉक्स एप्लिकेशन प्रारूप। वितरणों के पार चलता है, होस्ट सिस्टम से अलग, Fedora, Red Hat द्वारा नेतृत्व विकसित, GNOME सॉफ़्टवेयर केंद्र का डिफ़ॉल्ट प्रारूप है)"

msgid "mime_snap"
msgstr "Snap एप्लिकेशन पैकेज (Canonical ने 2014 में लॉन्च किया, Ubuntu मूल कंपनी द्वारा विकसित, Linux सामान्य एप्लिकेशन प्रारूप। स्वचालित अद्यतन, सैंडबॉक्स अलगाव, 40+ Linux वितरणों का समर्थन करता है, Ubuntu सॉफ़्टवेयर केंद्र का डिफ़ॉल्ट प्रारूप है)"

msgid "mime_deb"
msgstr "Debian सॉफ़्टवेयर पैकेज (Debian Project ने 1993 में लॉन्च किया, Debian/Ubuntu और उनके व्युत्पन्न संस्करणों के लिए मानक स्थापना प्रारूप। dpkg द्वारा प्रबंधित, APT इसका पैकेज प्रबंधक फ्रंट-एंड है, Linux पारिस्थितिकी तंत्र में सबसे परिपक्व पैकेज प्रारूपों में से एक है, आज भी Debian परिवार में मुख्यधारा है)"

msgid "mime_rpm"
msgstr "RPM सॉफ़्टवेयर पैकेज (Red Hat ने 1997 में लॉन्च किया, Red Hat/Fedora/CentOS/SUSE जैसे वितरणों के लिए मानक प्रारूप। RPM का पूर्ण रूप 'Red Hat Package Manager' है, DEB के साथ Linux के दो प्रमुख पैकेज प्रारूपों में से एक है, आज भी RHEL परिवार में मुख्यधारा है)"

msgid "mime_pacman"
msgstr "Arch सॉफ़्टवेयर पैकेज (Arch Linux ने 2002 में लॉन्च किया, pacman पैकेज प्रबंधक द्वारा उपयोग किया जाने वाला .pkg.tar.zst प्रारूप। Arch Linux रोलिंग रिलीज़ का मूल है, सरलता और KISS सिद्धांत के लिए प्रसिद्ध, AUR (Arch उपयोगकर्ता भंडार) इसकी विशेषता है)"

msgid "mime_exe"
msgstr "EXE निष्पादन योग्य फ़ाइल (Windows निष्पादन योग्य प्रोग्राम प्रारूप, 'Executable' का संक्षिप्त रूप। Windows ऑपरेटिंग सिस्टम का मूल निष्पादन प्रारूप, PE संरचना शामिल है। MS-DOS के MZ प्रारूप से विकसित, 1993 में Windows NT ने PE (पोर्टेबल निष्पादन योग्य) प्रारूप पेश किया और आज तक उपयोग किया जाता है। सॉफ़्टवेयर स्थापना पैकेज, एप्लिकेशन, सिस्टम उपकरण सभी इस प्रारूप का उपयोग करते हैं। उपयोगकर्ता डबल-क्लिक करके चलाता है, विश्व में सबसे व्यापक रूप से उपयोग किया जाने वाला निष्पादन योग्य प्रारूप है)"

msgid "mime_dll"
msgstr "DLL गतिशील लिंक लाइब्रेरी (Microsoft ने 1993 में लॉन्च की, Dynamic Link Library। Windows साझा कोड लाइब्रेरी, प्रोग्राम चलने पर गतिशील रूप से लोड होती है, मेमोरी और डिस्क स्थान बचाती है। सिस्टम घटक, एप्लिकेशन प्लगइन, ड्राइवर सभी DLL प्रारूप का उपयोग करते हैं। Windows API का मुख्य कार्यान्वयन विधि, DLL Hell समस्या .NET युग में कम हो गई है)"

msgid "mime_com"
msgstr "COM निष्पादन योग्य फ़ाइल (MS-DOS युग का निष्पादन योग्य प्रारूप, 'Command' का संक्षिप्त रूप। फ़ाइल संरचना सरल, 64KB सीमा, Windows 3.x से पहले का मुख्य प्रारूप। हटा दिया गया, आधुनिक Windows EXE प्रारूप का उपयोग करता है, COM एक्सटेंशन अभी भी कुछ घटक फ़ाइलों के लिए उपयोग किया जाता है)"

msgid "mime_aac"
msgstr "AAC ऑडियो (1997 में MPEG मानक, Advanced Audio Coding। MP3 का उत्तराधिकारी, समान बिट दर पर MP3 से बेहतर ऑडियो गुणवत्ता, YouTube, iTunes, Nintendo Switch का डिफ़ॉल्ट ऑडियो प्रारूप)"

msgid "mime_alac"
msgstr "ALAC ऑडियो (Apple ने 2004 में विकसित किया, Apple Lossless Audio Codec। Apple का हानिरहित प्रारूप, 2011 में ओपन सोर्स बना, iTunes और Apple Music में हानिरहित ऑडियो के लिए डिफ़ॉल्ट प्रारूप)"

msgid "mime_flac"
msgstr "FLAC ऑडियो (Xiph.Org Foundation ने 2001 में विकसित किया, Free Lossless Audio Codec। हानिरहित संपीड़न, ऑडियो गुणवत्ता CD के समान, फ़ाइल आकार मूल WAV का लगभग आधा। ओपन सोर्स और पेटेंट-मुक्त, ऑडियो उत्साही और डिजिटल संगीत संग्रह के लिए पहली पसंद प्रारूप)"

msgid "mime_mp3"
msgstr "MP3 ऑडियो (Fraunhofer Institute ने 1993 में विकसित किया, MPEG-1 Audio Layer 3। हानिपूर्ण संपीड़न प्रारूप, छोटी फ़ाइल लेकिन स्वीकार्य ऑडियो गुणवत्ता, 2000 के दशक की डिजिटल संगीत क्रांति का मुख्य प्रारूप, iPod और Napster का योगदानकर्ता। पेटेंट 2017 में समाप्त हो गया, सार्वजनिक डोमेन प्रारूप बन गया)"

msgid "mime_oga"
msgstr "Ogg Audio ऑडियो (Xiph.Org Foundation द्वारा विकसित, Ogg कंटेनर का शुद्ध ऑडियो प्रारूप, Vorbis कोडेक का उपयोग करता है। ओपन सोर्स और पेटेंट-मुक्त, संपीड़न दक्षता MP3 से बेहतर, ओपन सोर्स परियोजनाओं में व्यापक रूप से उपयोग किया जाता है)"

msgid "mime_ogg"
msgstr "OGG ऑडियो (Xiph.Org Foundation ने 2000 में विकसित किया, Ogg Vorbis प्रारूप। ओपन सोर्स और पेटेंट-मुक्त, संपीड़न दक्षता MP3 से बेहतर, प्रारंभिक Spotify ने इसका उपयोग किया, खेल ऑडियो प्रभावों में व्यापक रूप से उपयोग किया जाता है)"

msgid "mime_opus"
msgstr "Opus ऑडियो (IETF ने 2012 में मानकीकृत किया, ओपन सोर्स और पेटेंट-मुक्त ऑडियो प्रारूप, SILK और CELT प्रौद्योगिकियों का संयोजन, बहुत कम विलंबता, उच्चतम संपीड़न दक्षता, WebRTC, WhatsApp, Discord का डिफ़ॉल्ट ऑडियो प्रारूप)"

msgid "mime_wav"
msgstr "WAV ऑडियो (Microsoft और IBM ने 1991 में विकसित किया, Windows का मूल ऑडियो प्रारूप। PCM एन्कोडिंग, संपीड़ित नहीं, हानिरहित ऑडियो गुणवत्ता लेकिन फ़ाइल बहुत बड़ी, पेशेवर ऑडियो संपादन के लिए मानक प्रारूप)"

msgid "mime_wma"
msgstr "WMA ऑडियो (Microsoft ने 1999 में विकसित किया, Windows Media Audio। हानिपूर्ण/हानिरहित दोनों संस्करण हैं, Windows पर मूल रूप से समर्थित, Windows Media Player के साथ फैला। अब सीमांत हो गया है, MP3/AAC द्वारा प्रतिस्थापित)"

msgid "mime_dsf"
msgstr "DSF ऑडियो (Direct Stream Digital प्रारूप, Sony और Philips द्वारा विकसित। 1-बिट उच्च नमूना दर, DSD ऑडियो मानक प्रारूप, SACD का डिजिटल संस्करण, ऑडियो उत्साही के लिए उच्च-स्तरीय ऑडियो प्रारूप, फ़ाइल बहुत बड़ी)"

msgid "mime_ape"
msgstr "APE ऑडियो (2000 में Monkey's Audio द्वारा विकसित, दोषरहित संपीड़न प्रारूप। FLAC से उच्च संपीड़न लेकिन धीमी एन्कोडिंग, अभी भी Windows प्लेटफॉर्म और ऑडियो उत्साही लोगों के बीच उपयोग किया जाता है)"

msgid "mime_mid"
msgstr "MIDI ऑडियो (MIDI Association ने 1983 में निर्धारित किया, Musical Instrument Digital Interface। रिकॉर्डिंग नहीं बल्कि संगीत नोट प्रारूप, फ़ाइल बहुत छोटी, इलेक्ट्रॉनिक संगीत वाद्ययंत्र, फोन रिंगटोन, खेल ऑडियो प्रभावों के लिए मानक। General MIDI 1991 में मानकीकृत हुआ, 128 वाद्ययंत्र ध्वनियाँ परिभाषित कीं)"

msgid "mime_m4a"
msgstr "M4A ऑडियो (MPEG-4 Audio, AAC का कंटेनर प्रारूप। iTunes Music Store का मानक प्रारूप, Apple पारिस्थितिकी तंत्र का मुख्य ऑडियो प्रारूप, DRM संरक्षण समर्थन करता है)"

msgid "mime_m3u"
msgstr "M3U प्लेलिस्ट (MP3 URL प्लेलिस्ट प्रारूप, सादा पाठ फ़ाइल, ऑडियो फ़ाइल पथ रिकॉर्ड करती है। Winamp युग का मानक, ऑनलाइन रेडियो, ऑनलाइन संगीत स्ट्रीमिंग के लिए उपयोग की जाती है। M3U8 इसका UTF-8 संस्करण है, HTTP Live Streaming के लिए उपयोग किया जाता है)"

msgid "mime_asf"
msgstr "ASF स्ट्रीमिंग मीडिया (Microsoft ने 1996 में विकसित किया, Advanced Systems Format। Windows Media स्ट्रीमिंग कंटेनर, ऑडियो और वीडियो तुल्यकालिक संचरण समर्थन करता है। ऑनलाइन लाइव प्रसारण और वीडियो-ऑन-डिमांड स्ट्रीमिंग के लिए उपयोग किया जाता है, WMA/WMV दोनों ASF कंटेनर पर आधारित हैं)"

msgid "mime_avi"
msgstr "AVI वीडियो (Microsoft ने 1992 में लॉन्च किया, Windows का प्रारंभिक वीडियो मानक। 'Audio Video Interleave', ऑडियो और वीडियो बारी-बारी से संग्रहीत करता है, 1990-2000 के दशक में सबसे लोकप्रिय वीडियो प्रारूप था, अब MP4/MKV द्वारा प्रतिस्थापित)"

msgid "mime_divx"
msgstr "DivX वीडियो (DivX Corporation ने 1998 में विकसित किया, MPEG-4 पर आधारित वीडियो कोडेक प्रारूप। 2000 के दशक की ऑनलाइन वीडियो साझाकरण का मुख्य प्रारूप, DVD गुणवत्ता को CD आकार में संपीड़ित करने वाली पहली तकनीक। कॉपीराइट विवाद के कारण, बाद में व्यावसायिक एन्कोडर में परिवर्तित हो गया)"

msgid "mime_mp4"
msgstr "MP4 वीडियो (2001 में MPEG मानक, MPEG-4 Part 14। विश्व का सबसे सामान्य वीडियो प्रारूप, H.264/H.265 एन्कोडिंग समर्थन करता है, इंटरनेट वीडियो, फोन रिकॉर्डिंग, YouTube का डिफ़ॉल्ट प्रारूप)"

msgid "mime_m4v"
msgstr "M4V वीडियो (iTunes का वीडियो प्रारूप, MP4 का भिन्नता। Apple पारिस्थितिकी तंत्र में वीडियो प्रारूप, iTunes Store फिल्मों और टेलीविजन कार्यक्रमों का मानक प्रारूप, DRM कॉपीराइट संरक्षण समर्थन करता है)"

msgid "mime_mpeg"
msgstr "MPEG वीडियो (MPEG संगठन ने 1988 में निर्धारित किया, Moving Picture Experts Group। डिजिटल वीडियो संपीड़न मानकों का आधार बनाने वाला, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (ऑनलाइन वीडियो) का गहरा प्रभाव है)"

msgid "mime_mkv"
msgstr "MKV वीडियो (Matroska परियोजना ने 2002 में विकसित किया, ओपन सोर्स मल्टीमीडिया कंटेनर प्रारूप। कई ऑडियो ट्रैक, कई उपशीर्षक, अध्याय समर्थन करता है, 'रेपर टूल', उच्च-रिज़ॉल्यूशन फिल्म साझाकरण के लिए पहली पसंद प्रारूप)"

msgid "mime_mpg"
msgstr "MPEG वीडियो (MPEG-1/MPEG-2 वीडियो एक्सटेंशन, VCD और DVD के लिए मानक प्रारूप। 1990-2000 के दशक में डिस्क पर वीडियो का मुख्य प्रारूप था, अब H.264/H.265 द्वारा प्रतिस्थापित)"

msgid "mime_ogv"
msgstr "Ogg Video वीडियो (Xiph.Org Foundation द्वारा विकसित, Ogg कंटेनर का वीडियो प्रारूप, Theora कोडेक का उपयोग करता है। ओपन सोर्स और पेटेंट-मुक्त, HTML5 वीडियो के प्रारंभिक मानकों में से एक, Firefox द्वारा मूल रूप से समर्थित)"

msgid "mime_ogx"
msgstr "Ogg मल्टीमीडिया कंटेनर (Xiph.Org Foundation द्वारा विकसित, Ogg कंटेनर का सामान्य एक्सटेंशन, ऑडियो, वीडियो, उपशीर्षक जैसे कई ट्रैक शामिल कर सकता है। ओपन सोर्स मल्टीमीडिया मानक, गेम, स्ट्रीमिंग के लिए उपयोग किया जाता है)"

msgid "mime_rm"
msgstr "RealMedia वीडियो (RealNetworks ने 1995 में विकसित किया, RealMedia प्रारूप। 1990-2000 के दशक में ऑनलाइन स्ट्रीमिंग का अग्रदूत, RealPlayer प्लेयर का मुख्य प्रारूप। कमजोरियाँ: विशेष प्लेयर की आवश्यकता, खराब संपीड़न गुणवत्ता, बाद में Flash/MP4 द्वारा प्रतिस्थापित)"

msgid "mime_flv"
msgstr "Flash वीडियो (2002 में प्रारूप दिखाई दिया, Flash Video प्रारूप। एक समय ऑनलाइन वीडियो का मुख्य प्रारूप था, प्रारंभिक YouTube ने इसका उपयोग किया। कमजोरियाँ: Flash प्लगइन की आवश्यकता, कमजोर प्रदर्शन, कई सुरक्षा कमजोरियाँ। 2015 से मुख्य वेबसाइटों ने HTML5 वीडियो पर स्विच कर दिया, अब हटा दिया गया है)"

msgid "mime_f4v"
msgstr "F4V वीडियो (Adobe द्वारा विकसित Flash वीडियो प्रारूप, FLV का उत्तराधिकारी। MPEG-4 मानक पर आधारित, H.264 एन्कोडिंग समर्थन करता है। Flash प्रौद्योगिकी के साथ हटा दिया गया, Adobe ने 2020 में समर्थन बंद कर दिया)"

msgid "mime_wmv"
msgstr "WMV वीडियो (Microsoft ने 1999 में विकसित किया, Windows Media Video। Windows पर मूल रूप से समर्थित, स्ट्रीमिंग संचरण के लिए अनुकूलित, प्रारंभिक ऑनलाइन वीडियो में सामान्य प्रारूप था, अब सीमांत हो गया है)"

msgid "mime_wmf"
msgstr "WMF मीडिया प्रारूप (Windows Media Format, Microsoft का मीडिया फ्रेमवर्क, WMV वीडियो, WMA ऑडियो शामिल है, Windows Media Player द्वारा मूल रूप से समर्थित)"

msgid "mime_mov"
msgstr "MOV वीडियो (Apple ने 1991 में विकसित किया, QuickTime कंटेनर प्रारूप। पेशेवर वीडियो संपादन के लिए मानक प्रारूप, कई कोडेक का समर्थन करता है, Final Cut Pro, Premiere द्वारा मूल रूप से समर्थित)"

msgid "mime_qt"
msgstr "QuickTime वीडियो (Apple ने 1991 में लॉन्च किया, QuickTime प्रारूप। Mac प्लेटफॉर्म का वीडियो मानक, MOV इसका कंटेनर है, QuickTime प्लेयर एक समय व्यापक रूप से उपयोग किया जाता था। Apple ने 2016 में Windows संस्करण विकास बंद कर दिया, धीरे-धीरे MP4 द्वारा प्रतिस्थापित)"

msgid "mime_webm"
msgstr "WebM वीडियो (Google ने 2010 में लॉन्च किया, ओपन सोर्स और पेटेंट-मुक्त वीडियो प्रारूप। Matroska कंटेनर पर आधारित, VP8/VP9 एन्कोडिंग, HTML5 वीडियो मानक प्रारूप, YouTube का वेब पर डिफ़ॉल्ट प्लेबैक प्रारूप)"

msgid "mime_3gp"
msgstr "3GP वीडियो (3GPP ने 2000 में निर्धारित किया, मोबाइल उपकरणों के लिए वीडियो प्रारूप। फ़ाइल बहुत छोटी, कम गुणवत्ता, प्रारंभिक फीचर फोन की वीडियो रिकॉर्डिंग प्रारूप, MMS भेजने के लिए उपयोग किया जाता था)"

