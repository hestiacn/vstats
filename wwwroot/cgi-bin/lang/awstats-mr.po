msgid "FirstTime   = Date of first visit for history file"
msgstr "FirstTime   = इतिहास फाइलमधील पहिल्या भेटीची तारीख"

msgid "LastTime    = Date of last visit for history file"
msgstr "LastTime    = इतिहास फाइलमधील शेवटच्या भेटीची तारीख"

msgid "LastUpdate  = Date of last update - Nb of parsed records - Nb of parsed old records - Nb of parsed new records - Nb of parsed corrupted - Nb of parsed dropped"
msgstr "LastUpdate  = शेवटच्या अद्यतनाची तारीख - वापरलेल्या नोंदींची संख्या - जुन्या नोंदींची संख्या - नवीन नोंदींची संख्या - खराब झालेल्या नोंदींची संख्या - टाकून दिलेल्या नोंदींची संख्या"

