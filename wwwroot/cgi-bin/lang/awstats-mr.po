msgid "mime_kfx"
msgstr "Kindle KFX स्वरूप (2015 मध्ये Amazon ने प्रकाशित केले, Kindle चे विशेष ई-पुस्तक स्वरूप, सुधारित लेआउट आणि जलद पृष्ठ पलटणे समर्थन करते)"

msgid "mime_chm"
