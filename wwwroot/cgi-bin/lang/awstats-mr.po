msgid "mime_bmp"
msgstr "BMP बिटमॅप (Windows बिटमॅप स्वरूप, Windows 1.0 पासून मूळ समर्थन. संक्षिप्त केलेले नाही, फाइल तुलनेने मोठी आहे, परंतु साध्या रचनेमुळे आणि अतिरिक्त कोडेक्सची आवश्यकता नसल्यामुळे, Windows 11 स्क्रीनशॉट टूल, पेंट प्रोग्राम, EXE/MSI इन्स्टॉलेशन पॅकेज चिन्ह संसाधने, कर्सर फाइल्स आणि काही जुने ड्राइव्हर अजूनही वापरतात. समान गुणवत्तेच्या प्रतिमेसाठी फाइल PNG पेक्षा सुमारे 3-10 पट मोठी आहे, बहुतेक प्रकरणांमध्ये PNG/JPEG ने बदलली आहे, परंतु Windows परिसंस्थेत अजूनही विस्तृत सुसंगतता राखते)"

msgid "mime_cdr"
msgstr "CDR वेक्टर ग्राफिक्स (CorelDRAW चे विशेष स्वरूप, कॅनेडियन Corel कंपनी, वेक्टर ग्राफिक्स डिझाइन सॉफ्टवेअर)"

msgid "mime_gif"
msgstr "GIF प्रतिमा (1987 मध्ये CompuServe ने विकसित केली, 256 रंगांचे चालणारे प्रतिमा स्वरूप. तोटे: कमी रंग, कमी गुणवत्ता, अर्धपारदर्शकता नाही, मोठी फाइल, कमी फ्रेम दर. APNG, WebP सारख्या आधुनिक चालणारे प्रतिमा स्वरूपांनी बदलली गेली आहे)"

msgid "mime_ico"
msgstr "ICO चिन्ह (Windows चिन्ह फाइल स्वरूप, बहु-रेझोल्यूशन समर्थन करते, वेबसाइट favicon चे मानक स्वरूप)"

msgid "mime_jpeg"
msgstr "JPEG प्रतिमा (1992 मध्ये ISO मानक, नुकसान सहित संक्षेप फोटो स्वरूप, इंटरनेट फोटोचे वास्तविक मानक)"

msgid "mime_jpg"
msgstr "JPEG प्रतिमा (1992 मध्ये ISO मानक, नुकसान सहित संक्षेप फोटो स्वरूप, इंटरनेट फोटोचे वास्तविक मानक)"

msgid "mime_png"
msgstr "PNG प्रतिमा (1996 मध्ये W3C शिफारस, वास्तविक रंग आणि अर्धपारदर्शकता समर्थन करते, GIF चे स्थिर बदली, इंटरनेटचे नुकसान न करता प्रतिमा मानक)"

msgid "mime_ps"
msgstr "PostScript पृष्ठ वर्णन फाइल (1985 मध्ये Adobe ने प्रकाशित केले, पृष्ठ वर्णन भाषा, PDF चे पूर्वज, मुद्रण आणि प्रकाशनासाठी वापरली जाते)"

msgid "mime_psb"
msgstr "PSB मोठे दस्तऐवज (Adobe Photoshop चे अतिमोठे प्रतिमा स्वरूप, 2GB किंवा 30000 पिक्सेलपेक्षा मोठ्या प्रतिमांना समर्थन करते)"

msgid "mime_psd"
msgstr "PSD प्रतिमा (Adobe Photoshop ची स्त्रोत फाइल, स्तर, चॅनेल, मार्ग समर्थन करते, प्रतिमा प्रक्रिया उद्योगाचे मानक स्वरूप)"

msgid "mime_webp"
msgstr "WebP प्रतिमा (2010 मध्ये Google ने विकसित केली, वेब प्रतिमा स्वरूप, नुकसानी/नुकसान न करता संक्षेप आणि ॲनिमेशन समर्थन करते, संक्षेप दर PNG पेक्षा 25-35% चांगला आहे, JPEG पेक्षा 25% चांगला आहे)"

msgid "mime_woff"
msgstr "WOFF वेब फॉन्ट (2009 मध्ये तयार झाले, 2018 मध्ये W3C मानक. TrueType/OpenType वर आधारित संक्षिप्त केलेले, वेब फॉन्ट लोडिंग ऑप्टिमायझेशन, आधुनिक वेबसाइट चिन्ह फॉन्टचे मानक स्वरूप)"

msgid "mime_7z"
msgstr "7z संक्षिप्त संग्रह (1999 मध्ये Igor Pavlov ने विकसित केले, 7-Zip प्रोग्रामचे विशेष स्वरूप. LZMA अल्गोरिदम, उच्च संक्षेप दर, ओपन सोर्स आणि विनामूल्य आहे. 7z स्वरूप समान संक्षेप पातळीवर सामान्यतः ZIP पेक्षा 30-50% लहान आहे, ओपन सोर्स समुदायाचे आणि सॉफ्टवेअर वितरणाचे सामान्य स्वरूप आहे)"

msgid "mime_ace"
msgstr "ACE संक्षिप्त संग्रह (1990 च्या दशकात तयार झाले, WinACE प्रोग्राम स्वरूप. RAR शी स्पर्धा केली, संक्षेप दर खूप उच्च होता. 2007 मध्ये विकास थांबला, आता 7z/RAR ने बदलले, विरळ वापरले जाते)"

msgid "mime_bz2"
msgstr "BZIP2 संक्षिप्त संग्रह (1996 मध्ये Julian Seward ने विकसित केले, ब्लॉक सॉर्टिंग संक्षेप अल्गोरिदम. संक्षेप दर GZIP पेक्षा 15-20% चांगला आहे, परंतु वेग मंद आहे. Linux कर्नल स्त्रोत कोड, ओपन सोर्स पॅकेजचे सामान्य स्वरूप, विस्तार .bz2)"

msgid "mime_cab"
msgstr "CAB संक्षिप्त संग्रह (1995 मध्ये Microsoft ने विकसित केले, कॅबिनेट स्वरूप. Windows प्रणाली इन्स्टॉलेशन पॅकेज स्वरूप, ड्राइव्हर, प्रणाली फाइल्स वितरित करण्यासाठी वापरले जाते. Windows Installer (MSI) आंतरिकपणे CAB वापरून फाइल्स साठवते)"

msgid "mime_dmg"
msgstr "DMG डिस्क प्रतिमा (1980 च्या दशकात Apple ने प्रकाशित केले, डिस्क प्रतिमा स्वरूप. macOS सॉफ्टवेअर वितरणाचे मानक स्वरूप, डबल क्लिक करून व्हर्च्युअल डिस्क म्हणून माउंट होते, ॲप्लिकेशन इन्स्टॉल करण्यासाठी फक्त ड्रॅग आणि ड्रॉप करा. संक्षेप आणि एन्क्रिप्शन समर्थन करते, मॅक सॉफ्टवेअर डाउनलोडचे मुख्य स्वरूप आहे)"

msgid "mime_emz"
msgstr "EMZ संक्षिप्त प्रतिमा (Windows संक्षिप्त सुधारित मेटाफाइल, EMF ची संक्षिप्त आवृत्ती. Office दस्तऐवजांमध्ये वेक्टर ग्राफिक्स साठवण्याचे स्वरूप, मूलतः GZIP ने संक्षिप्त केलेली EMF फाइल आहे)"

msgid "mime_gz"
msgstr "GZIP संक्षिप्त संग्रह (1992 मध्ये Jean-loup Gailly आणि Mark Adler यांनी विकसित केले, GNU प्रकल्प. Unix/Linux चे मानक संक्षेप साधन, HTTP प्रसारण संक्षेपाचे सामान्य स्वरूप. विस्तार .gz, सामान्यतः TAR सोबत वापरले जाते)"

msgid "mime_jar"
msgstr "JAR संक्षिप्त संग्रह (1997 मध्ये Sun Microsystems ने प्रकाशित केले, Java ARchive स्वरूप. मूलतः ZIP संक्षिप्त संग्रह, जावा वर्ग लायब्ररी आणि ॲप्लिकेशन्स पॅकेज करण्यासाठी वापरले जाते. Maven, Gradle सारख्या जावा परिसंस्थेचे मूलभूत स्वरूप, Android देखील JAR वापरतो)"

msgid "mime_lzma"
msgstr "LZMA संक्षिप्त संग्रह (1998 मध्ये Igor Pavlov ने विकसित केले, Lempel-Ziv-Markov chain अल्गोरिदम. 7z स्वरूपाचे मूलभूत संक्षेप अल्गोरिदम, उच्च संक्षेप दर, डिकंप्रेशन वेग वेगवान आहे. फर्मवेअर, एम्बेडेड प्रणालींच्या सॉफ्टवेअर वितरणासाठी वापरले जाते)"

msgid "mime_rar"
msgstr "RAR संक्षिप्त संग्रह (1993 मध्ये Eugene Roshal ने विकसित केले, Roshal ARchive स्वरूप. उच्च संक्षेप दर, बहु-भाग संक्षेप, पुनर्संचयन रेकॉर्ड समर्थन करते. WinRAR प्रोग्राम स्वरूप, संक्षेप दर ZIP पेक्षा चांगला आहे, परंतु पैशाच्या सॉफ्टवेअरची आवश्यकता आहे, unrar सारखी ओपन सोर्स साधने ते डिकंप्रेस करू शकतात)"

msgid "mime_tar"
msgstr "TAR संग्रह (1979 मध्ये Unix V7 मध्ये सादर करण्यात आले, टेप संग्रह स्वरूप. टेप संग्रह स्वरूप, संक्षेप करत नाही, फक्त पॅक करते, सामान्यतः GZIP/BZIP2/XZ सोबत वापरले जाते. Linux सॉफ्टवेअर पॅकेजचा स्त्रोत कोड, डॉकर कंटेनर लेयरचे स्टोरेज TAR स्वरूप वापरतात)"

msgid "mime_tgz"
msgstr "TGZ संक्षिप्त संग्रह (TAR + GZIP संयोजन स्वरूप, विस्तार .tgz किंवा .tar.gz. Unix/Linux सॉफ्टवेअर पॅकेजचे सर्वात सामान्य वितरण स्वरूप, स्त्रोत कोड पॅकेज, बायनरी पॅकेज मोठ्या प्रमाणात वापरले जातात, 'अनपॅक करा आणि वापरा' प्रतिनिधी)"

msgid "mime_tbz2"
msgstr "TBZ2 संक्षिप्त संग्रह (TAR + BZIP2 संयोजन स्वरूप, विस्तार .tbz2 किंवा .tar.bz2. संक्षेप दर TGZ पेक्षा 15-20% चांगला आहे, मोठ्या फाइल्ससाठी योग्य आहे, Linux कर्नल स्त्रोत कोड बराच काळ हे स्वरूप वापरत होता)"

msgid "mime_xz"
msgstr "XZ संक्षिप्त संग्रह (2009 मध्ये प्रकाशित, LZMA2 अल्गोरिदमवर आधारित. संक्षेप दर खूप उच्च आहे, GZIP पेक्षा 30-50% चांगला आहे, डिकंप्रेशन वेग तुलनेने वेगवान आहे. Linux कर्नल, पॅकेज व्यवस्थापक (उदा. Debian च्या .deb आत) मोठ्या प्रमाणात वापरतात, सध्या Linux परिसंस्थेचे शिफारस केलेले स्वरूप आहे)"

msgid "mime_z"
msgstr "Z संक्षिप्त संग्रह (1985 मध्ये Unix कंप्रेस कमांडचे स्वरूप, LZW अल्गोरिदम. सुरुवातीचे Unix संक्षेप स्वरूप, आधीच GZIP ने बदलले आहे. विस्तार .Z, आधुनिक प्रणालींमध्ये विरळ वापरले जाते)"

msgid "mime_zip"
msgstr "ZIP संक्षिप्त संग्रह (1989 मध्ये Phil Katz यांनी विकसित केले, PKZIP स्वरूप. Windows मूळ समर्थन, इंटरनेटवरील सर्वात सामान्य संक्षेप स्वरूप. एकाधिक फाइल्स, निर्देशिका रचना समर्थन करते, संक्षेप अल्गोरिदम निवडण्याची क्षमता आहे. Java ची JAR, Android ची APK, Office दस्तऐवजाची DOCX/XLSX सर्व ZIP स्वरूपावर आधारित आहेत)"

msgid "mime_zst"
msgstr "Zstandard संक्षिप्त संग्रह (2015 मध्ये Facebook ने विकसित केले, Yann Collet डिझाइन. उच्च वेगाचे संक्षेप अल्गोरिदम, संक्षेप दर LZMA जवळ आहे, वेगात GZIP पेक्षा खूप जास्त आहे. Linux कर्नल 5.9+ समर्थन करते, Arch Linux pacman, Debian APT हळूहळू स्वीकारत आहेत, नवीन पिढीचे संक्षेप मानक आहे)"

msgid "mime_lz4"
msgstr "LZ4 संक्षिप्त संग्रह (2011 मध्ये Yann Collet यांनी विकसित केले, अतिवेगवान संक्षेप अल्गोरिदम. संक्षेप वेग GZIP पेक्षा 10 पट वेगवान आहे, वास्तविक वेळेच्या संक्षेपासाठी योग्य आहे. Linux कर्नल, OpenZFS, Hadoop मोठ्या प्रमाणात वापरतात, वेगाला प्राधान्य देणाऱ्या प्रकरणांमध्ये आवडते स्वरूप आहे)"

msgid "mime_lzo"
msgstr "LZO संक्षिप्त संग्रह (1996 मध्ये Markus Oberhumer यांनी विकसित केले, Lempel-Ziv-Oberhumer अल्गोरिदम. डिकंप्रेशन वेग खूप वेगवान आहे, संक्षेप दर मध्यम आहे. Linux कर्नलचे Squashfs, OpenWrt फर्मवेअर वापरते, एम्बेडेड प्रणालींसाठी योग्य आहे)"

msgid "mime_msi"
msgstr "MSI इन्स्टॉलेशन पॅकेज (1999 मध्ये Microsoft ने प्रकाशित केले, Windows इन्स्टॉलर पॅकेज स्वरूप. Windows अॅप्लिकेशन्सचे मानक इन्स्टॉलेशन स्वरूप, ट्रान्झॅक्शन रोलबॅक, घटक व्यवस्थापन, शांत इन्स्टॉलेशन समर्थन करते. कॉर्पोरेट स्तरावरील सॉफ्टवेअर वितरणाचे आवडते स्वरूप, आजही Windows सॉफ्टवेअर इन्स्टॉलेशनचे मुख्य स्वरूप आहे)"

msgid "mime_pkg"
msgstr "PKG इन्स्टॉलेशन पॅकेज (macOS अॅप्लिकेशन इन्स्टॉलेशन स्वरूप, Apple च्या इन्स्टॉलर तंत्रज्ञानावर आधारित. macOS सॉफ्टवेअर वितरणाचे मानक स्वरूप, घटक निवड, इन्स्टॉलेशन स्क्रिप्ट्स, अनइन्स्टॉलेशन कार्य समर्थन करते. .pkg फाइलवर डबल क्लिक करून इन्स्टॉल करता येते, Mac App Store व्यतिरिक्त सॉफ्टवेअर वितरणाची सामान्य पद्धत आहे)"

msgid "mime_apk"
msgstr "APK Android अॅप्लिकेशन पॅकेज (2008 मध्ये Google ने प्रकाशित केले, Android प्रणालीचे पारंपारिक अॅप्लिकेशन इन्स्टॉलेशन स्वरूप. APK मूलतः ZIP संक्षिप्त संग्रह आहे, कोड, संसाधने, मॅनिफेस्ट फाइल समाविष्ट करते. 2021 पासून Google Play ने नवीन अॅप्लिकेशन्सना AAB स्वरूपात बदलण्याची आवश्यकता आहे, परंतु APK अजूनही विकास, डीबगिंग, तृतीय-पक्ष स्टोअर आणि साइडलोडिंगसाठी वापरले जाते)"

msgid "mime_ipa"
msgstr "IPA Apple अॅप्लिकेशन पॅकेज (iOS App Store Package, iOS/iPadOS अॅप्लिकेशन इन्स्टॉलेशन स्वरूप. 2008 मध्ये iPhone SDK सोबत प्रकाशित. App Store मार्गे वितरित करणे किंवा कॉर्पोरेट प्रमाणपत्रासह स्वाक्षरी करणे आवश्यक आहे. कार्यान्वित करण्यायोग्य फाइल, संसाधने, Info.plist, स्वाक्षरी माहिती समाविष्ट करते)"

msgid "mime_hap"
msgstr "HAP हार्मनी OS अॅप्लिकेशन पॅकेज (HarmonyOS एबिलिटी पॅकेज, हार्मनी OS अॅप्लिकेशनचे मूलभूत एकक. 2020 मध्ये हार्मनी OS 2.0 सोबत प्रकाशित. एंट्री आणि फीचर असे दोन प्रकार समर्थन करते, हुवावे फोन, टॅब्लेट, स्मार्ट वॉच यांसारख्या हार्मनी OS उपकरणांच्या वितरणाचे स्वरूप)"

msgid "mime_har"
msgstr "HAR हार्मनी OS स्थिर सामायिक पॅकेज (HarmonyOS आर्काइव्ह, हार्मनी OS स्थिर सामायिक लायब्ररी, एकाधिक HAP च्या दरम्यान सामायिक केले जाऊ शकते, घटक-आधारित विकास आणि मॉड्यूल पुनर्वापरासाठी वापरले जाते)"

msgid "mime_aab"
msgstr "Android App Bundle (2018 मध्ये Google ने प्रकाशित केले, 2021 पासून Google Play नवीन अॅप्लिकेशन्सना हे स्वरूप वापरण्यास भाग पाडते. AAB वितरण स्वरूप आहे, Google Play उपकरण संरचनेनुसार (CPU आर्किटेक्चर, स्क्रीन घनता, भाषा) डायनॅमिकरित्या ऑप्टिमाइझ केलेले APK तयार करते, इन्स्टॉलेशन पॅकेज आकार सरासरी 35% कमी होते. विकासक AAB अपलोड करतो, वापरकर्ता APK डाउनलोड करतो)"

msgid "mime_xapk"
msgstr "XAPK अॅप्लिकेशन पॅकेज (तृतीय-पक्ष Android अॅप्लिकेशन विस्तारित पॅकेज, APK + OBB डेटा फाइल्स समाविष्ट करते. मोठ्या गेम्स आणि जटिल अॅप्लिकेशन्ससाठी वापरले जाते, APK ची 100MB मर्यादा समस्या सोडवते. APKPure, APKMirror तृतीय-पक्ष अॅप्लिकेशन स्टोअरमध्ये सामान्य आहे, Google चे अधिकृत स्वरूप नाही)"

msgid "mime_appx"
msgstr "Windows अॅप्लिकेशन पॅकेज (2012 मध्ये Microsoft ने प्रकाशित केले, Windows 8/10/11 अॅप्लिकेशन इन्स्टॉलेशन स्वरूप. UWP आणि डेस्कटॉप अॅप्लिकेशन रूपांतरण समर्थन करते, Microsoft Store मार्गे वितरित केले जाते. 2024 मध्ये Microsoft ने MSIX ला उत्तराधिकारी स्वरूप म्हणून प्रकाशित केले, हळूहळू APPX ची जागा घेते)"

msgid "mime_msix"
msgstr "MSIX अॅप्लिकेशन पॅकेज (2018 मध्ये Microsoft ने प्रकाशित केले, Windows चे नवीन पिढीचे अॅप्लिकेशन पॅकेजिंग स्वरूप. APPX आणि MSI चे फायदे एकत्र करते, सर्व Windows अॅप्लिकेशन प्रकारांना समर्थन करते, Microsoft Store मार्गे किंवा साइडलोडिंग मार्गे स्थापित करता येते, Windows 11 चे शिफारस केलेले स्वरूप आहे)"

msgid "mime_appimage"
msgstr "AppImage अॅप्लिकेशन पॅकेज (2004 मध्ये प्रकाशित, Linux चे अनइन्स्टॉल्ड अॅप्लिकेशन स्वरूप. 'एक अॅप्लिकेशन एक फाइल', स्थापित न करता थेट चालवता येते, बहुतेक Linux वितरणांना समर्थन करते, विकासकांद्वारे Linux सॉफ्टवेअर वितरणाची सामान्य पद्धत आहे)"

msgid "mime_flatpak"
msgstr "Flatpak अॅप्लिकेशन पॅकेज (2015 मध्ये प्रकाशित, Linux चे सँडबॉक्स केलेले अॅप्लिकेशन स्वरूप. वितरणांदरम्यान चालते, होस्ट प्रणालीपासून वेगळे केले जाते, Fedora, Red Hat विकासात आघाडीवर आहेत, GNOME सॉफ्टवेअर सेंटरचे डीफॉल्ट स्वरूप)"

msgid "mime_snap"
msgstr "Snap अॅप्लिकेशन पॅकेज (2014 मध्ये Canonical ने प्रकाशित केले, Ubuntu मूळ कंपनी, Linux चे सार्वत्रिक अॅप्लिकेशन स्वरूप. स्वयंचलित अद्यतन, सँडबॉक्स वेगळेपणा, 40+ Linux वितरणांना समर्थन करते, Ubuntu सॉफ्टवेअर सेंटरचे डीफॉल्ट स्वरूप)"

msgid "mime_deb"
msgstr "डेबियन सॉफ्टवेअर पॅकेज (1993 मध्ये डेबियन प्रकल्पाने प्रकाशित केले, Debian/Ubuntu आणि त्यांच्या व्युत्पन्नांचे मानक इन्स्टॉलेशन स्वरूप. dpkg द्वारे व्यवस्थापित केले जाते, APT हे त्याचे पॅकेज व्यवस्थापक फ्रंट-एंड आहे, Linux परिसंस्थेतील सर्वात प्रौढ पॅकेज स्वरूपांपैकी एक आहे, आजही Debian कुटुंबाचे मुख्य स्वरूप आहे)"

msgid "mime_rpm"
msgstr "RPM सॉफ्टवेअर पॅकेज (1997 मध्ये Red Hat ने प्रकाशित केले, Red Hat/Fedora/CentOS/SUSE आणि इतर वितरणांचे मानक स्वरूप. RPM पूर्णपणे 'Red Hat Package Manager' आहे, DEB सोबत Linux च्या दोन प्रमुख पॅकेज स्वरूपांपैकी एक आहे, आजही RHEL कुटुंबाचे मुख्य स्वरूप आहे)"

msgid "mime_pacman"
msgstr "आर्क सॉफ्टवेअर पॅकेज (2002 मध्ये Arch Linux ने प्रकाशित केले, pacman पॅकेज व्यवस्थापक वापरत असलेले .pkg.tar.zst स्वरूप. Arch Linux च्या रोलिंग रिलीझचे कर्नल, साधेपणा आणि KISS तत्त्वासाठी प्रसिद्ध आहे, AUR (Arch User Repository) हे त्याचे वैशिष्ट्यपूर्ण गुणधर्म आहे)"

msgid "mime_exe"
msgstr "EXE कार्यान्वित करण्यायोग्य फाइल (Windows कार्यान्वित प्रोग्राम स्वरूप, 'एक्झिक्युटेबल' चे संक्षिप्त रूप. Windows ऑपरेटिंग प्रणालीचे मूळ कार्यान्वित स्वरूप, PE रचना समाविष्ट करते. MS-DOS च्या MZ स्वरूपातून उद्भवले आहे, 1993 मध्ये Windows NT ने PE (पोर्टेबल एक्झिक्युटेबल) स्वरूप सादर केले, जे आजही वापरले जाते. सॉफ्टवेअर इन्स्टॉलेशन पॅकेज, अॅप्लिकेशन्स, प्रणाली साधने हे स्वरूप वापरतात. वापरकर्ता दुहेरी क्लिक करून चालवू शकतो, हे जगातील सर्वात व्यापकपणे वापरले जाणारे कार्यान्वित स्वरूप आहे)"

msgid "mime_dll"
msgstr "DLL डायनॅमिक लिंक लायब्ररी (1993 मध्ये Microsoft ने प्रकाशित केले, डायनॅमिक लिंक लायब्ररी. Windows ची सामायिक कोड लायब्ररी, प्रोग्राम चालू असताना डायनॅमिकरित्या लोड होते, मेमरी आणि डिस्क जागा वाचवते. प्रणाली घटक, अॅप्लिकेशन प्लगिन्स, ड्राइव्हर्स सर्व DLL स्वरूप वापरतात. Windows API ची मूळ अंमलबजावणी पद्धत, DLL Hell समस्या .NET युगात कमी झाली आहे)"

msgid "mime_com"
msgstr "COM कार्यान्वित करण्यायोग्य फाइल (MS-DOS युगाचे कार्यान्वित स्वरूप, 'कमांड' चे संक्षिप्त रूप. फाइल रचना सोपी आहे, 64KB मर्यादेसह, Windows 3.x पर्यंत सामान्य होते. आता जुने झाले आहे, आधुनिक Windows EXE स्वरूप वापरते, COM विस्तार अजूनही काही घटक फाइल्ससाठी वापरला जातो)"

msgid "mime_aac"
msgstr "AAC ऑडिओ (1997 मध्ये MPEG मानक, अॅडव्हान्स्ड ऑडिओ कोडिंग. MP3 चा उत्तराधिकारी, समान बिटरेटवर गुणवत्तेत MP3 पेक्षा चांगला आहे, YouTube, iTunes, निन्टेंडो स्विचचे डीफॉल्ट ऑडिओ स्वरूप)"

msgid "mime_alac"
msgstr "ALAC ऑडिओ (2004 मध्ये Apple ने विकसित केले, अॅपल लॉसलेस ऑडिओ कोडेक. Apple चे नुकसान न करणारे स्वरूप, 2011 मध्ये ओपन सोर्स झाले, iTunes आणि Apple Music च्या नुकसान न करणाऱ्या ऑडिओचे डीफॉल्ट स्वरूप)"

msgid "mime_flac"
msgstr "FLAC ऑडिओ (2001 मध्ये Xiph.Org फाउंडेशनने विकसित केले, फ्री लॉसलेस ऑडिओ कोडेक. नुकसान न करणारे संक्षेप, गुणवत्ता CD सारखीच आहे, फाइल सुमारे WAV च्या अर्धी आहे. ओपन सोर्स आणि पेटंट मुक्त आहे, ऑडिओफाइल्स आणि डिजिटल संगीत संग्राहकांचे आवडते स्वरूप आहे)"

msgid "mime_mp3"
msgstr "MP3 ऑडिओ (1993 मध्ये Fraunhofer इन्स्टिट्यूटने विकसित केले, MPEG-1 ऑडिओ लेयर 3. नुकसान सहित संक्षेप स्वरूप, फाइल लहान आणि गुणवत्ता स्वीकार्य आहे, 2000 च्या दशकातील डिजिटल संगीत क्रांतीचे मूलभूत स्वरूप, iPod आणि नॅप्स्टरची कामगिरी. 2017 मध्ये पेटंट कालबाह्य झाले, सार्वजनिक डोमेन स्वरूप बनले)"

msgid "mime_oga"
msgstr "Ogg Audio ऑडिओ (Xiph.Org फाउंडेशनने विकसित केले, Ogg कंटेनरचे शुद्ध ऑडिओ स्वरूप, Vorbis एन्कोडिंग वापरते. ओपन सोर्स आणि पेटंट मुक्त आहे, संक्षेप कार्यक्षमता MP3 पेक्षा चांगली आहे, ओपन सोर्स प्रकल्पांमध्ये मोठ्या प्रमाणात वापरले जाते)"

msgid "mime_ogg"
msgstr "OGG ऑडिओ (2000 मध्ये Xiph.Org फाउंडेशनने विकसित केले, Ogg Vorbis स्वरूप. ओपन सोर्स आणि पेटंट मुक्त आहे, संक्षेप कार्यक्षमता MP3 पेक्षा चांगली आहे, Spotify ने सुरुवातीच्या काळात वापरले, गेम्सच्या ध्वनी प्रभावांमध्ये मोठ्या प्रमाणात वापरले जाते)"

msgid "mime_opus"
msgstr "Opus ऑडिओ (2012 मध्ये IETF मानकीकृत, ओपन सोर्स आणि पेटंट मुक्त ऑडिओ स्वरूप. SILK आणि CELT तंत्रज्ञान एकत्र करते, खूप कमी विलंबता, सर्वोच्च संक्षेप कार्यक्षमता, WebRTC, WhatsApp, डिस्कॉर्डचे डीफॉल्ट ऑडिओ स्वरूप)"

msgid "mime_wav"
msgstr "WAV ऑडिओ (1991 मध्ये Microsoft आणि IBM यांनी विकसित केले, Windows चे मूळ ऑडिओ स्वरूप. संक्षेप न करता PCM एन्कोडिंग, गुणवत्ता नुकसान न करणारी आहे परंतु फाइल खूप मोठी आहे, व्यावसायिक ऑडिओ संपादनाचे मानक स्वरूप)"

msgid "mime_wma"
msgstr "WMA ऑडिओ (1999 मध्ये Microsoft ने विकसित केले, Windows मीडिया ऑडिओ. नुकसानी/नुकसान न करणारे दोन्ही आवृत्त्या, Windows चे मूळ समर्थन, Windows मीडिया प्लेयरसह प्रसार झाले. आता किनारी झाले आहे, MP3/AAC ने बदलले आहे)"

msgid "mime_dsf"
msgstr "DSF ऑडिओ (डायरेक्ट स्ट्रीम डिजिटल स्वरूप, सोनी आणि फिलिप्स यांनी विकसित केले. 1bit उच्च नमुना दर, DSD ऑडिओचे मानक स्वरूप, SACD ची डिजिटल आवृत्ती, ऑडिओफाइल्सचे उच्च-स्तरीय स्वरूप, फाइल प्रचंड आहे)"

msgid "mime_ape"
msgstr "APE ऑडिओ (2000 मध्ये Monkey's Audio ने विकसित केले, दोषरहित संक्षेपन स्वरूप. FLAC पेक्षा उच्च संक्षेपन पण मंद एन्कोडिंग, अजूनही Windows प्लॅटफॉर्म आणि ऑडिओ उत्साही लोकांमध्ये वापरले जाते)"

msgid "mime_mid"
msgstr "MIDI ऑडिओ (1983 मध्ये MIDI असोसिएशनने ठरवले, म्युझिकल इन्स्ट्रुमेंट डिजिटल इंटरफेस. नोट स्वरूप, ऑडिओ रेकॉर्डिंग नाही, फाइल खूप लहान आहे, इलेक्ट्रॉनिक साधने, मोबाइल फोन रिंगटोन, गेम ध्वनी प्रभावांचे मानक आहे. 1991 मध्ये जनरल MIDI मानकीकृत झाले, 128 साधनांचे टिंब्रे परिभाषित केले)"

msgid "mime_m4a"
msgstr "M4A ऑडिओ (MPEG-4 ऑडिओ, AAC चे कंटेनर स्वरूप. iTunes म्युझिक स्टोअरचे मानक स्वरूप, Apple परिसंस्थेचे मुख्य ऑडिओ स्वरूप, DRM संरक्षण समर्थन करते)"

msgid "mime_m3u"
msgstr "M3U प्लेलिस्ट (MP3 URL प्लेलिस्ट स्वरूप, साधी मजकूर फाइल, ऑडिओ फाइल मार्ग रेकॉर्ड करते. विनॅम्प युगाचे मानक, इंटरनेट रेडिओ, ऑनलाइन संगीत स्ट्रीमिंगसाठी वापरले जाते. M3U8 ही त्याची UTF-8 आवृत्ती आहे, HTTP लाइव्ह स्ट्रीमिंगसाठी वापरली जाते)"

msgid "mime_asf"
msgstr "ASF स्ट्रीमिंग स्वरूप (1996 मध्ये Microsoft ने विकसित केले, अॅडव्हान्स्ड सिस्टिम्स फॉरमॅट. Windows मीडियाचे स्ट्रीमिंग कंटेनर, ऑडिओ आणि व्हिडिओ समकालिक प्रसारण समर्थन करते. इंटरनेट प्रसारणे आणि स्ट्रीमिंगसाठी वापरले जाते, WMA/WMV दोन्ही ASF कंटेनरवर आधारित आहेत)"

msgid "mime_avi"
msgstr "AVI व्हिडिओ (1992 मध्ये Microsoft ने प्रकाशित केले, Windows चे सुरुवातीचे व्हिडिओ मानक. 'ऑडिओ व्हिडिओ इंटरलीव्ह', ऑडिओ आणि व्हिडिओ आलटून पालटून संचयित करते, 1990-2000 च्या दशकातील सर्वात लोकप्रिय व्हिडिओ स्वरूप, आता MP4/MKV ने बदलले आहे)"

msgid "mime_divx"
msgstr "DivX व्हिडिओ (1998 मध्ये DivX कंपनीने विकसित केले, MPEG-4 वर आधारित व्हिडिओ एन्कोडिंग स्वरूप. 2000 च्या दशकात इंटरनेट व्हिडिओ शेअरिंगचे मुख्य स्वरूप, DVD गुणवत्ता CD आकारात एन्कोड करणारे पहिले तंत्रज्ञान. कॉपीराइट वादांमुळे, नंतर व्यावसायिक एन्कोडिंगकडे वळले)"

msgid "mime_mp4"
msgstr "MP4 व्हिडिओ (2001 मध्ये MPEG मानक, MPEG-4 भाग 14. जगातील सर्वात सामान्य व्हिडिओ स्वरूप, H.264/H.265 एन्कोडिंग समर्थन करते, इंटरनेट व्हिडिओ, मोबाइल फोन रेकॉर्डिंग, YouTube चे डीफॉल्ट स्वरूप)"

msgid "mime_m4v"
msgstr "M4V व्हिडिओ (iTunes व्हिडिओ स्वरूप, MP4 चे रूपांतर. Apple परिसंस्थेचे व्हिडिओ स्वरूप, iTunes Store चित्रपट, टेलिव्हिजन कार्यक्रमांचे मानक स्वरूप, DRM कॉपीराइट संरक्षण समर्थन करते)"

msgid "mime_mpeg"
msgstr "MPEG व्हिडिओ (1988 मध्ये MPEG संस्थेने ठरवले, मूविंग पिक्चर एक्सपर्ट्स ग्रुप. डिजिटल व्हिडिओ संक्षेप मानकाचे संस्थापक, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (इंटरनेट व्हिडिओ) यांचा महत्त्वपूर्ण प्रभाव पडला आहे)"

msgid "mime_mkv"
msgstr "MKV व्हिडिओ (2002 मध्ये Matroska प्रकल्पाने विकसित केले, ओपन सोर्स मल्टीमीडिया कंटेनर स्वरूप. एकाधिक ऑडिओ ट्रॅक, एकाधिक सबटायटल, अध्याय समर्थन करते, 'पॅकेजिंगचा जादूगार', उच्च रेझोल्यूशन चित्रपट सामायिकरणाचे आवडते स्वरूप)"

msgid "mime_mpg"
msgstr "MPEG व्हिडिओ (MPEG-1/MPEG-2 व्हिडिओ विस्तार, VCD आणि DVD चे मानक स्वरूप. 1990-2000 च्या दशकात ऑप्टिकल डिस्क व्हिडिओचे मुख्य स्वरूप, आता H.264/H.265 ने बदलले आहे)"

msgid "mime_ogv"
msgstr "Ogg Video व्हिडिओ (Xiph.Org फाउंडेशनने विकसित केले, Ogg कंटेनरचे व्हिडिओ स्वरूप, Theora एन्कोडिंग वापरते. ओपन सोर्स आणि पेटंट मुक्त आहे, HTML5 व्हिडिओचे सुरुवातीचे मानक, Firefox चे मूळ समर्थन आहे)"

msgid "mime_ogx"
msgstr "Ogg मल्टीमीडिया कंटेनर (Xiph.Org फाउंडेशनने विकसित केले, Ogg कंटेनरचे सार्वत्रिक विस्तार, ऑडिओ, व्हिडिओ, सबटायटलचे एकाधिक ट्रॅक समाविष्ट करू शकते. ओपन सोर्स मल्टीमीडिया मानक, गेम्स, स्ट्रीमिंगमध्ये वापरले जाते)"

msgid "mime_rm"
msgstr "RealMedia व्हिडिओ (1995 मध्ये RealNetworks ने विकसित केले, RealMedia स्वरूप. 1990-2000 च्या दशकात इंटरनेट स्ट्रीमिंगचे प्रवर्तक, RealPlayer चे मुख्य स्वरूप. तोटे: विशेष प्लेयरची आवश्यकता होती, संक्षेप गुणवत्ता कमी होती, नंतर Flash/MP4 ने बदलले)"

msgid "mime_flv"
msgstr "Flash व्हिडिओ (2002 मध्ये स्वरूप दिसले, फ्लॅश व्हिडिओ स्वरूप. एकेकाळी इंटरनेट व्हिडिओचे मुख्य स्वरूप, YouTube ने सुरुवातीच्या काळात वापरले. तोटे: फ्लॅश प्लगिनची आवश्यकता होती, कार्यक्षमता खराब होती, सुरक्षा छिद्रे होती. 2015 पासून मुख्य वेबसाइट्स HTML5 व्हिडिओकडे वळल्या, आता जुने झाले आहे)"

msgid "mime_f4v"
msgstr "F4V व्हिडिओ (Adobe ने विकसित केलेले फ्लॅश व्हिडिओ स्वरूप, FLV चे उत्तराधिकारी. MPEG-4 मानकावर आधारित आहे, H.264 एन्कोडिंग समर्थन करते. फ्लॅश तंत्रज्ञानासह जुने झाले, Adobe ने 2020 मध्ये समर्थन बंद केले)"

msgid "mime_wmv"
msgstr "WMV व्हिडिओ (1999 मध्ये Microsoft ने विकसित केले, Windows मीडिया व्हिडिओ. Windows चे मूळ समर्थन, स्ट्रीमिंगसाठी ऑप्टिमाइज केलेले, सुरुवातीच्या ऑनलाइन व्हिडिओमध्ये सामान्य स्वरूप होते, आता किनारी झाले आहे)"

msgid "mime_wmf"
msgstr "WMF मीडिया स्वरूप (Windows मीडिया फॉरमॅट, Microsoft चे मीडिया फ्रेमवर्क. WMV व्हिडिओ, WMA ऑडिओ समाविष्ट करते, Windows मीडिया प्लेयरचे मूळ समर्थन आहे)"

msgid "mime_mov"
msgstr "MOV व्हिडिओ (1991 मध्ये Apple ने विकसित केले, क्विकटाइम कंटेनर स्वरूप. व्यावसायिक व्हिडिओ संपादनाचे मानक स्वरूप, एकाधिक कोडेक्स समर्थन करते, फायनल कट प्रो, प्रीमियरचे मूळ समर्थन आहे)"

msgid "mime_qt"
msgstr "क्विकटाइम व्हिडिओ (1991 मध्ये Apple ने प्रकाशित केले, क्विकटाइम स्वरूप. मॅक प्लॅटफॉर्मचे व्हिडिओ मानक, MOV हे त्याचे कंटेनर आहे, क्विकटाइम प्लेयर मोठ्या प्रमाणात वापरले जात असे. 2016 मध्ये Apple ने Windows आवृत्तीचा विकास थांबवला, हळूहळू MP4 ने बदलले)"

msgid "mime_webm"
msgstr "WebM व्हिडिओ (2010 मध्ये Google ने प्रकाशित केले, ओपन सोर्स आणि पेटंट मुक्त व्हिडिओ स्वरूप. Matroska कंटेनरवर आधारित आहे, VP8/VP9 एन्कोडिंग, HTML5 व्हिडिओचे मानक स्वरूप, YouTube चे डीफॉल्ट वेब प्लेयर स्वरूप)"

msgid "mime_3gp"
msgstr "3GP व्हिडिओ (2000 मध्ये 3GPP ने ठरवले, मोबाइल उपकरणांचे व्हिडिओ स्वरूप. फाइल खूप लहान आहे, गुणवत्ता कमी आहे, सुरुवातीच्या फीचर फोनच्या व्हिडिओ रेकॉर्डिंगसाठी वापरले जात असे, MMS संदेश पाठविण्यासाठी वापरले जात असे)"

