msgid "mime_gpx"
msgstr "GPS ट्रॅक डेटा (GPS एक्सचेंज स्वरूप, भौगोलिक स्थान माहिती संग्रहित करते, क्रीडा घड्याळे, नेव्हिगेशन उपकरणांचे सार्वत्रिक स्वरूप)"

msgid "mime_diskimage"
msgstr "डिस्क प्रतिमा (DMG, ISO, IMG आणि इतर डिस्क प्रतिमा फाइल्स, सॉफ्टवेअर वितरित करण्यासाठी किंवा मीडिया बॅकअपसाठी वापरली जातात)"

msgid "mime_vm"
msgstr "व्हर्च्युअल मशीन प्रतिमा (VMDK, VDI, VHDX, OVA आणि इतर व्हर्च्युअल मशीन डिस्क फाइल्स, VMware, VirtualBox, Hyper-V व्हर्च्युअलायझेशन प्लॅटफॉर्मचे स्वरूप)"

msgid "mime_torrent"
msgstr "BitTorrent टोरंट फाइल (2001 मध्ये Bram Cohen यांनी शोध लावला, P2P डाउनलोड निर्देशांक फाइल, फाइल मेटाडेटा आणि ट्रॅकर माहिती समाविष्ट करते)"

msgid "mime_gis"
