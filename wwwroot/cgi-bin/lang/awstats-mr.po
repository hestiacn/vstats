msgid "mime_avif"
msgstr "AVIF प्रतिमा (2019 मध्ये ओपन मीडिया अलायन्सने प्रकाशित केली, AV1 वर आधारित, संक्षेप दर WebF पेक्षा 50% चांगला आहे, नवीन पिढीच्या वेब प्रतिमांचे मानक)"

msgid "mime_markdown"
msgstr "Markdown दस्तऐवज (2004 मध्ये John Gruber यांनी डिझाइन केले, हलकी मार्कअप भाषा, GitHub README, तांत्रिक दस्तऐवजीकरण, फोरम पोस्टचे सार्वत्रिक स्वरूप)"

msgid "mime_yaml"
