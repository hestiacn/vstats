#------------------------------------------------------------------------------
# वेळ विभाग अनुवाद
#------------------------------------------------------------------------------

msgid "period_00"
msgstr "मध्यरात्री · AWStats झोपला आहे, तुम्ही अजूनही डेटा पाहत आहात? खरा चाहता"

msgid "period_01"
msgstr "रात्री 1 वाजता · या वेळी इथे आहात? निद्रानाश आहे की नुकताच कामावरून आलात"

msgid "period_02"
msgstr "रात्री 2 वाजता · बॉट्सही तुमच्यापेक्षा जास्त मेहनतीने काम करत आहेत"

msgid "period_03"
msgstr "रात्री 3 वाजता · शहर झोपले आहे, सर्व्हर ओव्हरटाईम काम करत आहे, कोण अधिक दुःखी"

msgid "period_04"
msgstr "रात्री 4 वाजता · अंधारातील सर्वात तेजस्वी तारा तुमची स्क्रीन आहे की सर्व्हरचा दिवा"

msgid "period_05"
msgstr "पहाटे 5 वाजता · लवकर उठणारा भाग्यवान, बॉट्स डेटा गोळा करतात"

msgid "period_06"
msgstr "सकाळी 6 वाजता · कोणी उठतो, कोणी अजून झोपलेला नाही, इंटरनेट कधीच बंद होत नाही"

msgid "period_07"
