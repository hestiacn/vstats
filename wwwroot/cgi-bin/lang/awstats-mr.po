msgid "mime_dotnet"
msgstr "ASP.NET डायनॅमिक पृष्ठ (2002 मध्ये Microsoft ने प्रकाशित केले, Windows प्लॅटफॉर्मचे डायनॅमिक वेब पृष्ठ तंत्रज्ञान, .NET Framework चा भाग)"

msgid "mime_mdb"
msgstr "Access डेटाबेस (Microsoft Access डेटाबेस फाइल, 1992 मध्ये प्रकाशित, Windows डेस्कटॉप डेटाबेस उपाय)"

msgid "mime_md"
