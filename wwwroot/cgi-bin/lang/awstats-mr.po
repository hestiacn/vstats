msgid "mime_mht"
msgstr "MHT वेब संग्रह (1999 मध्ये Microsoft ने प्रकाशित केले, एकल फाइल वेब पृष्ठ स्वरूप, IE ब्राउझर पृष्ठे जतन करण्यासाठी वापरलेले स्वरूप)"

msgid "mime_wml"
