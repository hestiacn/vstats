msgid "mime_jsx"
msgstr "React JSX घटक (2013 मध्ये Facebook ने प्रकाशित केले, JavaScript XML, React फ्रेमवर्क घटक सिंटॅक्स, HTML JavaScript मध्ये लिहिण्याची नाविन्यपूर्ण पद्धत)"

msgid "mime_tsx"
msgstr "TypeScript TSX घटक (2012 मध्ये Microsoft ने विकसित केले, TypeScript + JSX, React च्या टाइप सुरक्षित विकासाची मानक पद्धत)"

msgid "mime_heif"
