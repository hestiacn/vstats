msgid "mime_text"
msgstr "मजकूर फाइल (1963 मध्ये ASCII मानकीकृत, स्वरूपन न करता साधा मजकूर. सर्व स्त्रोत कोड, संरचना, लॉगचा आधार. Unix मध्ये LF, Windows मध्ये CRLF वापरते, आजही संगणकातील सर्वात सामान्य डेटा स्वरूप)"

msgid "mime_log"
msgstr "लॉग फाइल (प्रणाली, अनुप्रयोगाची माहिती नोंदवते, सामान्यतः त्रुटी शोधणे, कार्यक्षमता विश्लेषण, सुरक्षा तपासणीसाठी वापरली जाते. मानक स्वरूप: Apache combined log, Nginx access log, syslog)"

msgid "mime_page"
msgstr "HTML वेब पृष्ठ (1989 मध्ये टिम बर्नर्स-ली यांनी वर्ल्ड वाइड वेबचा शोध लावला, 1990 मध्ये HTML/HTTP/URL या तीन मूळ तंत्रज्ञानाची व्याख्या केली, पेटंटशिवाय मोफत उघडले. 2014 मध्ये HTML5 W3C अधिकृत मानक बनले. 2016 मध्ये ट्युरिंग पुरस्कार मिळाला)"

msgid "mime_khtml"
msgstr "KHTML वेब इंजिन (1998 मध्ये KDE 2.0 मध्ये प्रकाशित, Konqueror ब्राउझरचे रेंडरिंग इंजिन. 2001 मध्ये Apple ने KHTML वर आधारित WebKit तयार केले, 2008 मध्ये Google ने WebKit वरून Blink फोर्क केले, जे Chrome, Edge, Safari ब्राउझरचे कर्नल बनले. KHTML हे ओपन सोर्स समुदायाचे उदाहरण आहे, ज्याने आधुनिक ब्राउझर इंजिनसाठी पाया घातला)"

msgid "mime_script"
msgstr "डायनॅमिक स्क्रिप्ट (कंपाइल न करता, इंटरप्रिट केलेली भाषा. ASP, JSP, CGI, ColdFusion, Tcl, VBScript समाविष्ट करते, सुरुवातीच्या वेब विकासात, प्रणाली व्यवस्थापनात, स्वयंचलित कार्यांमध्ये मोठ्या प्रमाणात वापरली गेली. आधुनिक स्क्रिप्टिंग भाषा जसे Python, Ruby, JavaScript आता पूर्ण प्रमाणात प्रोग्रामिंग भाषा आहेत)"

msgid "mime_js"
msgstr "JavaScript स्क्रिप्ट (1995 मध्ये Brendan Eich ने Netscape मध्ये 10 दिवसांत तयार केली, ब्राउझरची मूळ प्रोग्रामिंग भाषा. 1997 मध्ये ECMAScript मानकीकृत झाली, 2009 मध्ये Node.js तयार झाल्याने ही पूर्ण प्रमाणात भाषा बनली, npm हा जगातील सर्वात मोठा पॅकेज व्यवस्थापक आहे. GitHub वरील सर्वात लोकप्रिय प्रोग्रामिंग भाषा)"

msgid "mime_py"
msgstr "Python स्क्रिप्ट (1991 मध्ये Guido van Rossum यांनी तयार केली, अनिवार्य इंडेंटेशन आणि साध्या सिंटॅक्सद्वारे ओळखली जाते. वेब विकास, डेटा विज्ञान, कृत्रिम बुद्धिमत्ता, स्वयंचलन यामध्ये मोठ्या प्रमाणात वापरली जाते. TIOBE वार्षिक प्रोग्रामिंग भाषा पुरस्कार अनेक वेळा मिळवला आहे)"

msgid "mime_sh"
msgstr "शेल स्क्रिप्ट (1971 मध्ये Unix सह, कमांड स्क्रिप्टिंग भाषा. प्रणाली व्यवस्थापन, स्वयंचलन कार्ये, सेवा सुरू करणे, तैनाती स्क्रिप्टसाठी वापरली जाते. Linux प्रशासनातील आवश्यक कौशल्य)"

msgid "mime_rb"
msgstr "Ruby स्क्रिप्ट (1995 मध्ये Yukihiro Matsumoto यांनी तयार केली, विकासकांच्या आनंदावर लक्ष केंद्रित करते. Ruby on Rails फ्रेमवर्कने "परंपरेपेक्षा संरचना चांगली" ही पद्धत सादर केली, ज्याने आधुनिक वेब फ्रेमवर्कच्या डिझाइनवर प्रभाव टाकला)"

msgid "mime_pl"
msgstr "Perl स्क्रिप्ट (1987 मध्ये Larry Wall यांनी तयार केली, व्यावहारिकतेसाठी प्रसिद्ध आहे, "स्विस आर्मी चाकू" म्हणून ओळखली जाते. CPAN हे आधुनिक भाषा पॅकेज व्यवस्थापकांचे प्रणेते होते, मजकूर प्रक्रिया, प्रणाली व्यवस्थापन, CGI क्षेत्रात महत्त्वपूर्ण प्रभाव टाकला)"

msgid "mime_php"
msgstr "PHP डायनॅमिक पृष्ठ (1995 मध्ये Rasmus Lerdorf यांनी तयार केले, विशेषतः वेब विकासासाठी. जगातील 70% वेबसाइट्स वापरतात, WordPress, Facebook, Wikipedia सह. PHP 8 ने JIT संकलन सादर केले, कार्यक्षमतेत लक्षणीय सुधारणा केली)"

msgid "mime_image"
msgstr "प्रतिमा फाइल"

msgid "mime_document"
msgstr "दस्तऐवज फाइल"

msgid "mime_package"
msgstr "सॉफ्टवेअर पॅकेज"

msgid "mime_archive"
msgstr "Gzip संक्षिप्त फाइल (1992 मध्ये GNU प्रकल्प, DEFLATE अल्गोरिदमवर आधारित. वेबमध्ये डायनॅमिक संक्षेपासाठी वापरली जाते, संक्षेप दर साधारणतः 60-90%. 2015 नंतर Brotli ने अंशतः बदलले, परंतु सर्व्हरवर अजूनही सर्वात सामान्य संक्षेप स्वरूप आहे)"

msgid "mime_audio"
msgstr "ऑडिओ फाइल"

msgid "mime_video"
msgstr "व्हिडिओ फाइल"

msgid "mime_jscript"
msgstr "JavaScript (1995 मध्ये Brendan Eich यांनी तयार केले)"

msgid "mime_json"
msgstr "JSON डेटा (2001 मध्ये Douglas Crockford यांनी प्रस्तावित केला, हलके डेटा विनिमय स्वरूप, Web API चे वास्तविक मानक)"

msgid "mime_vbs"
msgstr "VBScript (1996 मध्ये Microsoft ने विकसित केले, Windows स्क्रिप्टिंग भाषा, ASP पृष्ठे आणि Windows व्यवस्थापन स्क्रिप्टमध्ये वापरली जाते. PowerShell आणि JavaScript च्या प्रसारासह, हळूहळू जुनी झाली आहे)"

msgid "mime_conf"
msgstr "संरचना फाइल (सॉफ्टवेअर संरचना मजकूर स्वरूपात साठवते, सामान्य स्वरूप: INI, JSON, YAML, TOML, XML. Linux प्रणाली संरचना बहुतेक /etc निर्देशिकेत आहेत)"

msgid "mime_css"
msgstr "CSS स्टाइल शीट (1996 डिसेंबरमध्ये W3C ने प्रथम अधिकृत मानक CSS1 प्रकाशित केले, 1998 मध्ये CSS2 ने लेआउट आणि मीडिया प्रकार जोडले, 2011 पासून CSS3 मॉड्यूलर आवृत्तीने गोल कोपरे, ॲनिमेशन, Flexbox, ग्रिड लेआउट आणि रेस्पॉन्सिव्ह डिझाइन सादर केले. HTML आणि JavaScript सह फ्रंट-एंडच्या तीन मुख्य तंत्रज्ञानांपैकी एक आहे, सर्व आधुनिक ब्राउझर (Chrome, Firefox, Safari, Edge) मूळ समर्थन करतात, पृष्ठ शैली परिभाषित करण्याचे एकमेव मानक आहे)"

msgid "mime_xsl"
msgstr "XSL स्टाइल शीट (1999 मध्ये W3C मानक, XML दस्तऐवज रूपांतरण भाषा, XML ला HTML/PDF/मजकूरात रूपांतरित करू शकते. JSON प्रसारानंतर वापर कमी झाला आहे)"

msgid "mime_runtime"
msgstr "कार्यान्वित करण्यायोग्य फाइल (EXE, ELF, Mach-O ऑपरेटिंग सिस्टमचे कार्यान्वित करण्यायोग्य स्वरूप, मशीन कोड आणि लोडिंग माहिती समाविष्ट करतात)"

msgid "mime_library"
msgstr "लायब्ररी फाइल (DLL, SO, dylib डायनॅमिक लिंक लायब्ररी, प्रोग्राम चालू असताना लोड होतात)"

msgid "mime_swf"
msgstr "Flash ॲनिमेशन (1996 मध्ये Macromedia ने विकसित केले, नंतर Adobe ने विकत घेतले. संवादात्मक वेब ॲनिमेशनचे मानक, इंटरनेट ॲनिमेशन आणि गेममध्ये वर्चस्व गाजवले. तोटे: प्लगिनवर अवलंबून, मोबाइल उपकरणांवर कार्य करत नव्हते, उच्च सुरक्षा धोका. 2017 मध्ये Adobe ने समर्थन बंद करण्याची घोषणा केली, 2020 मध्ये पूर्णपणे बंद केले, HTML5/CSS3/JS ने बदलले)"

msgid "mime_dtd"
