msgid "mime_crystal"
msgstr "Crystal Reports अहवाल स्वरूप (SAP व्यवसाय बुद्धिमत्ता अहवाल, कॉर्पोरेट अहवालाचे मानक स्वरूप)"

msgid "mime_libreoffice"
