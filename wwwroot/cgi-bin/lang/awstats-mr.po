msgid "mime_gls"
msgstr "GLOSSARY शब्दकोश (शब्द व्याख्या फाइल, दस्तऐवजीकरण प्रणालीच्या शब्द व्यवस्थापनासाठी वापरली जाते)"

msgid "mime_cbz"
