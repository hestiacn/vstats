msgid "mime_text"
msgstr "ტექსტური ფაილი (1963 წელს ASCII სტანდარტიზებული, ფორმატირების გარეშე ჩვეულებრივი ტექსტი. ყველა წყაროს კოდის, კონფიგურაციის, ჟურნალის საფუძველი. Unix-ში გამოიყენება LF, Windows-ში CRLF, დღემდე ყველაზე გავრცელებული მონაცემთა ფორმატი კომპიუტერებში)"

msgid "mime_log"
msgstr "ჟურნალის ფაილი (აღრიცხავს სისტემის, აპლიკაციის მუშაობის ინფორმაციას, ხშირად გამოიყენება ხარვეზების მოძიების, მუშაობის ანალიზის, უსაფრთხოების აუდიტისთვის. სტანდარტული ფორმატები: Apache combined log, Nginx access log, syslog)"

msgid "mime_page"
msgstr "HTML ვებ გვერდი (1989 წელს ტიმ ბერნერს-ლიმ გამოიგონა მსოფლიო ქსელი, 1990 წელს განსაზღვრა სამი ძირითადი ტექნოლოგია HTML/HTTP/URL, უფასოდ გახსნა პატენტის გარეშე. 2014 წელს HTML5 გახდა W3C ოფიციალური სტანდარტი. მიიღო ტიურინგის პრემია 2016 წელს)"

msgid "mime_khtml"
msgstr "KHTML-ის ვებ ძრავა (1998 წელს KDE 2.0-ში გამოვიდა, Konqueror ბრაუზერის გადმოცემის ძრავა. 2001 წელს Apple-მა KHTML-ის ბაზაზე შექმნა WebKit, 2008 წელს Google-მა WebKit-იდან გამოყო Blink, რაც გახდა Chrome-ის, Edge-ის, Safari-ს ბირთვი. KHTML არის ღია წყაროს საზოგადოების მაგალითი, რომელმაც საფუძველი ჩაუყარა თანამედროვე ბრაუზერების ძრავებს)"

msgid "mime_script"
msgstr "დინამიკური სკრიპტი (ინტერპრეტირებადი ენა, კომპილაციის გარეშე. მოიცავს ASP, JSP, CGI, ColdFusion, Tcl, VBScript, ფართოდ გამოიყენებოდა ადრეულ ვებ დეველოპმენტში, სისტემის მართვაში, ავტომატიზაციაში. თანამედროვე სკრიპტის ენები Python, Ruby, JavaScript უკვე სრულფასოვანი პროგრამირების ენებია)"

msgid "mime_js"
