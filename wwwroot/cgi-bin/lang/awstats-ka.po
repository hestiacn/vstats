msgstr "  -staticlinksext=xxx    .html-ის ნაცვლად .xxx გაფართოების სტატიკური ბმულების გამოყენება"

msgid "  -lang=LL     to output a HTML report in language LL (en,de,es,fr,it,nl,zh-cn,...)"
msgstr "  -lang=LL      HTML ანგარიშის LL ენაზე გამოტანა (en,de,es,fr,it,nl,zh-cn,...)"

