msgstr "7z შეკუმშული არქივი (1999 წელს Igor Pavlov-მა შეიმუშავა, 7-Zip პროგრამის სპეციალური ფორმატი. LZMA ალგორითმი, მაღალი შეკუმშვის მაჩვენებელი, ღია წყარო და უფასო. 7z ფორმატი იმავე შეკუმშვის დონეზე ჩვეულებრივ 30-50%-ით პატარაა ვიდრე ZIP, არის ღია წყაროს საზოგადოებისა და პროგრამების გავრცელების ხშირი ფორმატი)"

msgid "mime_ace"
msgstr "ACE შეკუმშული არქივი (1990-იან წლებში შეიქმნა, WinACE პროგრამის ფორმატი. კონკურენციას უწევდა RAR-ს, შეკუმშვის მაჩვენებელი საკმაოდ მაღალი იყო. 2007 წელს შეწყდა განვითარება, ახლა უკვე შეცვლილია 7z/RAR-ით, იშვიათად გამოიყენება)"

msgid "mime_bz2"
msgstr "BZIP2 შეკუმშული არქივი (1996 წელს Julian Seward-მა შეიმუშავა, ბლოკების დალაგების შეკუმშვის ალგორითმი. შეკუმშვის მაჩვენებელი 15-20%-ით უკეთესია ვიდრე GZIP, მაგრამ სიჩქარე ნელი. Linux-ის ბირთვის წყაროს კოდის, ღია წყაროს პაკეტების ხშირი ფორმატი, გაფართოება .bz2)"

msgid "mime_cab"
msgstr "CAB შეკუმშული არქივი (1995 წელს Microsoft-მა შეიმუშავა, Cabinet ფორმატი. Windows-ის სისტემის ინსტალაციის პაკეტის ფორმატი, გამოიყენება დრაივერების, სისტემის ფაილების გასავრცელებლად. Windows Installer (MSI) შიდა იყენებს CAB-ს ფაილების შესანახად)"

msgid "mime_dmg"
msgstr "DMG დისკის სურათი (1980-იან წლებში Apple-მა გამოუშვა, Disk Image ფორმატი. macOS-ის პროგრამების გავრცელების სტანდარტული ფორმატი, ორმაგი დაწკაპუნებით მონტაჟდება როგორც ვირტუალური დისკი, აპლიკაციის დასაყენებლად საკმარისია გადათრევა. მხარს უჭერს შეკუმშვას და დაშიფვრას, არის Mac-ის პროგრამების ჩამოტვირთვის მთავარი ფორმატი)"

msgid "mime_emz"
msgstr "EMZ შეკუმშული სურათი (Windows-ის შეკუმშული გაუმჯობესებული მეტაფაილი, EMF-ის შეკუმშული ვერსია. Office-ის დოკუმენტებში ვექტორული გრაფიკის შესანახი ფორმატი, არსებითად არის GZIP-ით შეკუმშული EMF ფაილი)"

msgid "mime_gz"
msgstr "GZIP შეკუმშული არქივი (1992 წელს Jean-loup Gailly-მა და Mark Adler-მა შეიმუშავეს, GNU პროექტი. Unix/Linux-ის სტანდარტული შეკუმშვის ინსტრუმენტი, HTTP-ის გადაცემის შეკუმშვის ხშირი ფორმატი. გაფართოება .gz, ხშირად გამოიყენება TAR-თან ერთად)"

msgid "mime_jar"
msgstr "JAR შეკუმშული არქივი (1997 წელს Sun Microsystems-მა გამოუშვა, Java ARchive ფორმატი. არსებითად არის ZIP შეკუმშული არქივი, გამოიყენება Java-ს კლასების ბიბლიოთეკებისა და აპლიკაციების შესაფუთად. Maven-ის, Gradle-ის Java-ს ეკოსისტემის ძირითადი ფორმატი, Android-იც იყენებს JAR-ს)"

msgid "mime_lzma"
msgstr "LZMA შეკუმშული არქივი (1998 წელს Igor Pavlov-მა შეიმუშავა, Lempel-Ziv-Markov chain ალგორითმი. 7z ფორმატის ძირითადი შეკუმშვის ალგორითმი, მაღალი შეკუმშვის მაჩვენებელი, გაშიფვრის სიჩქარე სწრაფია. გამოიყენება firmware-ის, ჩაშენებული სისტემების პროგრამების გასავრცელებლად)"

msgid "mime_rar"
msgstr "RAR შეკუმშული არქივი (1993 წელს Eugene Roshal-მა შეიმუშავა, Roshal ARchive ფორმატი. მაღალი შეკუმშვის მაჩვენებელი, მხარს უჭერს მრავალნაწილიან შეკუმშვას, აღდგენის ჩანაწერებს. WinRAR პროგრამის ფორმატი, შეკუმშვის მაჩვენებელი უკეთესია ვიდრე ZIP, მაგრამ საჭიროებს ფასიან პროგრამას, ღია წყაროს ინსტრუმენტებს, როგორიცაა unrar, შეუძლიათ მისი გაშიფვრა)"

msgid "mime_tar"
msgstr "TAR არქივი (1979 წელს Unix V7-ში შემოვიდა, Tape ARchive ფორმატი. ლენტის არქივის ფორმატი, არ შეკუმშავს მხოლოდ აფუთავს, ხშირად გამოიყენება GZIP/BZIP2/XZ-თან ერთად. Linux-ის პროგრამული პაკეტების წყაროს კოდი, Docker-ის კონტეინერების ფენების შესანახი იყენებენ TAR ფორმატს)"

msgid "mime_tgz"
msgstr "TGZ შეკუმშული არქივი (TAR + GZIP კომბინაციის ფორმატი, გაფართოება .tgz ან .tar.gz. Unix/Linux-ის პროგრამული პაკეტების ყველაზე გავრცელებული გავრცელების ფორმატი, წყაროს კოდის პაკეტები, ორობითი პაკეტები ფართოდ გამოიყენება, 'გაშიფვრა და გამოყენება' წარმომადგენელი)"

msgid "mime_tbz2"
msgstr "TBZ2 შეკუმშული არქივი (TAR + BZIP2 კომბინაციის ფორმატი, გაფართოება .tbz2 ან .tar.bz2. შეკუმშვის მაჩვენებელი 15-20%-ით უკეთესია ვიდრე TGZ, შესაფერისია დიდი ფაილებისთვის, Linux-ის ბირთვის წყაროს კოდი დიდი ხნის განმავლობაში იყენებდა ამ ფორმატს)"

msgid "mime_xz"
msgstr "XZ შეკუმშული არქივი (2009 წელს გამოვიდა, LZMA2 ალგორითმის ბაზაზე. შეკუმშვის მაჩვენებელი ძალიან მაღალია, 30-50%-ით უკეთესი ვიდრე GZIP, გაშიფვრის სიჩქარე შედარებით სწრაფი. Linux-ის ბირთვი, პაკეტების მენეჯერები (როგორიცაა Debian-ის .deb შიდა) ფართოდ იყენებენ, არის Linux-ის ეკოსისტემის ამჟამინდელი რეკომენდებული ფორმატი)"

msgid "mime_z"
msgstr "Z შეკუმშული არქივი (1985 წელს Unix-ის compress ბრძანების ფორმატი, LZW ალგორითმი. ადრეული Unix-ის შეკუმშვის ფორმატი, უკვე შეცვლილია GZIP-ით. გაფართოება .Z, თანამედროვე სისტემებში იშვიათად გამოიყენება)"

msgid "mime_zip"
msgstr "ZIP შეკუმშული არქივი (1989 წელს Phil Katz-მა შეიმუშავა, PKZIP ფორმატი. Windows-ის მშობლიური მხარდაჭერა, ინტერნეტის ყველაზე გავრცელებული შეკუმშვის ფორმატი. მხარს უჭერს მრავალ ფაილს, დირექტორიის სტრუქტურას, შეკუმშვის ალგორითმის არჩევის შესაძლებლობას. Java-ს JAR, Android-ის APK, Office-ის დოკუმენტების DOCX/XLSX ყველა ZIP ფორმატს ეფუძნება)"

msgid "mime_zst"
msgstr "Zstandard შეკუმშული არქივი (2015 წელს Facebook-მა შეიმუშავა, Yann Collet-ის დიზაინი. მაღალსიჩქარიანი შეკუმშვის ალგორითმი, შეკუმშვის მაჩვენებელი ახლოს არის LZMA-სთან, სიჩქარით ბევრად აღემატება GZIP-ს. Linux-ის ბირთვი 5.9+ მხარს უჭერს, Arch Linux pacman, Debian APT თანდათან იღებენ, არის ახალი თაობის შეკუმშვის სტანდარტი)"

msgid "mime_lz4"
msgstr "LZ4 შეკუმშული არქივი (2011 წელს Yann Collet-მა შეიმუშავა, ექსტრა სწრაფი შეკუმშვის ალგორითმი. შეკუმშვის სიჩქარე 10-ჯერ უფრო სწრაფია ვიდრე GZIP, შესაფერისია რეალურ დროში შეკუმშვისთვის. Linux-ის ბირთვი, OpenZFS, Hadoop ფართოდ იყენებენ, არის სიჩქარის პრიორიტეტის შემთხვევების ფავორიტი)"

msgid "mime_lzo"
msgstr "LZO შეკუმშული არქივი (1996 წელს Markus Oberhumer-მა შეიმუშავა, Lempel-Ziv-Oberhumer ალგორითმი. გაშიფვრის სიჩქარე ძალიან სწრაფია, შეკუმშვის მაჩვენებელი საშუალო. Linux-ის ბირთვის Squashfs, OpenWrt firmware იყენებს, შესაფერისია ჩაშენებული სისტემებისთვის)"

msgid "mime_msi"
msgstr "MSI ინსტალაციის პაკეტი (1999 წელს Microsoft-მა გამოუშვა, Windows Installer პაკეტის ფორმატი. Windows-ის აპლიკაციების სტანდარტული ინსტალაციის ფორმატი, მხარს უჭერს ტრანზაქციების დაბრუნებას, კომპონენტების მართვას, ჩუმ ინსტალაციას. კორპორატიული დონის პროგრამების გავრცელების სასურველი ფორმატი, დღემდე Windows-ის პროგრამების ინსტალაციის მთავარი ფორმატია)"

msgid "mime_pkg"
msgstr "PKG ინსტალაციის პაკეტი (macOS-ის აპლიკაციის ინსტალაციის ფორმატი, Apple-ის Installer ტექნოლოგიაზე დაფუძნებული. macOS-ის პროგრამების გავრცელების სტანდარტული ფორმატი, მხარს უჭერს კომპონენტების არჩევას, ინსტალაციის სკრიპტებს, დეინსტალაციის ფუნქციას. .pkg ფაილის ორმაგი დაწკაპუნებით შესაძლებელია ინსტალაცია, Mac App Store-ის გარეთ პროგრამების გავრცელების ხშირი საშუალება)"

msgid "mime_apk"
msgstr "APK Android-ის აპლიკაციის პაკეტი (2008 წელს Google-მა გამოუშვა, Android-ის სისტემის ტრადიციული აპლიკაციის ინსტალაციის ფორმატი. APK არსებითად არის ZIP შეკუმშული არქივი, შეიცავს კოდს, რესურსებს, მანიფესტის ფაილს. 2021 წლიდან Google Play-მ მოითხოვა, რომ ახალი აპლიკაციები გადავიდნენ AAB ფორმატზე, მაგრამ APK დღემდე გამოიყენება შემუშავებისა და გამართვისთვის, მესამე მხარის მაღაზიებისთვის და გვერდითი ინსტალაციისთვის)"

msgid "mime_ipa"
msgstr "IPA Apple-ის აპლიკაციის პაკეტი (iOS App Store Package, iOS/iPadOS-ის აპლიკაციის ინსტალაციის ფორმატი. 2008 წელს iPhone SDK-სთან ერთად გამოვიდა. საჭიროებს App Store-ის საშუალებით გავრცელებას ან კორპორატიული სერთიფიკატით ხელმოწერას. შეიცავს შესრულებად ფაილს, რესურსებს, Info.plist-ს და ხელმოწერის ინფორმაციას)"

msgid "mime_hap"
msgstr "HAP HarmonyOS-ის აპლიკაციის პაკეტი (HarmonyOS Ability Package, HarmonyOS-ის აპლიკაციის ძირითადი ერთეული. 2020 წელს HarmonyOS 2.0-სთან ერთად გამოვიდა. მხარს უჭერს entry და feature ორ ტიპს, Huawei-ის ტელეფონების, პლანშეტების, ჭკვიანი საათების HarmonyOS-ის მოწყობილობების გავრცელების ფორმატი)"

msgid "mime_har"
msgstr "HAR HarmonyOS-ის სტატიკური გაზიარების პაკეტი (HarmonyOS Archive, HarmonyOS-ის სტატიკური გაზიარების ბიბლიოთეკა, შეიძლება გაზიარდეს რამდენიმე HAP-ს შორის, გამოიყენება კომპონენტებზე ორიენტირებული შემუშავებისა და მოდულების გამეორებისთვის)"

msgid "mime_aab"
msgstr "Android App Bundle (2018 წელს Google-მა გამოუშვა, 2021 წლიდან Google Play-მ აიძულა ახალმა აპლიკაციებმა გამოიყენონ ეს ფორმატი. AAB არის გავრცელების ფორმატი, Google Play მოწყობილობის კონფიგურაციის მიხედვით (CPU არქიტექტურა, ეკრანის სიმკვრივე, ენა) დინამიკურად ქმნის ოპტიმიზებულ APK-ს, ინსტალაციის პაკეტის ზომა საშუალოდ მცირდება 35%-ით. დეველოპერი ატვირთავს AAB-ს, მომხმარებელი ჩამოტვირთავს APK-ს)"

msgid "mime_xapk"
msgstr "XAPK აპლიკაციის პაკეტი (მესამე მხარის Android-ის აპლიკაციის გაფართოებული პაკეტი, შეიცავს APK + OBB მონაცემთა ფაილებს. გამოიყენება დიდი თამაშებისა და რთული აპლიკაციებისთვის, გადაჭრის APK-ის 100MB ლიმიტის პრობლემას. გავრცელებულია APKPure, APKMirror მესამე მხარის აპლიკაციების მაღაზიებში, არ არის Google-ის ოფიციალური ფორმატი)"

msgid "mime_appx"
msgstr "Windows-ის აპლიკაციის პაკეტი (2012 წელს Microsoft-მა გამოუშვა, Windows 8/10/11-ის აპლიკაციის ინსტალაციის ფორმატი. მხარს უჭერს UWP და დესკტოპის აპლიკაციების ტრანსფორმაციას, ვრცელდება Microsoft Store-ის საშუალებით. 2024 წელს Microsoft-მა გამოუშვა MSIX, როგორც მემკვიდრე ფორმატი, თანდათან შეცვლის APPX-ს)"

msgid "mime_msix"
msgstr "MSIX აპლიკაციის პაკეტი (2018 წელს Microsoft-მა გამოუშვა, Windows-ის ახალი თაობის აპლიკაციის შესაფუთი ფორმატი. აერთიანებს APPX-ისა და MSI-ს უპირატესობებს, მხარს უჭერს Windows-ის ყველა ტიპის აპლიკაციას, შესაძლებელია Microsoft Store-ის საშუალებით ან გვერდითი ინსტალაციით, Windows 11-ის რეკომენდებული ფორმატი)"

msgid "mime_appimage"
msgstr "AppImage აპლიკაციის პაკეტი (2004 წელს გამოვიდა, Linux-ის დაყენების გარეშე აპლიკაციის ფორმატი. 'ერთი აპლიკაცია ერთ ფაილში', ინსტალაციის გარეშე პირდაპირ გაშვება, მხარს უჭერს Linux-ის უმეტეს დისტრიბუტივებს, დეველოპერების მიერ Linux-ის პროგრამების გავრცელების ხშირი საშუალება)"

msgid "mime_flatpak"
msgstr "Flatpak აპლიკაციის პაკეტი (2015 წელს გამოვიდა, Linux-ის ქვიშის ყუთში მოთავსებული აპლიკაციის ფორმატი. მუშაობს დისტრიბუტივებს შორის, იზოლირებულია მასპინძელი სისტემისგან, Fedora, Red Hat ლიდერობს შემუშავებას, GNOME Software-ის ცენტრის ნაგულისხმევი ფორმატი)"

msgid "mime_snap"
msgstr "Snap აპლიკაციის პაკეტი (2014 წელს Canonical-მა გამოუშვა, Ubuntu-ს მშობელი კომპანია, Linux-ის საყოველთაო აპლიკაციის ფორმატი. ავტომატური განახლება, ქვიშის ყუთში მოთავსება, მხარს უჭერს 40+ Linux-ის დისტრიბუტივს, Ubuntu Software-ის ცენტრის ნაგულისხმევი ფორმატი)"

msgid "mime_deb"
msgstr "Debian-ის პროგრამული პაკეტი (1993 წელს Debian-ის პროექტმა გამოუშვა, Debian/Ubuntu და მათი წარმოებულების სტანდარტული ინსტალაციის ფორმატი. მართვა ხდება dpkg-ით, APT არის მისი პაკეტების მენეჯერის ფრონტ-ენდი, Linux-ის ეკოსისტემის ერთ-ერთი ყველაზე სექსუალური პაკეტის ფორმატი, დღემდე Debian-ის ოჯახის მთავარი ფორმატია)"

msgid "mime_rpm"
msgstr "RPM პროგრამული პაკეტი (1997 წელს Red Hat-მა გამოუშვა, Red Hat/Fedora/CentOS/SUSE და სხვა დისტრიბუტივების სტანდარტული ფორმატი. RPM სრულად 'Red Hat Package Manager'-ია, DEB-თან ერთად Linux-ის ორი მთავარი პაკეტის ფორმატია, დღემდე RHEL-ის ოჯახის მთავარი ფორმატია)"

msgid "mime_pacman"
msgstr "Arch-ის პროგრამული პაკეტი (2002 წელს Arch Linux-მა გამოუშვა, pacman პაკეტების მენეჯერის მიერ გამოყენებული .pkg.tar.zst ფორმატი. Arch Linux-ის მოძრავი გამოშვების ბირთვი, ცნობილია სიმარტივითა და KISS პრინციპით, AUR (Arch User Repository) მისი განსაკუთრებული თვისებაა)"

msgid "mime_exe"
msgstr "EXE შესრულებადი ფაილი (Windows-ის შესრულებადი პროგრამის ფორმატი, 'Executable'-ის შემოკლება. Windows-ის ოპერაციული სისტემის მშობლიური შესრულების ფორმატი, შეიცავს PE სტრუქტურას. წარმოშობილია MS-DOS-ის MZ ფორმატიდან, 1993 წელს Windows NT-მა შემოიტანა PE (Portable Executable) ფორმატი, რომელიც დღემდე გამოიყენება. პროგრამების ინსტალაციის პაკეტები, აპლიკაციები, სისტემის ინსტრუმენტები ყველა იყენებს ამ ფორმატს. მომხმარებელს ორმაგი დაწკაპუნებით შეუძლია გაშვება, არის მსოფლიოში ყველაზე ფართოდ გავრცელებული შესრულების ფორმატი)"

msgid "mime_dll"
msgstr "DLL დინამიკური ბმულების ბიბლიოთეკა (1993 წელს Microsoft-მა გამოუშვა, Dynamic Link Library. Windows-ის გაზიარებული კოდის ბიბლიოთეკა, პროგრამის გაშვების დროს დინამიკურად იტვირთება, ზოგავს მეხსიერებას და დისკის ადგილს. სისტემის კომპონენტები, აპლიკაციების პლაგინები, დრაივერები ყველა იყენებს DLL ფორმატს. Windows API-ს ძირითადი იმპლემენტაციის გზა, DLL Hell-ის პრობლემა .NET-ის ეპოქაში შემსუბუქდა)"

msgid "mime_com"
msgstr "COM შესრულებადი ფაილი (MS-DOS-ის ეპოქის შესრულებადი ფორმატი, 'Command'-ის შემოკლება. ფაილის სტრუქტურა მარტივია, 64KB ლიმიტით, გავრცელებული იყო Windows 3.x-მდე. უკვე მოძველებულია, თანამედროვე Windows იყენებს EXE ფორმატს, COM გაფართოება დღემდე გამოიყენება ზოგიერთი კომპონენტის ფაილისთვის)"

msgid "mime_aac"
msgstr "AAC აუდიო (1997 წელს MPEG სტანდარტი, Advanced Audio Coding. MP3-ის მემკვიდრე, იმავე ბიტრეიტზე ხარისხით აღემატება MP3-ს, YouTube-ის, iTunes-ის, Nintendo Switch-ის ნაგულისხმევი აუდიო ფორმატი)"

msgid "mime_alac"
msgstr "ALAC აუდიო (2004 წელს Apple-მა შეიმუშავა, Apple Lossless Audio Codec. Apple-ის უდანაკარგო ფორმატი, 2011 წელს გახდა ღია წყარო, iTunes-ისა და Apple Music-ის უდანაკარგო აუდიოს ნაგულისხმევი ფორმატი)"

msgid "mime_flac"
msgstr "FLAC აუდიო (2001 წელს Xiph.Org ფონდმა შეიმუშავა, Free Lossless Audio Codec. უდანაკარგო შეკუმშვა, ხარისხი იგივეა რაც CD, ფაილი დაახლოებით WAV-ის ნახევარია. ღია წყარო და პატენტების გარეშე, აუდიოფილებისა და ციფრული მუსიკის კოლექციონერების სასურველი ფორმატი)"

msgid "mime_mp3"
msgstr "MP3 აუდიო (1993 წელს Fraunhofer-ის ინსტიტუტმა შეიმუშავა, MPEG-1 Audio Layer 3. დაკარგვითი შეკუმშვის ფორმატი, ფაილი მცირეა ხარისხი მისაღები, 2000-იან წლებში ციფრული მუსიკის რევოლუციის ძირითადი ფორმატი, iPod-ისა და Napster-ის დამსახურება. 2017 წელს პატენტი ვადაგასულია, გახდა საზოგადოებრივი დომენის ფორმატი)"

msgid "mime_oga"
msgstr "Ogg Audio აუდიო (Xiph.Org ფონდმა შეიმუშავა, Ogg კონტეინერის სუფთა აუდიო ფორმატი, იყენებს Vorbis კოდირებას. ღია წყარო და პატენტების გარეშე, შეკუმშვის ეფექტურობა აღემატება MP3-ს, ფართოდ გამოიყენება ღია წყაროს პროექტებში)"

msgid "mime_ogg"
msgstr "OGG აუდიო (2000 წელს Xiph.Org ფონდმა შეიმუშავა, Ogg Vorbis ფორმატი. ღია წყარო და პატენტების გარეშე, შეკუმშვის ეფექტურობა აღემატება MP3-ს, Spotify-მ ადრეულ ეტაპზე გამოიყენა, თამაშების ხმოვან ეფექტებში ფართოდ გამოიყენება)"

msgid "mime_opus"
msgstr "Opus აუდიო (2012 წელს IETF-მა სტანდარტიზაცია მოახდინა, ღია წყარო და პატენტების გარეშე აუდიო ფორმატი. აერთიანებს SILK და CELT ტექნოლოგიებს, ძალიან დაბალი შეყოვნება, ყველაზე მაღალი შეკუმშვის ეფექტურობა, WebRTC-ის, WhatsApp-ის, Discord-ის ნაგულისხმევი აუდიო ფორმატი)"

msgid "mime_wav"
msgstr "WAV აუდიო (1991 წელს Microsoft-მა და IBM-მა შეიმუშავეს, Windows-ის მშობლიური აუდიო ფორმატი. შეკუმშვის გარეშე PCM კოდირება, ხარისხი უდანაკარგოა მაგრამ ფაილი ძალიან დიდი, პროფესიონალური აუდიო რედაქტირების სტანდარტული ფორმატი)"

msgid "mime_wma"
msgstr "WMA აუდიო (1999 წელს Microsoft-მა შეიმუშავა, Windows Media Audio. დაკარგვითი/უდანაკარგო ორივე ვერსია, Windows-ის მშობლიური მხარდაჭერა, გავრცელდა Windows Media Player-თან ერთად. ახლა უკვე მარგინალიზებულია, შეიცვალა MP3/AAC-ით)"

msgid "mime_dsf"
msgstr "DSF აუდიო (Direct Stream Digital ფორმატი, Sony-მა და Philips-მა შეიმუშავეს. 1bit მაღალი ნიმუშის სიხშირე, DSD აუდიოს სტანდარტული ფორმატი, SACD-ის ციფრული ვერსია, აუდიოფილების მაღალი დონის ფორმატი, ფაილი უზარმაზარი)"

msgid "mime_ape"
msgstr "APE აუდიო (შემუშავებული Monkey's Audio-ს მიერ 2000 წელს, უარყოფითი შეკუმშვის ფორმატი. უფრო მაღალი შეკუმშვა ვიდრე FLAC, მაგრამ ნელი კოდირება, ჯერ კიდევ გამოიყენება Windows პლატფორმაზე და აუდიო მოყვარულებს შორის)"

msgid "mime_mid"
msgstr "MIDI აუდიო (1983 წელს MIDI ასოციაციამ დაადგინა, Musical Instrument Digital Interface. ნოტების ფორმატი, არა აუდიო ჩანაწერი, ფაილი ძალიან პატარა, ელექტრონული ინსტრუმენტების, მობილური ტელეფონების ზარების, თამაშების ხმოვანი ეფექტების სტანდარტი. 1991 წელს General MIDI სტანდარტიზებული იქნა, განსაზღვრა 128 ინსტრუმენტის ტემბრი)"

msgid "mime_m4a"
msgstr "M4A აუდიო (MPEG-4 Audio, AAC-ის კონტეინერის ფორმატი. iTunes Music Store-ის სტანდარტული ფორმატი, Apple-ის ეკოსისტემის მთავარი აუდიო ფორმატი, მხარს უჭერს DRM დაცვას)"

msgid "mime_m3u"
msgstr "M3U დაკვრის სია (MP3 URL დაკვრის სიის ფორმატი, ჩვეულებრივი ტექსტის ფაილი, აღრიცხავს აუდიო ფაილების ბილიკებს. Winamp-ის ეპოქის სტანდარტი, გამოიყენება ინტერნეტ რადიოსთვის, ონლაინ მუსიკის სტრიმინგისთვის. M3U8 არის მისი UTF-8 ვერსია, გამოიყენება HTTP Live Streaming-ისთვის)"

msgid "mime_asf"
msgstr "ASF სტრიმინგის ფორმატი (1996 წელს Microsoft-მა შეიმუშავა, Advanced Systems Format. Windows Media-ს სტრიმინგის კონტეინერი, მხარს უჭერს აუდიოსა და ვიდეოს სინქრონულ გადაცემას. გამოიყენება ინტერნეტ ტრანსლაციებისა და სტრიმინგისთვის, WMA/WMV ორივე ASF კონტეინერს ეფუძნება)"

msgid "mime_avi"
msgstr "AVI ვიდეო (1992 წელს Microsoft-მა გამოუშვა, Windows-ის ადრეული ვიდეოს სტანდარტი. 'Audio Video Interleave', აუდიოსა და ვიდეოს მონაცვლეობით შენახვა, 1990-2000-იან წლებში ყველაზე პოპულარული ვიდეო ფორმატი, ახლა უკვე შეცვლილია MP4/MKV-ით)"

msgid "mime_divx"
msgstr "DivX ვიდეო (1998 წელს DivX კომპანიამ შეიმუშავა, MPEG-4-ზე დაფუძნებული ვიდეო კოდირების ფორმატი. 2000-იან წლებში ინტერნეტ ვიდეოების გაზიარების მთავარი ფორმატი, პირველი ტექნოლოგია, რომელმაც DVD-ის ხარისხი CD-ის ზომამდე შეკუმშა. საავტორო უფლებების დავების გამო, მოგვიანებით გადავიდა კომერციულ კოდირებაზე)"

msgid "mime_mp4"
msgstr "MP4 ვიდეო (2001 წელს MPEG სტანდარტი, MPEG-4 Part 14. მსოფლიოში ყველაზე გავრცელებული ვიდეო ფორმატი, მხარს უჭერს H.264/H.265 კოდირებას, ინტერნეტ ვიდეოების, მობილური ტელეფონების ჩანაწერების, YouTube-ის ნაგულისხმევი ფორმატი)"

msgid "mime_m4v"
msgstr "M4V ვიდეო (iTunes-ის ვიდეო ფორმატი, MP4-ის ვარიანტი. Apple-ის ეკოსისტემის ვიდეო ფორმატი, iTunes Store-ის ფილმების, სატელევიზიო შოუების სტანდარტული ფორმატი, მხარს უჭერს DRM საავტორო უფლებების დაცვას)"

msgid "mime_mpeg"
msgstr "MPEG ვიდეო (1988 წელს MPEG ორგანიზაციამ დაადგინა, Moving Picture Experts Group. ციფრული ვიდეოს შეკუმშვის სტანდარტის ფუძემდებელი, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (ინტერნეტ ვიდეო) მნიშვნელოვანი გავლენა მოახდინეს)"

msgid "mime_mkv"
msgstr "MKV ვიდეო (2002 წელს Matroska-ს პროექტმა შეიმუშავა, ღია წყაროს მულტიმედიური კონტეინერის ფორმატი. მხარს უჭერს მრავალ აუდიო ჩანაწერს, მრავალ სუბტიტრს, თავებს, 'შესაფუთი ოსტატი', მაღალი გარჩევადობის ფილმების გაზიარების სასურველი ფორმატი)"

msgid "mime_mpg"
msgstr "MPEG ვიდეო (MPEG-1/MPEG-2 ვიდეოს გაფართოება, VCD-ისა და DVD-ის სტანდარტული ფორმატი. 1990-2000-იან წლებში ოპტიკური დისკების ვიდეოს მთავარი ფორმატი, ახლა უკვე შეცვლილია H.264/H.265-ით)"

msgid "mime_ogv"
msgstr "Ogg Video ვიდეო (Xiph.Org ფონდმა შეიმუშავა, Ogg კონტეინერის ვიდეო ფორმატი, იყენებს Theora კოდირებას. ღია წყარო და პატენტების გარეშე, HTML5 ვიდეოს ადრეული სტანდარტი, Firefox-ის მშობლიური მხარდაჭერა)"

msgid "mime_ogx"
msgstr "Ogg მულტიმედიური კონტეინერი (Xiph.Org ფონდმა შეიმუშავა, Ogg კონტეინერის საყოველთაო გაფართოება, შეიძლება შეიცავდეს აუდიოს, ვიდეოს, სუბტიტრების მრავალ ჩანაწერს. ღია წყაროს მულტიმედიური სტანდარტი, გამოიყენება თამაშებში, სტრიმინგში)"

msgid "mime_rm"
msgstr "RealMedia ვიდეო (1995 წელს RealNetworks-მა შეიმუშავა, RealMedia ფორმატი. 1990-2000-იან წლებში ინტერნეტ სტრიმინგის პიონერი, RealPlayer-ის ძირითადი ფორმატი. ნაკლოვანებები: საჭიროებდა სპეციალურ პლეერს, შეკუმშვის ხარისხი დაბალი, მოგვიანებით შეიცვალა Flash/MP4-ით)"

msgid "mime_flv"
msgstr "Flash ვიდეო (2002 წელს ფორმატი გამოჩნდა, Flash Video ფორმატი. ოდესღაც ინტერნეტ ვიდეოს მთავარი ფორმატი, YouTube-მა ადრეულ ეტაპზე გამოიყენა. ნაკლოვანებები: საჭიროებდა Flash პლაგინს, შესრულება ცუდი, უსაფრთხოების ხარვეზები. 2015 წლიდან მთავარმა ვებსაიტებმა გადაინაცვლეს HTML5 ვიდეოზე, ახლა უკვე მოძველებულია)"

msgid "mime_f4v"
msgstr "F4V ვიდეო (Adobe-ის მიერ შემუშავებული Flash ვიდეო ფორმატი, FLV-ის მემკვიდრე. MPEG-4 სტანდარტზე დაფუძნებული, მხარს უჭერს H.264 კოდირებას. Flash ტექნოლოგიასთან ერთად მოძველდა, Adobe-მ მხარდაჭერა შეწყვიტა 2020 წელს)"

msgid "mime_wmv"
msgstr "WMV ვიდეო (1999 წელს Microsoft-მა შეიმუშავა, Windows Media Video. Windows-ის მშობლიური მხარდაჭერა, სტრიმინგისთვის ოპტიმიზებული, ადრეულ ონლაინ ვიდეოებში ხშირი ფორმატი, ახლა უკვე მარგინალიზებულია)"

msgid "mime_wmf"
msgstr "WMF მედია ფორმატი (Windows Media Format, Microsoft-ის მედია ჩარჩო. მოიცავს WMV ვიდეოს, WMA აუდიოს, Windows Media Player-ის მშობლიური მხარდაჭერა)"

msgid "mime_mov"
msgstr "MOV ვიდეო (1991 წელს Apple-მა შეიმუშავა, QuickTime კონტეინერის ფორმატი. პროფესიონალური ვიდეო მონტაჟის სტანდარტული ფორმატი, მხარს უჭერს მრავალ კოდეკს, Final Cut Pro-ს, Premiere-ის მშობლიური მხარდაჭერა)"

msgid "mime_qt"
msgstr "QuickTime ვიდეო (1991 წელს Apple-მა გამოუშვა, QuickTime ფორმატი. Mac-ის პლატფორმის ვიდეოს სტანდარტი, MOV არის მისი კონტეინერი, QuickTime პლეერი ფართოდ გამოიყენებოდა. 2016 წელს Apple-მა შეწყვიტა Windows-ის ვერსიის შემუშავება, თანდათან შეიცვალა MP4-ით)"

msgid "mime_webm"
msgstr "WebM ვიდეო (2010 წელს Google-მა გამოუშვა, ღია წყარო და პატენტების გარეშე ვიდეო ფორმატი. Matroska-ს კონტეინერზე დაფუძნებული, VP8/VP9 კოდირება, HTML5 ვიდეოს სტანდარტული ფორმატი, YouTube-ის ნაგულისხმევი ვებ პლეერის ფორმატი)"

msgid "mime_3gp"
msgstr "3GP ვიდეო (2000 წელს 3GPP-მა დაადგინა, მობილური მოწყობილობების ვიდეო ფორმატი. ფაილი ძალიან პატარა, ხარისხი დაბალი, ადრეული ფუნქციური მობილური ტელეფონების ვიდეო გადაღების ფორმატი, გამოიყენებოდა MMS-ის გზავნილების გასაგზავნად)"

