#------------------------------------------------------------------------------
# File Format Descriptions - Tagalog
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Text file (1963 ASCII standardization, walang format na plain text. Batayan ng lahat ng source code, configuration, log. Unix gamit ang LF, Windows gamit ang CRLF line break, nananatiling pinaka-unibersal na format ng data sa mga computer)"

msgid "mime_log"
msgstr "Log file (text file na nagtatala ng impormasyon ng pagpapatakbo ng system at application, karaniwang ginagamit para sa pag-troubleshoot, pagsusuri ng performance, at security audit. Kasama sa mga standard na format ang Apache combined log, Nginx access log, syslog, atbp.)"

msgid "mime_page"
msgstr "HTML web page (Inimbento ni Tim Berners-Lee ang World Wide Web noong 1989, tinukoy ang tatlong pangunahing teknolohiyang HTML/HTTP/URL noong 1990, walang bayad na ibinigay nang hindi na-patent. Naging opisyal na W3C standard ang HTML5 noong 2014, sumusuporta sa display, multimedia, at pag-print. Nagwagi ng Turing Award 2016)"

msgid "mime_khtml"
msgstr "KHTML web engine (Inilabas ang KDE 2.0 noong 1998, rendering engine ng Konqueror browser. Gumawa ang Apple noong 2001 ng WebKit batay sa KHTML, at gumawa ang Google noong 2008 ng Blink mula sa WebKit, na naging core ng mga browser tulad ng Chrome, Edge, Safari. Ang KHTML ay isang halimbawa kung paano itinatag ng open source community ang pundasyon ng mga modernong browser engine, ang teknolohikal na pamana nito ay nagpapatuloy sa pamamagitan ng WebKit/Blink hanggang ngayon)"

msgid "mime_script"
msgstr "Dynamic na script language (interpreted language, hindi kailangan ang compilation. Kabilang ang ASP, JSP, CGI, ColdFusion, Tcl, VBScript, atbp., malawakang ginamit sa unang bahagi ng web development, system administration, automation ng gawain. Ang mga modernong script language tulad ng Python, Ruby, JavaScript ay umunlad sa pangunahing mga tool para sa full-stack development)"

msgid "mime_js"
msgstr "JavaScript script (Nilikha ito ni Brendan Eich sa loob ng 10 araw sa Netscape noong 1995, native programming language ng browser. Na-standardize ang ECMAScript noong 1997, ipinanganak ang Node.js noong 2009 na ginagawa itong cross-platform na wika, ang npm ay ang pinakamalaking package manager sa mundo. Nangungunang programming language sa GitHub sa loob ng maraming taon)"

msgid "mime_py"
msgstr "Python script (Nilikha ito ni Guido van Rossum noong 1991, kilala sa mandatoryong indentation at simpleng syntax. Malawakang ginagamit sa web development, data science, artificial intelligence, automation ng administrasyon. Maraming beses na nagwagi ng TIOBE Programming Language of the Year award)"

msgid "mime_sh"
msgstr "Shell script (Ipinanganak ang Unix noong 1971, command line language. Ginagamit para sa system administration, automation ng gawain, pagpapatakbo ng serbisyo, deployment script. Kailangang kasanayan para sa Linux administration)"

msgid "mime_rb"
msgstr "Ruby script (Nilikha ito ni Yukihiro Matsumoto noong 1995, nakatuon sa kaligayahan ng developer. Ang Ruby on Rails framework ay nag-pioneer ng convention over configuration paradigm, na nakakaimpluwensya sa disenyo ng mga modernong web framework)"

msgid "mime_pl"
msgstr "Perl script (Nilikha ito ni Larry Wall noong 1987, kilala sa pagiging pragmatic, madalas tawaging 'Swiss Army knife'. Ang CPAN ay ang nagpasimula ng modernong package manager ng mga programming language, may malalim na impluwensya sa larangan ng pagpoproseso ng teksto, system administration, at CGI)"

msgid "mime_php"
msgstr "PHP dynamic web page (Nilikha ito ni Rasmus Lerdorf noong 1995, partikular na idinisenyo para sa web development. Mahigit 70% ng mga website sa mundo ang gumagamit nito, pinapatakbo ang mga platform tulad ng WordPress, Facebook, Wikipedia. Ang PHP 8 ay nagpapakilala ng JIT compilation, na makabuluhang nagpapabuti ng performance)"

msgid "mime_image"
msgstr "Image file"

msgid "mime_document"
msgstr "Document file"

msgid "mime_package"
msgstr "Software package"

msgid "mime_archive"
msgstr "Gzip compressed file (GNU project noong 1992, batay sa DEFLATE algorithm. Ginagamit sa Web para sa dynamic na compression ng tugon, ang compression rate ay karaniwang 60-90%. Pagkatapos ng 2015, pinalitan ito ng Brotli sa ilang mga sitwasyon, ngunit nananatiling pinakamalawak na suportadong compression format sa server side)"

msgid "mime_audio"
msgstr "Audio file"

msgid "mime_video"
msgstr "Video file"

msgid "mime_jscript"
msgstr "JavaScript (binuo ni Brendan Eich noong 1995)"

msgid "mime_json"
msgstr "JSON data (iminungkahi ni Douglas Crockford noong 2001, magaan na format para sa pagpapalitan ng data, de facto standard para sa Web APIs)"

msgid "mime_vbs"
msgstr "VBScript (binuo ng Microsoft noong 1996, Windows scripting language, ginamit para sa ASP web page at Windows administration script. Sa pagtaas ng katanyagan ng PowerShell at JavaScript, unti-unting inalis)"

msgid "mime_conf"
msgstr "Configuration file (nag-iimbak ng configuration ng software sa text format, karaniwang format: INI, JSON, YAML, TOML, XML. Karamihan ng mga configuration ng Linux system ay nasa /etc directory)"

msgid "mime_css"
msgstr "CSS style sheet (Unang opisyal na standard na CSS1 ng W3C ay inilabas noong Disyembre 1996, nagdagdag ng positioning at media types ang CSS2 noong 1998, mula 2011 ang CSS3 ay modular na ipinakilala na may rounded corners, animation, flexbox, grid layout, at responsive na disenyo. Kasama ng HTML at JavaScript, bumubuo sa tatlong pangunahing teknolohiya ng frontend, lahat ng modernong browser (Chrome, Firefox, Safari, Edge) ay native na sumusuporta dito, ito ang tanging pamantayan para sa pagtukoy ng web styles)"

msgid "mime_xsl"
msgstr "XSL style sheet (W3C standard 1999, wika para sa pagbabago ng XML document, maaaring mag-convert ng XML sa HTML/PDF/text. Matapos ang pagpapasikat ng JSON, nabawasan ang paggamit)"

msgid "mime_runtime"
msgstr "Executable file (executable format ng operating system tulad ng EXE, ELF, Mach-O, naglalaman ng machine code at impormasyon para sa pag-load)"

msgid "mime_library"
msgstr "Library file (DLL, SO, dylib, atbp. dynamic link libraries, shared code na ni-load sa pagpapatakbo ng programa)"

msgid "mime_swf"
msgstr "Flash animation (binuo ng Macromedia noong 1996, kalaunan ay pagmamay-ari ng Adobe. Pamantayan para sa interactive na web animation, dating nangingibabaw sa internet animation at laro. Mga disadvantages: dependency sa plugin, hindi suportado sa mobile device, mataas na panganib sa seguridad. Inanunsyo ng Adobe ang pagtatapos noong 2017, ganap na winakasan ang suporta noong 2020, pinalitan ng HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD document type definition (XML specification, tumutukoy sa istruktura ng XML document, ginagamit upang i-verify ang validity ng XML)"

msgid "mime_csv"
msgstr "CSV data format (comma-separated values, unibersal na format para sa tabular data, pamantayan para sa pag-import/export sa Excel at database)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java application launcher, teknolohiya sa pamamahagi ng Java desktop application noong 2000s, inalis na)"

msgid "mime_lit"
msgstr "Microsoft Reader e-book (inilunsad ng Microsoft noong 2000, LIT format, inalis na)"

msgid "mime_svg"
msgstr "SVG vector graphics (W3C standard 1999, matagal na itinulak ng Microsoft ang sarili nitong VML format, sinuportahan lamang ng IE browser mula 2011, na nagdulot ng pagkaantala sa pagpapasikat. Pagkatapos ng 2015, sa pag-alis ng IE at pagpapasikat ng high-resolution na screen, naging unang pagpipilian para sa mga icon at logo)"

msgid "mime_ai"
msgstr "Adobe Illustrator vector graphics (inilunsad noong 1987, pamantayan sa industriya na vector graphics format, unang pagpipilian para sa print design, logo, icon)"

msgid "mime_phshop"
msgstr "Photoshop image (inilunsad ng Adobe noong 1990, PSD format ng source file ng Photoshop, pamantayan sa industriya para sa pagpoproseso ng imahe)"

msgid "mime_ttf"
msgstr "TrueType font (pinagsamang pag-unlad ng Apple at Microsoft noong 1989, vector font format, pare-parehong pagpapakita sa screen at sa print, default na format ng font sa mga modernong operating system)"

msgid "mime_fon"
msgstr "WOFF2 web font (W3C rekomendasyon 2014, gumagamit ng Brotli compression algorithm, laki ay nabawasan ng humigit-kumulang 30% kumpara sa lumang WOFF, higit sa 50% kumpara sa TTF/OTF. Sinusuportahan na ito ng lahat ng modernong browser, ito ang pinakamahusay na pagpipilian para sa web font ngayon, sinusuportahan ng higit sa 98% ng mga browser)"

msgid "mime_pdf"
msgstr "PDF document (binuo ng Adobe noong 1993, naging ISO international standard noong 2008. Cross-platform document format, pinapanatili ang consistency ng format, pandaigdigang pamantayan para sa pamamahagi ng electronic document)"

msgid "mime_dotnet"
msgstr "ASP.NET dynamic page (inilunsad ng Microsoft noong 2002, dynamic web page technology para sa Windows platform, bahagi ng .NET Framework)"

msgid "mime_mdb"
msgstr "Access database (Microsoft Access database file, inilunsad noong 1992, solusyon sa desktop database sa Windows)"

msgid "mime_md"
msgstr "Markdown document (Nilikha ni John Gruber noong 2004, ang disenyo ng syntax ay naiimpluwensyahan ng reStructuredText at Setext. Ang pangunahing pilosopiya ng disenyo ay 'readability equals rendering', ang orihinal na pagpapatupad ng Markdown.pl ay gumagamit ng Perl regex. Ang mga hinangong spec ay kinabibilangan ng GFM (2013), CommonMark (2017), Pandoc Markdown, atbp. Nagpapagana ng mga ecosystem tulad ng GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, naging de facto standard na format para sa mga static site generator at dokumentasyon ng developer)"

msgid "mime_crystal"
msgstr "Crystal Reports format ng ulat (SAP business intelligence reports, standard na format para sa mga ulat sa enterprise)"

msgid "mime_libreoffice"
msgstr "LibreOffice document (Binubuo ng The Document Foundation noong 2010, sangay ng OpenOffice, pagpapatupad ng ODF standard, pangunahing open source office suite)"

msgid "mime_encrypt"
msgstr "Naka-encrypt na file (kailangan ng decryption upang matingnan, karaniwang extension: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS track data (GPS Exchange Format, nagtatala ng impormasyon ng geograpikal na lokasyon, unibersal na format para sa mga sports watch at navigation device)"

msgid "mime_diskimage"
msgstr "Disk image (DMG, ISO, IMG, atbp., mga file ng disk/CD image, ginagamit para sa pamamahagi ng software o backup ng storage media)"

msgid "mime_vm"
msgstr "Virtual machine image (VMDK, VDI, VHDX, OVA, atbp., virtual disk file, mga format para sa virtualization platform tulad ng VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent torrent file (inimbento ni Bram Cohen noong 2001, P2P index file para sa pag-download, naglalaman ng metadata ng file at impormasyon ng Tracker)"

msgid "mime_gis"
msgstr "GIS geospatial data (geospatial data format tulad ng Shapefile, GeoJSON, ginagamit para sa mapa at spatial analysis)"

msgid "mime_ebook"
msgstr "E-book (format ng e-book tulad ng EPUB, MOBI, AZW. Ang EPUB ay internasyonal na pamantayan, ang MOBI/AZW ay format para sa Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF image (inilunsad ng Alliance for Open Media noong 2019, batay sa AV1 codec, ang compression rate ay 50% na mas mataas kaysa sa WebP, bagong pamantayan ng web image)"

msgid "mime_markdown"
msgstr "Markdown document (idinisenyo ni John Gruber noong 2004, magaan na markup language, unibersal na format para sa GitHub README, teknikal na dokumentasyon, mga forum)"

msgid "mime_yaml"
msgstr "YAML configuration (idinisenyo ni Clark Evans noong 2001, format ng serialization ng data na nababasa ng tao, standard na format ng configuration file para sa Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML configuration (idinisenyo ni Tom Preston-Werner noong 2013, 'Tom's Obvious Minimal Language', format ng configuration file para sa mga modernong tool tulad ng Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue component file (ipinakilala noong 2014 ni Evan You, isang progresibong JavaScript framework. Sa pamamagitan ng single-file components (SFC), perpektong pinagsasama nito ang HTML, CSS, at JS, na lubhang nagpapataas ng kahusayan sa pagbuo. Ito ay isa sa pinakasikat na frontend framework sa buong mundo. Bilang sentro rin ng mga modernong static site generator tulad ng VitePress, malawak itong ginagamit upang magmaneho ng interaktibong teknikal na dokumentasyon at mga blog.)"

msgid "mime_wasm"
msgstr "WebAssembly module (W3C standard 2017, format para sa high-performance sa browser, C/C++/Rust/R ay maaaring i-compile dito, performance na malapit sa native code)"

msgid "mime_jsx"
msgstr "React JSX component (inilunsad ng Facebook ang JavaScript XML noong 2013, syntax ng component ng React framework, makabagong paradigm ng pagsulat ng HTML sa loob ng JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX component (binuo ng Microsoft noong 2012, TypeScript + JSX, standard na paraan para sa pagbuo ng React application na may type safety)"

msgid "mime_heif"
msgstr "HEIF image (MPEG standard 2015, mahusay na format ng image file, malawakang ginagamit sa Apple ecosystem)"

msgid "mime_heic"
msgstr "HEIC image (implementasyon ng Apple ng HEIF, default na format ng larawan sa iPhone, native na suportado sa iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D model (GL Transmission Format, 'JPEG ng 3D world', inilabas ng Khronos Group noong 2015, standard na format para sa web 3D)"

msgid "mime_glb"
msgstr "GLB binary 3D model (binary version ng GLTF, isang file na naglalaman ng lahat ng resources, ginagamit para sa pamamahagi ng 3D scene)"

msgid "mime_gls"
msgstr "GLOSSARY talahuluganan (file ng kahulugan ng termino, ginagamit para sa pamamahala ng termino sa documentation system)"

msgid "mime_cbz"
msgstr "CBZ comic book (ZIP-compressed comic image, unibersal na format para sa mga kolektor ng komiks)"

msgid "mime_cbr"
msgstr "CBR comic book (RAR-compressed comic image, unibersal na format para sa mga kolektor ng komiks)"

msgid "mime_fb2"
msgstr "FB2 e-book (FictionBook 2.0, Russian e-book format, XML structure, malawakang sinusuportahan ng open source reader)"

msgid "mime_kepub"
msgstr "KEPUB e-book (Kobo espesyal na EPUB format, na-optimize na format para sa Kobo e-book reader)"

msgid "mime_m4b"
msgstr "M4B audiobook (MPEG-4 audio book format, sumusuporta sa bookmark, format para sa iTunes audiobook)"

msgid "mime_kfx"
msgstr "Kindle KFX format (inilunsad ng Amazon noong 2015, espesyal na format ng e-book para sa Kindle, sumusuporta sa pinahusay na typography at mabilis na page flip)"

msgid "mime_chm"
msgstr "CHM help file (inilunsad ng Microsoft noong 1997, compiled HTML help format, pamantayan para sa dokumentasyon ng tulong sa Windows software)"

msgid "mime_mht"
msgstr "MHT web archive (inilunsad ng Microsoft noong 1999, single-file web page format, format ng pag-save ng web page sa IE browser)"

msgid "mime_wml"
msgstr "WML (Wireless Markup Language, WAP standard 1999, ginamit para sa web page ng lumang feature phone, inalis na)"

msgid "mime_xhtml"
msgstr "XHTML web page (W3C standard 2000, XML version ng HTML, mas mahigpit na syntax. Winakasan ng W3C ang pagpapanatili noong 2009, inilipat ang pokus sa HTML5)"

msgid "mime_xml"
msgstr "XML document (W3C standard 1998, extensible markup language, pangunahing format para sa web services, configuration file, pagpapalitan ng data)"

msgid "mime_sgml"
msgstr "SGML document (ISO standard 1986, hinalinhan ng HTML, Standard Generalized Markup Language, ang XML at HTML ay nagmula sa SGML)"

msgid "mime_apng"
msgstr "APNG animation (binuo ng Mozilla noong 2004, extension ng PNG para sa animation, modernong kapalit para sa GIF, sumusuporta sa totoong kulay at transparency)"

msgid "mime_bmp"
msgstr "BMP bitmap (Windows bitmap format, native na suportado mula noong Windows 1.0. Hindi naka-compress, malalaking sukat ng file, ngunit dahil sa simpleng istraktura at walang pangangailangan para sa karagdagang codec, ang Windows 11 screenshot tool, paint program, icon resources sa EXE/MSI installation package, cursor file, at ilang lumang driver ay ginagamit pa rin ito. Para sa parehong kalidad ng imahe, ang file ay humigit-kumulang 3-10 beses na mas malaki kaysa sa PNG, sa karamihan ng mga sitwasyon ay pinalitan ng PNG/JPEG, ngunit ang Windows ecosystem ay nagpapanatili pa rin ng malawak na compatibility)"

msgid "mime_cdr"
msgstr "CDR vector graphics (espesyal na format para sa CorelDRAW, Corel Corporation mula sa Canada, software para sa vector graphic design)"

msgid "mime_gif"
msgstr "GIF image (binuo ng CompuServe noong 1987, 256-color animation format. Mga disadvantages: limitadong bilang ng kulay, magaspang na kalidad ng imahe, hindi sumusuporta sa transparency, malalaking file, mababang frame rate. Pinalitan ng mga modernong animation format tulad ng APNG, WebP)"

msgid "mime_ico"
msgstr "ICO icon (Windows format ng icon file, sumusuporta sa maraming resolution, standard na format para sa favicon ng web page)"

msgid "mime_jpeg"
msgstr "JPEG image (ISO standard 1992, lossy compression format para sa larawan, de facto standard para sa mga litrato sa internet)"

msgid "mime_jpg"
msgstr "JPEG image (ISO standard 1992, lossy compression format para sa larawan, de facto standard para sa mga litrato sa internet)"

msgid "mime_png"
msgstr "PNG image (W3C rekomendasyon 1996, sumusuporta sa totoong kulay at transparency, static na kapalit para sa GIF, pamantayan para sa lossless na imahe sa internet)"

msgid "mime_ps"
msgstr "PostScript page description file (inilunsad ng Adobe noong 1985, page description language, hinalinhan ng PDF, ginagamit para sa pag-print at pag-publish)"

msgid "mime_psb"
msgstr "PSB large document (Adobe Photoshop format para sa napakalaking imahe, sumusuporta sa mga imaheng mas malaki sa 2GB o 30000 pixels)"

msgid "mime_psd"
msgstr "PSD image (Adobe Photoshop source file, sumusuporta sa mga layer, channel, path, pamantayan sa industriya para sa pagpoproseso ng imahe)"

msgid "mime_webp"
msgstr "WebP image (binuo ng Google noong 2010, format ng web image, sumusuporta sa lossy/lossless compression at animation, ang compression rate ay 25-35% na mas mataas kaysa sa PNG at 25% na mas mataas kaysa sa JPEG)"

msgid "mime_woff"
msgstr "WOFF web font (nilikha noong 2009, W3C standard 2018. Batay sa TrueType/OpenType compression, optimization ng pag-load ng web font, standard na format para sa icon font sa mga modernong web page)"

msgid "mime_7z"
msgstr "7z compressed package (binuo ni Igor Pavlov noong 1999, espesyal na format ng 7-Zip program. LZMA algorithm, mataas na compression rate, open source at libre. Ang 7z format ay karaniwang 30-50% na mas maliit kaysa sa ZIP sa parehong compression rate, karaniwang format sa open source community at para sa pamamahagi ng software)"

msgid "mime_ace"
msgstr "ACE compressed package (binuo noong 1990s, format ng WinACE program. Dati ay nakipagkumpitensya sa RAR, medyo mataas ang compression rate. Winakasan ang pag-unlad noong 2007, ngayon ay pinalitan ng 7z/RAR, bihirang gamitin)"

msgid "mime_bz2"
msgstr "BZIP2 compressed package (binuo ni Julian Seward noong 1996, block-sorting compression algorithm. Ang compression rate ay 15-20% na mas mataas kaysa sa GZIP, ngunit mas mabagal ang bilis. Karaniwang format para sa source code ng Linux kernel, open source software package, extension .bz2)"

msgid "mime_cab"
msgstr "CAB compressed package (binuo ng Microsoft noong 1995, Cabinet format. Format ng installation package para sa Windows, ginagamit para sa pamamahagi ng driver at system file. Ang Windows Installer (MSI) ay panloob na gumagamit ng CAB para sa pag-iimbak ng file)"

msgid "mime_dmg"
msgstr "DMG disk image (inilunsad ng Apple noong 1980s, Disk Image format. Standard na format para sa pamamahagi ng software sa macOS, nagmo-mount bilang virtual disk sa double-click, i-drag upang i-install ang application. Sumusuporta sa compression at encryption, pangunahing format para sa pag-download ng Mac software)"

msgid "mime_emz"
msgstr "EMZ compressed image (Windows compressed Enhanced Metafile, compressed version ng EMF. Format para sa pag-iimbak ng vector graphics sa Office document, sa esensya ay GZIP compressed EMF file)"

msgid "mime_gz"
msgstr "GZIP compressed package (binuo nina Jean-loup Gailly at Mark Adler noong 1992, GNU project. Standard na tool sa compression sa Unix/Linux system, karaniwang format para sa HTTP compression sa pagpapadala. Extension .gz, madalas na ginagamit kasama ng TAR)"

msgid "mime_jar"
msgstr "JAR compressed package (inilunsad ng Sun Microsystems noong 1997, Java ARchive format. Sa esensya ay ZIP compressed package, ginagamit para sa pag-package ng Java classes at application. Pangunahing format sa Java ecosystem tulad ng Maven, Gradle, ginagamit din ng Android ang JAR)"

msgid "mime_lzma"
msgstr "LZMA compressed package (binuo ni Igor Pavlov noong 1998, Lempel-Ziv-Markov chain algorithm. Pangunahing compression algorithm ng 7z format, mataas na compression rate, mabilis na decompression. Ginagamit para sa pamamahagi ng firmware at embedded system software)"

msgid "mime_rar"
msgstr "RAR compressed package (binuo ni Eugene Roshal noong 1993, Roshal ARchive format. Mataas na compression rate, sumusuporta sa volume split at recovery record. Format ng WinRAR program, ang compression rate ay mas mahusay kaysa sa ZIP, ngunit nangangailangan ng bayad na software, ang mga open source tool tulad ng unrar ay maaaring mag-decompress)"

msgid "mime_tar"
msgstr "TAR archive package (ipinakilala sa Unix V7 noong 1979, Tape ARchive format. Tape archive format, packaging lamang walang compression, madalas na ginagamit kasama ng GZIP/BZIP2/XZ. Ang source code ng Linux software package, layered storage ng Docker image ay gumagamit ng TAR format)"

msgid "mime_tgz"
msgstr "TGZ compressed package (kombinasyon ng TAR + GZIP format, extension .tgz o .tar.gz. Pinaka-unibersal na format ng pamamahagi para sa Unix/Linux software package, malawakang ginagamit para sa source code at binary package, kinatawan ng 'extract and use' na konsepto)"

msgid "mime_tbz2"
msgstr "TBZ2 compressed package (kombinasyon ng TAR + BZIP2 format, extension .tbz2 o .tar.bz2. Ang compression rate ay 15-20% na mas mataas kaysa sa TGZ, angkop para sa pamamahagi ng malalaking file, ang source code ng Linux kernel ay matagal nang gumamit ng format na ito)"

msgid "mime_xz"
msgstr "XZ compressed package (inilunsad noong 2009, batay sa LZMA2 algorithm. Napakataas na compression rate, 30-50% na mas mataas kaysa sa GZIP, medyo mabilis ang decompression. Malawakang ginagamit sa Linux kernel, mga package manager (tulad ng panloob na istraktura ng Debian .deb package), inirerekomendang format sa Linux ecosystem ngayon)"

msgid "mime_z"
msgstr "Z compressed package (Unix compress command format mula 1985, LZW algorithm. Maagang Unix compression format, pinalitan ng GZIP. Extension .Z, bihirang gamitin sa mga modernong system)"

msgid "mime_zip"
msgstr "ZIP compressed package (binuo ni Phil Katz noong 1989, PKZIP format. Native na sinusuportahan ng Windows, pinaka-unibersal na compression format sa internet. Sumusuporta sa maraming file, directory structure, maaaring pumili ng compression algorithm. Ang JAR sa Java, APK sa Android, DOCX/XLSX para sa Office document ay batay sa ZIP format)"

msgid "mime_zst"
msgstr "Zstandard compressed package (binuo ng Facebook noong 2015, dinisenyo ni Yann Collet. High-speed compression algorithm, compression rate malapit sa LZMA, bilis na mas mataas kaysa sa GZIP. Sinusuportahan ng Linux kernel 5.9+, unti-unting pinagtibay ng Arch Linux pacman, Debian APT, bagong standard ng compression ng susunod na henerasyon)"

msgid "mime_lz4"
msgstr "LZ4 compressed package (binuo ni Yann Collet noong 2011, napakabilis na compression algorithm. Ang bilis ng compression ay higit sa 10 beses na mas mataas kaysa sa GZIP, angkop para sa real-time na compression scenario. Malawakang ginagamit sa Linux kernel, OpenZFS, Hadoop, unang pagpipilian para sa mga sitwasyon kung saan prayoridad ang bilis)"

msgid "mime_lzo"
msgstr "LZO compressed package (binuo ni Markus Oberhumer noong 1996, Lempel-Ziv-Oberhumer algorithm. Napakabilis na decompression, average na compression rate. Ginagamit ng Linux kernel Squashfs, OpenWrt firmware, angkop para sa embedded system)"

msgid "mime_msi"
msgstr "MSI installation package (inilunsad ng Microsoft noong 1999, Windows Installer package format. Standard na format ng pag-install para sa Windows application, sumusuporta sa transaction rollback, pamamahala ng component, silent installation. Unang pagpipilian para sa pamamahagi ng enterprise software, nananatiling pangunahing format para sa pag-install ng Windows software ngayon)"

msgid "mime_pkg"
msgstr "PKG installation package (macOS application installation format, batay sa teknolohiya ng Apple Installer. Standard na format para sa pamamahagi ng software sa macOS, sumusuporta sa pagpili ng component, installation script, pag-andar ng pag-uninstall. Ang .pkg file ay maaaring i-install sa double-click, karaniwang paraan ng pamamahagi ng software sa labas ng Mac App Store)"

msgid "mime_apk"
msgstr "APK Android application package (inilunsad ng Google noong 2008, tradisyonal na format ng pag-install para sa Android system. Ang APK ay sa esensya ay ZIP compressed package, naglalaman ng code, resources, manifest file. Mula 2021, hinihiling ng Google Play na ang mga bagong application ay gumamit ng AAB format, ngunit ang APK ay ginagamit pa rin para sa pag-unlad, pag-debug, pamamahagi sa pamamagitan ng third-party na tindahan, at side-loading)"

msgid "mime_ipa"
msgstr "IPA Apple application package (iOS App Store Package, format ng pag-install para sa iOS/iPadOS application. Inilunsad noong 2008 kasama ang iPhone SDK. Nangangailangan ng pamamahagi sa pamamagitan ng App Store o pag-sign ng enterprise certificate. Naglalaman ng executable file, resources, Info.plist signed information)"

msgid "mime_hap"
msgstr "HAP HarmonyOS application package (HarmonyOS Ability Package, pangunahing yunit ng HarmonyOS application. Inilunsad kasama ang HarmonyOS 2.0 noong 2020. Sumusuporta sa entry at feature type, format ng pamamahagi para sa Huawei phone, tablet, smart watch, at iba pang HarmonyOS device)"

msgid "mime_har"
msgstr "HAR HarmonyOS static shared package (HarmonyOS Archive, static shared library para sa HarmonyOS, maaaring ibahagi sa maraming HAP, ginagamit para sa component development at module reuse)"

msgid "mime_aab"
msgstr "Android App Bundle (inilunsad ng Google noong 2018, mula 2021 hinihiling ng Google Play na ang mga bagong application ay gumamit ng format na ito. Ang AAB ay format para sa pamamahagi, dynamic na bumubuo ang Google Play ng mga na-optimize na APK batay sa configuration ng device (CPU architecture, screen density, wika), ang average na laki ng installation package ay nabawasan ng 35%. Nag-upload ang mga developer ng AAB, nagda-download ang mga user ng APK)"

msgid "mime_xapk"
msgstr "XAPK application package (pinalawak na Android application package ng third-party, naglalaman ng APK + OBB data file. Ginagamit para sa malalaking laro at kumplikadong application, nilulutas ang limitasyon sa 100MB ng solong APK file. Karaniwan sa third-party na app store tulad ng APKPure, APKMirror, hindi opisyal na format ng Google)"

msgid "mime_appx"
msgstr "Windows application package (inilunsad ng Microsoft noong 2012, format ng pag-install ng application para sa Windows 8/10/11. Sumusuporta sa UWP at conversion ng desktop application, ipinamamahagi sa pamamagitan ng Microsoft Store. Inilunsad ng Microsoft ang MSIX noong 2024 bilang kapalit na format, unti-unting pinapalitan ang APPX)"

msgid "mime_msix"
msgstr "MSIX application package (inilunsad ng Microsoft noong 2018, bagong format ng Windows para sa pag-package ng application. Pinagsasama ang mga bentahe ng APPX at MSI, sumusuporta sa lahat ng uri ng Windows application, maaaring ipamahagi sa pamamagitan ng Microsoft Store o side-load, inirerekomendang format para sa Windows 11)"

msgid "mime_appimage"
msgstr "AppImage application package (inilunsad noong 2004, Linux format ng application na walang pag-install. 'Isang application = isang file', direktang tumatakbo nang walang pag-install, sumusuporta sa karamihan ng Linux distribution, karaniwang paraan para sa mga developer upang ipamahagi ang Linux software)"

msgid "mime_flatpak"
msgstr "Flatpak application package (inilunsad noong 2015, Linux sandboxed application format. Tumatakbo sa cross-distribution, nakahiwalay sa system environment, binuo ng Fedora, Red Hat, default na format sa GNOME Software center)"

msgid "mime_snap"
msgstr "Snap application package (inilunsad ng Canonical noong 2014, binuo ng kumpanya ng magulang ng Ubuntu, Linux unibersal na format ng application. Awtomatikong pag-update, sandbox isolation, sumusuporta sa 40+ Linux distribution, default na format sa Ubuntu Software center)"

msgid "mime_deb"
msgstr "Debian software package (inilunsad ng Debian project noong 1993, standard na format ng pag-install para sa Debian/Ubuntu at mga derivative nito. Pinamamahalaan ng dpkg, ang APT ay ang frontend package manager nito, isa sa mga pinaka-mature na format ng package sa Linux ecosystem, nananatiling pangunahing para sa pamilya ng Debian)"

msgid "mime_rpm"
msgstr "RPM software package (inilunsad ng Red Hat noong 1997, standard na format para sa Red Hat/Fedora/CentOS/SUSE at iba pang distribution. Ang RPM ay kumakatawan sa 'Red Hat Package Manager', kasama ng DEB, isa sa dalawang pangunahing format ng package sa Linux, nananatiling pangunahing para sa pamilya ng RHEL)"

msgid "mime_pacman"
msgstr "Arch software package (inilunsad ng Arch Linux noong 2002, .pkg.tar.zst format na ginagamit ng pacman package manager. Core ng rolling release Arch Linux, kilala sa pagiging simple at KISS prinsipyo, ang AUR (Arch User Repository) ay ang espesyalidad nito)"

msgid "mime_exe"
msgstr "EXE executable file (Windows executable program format, maikli para sa 'Executable'. Native executable format ng Windows operating system, naglalaman ng PE structure. Nag-evolve mula sa MZ format mula sa MS-DOS, ang PE (Portable Executable) format ay ipinakilala sa Windows NT noong 1993 at ginagamit pa rin hanggang ngayon. Ang mga installation package ng software, application, system tool ay gumagamit ng format na ito. Dina-double click ng user upang tumakbo, ang pinakamalawak na ginagamit na executable format sa mundo)"

msgid "mime_dll"
msgstr "DLL dynamic link library (inilunsad ng Microsoft noong 1993, Dynamic Link Library. Windows shared code library, dynamic na ni-load sa pagpapatakbo ng programa, nakakatipid ng memory at disk space. Ang mga system component, application plugin, driver ay gumagamit ng DLL format. Pangunahing paraan ng pagpapatupad ng Windows API, ang 'DLL Hell' na problema ay napawi sa .NET era)"

msgid "mime_com"
msgstr "COM executable file (executable format mula sa MS-DOS era, maikli para sa 'Command'. Simpleng istraktura ng file, limitasyon sa 64KB, ay ang pangunahing format bago ang Windows 3.x. Inalis na, ang modernong Windows ay gumagamit ng EXE format, ang COM extension ay ginagamit pa rin para sa ilang component file)"

msgid "mime_aac"
msgstr "AAC audio (MPEG standard 1997, Advanced Audio Coding. Kahalili ng MP3, kalidad ng tunog ay mas mahusay kaysa sa MP3 sa parehong bitrate, default na audio format para sa YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC audio (binuo ng Apple noong 2004, Apple Lossless Audio Codec. Apple lossless format, naging open source noong 2011, default na format para sa lossless audio sa iTunes at Apple Music)"

msgid "mime_flac"
msgstr "FLAC audio (binuo ng Xiph.Org Foundation noong 2001, Free Lossless Audio Codec. Lossless compression, kalidad ng tunog ay katulad ng CD, ang file ay humigit-kumulang kalahati ng laki ng orihinal na WAV. Open source at walang patent, unang pagpipilian para sa mga audiophile at collector ng digital music)"

msgid "mime_mp3"
msgstr "MP3 audio (binuo ng Fraunhofer Institute noong 1993, MPEG-1 Audio Layer 3. Lossy compression format, maliliit na file na may disenteng kalidad ng tunog, ay ang pangunahing format ng digital music revolution noong 2000s, responsable para sa iPod at Napster. Nag-expire ang patent noong 2017, naging public domain)"

msgid "mime_oga"
msgstr "Ogg Audio audio (binuo ng Xiph.Org Foundation, purong audio format ng Ogg container, gumagamit ng Vorbis codec. Open source at walang patent, kahusayan ng compression ay mas mahusay kaysa sa MP3, malawakang ginagamit sa open source projects)"

msgid "mime_ogg"
msgstr "OGG audio (binuo ng Xiph.Org Foundation noong 2000, Ogg Vorbis format. Open source at walang patent, kahusayan ng compression ay mas mahusay kaysa sa MP3, maagang ginamit ng Spotify, malawakang ginagamit sa sound effects para sa mga laro)"

msgid "mime_opus"
msgstr "Opus audio (IETF standardize noong 2012, open source at walang patent. Pinagsasama ang SILK at CELT na teknolohiya, napakababang latency, pinakamataas na kahusayan ng compression, default na audio format para sa WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV audio (binuo ng Microsoft at IBM noong 1991, Windows native audio format. PCM encoding na walang compression, walang kapintasang kalidad, ngunit napakalaki ng mga file, standard na format para sa propesyonal na audio editing)"

msgid "mime_wma"
msgstr "WMA audio (binuo ng Microsoft noong 1999, Windows Media Audio. May lossy at lossless na bersyon, native na sinusuportahan ng Windows, naging tanyag sa Windows Media Player. Ngayon ay nasa gilid na, pinalitan ng MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF audio (Direct Stream Digital format, binuo ng Sony at Philips. 1-bit high sampling rate, standard na format ng DSD audio, digital na bersyon ng SACD, high-end audio format para sa mga audiophile, napakalaking file)"

msgid "mime_ape"
msgstr "Audio APE (binuo ng Monkey's Audio noong 2000, lossless compression format. Mas mataas na compression kaysa FLAC ngunit mas mabagal na encoding, ginagamit pa rin sa Windows platform at sa mga mahilig sa audio)"

msgid "mime_mid"
msgstr "MIDI audio (itinatag ng MIDI Association ang standard noong 1983, Musical Instrument Digital Interface. Format ng musical score sa halip na recording, napakaliit na mga file, pamantayan para sa electronic musical instrument, ringtone ng mobile phone, sound effect sa mga laro. Na-standardize ang General MIDI noong 1991, tumutukoy ng 128 instrumento)"

msgid "mime_m4a"
msgstr "M4A audio (MPEG-4 Audio, container format para sa AAC. Standard na format para sa iTunes Music Store, pangunahing audio format sa Apple ecosystem, sumusuporta sa DRM protection)"

msgid "mime_m3u"
msgstr "M3U playlist (MP3 URL playlist format, plain text file, nagtatala ng mga path ng audio file. Standard mula sa Winamp era, ginagamit para sa internet radio, online music streaming. Ang M3U8 ay ang UTF-8 version nito, ginagamit para sa HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF streaming media (binuo ng Microsoft noong 1996, Advanced Systems Format. Windows Media streaming container, sumusuporta sa synchronized na pagpapadala ng audio at video. Ginagamit para sa live broadcast at video on demand streaming, ang WMA/WMV ay batay sa ASF container)"

msgid "mime_avi"
msgstr "AVI video (inilunsad ng Microsoft noong 1992, maagang Windows video standard. 'Audio Video Interleave', audio at video ay interleaved, ay ang pinakasikat na video format noong 1990s at 2000s, ngayon ay pinalitan ng MP4/MKV)"

msgid "mime_divx"
msgstr "DivX video (binuo ng DivX company noong 1998, video codec batay sa MPEG-4. Ay ang pangunahing format para sa pagbabahagi ng video sa internet noong 2000s, unang nagbigay-daan sa compression ng DVD quality sa laki ng CD. Dahil sa kontrobersya sa copyright, kalaunan ay nagbago sa komersyal na codec)"

msgid "mime_mp4"
msgstr "MP4 video (MPEG standard 2001, MPEG-4 Part 14. Pinaka-unibersal na video format sa mundo, sumusuporta sa H.264/H.265 encoding, default na format para sa internet video, pagre-record ng mobile phone, YouTube)"

msgid "mime_m4v"
msgstr "M4V video (iTunes video format, variant ng MP4. Video format sa Apple ecosystem, standard na format para sa mga pelikula at TV series sa iTunes Store, sumusuporta sa DRM copyright protection)"

msgid "mime_mpeg"
msgstr "MPEG video (itinatag ng MPEG organization ang standard noong 1988, Moving Picture Experts Group. Pangunahing standard para sa digital video compression, ang MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (internet video) ay may malalim na impluwensya)"

msgid "mime_mkv"
msgstr "MKV video (binuo ng Matroska project noong 2002, open source multimedia container format. Sumusuporta sa maraming audio track, maraming subtitle, kabanata, 'may kakayahang mag-package ng lahat', unang pagpipilian para sa pagbabahagi ng high-definition na pelikula)"

msgid "mime_mpg"
msgstr "MPEG video (extension para sa MPEG-1/MPEG-2 video, standard na format para sa VCD at DVD. Ay ang pangunahing format para sa video sa CD noong 1990s at 2000s, ngayon ay pinalitan ng H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video video (binuo ng Xiph.Org Foundation, video format ng Ogg container, gumagamit ng Theora codec. Open source at walang patent, ay isa sa mga unang standard para sa HTML5 video, native na sinusuportahan ng Firefox)"

msgid "mime_ogx"
msgstr "Ogg multimedia container (binuo ng Xiph.Org Foundation, pangkalahatang extension ng Ogg container, maaaring maglaman ng maraming track tulad ng audio, video, subtitle. Open source multimedia standard, ginagamit sa mga laro at streaming media)"

msgid "mime_rm"
msgstr "RealMedia video (binuo ng RealNetworks noong 1995, RealMedia format. Ay ang pioneer ng streaming media sa internet noong 1990s at 2000s, pangunahing format ng RealPlayer. Mga disadvantages: nangangailangan ng espesyal na player, mahinang kalidad ng compression, pinalitan ng Flash/MP4)"

msgid "mime_flv"
msgstr "Flash video (lumitaw ang format noong 2002, Flash Video format. Dati ay ang pangunahing anyo ng internet video, maagang ginamit ng YouTube. Mga disadvantages: nangangailangan ng Flash plugin, mahinang performance, maraming security hole. Mula 2015, lumipat ang mga pangunahing website sa HTML5 video, ngayon ay inalis na)"

msgid "mime_f4v"
msgstr "F4V video (Flash video format na binuo ng Adobe, kahalili ng FLV. Batay sa MPEG-4 standard, sumusuporta sa H.264 encoding. Inalis kasama ng Flash technology, winakasan ng Adobe ang suporta noong 2020)"

msgid "mime_wmv"
msgstr "WMV video (binuo ng Microsoft noong 1999, Windows Media Video. Native na sinusuportahan ng Windows, na-optimize para sa streaming media transmission, ay karaniwang format para sa online video noong 2000s, ngayon ay nasa gilid na)"

msgid "mime_wmf"
msgstr "WMF media format (Windows Media Format, Microsoft framework para sa media. Kabilang ang WMV video, WMA audio, native na sinusuportahan ng Windows Media Player)"

msgid "mime_mov"
msgstr "MOV video (binuo ng Apple noong 1991, QuickTime container format. Standard na format para sa propesyonal na video editing, sumusuporta sa maraming codec, native na sinusuportahan ng Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime video (inilunsad ng Apple noong 1991, QuickTime format. Standard para sa video sa Mac platform, ang MOV ay ang container nito, ang QuickTime player ay malawakang ginamit. Winakasan ng Apple ang pagbuo ng Windows version noong 2016, unti-unting pinalitan ng MP4)"

msgid "mime_webm"
msgstr "WebM video (inilunsad ng Google noong 2010, open source at walang patent. Batay sa Matroska container, VP8/VP9 encoding, standard na format para sa HTML5 video, default na format para sa YouTube Web player)"

msgid "mime_3gp"
msgstr "3GP video (itinatag ng 3GPP noong 2000, video format para sa mobile device. Napakaliit na mga file, mababang kalidad, format para sa pagre-record sa lumang feature phone, ginamit para sa pagpapadala sa pamamagitan ng MMS)"

