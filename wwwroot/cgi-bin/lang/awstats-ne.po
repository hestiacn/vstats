msgid "period_14"
msgstr "दिउँसो २ बजे · चिया समय"

msgid "period_15"
msgstr "दिउँसो ३ बजे · आजको ट्राफिक प्रवृत्ति ग्राफ, तिम्रो भावना ग्राफ जस्तो छैन?"

msgid "period_16"
