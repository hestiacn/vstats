# ढाँचा विवरण
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "पाठ फाइल (सन् १९६३ मा ASCII मापदण्डीकृत, ढाँचा नभएको सादा पाठ। स्रोत कोड, कन्फिगरेसन फाइल र लगहरूको आधार। Unix ले LF प्रयोग गर्छ, Windows ले CRLF प्रयोग गर्छ, अझै पनि कम्प्युटरको सबैभन्दा सामान्य डाटा ढाँचा)"

msgid "mime_log"
msgstr "लग फाइल (प्रणाली डाटा, अनुप्रयोग सञ्चालन जानकारी रेकर्ड गर्ने सादा पाठ फाइल, समस्या निवारण, प्रदर्शन विश्लेषण, सुरक्षा लेखापरीक्षणको लागि प्रयोग गरिन्छ। मानक ढाँचाहरू जस्तै Apache combined log, Nginx access log, syslog आदि)"

msgid "mime_page"
msgstr "HTML वेब पृष्ठ (Tim Berners-Lee ले सन् १९८९ मा वर्ल्ड वाइड वेब आविष्कार गरे, सन् १९९० मा HTML/HTTP/URL तीन प्रविधिहरू परिभाषित गरे, पेटेन्ट नमागी नि:शुल्क प्रदान गरे। HTML5 सन् २०१४ मा W3C मापदण्ड बन्यो, प्रदर्शन, मल्टिमिडिया र छपाइ समर्थन गर्छ। सन् २०१६ मा ट्युरिङ पुरस्कार प्राप्त)"

msgid "mime_khtml"
msgstr "KHTML वेब पृष्ठ इन्जिन (सन् १९९८ मा KDE 2.0 मा प्रकाशित, Konqueror ब्राउजरको रेन्डरिङ इन्जिन। Apple ले सन् २००१ मा KHTML को आधारमा WebKit सिर्जना गर्यो। Google ले सन् २००८ मा WebKit बाट Blink सिर्जना गर्यो, Chrome, Edge, Safari ब्राउजरहरूको मूल बन्यो। KHTML खुला स्रोत समुदायको नमूना हो जसले आधुनिक ब्राउजर इन्जिनहरूको जग बसायो, यसको प्रविधि सम्पदा WebKit/Blink मार्फत जारी छ)"

msgid "mime_script"
msgstr "गतिशील स्क्रिप्ट (व्याख्याात्मक भाषा, कम्पाइल गर्नुपर्दैन। ASP, JSP, CGI, ColdFusion, Tcl, VBScript आदि समावेश छ, प्रारम्भिक वेब विकास, प्रणाली व्यवस्थापन, स्वचालित कार्यहरूमा व्यापक रूपमा प्रयोग गरिन्छ। Python, Ruby, JavaScript जस्ता आधुनिक स्क्रिप्ट भाषाहरू full-stack विकासको मुख्य भाषाहरूको रूपमा विकसित भएका छन्)"

msgid "mime_js"
msgstr "JavaScript स्क्रिप्ट (Brendan Eich ले सन् १९९५ मा Netscape मा १० दिनमा सिर्जना गरे, ब्राउजरको मूल प्रोग्रामिङ भाषा। ECMAScript सन् १९९७ मा मापदण्डीकृत भयो। Node.js सन् २००९ मा जन्मियो र यसलाई full-stack भाषा बनायो। npm विश्वको सबैभन्दा ठूलो प्याकेज व्यवस्थापक हो। GitHub मा लगातार वर्षौंसम्म सबैभन्दा लोकप्रिय प्रोग्रामिङ भाषा)"

msgid "mime_py"
msgstr "Python स्क्रिप्ट (Guido van Rossum ले सन् १९९१ मा सिर्जना गरे, अनिवार्य इन्डेन्टेसन, सरल syntax को लागि प्रसिद्ध। वेब विकास, डाटा विज्ञान, कृत्रिम बुद्धिमत्ता, स्वचालित सञ्चालनमा व्यापक रूपमा प्रयोग गरिन्छ। TIOBE को वार्षिक प्रोग्रामिङ भाषा पुरस्कार धेरै पटक प्राप्त)"

msgid "mime_sh"
msgstr "Shell स्क्रिप्ट (Unix सन् १९७१ मा जन्मियो, आदेश स्क्रिप्ट भाषा। प्रणाली व्यवस्थापन, स्वचालित कार्य, सेवा सुरु, तैनाती स्क्रिप्टको लागि प्रयोग गरिन्छ। Linux प्रशासनको लागि आवश्यक सीप)"

msgid "mime_rb"
msgstr "Ruby स्क्रिप्ट (Yukihiro Matsumoto ले सन् १९९५ मा सिर्जना गरे, विकासकर्ताको खुशीलाई केन्द्रित गर्दछ। Ruby on Rails framework ले 'कन्फिगरेसन भन्दा कन्भेन्सन' को विकास प्रतिमान सुरु गर्यो, आधुनिक वेब framework डिजाइनलाई प्रभाव पार्यो)"

msgid "mime_pl"
msgstr "Perl स्क्रिप्ट (Larry Wall ले सन् १९८७ मा सिर्जना गरे, व्यावहारिकताको लागि प्रसिद्ध, 'स्विस आर्मी चक्कु' को रूपमा परिचित। CPAN आधुनिक भाषा प्याकेज व्यवस्थापकको अग्रदूत हो, पाठ प्रशोधन, प्रणाली व्यवस्थापन र CGI मा गहिरो प्रभाव छ)"

msgid "mime_php"
msgstr "PHP गतिशील वेब पृष्ठ (Rasmus Lerdorf ले सन् १९९५ मा सिर्जना गरे, विशेष गरी वेब विकासको लागि डिजाइन गरिएको। विश्वभरका ७०% भन्दा बढी वेबसाइटहरूले प्रयोग गर्छन्, WordPress, Facebook, Wikipedia जस्ता प्लेटफर्महरू चलाउँदछ। PHP 8 ले JIT कम्पाइल प्रस्तुत गर्यो, प्रदर्शनमा उल्लेख्य सुधार गर्यो)"

msgid "mime_image"
msgstr "तस्वीर फाइल"

msgid "mime_document"
msgstr "कागजात फाइल"

msgid "mime_package"
msgstr "सफ्टवेयर प्याकेज"

msgid "mime_archive"
msgstr "Gzip कम्प्रेस गरिएको फाइल (सन् १९९२ मा GNU परियोजना, DEFLATE एल्गोरिदममा आधारित। वेबमा गतिशील प्रतिक्रिया सामग्री कम्प्रेस गर्न प्रयोग गरिन्छ, कम्प्रेसन दर सामान्यतया ६०-९०%। सन् २०१५ पछि केही परिस्थितिहरूमा Brotli द्वारा प्रतिस्थापित भयो, तर सर्भरपट्टि सबैभन्दा व्यापक रूपमा समर्थित कम्प्रेसन ढाँचाको रूपमा रहिरहेको छ)"

msgid "mime_audio"
msgstr "अडियो फाइल"

msgid "mime_video"
msgstr "भिडियो फाइल"

msgid "mime_jscript"
msgstr "JavaScript (Brendan Eich द्वारा सन् १९९५ मा विकसित)"

msgid "mime_json"
msgstr "JSON डाटा (Douglas Crockford ले सन् २००१ मा प्रस्ताव गरे, हल्का डाटा आदानप्रदान ढाँचा, Web API को वास्तविक मापदण्ड)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft ले सन् १९९६ मा विकसित गरेको, Windows स्क्रिप्ट भाषा, ASP वेब पृष्ठ र Windows व्यवस्थापन स्क्रिप्टको लागि प्रयोग गरिन्छ। PowerShell र JavaScript को प्रसारसँगै बिस्तारै हट्दै गएको छ)"

msgid "mime_conf"
msgstr "कन्फिगरेसन फाइल (सफ्टवेयर कन्फिगरेसन पाठ ढाँचामा भण्डारण गर्छ, सामान्य ढाँचाहरू: INI, JSON, YAML, TOML, XML। Linux प्रणाली कन्फिगरेसन प्रायः /etc निर्देशिकामा हुन्छ)"

msgid "mime_css"
msgstr "CSS स्टाइल शीट (W3C ले सन् १९९६ डिसेम्बरमा CSS1 पहिलो आधिकारिक मापदण्ड प्रकाशित गर्यो, CSS2 ले सन् १९९८ मा स्थिति निर्धारण र मिडिया प्रकार थप्यो, सन् २०११ देखि CSS3 मोड्युलरले कुनाको गोलाइ, एनिमेसन, लचिलो बाकस, ग्रिड लेआउट र उत्तरदायी डिजाइन प्रस्तुत गर्यो। HTML र JavaScript सँगै front-end को तीन मुख्य प्रविधिहरू मध्ये एक हो, सबै आधुनिक ब्राउजरहरू (Chrome, Firefox, Safari, Edge) ले मूल रूपमा समर्थन गर्छन्, वेब पृष्ठ शैली परिभाषित गर्नको लागि एक मात्र मापदण्ड हो)"

msgid "mime_xsl"
msgstr "XSL स्टाइल शीट (सन् १९९९ मा W3C मापदण्ड, XML कागजात रूपान्तरण भाषा, XML लाई HTML/PDF/पाठमा रूपान्तरण गर्न सक्छ। JSON को प्रसारपछि प्रयोग घटेको छ)"

msgid "mime_runtime"
msgstr "कार्यान्वयन योग्य फाइल (EXE, ELF, Mach-O आदि अपरेटिङ सिस्टमको कार्यान्वयन योग्य ढाँचा, मेसिन कोड र लोडिङ जानकारी समावेश गर्दछ)"

msgid "mime_library"
msgstr "पुस्तकालय फाइल (DLL, SO, dylib आदि गतिशील लिङ्क पुस्तकालयहरू, प्रोग्राम चल्दा लोड हुने साझा कोड)"

msgid "mime_swf"
msgstr "Flash एनिमेसन (Macromedia ले सन् १९९६ मा विकसित गरेको, पछि Adobe को स्वामित्वमा। अन्तरक्रियात्मक वेब एनिमेसन मापदण्ड, एक पटक इन्टरनेटमा गेम र एनिमेसनहरूमा प्रभुत्व जमाएको थियो। कमजोरीहरू: प्लगइनमा निर्भरता, मोबाइल समर्थन नभएको, उच्च सुरक्षा जोखिम। Adobe ले सन् २०१७ मा हटाउने घोषणा गर्यो, सन् २०२० मा पूर्ण रूपमा समर्थन बन्द गर्यो, HTML5/CSS3/JS द्वारा प्रतिस्थापित भयो)"

msgid "mime_dtd"
msgstr "DTD (कागजात प्रकार परिभाषा) (XML विशिष्टता, XML कागजात संरचना परिभाषित गर्दछ, XML को वैधता प्रमाणित गर्न प्रयोग गरिन्छ)"

msgid "mime_csv"
msgstr "CSV डाटा ढाँचा (कमा द्वारा छुट्याइएको मान, साधारण तालिका डाटा ढाँचा, Excel र डाटाबेस आयात निर्यात मापदण्ड)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java अनुप्रयोग लञ्चर, सन् २००० को दशकमा Java डेस्कटप अनुप्रयोग वितरण प्रविधि, अहिले हटाइसकिएको छ)"

msgid "mime_lit"
msgstr "Microsoft Reader ई-पुस्तक (Microsoft ले सन् २००० मा लन्च गरेको, LIT ढाँचा, हटाइसकिएको छ)"

msgid "mime_svg"
msgstr "SVG भेक्टर ग्राफिक्स (सन् १९९९ मा W3C मापदण्ड, Microsoft ले आफ्नै VML ढाँचालाई लामो समयसम्म प्रवर्द्धन गरेकोले IE ब्राउजरले सन् २०११ सम्म मात्र समर्थन गर्यो, जसले प्रसारमा ढिलाइ गर्यो। सन् २०१५ पछि IE हटाइएपछि र उच्च रिजोल्युसन स्क्रिनको प्रसारसँगै, यो आइकन र लोगोहरूको लागि पहिलो छनौट ढाँचा बन्यो)"

msgid "mime_ai"
msgstr "Adobe Illustrator भेक्टर ग्राफिक्स (सन् १९८७ मा लन्च गरिएको, उद्योग मापदण्ड भेक्टर ग्राफिक्स ढाँचा, छपाइ डिजाइन, लोगो, आइकनको लागि पहिलो छनौट)"

msgid "mime_phshop"
msgstr "Photoshop तस्वीर (Adobe ले सन् १९९० मा लन्च गरेको, Photoshop को मूल फाइल ढाँचा PSD, तस्वीर प्रशोधन उद्योग मापदण्ड)"

msgid "mime_ttf"
msgstr "TrueType फन्ट (Apple र Microsoft ले सन् १९८९ मा संयुक्त रूपमा विकास गरे, भेक्टर फन्ट ढाँचा, स्क्रिन प्रदर्शन र छपाइ एकरूप, आधुनिक अपरेटिङ सिस्टमको पूर्वनिर्धारित फन्ट ढाँचा)"

msgid "mime_fon"
msgstr "WOFF2 वेब फन्ट (W3C ले सन् २०१४ मा सिफारिस गरेको, Brotli कम्प्रेसन एल्गोरिदम प्रयोग गर्छ, पुरानो WOFF को तुलनामा आकार लगभग ३०% घट्छ, TTF/OTF को तुलनामा ५०% भन्दा बढी घट्छ, हाल सबै आधुनिक ब्राउजरहरूले समर्थन गर्छन्, आधुनिक वेब फन्टको लागि पहिलो छनौट ढाँचा हो, ९८% भन्दा बढी ब्राउजरहरूले समर्थन गर्छन्)"

msgid "mime_pdf"
msgstr "PDF कागजात (Adobe ले सन् १९९३ मा विकास गरेको, सन् २००८ मा ISO मापदण्ड बन्यो। क्रस-प्लेटफर्म कागजात ढाँचा, ढाँचा एकरूपता कायम राख्छ, इलेक्ट्रोनिक कागजात वितरणको विश्वव्यापी मापदण्ड हो)"

msgid "mime_dotnet"
msgstr "ASP.NET गतिशील पृष्ठ (Microsoft ले सन् २००२ मा लन्च गरेको, Windows प्लेटफर्ममा गतिशील वेब पृष्ठ प्रविधि, .NET Framework को एक भाग)"

msgid "mime_mdb"
msgstr "Access डाटाबेस (Microsoft Access डाटाबेस फाइल, सन् १९९२ मा लन्च गरिएको, Windows डेस्कटप डाटाबेस समाधान)"

msgid "mime_md"
msgstr "Markdown कागजात (John Gruber ले सन् २००४ मा सिर्जना गरे, को syntax डिजाइन reStructuredText र Setext बाट प्रभावित छ। मुख्य डिजाइन दर्शन 'पढ्न सकिन्छ भने प्रस्तुत गर्न सकिन्छ' हो। मूल कार्यान्वयन Markdown.pl ले Perl नियमित अभिव्यक्ति प्रयोग गर्दछ। व्युत्पन्न विशिष्टताहरूमा GFM (२०१३), CommonMark (२०१७), Pandoc Markdown आदि समावेश छन्। GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress जस्ता पारिस्थितिकी तंत्रहरू चलाउँदछ, स्थिर वेबसाइट जेनरेटर र विकासकर्ता कागजातको लागि वास्तविक मापदण्ड ढाँचा बनेको छ)"

msgid "mime_crystal"
msgstr "Crystal Reports रिपोर्ट ढाँचा (SAP को व्यापार बुद्धिमत्ता रिपोर्ट, उद्यम रिपोर्ट मापदण्ड ढाँचा)"

msgid "mime_libreoffice"
msgstr "LibreOffice कागजात (The Document Foundation ले सन् २०१० मा विकास गरेको, OpenOffice को शाखा, ODF मापदण्ड कार्यान्वयन, मुख्यधारा खुला स्रोत कार्यालय सुइट)"

msgid "mime_encrypt"
msgstr "इन्क्रिप्टेड फाइल (फाइल हेर्नको लागि डिक्रिप्ट गर्नुपर्छ, सामान्य एक्सटेन्सन: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS ट्र्याक डाटा (GPS आदानप्रदान ढाँचा, भौगोलिक स्थिति डाटा रेकर्ड गर्दछ, खेल घडी र नेभिगेसन उपकरणहरूको लागि सामान्य ढाँचा)"

msgid "mime_diskimage"
msgstr "डिस्क छवि (DMG, ISO, IMG आदि अप्टिकल डिस्क/डिस्क छवि फाइलहरू, सफ्टवेयर वितरण वा भण्डारण मिडिया ब्याकअपको लागि प्रयोग गरिन्छ)"

msgid "mime_vm"
msgstr "भर्चुअल मेसिन छवि (VMDK, VDI, VHDX, OVA आदि भर्चुअल मेसिन डिस्क फाइलहरू, VMware, VirtualBox, Hyper-V जस्तो भर्चुअलाइजेसन प्लेटफर्महरूको लागि ढाँचा)"

msgid "mime_torrent"
msgstr "BitTorrent बीज फाइल (Bram Cohen ले सन् २००१ मा आविष्कार गरे, P2P डाउनलोड सूचकांक फाइल, फाइल मेटाडाटा र ट्र्याकर जानकारी समावेश गर्दछ)"

msgid "mime_gis"
msgstr "GIS भौगोलिक सूचना प्रणाली डाटा (Shapefile, GeoJSON आदि भौगोलिक स्थान डाटा ढाँचाहरू, नक्सा र स्थानिय विश्लेषणको लागि प्रयोग गरिन्छ)"

msgid "mime_ebook"
msgstr "ई-पुस्तक (EPUB, MOBI, AZW आदि ई-पुस्तक ढाँचाहरू। EPUB अन्तर्राष्ट्रिय मापदण्ड हो, MOBI/AZW Amazon Kindle को लागि ढाँचा हो)"

msgid "mime_avif"
msgstr "AVIF छवि (Alliance for Open Media ले सन् २०१९ मा लन्च गरेको, AV1 कोडेकमा आधारित, WebP भन्दा ५०% उच्च कम्प्रेसन दर, नयाँ पुस्ताको वेब छवि मापदण्ड)"

msgid "mime_markdown"
msgstr "Markdown कागजात (John Gruber ले सन् २००४ मा डिजाइन गरेको, हल्का मार्कअप भाषा, GitHub README, प्राविधिक कागजात, फोरम पोस्टको लागि सामान्य ढाँचा)"

msgid "mime_yaml"
msgstr "YAML कन्फिगरेसन (Clark Evans ले सन् २००१ मा डिजाइन गरेको, मानव-पठनीय डाटा सिरियलाइजेसन ढाँचा, Kubernetes, Ansible, Docker Compose को लागि कन्फिगरेसन फाइल मापदण्ड)"

msgid "mime_toml"
msgstr "TOML कन्फिगरेसन (Tom Preston-Werner ले सन् २०१३ मा डिजाइन गरेको, 'Tom's Obvious Minimal Language', Rust/Cargo, Python/pip, Go जस्ता आधुनिक उपकरणहरूको लागि कन्फिगरेसन फाइल ढाँचा)"

msgid "mime_vue"
msgstr "Vue कम्पोनेन्ट फाइल (2014 मा इभान यू द्वारा प्रस्तुत, प्रगतिशील JavaScript फ्रेमवर्क। एकल-फाइल कम्पोनेन्टहरू (SFC) मार्फत यसले HTML, CSS र JS लाई पूर्ण रूपमा संयोजन गर्दछ, विकास दक्षतालाई ठूलो मात्रामा वृद्धि गर्दछ। यो विश्वको सबैभन्दा लोकप्रिय फ्रन्टएन्ड फ्रेमवर्कहरू मध्ये एक हो। साथै, VitePress जस्ता आधुनिक स्ट्याटिक साइट जेनरेटरहरूको मूलको रूपमा, यो अन्तरक्रियात्मक प्राविधिक कागजात र ब्लगहरू सञ्चालन गर्न व्यापक रूपमा प्रयोग गरिन्छ।)"

msgid "mime_wasm"
msgstr "WebAssembly मोड्युल (सन् २०१७ मा W3C मापदण्ड, ब्राउजरमा उच्च प्रदर्शन कार्यान्वयन ढाँचा, C/C++/Rust/R लाई लक्ष्यको रूपमा कम्पाइल गर्न सकिन्छ, प्रदर्शन मूल नजिक)"

msgid "mime_jsx"
msgstr "React JSX कम्पोनेन्ट (Facebook ले सन् २०१३ मा JavaScript XML लन्च गरेको, React framework को कम्पोनेन्ट syntax, HTML लाई JavaScript मा लेख्ने अभिनव प्रतिमान)"

msgid "mime_tsx"
msgstr "TypeScript TSX कम्पोनेन्ट (Microsoft ले सन् २०१२ मा विकास गरेको, TypeScript + JSX, React प्रकार-सुरक्षित विकासको लागि मानक लेखन विधि)"

msgid "mime_heif"
msgstr "HEIF छवि (सन् २०१५ मा MPEG मापदण्ड, उच्च दक्षता छवि फाइल ढाँचा, Apple पारिस्थितिकी तंत्रमा व्यापक रूपमा प्रयोग गरिन्छ)"

msgid "mime_heic"
msgstr "HEIC छवि (Apple को HEIF कार्यान्वयन, iPhone को पूर्वनिर्धारित फोटो ढाँचा, iOS/macOS मा मूल रूपमा समर्थित)"

msgid "mime_gltf"
msgstr "GLTF 3D मोडेल (GL प्रसारण ढाँचा, '3D को JPEG', Khronos Group ले सन् २०१५ मा प्रकाशित गरेको, Web 3D मापदण्ड ढाँचा)"

msgid "mime_glb"
msgstr "GLB बाइनरी 3D मोडेल (GLTF को बाइनरी संस्करण, एकल फाइलले सबै स्रोतहरू समावेश गर्दछ, 3D दृश्य वितरणको लागि प्रयोग गरिन्छ)"

msgid "mime_gls"
msgstr "GLOSSARY शब्दावली (शब्द परिभाषा फाइल, कागजात प्रणालीमा शब्द व्यवस्थापनको लागि प्रयोग गरिन्छ)"

msgid "mime_cbz"
msgstr "CBZ कमिक पुस्तक (ZIP कम्प्रेस गरिएको कमिक तस्वीरहरू, कमिक सङ्कलनको लागि सामान्य ढाँचा)"

msgid "mime_cbr"
msgstr "CBR कमिक पुस्तक (RAR कम्प्रेस गरिएको कमिक तस्वीरहरू, कमिक सङ्कलनको लागि सामान्य ढाँचा)"

msgid "mime_fb2"
msgstr "FB2 ई-पुस्तक (FictionBook 2.0, रूसी ई-पुस्तक ढाँचा, XML संरचना, खुला स्रोत पाठकहरू द्वारा व्यापक रूपमा समर्थित)"

msgid "mime_kepub"
msgstr "KEPUB ई-पुस्तक (Kobo को लागि विशेष EPUB ढाँचा, Kobo ई-पुस्तक पाठकको लागि अनुकूलित ढाँचा)"

msgid "mime_m4b"
msgstr "M4B अडियो पुस्तक (MPEG-4 अडियो पुस्तक ढाँचा, बुकमार्क समर्थन गर्दछ, iTunes अडियो पुस्तक ढाँचा)"

msgid "mime_kfx"
msgstr "Kindle KFX ढाँचा (Amazon ले सन् २०१५ मा लन्च गरेको, Kindle को लागि विशेष ई-पुस्तक ढाँचा, उन्नत लेआउट र द्रुत पृष्ठ पल्टाउने समर्थन गर्दछ)"

msgid "mime_chm"
msgstr "CHM सहायता फाइल (Microsoft ले सन् १९९७ मा लन्च गरेको, कम्पाइल गरिएको HTML सहायता ढाँचा, Windows सफ्टवेयर सहायता कागजात मापदण्ड)"

msgid "mime_mht"
msgstr "MHT वेब पुरालेख (Microsoft ले सन् १९९९ मा लन्च गरेको, एकल फाइल वेब पृष्ठ ढाँचा, IE ब्राउजरको वेब पृष्ठ सङ्ग्रह ढाँचा)"

msgid "mime_wml"
msgstr "WML ताररहित मार्कअप भाषा (सन् १९९९ मा WAP मापदण्ड, प्रारम्भिक सुविधा फोनहरूको वेब पृष्ठ फाइलहरूको लागि प्रयोग गरिन्थ्यो, हटाइसकिएको छ)"

msgid "mime_xhtml"
msgstr "XHTML वेब पृष्ठ (सन् २००० मा W3C मापदण्ड, HTML को XML संस्करण, अधिक कडा syntax। W3C ले सन् २००९ मा मर्मत बन्द गर्यो, ध्यान HTML5 तिर सार्यो)"

msgid "mime_xml"
msgstr "XML कागजात (सन् १९९८ मा W3C मापदण्ड, विस्तार योग्य मार्कअप भाषा, वेब सेवाहरू, कन्फिगरेसन फाइलहरू, डाटा आदानप्रदानको लागि आधारभूत ढाँचा)"

msgid "mime_sgml"
msgstr "SGML कागजात (सन् १९८६ मा ISO मापदण्ड, HTML को अग्रज, मापदण्ड साधारण मार्कअप भाषा, XML र HTML दुवै SGML बाट व्युत्पन्न भएका हुन्)"

msgid "mime_apng"
msgstr "APNG एनिमेसन (Mozilla ले सन् २००४ मा विकास गरेको, PNG को एनिमेसन एक्सटेन्सन, GIF को आधुनिक विकल्प, साँचो रङ र पारदर्शिता समर्थन गर्दछ)"

msgid "mime_bmp"
msgstr "BMP बिटम्याप (Windows बिटम्याप ढाँचा, Windows 1.0 देखि नै मूल रूपमा समर्थित। असम्पीडित, फाइल आकार ठुलो, तर यसको सरल संरचना र थप कोडेकहरूको आवश्यकता नभएकोले, Windows 11 को स्निपिङ टुल, पेन्ट प्रोग्राम, EXE/MSI इन्स्टलेसन प्याकेजहरूमा आइकन स्रोतहरू, कर्सर फाइलहरू, र केही पुराना ड्राइभरहरूमा अझै प्रयोग गरिन्छ। समान छवि गुणस्तरमा, फाइल आकार PNG भन्दा लगभग 3-10 गुणा ठुलो हुन्छ। धेरैजसो अवस्थामा यसलाई PNG/JPEG द्वारा प्रतिस्थापित गरिएको छ, तर Windows पारिस्थितिकी प्रणालीले अझै व्यापक अनुकूलता कायम राखेको छ)"

msgid "mime_cdr"
msgstr "CDR भेक्टर ग्राफिक्स (CorelDRAW को लागि विशेष ढाँचा, क्यानाडाको Corel कम्पनी, भेक्टर ग्राफिक्स डिजाइन सफ्टवेयर)"

msgid "mime_gif"
msgstr "GIF छवि (CompuServe ले सन् १९८७ मा विकास गरेको, २५६ रङ एनिमेटेड छवि ढाँचा। कमजोरीहरू: कम रङ, कम छवि गुणस्तर, पारदर्शिता समर्थन गर्दैन, ठूलो फाइल, कम फ्रेम दर। APNG, WebP जस्ता आधुनिक एनिमेटेड छवि ढाँचाहरूद्वारा प्रतिस्थापित भयो)"

msgid "mime_ico"
msgstr "ICO आइकन (Windows आइकन फाइल ढाँचा, बहु-रिजोल्युसन समर्थन गर्दछ, वेबसाइट favicon को लागि मानक ढाँचा)"

msgid "mime_jpeg"
msgstr "JPEG छवि (सन् १९९२ मा ISO मापदण्ड, फोटोहरूको लागि हानीयुक्त कम्प्रेसन ढाँचा, इन्टरनेटमा फोटोहरूको वास्तविक मापदण्ड)"

msgid "mime_jpg"
msgstr "JPEG छवि (सन् १९९२ मा ISO मापदण्ड, फोटोहरूको लागि हानीयुक्त कम्प्रेसन ढाँचा, इन्टरनेटमा फोटोहरूको वास्तविक मापदण्ड)"

msgid "mime_png"
msgstr "PNG छवि (W3C ले सन् १९९६ मा सिफारिस गरेको, साँचो रङ र पारदर्शिता समर्थन गर्दछ, GIF को स्थिर विकल्प, इन्टरनेटमा हानीरहित छवि मापदण्ड)"

msgid "mime_ps"
msgstr "PostScript पृष्ठ विवरण फाइल (Adobe ले सन् १९८५ मा लन्च गरेको, पृष्ठ विवरण भाषा, PDF को अग्रज, छपाइ र प्रकाशनको लागि प्रयोग गरिन्छ)"

msgid "mime_psb"
msgstr "PSB ठूलो कागजात (Adobe Photoshop को अति ठूलो छवि ढाँचा, २ GB वा ३०००० पिक्सेल भन्दा ठूला विशाल छविहरू समर्थन गर्दछ)"

msgid "mime_psd"
msgstr "PSD छवि (Adobe Photoshop को मूल फाइल, तहहरू, च्यानलहरू, पथहरू समर्थन गर्दछ, छवि प्रशोधन उद्योग मापदण्ड ढाँचा)"

msgid "mime_webp"
msgstr "WebP छवि (Google ले सन् २०१० मा विकास गरेको, वेब छवि ढाँचा, हानीयुक्त/हानीरहित कम्प्रेसन र एनिमेसन समर्थन गर्दछ, PNG भन्दा २५-३५% र JPEG भन्दा २५% उच्च कम्प्रेसन दर)"

msgid "mime_woff"
msgstr "WOFF वेब फन्ट (सन् २००९ मा सिर्जना गरिएको, सन् २०१८ मा W3C मापदण्ड। TrueType/OpenType मा आधारित कम्प्रेस गरिएको, वेब फन्ट लोडिङ अनुकूलन, आधुनिक वेबसाइट आइकन फन्टको लागि मानक ढाँचा)"

msgid "mime_7z"
msgstr "7z कम्प्रेस गरिएको फाइल (Igor Pavlov ले सन् १९९९ मा विकास गरेको, 7-Zip प्रोग्रामको विशेष ढाँचा। LZMA एल्गोरिदम, उच्च कम्प्रेसन दर, खुला स्रोत र नि:शुल्क। समान कम्प्रेसन दरमा 7z ढाँचा सामान्यतया ZIP भन्दा ३०-५०% सानो हुन्छ, खुला स्रोत समुदाय र सफ्टवेयर वितरणको लागि सामान्य ढाँचा हो)"

msgid "mime_ace"
msgstr "ACE कम्प्रेस गरिएको फाइल (सन् १९९० को दशकमा विकसित, WinACE प्रोग्राम ढाँचा। एक पटक RAR सँग प्रतिस्पर्धा गरेको थियो, कम्प्रेसन दर उच्च थियो। सन् २००७ मा विकास बन्द भयो, अहिले 7z/RAR द्वारा प्रतिस्थापित भयो, कम प्रयोग हुन्छ)"

msgid "mime_bz2"
msgstr "BZIP2 कम्प्रेस गरिएको फाइल (Julian Seward ले सन् १९९६ मा विकास गरेको, ब्लक क्रमबद्ध कम्प्रेसन एल्गोरिदम। GZIP भन्दा १५-२०% उच्च कम्प्रेसन दर तर ढिलो। Linux kernel स्रोत कोड, खुला स्रोत सफ्टवेयर प्याकेजहरूको लागि सामान्य ढाँचा, एक्सटेन्सन .bz2)"

msgid "mime_cab"
msgstr "CAB कम्प्रेस गरिएको फाइल (Microsoft ले सन् १९९५ मा विकास गरेको, Cabinet ढाँचा। Windows स्थापना प्याकेज ढाँचा, ड्राइभरहरू, प्रणाली फाइल वितरणको लागि प्रयोग गरिन्छ। Windows Installer (MSI) ले फाइलहरू भण्डारण गर्न CAB प्रयोग गर्दछ)"

msgid "mime_dmg"
msgstr "डीएमजी डिस्क छवि (Apple ले सन् १९८० को दशकमा लन्च गरेको, Disk Image ढाँचा। macOS सफ्टवेयर वितरण मानक ढाँचा, भर्चुअल डिस्कको रूपमा माउन्ट गर्न डबल-क्लिक गर्नुहोस्, अनुप्रयोग स्थापना गर्न तान्नुहोस् र छोड्नुहोस्। कम्प्रेसन र इन्क्रिप्सन समर्थन गर्दछ, Mac सफ्टवेर डाउनलोडको लागि मुख्य ढाँचा हो)"

msgid "mime_emz"
msgstr "EMZ कम्प्रेस गरिएको छवि (Windows कम्प्रेस गरिएको संवर्धित मेटाफाइल, EMF को कम्प्रेस गरिएको संस्करण। Office कागजातहरूमा भेक्टर ग्राफिक्स भण्डारण ढाँचा, मूलतः GZIP कम्प्रेस गरिएको EMF फाइल हो)"

msgid "mime_gz"
msgstr "GZIP कम्प्रेस गरिएको फाइल (Jean-loup Gailly र Mark Adler ले सन् १९९२ मा विकास गरे, GNU परियोजना। Unix/Linux को मानक कम्प्रेसन उपकरण, HTTP प्रसारण कम्प्रेसनको लागि सामान्य ढाँचा। एक्सटेन्सन .gz, प्रायः TAR सँग जोडेर प्रयोग गरिन्छ)"

msgid "mime_jar"
msgstr "JAR कम्प्रेस गरिएको फाइल (Sun Microsystems ले सन् १९९७ मा लन्च गरेको, Java ARchive ढाँचा। मूलतः ZIP फाइल हो, Java पुस्तकालयहरू र अनुप्रयोगहरू प्याकेज गर्न प्रयोग गरिन्छ। Maven, Gradle जस्ता Java पारिस्थितिकी तंत्रको मुख्य ढाँचा, Android ले पनि JAR प्रयोग गर्दछ)"

msgid "mime_lzma"
msgstr "LZMA कम्प्रेस गरिएको फाइल (Igor Pavlov ले सन् १९९८ मा विकास गरेको, Lempel-Ziv-Markov chain एल्गोरिदम। 7z ढाँचाको मुख्य कम्प्रेसन एल्गोरिदम, उच्च कम्प्रेसन दर, डिकम्प्रेसन गति द्रुत। फर्मवेयर र एम्बेडेड प्रणाली सफ्टवेयर वितरणको लागि प्रयोग गरिन्छ)"

msgid "mime_rar"
msgstr "RAR कम्प्रेस गरिएको फाइल (Eugene Roshal ले सन् १९९३ मा विकास गरेको, Roshal ARchive ढाँचा। उच्च कम्प्रेसन दर, भोल्युम विभाजन र पुन:प्राप्ति रेकर्ड समर्थन गर्दछ। WinRAR प्रोग्राम ढाँचा, कम्प्रेसन दर ZIP भन्दा राम्रो तर भुक्तान सफ्टवेयर चाहिन्छ, unrar जस्ता खुला स्रोत उपकरणहरूले डिकम्प्रेस गर्न सक्छन्)"

msgid "mime_tar"
msgstr "TAR सङ्ग्रह फाइल (Unix V7 ले सन् १९७९ मा परिचय गरायो, Tape ARchive ढाँचा। टेप सङ्ग्रह ढाँचा, कम्प्रेस गर्दैन केवल प्याक गर्छ, प्रायः GZIP/BZIP2/XZ सँग जोडेर प्रयोग गरिन्छ। Linux प्याकेज स्रोत कोड, Docker छवि तह भण्डारणले TAR ढाँचा प्रयोग गर्दछ)"

msgid "mime_tgz"
msgstr "TGZ कम्प्रेस गरिएको फाइल (TAR + GZIP संयोजन ढाँचा, एक्सटेन्सन .tgz वा .tar.gz। Unix/Linux सफ्टवेयर प्याकेजहरूको लागि सबैभन्दा सामान्य वितरण ढाँचा, स्रोत कोड प्याकेज, बाइनरी प्याकेजहरू, व्यापक रूपमा प्रयोग गरिन्छ, 'डिकम्प्रेस गर्यो र प्रयोग गर्यो' को प्रतिनिधि)"

msgid "mime_tbz2"
msgstr "TBZ2 कम्प्रेस गरिएको फाइल (TAR + BZIP2 संयोजन ढाँचा, एक्सटेन्सन .tbz2 वा .tar.bz2। TGZ भन्दा १५-२०% उच्च कम्प्रेसन दर, ठूला फाइलहरू वितरणको लागि उपयुक्त, Linux kernel ले यो ढाँचा लामो समयदेखि प्रयोग गर्दै आएको छ)"

msgid "mime_xz"
msgstr "XZ कम्प्रेस गरिएको फाइल (सन् २००९ मा लन्च गरिएको, LZMA2 एल्गोरिदममा आधारित। अत्यधिक उच्च कम्प्रेसन दर, GZIP भन्दा ३०-५०% उच्च, डिकम्प्रेसन गति अपेक्षाकृत द्रुत। Linux kernel, प्याकेज व्यवस्थापकहरू (जस्तै Debian को .deb भित्र) ले व्यापक रूपमा प्रयोग गर्छन्, हालको Linux पारिस्थितिकी तंत्रमा सिफारिस गरिएको ढाँचा हो)"

msgid "mime_z"
msgstr "Z कम्प्रेस गरिएको फाइल (सन् १९८५ मा Unix compress कमाण्ड ढाँचा, LZW एल्गोरिदम। प्रारम्भिक Unix कम्प्रेसन ढाँचा, GZIP द्वारा प्रतिस्थापित भयो। एक्सटेन्सन .Z, आधुनिक प्रणालीहरूमा कम प्रयोग गरिन्छ)"

msgid "mime_zip"
msgstr "ZIP कम्प्रेस गरिएको फाइल (Phil Katz ले सन् १९८९ मा विकास गरेको, PKZIP ढाँचा। Windows मा मूल रूपमा समर्थित, इन्टरनेटमा सबैभन्दा सामान्य कम्प्रेसन ढाँचा। धेरै फाइलहरू, निर्देशिका संरचना समर्थन गर्दछ, कम्प्रेसन एल्गोरिदम छनौट गर्न सकिन्छ। Java को JAR, Android को APK, Office कागजातको DOCX/XLSX सबै ZIP ढाँचामा आधारित छन्)"

msgid "mime_zst"
msgstr "Zstandard कम्प्रेस गरिएको फाइल (Facebook ले सन् २०१५ मा विकास गरेको, Yann Collet द्वारा डिजाइन गरिएको। उच्च-गति कम्प्रेसन एल्गोरिदम, कम्प्रेसन दर LZMA नजिक, गति GZIP भन्दा धेरै तीव्र। Linux kernel 5.9+ ले समर्थन गर्दछ, Arch Linux pacman, Debian APT ले बिस्तारै अपनाउँदै छन्, नयाँ पुस्ताको कम्प्रेसन मापदण्ड हो)"

msgid "mime_lz4"
msgstr "LZ4 कम्प्रेस गरिएको फाइल (Yann Collet ले सन् २०११ मा विकास गरेको, अत्यन्त द्रुत कम्प्रेसन एल्गोरिदम। कम्प्रेसन गति GZIP भन्दा १० गुणा भन्दा तीव्र, वास्तविक-समय कम्प्रेसन परिदृश्यहरूको लागि उपयुक्त। Linux kernel, OpenZFS, Hadoop ले व्यापक रूपमा प्रयोग गर्छन्, गति-प्राथमिकता परिदृश्यहरूको लागि पहिलो छनौट हो)"

msgid "mime_lzo"
msgstr "LZO कम्प्रेस गरिएको फाइल (Markus Oberhumer ले सन् १९९६ मा विकास गरेको, Lempel-Ziv-Oberhumer एल्गोरिदम। डिकम्प्रेसन गति अत्यन्त द्रुत, कम्प्रेसन दर साधारण। Linux kernel Squashfs, OpenWrt फर्मवेयरले प्रयोग गर्दछ, एम्बेडेड प्रणालीहरूको लागि उपयुक्त)"

msgid "mime_msi"
msgstr "MSI स्थापना प्याकेज (Microsoft ले सन् १९९९ मा लन्च गरेको, Windows Installer प्याकेज ढाँचा। Windows अनुप्रयोग स्थापना मानक ढाँचा, कारोबार रोलब्याक, कम्पोनेन्ट व्यवस्थापन, मौन स्थापना समर्थन गर्दछ। उद्यम-स्तर सफ्टवेयर वितरणको लागि पहिलो छनौट ढाँचा, अहिले पनि Windows सफ्टवेयर स्थापनाको लागि मुख्य धारा हो)"

msgid "mime_pkg"
msgstr "PKG स्थापना प्याकेज (macOS अनुप्रयोग स्थापना प्याकेज ढाँचा, Apple को Installer प्रविधिमा आधारित। macOS सफ्टवेयर वितरण मानक ढाँचा, कम्पोनेन्ट चयन, स्थापना स्क्रिप्ट, हटाउने प्रकार्य समर्थन गर्दछ। .pkg फाइल डबल-क्लिक गरेर स्थापना गर्न सकिन्छ, Mac App Store बाहिर सफ्टवेयरको लागि सामान्य वितरण विधि)"

msgid "mime_apk"
msgstr "APK एन्ड्रोइड एप्लिकेसन प्याकेज (गूगलले सन् २००८ मा परिचय गराएको, एन्ड्रोइड प्रणालीको परम्परागत एप्लिकेसन स्थापना ढाँचा। APK मूलतः ZIP प्याकेज हो जसमा कोड, स्रोतहरू, र म्यानिफेस्ट फाइल हुन्छ। सन् २०२१ देखि, गूगल प्लेले नयाँ एप्लिकेसनहरूलाई AAB ढाँचा प्रयोग गर्न आवश्यक बनाएको छ, तर APK अझै पनि डिबगिङ, तेस्रो-पक्ष स्टोरहरू, र साइडलोडिङको लागि प्रयोग गरिन्छ)"

msgid "mime_ipa"
msgstr "IPA iOS एप्लिकेसन प्याकेज (iOS App Store Package, iOS/iPadOS एप्लिकेसनहरूको लागि स्थापना ढाँचा। सन् २००८ मा iPhone SDK सँगै परिचय गराइएको। App Store मार्फत वितरण गर्न वा उद्यम प्रमाणपत्रद्वारा हस्ताक्षर गर्नुपर्छ। कार्यान्वयनयोग्य फाइल, स्रोतहरू, Info.plist, र हस्ताक्षर जानकारी समावेश गर्दछ)"

msgid "mime_hap"
msgstr "HAP हार्मोनीओएस एप्लिकेसन प्याकेज (HarmonyOS Ability Package, हार्मोनीओएस एप्लिकेसनको आधारभूत एकाई। सन् २०२० मा HarmonyOS 2.0 सँगै परिचय गराइएको। दुई प्रकारहरू समर्थन गर्दछ: entry र feature, हुवावे फोनहरू, ट्याब्लेटहरू, स्मार्टवाचहरू, र अन्य हार्मोनीओएस उपकरणहरूको लागि वितरण ढाँचा)"

msgid "mime_har"
msgstr "HAR हार्मोनीओएस स्थिर साझेदार पुस्तकालय (HarmonyOS Archive, हार्मोनीओएसको स्थिर साझेदार पुस्तकालय, धेरै HAP प्याकेजहरूद्वारा साझेदारी गर्न सकिन्छ, कम्पोनेन्ट-आधारित विकास र मोड्युल पुन: प्रयोगको लागि प्रयोग गरिन्छ)"

msgid "mime_aab"
msgstr "Android App Bundle (Google ले सन् २०१८ मा लन्च गरेको, सन् २०२१ देखि Google Play मा नयाँ अनुप्रयोगहरूको लागि यो ढाँचा अनिवार्य गरियो। AAB वितरण ढाँचा हो, Google Play ले यन्त्र कन्फिगरेसन (CPU आर्किटेक्चर, स्क्रिन घनत्व, भाषा) अनुसार अनुकूलित APK उत्पन्न गर्दछ, प्याकेज आकार औसत ३५% घटाउँदछ। विकासकर्ताले AAB अपलोड गर्दछ, प्रयोगकर्ताले APK डाउनलोड गर्दछ)"

msgid "mime_xapk"
msgstr "XAPK अनुप्रयोग प्याकेज (तेस्रो-पक्ष Android अनुप्रयोग विस्तार प्याकेज, APK + OBB डाटा फाइलहरू समावेश गर्दछ। ठूला गेमहरू र जटिल अनुप्रयोगहरूको लागि प्रयोग गरिन्छ, एकल-फाइल APK को १००MB सीमा समाधान गर्दछ। APKPure, APKMirror जस्ता तेस्रो-पक्ष अनुप्रयोग पसलहरूमा सामान्यतया पाइन्छ, Google को आधिकारिक ढाँचा होइन)"

msgid "mime_appx"
msgstr "Windows अनुप्रयोग प्याकेज (Microsoft ले सन् २०१२ मा लन्च गरेको, Windows 8/10/11 अनुप्रयोग स्थापना ढाँचा। UWP अनुप्रयोगहरू र डेस्कटप अनुप्रयोग रूपान्तरण समर्थन गर्दछ, Microsoft Store मार्फत वितरण गरिन्छ। सन् २०२४ मा Microsoft ले MSIX लाई उत्तराधिकारी ढाँचाको रूपमा लन्च गर्यो, बिस्तारै APPX प्रतिस्थापन गर्दै)"

msgid "mime_msix"
msgstr "MSIX अनुप्रयोग प्याकेज (Microsoft ले सन् २०१८ मा लन्च गरेको, Windows नयाँ पुस्ता अनुप्रयोग प्याकेजिङ ढाँचा। APPX र MSI को फाइदाहरू संयोजन गर्दछ, सबै Windows अनुप्रयोग प्रकारहरू समर्थन गर्दछ, Microsoft Store वा साइड-लोड मार्फत वितरण गर्न सकिन्छ, Windows 11 को लागि सिफारिस गरिएको ढाँचा हो)"

msgid "mime_appimage"
msgstr "AppImage अनुप्रयोग प्याकेज (सन् २००४ मा लन्च गरिएको, Linux स्थापना-रहित अनुप्रयोग ढाँचा। 'एउटा अनुप्रयोग एउटा फाइल', स्थापना बिना प्रत्यक्ष चल्छ, अधिकांश Linux वितरणहरू समर्थन गर्दछ, विकासकर्ताहरूको लागि Linux सफ्टवेयर वितरणको सामान्य विधि हो)"

msgid "mime_flatpak"
msgstr "Flatpak अनुप्रयोग प्याकेज (सन् २०१५ मा लन्च गरिएको, Linux स्यान्डबक्स अनुप्रयोग ढाँचा। वितरणहरू पार गर्न चल्छ, होस्ट प्रणालीबाट पृथक, Fedora, Red Hat द्वारा नेतृत्व विकास गरिएको, GNOME सफ्टवेयर केन्द्रको पूर्वनिर्धारित ढाँचा हो)"

msgid "mime_snap"
msgstr "Snap अनुप्रयोग प्याकेज (Canonical ले सन् २०१४ मा लन्च गरेको, Ubuntu मूल कम्पनीद्वारा विकसित, Linux साधारण अनुप्रयोग ढाँचा। स्वचालित अद्यावधिक, स्यान्डबक्स विलगीकरण, ४०+ Linux वितरणहरू समर्थन गर्दछ, Ubuntu सफ्टवेयर केन्द्रको पूर्वनिर्धारित ढाँचा हो)"

msgid "mime_deb"
msgstr "Debian सफ्टवेयर प्याकेज (Debian Project ले सन् १९९३ मा लन्च गरेको, Debian/Ubuntu र तिनीहरूको व्युत्पन्न संस्करणहरूको लागि मानक स्थापना ढाँचा। dpkg द्वारा व्यवस्थित, APT यसको प्याकेज व्यवस्थापक फ्रन्ट-एन्ड हो, Linux पारिस्थितिकी तंत्रमा सबैभन्दा परिपक्व प्याकेज ढाँचाहरू मध्ये एक हो, अहिले पनि Debian परिवारमा मुख्य धारा हो)"

msgid "mime_rpm"
msgstr "RPM सफ्टवेयर प्याकेज (Red Hat ले सन् १९९७ मा लन्च गरेको, Red Hat/Fedora/CentOS/SUSE जस्ता वितरणहरूको लागि मानक ढाँचा। RPM को पूर्ण रूप 'Red Hat Package Manager' हो, DEB सँगै Linux को दुई प्रमुख प्याकेज ढाँचाहरू मध्ये एक हो, अहिले पनि RHEL परिवारमा मुख्य धारा हो)"

msgid "mime_pacman"
msgstr "Arch सफ्टवेयर प्याकेज (Arch Linux ले सन् २००२ मा लन्च गरेको, pacman प्याकेज व्यवस्थापकद्वारा प्रयोग गरिने .pkg.tar.zst ढाँचा। Arch Linux रोलिङ रिलिजको मुख्य भाग हो, सरलता र KISS सिद्धान्तको लागि प्रसिद्ध, AUR (Arch प्रयोगकर्ता भण्डार) यसको विशेषता हो)"

msgid "mime_exe"
msgstr "EXE कार्यान्वयन योग्य फाइल (Windows कार्यान्वयन योग्य प्रोग्राम ढाँचा, 'Executable' को संक्षिप्त रूप। Windows अपरेटिङ सिस्टमको मूल कार्यान्वयन ढाँचा, PE संरचना समावेश गर्दछ। MS-DOS को MZ ढाँचाबाट विकसित, सन् १९९३ मा Windows NT ले PE (पोर्टेबल कार्यान्वयन योग्य) ढाँचा परिचय गरायो र आजसम्म प्रयोग गरिन्छ। सफ्टवेयर स्थापना प्याकेजहरू, अनुप्रयोगहरू, प्रणाली उपकरणहरूले यो ढाँचा प्रयोग गर्छन्। प्रयोगकर्ताले डबल-क्लिक गरेर चलाउँछ, विश्वको सबैभन्दा व्यापक रूपमा प्रयोग हुने कार्यान्वयन योग्य ढाँचा हो)"

msgid "mime_dll"
msgstr "DLL गतिशील लिङ्क पुस्तकालय (Microsoft ले सन् १९९३ मा लन्च गरेको, Dynamic Link Library। Windows साझा कोड पुस्तकालय, प्रोग्राम चल्दा गतिशील रूपमा लोड हुन्छ, मेमोरी र डिस्क स्थान बचत गर्दछ। प्रणाली कम्पोनेन्टहरू, अनुप्रयोग प्लगइनहरू, ड्राइभरहरूले DLL ढाँचा प्रयोग गर्छन्। Windows API को मुख्य कार्यान्वयन विधि, DLL Hell समस्या .NET युगमा कम भएको छ)"

msgid "mime_com"
msgstr "COM कार्यान्वयन योग्य फाइल (MS-DOS युगको कार्यान्वयन योग्य ढाँचा, 'Command' को संक्षिप्त रूप। फाइल संरचना साधारण, ६४KB सीमा, Windows 3.x भन्दा पहिलेको मुख्य ढाँचा। हटाइसकिएको छ, आधुनिक Windows ले EXE ढाँचा प्रयोग गर्दछ, COM एक्सटेन्सन अझै पनि केही कम्पोनेन्ट फाइलहरूको लागि प्रयोग गरिन्छ)"

msgid "mime_aac"
msgstr "AAC अडियो (सन् १९९७ मा MPEG मापदण्ड, Advanced Audio Coding। MP3 को उत्तराधिकारी, समान बिट दरमा MP3 भन्दा राम्रो अडियो गुणस्तर, YouTube, iTunes, Nintendo Switch को पूर्वनिर्धारित अडियो ढाँचा)"

msgid "mime_alac"
msgstr "ALAC अडियो (Apple ले सन् २००४ मा विकास गरेको, Apple Lossless Audio Codec। Apple को हानीरहित ढाँचा, सन् २०११ मा खुला स्रोत बन्यो, iTunes र Apple Music मा हानीरहित अडियोको लागि पूर्वनिर्धारित ढाँचा)"

msgid "mime_flac"
msgstr "FLAC अडियो (Xiph.Org Foundation ले सन् २००१ मा विकास गरेको, Free Lossless Audio Codec। हानीरहित कम्प्रेसन, अडियो गुणस्तर CD सरह, फाइल आकार मूल WAV को लगभग आधा। खुला स्रोत र पेटेन्ट-मुक्त, अडियो उत्साही र डिजिटल संगीत सङ्कलनको लागि पहिलो छनौट ढाँचा)"

msgid "mime_mp3"
msgstr "MP3 अडियो (Fraunhofer Institute ले सन् १९९३ मा विकास गरेको, MPEG-1 Audio Layer 3। हानीयुक्त कम्प्रेसन ढाँचा, सानो फाइल तर स्वीकार्य अडियो गुणस्तर, सन् २००० को दशकको डिजिटल संगीत क्रान्तिको मुख्य ढाँचा, iPod र Napster को योगदानकर्ता। पेटेन्ट सन् २०१७ मा समाप्त भयो, सार्वजनिक डोमेन ढाँचा बन्यो)"

msgid "mime_oga"
msgstr "Ogg Audio अडियो (Xiph.Org Foundation द्वारा विकसित, Ogg कन्टेनरको शुद्ध अडियो ढाँचा, Vorbis कोडेक प्रयोग गर्दछ। खुला स्रोत र पेटेन्ट-मुक्त, कम्प्रेसन दक्षता MP3 भन्दा राम्रो, खुला स्रोत परियोजनाहरूमा व्यापक रूपमा प्रयोग गरिन्छ)"

msgid "mime_ogg"
msgstr "OGG अडियो (Xiph.Org Foundation ले सन् २००० मा विकास गरेको, Ogg Vorbis ढाँचा। खुला स्रोत र पेटेन्ट-मुक्त, कम्प्रेसन दक्षता MP3 भन्दा राम्रो, प्रारम्भिक Spotify ले प्रयोग गर्यो, खेल अडियो प्रभावहरूमा व्यापक रूपमा प्रयोग गरिन्छ)"

msgid "mime_opus"
msgstr "Opus अडियो (IETF ले सन् २०१२ मा मापदण्डीकृत गरेको, खुला स्रोत र पेटेन्ट-मुक्त अडियो ढाँचा, SILK र CELT प्रविधिहरूको संयोजन, धेरै कम विलम्बता, उच्चतम कम्प्रेसन दक्षता, WebRTC, WhatsApp, Discord को पूर्वनिर्धारित अडियो ढाँचा)"

msgid "mime_wav"
msgstr "WAV अडियो (Microsoft र IBM ले सन् १९९१ मा विकास गरेको, Windows को मूल अडियो ढाँचा। PCM इन्कोडिङ, कम्प्रेस नगरिएको, हानीरहित अडियो गुणस्तर तर फाइल धेरै ठूलो, पेशेवर अडियो सम्पादनको लागि मानक ढाँचा)"

msgid "mime_wma"
msgstr "WMA अडियो (Microsoft ले सन् १९९९ मा विकास गरेको, Windows Media Audio। हानीयुक्त/हानीरहित दुवै संस्करणहरू छन्, Windows मा मूल रूपमा समर्थित, Windows Media Player सँगै फैलियो। अहिले सीमान्तकृत भएको छ, MP3/AAC द्वारा प्रतिस्थापित भयो)"

msgid "mime_dsf"
msgstr "DSF अडियो (Direct Stream Digital ढाँचा, Sony र Philips द्वारा विकसित। १-बिट उच्च नमूना दर, DSD अडियो मानक ढाँचा, SACD को डिजिटल संस्करण, अडियो उत्साहीहरूको लागि उच्च-स्तरीय अडियो ढाँचा, फाइल धेरै ठूलो)"

msgid "mime_ape"
msgstr "APE अडियो (सन् २००० मा Monkey's Audio द्वारा विकसित, दोषरहित संकुचन ढाँचा। FLAC भन्दा उच्च संकुचन तर ढिलो एन्कोडिङ, अझै पनि Windows प्लेटफर्म र अडियो उत्साहीहरू बीच प्रयोग गरिन्छ)"

msgid "mime_mid"
msgstr "MIDI अडियो (MIDI Association ले सन् १९८३ मा तोकेको, Musical Instrument Digital Interface। रेकर्डिङ नभई संगीत नोट ढाँचा, फाइल धेरै सानो, इलेक्ट्रोनिक संगीत वाद्ययन्त्रहरू, फोन घण्टी, खेल अडियो प्रभावहरूको लागि मानक। General MIDI सन् १९९१ मा मापदण्डीकृत भयो, १२८ वाद्ययन्त्र ध्वनिहरू परिभाषित गर्यो)"

msgid "mime_m4a"
msgstr "M4A अडियो (MPEG-4 Audio, AAC को कन्टेनर ढाँचा। iTunes Music Store को मानक ढाँचा, Apple पारिस्थितिकी तंत्रको मुख्य अडियो ढाँचा, DRM संरक्षण समर्थन गर्दछ)"

msgid "mime_m3u"
msgstr "M3U प्लेलिस्ट (MP3 URL प्लेलिस्ट ढाँचा, सादा पाठ फाइल, अडियो फाइल मार्गहरू रेकर्ड गर्दछ। Winamp युगको मानक, अनलाइन रेडियो, अनलाइन संगीत स्ट्रिमिङको लागि प्रयोग गरिन्छ। M3U8 यसको UTF-8 संस्करण हो, HTTP Live Streaming को लागि प्रयोग गरिन्छ)"

msgid "mime_asf"
msgstr "ASF स्ट्रिमिङ मिडिया (Microsoft ले सन् १९९६ मा विकास गरेको, Advanced Systems Format। Windows Media स्ट्रिमिङ कन्टेनर, अडियो र भिडियो सिङ्क्रोनस प्रसारण समर्थन गर्दछ। अनलाइन लाइभ प्रसारण र भिडियो-अन-डिमान्ड स्ट्रिमिङको लागि प्रयोग गरिन्छ, WMA/WMV दुवै ASF कन्टेनरमा आधारित छन्)"

msgid "mime_avi"
msgstr "AVI भिडियो (Microsoft ले सन् १९९२ मा लन्च गरेको, Windows को प्रारम्भिक भिडियो मानक। 'Audio Video Interleave', अडियो र भिडियो वैकल्पिक रूपमा भण्डारण गर्दछ, सन् १९९०-२००० को दशकमा सबैभन्दा लोकप्रिय भिडियो ढाँचा थियो, अहिले MP4/MKV द्वारा प्रतिस्थापित भयो)"

msgid "mime_divx"
msgstr "DivX भिडियो (DivX Corporation ले सन् १९९८ मा विकास गरेको, MPEG-4 मा आधारित भिडियो कोडेक ढाँचा। सन् २००० को दशकको अनलाइन भिडियो साझेदारीको मुख्य ढाँचा, DVD गुणस्तरलाई CD आकारमा कम्प्रेस गर्ने पहिलो प्रविधि। प्रतिलिपि अधिकार विवादको कारण, पछि व्यावसायिक एन्कोडरमा परिणत भयो)"

msgid "mime_mp4"
msgstr "MP4 भिडियो (सन् २००१ मा MPEG मापदण्ड, MPEG-4 Part 14। विश्वको सबैभन्दा साधारण भिडियो ढाँचा, H.264/H.265 इन्कोडिङ समर्थन गर्दछ, इन्टरनेट भिडियो, फोन रेकर्डिङ, YouTube को पूर्वनिर्धारित ढाँचा)"

msgid "mime_m4v"
msgstr "M4V भिडियो (iTunes को भिडियो ढाँचा, MP4 को भिन्नता। Apple पारिस्थितिकी तंत्रमा भिडियो ढाँचा, iTunes Store चलचित्र र टेलिभिजन कार्यक्रमहरूको मानक ढाँचा, DRM प्रतिलिपि अधिकार संरक्षण समर्थन गर्दछ)"

msgid "mime_mpeg"
msgstr "MPEG भिडियो (MPEG संगठनले सन् १९८८ मा तोकेको, Moving Picture Experts Group। डिजिटल भिडियो कम्प्रेसन मापदण्डहरूको जग बसाउने, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (अनलाइन भिडियो) को गहिरो प्रभाव छ)"

msgid "mime_mkv"
msgstr "MKV भिडियो (Matroska परियोजनाले सन् २००२ मा विकास गरेको, खुला स्रोत मल्टिमिडिया कन्टेनर ढाँचा। धेरै अडियो ट्र्याकहरू, धेरै उपशीर्षकहरू, अध्यायहरू समर्थन गर्दछ, 'रेयापर उपकरण', उच्च-रिजोल्युसन चलचित्र साझेदारीको लागि पहिलो छनौट ढाँचा)"

msgid "mime_mpg"
msgstr "MPEG भिडियो (MPEG-1/MPEG-2 भिडियो एक्सटेन्सन, VCD र DVD को लागि मानक ढाँचा। सन् १९९०-२००० को दशकमा डिस्कमा भिडियोको लागि मुख्य ढाँचा थियो, अहिले H.264/H.265 द्वारा प्रतिस्थापित भयो)"

msgid "mime_ogv"
msgstr "Ogg Video भिडियो (Xiph.Org Foundation द्वारा विकसित, Ogg कन्टेनरको भिडियो ढाँचा, Theora कोडेक प्रयोग गर्दछ। खुला स्रोत र पेटेन्ट-मुक्त, HTML5 भिडियोको प्रारम्भिक मानकहरू मध्ये एक, Firefox द्वारा मूल रूपमा समर्थित)"

msgid "mime_ogx"
msgstr "Ogg मल्टिमिडिया कन्टेनर (Xiph.Org Foundation द्वारा विकसित, Ogg कन्टेनरको साधारण एक्सटेन्सन, अडियो, भिडियो, उपशीर्षक जस्ता धेरै ट्र्याकहरू समावेश गर्न सक्छ। खुला स्रोत मल्टिमिडिया मानक, गेमहरू, स्ट्रिमिङको लागि प्रयोग गरिन्छ)"

msgid "mime_rm"
msgstr "RealMedia भिडियो (RealNetworks ले सन् १९९५ मा विकास गरेको, RealMedia ढाँचा। सन् १९९०-२००० को दशकमा अनलाइन स्ट्रिमिङको अग्रदूत, RealPlayer प्लेयरको मुख्य ढाँचा। कमजोरीहरू: विशेष प्लेयर चाहिन्छ, कम्प्रेसन गुणस्तर खराब, पछि Flash/MP4 द्वारा प्रतिस्थापित भयो)"

msgid "mime_flv"
msgstr "Flash भिडियो (सन् २००२ मा ढाँचा देखा पर्यो, Flash Video ढाँचा। एक पटक अनलाइन भिडियोको मुख्य ढाँचा थियो, प्रारम्भिक YouTube ले प्रयोग गर्यो। कमजोरीहरू: Flash प्लगइनको आवश्यकता, कमजोर प्रदर्शन, धेरै सुरक्षा कमजोरीहरू। सन् २०१५ देखि मुख्य वेबसाइटहरू HTML5 भिडियोमा परिवर्तन भए, अहिले हटाइसकिएको छ)"

msgid "mime_f4v"
msgstr "F4V भिडियो (Adobe द्वारा विकसित Flash भिडियो ढाँचा, FLV को उत्तराधिकारी। MPEG-4 मापदण्डमा आधारित, H.264 इन्कोडिङ समर्थन गर्दछ। Flash प्रविधिसँगै हटाइयो, Adobe ले सन् २०२० मा समर्थन बन्द गर्यो)"

msgid "mime_wmv"
msgstr "WMV भिडियो (Microsoft ले सन् १९९९ मा विकास गरेको, Windows Media Video। Windows मा मूल रूपमा समर्थित, स्ट्रिमिङ प्रसारणको लागि अनुकूलित, प्रारम्भिक अनलाइन भिडियोहरूमा सामान्य ढाँचा थियो, अहिले सीमान्तकृत भएको छ)"

msgid "mime_wmf"
msgstr "WMF मिडिया ढाँचा (Windows Media Format, Microsoft को मिडिया फ्रेमवर्क, WMV भिडियो, WMA अडियो समावेश गर्दछ, Windows Media Player द्वारा मूल रूपमा समर्थित)"

msgid "mime_mov"
msgstr "MOV भिडियो (Apple ले सन् १९९१ मा विकास गरेको, QuickTime कन्टेनर ढाँचा। पेशेवर भिडियो सम्पादनको लागि मानक ढाँचा, धेरै कोडेकहरू समर्थन गर्दछ, Final Cut Pro, Premiere द्वारा मूल रूपमा समर्थित)"

msgid "mime_qt"
msgstr "QuickTime भिडियो (Apple ले सन् १९९१ मा लन्च गरेको, QuickTime ढाँचा। Mac प्लेटफर्मको भिडियो मानक, MOV यसको कन्टेनर हो, QuickTime प्लेयर एक पटक व्यापक रूपमा प्रयोग गरिन्थ्यो। Apple ले सन् २०१६ मा Windows संस्करण विकास बन्द गर्यो, बिस्तारै MP4 द्वारा प्रतिस्थापित भयो)"

msgid "mime_webm"
msgstr "WebM भिडियो (Google ले सन् २०१० मा लन्च गरेको, खुला स्रोत र पेटेन्ट-मुक्त भिडियो ढाँचा। Matroska कन्टेनरमा आधारित, VP8/VP9 इन्कोडिङ, HTML5 भिडियो मानक ढाँचा, YouTube को वेबमा पूर्वनिर्धारित प्लेब्याक ढाँचा)"

msgid "mime_3gp"
msgstr "3GP भिडियो (3GPP ले सन् २००० मा तोकेको, मोबाइल यन्त्रहरूको लागि भिडियो ढाँचा। फाइल धेरै सानो, कम गुणस्तर, प्रारम्भिक सुविधा फोनहरूको भिडियो रेकर्डिङ ढाँचा, MMS पठाउनको लागि प्रयोग गरिन्थ्यो)"

