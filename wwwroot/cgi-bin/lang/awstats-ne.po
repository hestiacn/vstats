msgid "period_09"
msgstr "बिहान ९ बजे · सुनौलो समय, काम छल्न पनि नियम हुन्छ"

msgid "period_10"
msgstr "बिहान १० बजे · कफी समय, ट्राफिक बढ्यो कि हेर"

msgid "period_11"
