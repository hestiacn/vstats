msgid "mime_text"
msgstr "ਟੈਕਸਟ ਫਾਈਲ (1963 ਵਿੱਚ ASCII ਮਿਆਰੀ ਬਣਾਇਆ ਗਿਆ, ਫਾਰਮੈਟਿੰਗ ਤੋਂ ਬਿਨਾਂ ਸਾਦਾ ਟੈਕਸਟ। ਸਾਰੇ ਸਰੋਤ ਕੋਡ, ਸੰਰਚਨਾ, ਲਾਗਾਂ ਦਾ ਆਧਾਰ। Unix ਵਿੱਚ LF, Windows ਵਿੱਚ CRLF ਵਰਤਦਾ ਹੈ, ਅੱਜ ਵੀ ਕੰਪਿਊਟਰਾਂ ਵਿੱਚ ਸਭ ਤੋਂ ਆਮ ਡਾਟਾ ਫਾਰਮੈਟ)"

msgid "mime_log"
msgstr "ਲਾਗ ਫਾਈਲ (ਸਿਸਟਮ, ਐਪਲੀਕੇਸ਼ਨ ਦੀ ਜਾਣਕਾਰੀ ਰਿਕਾਰਡ ਕਰਦੀ ਹੈ, ਆਮ ਤੌਰ 'ਤੇ ਗਲਤੀਆਂ ਦਾ ਪਤਾ ਲਗਾਉਣ, ਕਾਰਗੁਜ਼ਾਰੀ ਵਿਸ਼ਲੇਸ਼ਣ, ਸੁਰੱਖਿਆ ਆਡਿਟ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ। ਮਿਆਰੀ ਫਾਰਮੈਟ: Apache combined log, Nginx access log, syslog)"

msgid "mime_page"
msgstr "HTML ਵੈੱਬ ਸਫ਼ਾ (1989 ਵਿੱਚ ਟਿਮ ਬਰਨਰਸ-ਲੀ ਨੇ ਵਰਲਡ ਵਾਈਡ ਵੈੱਬ ਦੀ ਖੋਜ ਕੀਤੀ, 1990 ਵਿੱਚ HTML/HTTP/URL ਤਿੰਨ ਮੂਲ ਤਕਨਾਲੋਜੀਆਂ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕੀਤਾ, ਪੇਟੈਂਟ ਤੋਂ ਬਿਨਾਂ ਮੁਫ਼ਤ ਖੋਲ੍ਹਿਆ। 2014 ਵਿੱਚ HTML5 W3C ਅਧਿਕਾਰਤ ਮਿਆਰ ਬਣਿਆ। 2016 ਵਿੱਚ ਟਿਊਰਿੰਗ ਪੁਰਸਕਾਰ ਪ੍ਰਾਪਤ ਕੀਤਾ)"

msgid "mime_khtml"
msgstr "KHTML ਵੈੱਬ ਇੰਜਨ (1998 ਵਿੱਚ KDE 2.0 ਨਾਲ ਰਿਲੀਜ਼ ਹੋਇਆ, Konqueror ਬਰਾਊਜ਼ਰ ਦਾ ਰੈਂਡਰਿੰਗ ਇੰਜਨ। 2001 ਵਿੱਚ ਐਪਲ ਨੇ KHTML ਅਧਾਰਤ WebKit ਬਣਾਇਆ, 2008 ਵਿੱਚ ਗੂਗਲ ਨੇ WebKit ਤੋਂ Blink ਫੋਰਕ ਕੀਤਾ, ਜੋ Chrome, Edge, Safari ਬਰਾਊਜ਼ਰਾਂ ਦਾ ਕੋਰ ਬਣਿਆ। KHTML ਓਪਨ ਸੋਰਸ ਸਮੁਦਾਇ ਦੀ ਉਦਾਹਰਣ ਹੈ, ਜਿਸਨੇ ਆਧੁਨਿਕ ਬਰਾਊਜ਼ਰ ਇੰਜਨਾਂ ਦੀ ਨੀਂਹ ਰੱਖੀ)"

msgid "mime_script"
msgstr "ਡਾਇਨਾਮਿਕ ਸਕ੍ਰਿਪਟ (ਇੰਟਰਪ੍ਰੇਟ ਕੀਤੀ ਜਾਣ ਵਾਲੀ ਭਾਸ਼ਾ, ਕੰਪਾਈਲ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ASP, JSP, CGI, ColdFusion, Tcl, VBScript ਸ਼ਾਮਲ ਕਰਦੀ ਹੈ, ਸ਼ੁਰੂਆਤੀ ਵੈੱਬ ਵਿਕਾਸ, ਸਿਸਟਮ ਪ੍ਰਬੰਧਨ, ਆਟੋਮੇਸ਼ਨ ਕੰਮਾਂ ਵਿੱਚ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤੀ ਜਾਂਦੀ ਸੀ। ਆਧੁਨਿਕ ਸਕ੍ਰਿਪਟਿੰਗ ਭਾਸ਼ਾਵਾਂ ਜਿਵੇਂ Python, Ruby, JavaScript ਹੁਣ ਪੂਰੇ ਪੈਮਾਨੇ ਦੀਆਂ ਪ੍ਰੋਗਰਾਮਿੰਗ ਭਾਸ਼ਾਵਾਂ ਹਨ)"

msgid "mime_js"
msgstr "JavaScript ਸਕ੍ਰਿਪਟ (1995 ਵਿੱਚ Brendan Eich ਨੇ Netscape ਵਿੱਚ 10 ਦਿਨਾਂ ਵਿੱਚ ਬਣਾਈ, ਬਰਾਊਜ਼ਰ ਦੀ ਮੂਲ ਪ੍ਰੋਗਰਾਮਿੰਗ ਭਾਸ਼ਾ। 1997 ਵਿੱਚ ECMAScript ਮਿਆਰੀ ਬਣਾਈ ਗਈ, 2009 ਵਿੱਚ Node.js ਬਣਾਏ ਜਾਣ ਨਾਲ ਇਹ ਪੂਰੇ ਪੈਮਾਨੇ ਦੀ ਭਾਸ਼ਾ ਬਣ ਗਈ, npm ਵਿਸ਼ਵ ਦਾ ਸਭ ਤੋਂ ਵੱਡਾ ਪੈਕੇਜ ਮੈਨੇਜਰ ਹੈ। GitHub 'ਤੇ ਸਭ ਤੋਂ ਪ੍ਰਸਿੱਧ ਪ੍ਰੋਗਰਾਮਿੰਗ ਭਾਸ਼ਾ)"

msgid "mime_py"
msgstr "Python ਸਕ੍ਰਿਪਟ (1991 ਵਿੱਚ Guido van Rossum ਨੇ ਬਣਾਈ, ਲਾਜ਼ਮੀ ਇੰਡੈਂਟੇਸ਼ਨ ਅਤੇ ਸਧਾਰਨ ਸਿੰਟੈਕਸ ਦੁਆਰਾ ਪਛਾਣੀ ਜਾਂਦੀ ਹੈ। ਵੈੱਬ ਵਿਕਾਸ, ਡਾਟਾ ਵਿਗਿਆਨ, ਨਕਲੀ ਬੁੱਧੀ, ਆਟੋਮੇਸ਼ਨ ਵਿੱਚ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤੀ ਜਾਂਦੀ ਹੈ। TIOBE ਵਾਰਸ਼ਿਕ ਪ੍ਰੋਗਰਾਮਿੰਗ ਭਾਸ਼ਾ ਪੁਰਸਕਾਰ ਕਈ ਵਾਰ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੈ)"

msgid "mime_sh"
msgstr "ਸ਼ੈੱਲ ਸਕ੍ਰਿਪਟ (1971 ਵਿੱਚ Unix ਦੇ ਨਾਲ, ਕਮਾਂਡ ਸਕ੍ਰਿਪਟਿੰਗ ਭਾਸ਼ਾ। ਸਿਸਟਮ ਪ੍ਰਬੰਧਨ, ਆਟੋਮੇਸ਼ਨ ਕੰਮਾਂ, ਸੇਵਾਵਾਂ ਸ਼ੁਰੂ ਕਰਨ, ਤੈਨਾਤੀ ਸਕ੍ਰਿਪਟਾਂ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ। Linux ਪ੍ਰਬੰਧਨ ਵਿੱਚ ਜ਼ਰੂਰੀ ਹੁਨਰ)"

msgid "mime_rb"
msgstr "Ruby ਸਕ੍ਰਿਪਟ (1995 ਵਿੱਚ Yukihiro Matsumoto ਨੇ ਬਣਾਈ, ਡਿਵੈਲਪਰਾਂ ਦੀ ਖੁਸ਼ੀ 'ਤੇ ਕੇਂਦਰਤ ਕਰਦੀ ਹੈ। Ruby on Rails ਫਰੇਮਵਰਕ ਨੇ "ਰਵਾਇਤ ਨਾਲੋਂ ਸੰਰਚਨਾ ਬਿਹਤਰ ਹੈ" ਦੀ ਵਿਧੀ ਪੇਸ਼ ਕੀਤੀ, ਜਿਸਨੇ ਆਧੁਨਿਕ ਵੈੱਬ ਫਰੇਮਵਰਕ ਦੇ ਡਿਜ਼ਾਈਨ ਨੂੰ ਪ੍ਰਭਾਵਿਤ ਕੀਤਾ)"

msgid "mime_pl"
msgstr "Perl ਸਕ੍ਰਿਪਟ (1987 ਵਿੱਚ Larry Wall ਨੇ ਬਣਾਈ, ਵਿਵਹਾਰਿਕਤਾ ਲਈ ਮਸ਼ਹੂਰ ਹੈ, "ਸਵਿਸ ਆਰਮੀ ਚਾਕੂ" ਵਜੋਂ ਜਾਣੀ ਜਾਂਦੀ ਹੈ। CPAN ਆਧੁਨਿਕ ਭਾਸ਼ਾ ਪੈਕੇਜ ਮੈਨੇਜਰਾਂ ਦਾ ਮੋਢੀ ਸੀ, ਟੈਕਸਟ ਪ੍ਰੋਸੈਸਿੰਗ, ਸਿਸਟਮ ਪ੍ਰਬੰਧਨ, CGI ਖੇਤਰਾਂ ਵਿੱਚ ਮਹੱਤਵਪੂਰਨ ਪ੍ਰਭਾਵ ਪਾਇਆ)"

msgid "mime_php"
msgstr "PHP ਡਾਇਨਾਮਿਕ ਸਫ਼ਾ (1995 ਵਿੱਚ Rasmus Lerdorf ਨੇ ਬਣਾਇਆ, ਖਾਸ ਤੌਰ 'ਤੇ ਵੈੱਬ ਵਿਕਾਸ ਲਈ। ਵਿਸ਼ਵ ਦੀਆਂ 70% ਵੈੱਬਸਾਈਟਾਂ ਵਰਤਦੀਆਂ ਹਨ, WordPress, Facebook, Wikipedia ਸਮੇਤ। PHP 8 ਨੇ JIT ਕੰਪਾਈਲੇਸ਼ਨ ਪੇਸ਼ ਕੀਤੀ, ਕਾਰਗੁਜ਼ਾਰੀ ਵਿੱਚ ਕਾਫੀ ਸੁਧਾਰ ਕੀਤਾ)"

msgid "mime_image"
msgstr "ਚਿੱਤਰ ਫਾਈਲ"

msgid "mime_document"
msgstr "ਦਸਤਾਵੇਜ਼ ਫਾਈਲ"

msgid "mime_package"
msgstr "ਸਾਫਟਵੇਅਰ ਪੈਕੇਜ"

msgid "mime_archive"
msgstr "Gzip ਸੰਕੁਚਿਤ ਫਾਈਲ (1992 ਵਿੱਚ GNU ਪ੍ਰੋਜੈਕਟ, DEFLATE ਐਲਗੋਰਿਦਮ 'ਤੇ ਅਧਾਰਤ। ਵੈੱਬ ਵਿੱਚ ਡਾਇਨਾਮਿਕ ਸੰਕੁਚਨ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ, ਸੰਕੁਚਨ ਦਰ ਆਮ ਤੌਰ 'ਤੇ 60-90%। 2015 ਤੋਂ ਬਾਅਦ Brotli ਦੁਆਰਾ ਅੰਸ਼ਕ ਤੌਰ 'ਤੇ ਬਦਲਿਆ ਗਿਆ, ਪਰ ਫਿਰ ਵੀ ਸਰਵਰਾਂ 'ਤੇ ਸਭ ਤੋਂ ਆਮ ਸੰਕੁਚਨ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_audio"
msgstr "ਆਡੀਓ ਫਾਈਲ"

msgid "mime_video"
msgstr "ਵੀਡੀਓ ਫਾਈਲ"

msgid "mime_jscript"
msgstr "JavaScript (1995 ਵਿੱਚ Brendan Eich ਨੇ ਬਣਾਈ)"

msgid "mime_json"
msgstr "JSON ਡਾਟਾ (2001 ਵਿੱਚ Douglas Crockford ਨੇ ਪ੍ਰਸਤਾਵਿਤ ਕੀਤਾ, ਹਲਕਾ ਡਾਟਾ ਅਦਲਾ-ਬਦਲੀ ਫਾਰਮੈਟ, Web API ਦਾ ਅਸਲ ਮਿਆਰ)"

msgid "mime_vbs"
msgstr "VBScript (1996 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, Windows ਸਕ੍ਰਿਪਟਿੰਗ ਭਾਸ਼ਾ, ASP ਸਫ਼ਿਆਂ ਅਤੇ Windows ਪ੍ਰਬੰਧਨ ਸਕ੍ਰਿਪਟਾਂ ਵਿੱਚ ਵਰਤੀ ਜਾਂਦੀ ਹੈ। PowerShell ਅਤੇ JavaScript ਦੇ ਪ੍ਰਸਾਰ ਨਾਲ, ਹੌਲੀ-ਹੌਲੀ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ)"

msgid "mime_conf"
msgstr "ਸੰਰਚਨਾ ਫਾਈਲ (ਸਾਫਟਵੇਅਰ ਸੰਰਚਨਾ ਟੈਕਸਟ ਫਾਰਮੈਟ ਵਿੱਚ ਸਟੋਰ ਕਰਦੀ ਹੈ, ਆਮ ਫਾਰਮੈਟ: INI, JSON, YAML, TOML, XML। Linux ਸਿਸਟਮ ਸੰਰਚਨਾਵਾਂ ਜ਼ਿਆਦਾਤਰ /etc ਡਾਇਰੈਕਟਰੀ ਵਿੱਚ ਹਨ)"

msgid "mime_css"
msgstr "CSS ਸਟਾਈਲ ਸ਼ੀਟ (1996 ਦਸੰਬਰ ਵਿੱਚ W3C ਨੇ ਪਹਿਲਾ ਅਧਿਕਾਰਤ ਮਿਆਰ CSS1 ਪ੍ਰਕਾਸ਼ਿਤ ਕੀਤਾ, 1998 ਵਿੱਚ CSS2 ਨੇ ਲੇਆਉਟ ਅਤੇ ਮੀਡੀਆ ਕਿਸਮਾਂ ਸ਼ਾਮਲ ਕੀਤੀਆਂ, 2011 ਤੋਂ CSS3 ਮੌਡਿਊਲਰ ਸੰਸਕਰਣ ਨੇ ਗੋਲ ਕੋਨੇ, ਐਨੀਮੇਸ਼ਨ, Flexbox, ਗਰਿੱਡ ਲੇਆਉਟ ਅਤੇ ਰੈਸਪਾਂਸਿਵ ਡਿਜ਼ਾਈਨ ਪੇਸ਼ ਕੀਤੇ। HTML ਅਤੇ JavaScript ਦੇ ਨਾਲ ਫਰੰਟ-ਐਂਡ ਦੀਆਂ ਤਿੰਨ ਮੁੱਖ ਤਕਨਾਲੋਜੀਆਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ, ਸਾਰੇ ਆਧੁਨਿਕ ਬਰਾਊਜ਼ਰ (Chrome, Firefox, Safari, Edge) ਮੂਲ ਸਮਰਥਨ ਕਰਦੇ ਹਨ, ਸਫ਼ੇ ਦੀ ਸ਼ੈਲੀ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕਰਨ ਦਾ ਇੱਕੋ ਇੱਕ ਮਿਆਰ ਹੈ)"

msgid "mime_xsl"
msgstr "XSL ਸਟਾਈਲ ਸ਼ੀਟ (1999 ਵਿੱਚ W3C ਮਿਆਰ, XML ਦਸਤਾਵੇਜ਼ ਰੂਪਾਂਤਰਨ ਭਾਸ਼ਾ, XML ਨੂੰ HTML/PDF/ਟੈਕਸਟ ਵਿੱਚ ਬਦਲ ਸਕਦੀ ਹੈ। JSON ਦੇ ਪ੍ਰਸਾਰ ਤੋਂ ਬਾਅਦ ਵਰਤੋਂ ਘੱਟ ਗਈ ਹੈ)"

msgid "mime_runtime"
msgstr "ਐਗਜ਼ੀਕਿਊਟਯੋਗ ਫਾਈਲ (EXE, ELF, Mach-O ਓਪਰੇਟਿੰਗ ਸਿਸਟਮ ਦੇ ਚੱਲਣ ਯੋਗ ਫਾਰਮੈਟ, ਮਸ਼ੀਨ ਕੋਡ ਅਤੇ ਲੋਡਿੰਗ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਕਰਦੇ ਹਨ)"

msgid "mime_library"
msgstr "ਲਾਇਬ੍ਰੇਰੀ ਫਾਈਲ (DLL, SO, dylib ਡਾਇਨਾਮਿਕ ਲਿੰਕ ਲਾਇਬ੍ਰੇਰੀਆਂ, ਪ੍ਰੋਗਰਾਮ ਚੱਲਣ ਸਮੇਂ ਲੋਡ ਹੁੰਦੀਆਂ ਹਨ)"

msgid "mime_swf"
msgstr "Flash ਐਨੀਮੇਸ਼ਨ (1996 ਵਿੱਚ Macromedia ਦੁਆਰਾ ਵਿਕਸਤ, ਬਾਅਦ ਵਿੱਚ Adobe ਦੁਆਰਾ ਪ੍ਰਾਪਤ ਕੀਤੀ ਗਈ। ਇੰਟਰੈਕਟਿਵ ਵੈੱਬ ਐਨੀਮੇਸ਼ਨ ਦਾ ਮਿਆਰ, ਇੰਟਰਨੈੱਟ ਐਨੀਮੇਸ਼ਨ ਅਤੇ ਗੇਮਾਂ ਵਿੱਚ ਦਬਦਬਾ ਸਥਾਪਿਤ ਕੀਤਾ। ਕਮੀਆਂ: ਪਲੱਗਇਨ 'ਤੇ ਨਿਰਭਰ, ਮੋਬਾਈਲ ਡਿਵਾਈਸਾਂ 'ਤੇ ਕੰਮ ਨਹੀਂ ਕਰਦੀ ਸੀ, ਉੱਚ ਸੁਰੱਖਿਆ ਜੋਖਮ। 2017 ਵਿੱਚ Adobe ਨੇ ਸਮਰਥਨ ਬੰਦ ਕਰਨ ਦਾ ਐਲਾਨ ਕੀਤਾ, 2020 ਵਿੱਚ ਪੂਰੀ ਤਰ੍ਹਾਂ ਬੰਦ ਕਰ ਦਿੱਤੀ ਗਈ, HTML5/CSS3/JS ਦੁਆਰਾ ਬਦਲੀ ਗਈ)"

msgid "mime_dtd"
msgstr "DTD ਦਸਤਾਵੇਜ਼ ਕਿਸਮ ਪਰਿਭਾਸ਼ਾ (XML ਵਿਸ਼ੇਸ਼ਤਾ, XML ਦਸਤਾਵੇਜ਼ ਦੀ ਬਣਤਰ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕਰਦੀ ਹੈ, XML ਦੀ ਵੈਧਤਾ ਦੀ ਪੁਸ਼ਟੀ ਕਰਨ ਲਈ)"

msgid "mime_csv"
msgstr "CSV ਡਾਟਾ ਫਾਰਮੈਟ (ਕੋਮਾ ਨਾਲ ਵੱਖ ਕੀਤੇ ਮੁੱਲ, ਟੇਬਲ ਡਾਟਾ ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਫਾਰਮੈਟ, Excel ਅਤੇ ਡਾਟਾਬੇਸ ਆਯਾਤ/ਨਿਰਯਾਤ ਮਿਆਰ)"

msgid "mime_jnlp"
msgstr "Java Web Start (ਜਾਵਾ ਐਪਲੀਕੇਸ਼ਨ ਲਾਂਚਰ, 2000 ਦੇ ਦਹਾਕੇ ਵਿੱਚ ਜਾਵਾ ਡੈਸਕਟਾਪ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ ਵੰਡਣ ਦੀ ਤਕਨਾਲੋਜੀ, ਹੁਣ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ)"

msgid "mime_lit"
msgstr "Microsoft Reader ਈ-ਕਿਤਾਬ (2000 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤੀ ਗਈ, LIT ਫਾਰਮੈਟ, ਹੁਣ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ)"

msgid "mime_svg"
msgstr "SVG ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ (1999 ਵਿੱਚ W3C ਮਿਆਰ, Microsoft ਦੁਆਰਾ ਆਪਣੇ VML ਫਾਰਮੈਟ ਨੂੰ ਲੰਮੇ ਸਮੇਂ ਤੱਕ ਪ੍ਰਚਾਰਨ ਕਾਰਨ, IE ਬਰਾਊਜ਼ਰ ਨੇ 2011 ਤੱਕ ਸਮਰਥਨ ਨਹੀਂ ਦਿੱਤਾ, ਜਿਸ ਨਾਲ ਫੈਲਾਅ ਵਿੱਚ ਦੇਰੀ ਹੋਈ। 2015 ਤੋਂ ਬਾਅਦ, IE ਦੇ ਬੰਦ ਹੋਣ ਅਤੇ ਉੱਚ ਰੈਜ਼ੋਲੂਸ਼ਨ ਸਕ੍ਰੀਨਾਂ ਦੇ ਪ੍ਰਸਾਰ ਕਾਰਨ, ਆਈਕਨਾਂ, ਲੋਗੋ ਲਈ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ ਬਣ ਗਿਆ)"

msgid "mime_ai"
msgstr "Adobe Illustrator ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ (1987 ਵਿੱਚ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, ਉਦਯੋਗ ਮਿਆਰੀ ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ ਫਾਰਮੈਟ, ਪ੍ਰਿੰਟ ਡਿਜ਼ਾਈਨ, ਲੋਗੋ, ਆਈਕਨਾਂ ਲਈ ਪਸੰਦੀਦਾ)"

msgid "mime_phshop"
msgstr "ਫੋਟੋਸ਼ਾਪ ਚਿੱਤਰ (1990 ਵਿੱਚ Adobe ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, ਫੋਟੋਸ਼ਾਪ ਦੀ ਸਰੋਤ ਫਾਈਲ PSD, ਚਿੱਤਰ ਪ੍ਰੋਸੈਸਿੰਗ ਉਦਯੋਗ ਦਾ ਮਿਆਰ)"

msgid "mime_ttf"
msgstr "TrueType ਫੌਂਟ (1989 ਵਿੱਚ Apple ਅਤੇ Microsoft ਦੁਆਰਾ ਸਾਂਝੇ ਤੌਰ 'ਤੇ ਵਿਕਸਤ ਕੀਤਾ ਗਿਆ, ਵੈਕਟਰ ਫੌਂਟ ਫਾਰਮੈਟ, ਸਕ੍ਰੀਨ ਡਿਸਪਲੇ ਅਤੇ ਪ੍ਰਿੰਟਿੰਗ ਇਕੋ ਜਿਹੀ ਹੈ, ਆਧੁਨਿਕ ਓਪਰੇਟਿੰਗ ਸਿਸਟਮਾਂ ਦਾ ਮਿਆਰੀ ਫੌਂਟ ਫਾਰਮੈਟ)"

msgid "mime_fon"
msgstr "WOFF2 ਵੈੱਬ ਫੌਂਟ (2014 ਵਿੱਚ W3C ਦੁਆਰਾ ਮਨਜ਼ੂਰ, Brotli ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ ਵਰਤਦਾ ਹੈ, ਪੁਰਾਣੇ WOFF ਫਾਰਮੈਟ ਨਾਲੋਂ ਲਗਭਗ 30% ਛੋਟਾ, TTF/OTF ਨਾਲੋਂ 50% ਤੋਂ ਵੱਧ, ਸਾਰੇ ਆਧੁਨਿਕ ਬਰਾਊਜ਼ਰ ਸਮਰਥਨ ਕਰਦੇ ਹਨ, ਆਧੁਨਿਕ ਵੈੱਬ ਫੌਂਟਾਂ ਲਈ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ ਹੈ, 98% ਤੋਂ ਵੱਧ ਬਰਾਊਜ਼ਰਾਂ ਦੁਆਰਾ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_pdf"
msgstr "PDF ਦਸਤਾਵੇਜ਼ (1993 ਵਿੱਚ Adobe ਦੁਆਰਾ ਵਿਕਸਤ, 2008 ਵਿੱਚ ISO ਅੰਤਰਰਾਸ਼ਟਰੀ ਮਿਆਰ ਬਣਿਆ। ਕਰਾਸ-ਪਲੇਟਫਾਰਮ ਦਸਤਾਵੇਜ਼ ਫਾਰਮੈਟ, ਫਾਰਮੈਟਿੰਗ ਇਕਸਾਰਤਾ ਬਣਾਈ ਰੱਖਦਾ ਹੈ, ਇਲੈਕਟ੍ਰਾਨਿਕ ਦਸਤਾਵੇਜ਼ਾਂ ਦੀ ਵੰਡ ਦਾ ਗਲੋਬਲ ਮਿਆਰ ਹੈ)"

msgid "mime_dotnet"
msgstr "ASP.NET ਡਾਇਨਾਮਿਕ ਸਫ਼ਾ (2002 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Windows ਪਲੇਟਫਾਰਮ ਦੀ ਡਾਇਨਾਮਿਕ ਵੈੱਬ ਸਫ਼ਾ ਤਕਨਾਲੋਜੀ, .NET Framework ਦਾ ਹਿੱਸਾ)"

msgid "mime_mdb"
msgstr "Access ਡਾਟਾਬੇਸ (Microsoft Access ਡਾਟਾਬੇਸ ਫਾਈਲ, 1992 ਵਿੱਚ ਜਾਰੀ ਕੀਤੀ ਗਈ, Windows ਡੈਸਕਟਾਪ ਡਾਟਾਬੇਸ ਹੱਲ)"

msgid "mime_md"
msgstr "Markdown ਦਸਤਾਵੇਜ਼ (2004 ਵਿੱਚ John Gruber ਦੁਆਰਾ ਬਣਾਇਆ ਗਿਆ, 'ਪੜ੍ਹਨਯੋਗ ਰੈਂਡਰ' ਮੁੱਖ ਡਿਜ਼ਾਈਨ ਦਰਸ਼ਨ, ਅਸਲ Markdown.pl ਨੇ Perl ਰੈਗੂਲਰ ਐਕਸਪ੍ਰੈਸ਼ਨਾਂ ਦੀ ਵਰਤੋਂ ਕੀਤੀ। ਵਿਉਤਪੰਨ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਵਿੱਚ GFM (2013), CommonMark (2017), Pandoc Markdown ਆਦਿ ਸ਼ਾਮਲ ਹਨ। GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress ਆਦਿ ਈਕੋਸਿਸਟਮਾਂ ਨੂੰ ਸੰਚਾਲਿਤ ਕਰਦੇ ਹੋਏ, ਸਥਿਰ ਸਾਈਟ ਜਨਰੇਟਰਾਂ ਅਤੇ ਡਿਵੈਲਪਰ ਦਸਤਾਵੇਜ਼ ਲਈ ਵਾਸਤਵਿਕ ਮਿਆਰੀ ਫਾਰਮੈਟ ਬਣ ਗਿਆ)"

msgid "mime_crystal"
msgstr "Crystal Reports ਰਿਪੋਰਟ ਫਾਰਮੈਟ (SAP ਵਪਾਰਕ ਖੁਫੀਆ ਰਿਪੋਰਟਾਂ, ਕਾਰਪੋਰੇਟ ਰਿਪੋਰਟਾਂ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_libreoffice"
msgstr "LibreOffice ਦਸਤਾਵੇਜ਼ (2010 ਵਿੱਚ The Document Foundation ਦੁਆਰਾ ਵਿਕਸਤ, OpenOffice ਫੋਰਕ, ODF ਮਿਆਰ ਦੀ ਪਾਲਣਾ, ਮੁੱਖ ਓਪਨ ਸੋਰਸ ਦਫਤਰ ਸੂਟ)"

msgid "mime_encrypt"
msgstr "ਏਨਕ੍ਰਿਪਟ ਕੀਤੀ ਫਾਈਲ (ਦੇਖਣ ਲਈ ਡੀਕ੍ਰਿਪਟ ਕਰਨ ਦੀ ਲੋੜ ਹੈ, ਆਮ ਐਕਸਟੈਂਸ਼ਨਾਂ: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS ਟਰੈਕ ਡਾਟਾ (GPS ਐਕਸਚੇਂਜ ਫਾਰਮੈਟ, ਭੂਗੋਲਿਕ ਸਥਿਤੀ ਜਾਣਕਾਰੀ ਸਟੋਰ ਕਰਦਾ ਹੈ, ਖੇਡ ਘੜੀਆਂ, ਨੇਵੀਗੇਸ਼ਨ ਉਪਕਰਣਾਂ ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਫਾਰਮੈਟ)"

msgid "mime_diskimage"
msgstr "ਡਿਸਕ ਇਮੇਜ (DMG, ISO, IMG ਅਤੇ ਹੋਰ ਡਿਸਕ ਇਮੇਜ ਫਾਈਲਾਂ, ਸਾਫਟਵੇਅਰ ਵੰਡਣ ਜਾਂ ਮੀਡੀਆ ਬੈਕਅੱਪ ਲਈ ਵਰਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ)"

msgid "mime_vm"
msgstr "ਵਰਚੁਅਲ ਮਸ਼ੀਨ ਇਮੇਜ (VMDK, VDI, VHDX, OVA ਅਤੇ ਹੋਰ ਵਰਚੁਅਲ ਮਸ਼ੀਨ ਡਿਸਕ ਫਾਈਲਾਂ, VMware, VirtualBox, Hyper-V ਵਰਚੁਅਲਾਈਜ਼ੇਸ਼ਨ ਪਲੇਟਫਾਰਮਾਂ ਦੇ ਫਾਰਮੈਟ)"

msgid "mime_torrent"
msgstr "BitTorrent ਟੋਰੈਂਟ ਫਾਈਲ (2001 ਵਿੱਚ Bram Cohen ਦੁਆਰਾ ਖੋਜੀ ਗਈ, P2P ਡਾਊਨਲੋਡ ਸੂਚਕਾਂਕ ਫਾਈਲ, ਫਾਈਲ ਮੈਟਾਡਾਟਾ ਅਤੇ ਟਰੈਕਰ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਕਰਦੀ ਹੈ)"

msgid "mime_gis"
msgstr "GIS ਭੂਗੋਲਿਕ ਜਾਣਕਾਰੀ ਪ੍ਰਣਾਲੀ ਦਾ ਡਾਟਾ (Shapefile, GeoJSON ਅਤੇ ਹੋਰ ਭੂ-ਅਵਕਾਸ਼ੀ ਡਾਟਾ ਫਾਰਮੈਟ, ਨਕਸ਼ਿਆਂ ਅਤੇ ਅਵਕਾਸ਼ੀ ਵਿਸ਼ਲੇਸ਼ਣ ਲਈ ਵਰਤੇ ਜਾਂਦੇ ਹਨ)"

msgid "mime_ebook"
msgstr "ਈ-ਕਿਤਾਬ (EPUB, MOBI, AZW ਈ-ਕਿਤਾਬ ਫਾਰਮੈਟ। EPUB ਅੰਤਰਰਾਸ਼ਟਰੀ ਮਿਆਰ ਹੈ, MOBI/AZW Amazon Kindle ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_avif"
msgstr "AVIF ਚਿੱਤਰ (2019 ਵਿੱਚ ਓਪਨ ਮੀਡੀਆ ਅਲਾਇੰਸ ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, AV1 'ਤੇ ਅਧਾਰਤ, ਸੰਕੁਚਨ ਦਰ WebP ਨਾਲੋਂ 50% ਬਿਹਤਰ ਹੈ, ਨਵੀਂ ਪੀੜ੍ਹੀ ਦੇ ਵੈੱਬ ਚਿੱਤਰਾਂ ਦਾ ਮਿਆਰ)"

msgid "mime_markdown"
msgstr "Markdown ਦਸਤਾਵੇਜ਼ (2004 ਵਿੱਚ John Gruber ਦੁਆਰਾ ਡਿਜ਼ਾਈਨ ਕੀਤਾ ਗਿਆ, ਹਲਕੀ ਮਾਰਕਅੱਪ ਭਾਸ਼ਾ, GitHub README, ਤਕਨੀਕੀ ਦਸਤਾਵੇਜ਼ੀਕਰਨ, ਫੋਰਮ ਪੋਸਟਾਂ ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਫਾਰਮੈਟ)"

msgid "mime_yaml"
msgstr "YAML ਸੰਰਚਨਾ (2001 ਵਿੱਚ Clark Evans ਦੁਆਰਾ ਡਿਜ਼ਾਈਨ ਕੀਤੀ ਗਈ, ਇਨਸਾਨ ਦੁਆਰਾ ਪੜ੍ਹਨ ਯੋਗ ਡਾਟਾ ਸੀਰੀਅਲਾਈਜ਼ੇਸ਼ਨ ਫਾਰਮੈਟ, Kubernetes, Ansible, Docker Compose ਸੰਰਚਨਾ ਫਾਈਲਾਂ ਦਾ ਮਿਆਰ)"

msgid "mime_toml"
msgstr "TOML ਸੰਰਚਨਾ (2013 ਵਿੱਚ Tom Preston-Werner ਦੁਆਰਾ ਡਿਜ਼ਾਈਨ ਕੀਤੀ ਗਈ, 'Tom's Obvious Minimal Language', Rust/Cargo, Python/pip, Go ਵਰਗੇ ਆਧੁਨਿਕ ਔਜ਼ਾਰਾਂ ਦੀ ਸੰਰਚਨਾ ਫਾਈਲ ਫਾਰਮੈਟ)"

msgid "mime_vue"
msgstr "Vue ਕੰਪੋਨੈਂਟ (2014 ਵਿੱਚ ਯੂ ਯੂਕਸੀ ਦੁਆਰਾ ਵਿਕਸਤ, ਪ੍ਰਗਤੀਸ਼ੀਲ JavaScript ਫਰੇਮਵਰਕ, ਸਿੰਗਲ ਫਾਈਲ ਕੰਪੋਨੈਂਟ ਫਾਰਮੈਟ, ਸਭ ਤੋਂ ਪ੍ਰਸਿੱਧ ਘਰੇਲੂ ਫਰੰਟ-ਐਂਡ ਫਰੇਮਵਰਕ)"

msgid "mime_wasm"
msgstr "WebAssembly ਮੌਡੀਊਲ (2017 ਵਿੱਚ W3C ਮਿਆਰ, ਬਰਾਊਜ਼ਰ ਦਾ ਉੱਚ ਕਾਰਗੁਜ਼ਾਰੀ ਰਨ ਫਾਰਮੈਟ, C/C++/Rust/R ਕੰਪਾਈਲ ਕਰ ਸਕਦੇ ਹਨ, ਕਾਰਗੁਜ਼ਾਰੀ ਮੂਲ ਕੋਡ ਦੇ ਨੇੜੇ ਹੈ)"

msgid "mime_jsx"
msgstr "React JSX ਕੰਪੋਨੈਂਟ (2013 ਵਿੱਚ Facebook ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, JavaScript XML, React ਫਰੇਮਵਰਕ ਕੰਪੋਨੈਂਟ ਸਿੰਟੈਕਸ, HTML ਨੂੰ JavaScript ਵਿੱਚ ਲਿਖਣ ਦੀ ਨਵੀਨਤਾਕਾਰੀ ਵਿਧੀ)"

msgid "mime_tsx"
msgstr "TypeScript TSX ਕੰਪੋਨੈਂਟ (2012 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, TypeScript + JSX, React ਦੇ ਟਾਈਪ ਸੁਰੱਖਿਅਤ ਵਿਕਾਸ ਦੀ ਮਿਆਰੀ ਲਿਖਤ)"

msgid "mime_heif"
msgstr "HEIF ਚਿੱਤਰ (2015 ਵਿੱਚ MPEG ਮਿਆਰ, ਉੱਚ ਕੁਸ਼ਲਤਾ ਵਾਲਾ ਚਿੱਤਰ ਫਾਈਲ ਫਾਰਮੈਟ, Apple ਈਕੋਸਿਸਟਮ ਵਿੱਚ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_heic"
msgstr "HEIC ਚਿੱਤਰ (Apple ਦੀ HEIF ਪਾਲਣਾ, iPhone ਦਾ ਡਿਫੌਲਟ ਫੋਟੋ ਫਾਰਮੈਟ, iOS/macOS ਮੂਲ ਸਮਰਥਨ)"

msgid "mime_gltf"
msgstr "GLTF 3D ਮਾਡਲ (GL ਟ੍ਰਾਂਸਫਰ ਫਾਰਮੈਟ, '3D ਦਾ JPEG', 2015 ਵਿੱਚ Khronos Group ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, ਵੈੱਬ 3D ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_glb"
msgstr "GLB ਬਾਈਨਰੀ 3D ਮਾਡਲ (GLTF ਦਾ ਬਾਈਨਰੀ ਸੰਸਕਰਣ, ਇੱਕ ਫਾਈਲ ਵਿੱਚ ਸਾਰੇ ਸਰੋਤ ਸ਼ਾਮਲ ਹਨ, 3D ਦ੍ਰਿਸ਼ਾਂ ਨੂੰ ਵੰਡਣ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_gls"
msgstr "GLOSSARY ਸ਼ਬਦਾਵਲੀ (ਸ਼ਬਦ ਪਰਿਭਾਸ਼ਾ ਫਾਈਲ, ਦਸਤਾਵੇਜ਼ੀਕਰਨ ਪ੍ਰਣਾਲੀਆਂ ਦੇ ਸ਼ਬਦ ਪ੍ਰਬੰਧਨ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ)"

msgid "mime_cbz"
msgstr "CBZ ਕਾਮਿਕ ਕਿਤਾਬ (ZIP ਵਿੱਚ ਸੰਕੁਚਿਤ ਕਾਮਿਕ ਚਿੱਤਰ, ਕਾਮਿਕ ਸੰਗ੍ਰਹਿ ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਫਾਰਮੈਟ)"

msgid "mime_cbr"
