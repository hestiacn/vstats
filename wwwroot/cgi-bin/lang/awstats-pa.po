msgid "mime_fb2"
msgstr "FB2 ਈ-ਕਿਤਾਬ (FictionBook 2.0, ਰੂਸੀ ਈ-ਕਿਤਾਬ ਫਾਰਮੈਟ, XML ਬਣਤਰ, ਓਪਨ ਸੋਰਸ ਰੀਡਰਾਂ ਦੁਆਰਾ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਸਮਰਥਿਤ)"

msgid "mime_kepub"
msgstr "KEPUB ਈ-ਕਿਤਾਬ (Kobo ਦਾ ਵਿਸ਼ੇਸ਼ EPUB ਫਾਰਮੈਟ, Kobo ਈ-ਕਿਤਾਬ ਰੀਡਰ ਦਾ ਔਪਟੀਮਾਈਜ਼ਡ ਫਾਰਮੈਟ)"

msgid "mime_m4b"
msgstr "M4B ਆਡੀਓ ਕਿਤਾਬ (MPEG-4 ਆਡੀਓ ਕਿਤਾਬ ਫਾਰਮੈਟ, ਬੁੱਕਮਾਰਕ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, iTunes ਆਡੀਓ ਕਿਤਾਬ ਫਾਰਮੈਟ)"

msgid "mime_kfx"
msgstr "Kindle KFX ਫਾਰਮੈਟ (2015 ਵਿੱਚ Amazon ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Kindle ਦਾ ਵਿਸ਼ੇਸ਼ ਈ-ਕਿਤਾਬ ਫਾਰਮੈਟ, ਵਧਿਆ ਹੋਇਆ ਲੇਆਉਟ ਅਤੇ ਤੇਜ਼ ਪੰਨਾ ਪਲਟਣ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)"

msgid "mime_chm"
msgstr "CHM ਮਦਦ ਫਾਈਲ (1997 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤੀ ਗਈ, ਸੰਕਲਿਤ HTML ਮਦਦ ਫਾਰਮੈਟ, Windows ਸਾਫਟਵੇਅਰ ਮਦਦ ਦਸਤਾਵੇਜ਼ੀਕਰਨ ਦਾ ਮਿਆਰ)"

msgid "mime_mht"
msgstr "MHT ਵੈੱਬ ਆਰਕਾਈਵ (1999 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, ਸਿੰਗਲ ਫਾਈਲ ਵੈੱਬ ਪੰਨਾ ਫਾਰਮੈਟ, IE ਬਰਾਊਜ਼ਰ ਦੁਆਰਾ ਪੰਨੇ ਸੁਰੱਖਿਅਤ ਕਰਨ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਫਾਰਮੈਟ)"

msgid "mime_wml"
msgstr "WML ਵਾਇਰਲੈੱਸ ਮਾਰਕਅੱਪ ਭਾਸ਼ਾ (1999 ਵਿੱਚ WAP ਮਿਆਰ, ਸ਼ੁਰੂਆਤੀ ਫੀਚਰ ਫੋਨਾਂ ਦੇ ਵੈੱਬ ਪੰਨਿਆਂ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਸੀ, ਹੁਣ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ)"

msgid "mime_xhtml"
msgstr "XHTML ਵੈੱਬ ਪੰਨਾ (2000 ਵਿੱਚ W3C ਮਿਆਰ, HTML ਦਾ XML ਸੰਸਕਰਣ, ਵਧੇਰੇ ਸਖਤ ਸਿੰਟੈਕਸ ਨਾਲ। 2009 ਵਿੱਚ W3C ਨੇ ਸਮਰਥਨ ਬੰਦ ਕਰ ਦਿੱਤਾ, ਧਿਆਨ HTML5 ਵੱਲ ਤਬਦੀਲ ਕੀਤਾ)"

msgid "mime_xml"
msgstr "XML ਦਸਤਾਵੇਜ਼ (1998 ਵਿੱਚ W3C ਮਿਆਰ, ਐਕਸਟੈਂਸੀਬਲ ਮਾਰਕਅੱਪ ਭਾਸ਼ਾ, ਵੈੱਬ ਸੇਵਾਵਾਂ, ਸੰਰਚਨਾ ਫਾਈਲਾਂ, ਡਾਟਾ ਅਦਲਾ-ਬਦਲੀ ਦਾ ਮੂਲ ਫਾਰਮੈਟ)"

msgid "mime_sgml"
msgstr "SGML ਦਸਤਾਵੇਜ਼ (1986 ਵਿੱਚ ISO ਮਿਆਰ, HTML ਦਾ ਪੂਰਵਜ, ਸਟੈਂਡਰਡ ਜਨਰਲਾਈਜ਼ਡ ਮਾਰਕਅੱਪ ਭਾਸ਼ਾ, XML ਅਤੇ HTML ਦੋਵੇਂ SGML ਤੋਂ ਉਤਪੰਨ ਹੋਏ ਹਨ)"

msgid "mime_apng"
msgstr "APNG ਐਨੀਮੇਸ਼ਨ (2004 ਵਿੱਚ Mozilla ਦੁਆਰਾ ਵਿਕਸਤ, PNG ਦਾ ਐਨੀਮੇਟਿਡ ਵਿਸਥਾਰ, GIF ਦਾ ਆਧੁਨਿਕ ਬਦਲ, ਅਸਲੀ ਰੰਗ ਅਤੇ ਅਰਧ-ਪਾਰਦਰਸ਼ਤਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)"

msgid "mime_bmp"
msgstr "BMP ਬਿਟਮੈਪ (Windows ਬਿਟਮੈਪ ਫਾਰਮੈਟ, Windows 1.0 ਤੋਂ ਮੂਲ ਸਮਰਥਨ। ਸੰਕੁਚਿਤ ਨਹੀਂ, ਫਾਈਲ ਮੁਕਾਬਲਤਨ ਵੱਡੀ ਹੈ, ਪਰ ਸਧਾਰਨ ਬਣਤਰ ਦੇ ਕਾਰਨ ਅਤੇ ਵਾਧੂ ਕੋਡੈਕਸ ਦੀ ਲੋੜ ਨਾ ਹੋਣ ਕਰਕੇ, Windows 11 ਸਕ੍ਰੀਨਸ਼ਾਟ ਟੂਲ, ਪੇਂਟ ਪ੍ਰੋਗਰਾਮ, EXE/MSI ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ ਆਈਕਨ ਸਰੋਤ, ਕਰਸਰ ਫਾਈਲਾਂ ਅਤੇ ਕੁਝ ਪੁਰਾਣੇ ਡਰਾਈਵਰ ਅਜੇ ਵੀ ਵਰਤਦੇ ਹਨ। ਸਮਾਨ ਗੁਣਵੱਤਾ ਵਾਲੀ ਤਸਵੀਰ ਲਈ ਫਾਈਲ PNG ਨਾਲੋਂ ਲਗਭਗ 3-10 ਗੁਣਾ ਵੱਡੀ ਹੈ, ਜ਼ਿਆਦਾਤਰ ਮਾਮਲਿਆਂ ਵਿੱਚ PNG/JPEG ਦੁਆਰਾ ਬਦਲ ਦਿੱਤੀ ਗਈ ਹੈ, ਪਰ Windows ਈਕੋਸਿਸਟਮ ਵਿੱਚ ਅਜੇ ਵੀ ਵਿਆਪਕ ਅਨੁਕੂਲਤਾ ਬਣਾਈ ਰੱਖਦੀ ਹੈ)"

msgid "mime_cdr"
msgstr "CDR ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ (CorelDRAW ਦਾ ਵਿਸ਼ੇਸ਼ ਫਾਰਮੈਟ, ਕੈਨੇਡੀਅਨ Corel ਕੰਪਨੀ, ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ ਡਿਜ਼ਾਈਨ ਸਾਫਟਵੇਅਰ)"

msgid "mime_gif"
msgstr "GIF ਚਿੱਤਰ (1987 ਵਿੱਚ CompuServe ਦੁਆਰਾ ਵਿਕਸਤ, 256 ਰੰਗਾਂ ਵਾਲਾ ਮੂਵਿੰਗ ਚਿੱਤਰ ਫਾਰਮੈਟ। ਕਮੀਆਂ: ਘੱਟ ਰੰਗ, ਘੱਟ ਗੁਣਵੱਤਾ, ਅਰਧ-ਪਾਰਦਰਸ਼ਤਾ ਨਹੀਂ, ਵੱਡੀ ਫਾਈਲ, ਘੱਟ ਫ੍ਰੇਮ ਦਰ। APNG, WebP ਵਰਗੇ ਆਧੁਨਿਕ ਮੂਵਿੰਗ ਚਿੱਤਰ ਫਾਰਮੈਟਾਂ ਦੁਆਰਾ ਬਦਲ ਦਿੱਤਾ ਗਿਆ ਹੈ)"

msgid "mime_ico"
msgstr "ICO ਆਈਕਨ (Windows ਆਈਕਨ ਫਾਈਲ ਫਾਰਮੈਟ, ਬਹੁ-ਰੈਜ਼ੋਲੂਸ਼ਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਵੈੱਬਸਾਈਟ favicon ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_jpeg"
msgstr "JPEG ਚਿੱਤਰ (1992 ਵਿੱਚ ISO ਮਿਆਰ, ਨੁਕਸਾਨ ਸਹਿਤ ਸੰਕੁਚਨ ਫੋਟੋ ਫਾਰਮੈਟ, ਇੰਟਰਨੈੱਟ ਫੋਟੋ ਦਾ ਅਸਲ ਮਿਆਰ)"

msgid "mime_jpg"
msgstr "JPEG ਚਿੱਤਰ (1992 ਵਿੱਚ ISO ਮਿਆਰ, ਨੁਕਸਾਨ ਸਹਿਤ ਸੰਕੁਚਨ ਫੋਟੋ ਫਾਰਮੈਟ, ਇੰਟਰਨੈੱਟ ਫੋਟੋ ਦਾ ਅਸਲ ਮਿਆਰ)"

msgid "mime_png"
msgstr "PNG ਚਿੱਤਰ (1996 ਵਿੱਚ W3C ਸਿਫ਼ਾਰਿਸ਼, ਅਸਲੀ ਰੰਗ ਅਤੇ ਅਰਧ-ਪਾਰਦਰਸ਼ਤਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, GIF ਦਾ ਸਥਿਰ ਬਦਲ, ਇੰਟਰਨੈੱਟ ਦਾ ਨੁਕਸਾਨ ਰਹਿਤ ਚਿੱਤਰ ਮਿਆਰ)"

msgid "mime_ps"
msgstr "PostScript ਪੰਨਾ ਵਰਣਨ ਫਾਈਲ (1985 ਵਿੱਚ Adobe ਦੁਆਰਾ ਜਾਰੀ ਕੀਤੀ ਗਈ, ਪੰਨਾ ਵਰਣਨ ਭਾਸ਼ਾ, PDF ਦਾ ਪੂਰਵਜ, ਪ੍ਰਿੰਟਿੰਗ ਅਤੇ ਪ੍ਰਕਾਸ਼ਨ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ)"

msgid "mime_psb"
msgstr "PSB ਵੱਡਾ ਦਸਤਾਵੇਜ਼ (Adobe Photoshop ਦਾ ਅਤਿ-ਵੱਡਾ ਚਿੱਤਰ ਫਾਰਮੈਟ, 2GB ਜਾਂ 30000 ਪਿਕਸਲ ਤੋਂ ਵੱਡੀਆਂ ਤਸਵੀਰਾਂ ਨੂੰ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)"

msgid "mime_psd"
msgstr "PSD ਚਿੱਤਰ (Adobe Photoshop ਦੀ ਸਰੋਤ ਫਾਈਲ, ਪਰਤਾਂ, ਚੈਨਲਾਂ, ਮਾਰਗਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਚਿੱਤਰ ਪ੍ਰੋਸੈਸਿੰਗ ਉਦਯੋਗ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_webp"
msgstr "WebP ਚਿੱਤਰ (2010 ਵਿੱਚ Google ਦੁਆਰਾ ਵਿਕਸਤ, ਵੈੱਬ ਚਿੱਤਰ ਫਾਰਮੈਟ, ਨੁਕਸਾਨ/ਨੁਕਸਾਨ ਰਹਿਤ ਸੰਕੁਚਨ ਅਤੇ ਐਨੀਮੇਸ਼ਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਸੰਕੁਚਨ ਦਰ PNG ਨਾਲੋਂ 25-35% ਬਿਹਤਰ ਹੈ, JPEG ਨਾਲੋਂ 25% ਬਿਹਤਰ ਹੈ)"

msgid "mime_woff"
msgstr "WOFF ਵੈੱਬ ਫੌਂਟ (2009 ਵਿੱਚ ਬਣਾਇਆ ਗਿਆ, 2018 ਵਿੱਚ W3C ਮਿਆਰ। TrueType/OpenType 'ਤੇ ਅਧਾਰਤ ਸੰਕੁਚਿਤ, ਵੈੱਬ ਫੌਂਟ ਲੋਡਿੰਗ ਔਪਟੀਮਾਈਜ਼ੇਸ਼ਨ, ਆਧੁਨਿਕ ਵੈੱਬਸਾਈਟ ਆਈਕਨ ਫੌਂਟਾਂ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_7z"
msgstr "7z ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1999 ਵਿੱਚ Igor Pavlov ਦੁਆਰਾ ਵਿਕਸਤ, 7-Zip ਪ੍ਰੋਗਰਾਮ ਦਾ ਵਿਸ਼ੇਸ਼ ਫਾਰਮੈਟ। LZMA ਐਲਗੋਰਿਦਮ, ਉੱਚ ਸੰਕੁਚਨ ਦਰ, ਓਪਨ ਸੋਰਸ ਅਤੇ ਮੁਫ਼ਤ ਹੈ। 7z ਫਾਰਮੈਟ ਇੱਕੋ ਸੰਕੁਚਨ ਪੱਧਰ 'ਤੇ ਆਮ ਤੌਰ 'ਤੇ ZIP ਨਾਲੋਂ 30-50% ਛੋਟਾ ਹੈ, ਓਪਨ ਸੋਰਸ ਕਮਿਊਨਿਟੀ ਅਤੇ ਸਾਫਟਵੇਅਰ ਵੰਡ ਦਾ ਆਮ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_ace"
msgstr "ACE ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1990 ਦੇ ਦਹਾਕੇ ਵਿੱਚ ਬਣਾਇਆ ਗਿਆ, WinACE ਪ੍ਰੋਗਰਾਮ ਫਾਰਮੈਟ। RAR ਨਾਲ ਮੁਕਾਬਲਾ ਕੀਤਾ, ਸੰਕੁਚਨ ਦਰ ਬਹੁਤ ਉੱਚੀ ਸੀ। 2007 ਵਿੱਚ ਵਿਕਾਸ ਬੰਦ ਕਰ ਦਿੱਤਾ ਗਿਆ, ਹੁਣ 7z/RAR ਦੁਆਰਾ ਬਦਲ ਦਿੱਤਾ ਗਿਆ, ਘੱਟ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_bz2"
msgstr "BZIP2 ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1996 ਵਿੱਚ Julian Seward ਦੁਆਰਾ ਵਿਕਸਤ, ਬਲਾਕ ਸੌਰਟਿੰਗ ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ। ਸੰਕੁਚਨ ਦਰ GZIP ਨਾਲੋਂ 15-20% ਬਿਹਤਰ ਹੈ, ਪਰ ਗਤੀ ਹੌਲੀ ਹੈ। Linux ਕਰਨਲ ਸਰੋਤ ਕੋਡ, ਓਪਨ ਸੋਰਸ ਪੈਕੇਜਾਂ ਦਾ ਆਮ ਫਾਰਮੈਟ, ਐਕਸਟੈਂਸ਼ਨ .bz2)"

msgid "mime_cab"
msgstr "CAB ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1995 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, ਕੈਬਨਿਟ ਫਾਰਮੈਟ। Windows ਸਿਸਟਮ ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ ਫਾਰਮੈਟ, ਡਰਾਈਵਰ, ਸਿਸਟਮ ਫਾਈਲਾਂ ਵੰਡਣ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। Windows Installer (MSI) ਅੰਦਰੂਨੀ ਤੌਰ 'ਤੇ CAB ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਫਾਈਲਾਂ ਸਟੋਰ ਕਰਦਾ ਹੈ)"

msgid "mime_dmg"
msgstr "DMG ਡਿਸਕ ਇਮੇਜ (1980 ਦੇ ਦਹਾਕੇ ਵਿੱਚ Apple ਦੁਆਰਾ ਜਾਰੀ ਕੀਤੀ ਗਈ, ਡਿਸਕ ਇਮੇਜ ਫਾਰਮੈਟ। macOS ਸਾਫਟਵੇਅਰ ਵੰਡ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, ਡਬਲ ਕਲਿੱਕ ਕਰਨ ਨਾਲ ਵਰਚੁਅਲ ਡਿਸਕ ਵਜੋਂ ਮਾਊਂਟ ਹੁੰਦੀ ਹੈ, ਐਪਲੀਕੇਸ਼ਨ ਇੰਸਟਾਲ ਕਰਨ ਲਈ ਸਿਰਫ਼ ਡ੍ਰੈਗ ਅਤੇ ਡ੍ਰੌਪ ਕਰੋ। ਸੰਕੁਚਨ ਅਤੇ ਏਨਕ੍ਰਿਪਸ਼ਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਮੈਕ ਸਾਫਟਵੇਅਰ ਡਾਊਨਲੋਡਾਂ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_emz"
msgstr "EMZ ਸੰਕੁਚਿਤ ਚਿੱਤਰ (Windows ਸੰਕੁਚਿਤ ਸੁਧਰਿਆ ਮੈਟਾਫਾਈਲ, EMF ਦਾ ਸੰਕੁਚਿਤ ਸੰਸਕਰਣ। Office ਦਸਤਾਵੇਜ਼ਾਂ ਵਿੱਚ ਵੈਕਟਰ ਗ੍ਰਾਫਿਕਸ ਸਟੋਰ ਕਰਨ ਦਾ ਫਾਰਮੈਟ, ਅਸਲ ਵਿੱਚ GZIP ਦੁਆਰਾ ਸੰਕੁਚਿਤ EMF ਫਾਈਲ ਹੈ)"

msgid "mime_gz"
msgstr "GZIP ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1992 ਵਿੱਚ Jean-loup Gailly ਅਤੇ Mark Adler ਦੁਆਰਾ ਵਿਕਸਤ, GNU ਪ੍ਰੋਜੈਕਟ। Unix/Linux ਦਾ ਮਿਆਰੀ ਸੰਕੁਚਨ ਟੂਲ, HTTP ਟਰਾਂਸਮਿਸ਼ਨ ਸੰਕੁਚਨ ਦਾ ਆਮ ਫਾਰਮੈਟ। ਐਕਸਟੈਂਸ਼ਨ .gz, ਆਮ ਤੌਰ 'ਤੇ TAR ਨਾਲ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_jar"
msgstr "JAR ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1997 ਵਿੱਚ Sun Microsystems ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Java ARchive ਫਾਰਮੈਟ। ਅਸਲ ਵਿੱਚ ZIP ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ, ਜਾਵਾ ਕਲਾਸ ਲਾਇਬ੍ਰੇਰੀਆਂ ਅਤੇ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ ਪੈਕੇਜ ਕਰਨ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। Maven, Gradle ਵਰਗੀ ਜਾਵਾ ਈਕੋਸਿਸਟਮ ਦਾ ਮੂਲ ਫਾਰਮੈਟ, Android ਵੀ JAR ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ)"

msgid "mime_lzma"
msgstr "LZMA ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1998 ਵਿੱਚ Igor Pavlov ਦੁਆਰਾ ਵਿਕਸਤ, Lempel-Ziv-Markov chain ਐਲਗੋਰਿਦਮ। 7z ਫਾਰਮੈਟ ਦਾ ਮੂਲ ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ, ਉੱਚ ਸੰਕੁਚਨ ਦਰ, ਡੀਕੰਪ੍ਰੈਸ਼ਨ ਗਤੀ ਤੇਜ਼ ਹੈ। ਫਰਮਵੇਅਰ, ਐਂਬੇਡਡ ਸਿਸਟਮਾਂ ਦੇ ਸਾਫਟਵੇਅਰ ਵੰਡ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_rar"
msgstr "RAR ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1993 ਵਿੱਚ Eugene Roshal ਦੁਆਰਾ ਵਿਕਸਤ, Roshal ARchive ਫਾਰਮੈਟ। ਉੱਚ ਸੰਕੁਚਨ ਦਰ, ਬਹੁ-ਭਾਗ ਸੰਕੁਚਨ, ਮੁੜ-ਸਥਾਪਨਾ ਰਿਕਾਰਡ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। WinRAR ਪ੍ਰੋਗਰਾਮ ਫਾਰਮੈਟ, ਸੰਕੁਚਨ ਦਰ ZIP ਨਾਲੋਂ ਬਿਹਤਰ ਹੈ, ਪਰ ਭੁਗਤਾਨ ਕੀਤੇ ਸਾਫਟਵੇਅਰ ਦੀ ਲੋੜ ਹੈ, unrar ਵਰਗੇ ਓਪਨ ਸੋਰਸ ਟੂਲ ਇਸਨੂੰ ਡੀਕੰਪ੍ਰੈਸ ਕਰ ਸਕਦੇ ਹਨ)"

msgid "mime_tar"
msgstr "TAR ਆਰਕਾਈਵ (1979 ਵਿੱਚ Unix V7 ਵਿੱਚ ਪੇਸ਼ ਕੀਤਾ ਗਿਆ, ਟੇਪ ਆਰਕਾਈਵ ਫਾਰਮੈਟ। ਟੇਪ ਆਰਕਾਈਵ ਫਾਰਮੈਟ, ਸੰਕੁਚਨ ਨਹੀਂ ਕਰਦਾ, ਸਿਰਫ਼ ਪੈਕ ਕਰਦਾ ਹੈ, ਆਮ ਤੌਰ 'ਤੇ GZIP/BZIP2/XZ ਨਾਲ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। Linux ਸਾਫਟਵੇਅਰ ਪੈਕੇਜਾਂ ਦਾ ਸਰੋਤ ਕੋਡ, ਡੌਕਰ ਕੰਟੇਨਰ ਲੇਅਰਾਂ ਦਾ ਸਟੋਰੇਜ TAR ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ)"

msgid "mime_tgz"
msgstr "TGZ ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (TAR + GZIP ਸੰਯੋਜਨ ਫਾਰਮੈਟ, ਐਕਸਟੈਂਸ਼ਨ .tgz ਜਾਂ .tar.gz। Unix/Linux ਸਾਫਟਵੇਅਰ ਪੈਕੇਜਾਂ ਦਾ ਸਭ ਤੋਂ ਆਮ ਵੰਡ ਫਾਰਮੈਟ, ਸਰੋਤ ਕੋਡ ਪੈਕੇਜ, ਬਾਈਨਰੀ ਪੈਕੇਜ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤੇ ਜਾਂਦੇ ਹਨ, 'ਅਨਪੈਕ ਕਰੋ ਅਤੇ ਵਰਤੋਂ' ਪ੍ਰਤੀਨਿਧੀ)"

msgid "mime_tbz2"
msgstr "TBZ2 ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (TAR + BZIP2 ਸੰਯੋਜਨ ਫਾਰਮੈਟ, ਐਕਸਟੈਂਸ਼ਨ .tbz2 ਜਾਂ .tar.bz2। ਸੰਕੁਚਨ ਦਰ TGZ ਨਾਲੋਂ 15-20% ਬਿਹਤਰ ਹੈ, ਵੱਡੀਆਂ ਫਾਈਲਾਂ ਲਈ ਢੁਕਵਾਂ ਹੈ, Linux ਕਰਨਲ ਸਰੋਤ ਕੋਡ ਨੇ ਲੰਬੇ ਸਮੇਂ ਤੱਕ ਇਸ ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕੀਤੀ)"

msgid "mime_xz"
msgstr "XZ ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (2009 ਵਿੱਚ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, LZMA2 ਐਲਗੋਰਿਦਮ 'ਤੇ ਅਧਾਰਤ। ਸੰਕੁਚਨ ਦਰ ਬਹੁਤ ਉੱਚੀ ਹੈ, GZIP ਨਾਲੋਂ 30-50% ਬਿਹਤਰ ਹੈ, ਡੀਕੰਪ੍ਰੈਸ਼ਨ ਗਤੀ ਮੁਕਾਬਲਤਨ ਤੇਜ਼ ਹੈ। Linux ਕਰਨਲ, ਪੈਕੇਜ ਮੈਨੇਜਰ (ਜਿਵੇਂ Debian ਦੇ .deb ਅੰਦਰ) ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਦੇ ਹਨ, ਮੌਜੂਦਾ Linux ਈਕੋਸਿਸਟਮ ਦਾ ਸਿਫ਼ਾਰਿਸ਼ ਕੀਤਾ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_z"
msgstr "Z ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1985 ਵਿੱਚ Unix ਕੰਪ੍ਰੈਸ ਕਮਾਂਡ ਦਾ ਫਾਰਮੈਟ, LZW ਐਲਗੋਰਿਦਮ। ਸ਼ੁਰੂਆਤੀ Unix ਸੰਕੁਚਨ ਫਾਰਮੈਟ, ਪਹਿਲਾਂ ਹੀ GZIP ਦੁਆਰਾ ਬਦਲ ਦਿੱਤਾ ਗਿਆ ਹੈ। ਐਕਸਟੈਂਸ਼ਨ .Z, ਆਧੁਨਿਕ ਪ੍ਰਣਾਲੀਆਂ ਵਿੱਚ ਘੱਟ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_zip"
msgstr "ZIP ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1989 ਵਿੱਚ Phil Katz ਦੁਆਰਾ ਵਿਕਸਤ, PKZIP ਫਾਰਮੈਟ। Windows ਮੂਲ ਸਮਰਥਨ, ਇੰਟਰਨੈੱਟ 'ਤੇ ਸਭ ਤੋਂ ਆਮ ਸੰਕੁਚਨ ਫਾਰਮੈਟ। ਕਈ ਫਾਈਲਾਂ, ਡਾਇਰੈਕਟਰੀ ਬਣਤਰ ਨੂੰ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ ਚੁਣਨ ਦੀ ਯੋਗਤਾ ਹੈ। Java ਦਾ JAR, Android ਦਾ APK, Office ਦਸਤਾਵੇਜ਼ਾਂ ਦਾ DOCX/XLSX ਸਾਰੇ ZIP ਫਾਰਮੈਟ 'ਤੇ ਅਧਾਰਤ ਹਨ)"

msgid "mime_zst"
msgstr "Zstandard ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (2015 ਵਿੱਚ Facebook ਦੁਆਰਾ ਵਿਕਸਤ, Yann Collet ਦੁਆਰਾ ਡਿਜ਼ਾਈਨ। ਉੱਚ ਗਤੀ ਵਾਲਾ ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ, ਸੰਕੁਚਨ ਦਰ LZMA ਦੇ ਨੇੜੇ ਹੈ, ਗਤੀ ਵਿੱਚ GZIP ਨੂੰ ਬਹੁਤ ਪਛਾੜਦਾ ਹੈ। Linux ਕਰਨਲ 5.9+ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, Arch Linux pacman, Debian APT ਹੌਲੀ-ਹੌਲੀ ਅਪਣਾ ਰਹੇ ਹਨ, ਨਵੀਂ ਪੀੜ੍ਹੀ ਦਾ ਸੰਕੁਚਨ ਮਿਆਰ ਹੈ)"

msgid "mime_lz4"
msgstr "LZ4 ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (2011 ਵਿੱਚ Yann Collet ਦੁਆਰਾ ਵਿਕਸਤ, ਬਹੁਤ ਤੇਜ਼ ਸੰਕੁਚਨ ਐਲਗੋਰਿਦਮ। ਸੰਕੁਚਨ ਗਤੀ GZIP ਨਾਲੋਂ 10 ਗੁਣਾ ਤੇਜ਼ ਹੈ, ਅਸਲ-ਸਮੇਂ ਦੇ ਸੰਕੁਚਨ ਲਈ ਢੁਕਵਾਂ ਹੈ। Linux ਕਰਨਲ, OpenZFS, Hadoop ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਦੇ ਹਨ, ਗਤੀ ਨੂੰ ਤਰਜੀਹ ਦੇਣ ਵਾਲੇ ਮਾਮਲਿਆਂ ਵਿੱਚ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_lzo"
msgstr "LZO ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ (1996 ਵਿੱਚ Markus Oberhumer ਦੁਆਰਾ ਵਿਕਸਤ, Lempel-Ziv-Oberhumer ਐਲਗੋਰਿਦਮ। ਡੀਕੰਪ੍ਰੈਸ਼ਨ ਗਤੀ ਬਹੁਤ ਤੇਜ਼ ਹੈ, ਸੰਕੁਚਨ ਦਰ ਦਰਮਿਆਨੀ ਹੈ। Linux ਕਰਨਲ ਦਾ Squashfs, OpenWrt ਫਰਮਵੇਅਰ ਵਰਤਦਾ ਹੈ, ਐਂਬੇਡਡ ਪ੍ਰਣਾਲੀਆਂ ਲਈ ਢੁਕਵਾਂ ਹੈ)"

msgid "mime_msi"
msgstr "MSI ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ (1999 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Windows ਇੰਸਟਾਲਰ ਪੈਕੇਜ ਫਾਰਮੈਟ। Windows ਐਪਲੀਕੇਸ਼ਨਾਂ ਦਾ ਮਿਆਰੀ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ, ਟ੍ਰਾਂਜ਼ੈਕਸ਼ਨ ਰੋਲਬੈਕ, ਕੰਪੋਨੈਂਟ ਪ੍ਰਬੰਧਨ, ਚੁੱਪ ਇੰਸਟਾਲੇਸ਼ਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। ਕਾਰਪੋਰੇਟ ਪੱਧਰ ਦੇ ਸਾਫਟਵੇਅਰ ਵੰਡ ਲਈ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ, ਅੱਜ ਵੀ Windows ਸਾਫਟਵੇਅਰ ਇੰਸਟਾਲੇਸ਼ਨ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_pkg"
msgstr "PKG ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ (macOS ਐਪਲੀਕੇਸ਼ਨ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ, Apple ਦੀ ਇੰਸਟਾਲਰ ਤਕਨਾਲੋਜੀ 'ਤੇ ਅਧਾਰਤ। macOS ਸਾਫਟਵੇਅਰ ਵੰਡ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, ਕੰਪੋਨੈਂਟ ਚੋਣ, ਇੰਸਟਾਲੇਸ਼ਨ ਸਕ੍ਰਿਪਟਾਂ, ਅਣਇੰਸਟਾਲੇਸ਼ਨ ਫੰਕਸ਼ਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। .pkg ਫਾਈਲ 'ਤੇ ਡਬਲ ਕਲਿੱਕ ਕਰਨ ਨਾਲ ਇੰਸਟਾਲ ਹੋ ਜਾਂਦੀ ਹੈ, Mac App Store ਤੋਂ ਇਲਾਵਾ ਸਾਫਟਵੇਅਰ ਵੰਡ ਦਾ ਆਮ ਤਰੀਕਾ ਹੈ)"

msgid "mime_apk"
msgstr "APK Android ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2008 ਵਿੱਚ Google ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Android ਪ੍ਰਣਾਲੀ ਦਾ ਰਵਾਇਤੀ ਐਪਲੀਕੇਸ਼ਨ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ। APK ਅਸਲ ਵਿੱਚ ZIP ਸੰਕੁਚਿਤ ਆਰਕਾਈਵ ਹੈ, ਕੋਡ, ਸਰੋਤ, ਮੈਨੀਫੈਸਟ ਫਾਈਲ ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ। 2021 ਤੋਂ Google Play ਨਵੀਆਂ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ AAB ਫਾਰਮੈਟ 'ਤੇ ਬਦਲਣ ਲਈ ਮਜਬੂਰ ਕਰਦਾ ਹੈ, ਪਰ APK ਅਜੇ ਵੀ ਵਿਕਾਸ, ਡੀਬੱਗਿੰਗ, ਤੀਜੀ-ਧਿਰ ਸਟੋਰ ਅਤੇ ਸਾਈਡਲੋਡਿੰਗ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_ipa"
msgstr "IPA Apple ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (iOS App Store Package, iOS/iPadOS ਐਪਲੀਕੇਸ਼ਨ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ। 2008 ਵਿੱਚ iPhone SDK ਦੇ ਨਾਲ ਜਾਰੀ ਕੀਤਾ ਗਿਆ। App Store ਰਾਹੀਂ ਵੰਡਣਾ ਜਾਂ ਕਾਰਪੋਰੇਟ ਸਰਟੀਫਿਕੇਟ ਨਾਲ ਸਾਈਨ ਕਰਨਾ ਲੋੜੀਂਦਾ ਹੈ। ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਫਾਈਲ, ਸਰੋਤ, Info.plist, ਸਾਈਨਿੰਗ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ)"

msgid "mime_hap"
msgstr "HAP ਹਾਰਮਨੀ OS ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (HarmonyOS ਯੋਗਤਾ ਪੈਕੇਜ, ਹਾਰਮਨੀ OS ਐਪਲੀਕੇਸ਼ਨ ਦੀ ਮੂਲ ਇਕਾਈ। 2020 ਵਿੱਚ ਹਾਰਮਨੀ OS 2.0 ਦੇ ਨਾਲ ਜਾਰੀ ਕੀਤਾ ਗਿਆ। ਐਂਟਰੀ ਅਤੇ ਫੀਚਰ ਦੋ ਕਿਸਮਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਹੁਆਵੇਈ ਫੋਨ, ਟੈਬਲੈੱਟ, ਸਮਾਰਟ ਵਾਚ ਸਮੇਤ ਹਾਰਮਨੀ OS ਡਿਵਾਈਸਾਂ ਦੇ ਵੰਡ ਫਾਰਮੈਟ)"

msgid "mime_har"
msgstr "HAR ਹਾਰਮਨੀ OS ਸਥਿਰ ਸਾਂਝਾ ਪੈਕੇਜ (HarmonyOS ਆਰਕਾਈਵ, ਹਾਰਮਨੀ OS ਸਥਿਰ ਸਾਂਝੀ ਲਾਇਬ੍ਰੇਰੀ, ਕਈ HAP ਦੇ ਵਿਚਕਾਰ ਸਾਂਝਾ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, ਕੰਪੋਨੈਂਟ-ਅਧਾਰਤ ਵਿਕਾਸ ਅਤੇ ਮੋਡੀਊਲ ਮੁੜ-ਵਰਤੋਂ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_aab"
msgstr "Android App Bundle (2018 ਵਿੱਚ Google ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, 2021 ਤੋਂ Google Play ਨਵੀਆਂ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ ਇਸ ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕਰਨ ਲਈ ਮਜਬੂਰ ਕਰਦਾ ਹੈ। AAB ਵੰਡ ਫਾਰਮੈਟ ਹੈ, Google Play ਡਿਵਾਈਸ ਸੰਰਚਨਾ ਦੇ ਅਨੁਸਾਰ (CPU ਆਰਕੀਟੈਕਚਰ, ਸਕ੍ਰੀਨ ਘਣਤਾ, ਭਾਸ਼ਾ) ਡਾਇਨਾਮਿਕ ਤੌਰ 'ਤੇ ਔਪਟੀਮਾਈਜ਼ਡ APK ਬਣਾਉਂਦਾ ਹੈ, ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ ਦਾ ਆਕਾਰ ਔਸਤਨ 35% ਘਟਦਾ ਹੈ। ਵਿਕਾਸਕਾਰ AAB ਅਪਲੋਡ ਕਰਦਾ ਹੈ, ਉਪਭੋਗੀ APK ਡਾਊਨਲੋਡ ਕਰਦਾ ਹੈ)"

msgid "mime_xapk"
msgstr "XAPK ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (ਤੀਜੀ-ਧਿਰ Android ਐਪਲੀਕੇਸ਼ਨ ਵਿਸਤ੍ਰਿਤ ਪੈਕੇਜ, APK + OBB ਡਾਟਾ ਫਾਈਲਾਂ ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ। ਵੱਡੀਆਂ ਗੇਮਾਂ ਅਤੇ ਗੁੰਝਲਦਾਰ ਐਪਲੀਕੇਸ਼ਨਾਂ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ, APK ਦੀ 100MB ਸੀਮਾ ਸਮੱਸਿਆ ਨੂੰ ਹੱਲ ਕਰਦਾ ਹੈ। APKPure, APKMirror ਤੀਜੀ-ਧਿਰ ਐਪਲੀਕੇਸ਼ਨ ਸਟੋਰਾਂ ਵਿੱਚ ਆਮ ਹੈ, Google ਦਾ ਅਧਿਕਾਰਤ ਫਾਰਮੈਟ ਨਹੀਂ ਹੈ)"

msgid "mime_appx"
msgstr "Windows ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2012 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Windows 8/10/11 ਐਪਲੀਕੇਸ਼ਨ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ। UWP ਅਤੇ ਡੈਸਕਟਾਪ ਐਪਲੀਕੇਸ਼ਨ ਰੂਪਾਂਤਰਨ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, Microsoft Store ਰਾਹੀਂ ਵੰਡਿਆ ਜਾਂਦਾ ਹੈ। 2024 ਵਿੱਚ Microsoft ਨੇ MSIX ਨੂੰ ਉੱਤਰਾਧਿਕਾਰੀ ਫਾਰਮੈਟ ਵਜੋਂ ਜਾਰੀ ਕੀਤਾ, ਹੌਲੀ-ਹੌਲੀ APPX ਦੀ ਥਾਂ ਲੈਂਦਾ ਹੈ)"

msgid "mime_msix"
msgstr "MSIX ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2018 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Windows ਦਾ ਨਵੀਂ ਪੀੜ੍ਹੀ ਦਾ ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜਿੰਗ ਫਾਰਮੈਟ। APPX ਅਤੇ MSI ਦੇ ਫਾਇਦਿਆਂ ਨੂੰ ਜੋੜਦਾ ਹੈ, ਸਾਰੀਆਂ Windows ਐਪਲੀਕੇਸ਼ਨ ਕਿਸਮਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, Microsoft Store ਰਾਹੀਂ ਜਾਂ ਸਾਈਡਲੋਡਿੰਗ ਰਾਹੀਂ ਸਥਾਪਿਤ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, Windows 11 ਦਾ ਸਿਫ਼ਾਰਿਸ਼ ਕੀਤਾ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_appimage"
msgstr "AppImage ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2004 ਵਿੱਚ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Linux ਦਾ ਬਿਨਾਂ ਇੰਸਟਾਲੇਸ਼ਨ ਵਾਲਾ ਐਪਲੀਕੇਸ਼ਨ ਫਾਰਮੈਟ। 'ਇੱਕ ਐਪਲੀਕੇਸ਼ਨ ਇੱਕ ਫਾਈਲ', ਬਿਨਾਂ ਇੰਸਟਾਲੇਸ਼ਨ ਦੇ ਸਿੱਧਾ ਚਲਦਾ ਹੈ, ਜ਼ਿਆਦਾਤਰ Linux ਵੰਡਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਵਿਕਾਸਕਾਰਾਂ ਦੁਆਰਾ Linux ਸਾਫਟਵੇਅਰ ਵੰਡਣ ਦਾ ਆਮ ਤਰੀਕਾ ਹੈ)"

msgid "mime_flatpak"
msgstr "Flatpak ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2015 ਵਿੱਚ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Linux ਦਾ ਸੈਂਡਬਾਕਸ ਕੀਤਾ ਐਪਲੀਕੇਸ਼ਨ ਫਾਰਮੈਟ। ਵੰਡਾਂ ਦੇ ਵਿਚਕਾਰ ਚਲਦਾ ਹੈ, ਹੋਸਟ ਸਿਸਟਮ ਤੋਂ ਵੱਖ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, Fedora, Red Hat ਵਿਕਾਸ ਵਿੱਚ ਮੋਹਰੀ ਹਨ, GNOME ਸਾਫਟਵੇਅਰ ਸੈਂਟਰ ਦਾ ਡਿਫੌਲਟ ਫਾਰਮੈਟ)"

msgid "mime_snap"
msgstr "Snap ਐਪਲੀਕੇਸ਼ਨ ਪੈਕੇਜ (2014 ਵਿੱਚ Canonical ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Ubuntu ਮੂਲ ਕੰਪਨੀ, Linux ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਐਪਲੀਕੇਸ਼ਨ ਫਾਰਮੈਟ। ਆਟੋਮੈਟਿਕ ਅੱਪਡੇਟ, ਸੈਂਡਬਾਕਸ ਵੱਖਰਤਾ, 40+ Linux ਵੰਡਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, Ubuntu ਸਾਫਟਵੇਅਰ ਸੈਂਟਰ ਦਾ ਡਿਫੌਲਟ ਫਾਰਮੈਟ)"

msgid "mime_deb"
msgstr "ਡੇਬੀਅਨ ਸਾਫਟਵੇਅਰ ਪੈਕੇਜ (1993 ਵਿੱਚ ਡੇਬੀਅਨ ਪ੍ਰੋਜੈਕਟ ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Debian/Ubuntu ਅਤੇ ਉਹਨਾਂ ਦੇ ਉਤਪੰਨਾਂ ਦਾ ਮਿਆਰੀ ਇੰਸਟਾਲੇਸ਼ਨ ਫਾਰਮੈਟ। dpkg ਦੁਆਰਾ ਪ੍ਰਬੰਧਿਤ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, APT ਇਸਦਾ ਪੈਕੇਜ ਮੈਨੇਜਰ ਫਰੰਟ-ਐਂਡ ਹੈ, Linux ਈਕੋਸਿਸਟਮ ਵਿੱਚ ਸਭ ਤੋਂ ਪਰਿਪੱਕ ਪੈਕੇਜ ਫਾਰਮੈਟਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ, ਅੱਜ ਵੀ Debian ਪਰਿਵਾਰ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_rpm"
msgstr "RPM ਸਾਫਟਵੇਅਰ ਪੈਕੇਜ (1997 ਵਿੱਚ Red Hat ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Red Hat/Fedora/CentOS/SUSE ਅਤੇ ਹੋਰ ਵੰਡਾਂ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ। RPM ਪੂਰੀ ਤਰ੍ਹਾਂ 'Red Hat Package Manager' ਹੈ, DEB ਦੇ ਨਾਲ Linux ਦੇ ਦੋ ਪ੍ਰਮੁੱਖ ਪੈਕੇਜ ਫਾਰਮੈਟਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੈ, ਅੱਜ ਵੀ RHEL ਪਰਿਵਾਰ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_pacman"
msgstr "ਆਰਚ ਸਾਫਟਵੇਅਰ ਪੈਕੇਜ (2002 ਵਿੱਚ Arch Linux ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, pacman ਪੈਕੇਜ ਮੈਨੇਜਰ ਦੁਆਰਾ ਵਰਤਿਆ ਜਾਣ ਵਾਲਾ .pkg.tar.zst ਫਾਰਮੈਟ। Arch Linux ਦੀ ਰੋਲਿੰਗ ਰਿਲੀਜ਼ ਦਾ ਕਰਨਲ, ਸਾਦਗੀ ਅਤੇ KISS ਸਿਧਾਂਤ ਲਈ ਮਸ਼ਹੂਰ ਹੈ, AUR (Arch User Repository) ਇਸਦੀ ਵਿਸ਼ੇਸ਼ਤਾ ਹੈ)"

msgid "mime_exe"
msgstr "EXE ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਫਾਈਲ (Windows ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਪ੍ਰੋਗਰਾਮ ਫਾਰਮੈਟ, 'ਐਗਜ਼ੀਕਿਊਟੇਬਲ' ਦਾ ਸੰਖੇਪ ਰੂਪ। Windows ਓਪਰੇਟਿੰਗ ਸਿਸਟਮ ਦਾ ਮੂਲ ਐਗਜ਼ੀਕਿਊਸ਼ਨ ਫਾਰਮੈਟ, PE ਬਣਤਰ ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ। MS-DOS ਦੇ MZ ਫਾਰਮੈਟ ਤੋਂ ਉਤਪੰਨ ਹੋਇਆ ਹੈ, 1993 ਵਿੱਚ Windows NT ਨੇ PE (ਪੋਰਟੇਬਲ ਐਗਜ਼ੀਕਿਊਟੇਬਲ) ਫਾਰਮੈਟ ਪੇਸ਼ ਕੀਤਾ, ਜੋ ਅੱਜ ਵੀ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। ਸਾਫਟਵੇਅਰ ਇੰਸਟਾਲੇਸ਼ਨ ਪੈਕੇਜ, ਐਪਲੀਕੇਸ਼ਨਾਂ, ਸਿਸਟਮ ਟੂਲ ਇਸ ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹਨ। ਉਪਭੋਗੀ ਡਬਲ ਕਲਿੱਕ ਕਰਕੇ ਚਲਾ ਸਕਦਾ ਹੈ, ਇਹ ਦੁਨੀਆ ਵਿੱਚ ਸਭ ਤੋਂ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਿਆ ਜਾਣ ਵਾਲਾ ਐਗਜ਼ੀਕਿਊਸ਼ਨ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_dll"
msgstr "DLL ਡਾਇਨਾਮਿਕ ਲਿੰਕ ਲਾਇਬ੍ਰੇਰੀ (1993 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤੀ ਗਈ, ਡਾਇਨਾਮਿਕ ਲਿੰਕ ਲਾਇਬ੍ਰੇਰੀ। Windows ਦੀ ਸਾਂਝੀ ਕੋਡ ਲਾਇਬ੍ਰੇਰੀ, ਪ੍ਰੋਗਰਾਮ ਚੱਲਣ ਦੌਰਾਨ ਡਾਇਨਾਮਿਕ ਤੌਰ 'ਤੇ ਲੋਡ ਹੁੰਦੀ ਹੈ, ਮੈਮੋਰੀ ਅਤੇ ਡਿਸਕ ਸਪੇਸ ਬਚਾਉਂਦੀ ਹੈ। ਸਿਸਟਮ ਕੰਪੋਨੈਂਟ, ਐਪਲੀਕੇਸ਼ਨ ਪਲੱਗਇਨ, ਡ੍ਰਾਈਵਰ ਸਾਰੇ DLL ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹਨ। Windows API ਦੇ ਮੂਲ ਲਾਗੂਕਰਨ ਦਾ ਤਰੀਕਾ, DLL Hell ਸਮੱਸਿਆ .NET ਯੁੱਗ ਵਿੱਚ ਘੱਟ ਹੋਈ ਹੈ)"

msgid "mime_com"
msgstr "COM ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਫਾਈਲ (MS-DOS ਯੁੱਗ ਦਾ ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਫਾਰਮੈਟ, 'ਕਮਾਂਡ' ਦਾ ਸੰਖੇਪ ਰੂਪ। ਫਾਈਲ ਬਣਤਰ ਸਧਾਰਨ ਹੈ, 64KB ਸੀਮਾ ਦੇ ਨਾਲ, Windows 3.x ਤੱਕ ਆਮ ਸੀ। ਹੁਣ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ, ਆਧੁਨਿਕ Windows EXE ਫਾਰਮੈਟ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ, COM ਐਕਸਟੈਂਸ਼ਨ ਅਜੇ ਵੀ ਕੁਝ ਕੰਪੋਨੈਂਟ ਫਾਈਲਾਂ ਲਈ ਵਰਤੀ ਜਾਂਦੀ ਹੈ)"

msgid "mime_aac"
msgstr "AAC ਆਡੀਓ (1997 ਵਿੱਚ MPEG ਮਿਆਰ, ਐਡਵਾਂਸਡ ਆਡੀਓ ਕੋਡਿੰਗ। MP3 ਦਾ ਉੱਤਰਾਧਿਕਾਰੀ, ਇੱਕੋ ਬਿਟਰੇਟ 'ਤੇ ਗੁਣਵੱਤਾ ਵਿੱਚ MP3 ਤੋਂ ਬਿਹਤਰ ਹੈ, YouTube, iTunes, ਨਿਨਟੈਂਡੋ ਸਵਿੱਚ ਦਾ ਡਿਫੌਲਟ ਆਡੀਓ ਫਾਰਮੈਟ)"

msgid "mime_alac"
msgstr "ALAC ਆਡੀਓ (2004 ਵਿੱਚ Apple ਦੁਆਰਾ ਵਿਕਸਤ, ਐਪਲ ਲੌਸਲੈੱਸ ਆਡੀਓ ਕੋਡੈਕ। Apple ਦਾ ਨੁਕਸਾਨ ਰਹਿਤ ਫਾਰਮੈਟ, 2011 ਵਿੱਚ ਓਪਨ ਸੋਰਸ ਹੋਇਆ, iTunes ਅਤੇ Apple Music ਦੇ ਨੁਕਸਾਨ ਰਹਿਤ ਆਡੀਓ ਦਾ ਡਿਫੌਲਟ ਫਾਰਮੈਟ)"

msgid "mime_flac"
msgstr "FLAC ਆਡੀਓ (2001 ਵਿੱਚ Xiph.Org ਫਾਊਂਡੇਸ਼ਨ ਦੁਆਰਾ ਵਿਕਸਤ, ਫ੍ਰੀ ਲੌਸਲੈੱਸ ਆਡੀਓ ਕੋਡੈਕ। ਨੁਕਸਾਨ ਰਹਿਤ ਸੰਕੁਚਨ, ਗੁਣਵੱਤਾ CD ਦੇ ਸਮਾਨ ਹੈ, ਫਾਈਲ ਲਗਭਗ WAV ਦੀ ਅੱਧੀ ਹੈ। ਓਪਨ ਸੋਰਸ ਅਤੇ ਪੇਟੈਂਟ ਮੁਕਤ ਹੈ, ਆਡੀਓਫਾਈਲਜ਼ ਅਤੇ ਡਿਜੀਟਲ ਸੰਗੀਤ ਸੰਗ੍ਰਹਿ ਕਰਨ ਵਾਲਿਆਂ ਦਾ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ ਹੈ)"

msgid "mime_mp3"
msgstr "MP3 ਆਡੀਓ (1993 ਵਿੱਚ Fraunhofer ਇੰਸਟੀਚਿਊਟ ਦੁਆਰਾ ਵਿਕਸਤ, MPEG-1 ਆਡੀਓ ਲੇਅਰ 3। ਨੁਕਸਾਨ ਸਹਿਤ ਸੰਕੁਚਨ ਫਾਰਮੈਟ, ਫਾਈਲ ਛੋਟੀ ਅਤੇ ਗੁਣਵੱਤਾ ਸਵੀਕਾਰਯੋਗ ਹੈ, 2000 ਦੇ ਦਹਾਕੇ ਦੀ ਡਿਜੀਟਲ ਸੰਗੀਤ ਕ੍ਰਾਂਤੀ ਦਾ ਮੂਲ ਫਾਰਮੈਟ, iPod ਅਤੇ Napster ਦੀ ਪ੍ਰਾਪਤੀ। 2017 ਵਿੱਚ ਪੇਟੈਂਟ ਖਤਮ ਹੋ ਗਿਆ, ਜਨਤਕ ਡੋਮੇਨ ਫਾਰਮੈਟ ਬਣ ਗਿਆ)"

msgid "mime_oga"
msgstr "Ogg Audio ਆਡੀਓ (Xiph.Org ਫਾਊਂਡੇਸ਼ਨ ਦੁਆਰਾ ਵਿਕਸਤ, Ogg ਕੰਟੇਨਰ ਦਾ ਸ਼ੁੱਧ ਆਡੀਓ ਫਾਰਮੈਟ, Vorbis ਏਨਕੋਡਿੰਗ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ। ਓਪਨ ਸੋਰਸ ਅਤੇ ਪੇਟੈਂਟ ਮੁਕਤ ਹੈ, ਸੰਕੁਚਨ ਕੁਸ਼ਲਤਾ MP3 ਨਾਲੋਂ ਬਿਹਤਰ ਹੈ, ਓਪਨ ਸੋਰਸ ਪ੍ਰੋਜੈਕਟਾਂ ਵਿੱਚ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_ogg"
msgstr "OGG ਆਡੀਓ (2000 ਵਿੱਚ Xiph.Org ਫਾਊਂਡੇਸ਼ਨ ਦੁਆਰਾ ਵਿਕਸਤ, Ogg Vorbis ਫਾਰਮੈਟ। ਓਪਨ ਸੋਰਸ ਅਤੇ ਪੇਟੈਂਟ ਮੁਕਤ ਹੈ, ਸੰਕੁਚਨ ਕੁਸ਼ਲਤਾ MP3 ਨਾਲੋਂ ਬਿਹਤਰ ਹੈ, Spotify ਨੇ ਸ਼ੁਰੂਆਤੀ ਦੌਰ ਵਿੱਚ ਵਰਤਿਆ, ਗੇਮਾਂ ਦੇ ਧੁਨੀ ਪ੍ਰਭਾਵਾਂ ਵਿੱਚ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_opus"
msgstr "Opus ਆਡੀਓ (2012 ਵਿੱਚ IETF ਮਿਆਰੀਕਰਨ, ਓਪਨ ਸੋਰਸ ਅਤੇ ਪੇਟੈਂਟ ਮੁਕਤ ਆਡੀਓ ਫਾਰਮੈਟ। SILK ਅਤੇ CELT ਤਕਨਾਲੋਜੀਆਂ ਨੂੰ ਜੋੜਦਾ ਹੈ, ਬਹੁਤ ਘੱਟ ਲੇਟੈਂਸੀ, ਸਭ ਤੋਂ ਵੱਧ ਸੰਕੁਚਨ ਕੁਸ਼ਲਤਾ, WebRTC, WhatsApp, ਡਿਸਕੋਰਡ ਦਾ ਡਿਫੌਲਟ ਆਡੀਓ ਫਾਰਮੈਟ)"

msgid "mime_wav"
msgstr "WAV ਆਡੀਓ (1991 ਵਿੱਚ Microsoft ਅਤੇ IBM ਦੁਆਰਾ ਵਿਕਸਤ, Windows ਦਾ ਮੂਲ ਆਡੀਓ ਫਾਰਮੈਟ। ਸੰਕੁਚਨ ਰਹਿਤ PCM ਏਨਕੋਡਿੰਗ, ਗੁਣਵੱਤਾ ਨੁਕਸਾਨ ਰਹਿਤ ਹੈ ਪਰ ਫਾਈਲ ਬਹੁਤ ਵੱਡੀ ਹੈ, ਪੇਸ਼ੇਵਰ ਆਡੀਓ ਸੰਪਾਦਨ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ)"

msgid "mime_wma"
msgstr "WMA ਆਡੀਓ (1999 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, Windows ਮੀਡੀਆ ਆਡੀਓ। ਨੁਕਸਾਨ/ਨੁਕਸਾਨ ਰਹਿਤ ਦੋਵੇਂ ਸੰਸਕਰਣ, Windows ਦਾ ਮੂਲ ਸਮਰਥਨ, Windows ਮੀਡੀਆ ਪਲੇਅਰ ਦੇ ਨਾਲ ਫੈਲਿਆ। ਹੁਣ ਕਿਨਾਰੇ ਹੋ ਗਿਆ ਹੈ, MP3/AAC ਦੁਆਰਾ ਬਦਲਿਆ ਗਿਆ ਹੈ)"

msgid "mime_dsf"
msgstr "DSF ਆਡੀਓ (ਡਾਇਰੈਕਟ ਸਟ੍ਰੀਮ ਡਿਜੀਟਲ ਫਾਰਮੈਟ, ਸੋਨੀ ਅਤੇ ਫਿਲਿਪਸ ਦੁਆਰਾ ਵਿਕਸਤ। 1bit ਉੱਚ ਨਮੂਨਾ ਦਰ, DSD ਆਡੀਓ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, SACD ਦਾ ਡਿਜੀਟਲ ਸੰਸਕਰਣ, ਆਡੀਓਫਾਈਲਾਂ ਦਾ ਉੱਚ-ਪੱਧਰੀ ਫਾਰਮੈਟ, ਫਾਈਲ ਬਹੁਤ ਵੱਡੀ ਹੈ)"

msgid "mime_ape"
msgstr "APE ਆਡੀਓ (2000 ਵਿੱਚ Monkey's Audio ਦੁਆਰਾ ਵਿਕਸਤ ਕੀਤਾ ਗਿਆ, ਨੁਕਸਾਨ ਰਹਿਤ ਸੰਕੁਚਨ ਫਾਰਮੈਟ। FLAC ਨਾਲੋਂ ਉੱਚ ਸੰਕੁਚਨ ਪਰ ਹੌਲੀ ਏਨਕੋਡਿੰਗ, ਅਜੇ ਵੀ Windows ਪਲੇਟਫਾਰਮ ਅਤੇ ਆਡੀਓ ਸ਼ੌਕੀਨਾਂ ਵਿੱਚ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_mid"
msgstr "MIDI ਆਡੀਓ (1983 ਵਿੱਚ MIDI ਐਸੋਸੀਏਸ਼ਨ ਦੁਆਰਾ ਨਿਰਧਾਰਤ, ਸੰਗੀਤਕ ਯੰਤਰ ਡਿਜੀਟਲ ਇੰਟਰਫੇਸ। ਨੋਟ ਫਾਰਮੈਟ, ਆਡੀਓ ਰਿਕਾਰਡਿੰਗ ਨਹੀਂ, ਫਾਈਲ ਬਹੁਤ ਛੋਟੀ ਹੈ, ਇਲੈਕਟ੍ਰਾਨਿਕ ਯੰਤਰ, ਮੋਬਾਈਲ ਫੋਨ ਰਿੰਗਟੋਨ, ਗੇਮ ਧੁਨੀ ਪ੍ਰਭਾਵਾਂ ਦਾ ਮਿਆਰ। 1991 ਵਿੱਚ ਜਨਰਲ MIDI ਮਿਆਰੀਕਰਨ, 128 ਯੰਤਰਾਂ ਦੇ ਟਿੰਬਰ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕੀਤਾ)"

msgid "mime_m4a"
msgstr "M4A ਆਡੀਓ (MPEG-4 ਆਡੀਓ, AAC ਦਾ ਕੰਟੇਨਰ ਫਾਰਮੈਟ। iTunes ਸੰਗੀਤ ਸਟੋਰ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, Apple ਈਕੋਸਿਸਟਮ ਦਾ ਮੁੱਖ ਆਡੀਓ ਫਾਰਮੈਟ, DRM ਸੁਰੱਖਿਆ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)"

msgid "mime_m3u"
msgstr "M3U ਪਲੇਲਿਸਟ (MP3 URL ਪਲੇਲਿਸਟ ਫਾਰਮੈਟ, ਸਾਦਾ ਟੈਕਸਟ ਫਾਈਲ, ਆਡੀਓ ਫਾਈਲ ਮਾਰਗ ਰਿਕਾਰਡ ਕਰਦੀ ਹੈ। ਵਿਨੈੱਮਪ ਯੁੱਗ ਦਾ ਮਿਆਰ, ਇੰਟਰਨੈੱਟ ਰੇਡੀਓ, ਔਨਲਾਈਨ ਸੰਗੀਤ ਸਟ੍ਰੀਮਿੰਗ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। M3U8 ਇਸਦਾ UTF-8 ਸੰਸਕਰਣ ਹੈ, HTTP ਲਾਈਵ ਸਟ੍ਰੀਮਿੰਗ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_asf"
msgstr "ASF ਸਟ੍ਰੀਮਿੰਗ ਫਾਰਮੈਟ (1996 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, ਐਡਵਾਂਸਡ ਸਿਸਟਮਜ਼ ਫਾਰਮੈਟ। Windows ਮੀਡੀਆ ਦਾ ਸਟ੍ਰੀਮਿੰਗ ਕੰਟੇਨਰ, ਆਡੀਓ ਅਤੇ ਵੀਡੀਓ ਸਿੰਕ੍ਰੋਨਸ ਟ੍ਰਾਂਸਮਿਸ਼ਨ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। ਇੰਟਰਨੈੱਟ ਪ੍ਰਸਾਰਣ ਅਤੇ ਸਟ੍ਰੀਮਿੰਗ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ, WMA/WMV ਦੋਵੇਂ ASF ਕੰਟੇਨਰ 'ਤੇ ਅਧਾਰਤ ਹਨ)"

msgid "mime_avi"
msgstr "AVI ਵੀਡੀਓ (1992 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, Windows ਦਾ ਸ਼ੁਰੂਆਤੀ ਵੀਡੀਓ ਮਿਆਰ। 'ਆਡੀਓ ਵੀਡੀਓ ਇੰਟਰਲੀਵ', ਆਡੀਓ ਅਤੇ ਵੀਡੀਓ ਨੂੰ ਇੱਕ ਦੇ ਬਾਅਦ ਇੱਕ ਸਟੋਰ ਕਰਦਾ ਹੈ, 1990-2000 ਦੇ ਦਹਾਕੇ ਦਾ ਸਭ ਤੋਂ ਪ੍ਰਸਿੱਧ ਵੀਡੀਓ ਫਾਰਮੈਟ, ਹੁਣ MP4/MKV ਦੁਆਰਾ ਬਦਲਿਆ ਗਿਆ ਹੈ)"

msgid "mime_divx"
msgstr "DivX ਵੀਡੀਓ (1998 ਵਿੱਚ DivX ਕੰਪਨੀ ਦੁਆਰਾ ਵਿਕਸਤ, MPEG-4 'ਤੇ ਅਧਾਰਤ ਵੀਡੀਓ ਏਨਕੋਡਿੰਗ ਫਾਰਮੈਟ। 2000 ਦੇ ਦਹਾਕੇ ਵਿੱਚ ਇੰਟਰਨੈੱਟ ਵੀਡੀਓ ਸ਼ੇਅਰਿੰਗ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ, DVD ਗੁਣਵੱਤਾ ਨੂੰ CD ਆਕਾਰ ਵਿੱਚ ਏਨਕੋਡ ਕਰਨ ਵਾਲੀ ਪਹਿਲੀ ਤਕਨਾਲੋਜੀ। ਕਾਪੀਰਾਈਟ ਵਿਵਾਦਾਂ ਕਾਰਨ, ਬਾਅਦ ਵਿੱਚ ਵਪਾਰਕ ਏਨਕੋਡਿੰਗ ਵੱਲ ਬਦਲ ਗਿਆ)"

msgid "mime_mp4"
msgstr "MP4 ਵੀਡੀਓ (2001 ਵਿੱਚ MPEG ਮਿਆਰ, MPEG-4 ਭਾਗ 14। ਦੁਨੀਆ ਦਾ ਸਭ ਤੋਂ ਆਮ ਵੀਡੀਓ ਫਾਰਮੈਟ, H.264/H.265 ਏਨਕੋਡਿੰਗ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਇੰਟਰਨੈੱਟ ਵੀਡੀਓ, ਮੋਬਾਈਲ ਫੋਨ ਰਿਕਾਰਡਿੰਗ, YouTube ਦਾ ਡਿਫੌਲਟ ਫਾਰਮੈਟ)"

msgid "mime_m4v"
msgstr "M4V ਵੀਡੀਓ (iTunes ਵੀਡੀਓ ਫਾਰਮੈਟ, MP4 ਦਾ ਰੂਪਾਂਤਰ। Apple ਈਕੋਸਿਸਟਮ ਦਾ ਵੀਡੀਓ ਫਾਰਮੈਟ, iTunes Store ਫਿਲਮਾਂ, ਟੈਲੀਵਿਜ਼ਨ ਪ੍ਰੋਗਰਾਮਾਂ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, DRM ਕਾਪੀਰਾਈਟ ਸੁਰੱਖਿਆ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ)"

msgid "mime_mpeg"
msgstr "MPEG ਵੀਡੀਓ (1988 ਵਿੱਚ MPEG ਸੰਸਥਾ ਦੁਆਰਾ ਨਿਰਧਾਰਤ, ਮੂਵਿੰਗ ਪਿਕਚਰ ਐਕਸਪਰਟਸ ਗਰੁੱਪ। ਡਿਜੀਟਲ ਵੀਡੀਓ ਸੰਕੁਚਨ ਮਿਆਰ ਦੇ ਸੰਸਥਾਪਕ, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (ਇੰਟਰਨੈੱਟ ਵੀਡੀਓ) ਦਾ ਮਹੱਤਵਪੂਰਨ ਪ੍ਰਭਾਵ ਪਿਆ)"

msgid "mime_mkv"
msgstr "MKV ਵੀਡੀਓ (2002 ਵਿੱਚ Matroska ਪ੍ਰੋਜੈਕਟ ਦੁਆਰਾ ਵਿਕਸਤ, ਓਪਨ ਸੋਰਸ ਮਲਟੀਮੀਡੀਆ ਕੰਟੇਨਰ ਫਾਰਮੈਟ। ਇੱਕ ਤੋਂ ਵੱਧ ਆਡੀਓ ਟਰੈਕ, ਇੱਕ ਤੋਂ ਵੱਧ ਸਬਟਾਈਟਲ, ਅਧਿਆਏ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, 'ਪੈਕੇਜਿੰਗ ਦਾ ਜਾਦੂਗਰ', ਉੱਚ ਰੈਜ਼ੋਲੂਸ਼ਨ ਫਿਲਮਾਂ ਸਾਂਝੀਆਂ ਕਰਨ ਦਾ ਪਸੰਦੀਦਾ ਫਾਰਮੈਟ)"

msgid "mime_mpg"
msgstr "MPEG ਵੀਡੀਓ (MPEG-1/MPEG-2 ਵੀਡੀਓ ਐਕਸਟੈਂਸ਼ਨ, VCD ਅਤੇ DVD ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ। 1990-2000 ਦੇ ਦਹਾਕੇ ਵਿੱਚ ਆਪਟੀਕਲ ਡਿਸਕ ਵੀਡੀਓ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ, ਹੁਣ H.264/H.265 ਦੁਆਰਾ ਬਦਲਿਆ ਗਿਆ ਹੈ)"

msgid "mime_ogv"
msgstr "Ogg Video ਵੀਡੀਓ (Xiph.Org ਫਾਊਂਡੇਸ਼ਨ ਦੁਆਰਾ ਵਿਕਸਤ, Ogg ਕੰਟੇਨਰ ਦਾ ਵੀਡੀਓ ਫਾਰਮੈਟ, Theora ਏਨਕੋਡਿੰਗ ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ। ਓਪਨ ਸੋਰਸ ਅਤੇ ਪੇਟੈਂਟ ਮੁਕਤ ਹੈ, HTML5 ਵੀਡੀਓ ਦਾ ਸ਼ੁਰੂਆਤੀ ਮਿਆਰ, Firefox ਦਾ ਮੂਲ ਸਮਰਥਨ)"

msgid "mime_ogx"
msgstr "Ogg ਮਲਟੀਮੀਡੀਆ ਕੰਟੇਨਰ (Xiph.Org ਫਾਊਂਡੇਸ਼ਨ ਦੁਆਰਾ ਵਿਕਸਤ, Ogg ਕੰਟੇਨਰ ਦਾ ਸਾਰਵਤ੍ਰਿਕ ਵਿਸਤਾਰ, ਆਡੀਓ, ਵੀਡੀਓ, ਸਬਟਾਈਟਲ ਦੇ ਇੱਕ ਤੋਂ ਵੱਧ ਟਰੈਕ ਸ਼ਾਮਲ ਕਰ ਸਕਦਾ ਹੈ। ਓਪਨ ਸੋਰਸ ਮਲਟੀਮੀਡੀਆ ਮਿਆਰ, ਗੇਮਾਂ, ਸਟ੍ਰੀਮਿੰਗ ਵਿੱਚ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ)"

msgid "mime_rm"
msgstr "RealMedia ਵੀਡੀਓ (1995 ਵਿੱਚ RealNetworks ਦੁਆਰਾ ਵਿਕਸਤ, RealMedia ਫਾਰਮੈਟ। 1990-2000 ਦੇ ਦਹਾਕੇ ਵਿੱਚ ਇੰਟਰਨੈੱਟ ਸਟ੍ਰੀਮਿੰਗ ਦਾ ਪਾਇਨੀਅਰ, RealPlayer ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ। ਕਮੀਆਂ: ਵਿਸ਼ੇਸ਼ ਪਲੇਅਰ ਦੀ ਲੋੜ ਸੀ, ਸੰਕੁਚਨ ਗੁਣਵੱਤਾ ਮਾੜੀ ਸੀ, ਬਾਅਦ ਵਿੱਚ Flash/MP4 ਦੁਆਰਾ ਬਦਲਿਆ ਗਿਆ)"

msgid "mime_flv"
msgstr "Flash ਵੀਡੀਓ (2002 ਵਿੱਚ ਫਾਰਮੈਟ ਪ੍ਰਗਟ ਹੋਇਆ, ਫਲੈਸ਼ ਵੀਡੀਓ ਫਾਰਮੈਟ। ਇੱਕ ਸਮੇਂ ਇੰਟਰਨੈੱਟ ਵੀਡੀਓ ਦਾ ਮੁੱਖ ਫਾਰਮੈਟ, YouTube ਨੇ ਸ਼ੁਰੂਆਤੀ ਦੌਰ ਵਿੱਚ ਵਰਤਿਆ। ਕਮੀਆਂ: ਫਲੈਸ਼ ਪਲੱਗਇਨ ਦੀ ਲੋੜ ਸੀ, ਕਾਰਗੁਜ਼ਾਰੀ ਮਾੜੀ ਸੀ, ਸੁਰੱਖਿਆ ਛੇਦ ਸਨ। 2015 ਤੋਂ ਮੁੱਖ ਵੈੱਬਸਾਈਟਾਂ HTML5 ਵੀਡੀਓ ਵੱਲ ਬਦਲੀਆਂ, ਹੁਣ ਪੁਰਾਣੀ ਹੋ ਗਈ ਹੈ)"

msgid "mime_f4v"
msgstr "F4V ਵੀਡੀਓ (Adobe ਦੁਆਰਾ ਵਿਕਸਤ ਫਲੈਸ਼ ਵੀਡੀਓ ਫਾਰਮੈਟ, FLV ਦਾ ਉੱਤਰਾਧਿਕਾਰੀ। MPEG-4 ਮਿਆਰ 'ਤੇ ਅਧਾਰਤ, H.264 ਏਨਕੋਡਿੰਗ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। ਫਲੈਸ਼ ਤਕਨਾਲੋਜੀ ਦੇ ਨਾਲ ਪੁਰਾਣਾ ਹੋ ਗਿਆ, Adobe ਨੇ 2020 ਵਿੱਚ ਸਮਰਥਨ ਬੰਦ ਕਰ ਦਿੱਤਾ)"

msgid "mime_wmv"
msgstr "WMV ਵੀਡੀਓ (1999 ਵਿੱਚ Microsoft ਦੁਆਰਾ ਵਿਕਸਤ, Windows ਮੀਡੀਆ ਵੀਡੀਓ। Windows ਦਾ ਮੂਲ ਸਮਰਥਨ, ਸਟ੍ਰੀਮਿੰਗ ਲਈ ਔਪਟੀਮਾਈਜ਼ ਕੀਤਾ ਗਿਆ, ਸ਼ੁਰੂਆਤੀ ਔਨਲਾਈਨ ਵੀਡੀਓ ਵਿੱਚ ਆਮ ਫਾਰਮੈਟ ਸੀ, ਹੁਣ ਕਿਨਾਰੇ ਹੋ ਗਿਆ ਹੈ)"

msgid "mime_wmf"
msgstr "WMF ਮੀਡੀਆ ਫਾਰਮੈਟ (Windows ਮੀਡੀਆ ਫਾਰਮੈਟ, Microsoft ਦਾ ਮੀਡੀਆ ਫਰੇਮਵਰਕ। WMV ਵੀਡੀਓ, WMA ਆਡੀਓ ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ, Windows ਮੀਡੀਆ ਪਲੇਅਰ ਦਾ ਮੂਲ ਸਮਰਥਨ ਹੈ)"

msgid "mime_mov"
msgstr "MOV ਵੀਡੀਓ (1991 ਵਿੱਚ Apple ਦੁਆਰਾ ਵਿਕਸਤ, ਕਵਿਕਟਾਈਮ ਕੰਟੇਨਰ ਫਾਰਮੈਟ। ਪੇਸ਼ੇਵਰ ਵੀਡੀਓ ਸੰਪਾਦਨ ਦਾ ਮਿਆਰੀ ਫਾਰਮੈਟ, ਇੱਕ ਤੋਂ ਵੱਧ ਕੋਡੈਕਾਂ ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ, ਫਾਈਨਲ ਕਟ ਪ੍ਰੋ, ਪ੍ਰੀਮੀਅਰ ਦਾ ਮੂਲ ਸਮਰਥਨ ਹੈ)"

msgid "mime_qt"
msgstr "ਕਵਿਕਟਾਈਮ ਵੀਡੀਓ (1991 ਵਿੱਚ Apple ਦੁਆਰਾ ਜਾਰੀ ਕੀਤਾ ਗਿਆ, ਕਵਿਕਟਾਈਮ ਫਾਰਮੈਟ। ਮੈਕ ਪਲੇਟਫਾਰਮ ਦਾ ਵੀਡੀਓ ਮਿਆਰ, MOV ਇਸਦਾ ਕੰਟੇਨਰ ਹੈ, ਕਵਿਕਟਾਈਮ ਪਲੇਅਰ ਵਿਆਪਕ ਤੌਰ 'ਤੇ ਵਰਤਿਆ ਜਾਂਦਾ ਸੀ। 2016 ਵਿੱਚ Apple ਨੇ Windows ਸੰਸਕਰਣ ਦਾ ਵਿਕਾਸ ਬੰਦ ਕਰ ਦਿੱਤਾ, ਹੌਲੀ-ਹੌਲੀ MP4 ਦੁਆਰਾ ਬਦਲਿਆ ਗਿਆ)"

msgid "mime_webm"
