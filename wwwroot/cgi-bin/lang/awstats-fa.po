#------------------------------------------------------------------------------
# توضیحات فرمت
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "فایل متنی (استاندارد ASCII در سال ۱۹۶۳، متن ساده بدون فرمت. پایه کد منبع، فایل‌های پیکربندی و لاگ‌ها. یونیکس از LF استفاده می‌کند، ویندوز از CRLF برای خط جدید، هنوز رایج‌ترین فرمت داده کامپیوتر)"

msgid "mime_log"
msgstr "فایل لاگ (فایل متنی ساده که داده‌های سیستم، عملکرد برنامه را ثبت می‌کند، برای رفع مشکل، تحلیل عملکرد، ممیزی امنیتی استفاده می‌شود. فرمت‌های استاندارد مانند لاگ ترکیبی Apache، لاگ دسترسی Nginx، syslog و غیره)"

msgid "mime_page"
msgstr "صفحه وب HTML (تیم برنرزلی در سال ۱۹۸۹ وب جهانی را اختراع کرد، در سال ۱۹۹۰ سه فناوری HTML/HTTP/URL را تعریف کرد، به صورت رایگان و بدون درخواست ثبت اختراع ارائه شد. HTML5 در سال ۲۰۱۴ به استاندارد W3C تبدیل شد، از نمایش، چندرسانه و چاپ پشتیبانی می‌کند. برنده جایزه تورینگ در سال ۲۰۱۶)"

msgid "mime_khtml"
msgstr "موتور صفحه وب KHTML (منتشر شده در KDE 2.0 در سال ۱۹۹۸، موتور رندر مرورگر Konqueror. اپل WebKit را بر اساس KHTML در سال ۲۰۰۱ ایجاد کرد. گوگل Blink را از WebKit در سال ۲۰۰۸ ایجاد کرد، به هسته اصلی مرورگرهای Chrome، Edge، Safari تبدیل شد. KHTML الگوی جامعه متن‌باز است که پایه موتورهای مرورگر مدرن را بنا نهاد، میراث فناوری آن از طریق WebKit/Blink ادامه می‌یابد)"

msgid "mime_script"
msgstr "اسکریپت پویا (زبان تفسیری، نیازی به کامپایل ندارد. شامل ASP، JSP، CGI، ColdFusion، Tcl، VBScript و غیره، به طور گسترده در توسعه وب اولیه، مدیریت سیستم، کارهای خودکار استفاده می‌شود. زبان‌های اسکریپت مدرن مانند Python، Ruby، JavaScript به زبان‌های اصلی در توسعه full-stack تبدیل شده‌اند)"

msgid "mime_js"
msgstr "اسکریپت JavaScript (برندن آیش در ۱۰ روز در نت‌اسکیپ در سال ۱۹۹۵ ایجاد کرد، زبان برنامه‌نویسی بومی مرورگر. ECMAScript در سال ۱۹۹۷ استاندارد شد. Node.js در سال ۲۰۰۹ متولد شد و آن را به یک زبان full-stack تبدیل کرد. npm بزرگترین مدیر بسته در جهان است. سال‌ها متوالی محبوب‌ترین زبان برنامه‌نویسی در GitHub)"

msgid "mime_py"
msgstr "اسکریپت Python (گیدو ون روسوم در سال ۱۹۹۱ ایجاد کرد، معروف به تورفتگی اجباری، نحو ساده. به طور گسترده در توسعه وب، علم داده، هوش مصنوعی، عملیات خودکار استفاده می‌شود. برنده چندین دوره جایزه TIOBE Programming Language of the Year)"

msgid "mime_sh"
msgstr "اسکریپت Shell (یونیکس در سال ۱۹۷۱ متولد شد، زبان اسکریپت دستوری. برای مدیریت سیستم، کارهای خودکار، راه‌اندازی سرویس، اسکریپت استقرار استفاده می‌شود. مهارت ضروری برای مدیریت لینوکس)"

msgid "mime_rb"
msgstr "اسکریپت Ruby (یوکیهیرو ماتسوموتو در سال ۱۹۹۵ ایجاد کرد، بر شادی برنامه‌نویس تمرکز دارد. فریمورک Ruby on Rails الگوی توسعه 'پیکربندی بیشتر از قرارداد' را آغاز کرد، بر طراحی فریمورک‌های وب مدرن تأثیر گذاشت)"

msgid "mime_pl"
msgstr "اسکریپت Perl (لری وال در سال ۱۹۸۷ ایجاد کرد، معروف به عمل‌گرایی، ملقب به 'چاقوی ارتشی سوئیس'. CPAN پیشرو مدیران بسته زبان مدرن است، تأثیر عمیقی در پردازش متن، مدیریت سیستم و CGI دارد)"

msgid "mime_php"
msgstr "صفحه وب پویا PHP (راسموس لردورف در سال ۱۹۹۵ ایجاد کرد، به طور خاص برای توسعه وب طراحی شده است. بیش از ۷۰٪ وب‌سایت‌های جهان از آن استفاده می‌کنند، پلتفرم‌هایی مانند WordPress، Facebook، Wikipedia را راه‌اندازی می‌کند. PHP 8 کامپایل JIT را معرفی کرد، عملکرد را به طور قابل توجهی بهبود بخشید)"

msgid "mime_image"
msgstr "فایل تصویری"

msgid "mime_document"
msgstr "فایل سند"

msgid "mime_package"
msgstr "بسته نرم‌افزاری"

msgid "mime_archive"
msgstr "فایل فشرده Gzip (پروژه GNU در سال ۱۹۹۲، بر اساس الگوریتم DEFLATE. در وب برای فشرده‌سازی محتوای پاسخ پویا استفاده می‌شود، نرخ فشرده‌سازی معمولاً ۶۰-۹۰٪. پس از سال ۲۰۱۵ در برخی موارد با Brotli جایگزین شد، اما هنوز رایج‌ترین فرمت فشرده‌سازی سمت سرور است)"

msgid "mime_audio"
msgstr "فایل صوتی"

msgid "mime_video"
msgstr "فایل ویدیویی"

msgid "mime_jscript"
msgstr "JavaScript (توسعه یافته توسط برندن آیش در سال ۱۹۹۵)"

msgid "mime_json"
msgstr "داده JSON (داگلاس کراکفورد در سال ۲۰۰۱ ارائه کرد، فرمت تبادل داده سبک، استاندارد واقعی Web API)"

msgid "mime_vbs"
msgstr "VBScript (مایکروسافت در سال ۱۹۹۶ توسعه داد، زبان اسکریپت ویندوز، برای صفحات وب ASP و اسکریپت‌های مدیریت ویندوز استفاده می‌شود. با گسترش PowerShell و JavaScript، به تدریج کنار گذاشته شده است)"

msgid "mime_conf"
msgstr "فایل پیکربندی (ذخیره پیکربندی نرم‌افزار در قالب متن، فرمت‌های رایج: INI، JSON، YAML، TOML، XML. پیکربندی سیستم لینوکس بیشتر در دایرکتوری /etc است)"

msgid "mime_css"
msgstr "برگه سبک CSS (W3C در دسامبر ۱۹۹۶ CSS1 اولین استاندارد رسمی را منتشر کرد، CSS2 در سال ۱۹۹۸ موقعیت‌یابی و انواع رسانه را اضافه کرد، از سال ۲۰۱۱ CSS3 مدولار گرد کردن گوشه، انیمیشن، جعبه کشسان، چیدمان شبکه و طراحی واکنش‌گرا را معرفی کرد. همراه با HTML و JavaScript سه فناوری اصلی front-end هستند، همه مرورگرهای مدرن (Chrome، Firefox، Safari، Edge) به صورت بومی از آن پشتیبانی می‌کنند، تنها استاندارد برای تعریف سبک صفحات وب است)"

msgid "mime_xsl"
msgstr "برگه سبک XSL (استاندارد W3C در سال ۱۹۹۹، زبان تبدیل سند XML، می‌تواند XML را به HTML/PDF/متن تبدیل کند. استفاده پس از رواج JSON کاهش یافت)"

msgid "mime_runtime"
msgstr "فایل اجرایی (فرمت اجرایی سیستم‌عامل مانند EXE، ELF، Mach-O، شامل کد ماشین و اطلاعات بارگذاری)"

msgid "mime_library"
msgstr "فایل کتابخانه (DLL، SO، dylib و غیره، کتابخانه پیوند پویا، کد مشترکی که در زمان اجرای برنامه بارگذاری می‌شود)"

msgid "mime_swf"
msgstr "انیمیشن Flash (Macromedia در سال ۱۹۹۶ توسعه داد، بعداً متعلق به Adobe. استاندارد انیمیشن وب تعاملی، زمانی بر بازی‌ها و انیمیشن‌های اینترنتی حکمرانی می‌کرد. نقاط ضعف: وابستگی به افزونه، عدم پشتیبانی از موبایل، ریسک امنیتی بالا. Adobe در سال ۲۰۱۷ اعلام به حذف کرد، در سال ۲۰۲۰ پشتیبانی را به طور کامل متوقف کرد، با HTML5/CSS3/JS جایگزین شد)"

msgid "mime_dtd"
msgstr "DTD (تعریف نوع سند) (مشخصات XML، ساختار سند XML را تعریف می‌کند، برای اعتبارسنجی صحت XML استفاده می‌شود)"

msgid "mime_csv"
msgstr "فرمت داده CSV (مقادیر جدا شده با کاما، فرمت داده جدولی رایج، استاندارد واردات و صادرات Excel و پایگاه داده)"

msgid "mime_jnlp"
msgstr "Java Web Start (راه‌انداز برنامه Java، فناوری توزیع برنامه Java روی دسکتاپ در دهه ۲۰۰۰، اکنون حذف شده است)"

msgid "mime_lit"
msgstr "کتاب الکترونیک Microsoft Reader (مایکروسافت در سال ۲۰۰۰ عرضه کرد، فرمت LIT، حذف شده است)"

msgid "mime_svg"
msgstr "گرافیک برداری SVG (استاندارد W3C در سال ۱۹۹۹، زیرا مایکروسافت برای مدت طولانی فرمت VML خود را ترویج می‌کرد، مرورگر IE تا سال ۲۰۱۱ پشتیبانی کرد، که باعث تأخیر در گسترش شد. پس از سال ۲۰۱۵ با حذف IE و رواج صفحه‌نمایش‌های با وضوح بالا، به فرمت ارجح برای آیکون‌ها و لوگوها تبدیل شد)"

msgid "mime_ai"
msgstr "گرافیک برداری Adobe Illustrator (عرضه شده در سال ۱۹۸۷، فرمت گرافیک برداری استاندارد صنعت، ارجح برای طراحی چاپ، لوگو، آیکون)"

msgid "mime_phshop"
msgstr "تصویر Photoshop (ادوبی در سال ۱۹۹۰ عرضه کرد، فرمت فایل اصلی PSD فتوشاپ، استاندارد صنعت پردازش تصویر)"

msgid "mime_ttf"
msgstr "فونت TrueType (اپل و مایکروسافت در سال ۱۹۸۹ با هم توسعه دادند، فرمت فونت برداری، نمایش روی صفحه و چاپ یکسان، فرمت فونت پیش‌فرض سیستم‌عامل‌های مدرن)"

msgid "mime_fon"
msgstr "فونت وب WOFF2 (W3C در سال ۲۰۱۴ توصیه کرد، با استفاده از الگوریتم فشرده‌سازی Brotli، حجم نسبت به WOFF قدیمی حدود ۳۰٪ و نسبت به TTF/OTF بیش از ۵۰٪ کاهش یافته است، اکنون همه مرورگرهای مدرن از آن پشتیبانی می‌کنند، فرمت ارجح برای فونت‌های وب مدرن است، توسط بیش از ۹۸٪ مرورگرها پشتیبانی می‌شود)"

msgid "mime_pdf"
msgstr "سند PDF (ادوبی در سال ۱۹۹۳ توسعه داد، در سال ۲۰۰۸ به استاندارد ISO تبدیل شد. فرمت سند کراس پلتفرم، حفظ یکپارچگی قالب، استاندارد جهانی برای توزیع اسناد الکترونیکی است)"

msgid "mime_dotnet"
msgstr "صفحه وب پویا ASP.NET (مایکروسافت در سال ۲۰۰۲ عرضه کرد، فناوری صفحه وب پویا در پلتفرم ویندوز، بخشی از چارچوب .NET)"

msgid "mime_mdb"
msgstr "پایگاه داده Access (فایل پایگاه داده مایکروسافت اکسس، عرضه شده در سال ۱۹۹۲، راه‌حل پایگاه داده روی دسکتاپ ویندوز)"

msgid "mime_md"
msgstr "سند Markdown (جان گروبر در سال ۲۰۰۴ ایجاد کرد، طراحی نحو تحت تأثیر reStructuredText و Setext. فلسفه طراحی اصلی 'خوانا بودن یعنی قابل نمایش بودن' است. پیاده‌سازی اصلی Markdown.pl از عبارت منظم Perl استفاده می‌کند. مشخصات مشتق شده شامل GFM (۲۰۱۳)، CommonMark (۲۰۱۷)، Pandoc Markdown و غیره است. اکوسیستم‌هایی مانند GitHub، GitLab، Stack Overflow، Jupyter Notebook، Obsidian، Hugo، VitePress را راه‌اندازی می‌کند، به فرمت استاندارد واقعی برای مولدهای وب‌سایت استاتیک و مستندات توسعه‌دهندگان تبدیل شده است)"

msgid "mime_crystal"
msgstr "فرمت گزارش Crystal Reports (گزارش هوش تجاری SAP، فرمت گزارش استاندارد سازمانی)"

msgid "mime_libreoffice"
msgstr "سند LibreOffice (بنیاد The Document Foundation در سال ۲۰۱۰ توسعه داد، شاخه‌ای از OpenOffice، پیاده‌سازی استاندارد ODF، مجموعه اداری متن‌باز اصلی)"

msgid "mime_encrypt"
msgstr "فایل رمزگذاری شده (برای مشاهده فایل باید رمزگشایی شود، پسوندهای رایج: .enc، .crypt، .pgp، .gpg)"

msgid "mime_gpx"
msgstr "داده مسیر GPS (فرمت تبادل GPS، ثبت داده موقعیت جغرافیایی، فرمت رایج برای ساعت‌های ورزشی و دستگاه‌های ناوبری)"

msgid "mime_diskimage"
msgstr "تصویر دیسک (فایل تصویر دیسک/سی‌دی‌رام مانند DMG، ISO، IMG، برای توزیع نرم‌افزار یا پشتیبان‌گیری از رسانه ذخیره‌سازی استفاده می‌شود)"

msgid "mime_vm"
msgstr "تصویر ماشین مجازی (فایل دیسک ماشین مجازی مانند VMDK، VDI، VHDX، OVA، فرمت برای پلتفرم‌های مجازی‌سازی مانند VMware، VirtualBox، Hyper-V)"

msgid "mime_torrent"
msgstr "فایل تورنت BitTorrent (برام کوهن در سال ۲۰۰۱ اختراع کرد، فایل ایندکس دانلود P2P، شامل متادیتای فایل و اطلاعات Tracker)"

msgid "mime_gis"
msgstr "داده سیستم اطلاعات جغرافیایی GIS (داده مکانی جغرافیایی مانند Shapefile، GeoJSON، برای نقشه و تحلیل مکانی استفاده می‌شود)"

msgid "mime_ebook"
msgstr "کتاب الکترونیک (فرمت‌های کتاب الکترونیک مانند EPUB، MOBI، AZW. EPUB استاندارد بین‌المللی است، MOBI/AZW فرمت برای آمازون کیندل است)"

msgid "mime_avif"
msgstr "تصویر AVIF (اتحاد رسانه باز در سال ۲۰۱۹ عرضه کرد، مبتنی بر کدک AV1، نرخ فشرده‌سازی ۵۰٪ بیشتر از WebP، استاندارد تصویر وب نسل جدید)"

msgid "mime_markdown"
msgstr "سند Markdown (جان گروبر در سال ۲۰۰۴ طراحی کرد، زبان نشانه‌گذاری سبک، فرمت رایج برای README در GitHub، اسناد فنی، پست‌های انجمن)"

msgid "mime_yaml"
msgstr "پیکربندی YAML (کلارک ایوانز در سال ۲۰۰۱ طراحی کرد، فرمت سریال‌سازی داده قابل خواندن برای انسان، استاندارد فایل پیکربندی برای Kubernetes، Ansible، Docker Compose)"

msgid "mime_toml"
msgstr "پیکربندی TOML (تام پرستون ورنر در سال ۲۰۱۳ طراحی کرد، 'زبان کمینه واضح تام'، فرمت فایل پیکربندی برای ابزارهای مدرن مانند Rust/Cargo، Python/pip، Go)"

msgid "mime_vue"
msgstr "فایل کامپوننت Vue (معرفی شده در سال ۲۰۱۴ توسط ایوان یو، فریمورک پیشرونده جاوااسکریپت. از طریق کامپوننت‌های تک‌فایلی (SFC) HTML، CSS و JS را به طور کامل ترکیب می‌کند و بازدهی توسعه را به شدت افزایش می‌دهد. این فریمورک یکی از محبوب‌ترین فریمورک‌های Frontend در جهان است. همچنین به عنوان هسته تولیدکنندگان سایت ایستا مدرن مانند VitePress، به طور گسترده برای راه‌اندازی مستندات فنی تعاملی و وبلاگ‌ها استفاده می‌شود.)"

msgid "mime_wasm"
msgstr "ماژول WebAssembly (استاندارد W3C در سال ۲۰۱۷، فرمت اجرای با کارایی بالا در مرورگر، C/C++/Rust/R می‌توانند به عنوان هدف کامپایل شوند، عملکرد نزدیک به بومی)"

msgid "mime_jsx"
msgstr "کامپوننت React JSX (فیس‌بوک در سال ۲۰۱۳ جاوااسکریپت XML را عرضه کرد، نحو کامپوننت فریمورک React، نوآوری که HTML را در جاوااسکریپت می‌نویسد)"

msgid "mime_tsx"
msgstr "کامپوننت TypeScript TSX (مایکروسافت در سال ۲۰۱۲ توسعه داد، TypeScript + JSX، روش نوشتن استاندارد برای توسعه React ایمن از نظر نوع)"

msgid "mime_heif"
msgstr "تصویر HEIF (استاندارد MPEG در سال ۲۰۱۵، فرمت فایل تصویری با کارایی بالا، به طور گسترده در اکوسیستم اپل استفاده می‌شود)"

msgid "mime_heic"
msgstr "تصویر HEIC (پیاده‌سازی HEIF توسط اپل، فرمت عکس پیش‌فرض آیفون، پشتیبانی بومی در iOS/macOS)"

msgid "mime_gltf"
msgstr "مدل ۳ بعدی GLTF (فرمت انتقال GL، 'JPEG جهان ۳ بعدی'، گروه خرونوس در سال ۲۰۱۵ منتشر کرد، فرمت استاندارد وب ۳ بعدی)"

msgid "mime_glb"
msgstr "مدل ۳ بعدی GLB باینری (نسخه باینری GLTF، یک فایل شامل همه منابع، برای توزیع صحنه ۳ بعدی استفاده می‌شود)"

msgid "mime_gls"
msgstr "واژه‌نامه GLOSSARY (فایل تعریف اصطلاحات، برای مدیریت اصطلاحات در سیستم مستندات استفاده می‌شود)"

msgid "mime_cbz"
msgstr "کتاب کمیک CBZ (تصاویر کمیک فشرده شده با ZIP، فرمت رایج برای مجموعه‌های کمیک)"

msgid "mime_cbr"
msgstr "کتاب کمیک CBR (تصاویر کمیک فشرده شده با RAR، فرمت رایج برای مجموعه‌های کمیک)"

msgid "mime_fb2"
msgstr "کتاب الکترونیک FB2 (FictionBook 2.0، فرمت کتاب الکترونیک روسی، ساختار XML، پشتیبانی گسترده توسط خواننده‌های متن‌باز)"

msgid "mime_kepub"
msgstr "کتاب الکترونیک KEPUB (فرمت EPUB اختصاصی Kobo، فرمت بهینه شده برای خواننده کتاب الکترونیک Kobo)"

msgid "mime_m4b"
msgstr "کتاب صوتی M4B (فرمت کتاب صوتی MPEG-4، پشتیبانی از نشانک، فرمت کتاب صوتی iTunes)"

msgid "mime_kfx"
msgstr "فرمت Kindle KFX (آمازون در سال ۲۰۱۵ عرضه کرد، فرمت کتاب الکترونیک اختصاصی کیندل، پشتیبانی از چیدمان پیشرفته و ورق زدن سریع)"

msgid "mime_chm"
msgstr "فایل راهنما CHM (مایکروسافت در سال ۱۹۹۷ عرضه کرد، فرمت HTML Help کامپایل شده، استاندارد مستندات راهنمای نرم‌افزار ویندوز)"

msgid "mime_mht"
msgstr "بایگانی وب MHT (مایکروسافت در سال ۱۹۹۹ عرضه کرد، فرمت صفحه وب تک فایل، فرمت ذخیره صفحه وب مرورگر IE)"

msgid "mime_wml"
msgstr "زبان نشانه‌گذاری بی‌سیم WML (استاندارد WAP در سال ۱۹۹۹، برای فایل‌های صفحه وب تلفن‌های همراه قدیمی استفاده می‌شد، حذف شده است)"

msgid "mime_xhtml"
msgstr "صفحه وب XHTML (استاندارد W3C در سال ۲۰۰۰، نسخه XML از HTML، نحو سخت‌گیرانه‌تر. W3C در سال ۲۰۰۹ نگهداری را متوقف کرد، تمرکز را به HTML5 معطوف کرد)"

msgid "mime_xml"
msgstr "سند XML (استاندارد W3C در سال ۱۹۹۸، زبان نشانه‌گذاری قابل توسعه، فرمت پایه برای خدمات وب، فایل‌های پیکربندی، تبادل داده)"

msgid "mime_sgml"
msgstr "سند SGML (استاندارد ISO در سال ۱۹۸۶، پیشرو HTML، زبان نشانه‌گذاری عمومی استاندارد، XML و HTML هر دو از SGML مشتق شده‌اند)"

msgid "mime_apng"
msgstr "انیمیشن APNG (موزیلا در سال ۲۰۰۴ توسعه داد، افزونه انیمیشن PNG، جایگزین مدرن برای GIF، پشتیبانی از رنگ واقعی و شفافیت)"

msgid "mime_bmp"
msgstr "نقشه بیتی BMP (فرمت نقشه بیتی ویندوز، به طور بومی از ویندوز 1.0 پشتیبانی می‌شود. بدون فشرده‌سازی، حجم فایل بزرگ، اما به دلیل ساختار ساده و عدم نیاز به کدک‌های اضافی، هنوز در ابزار برش ویندوز 11، برنامه Paint، منابع آیکون در بسته‌های نصب EXE/MSI، فایل‌های مکان‌نما و برخی درایورهای قدیمی استفاده می‌شود. با همان کیفیت تصویر، حجم فایل حدود 3-10 برابر بزرگتر از PNG است. در بیشتر موارد با PNG/JPEG جایگزین شده است، اما اکوسیستم ویندوز همچنان سازگاری گسترده را حفظ می‌کند)"

msgid "mime_cdr"
msgstr "گرافیک برداری CDR (فرمت اختصاصی CorelDRAW، شرکت Corel کانادا، نرم‌افزار طراحی گرافیک برداری)"

msgid "mime_gif"
msgstr "تصویر GIF (CompuServe در سال ۱۹۸۷ توسعه داد، فرمت تصویر متحرک ۲۵۶ رنگ. نقاط ضعف: رنگ کم، کیفیت تصویر خشن، عدم پشتیبانی از شفافیت، فایل بزرگ، نرخ فریم پایین. با فرمت‌های تصویر متحرک مدرن مانند APNG، WebP جایگزین شده است)"

msgid "mime_ico"
msgstr "آیکون ICO (فرمت فایل آیکون ویندوز، پشتیبانی از وضوح چندگانه، فرمت استاندارد favicon وب‌سایت)"

msgid "mime_jpeg"
msgstr "تصویر JPEG (استاندارد ISO در سال ۱۹۹۲، فرمت فشرده‌سازی با اتلاف برای عکس‌ها، استاندارد واقعی برای عکس‌ها در اینترنت)"

msgid "mime_jpg"
msgstr "تصویر JPEG (استاندارد ISO در سال ۱۹۹۲، فرمت فشرده‌سازی با اتلاف برای عکس‌ها، استاندارد واقعی برای عکس‌ها در اینترنت)"

msgid "mime_png"
msgstr "تصویر PNG (W3C در سال ۱۹۹۶ توصیه کرد، پشتیبانی از رنگ واقعی و شفافیت، جایگزین ایستا برای GIF، استاندارد تصویر بدون اتلاف در اینترنت)"

msgid "mime_ps"
msgstr "فایل توصیف صفحه PostScript (ادوبی در سال ۱۹۸۵ عرضه کرد، زبان توصیف صفحه، پیشرو PDF، برای چاپ و نشر استفاده می‌شود)"

msgid "mime_psb"
msgstr "سند بزرگ PSB (فرمت تصویر بسیار بزرگ ادوبی فتوشاپ، پشتیبانی از تصاویر غول‌پیکر بزرگتر از ۲ گیگابایت یا ۳۰۰۰۰ پیکسل)"

msgid "mime_psd"
msgstr "تصویر PSD (فایل اصلی ادوبی فتوشاپ، پشتیبانی از لایه‌ها، کانال‌ها، مسیرها، فرمت استاندارد صنعت پردازش تصویر)"

msgid "mime_webp"
msgstr "تصویر WebP (گوگل در سال ۲۰۱۰ توسعه داد، فرمت تصویر وب، پشتیبانی از فشرده‌سازی با اتلاف/بدون اتلاف و انیمیشن، نرخ فشرده‌سازی ۲۵-۳۵٪ بیشتر از PNG و ۲۵٪ بیشتر از JPEG)"

msgid "mime_woff"
msgstr "فونت وب WOFF (ایجاد شده در سال ۲۰۰۹، استاندارد W3C در سال ۲۰۱۸. فشرده‌سازی بر اساس TrueType/OpenType، بهینه‌سازی بارگذاری فونت وب، فرمت استاندارد برای فونت‌های آیکون وب‌سایت مدرن)"

msgid "mime_7z"
msgstr "بسته فشرده 7z (یگور پاولوف در سال ۱۹۹۹ توسعه داد، فرمت اختصاصی برنامه 7-Zip. الگوریتم LZMA، نرخ فشرده‌سازی بالا، متن‌باز رایگان. فرمت 7z با نرخ فشرده‌سازی یکسان معمولاً ۳۰-۵۰٪ از ZIP کوچک‌تر است، فرمت رایج برای جامعه متن‌باز و توزیع نرم‌افزار)"

msgid "mime_ace"
msgstr "بسته فشرده ACE (توسعه یافته در دهه ۱۹۹۰، فرمت برنامه WinACE. زمانی با RAR رقابت می‌کرد، نرخ فشرده‌سازی نسبتاً بالا. توسعه در سال ۲۰۰۷ متوقف شد، اکنون با 7z/RAR جایگزین شده است، کمتر استفاده می‌شود)"

msgid "mime_bz2"
msgstr "بسته فشرده BZIP2 (جولیان ساوارد در سال ۱۹۹۶ توسعه داد، الگوریتم فشرده‌سازی بلوکی. نرخ فشرده‌سازی ۱۵-۲۰٪ بیشتر از GZIP اما کندتر. فرمت رایج برای کد منبع هسته لینوکس، بسته‌های نرم‌افزاری متن‌باز، پسوند .bz2)"

msgid "mime_cab"
msgstr "بسته فشرده CAB (مایکروسافت در سال ۱۹۹۵ توسعه داد، فرمت Cabinet. فرمت بسته نصب ویندوز، برای درایورها، توزیع فایل‌های سیستم استفاده می‌شود. Windows Installer (MSI) داخلاً از CAB برای ذخیره فایل‌ها استفاده می‌کند)"

msgid "mime_dmg"
msgstr "تصویر دیسک DMG (اپل در دهه ۱۹۸۰ عرضه کرد، فرمت Disk Image. فرمت استاندارد توزیع نرم‌افزار macOS، دوبار کلیک برای نصب به عنوان دیسک مجازی، کشیدن و رها کردن برای نصب برنامه. پشتیبانی از فشرده‌سازی و رمزگذاری، فرمت اصلی برای دانلود نرم‌افزار مک)"

msgid "mime_emz"
msgstr "تصویر فشرده EMZ (Windows compressed Enhanced Metafile، نسخه فشرده EMF. فرمت ذخیره گرافیک برداری در اسناد Office، ماهیتاً فایل EMF فشرده شده با GZIP است)"

msgid "mime_gz"
msgstr "بسته فشرده GZIP (ژان-لوپ گایلی و مارک ادلر در سال ۱۹۹۲ توسعه دادند، پروژه GNU. ابزار فشرده‌سازی استاندارد یونیکس/لینوکس، فرمت رایج برای فشرده‌سازی انتقال HTTP. پسوند .gz، اغلب با TAR همراه استفاده می‌شود)"

msgid "mime_jar"
msgstr "بسته فشرده JAR (سان میکروسیستمز در سال ۱۹۹۷ عرضه کرد، فرمت Java ARchive. ماهیتاً فایل ZIP است، برای بسته‌بندی کتابخانه‌ها و برنامه‌های جاوا استفاده می‌شود. فرمت اصلی اکوسیستم جاوا مانند Maven، Gradle. اندروید نیز از JAR استفاده می‌کند)"

msgid "mime_lzma"
msgstr "بسته فشرده LZMA (یگور پاولوف در سال ۱۹۹۸ توسعه داد، الگوریتم Lempel-Ziv-Markov chain. الگوریتم فشرده‌سازی اصلی فرمت 7z، نرخ فشرده‌سازی بالا، سرعت استخراج سریع. برای توزیع نرم‌افزار میان‌افزار و سیستم‌های جاسازی شده استفاده می‌شود)"

msgid "mime_rar"
msgstr "بسته فشرده RAR (یوجین روشال در سال ۱۹۹۳ توسعه داد، فرمت Roshal ARchive. نرخ فشرده‌سازی بالا، پشتیبانی از تقسیم حجم و رکورد بازیابی. فرمت برنامه WinRAR، نرخ فشرده‌سازی بهتر از ZIP اما نیاز به نرم‌افزار پولی دارد، ابزارهای متن‌باز مانند unrar می‌توانند استخراج کنند)"

msgid "mime_tar"
msgstr "بسته بایگانی TAR (یونیکس V7 در سال ۱۹۷۹ معرفی کرد، فرمت Tape ARchive. فرمت بایگانی نوار، فشرده نمی‌کند فقط بسته‌بندی می‌کند، اغلب با GZIP/BZIP2/XZ همراه استفاده می‌شود. کد منبع بسته لینوکس، ذخیره لایه تصاویر داکر همگی از فرمت TAR استفاده می‌کنند)"

msgid "mime_tgz"
msgstr "بسته فشرده TGZ (فرمت ترکیبی TAR + GZIP، پسوند .tgz یا .tar.gz. رایج‌ترین فرمت توزیع برای بسته‌های نرم‌افزاری یونیکس/لینوکس، بسته‌های کد منبع، بسته‌های باینری، به طور گسترده استفاده می‌شود، نماینده 'استخراج کن و استفاده کن')"

msgid "mime_tbz2"
msgstr "بسته فشرده TBZ2 (فرمت ترکیبی TAR + BZIP2، پسوند .tbz2 یا .tar.bz2. نرخ فشرده‌سازی ۱۵-۲۰٪ بیشتر از TGZ، مناسب برای توزیع فایل‌های بزرگ، هسته لینوکس برای مدت طولانی از این فرمت استفاده می‌کند)"

msgid "mime_xz"
msgstr "بسته فشرده XZ (عرضه شده در سال ۲۰۰۹، مبتنی بر الگوریتم LZMA2. نرخ فشرده‌سازی بسیار بالا، ۳۰-۵۰٪ بیشتر از GZIP، سرعت استخراج نسبتاً سریع. هسته لینوکس، مدیران بسته (مانند داخل .deb دبیان) به طور گسترده استفاده می‌کنند، فرمت توصیه شده در اکوسیستم لینوکس فعلی است)"

msgid "mime_z"
msgstr "بسته فشرده Z (فرمت دستور compress یونیکس در سال ۱۹۸۵، الگوریتم LZW. فرمت فشرده‌سازی اولیه یونیکس، توسط GZIP جایگزین شده است. پسوند .Z، سیستم‌های مدرن کمتر استفاده می‌کنند)"

msgid "mime_zip"
msgstr "بسته فشرده ZIP (فیل کاتز در سال ۱۹۸۹ توسعه داد، فرمت PKZIP. پشتیبانی بومی در ویندوز، رایج‌ترین فرمت فشرده‌سازی در اینترنت. پشتیبانی از چندین فایل، ساختار دایرکتوری، امکان انتخاب الگوریتم فشرده‌سازی. JAR جاوا، APK اندروید، DOCX/XLSX اسناد آفیس همگی مبتنی بر فرمت ZIP هستند)"

msgid "mime_zst"
msgstr "بسته فشرده Zstandard (فیس‌بوک در سال ۲۰۱۵ توسعه داد، طراحی توسط یان کولت. الگوریتم فشرده‌سازی پرسرعت، نرخ فشرده‌سازی نزدیک به LZMA، سرعت بسیار بیشتر از GZIP. هسته لینوکس 5.9+ پشتیبانی می‌کند، آرچ لینوکس pacman، دبیان APT به تدریج در حال پذیرش هستند، استاندارد فشرده‌سازی نسل جدید)"

msgid "mime_lz4"
msgstr "بسته فشرده LZ4 (یان کولت در سال ۲۰۱۱ توسعه داد، الگوریتم فشرده‌سازی فوق‌سریع. سرعت فشرده‌سازی ۱۰ برابر بیشتر از GZIP، مناسب برای سناریوهای فشرده‌سازی بی‌درنگ. هسته لینوکس، OpenZFS، هدوپ به طور گسترده استفاده می‌کنند، انتخاب اول برای سناریوهای اولویت سرعت)"

msgid "mime_lzo"
msgstr "بسته فشرده LZO (مارکوس اوبرهومر در سال ۱۹۹۶ توسعه داد، الگوریتم Lempel-Ziv-Oberhumer. سرعت استخراج بسیار بالا، نرخ فشرده‌سازی متوسط. هسته لینوکس Squashfs، میان‌افزار OpenWrt استفاده می‌کنند، مناسب برای سیستم‌های جاسازی شده)"

msgid "mime_msi"
msgstr "بسته نصب MSI (مایکروسافت در سال ۱۹۹۹ عرضه کرد، فرمت بسته Windows Installer. فرمت استاندارد نصب برنامه ویندوز، پشتیبانی از بازگشت تراکنش، مدیریت کامپوننت، نصب بی‌صدا. فرمت ارجح برای توزیع نرم‌افزار سازمانی، هنوز هم اصلی‌ترین روش برای نصب نرم‌افزار ویندوز تا به امروز است)"

msgid "mime_pkg"
msgstr "بسته نصب PKG (فرمت بسته نصب برنامه macOS، مبتنی بر فناوری Installer اپل. فرمت استاندارد توزیع نرم‌افزار macOS، پشتیبانی از انتخاب کامپوننت، اسکریپت نصب، عملکرد حذف. دوبار کلیک روی فایل .pkg برای نصب، روش توزیع رایج برای نرم‌افزارهای خارج از اپ‌استور مک)"

msgid "mime_apk"
msgstr "بسته برنامه اندروید APK (ارائه شده توسط گوگل در سال ۲۰۰۸، فرمت نصب سنتی برای برنامه‌های اندروید. APK در اصل یک بسته ZIP است که شامل کد، منابع و فایل مانیفست می‌باشد. از سال ۲۰۲۱، گوگل پلی برنامه‌های جدید را ملزم به استفاده از فرمت AAB کرده است، اما APK هنوز برای اشکال‌زدایی، فروشگاه‌های شخص ثالث و نصب جانبی استفاده می‌شود)"

msgid "mime_ipa"
msgstr "بسته برنامه iOS IPA (iOS App Store Package، فرمت نصب برای برنامه‌های iOS/iPadOS. ارائه شده در سال ۲۰۰۸ با iPhone SDK. باید از طریق App Store توزیع شود یا با گواهی سازمانی امضا گردد. شامل فایل اجرایی، منابع، Info.plist و اطلاعات امضا می‌باشد)"

msgid "mime_hap"
msgstr "بسته برنامه هارمونی‌اواس HAP (HarmonyOS Ability Package، واحد پایه یک برنامه هارمونی‌اواس. ارائه شده در سال ۲۰۲۰ با هارمونی‌اواس ۲.۰. پشتیبانی از دو نوع: entry و feature، فرمت توزیع برای گوشی‌های هوآوی، تبلت‌ها، ساعت‌های هوشمند و سایر دستگاه‌های هارمونی‌اواس)"

msgid "mime_har"
msgstr "کتابخانه اشتراکی ایستا هارمونی‌اواس HAR (HarmonyOS Archive، کتابخانه اشتراکی ایستا هارمونی‌اواس، می‌تواند توسط چندین بسته HAP به اشتراک گذاشته شود، برای توسعه مبتنی بر مؤلفه و بازاستفاده ماژول‌ها استفاده می‌شود)"

msgid "mime_aab"
msgstr "Android App Bundle (گوگل در سال ۲۰۱۸ عرضه کرد، از سال ۲۰۲۱ گوگل پلی برنامه‌های جدید را ملزم به استفاده از این فرمت کرده است. AAB فرمت توزیع است، گوگل پلی با توجه به پیکربندی دستگاه (معماری CPU، چگالی صفحه، زبان) به طور پویا APK بهینه تولید می‌کند، اندازه بسته به طور متوسط ۳۵٪ کاهش می‌یابد. توسعه‌دهندگان AAB را آپلود می‌کنند، کاربران APK را دانلود می‌کنند)"

msgid "mime_xapk"
msgstr "بسته برنامه XAPK (بسته افزونه برنامه اندروید شخص ثالث، شامل APK + فایل داده OBB. برای بازی‌های بزرگ و برنامه‌های پیچیده استفاده می‌شود، محدودیت ۱۰۰ مگابایتی فایل APK تکی را حل می‌کند. معمولاً در فروشگاه‌های برنامه شخص ثالث مانند APKPure، APKMirror یافت می‌شود، فرمت رسمی گوگل نیست)"

msgid "mime_appx"
msgstr "بسته برنامه Windows (مایکروسافت در سال ۲۰۱۲ عرضه کرد، فرمت نصب برنامه Windows 8/10/11. پشتیبانی از برنامه‌های UWP و تبدیل برنامه دسکتاپ، توزیع از طریق مایکروسافت استور. در سال ۲۰۲۴ مایکروسافت MSIX را به عنوان فرمت جانشین معرفی کرد، به تدریج جایگزین APPX می‌شود)"

msgid "mime_msix"
msgstr "بسته برنامه MSIX (مایکروسافت در سال ۲۰۱۸ عرضه کرد، فرمت بسته‌بندی برنامه ویندوز نسل جدید. ترکیبی از مزایای APPX و MSI، پشتیبانی از همه انواع برنامه ویندوز، قابل توزیع از طریق مایکروسافت استور یا نصب جانبی، فرمت توصیه شده برای ویندوز ۱۱)"

msgid "mime_appimage"
msgstr "بسته برنامه AppImage (عرضه شده در سال ۲۰۰۴، فرمت برنامه لینوکس بدون نیاز به نصب. 'یک برنامه یک فایل'، بدون نیاز به نصب اجرا می‌شود، پشتیبانی از اکثر توزیع‌های لینوکس، روش رایج برای توسعه‌دهندگان برای توزیع نرم‌افزار لینوکس)"

msgid "mime_flatpak"
msgstr "بسته برنامه Flatpak (عرضه شده در سال ۲۰۱۵، فرمت برنامه لینوکس در محیط جعبه شنی. اجرا در بین توزیع‌ها، جدا از سیستم میزبان، توسعه یافته توسط فدورا، رد هت، فرمت پیش‌فرض مرکز نرم‌افزار گنوم)"

msgid "mime_snap"
msgstr "بسته برنامه Snap (کانونیکال در سال ۲۰۱۴ عرضه کرد، شرکت مادر اوبونتو توسعه داد، فرمت برنامه لینوکس عمومی. به‌روزرسانی خودکار، محیط جعبه شنی جدا، پشتیبانی از بیش از ۴۰ توزیع لینوکس، فرمت پیش‌فرض مرکز نرم‌افزار اوبونتو)"

msgid "mime_deb"
msgstr "بسته نرم‌افزاری Debian (پروژه دبیان در سال ۱۹۹۳ عرضه کرد، فرمت نصب استاندارد برای دبیان/اوبونتو و مشتقات آن. مدیریت با dpkg، APT رابط جلوی مدیر بسته است، یکی از بالغ‌ترین فرمت‌های بسته در اکوسیستم لینوکس، هنوز اصلی‌ترین در خانواده دبیان تا به امروز است)"

msgid "mime_rpm"
msgstr "بسته نرم‌افزاری RPM (رد هت در سال ۱۹۹۷ عرضه کرد، فرمت استاندارد برای توزیع‌هایی مانند رد هت/فدورا/سن‌او‌اس/سوزه. RPM مخفف 'مدیر بسته رد هت' است، همراه با DEB یکی از دو فرمت اصلی بسته لینوکس، هنوز اصلی‌ترین در خانواده RHEL تا به امروز است)"

msgid "mime_pacman"
msgstr "بسته نرم‌افزاری Arch (آرچ لینوکس در سال ۲۰۰۲ عرضه کرد، فرمت .pkg.tar.zst که توسط مدیر بسته pacman استفاده می‌شود. هسته اصلی آرچ لینوکس انتشار غلتان، معروف به سادگی و اصل KISS، AUR (مخزن کاربر آرچ) ویژگی بارز آن است)"

msgid "mime_exe"
msgstr "فایل اجرایی EXE (فرمت برنامه اجرایی ویندوز، مخفف 'Executable'. فرمت اجرایی بومی سیستم‌عامل ویندوز، شامل ساختار PE. از فرمت MZ داس توسعه یافته است، ویندوز NT فرمت PE (قابل حمل) را در سال ۱۹۹۳ معرفی کرد و تا به امروز استفاده می‌شود. بسته‌های نصب نرم‌افزار، برنامه‌ها، ابزارهای سیستم همگی از این فرمت استفاده می‌کنند. کاربر برای اجرا دوبار کلیک می‌کند، رایج‌ترین فرمت اجرایی در جهان است)"

msgid "mime_dll"
msgstr "کتابخانه پیوند پویا DLL (مایکروسافت در سال ۱۹۹۳ معرفی کرد، Dynamic Link Library. کتابخانه کد مشترک ویندوز، به صورت پویا هنگام اجرای برنامه بارگذاری می‌شود، صرفه‌جویی در حافظه و فضای دیسک. کامپوننت‌های سیستم، افزونه‌های برنامه، درایورها همگی از فرمت DLL استفاده می‌کنند. روش اصلی پیاده‌سازی API ویندوز، مشکل DLL Hell در عصر دات نت کاهش یافته است)"

msgid "mime_com"
msgstr "فایل اجرایی COM (فرمت اجرایی دوران داس، مخفف 'Command'. ساختار فایل ساده، محدودیت ۶۴ کیلوبایت، فرمت اصلی قبل از ویندوز 3.x، حذف شده است. ویندوز مدرن از فرمت EXE استفاده می‌کند، پسوند COM هنوز برای برخی فایل‌های کامپوننت استفاده می‌شود)"

msgid "mime_aac"
msgstr "صدای AAC (استاندارد MPEG در سال ۱۹۹۷، Advanced Audio Coding. جانشین MP3، کیفیت صدا بهتر از MP3 در نرخ بیت یکسان، فرمت صدای پیش‌فرض YouTube، iTunes، نینتندو سوییچ)"

msgid "mime_alac"
msgstr "صدای ALAC (اپل در سال ۲۰۰۴ توسعه داد، Apple Lossless Audio Codec. فرمت بدون اتلاف اپل، در سال ۲۰۱۱ متن‌باز شد، فرمت پیش‌فرض برای صدای بدون اتلاف در iTunes و Apple Music)"

msgid "mime_flac"
msgstr "صدای FLAC (بنیاد Xiph.Org در سال ۲۰۰۱ توسعه داد، Free Lossless Audio Codec. فشرده‌سازی بدون اتلاف، کیفیت صدا برابر با CD، فایل حدود نیمی از WAV اصلی. متن‌باز بدون حق امتیاز، فرمت ارجح برای علاقه‌مندان به صدا و مجموعه‌های موسیقی دیجیتال)"

msgid "mime_mp3"
msgstr "صدای MP3 (موسسه فرانهوفر در سال ۱۹۹۳ توسعه داد، MPEG-1 Audio Layer 3. فرمت فشرده‌سازی با اتلاف، فایل کوچک کیفیت قابل قبول، فرمت اصلی انقلاب موسیقی دیجیتال در دهه ۲۰۰۰، عامل موفقیت آیپاد و نپستر. حق اختراع در سال ۲۰۱۷ منقضی شد، به فرمت عمومی تبدیل شد)"

msgid "mime_oga"
msgstr "صدای Ogg Audio (بنیاد Xiph.Org توسعه داد، فرمت صدای خالص کانتینر Ogg، با استفاده از کدک Vorbis. متن‌باز بدون حق امتیاز، کارایی فشرده‌سازی بهتر از MP3، به طور گسترده در پروژه‌های متن‌باز استفاده می‌شود)"

msgid "mime_ogg"
msgstr "صدای OGG (بنیاد Xiph.Org در سال ۲۰۰۰ توسعه داد، فرمت Ogg Vorbis. متن‌باز بدون حق امتیاز، کارایی فشرده‌سازی بهتر از MP3، اسپاتیفای اولیه از آن استفاده می‌کرد، به طور گسترده در افکت‌های صوتی بازی استفاده می‌شود)"

msgid "mime_opus"
msgstr "صدای Opus (IETF در سال ۲۰۱۲ استاندارد کرد، فرمت صوتی متن‌باز بدون حق امتیاز، ترکیبی از فناوری‌های SILK و CELT، تأخیر بسیار کم، بالاترین کارایی فشرده‌سازی، فرمت صدای پیش‌فرض WebRTC، WhatsApp، Discord)"

msgid "mime_wav"
msgstr "صدای WAV (مایکروسافت و آی‌بی‌ام در سال ۱۹۹۱ توسعه دادند، فرمت صدای بومی ویندوز. کدک PCM بدون فشرده‌سازی، کیفیت بدون اتلاف اما فایل بسیار بزرگ، فرمت استاندارد برای ویرایش حرفه‌ای صدا)"

msgid "mime_wma"
msgstr "صدای WMA (مایکروسافت در سال ۱۹۹۹ توسعه داد، Windows Media Audio. دارای هر دو نسخه با اتلاف/بدون اتلاف، پشتیبانی بومی در ویندوز، با Windows Media Player فراگیر شد. اکنون به حاشیه رانده شده، با MP3/AAC جایگزین شده است)"

msgid "mime_dsf"
msgstr "صدای DSF (فرمت Direct Stream Digital، توسعه یافته توسط سونی و فیلیپس. نمونه‌برداری با فرکانس بالا ۱ بیتی، فرمت استاندارد صدای DSD، نسخه دیجیتال SACD، فرمت صدای درجه یک برای علاقه‌مندان، فایل بسیار بزرگ)"

msgid "mime_ape"
msgstr "صوت APE (توسعه یافته توسط Monkey's Audio در سال 2000، فرمت فشرده سازی بدون اتلاف. فشرده سازی بالاتر از FLAC اما رمزگذاری کندتر، هنوز در پلتفرم ویندوز و بین علاقه‌مندان به صدا استفاده می‌شود)"

msgid "mime_mid"
msgstr "صدای MIDI (انجمن MIDI در سال ۱۹۸۳ تعیین کرد، رابط ابزار موسیقی دیجیتال. فرمت نت موسیقی به جای ضبط، فایل بسیار کوچک، استاندارد برای ابزارهای موسیقی الکترونیک، زنگ تلفن همراه، افکت‌های صوتی بازی. General MIDI در سال ۱۹۹۱ استاندارد شد، ۱۲۸ صدای ابزار را تعریف کرد)"

msgid "mime_m4a"
msgstr "صدای M4A (MPEG-4 Audio، فرمت کانتینر AAC. فرمت استاندارد فروشگاه موسیقی iTunes، فرمت صدای اصلی در اکوسیستم اپل، پشتیبانی از حفاظت DRM)"

msgid "mime_m3u"
msgstr "لیست پخش M3U (فرمت لیست پخش URL MP3، فایل متنی ساده، ثبت مسیر فایل‌های صوتی. استاندارد دوران وینامپ، برای پخش رادیویی آنلاین، استریم موسیقی آنلاین استفاده می‌شود. M3U8 نسخه UTF-8 آن است، برای HTTP Live Streaming استفاده می‌شود)"

msgid "mime_asf"
msgstr "رسانه جریانی ASF (مایکروسافت در سال ۱۹۹۶ توسعه داد، Advanced Systems Format. کانتینر رسانه جریانی ویندوز مدیا، پشتیبانی از انتقال همزمان صدا و تصویر. برای پخش زنده اینترنتی و استریم ویدیو بر اساس تقاضا استفاده می‌شود، WMA/WMV هر دو بر اساس کانتینر ASF هستند)"

msgid "mime_avi"
msgstr "ویدیوی AVI (مایکروسافت در سال ۱۹۹۲ عرضه کرد، استاندارد اولیه ویدیوی ویندوز. 'Audio Video Interleave'، ذخیره‌سازی متناوب صدا و تصویر، محبوب‌ترین فرمت ویدیو در دهه‌های ۱۹۹۰-۲۰۰۰، اکنون با MP4/MKV جایگزین شده است)"

msgid "mime_divx"
msgstr "ویدیوی DivX (شرکت DivX در سال ۱۹۹۸ توسعه داد، فرمت کدگذاری ویدیو مبتنی بر MPEG-4. فرمت اصلی به اشتراک‌گذاری ویدیوی آنلاین در دهه ۲۰۰۰، اولین فناوری که کیفیت DVD را به اندازه CD فشرده کرد. به دلیل اختلافات حق کپی‌رایت، بعداً به رمزگذار تجاری تبدیل شد)"

msgid "mime_mp4"
msgstr "ویدیوی MP4 (استاندارد MPEG در سال ۲۰۰۱، MPEG-4 Part 14. رایج‌ترین فرمت ویدیو در جهان، پشتیبانی از کدک H.264/H.265، فرمت پیش‌فرض برای ویدیوی اینترنتی، ضبط تلفن همراه، یوتیوب)"

msgid "mime_m4v"
msgstr "ویدیوی M4V (فرمت ویدیوی iTunes، گونه‌ای از MP4. فرمت ویدیو در اکوسیستم اپل، فرمت استاندارد فیلم‌ها و برنامه‌های تلویزیونی iTunes Store، پشتیبانی از حفاظت کپی‌رایت DRM)"

msgid "mime_mpeg"
msgstr "ویدیوی MPEG (سازمان MPEG در سال ۱۹۸۸ تعیین کرد، گروه کارشناسان تصاویر متحرک. بنیان‌گذار استانداردهای فشرده‌سازی ویدیوی دیجیتال، MPEG-1 (VCD)، MPEG-2 (DVD)، MPEG-4 (ویدیوی آنلاین) تأثیر عمیقی داشته است)"

msgid "mime_mkv"
msgstr "ویدیوی MKV (پروژه ماتروسکا در سال ۲۰۰۲ توسعه داد، فرمت کانتینر چندرسانه‌ای متن‌باز. پشتیبانی از چندین آهنگ صوتی، چندین زیرنویس، فصل‌ها، 'ابزار بسته‌بندی'، فرمت ارجح برای به اشتراک‌گذاری فیلم‌های با وضوح بالا)"

msgid "mime_mpg"
msgstr "ویدیوی MPEG (پسوندهای ویدیوی MPEG-1/MPEG-2، فرمت استاندارد برای VCD و DVD. فرمت اصلی برای ویدیوی روی دیسک در دهه‌های ۱۹۹۰-۲۰۰۰، اکنون با H.264/H.265 جایگزین شده است)"

msgid "mime_ogv"
msgstr "ویدیوی Ogg Video (بنیاد Xiph.Org توسعه داد، فرمت ویدیوی کانتینر Ogg، با استفاده از کدک Theora. متن‌باز بدون حق امتیاز، یکی از استانداردهای اولیه ویدیوی HTML5، فایرفاکس به صورت بومی پشتیبانی می‌کند)"

msgid "mime_ogx"
msgstr "کانتینر چندرسانه‌ای Ogg (بنیاد Xiph.Org توسعه داد، افزونه عمومی کانتینر Ogg، می‌تواند شامل چندین آهنگ مانند صدا، ویدیو، زیرنویس باشد. استاندارد چندرسانه‌ای متن‌باز، برای بازی، استریم استفاده می‌شود)"

msgid "mime_rm"
msgstr "ویدیوی RealMedia (RealNetworks در سال ۱۹۹۵ توسعه داد، فرمت RealMedia. پیشگام پخش جریانی روی اینترنت در دهه‌های ۱۹۹۰-۲۰۰۰، فرمت اصلی پخش‌کننده RealPlayer. نقاط ضعف: نیاز به پخش‌کننده خاص، کیفیت فشرده‌سازی ضعیف، با Flash/MP4 جایگزین شد)"

msgid "mime_flv"
msgstr "ویدیوی Flash (فرمت در سال ۲۰۰۲ ظاهر شد، فرمت Flash Video. زمانی فرمت اصلی ویدیوی آنلاین بود، YouTube اولیه از آن استفاده می‌کرد. نقاط ضعف: نیاز به افزونه Flash، عملکرد ضعیف، آسیب‌پذیری‌های امنیتی زیاد. از سال ۲۰۱۵ به بعد وب‌سایت‌های اصلی به ویدیوی HTML5 روی آوردند، اکنون حذف شده است)"

msgid "mime_f4v"
msgstr "ویدیوی F4V (فرمت ویدیوی Flash که توسط Adobe توسعه یافت، جانشین FLV. مبتنی بر استاندارد MPEG-4، پشتیبانی از کدک H.264. همراه با فناوری Flash منسوخ شد، Adobe در سال ۲۰۲۰ پشتیبانی را متوقف کرد)"

msgid "mime_wmv"
msgstr "ویدیوی WMV (مایکروسافت در سال ۱۹۹۹ توسعه داد، Windows Media Video. پشتیبانی بومی در ویندوز، بهینه‌سازی شده برای انتقال استریم، فرمت رایج در ویدیوی آنلاین اولیه، اکنون به حاشیه رانده شده است)"

msgid "mime_wmf"
msgstr "فرمت رسانه WMF (Windows Media Format، چارچوب رسانه مایکروسافت، شامل ویدیوی WMV و صدای WMA، به صورت بومی توسط Windows Media Player پشتیبانی می‌شود)"

msgid "mime_mov"
msgstr "ویدیوی MOV (اپل در سال ۱۹۹۱ توسعه داد، فرمت کانتینر QuickTime. فرمت استاندارد برای تدوین ویدیوی حرفه‌ای، پشتیبانی از چندین کدک، به صورت بومی توسط Final Cut Pro، Premiere پشتیبانی می‌شود)"

msgid "mime_qt"
msgstr "ویدیوی QuickTime (اپل در سال ۱۹۹۱ عرضه کرد، فرمت QuickTime. استاندارد ویدیو در پلتفرم مک، MOV کانتینر آن است، پخش‌کننده QuickTime زمانی به طور گسترده استفاده می‌شد. اپل در سال ۲۰۱۶ توسعه نسخه ویندوز را متوقف کرد، به تدریج با MP4 جایگزین شد)"

msgid "mime_webm"
msgstr "ویدیوی WebM (گوگل در سال ۲۰۱۰ عرضه کرد، فرمت ویدیوی متن‌باز بدون حق امتیاز. مبتنی بر کانتینر ماتروسکا، کدک VP8/VP9، فرمت استاندارد ویدیوی HTML5، فرمت پخش پیش‌فرض یوتیوب بر روی وب)"

msgid "mime_3gp"
msgstr "ویدیوی 3GP (3GPP در سال ۲۰۰۰ تعیین کرد، فرمت ویدیو برای دستگاه‌های تلفن همراه. فایل بسیار کوچک، کیفیت پایین، فرمت ضبط ویدیوی تلفن‌های همراه اولیه، برای ارسال MMS استفاده می‌شد)"

