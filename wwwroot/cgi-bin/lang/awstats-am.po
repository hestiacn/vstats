msgid "mime_text"
msgstr "የጽሑፍ ፋይል (እ.ኤ.አ. በ1963 ASCII ደረጃውን የጠበቀ፣ ቅርጸት የሌለው ጥሬ ጽሑፍ። የምንጭ ኮድ፣ የውቅር ፋይሎች እና ሎጎች መሠረት። ዩኒክስ LF ይጠቀማል፣ ዊንዶውስ CRLF ይጠቀማል፣ አሁንም የኮምፒውተር በጣም የተለመደ የውሂብ ቅርጸት)"

msgid "mime_log"
msgstr "የሎግ ፋይል (የስርዓት ውሂብ፣ የአፕሊኬሽን አሠራር መረጃ የሚመዘግብ ጥሬ ጽሑፍ ፋይል፣ ችግር መፍቻ፣ የአፈጻጸም ትንተና፣ የደህንነት ምርመራ ለማድረግ ይጠቅማል። የሚታወቁ ቅርጸቶች እንደ Apache combined log፣ Nginx access log፣ syslog ወዘተ)"

msgid "mime_page"
msgstr "የኤችቲኤምኤል ድር ገጽ (ቲም በርነርስ ሊ በ1989 ዎርልድ ዋይድ ዌብን ፈለሰፈ፣ በ1990 ኤችቲኤምኤል/ኤችቲቲፒ/ዩአርኤል ሶስቱን ቴክኖሎጂዎች ገለጸ፣ ያለ የፈጠራ ባለቤትነት በነጻ አቀረበ። ኤችቲኤምኤል5 በ2014 የW3C መስፈርት ሆነ፣ ማሳያ፣ መልቲሚዲያ እና ህትመት ይደግፋል። በ2016 የቲዩሪንግ ሽልማት አግኝቷል)"

msgid "mime_khtml"
msgstr "የKHTML ድር ገጽ ሞተር (በ1998 በKDE 2.0 ታትሟል፣ የኮንከረር አሳሽ አቅራቢ ሞተር። አፕል በ2001 በKHTML መሠረት ዌብ ኪትን ፈጠረ። ጎግል በ2008 ከዌብ ኪት ብሊንክን ፈጠረ፣ ወደ ክሮም፣ ኤጅ፣ ሳፋሪ አሳሾች ዋና ከርነል ሆነ። KHTML ለዘመናዊ አሳሽ ሞተሮች መሠረት የጣለ ክፍት ምንጭ ማህበረሰብ ምሳሌ ነው፣ የቴክኖሎጂ ቅርሱ በዌብ ኪት/ብሊንክ በኩል ይቀጥላል)"

msgid "mime_script"
msgstr "ዳይናሚክ ስክሪፕት (የትርጉም ቋንቋ፣ ማጠናቀር አያስፈልገውም። ኤኤስፒ፣ ጄኤስፒ፣ ሲጂአይ፣ ኮልድ ፍዩዥን፣ ቲሲኤል፣ ቪቢ ስክሪፕት ወዘተ ያጠቃልላል፣ በመጀመሪያ ድር ልማት፣ ስርዓት አስተዳደር፣ አውቶማቲክ ስራዎች ላይ በስፋት ጥቅም ላይ ይውላል። እንደ ፓይተን፣ ሩቢ፣ ጃቫስክሪፕት ያሉ ዘመናዊ ስክሪፕት ቋንቋዎች ወደ full-stack ልማት ዋና ቋንቋዎች ተለውጠዋል)"

msgid "mime_js"
msgstr "ጃቫ ስክሪፕት ስክሪፕት (ብሬንዳን አይክ በ1995 በኔትስኬፕ በ10 ቀናት ውስጥ ፈጠረ፣ የአሳሽ ተወላጅ ፕሮግራሚንግ ቋንቋ። ኢሲኤምኤ ስክሪፕት በ1997 ደረጃውን የጠበቀ ሆነ። ኖድ.ጄኤስ በ2009 ተወለደ እና ወደ full-stack ቋንቋ አደረገው። npm በዓለም ትልቁ የጥቅል አስተዳዳሪ ነው። በGitHub ላይ ለተከታታይ ዓመታት በጣም ታዋቂው የፕሮግራሚንግ ቋንቋ)"

msgid "mime_py"
msgstr "ፓይተን ስክሪፕት (ጊዶ ቫን ሮሱም በ1991 ፈጠረ፣ በግዴታ መግባት፣ ቀላል አገባብ ይታወቃል። በድር ልማት፣ የውሂብ ሳይንስ፣ አርቲፊሻል ኢንተሊጀንስ፣ አውቶሜትድ ኦፕሬሽን ላይ በስፋት ጥቅም ላይ ይውላል። የTIOBE ዓመታዊ የፕሮግራሚንግ ቋንቋ ሽልማትን ብዙ ጊዜ አግኝቷል)"

msgid "mime_sh"
