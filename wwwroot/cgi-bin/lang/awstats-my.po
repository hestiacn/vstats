msgid "mime_text"
msgstr "စာသားဖိုင် (၁၉၆၃ ခုနှစ်တွင် စံသတ်မှတ်ထားသော ASCII၊ ဖော်မတ်မပါသော ရိုးရိုးစာသား။ ဆိုက်ကုဒ်၊ ဖွဲ့စည်းပုံဖိုင်များနှင့် မှတ်တမ်းများ၏ အခြေခံ။ Unix က LF သုံးသည်၊ Windows က CRLF သုံးပြီး စာကြောင်းခွဲသည်၊ ယနေ့ထိ ကွန်ပျူတာ၏ အသုံးအများဆုံး ဒေတာဖော်မတ်ဖြစ်သည်)"

msgid "mime_log"
msgstr "မှတ်တမ်းဖိုင် (စနစ်ဒေတာ၊ အပလီကေးရှင်းလုပ်ဆောင်ချက်အချက်အလက်များကို မှတ်တမ်းတင်သော ရိုးရိုးစာသားဖိုင်၊ ပြဿနာဖြေရှင်းခြင်း၊ စွမ်းဆောင်ရည်ခွဲခြမ်းစိတ်ဖြာခြင်း၊ လုံခြုံရေးစစ်ဆေးခြင်းအတွက် အသုံးပြုသည်။ စံဖော်မတ်များဖြစ်သော Apache combined log၊ Nginx access log၊ syslog စသည်)"

msgid "mime_page"
msgstr "HTML ဝဘ်စာမျက်နှာ (Tim Berners-Lee သည် ၁၉၈၉ ခုနှစ်တွင် World Wide Web ကို တီထွင်ခဲ့ပြီး ၁၉၉၀ ခုနှစ်တွင် HTML/HTTP/URL နည်းပညာသုံးမျိုးကို သတ်မှတ်ခဲ့သည်၊ မူပိုင်ခွင်မတောင်းဘဲ အခမဲ့ ပေးအပ်ခဲ့သည်။ HTML5 သည် ၂၀၁၄ ခုနှစ်တွင် W3C စံသို့ ရောက်ရှိခဲ့ပြီး ပြသခြင်း၊ မာလ်တီမီဒီယာနှင့် ပုံနှိပ်ခြင်းကို ပံ့ပိုးသည်။ ၂၀၁၆ ခုနှစ်တွင် တူရင်ဆုရရှိခဲ့သည်)"

msgid "mime_khtml"
msgstr "KHTML ဝဘ်စာမျက်နှာ အင်ဂျင် (၁၉၉၈ ခုနှစ်တွင် KDE 2.0 တွင်ထုတ်ပြန်ခဲ့သည်၊ Konqueror ဘရောင်ဇာ၏ ပြန်ဆိုအင်ဂျင်။ Apple သည် ၂၀၀၁ ခုနှစ်တွင် KHTML ကိုအခြေခံ၍ WebKit ကိုဖန်တီးခဲ့သည်။ Google သည် ၂၀၀၈ ခုနှစ်တွင် WebKit မှ Blink ကိုခွဲထုတ်ဖန်တီးခဲ့ပြီး Chrome၊ Edge၊ Safari စသည့် ဘရောင်ဇာများ၏ အဓိကအချက်အချာဖြစ်လာသည်။ KHTML သည် ခေတ်မီဘရောင်ဇာအင်ဂျင်များအတွက် အုတ်မြစ်ချပေးသော ပွင့်လင်းရင်းမြစ်အသိုင်းအဝိုင်း၏ စံပြဖြစ်ပြီး ၎င်း၏နည်းပညာအမွေအနှစ်သည် WebKit/Blink မှတစ်ဆင့် ယနေ့တိုင်တည်ရှိနေသည်)"

msgid "mime_script"
msgstr "ဒိုင်နမစ် စကရစ် (အဓိပ္ပာယ်ပြန်ဆိုသော ဘာသာစကား၊ ကွန်ပါလ်ပြုလုပ်ရန်မလို။ ASP၊ JSP၊ CGI၊ ColdFusion၊ Tcl၊ VBScript စသည်တို့ပါဝင်ပြီး အစောပိုင်း ဝဘ်ဖွံ့ဖြိုးရေး၊ စနစ်စီမံခန့်ခွဲမှု၊ အလိုအလျောက်လုပ်ဆောင်ခြင်းလုပ်ငန်းများတွင် ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုသည်။ Python၊ Ruby၊ JavaScript ကဲ့သို့သော ခေတ်မီစကရစ်ဘာသာစကားများသည် full-stack ဖွံ့ဖြိုးရေးတွင် အဓိကဘာသာစကားများအဖြစ် ဖွံ့ဖြိုးလာသည်)"

msgid "mime_js"
msgstr "JavaScript စကရစ် (Brendan Eich သည် ၁၉၉၅ ခုနှစ်တွင် Netscape ၌ ၁၀ ရက်အတွင်း ဖန်တီးခဲ့သည်၊ ဘရောင်ဇာ၏ ဇာတိပရိုဂရမ်းမင်းဘာသာစကား။ ECMAScript ကို ၁၉၉၇ ခုနှစ်တွင် စံသတ်မှတ်ခဲ့သည်။ Node.js သည် ၂၀၀၉ ခုနှစ်တွင် ပေါ်ထွန်းလာပြီး ၎င်းကို full-stack ဘာသာစကားဖြစ်စေခဲ့သည်။ npm သည် ကမ္ဘာ့အကြီးဆုံး ပက်ကေ့ချ်မန်နေဂျာဖြစ်သည်။ GitHub တွင် နှစ်ပေါင်းများစွာ ဆက်တိုက် လူကြိုက်အများဆုံး ပရိုဂရမ်းမင်းဘာသာစကား)"

msgid "mime_py"
msgstr "Python စကရစ် (Guido van Rossum က ၁၉၉၁ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ အကြိုသတ်မှတ်ထားသော အကွက်ထိုးခြင်း၊ ရိုးရှင်းသော syntax ဖြင့် ကျော်ကြားသည်။ ဝဘ်ဖွံ့ဖြိုးရေး၊ ဒေတာသိပ္ပံ၊ ဉာဏ်ရည်တု၊ အလိုအလျောက်လည်ပတ်ခြင်းတို့တွင် ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုသည်။ TIOBE ၏ နှစ်စဉ်ပရိုဂရမ်းမင်းဘာသာစကားဆုကို အကြိမ်များစွာ ရရှိခဲ့သည်)"

msgid "mime_sh"
msgstr "Shell စကရစ် (Unix ကို ၁၉၇၁ ခုနှစ်တွင် စတင်ခဲ့သည်၊ ညွှန်ကြားချက်စကရစ်ဘာသာစကား။ စနစ်စီမံခန့်ခွဲမှု၊ အလိုအလျောက်လုပ်ဆောင်ခြင်း၊ ဝန်ဆောင်မှုစတင်ခြင်း၊ ဖြန့်ကျက်စကရစ်များအတွက် အသုံးပြုသည်။ Linux စီမံခန့်ခွဲမှုအတွက် မရှိမဖြစ်ကျွမ်းကျင်မှု)"

msgid "mime_rb"
msgstr "Ruby စကရစ် (Yukihiro Matsumoto က ၁၉၉၅ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ developer များ၏ ပျော်ရွှင်မှုကို အလေးထားသည်။ Ruby on Rails framework သည် 'သတ်မှတ်ချက်ထက် ဖွဲ့စည်းမှု' ဟူသော ဖွံ့ဖြိုးရေးစံနမူနာကို စတင်ခဲ့ပြီး ခေတ်မီဝဘ် framework ဒီဇိုင်းကို လွှမ်းမိုးခဲ့သည်)"

msgid "mime_pl"
msgstr "Perl စကရစ် (Larry Wall က ၁၉၈၇ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ လက်တွေ့ကျမှုဖြင့် ကျော်ကြားပြီး 'Swiss Army ဓား' ဟု အမည်တွင်သည်။ CPAN သည် ခေတ်မီဘာသာစကား ပက်ကေ့ချ်မန်နေဂျာများ၏ ရှေ့ဆောင်ဖြစ်ပြီး စာသားလုပ်ဆောင်ခြင်း၊ စနစ်စီမံခန့်ခွဲမှုနှင့် CGI နယ်ပယ်များတွင် နက်ရှိုင်းစွာ လွှမ်းမိုးမှုရှိသည်)"

msgid "mime_php"
msgstr "PHP ဒိုင်နမစ်ဝဘ်စာမျက်နှာ (Rasmus Lerdorf က ၁၉၉၅ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ ဝဘ်ဖွံ့ဖြိုးရေးအတွက် အထူးဒီဇိုင်းထုတ်ထားသည်။ ကမ္ဘာပေါ်ရှိ ဝဘ်ဆိုက်များ၏ ၇၀% ကျော်က အသုံးပြုပြီး WordPress၊ Facebook၊ Wikipedia စသည့် ပလက်ဖောင်းများကို မောင်းနှင်ပေးသည်။ PHP 8 သည် JIT ကွန်ပါလ်ကို မိတ်ဆက်ခဲ့ပြီး စွမ်းဆောင်ရည်ကို သိသိသာသာ မြှင့်တင်ပေးခဲ့သည်)"

msgid "mime_image"
msgstr "ပုံဖိုင်"

msgid "mime_document"
msgstr "စာရွက်စာတမ်းဖိုင်"

msgid "mime_package"
msgstr "ဆော့ဖ်ဝဲလ် ပက်ကေ့ချ်"

msgid "mime_archive"
msgstr "Gzip ဖိုင်ချုံ့ (၁၉၉၂ ခုနှစ်တွင် GNU ပရောဂျက်၊ DEFLATE အယ်လဂိုရီသမ်ကို အခြေခံသည်။ ဝဘ်တွင် ဒိုင်နမစ်တုံ့ပြန်မှု အကြောင်းအရာကို ချုံ့ရန် အသုံးပြုသည်၊ ချုံ့နှုန်းမှာ ပုံမှန်အားဖြင့် ၆၀-၉၀% ဖြစ်သည်။ ၂၀၁၅ ခုနှစ်နောက်ပိုင်း အချို့ကိစ္စများတွင် Brotli ဖြင့် အစားထိုးခဲ့သော်လည်း ဆာဗာဘက်တွင် အကျယ်ပြန့်ဆုံးပံ့ပိုးထားသော ချုံ့ဖော်မတ်အဖြစ် ရှိနေဆဲဖြစ်သည်)"

