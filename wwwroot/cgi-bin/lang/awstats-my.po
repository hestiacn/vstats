msgid "mime_json"
msgstr "JSON ဒေတာ (Douglas Crockford က ၂၀၀၁ ခုနှစ်တွင် အဆိုပြုခဲ့သည်၊ ပေါ့ပါးသော ဒေတာဖလှယ်မှုဖော်မတ်၊ Web API ၏ တကယ့်စံနှုန်း)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft က ၁၉၉၆ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Windows စကရစ်ဘာသာစကား၊ ASP ဝဘ်စာမျက်နှာများနှင့် Windows စီမံခန့်ခွဲမှုစကရစ်များအတွက် အသုံးပြုသည်။ PowerShell နှင့် JavaScript များ ကျယ်ပြန့်လာသည်နှင့်အမျှ တဖြည်းဖြည်း ခေတ်နောက်ကျသွားပြီဖြစ်သည်)"

msgid "mime_conf"
msgstr "ဖွဲ့စည်းပုံဖိုင် (စာသားဖော်မတ်ဖြင့် ဆော့ဖ်ဝဲလ်ဖွဲ့စည်းပုံကို သိမ်းဆည်းသည်၊ အသုံးများသော ဖော်မတ်များ- INI၊ JSON၊ YAML၊ TOML၊ XML။ Linux စနစ်ဖွဲ့စည်းပုံများသည် /etc လမ်းညွှန်တွင် အများစုရှိသည်)"

msgid "mime_css"
msgstr "CSS စတိုင်စာရွက် (W3C သည် ၁၉၉၆ ခုနှစ် ဒီဇင်ဘာလတွင် CSS1 ပထမဆုံးတရားဝင်စံနှုန်းကို ထုတ်ပြန်ခဲ့သည်၊ CSS2 သည် ၁၉၉၈ ခုနှစ်တွင် နေရာချခြင်းနှင့် မီဒီယာအမျိုးအစားများကို ထည့်သွင်းခဲ့သည်၊ ၂၀၁၁ ခုနှစ်မှစ၍ CSS3 မော်ဂျူလာသည် ထောင့်ဝိုင်းခြင်း၊ ကာတွန်း၊ ပြောင်းသေတ္တာ၊ ဇယားကွက်အပြင်အဆင်နှင့် တုံ့ပြန်မှုဒီဇိုင်းတို့ကို မိတ်ဆက်ခဲ့သည်။ HTML နှင့် JavaScript တို့နှင့်အတူ front-end ၏ အဓိကနည်းပညာသုံးခုမှတစ်ခုဖြစ်ပြီး ခေတ်မီဘရောင်ဇာများအားလုံး (Chrome၊ Firefox၊ Safari၊ Edge) က ဇာတိအဖြစ် ပံ့ပိုးထားကာ ဝဘ်စာမျက်နှာစတိုင်သတ်မှတ်ခြင်း၏ တစ်ခုတည်းသော စံနှုန်းဖြစ်သည်)"

msgid "mime_xsl"
msgstr "XSL စတိုင်စာရွက် (၁၉၉၉ ခုနှစ်တွင် W3C စံနှုန်း၊ XML စာရွက်စာတမ်းပြောင်းလဲခြင်းဘာသာစကား၊ XML ကို HTML/PDF/စာသားအဖြစ်သို့ ပြောင်းလဲနိုင်သည်။ JSON ကျယ်ပြန့်လာပြီးနောက် အသုံးပြုမှုလျော့နည်းသွားသည်)"

msgid "mime_runtime"
msgstr "လုပ်ဆောင်နိုင်သောဖိုင် (EXE၊ ELF၊ Mach-O စသည့် လည်ပတ်မှုစနစ်၏ လုပ်ဆောင်နိုင်သော ဖော်မတ်၊ စက်ကုဒ်နှင့် loading အချက်အလက်များ ပါဝင်သည်)"

msgid "mime_library"
msgstr "လိုင်ဘရေရီဖိုင် (DLL၊ SO၊ dylib စသည့် ဒိုင်နမစ်လင့်ခ်လိုင်ဘရေရီများ၊ ပရိုဂရမ်လည်ပတ်နေချိန်တွင် loading လုပ်သော မျှဝေထားသည့်ကုဒ်)"

msgid "mime_swf"
msgstr "Flash ကာတွန်း (Macromedia က ၁၉၉၆ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ နောက်ပိုင်း Adobe ပိုင်ဆိုင်သည်။ အပြန်အလှန်တုံ့ပြန်နိုင်သော ဝဘ်ကာတွန်းစံနှုန်း၊ တစ်ချိန်က အင်တာနက်ပေါ်ရှိ ဂိမ်းများနှင့် ကာတွန်းများကို လွှမ်းမိုးခဲ့သည်။ အားနည်းချက်များ- plugin ပေါ်မှီခိုမှု၊ မိုဘိုင်းပံ့ပိုးမှုမရှိ၊ လုံခြုံရေးအန္တရာယ်မြင့်မားမှု။ Adobe က ၂၀၁၇ ခုနှစ်တွင် ဖယ်ရှားမည်ဟုကြေငြာခဲ့ပြီး ၂၀၂၀ ခုနှစ်တွင် ပံ့ပိုးမှုအားလုံးကို ရပ်ဆိုင်းခဲ့ကာ HTML5/CSS3/JS ဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_dtd"
msgstr "DTD (Document Type Definition) (XML သတ်မှတ်ချက်၊ XML စာရွက်စာတမ်းဖွဲ့စည်းပုံကို သတ်မှတ်သည်၊ XML ၏ မှန်ကန်မှုကို အတည်ပြုရန် အသုံးပြုသည်)"

msgid "mime_csv"
msgstr "CSV ဒေတာဖော်မတ် (comma-separated values၊ အသုံးများသော စားပွဲဒေတာဖော်မတ်၊ Excel နှင့် ဒေတာဘေ့စ် တင်သွင်းခြင်းနှင့် ထုတ်ယူခြင်း စံနှုန်း)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java အပလီကေးရှင်း စတင်သည့်ကိရိယာ၊ ၂၀၀၀ ပြည့်လွန်နှစ်များတွင် Java desktop အပလီကေးရှင်း ဖြန့်ချိရေးနည်းပညာ၊ ယခုအခါ ဖယ်ရှားပြီးဖြစ်သည်)"

msgid "mime_lit"
msgstr "Microsoft Reader အီးဘွတ်ခ် (Microsoft က ၂၀၀၀ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်، LIT ဖော်မတ်၊ ဖယ်ရှားပြီးဖြစ်သည်)"

msgid "mime_svg"
msgstr "SVG ဗက်တာဂရပ်ဖစ် (၁၉၉၉ ခုနှစ်တွင် W3C စံနှုန်း၊ Microsoft က ၎င်း၏ကိုယ်ပိုင် VML ဖော်မတ်ကို ကြာရှည်စွာ တွန်းအားပေးခဲ့သောကြောင့် IE ဘရောင်ဇာသည် ၂၀၁၁ ခုနှစ်အထိ ပံ့ပိုးမှုရှိခဲ့ကာ ဖြန့်ကျက်မှုကို နှောင့်နှေးစေခဲ့သည်။ ၂၀၁၅ ခုနှစ်နောက်ပိုင်း IE ဖယ်ရှားခံရပြီး မြင့်မားသော ရုပ်ထွက်မျက်နှာပြင်များ ဖြန့်ကျက်လာသည်နှင့်အမျှ အိုင်ကွန်များနှင့် လိုဂိုများအတွက် ရွေးချယ်စရာဖော်မတ်ဖြစ်လာသည်)"

msgid "mime_ai"
msgstr "Adobe Illustrator ဗက်တာဂရပ်ဖစ် (၁၉၈၇ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ စက်မှုလုပ်ငန်းသုံး ဗက်တာဂရပ်ဖစ်ဖော်မတ်၊ ပုံနှိပ်ဒီဇိုင်း၊ လိုဂို၊ အိုင်ကွန်များအတွက် ရွေးချယ်စရာ)"

msgid "mime_phshop"
msgstr "Photoshop ရုပ်ပုံ (Adobe က ၁၉၉၀ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Photoshop ၏ မူရင်းဖိုင်ဖော်မတ် PSD၊ ရုပ်ပုံလုပ်ဆောင်ခြင်း စက်မှုလုပ်ငန်းစံနှုန်း)"

msgid "mime_ttf"
msgstr "TrueType ဖောင့် (Apple နှင့် Microsoft တို့က ၁၉၈၉ ခုနှစ်တွင် ပူးတွဲဖန်တီးခဲ့သည်၊ ဗက်တာဖောင့်ဖော်မတ်၊ မျက်နှာပြင်ပေါ်တွင်ပြသခြင်းနှင့် ပုံနှိပ်ခြင်းတို့ တူညီသည်၊ ခေတ်မီလည်ပတ်မှုစနစ်များ၏ မူရင်းဖောင့်ဖော်မတ်)"

msgid "mime_fon"
msgstr "WOFF2 ဝဘ်ဖောင့် (W3C က ၂၀၁၄ ခုနှစ်တွင် အကြံပြုခဲ့သည်၊ Brotli ချုံ့အယ်လဂိုရီသမ်ကို အသုံးပြုသည်၊ WOFF အဟောင်းနှင့် နှိုင်းယှဉ်ပါက အရွယ်အစား ၃၀% ခန့် လျော့ကျပြီး TTF/OTF နှင့် နှိုင်းယှဉ်ပါက ၅၀% ကျော် လျော့ကျသည်၊ ယခုအခါ ခေတ်မီဘရောင်ဇာများအားလုံးက ပံ့ပိုးထားပြီး ခေတ်မီဝဘ်ဖောင့်အတွက် ရွေးချယ်စရာဖော်မတ်ဖြစ်ကာ ဘရောင်ဇာ ၉၈% ကျော်က ပံ့ပိုးထားသည်)"

msgid "mime_pdf"
msgstr "PDF စာရွက်စာတမ်း (Adobe က ၁၉၉၃ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ ၂၀၀၈ ခုနှစ်တွင် ISO စံနှုန်းဖြစ်လာသည်။ Cross-platform စာရွက်စာတမ်းဖော်မတ်၊ ဖော်မတ်တစ်ပုံစံတည်းကို ထိန်းသိမ်းထားပြီး အီလက်ထရွန်းနစ်စာရွက်စာတမ်းဖြန့်ချိရေး၏ ကမ္ဘာ့စံနှုန်းဖြစ်သည်)"

msgid "mime_dotnet"
msgstr "ASP.NET ဒိုင်နမစ်စာမျက်နှာ (Microsoft က ၂၀၀၂ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows ပလက်ဖောင်းပေါ်ရှိ ဒိုင်နမစ်ဝဘ်စာမျက်နှာနည်းပညာ၊ .NET Framework ၏ အစိတ်အပိုင်းတစ်ခု)"

msgid "mime_mdb"
msgstr "Access ဒေတာဘေ့စ် (Microsoft Access ဒေတာဘေ့စ်ဖိုင်၊ ၁၉၉၂ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows desktop ဒေတာဘေ့စ်ဖြေရှင်းချက်)"

msgid "mime_md"
msgstr "Markdown စာရွက်စာတမ်း (John Gruber က ၂၀၀၄ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ syntax ဒီဇိုင်းသည် reStructuredText နှင့် Setext တို့၏ လွှမ်းမိုးမှုကို ခံခဲ့ရသည်။ အဓိကဒီဇိုင်းအတွေးအခေါ်မှာ 'ဖတ်နိုင်သည် သက်ရောက်နိုင်သည်' ဖြစ်သည်။ မူရင်း Markdown.pl သည် Perl ပုံမှန်အသုံးအနှုန်းကို အသုံးပြုသည်။ ဆက်ခံသတ်မှတ်ချက်များတွင် GFM (၂၀၁၃)၊ CommonMark (၂၀၁၇)၊ Pandoc Markdown စသည်တို့ ပါဝင်သည်။ GitHub၊ GitLab၊ Stack Overflow၊ Jupyter Notebook၊ Obsidian၊ Hugo၊ VitePress ကဲ့သို့သော ဂေဟစနစ်များကို မောင်းနှင်ပေးပြီး static site generator များနှင့် developer စာရွက်စာတမ်းများအတွက် တကယ့်စံနှုန်းဖော်မတ်ဖြစ်လာသည်)"

msgid "mime_crystal"
msgstr "Crystal Reports အစီရင်ခံစာဖော်မတ် (SAP ၏ လုပ်ငန်းဆိုင်ရာ ဉာဏ်ရည်အစီရင်ခံစာ၊ စံသတ်မှတ်ထားသော လုပ်ငန်းသုံးအစီရင်ခံစာဖော်မတ်)"

msgid "mime_libreoffice"
msgstr "LibreOffice စာရွက်စာတမ်း (The Document Foundation က ၂၀၁၀ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ OpenOffice ၏ အကိုင်းအခက်တစ်ခု၊ ODF စံနှုန်းကို အကောင်အထည်ဖော်သည်၊ ပင်မရေစီးကြောင်း open-source ရုံးသုံးအစီအစဉ်အစု)"

msgid "mime_encrypt"
msgstr "စာဝှက်ဖိုင် (ဖိုင်ကိုကြည့်ရှုရန် စာဝှက်ဖြေရမည်၊ အသုံးများသော extension များ- .enc၊ .crypt၊ .pgp၊ .gpg)"

msgid "mime_gpx"
msgstr "GPS လမ်းကြောင်းဒေတာ (GPS ဖလှယ်မှုဖော်မတ်၊ ပထဝီဝင်တည်နေရာဒေတာကို မှတ်တမ်းတင်သည်၊ အားကစားနာရီများနှင့် လမ်းညွှန်ကိရိယာများအတွက် အသုံးများသော ဖော်မတ်)"

msgid "mime_diskimage"
msgstr "ဒစ်ခ်ပုံရိပ် (DMG၊ ISO၊ IMG စသည့် optical disk/disk image ဖိုင်များ၊ ဆော့ဖ်ဝဲလ်ဖြန့်ချိရန် သို့မဟုတ် သိုလှောင်မီဒီယာ အရန်သိမ်းရန် အသုံးပြုသည်)"

msgid "mime_vm"
msgstr "virtual machine ပုံရိပ် (VMDK၊ VDI၊ VHDX၊ OVA စသည့် virtual machine disk ဖိုင်များ၊ VMware၊ VirtualBox၊ Hyper-V ကဲ့သို့သော virtualization ပလက်ဖောင်းများအတွက် ဖော်မတ်)"

msgid "mime_torrent"
msgstr "BitTorrent အစေ့ဖိုင် (Bram Cohen က ၂၀၀၁ ခုနှစ်တွင် တီထွင်ခဲ့သည်၊ P2P ဒေါင်းလုဒ် အညွှန်းဖိုင်၊ ဖိုင် meta data နှင့် Tracker အချက်အလက်များ ပါဝင်သည်)"

msgid "mime_gis"
msgstr "GIS ပထဝီဝင်အချက်အလက်စနစ်ဒေတာ (Shapefile၊ GeoJSON စသည့် ပထဝီဝင်နေရာဒေသဆိုင်ရာ ဒေတာဖော်မတ်များ၊ မြေပုံနှင့် spatial analysis အတွက် အသုံးပြုသည်)"

msgid "mime_ebook"
msgstr "အီးဘွတ်ခ် (EPUB၊ MOBI၊ AZW စသည့် အီးဘွတ်ခ်ဖော်မတ်များ။ EPUB သည် နိုင်ငံတကာစံနှုန်းဖြစ်ပြီး MOBI/AZW သည် Amazon Kindle အတွက် ဖော်မတ်ဖြစ်သည်)"

msgid "mime_avif"
msgstr "AVIF ရုပ်ပုံ (Alliance for Open Media က ၂၀၁၉ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ AV1 ကုဒ်အခြေခံထားပြီး WebP ထက် ၅၀% ပိုမိုမြင့်မားသော ချုံ့နှုန်းရှိသည်၊ မျိုးဆက်သစ် ဝဘ်ရုပ်ပုံစံနှုန်း)"

msgid "mime_markdown"
msgstr "Markdown စာရွက်စာတမ်း (John Gruber က ၂၀၀၄ ခုနှစ်တွင် ဒီဇိုင်းထုတ်ခဲ့သည်၊ ပေါ့ပါးသော markup ဘာသာစကား၊ GitHub README၊ နည်းပညာစာရွက်စာတမ်းများ၊ ဖိုရမ်ပို့စ်များအတွက် အသုံးများသော ဖော်မတ်)"

msgid "mime_yaml"
msgstr "YAML ဖွဲ့စည်းမှု (Clark Evans က ၂၀၀၁ ခုနှစ်တွင် ဒီဇိုင်းထုတ်ခဲ့သည်၊ လူဖတ်နိုင်သော ဒေတာ serialization ဖော်မတ်၊ Kubernetes၊ Ansible၊ Docker Compose တို့အတွက် ဖွဲ့စည်းမှုဖိုင်စံနှုန်း)"

msgid "mime_toml"
msgstr "TOML ဖွဲ့စည်းမှု (Tom Preston-Werner က ၂၀၁၃ ခုနှစ်တွင် ဒီဇိုင်းထုတ်ခဲ့သည်၊ 'Tom's Obvious Minimal Language'၊ Rust/Cargo၊ Python/pip၊ Go စသည့် ခေတ်မီကိရိယာများအတွက် ဖွဲ့စည်းမှုဖိုင်ဖော်မတ်)"

msgid "mime_vue"
msgstr "Vue ကွန်ပိုနင့်ဖိုင် (Evan You မှ 2014 ခုနှစ်တွင် မိတ်ဆက်ခဲ့သော တိုးတက်သော JavaScript frame work ။ Single-file component (SFC) များမှတစ်ဆင့် HTML, CSS နှင့် JS တို့ကို ပြီးပြည့်စုံစွာ ပေါင်းစပ်ကာ ဖွံ့ဖြိုးရေး စွမ်းဆောင်ရည်ကို များစွာ မြှင့်တင်ပေးသည်။ ၎င်းသည် ကမ္ဘာ့အကျော်ကြားဆုံး frontend frame work များထဲမှ တစ်ခုဖြစ်သည်။ ထို့အပြင် VitePress ကဲ့သို့သော ခေတ်မီ static site generator များ၏ core အဖြစ် interactive technical documentation နှင့် blog များကို မောင်းနှင်ရန် ကျယ်ကျယ်ပြန့်ပြန့် အသုံးပြုသည်။)"

msgid "mime_wasm"
msgstr "WebAssembly module (၂၀၁၇ ခုနှစ်တွင် W3C စံနှုန်း၊ ဘရောင်ဇာတွင် စွမ်းဆောင်ရည်မြင့်မားစွာ လုပ်ဆောင်နိုင်သော ဖော်မတ်၊ C/C++/Rust/R ကို ပစ်မှတ်အဖြစ် ကွန်ပါလ်ပြုလုပ်နိုင်ပြီး ဇာတိစွမ်းဆောင်ရည်နှင့် နီးစပ်သည်)"

msgid "mime_jsx"
msgstr "React JSX အစိတ်အပိုင်း (Facebook က ၂၀၁၃ ခုနှစ်တွင် JavaScript XML ကို မိတ်ဆက်ခဲ့သည်၊ React framework ၏ အစိတ်အပိုင်း syntax၊ HTML ကို JavaScript တွင် ရေးသားနိုင်သော ဆန်းသစ်မှု)"

msgid "mime_tsx"
msgstr "TypeScript TSX အစိတ်အပိုင်း (Microsoft က ၂၀၁၂ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ TypeScript + JSX၊ React အမျိုးအစား-လုံခြုံရေး ဖွံ့ဖြိုးရေးအတွက် စံရေးနည်း)"

msgid "mime_heif"
msgstr "HEIF ရုပ်ပုံ (၂၀၁၅ ခုနှစ်တွင် MPEG စံနှုန်း၊ စွမ်းဆောင်ရည်မြင့် ရုပ်ပုံဖိုင်ဖော်မတ်၊ Apple ဂေဟစနစ်တွင် ကျယ်ကျယ်ပြန့်ပြန့် အသုံးပြုသည်)"

msgid "mime_heic"
msgstr "HEIC ရုပ်ပုံ (Apple ၏ HEIF အကောင်အထည်ဖော်မှု၊ iPhone ၏ မူရင်းဓာတ်ပုံဖော်မတ်၊ iOS/macOS တွင် ဇာတိပံ့ပိုးမှုရှိသည်)"

msgid "mime_gltf"
msgstr "GLTF 3D မော်ဒယ် (GL transmission format၊ '3D ၏ JPEG'၊ Khronos Group က ၂၀၁၅ ခုနှစ်တွင် ထုတ်ပြန်ခဲ့သည်၊ Web 3D စံဖော်မတ်)"

msgid "mime_glb"
msgstr "GLB binary 3D မော်ဒယ် (GLTF ၏ binary ဗားရှင်း၊ ဖိုင်တစ်ခုတည်းတွင် အရင်းအမြစ်အားလုံးပါဝင်ပြီး 3D မြင်ကွင်းများ ဖြန့်ချိရန် အသုံးပြုသည်)"

msgid "mime_gls"
msgstr "GLOSSARY ဝေါဟာရ (ဝေါဟာရအဓိပ္ပာယ်ဖွင့်ဆိုချက်ဖိုင်၊ စာရွက်စာတမ်းစနစ်တွင် ဝေါဟာရများကို စီမံခန့်ခွဲရန် အသုံးပြုသည်)"

msgid "mime_cbz"
msgstr "CBZ ရုပ်ပြ (ZIP ဖြင့် ချုံ့ထားသော ရုပ်ပြပုံများ၊ ရုပ်ပြစုဆောင်းမှုအတွက် အသုံးများသော ဖော်မတ်)"

msgid "mime_cbr"
msgstr "CBR ရုပ်ပြ (RAR ဖြင့် ချုံ့ထားသော ရုပ်ပြပုံများ၊ ရုပ်ပြစုဆောင်းမှုအတွက် အသုံးများသော ဖော်မတ်)"

msgid "mime_fb2"
msgstr "FB2 အီးဘွတ်ခ် (FictionBook 2.0၊ ရုရှားအီးဘွတ်ခ်ဖော်မတ်၊ XML ဖွဲ့စည်းပုံ၊ open-source စာဖတ်သူများက ကျယ်ကျယ်ပြန့်ပြန့် ပံ့ပိုးထားသည်)"

msgid "mime_kepub"
msgstr "KEPUB အီးဘွတ်ခ် (Kobo အတွက် သီးသန့် EPUB ဖော်မတ်၊ Kobo အီးဘွတ်ခ်စာဖတ်သူအတွက် အကောင်းဆုံးဖြစ်အောင် ပြုလုပ်ထားသော ဖော်မတ်)"

msgid "mime_m4b"
msgstr "M4B အသံစာအုပ် (MPEG-4 အသံစာအုပ်ဖော်မတ်၊ စာညှပ်များကို ပံ့ပိုးသည်၊ iTunes အသံစာအုပ်ဖော်မတ်)"

msgid "mime_kfx"
msgstr "Kindle KFX ဖော်မတ် (Amazon က ၂၀၁၅ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Kindle အတွက် သီးသန့်အီးဘွတ်ခ်ဖော်မတ်၊ ပိုမိုကောင်းမွန်သော အပြင်အဆင်နှင့် စာမျက်နှာအမြန်လှန်ခြင်းကို ပံ့ပိုးသည်)"

msgid "mime_chm"
msgstr "CHM အကူအညီဖိုင် (Microsoft က ၁၉၉၇ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ စုစည်းထားသော HTML အကူအညီဖော်မတ်၊ Windows ဆော့ဖ်ဝဲလ် အကူအညီစာရွက်စာတမ်း စံနှုန်း)"

msgid "mime_mht"
msgstr "MHT ဝဘ်မော်ကွန်း (Microsoft က ၁၉၉၉ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ ဖိုင်တစ်ခုတည်းပါဝင်သော ဝဘ်စာမျက်နှာဖော်မတ်၊ IE ဘရောင်ဇာ၏ ဝဘ်စာမျက်နှာသိမ်းဆည်းမှုဖော်မတ်)"

msgid "mime_wml"
msgstr "WML ကြိုးမဲ့အမှတ်အသားဘာသာစကား (၁၉၉၉ ခုနှစ်တွင် WAP စံနှုန်း၊ အစောပိုင်း အခြေခံဖုန်းများ၏ ဝဘ်စာမျက်နှာဖိုင်များအတွက် အသုံးပြုခဲ့ပြီး ဖယ်ရှားပြီးဖြစ်သည်)"

msgid "mime_xhtml"
msgstr "XHTML ဝဘ်စာမျက်နှာ (၂၀၀၀ ခုနှစ်တွင် W3C စံနှုန်း၊ HTML ၏ XML ဗားရှင်း၊ syntax ပိုမိုတင်းကျပ်သည်။ W3C က ၂၀၀၉ ခုနှစ်တွင် ပြုပြင်ထိန်းသိမ်းမှုကို ရပ်ဆိုင်းခဲ့ပြီး အာရုံစိုက်မှုကို HTML5 သို့ ပြောင်းလဲခဲ့သည်)"

msgid "mime_xml"
msgstr "XML စာရွက်စာတမ်း (၁၉၉၈ ခုနှစ်တွင် W3C စံနှုန်း၊ portable markup ဘာသာစကား၊ ဝဘ်ဝန်ဆောင်မှုများ၊ ဖွဲ့စည်းပုံဖိုင်များ၊ ဒေတာဖလှယ်ခြင်းအတွက် အခြေခံဖော်မတ်)"

msgid "mime_sgml"
msgstr "SGML စာရွက်စာတမ်း (၁၉၈၆ ခုနှစ်တွင် ISO စံနှုန်း၊ HTML ၏ ရှေ့ပြေးပုံစံ၊ စံသတ်မှတ်ထားသော ယေဘုယျ markup ဘာသာစကား၊ XML နှင့် HTML နှစ်ခုစလုံးသည် SGML မှ ဆင်းသက်လာသည်)"

msgid "mime_apng"
msgstr "APNG ကာတွန်း (Mozilla က ၂၀၀၄ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ PNG ၏ ကာတွန်း extension၊ GIF ၏ ခေတ်မီအစားထိုး၊ အရောင်အစစ်နှင့် ပွင့်လင်းမြင်သာမှုကို ပံ့ပိုးသည်)"

msgid "mime_bmp"
msgstr "BMP ဘစ်မြေပုံ (Windows ဘစ်မြေပုံဖော်မတ်၊ Windows 1.0 မှ စတင်၍ ပင်ကိုယ်ပံ့ပိုးထားသည်။ ချုံ့မထားသော၊ ဖိုင်အရွယ်အစားကြီးမားသော်လည်း၊ ရိုးရှင်းသောဖွဲ့စည်းပုံနှင့် ကုဒ်ဒက်များ ထပ်မံမလိုအပ်သောကြောင့်၊ Windows 11 ၏ ဖြတ်တောက်ရေးကိရိယာ၊ Paint ပရိုဂရမ်၊ EXE/MSI တပ်ဆင်မှုပက်ကေ့ချ်များရှိ အိုင်ကွန်အရင်းအမြစ်များ၊ ကာဆာဖိုင်များနှင့် ဒရိုက်ဗာအဟောင်းအချို့တွင် ယနေ့တိုင် အသုံးပြုဆဲဖြစ်သည်။ တူညီသောရုပ်ပုံအရည်အသွေးတွင်၊ ဖိုင်အရွယ်အစားသည် PNG ထက် ၃-၁၀ ဆ ခန့် ပိုကြီးသည်။ ကိစ္စအများစုတွင် PNG/JPEG ဖြင့် အစားထိုးခံရပြီးဖြစ်သော်လည်း၊ Windows ဂေဟစနစ်သည် ကျယ်ပြန့်သော လိုက်ဖက်ညီမှုကို ဆက်လက်ထိန်းသိမ်းထားဆဲဖြစ်သည်)"

msgid "mime_cdr"
msgstr "CDR ဗက်တာဂရပ်ဖစ် (CorelDRAW အတွက် သီးသန့်ဖော်မတ်၊ ကနေဒါနိုင်ငံ Corel ကုမ္ပဏီ၊ ဗက်တာဂရပ်ဖစ်ဒီဇိုင်းဆော့ဖ်ဝဲလ်)"

msgid "mime_gif"
msgstr "GIF ရုပ်ပုံ (CompuServe က ၁၉၈၇ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ ၂၅၆ ရောင်ရှိသော ကာတွန်းရုပ်ပုံဖော်မတ်။ အားနည်းချက်များ- အရောင်နည်းခြင်း၊ ရုပ်ပုံအရည်အသွေး ကြမ်းတမ်းခြင်း၊ ပွင့်လင်းမြင်သာမှုကို မပံ့ပိုးခြင်း၊ ဖိုင်ကြီးခြင်း၊ frame rate နိမ့်ခြင်း။ APNG၊ WebP ကဲ့သို့သော ခေတ်မီကာတွန်းရုပ်ပုံဖော်မတ်များဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_ico"
msgstr "ICO အိုင်ကွန် (Windows အိုင်ကွန်ဖိုင်ဖော်မတ်၊ ဘက်စုံကြည်လင်ပြတ်သားမှုကို ပံ့ပိုးသည်၊ ဝဘ်ဆိုက် favicon အတွက် စံဖော်မတ်)"

msgid "mime_jpeg"
msgstr "JPEG ရုပ်ပုံ (၁၉၉၂ ခုနှစ်တွင် ISO စံနှုန်း၊ ဓာတ်ပုံများအတွက် ဆုံးရှုံးမှုရှိသော ချုံ့ဖော်မတ်၊ အင်တာနက်ပေါ်ရှိ ဓာတ်ပုံများအတွက် တကယ့်စံနှုန်း)"

msgid "mime_jpg"
msgstr "JPEG ရုပ်ပုံ (၁၉၉၂ ခုနှစ်တွင် ISO စံနှုန်း၊ ဓာတ်ပုံများအတွက် ဆုံးရှုံးမှုရှိသော ချုံ့ဖော်မတ်၊ အင်တာနက်ပေါ်ရှိ ဓာတ်ပုံများအတွက် တကယ့်စံနှုန်း)"

msgid "mime_png"
msgstr "PNG ရုပ်ပုံ (W3C က ၁၉၉၆ ခုနှစ်တွင် အကြံပြုခဲ့သည်၊ အရောင်အစစ်နှင့် ပွင့်လင်းမြင်သာမှုကို ပံ့ပိုးသည်၊ GIF ၏ တည်ငြိမ်သော အစားထိုး၊ အင်တာနက်ပေါ်ရှိ ဆုံးရှုံးမှုမရှိသော ရုပ်ပုံစံနှုန်း)"

msgid "mime_ps"
msgstr "PostScript စာမျက်နှာဖော်ပြချက်ဖိုင် (Adobe က ၁၉၈၅ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ စာမျက်နှာဖော်ပြချက်ဘာသာစကား၊ PDF ၏ ရှေ့ပြေးပုံစံ၊ ပုံနှိပ်ခြင်းနှင့် ထုတ်ဝေခြင်းအတွက် အသုံးပြုသည်)"

msgid "mime_psb"
msgstr "PSB ကြီးမားသောစာရွက်စာတမ်း (Adobe Photoshop ၏ အလွန်ကြီးမားသော ရုပ်ပုံဖော်မတ်၊ ၂ GB သို့မဟုတ် ၃၀၀၀၀ pixel ထက်ကြီးသော ဧရာမရုပ်ပုံများကို ပံ့ပိုးသည်)"

msgid "mime_psd"
msgstr "PSD ရုပ်ပုံ (Adobe Photoshop ၏ မူရင်းဖိုင်၊ အလွှာများ၊ ချန်နယ်များ၊ လမ်းကြောင်းများကို ပံ့ပိုးသည်၊ ရုပ်ပုံလုပ်ဆောင်ခြင်း စက်မှုလုပ်ငန်းစံဖော်မတ်)"

msgid "mime_webp"
msgstr "WebP ရုပ်ပုံ (Google က ၂၀၁၀ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ ဝဘ်ရုပ်ပုံဖော်မတ်၊ ဆုံးရှုံးမှုရှိ/မရှိ ချုံ့ခြင်းနှင့် ကာတွန်းကို ပံ့ပိုးသည်၊ PNG ထက် ၂၅-၃၅% နှင့် JPEG ထက် ၂၅% ပိုမိုမြင့်မားသော ချုံ့နှုန်းရှိသည်)"

msgid "mime_woff"
msgstr "WOFF ဝဘ်ဖောင့် (၂၀၀၉ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ ၂၀၁၈ ခုနှစ်တွင် W3C စံနှုန်း။ TrueType/OpenType ကိုအခြေခံပြီး ချုံ့ထားသည်၊ ဝဘ်ဖောင့်တင်ခြင်းအတွက် အကောင်းဆုံးဖြစ်အောင်ပြုလုပ်ထားပြီး ခေတ်မီဝဘ်ဆိုက်အိုင်ကွန်ဖောင့်များအတွက် စံဖော်မတ်)"

msgid "mime_7z"
msgstr "7z ချုံ့ထားသောဖိုင် (Igor Pavlov က ၁၉၉၉ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ 7-Zip ပရိုဂရမ်၏ သီးသန့်ဖော်မတ်။ LZMA algorithm၊ မြင့်မားသော ချုံ့နှုန်း၊ open-source နှင့် အခမဲ့။ ချုံ့နှုန်းတူညီသော 7z ဖော်မတ်သည် ZIP ထက် ၃၀-၅၀% သေးငယ်လေ့ရှိပြီး open-source အသိုင်းအဝိုင်းနှင့် ဆော့ဖ်ဝဲလ်ဖြန့်ချိမှုအတွက် အသုံးများသော ဖော်မတ်ဖြစ်သည်)"

msgid "mime_ace"
msgstr "ACE ချုံ့ထားသောဖိုင် (၁၉၉၀ ပြည့်လွန်နှစ်များတွင် ဖန်တီးခဲ့သည်၊ WinACE ပရိုဂရမ်ဖော်မတ်။ RAR နှင့် တစ်ချိန်က ယှဉ်ပြိုင်ခဲ့ပြီး ချုံ့နှုန်းအတော်အတန်မြင့်မားသည်။ ၂၀၀၇ ခုနှစ်တွင် ဖွံ့ဖြိုးတိုးတက်မှုရပ်ဆိုင်းခဲ့ပြီး ယခုအခါ 7z/RAR ဖြင့် အစားထိုးခဲ့ကာ အသုံးနည်းပါးလာသည်)"

msgid "mime_bz2"
msgstr "BZIP2 ချုံ့ထားသောဖိုင် (Julian Seward က ၁၉၉၆ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ block sorting compression algorithm။ GZIP ထက် ၁၅-၂၀% ပိုမိုမြင့်မားသော ချုံ့နှုန်းရှိသော်လည်း နှေးကွေးသည်။ Linux kernel source code, open-source ဆော့ဖ်ဝဲလ်ပက်ကေ့ချ်များအတွက် အသုံးများသော ဖော်မတ်၊ extension .bz2)"

msgid "mime_cab"
msgstr "CAB ချုံ့ထားသောဖိုင် (Microsoft က ၁၉၉၅ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Cabinet ဖော်မတ်။ Windows တပ်ဆင်မှုပက်ကေ့ချ်ဖော်မတ်၊ driver များ၊ system files ဖြန့်ချိမှုအတွက် အသုံးပြုသည်။ Windows Installer (MSI) သည် ဖိုင်များကို သိမ်းဆည်းရန် CAB ကို အတွင်းပိုင်းတွင် အသုံးပြုသည်)"

msgid "mime_dmg"
msgstr "DMG disk image (Apple က ၁၉၈၀ ပြည့်လွန်နှစ်များတွင် မိတ်ဆက်ခဲ့သည်၊ Disk Image ဖော်မတ်။ macOS ဆော့ဖ်ဝဲလ်ဖြန့်ချိမှု စံဖော်မတ်၊ ဒက်စ်တော့ပေါ်တွင် double-click နှိပ်ခြင်းဖြင့် virtual disk တစ်ခုအဖြစ် တပ်ဆင်ပေးပြီး ဆွဲချခြင်းဖြင့် အပလီကေးရှင်းကို တပ်ဆင်နိုင်သည်။ ချုံ့ခြင်းနှင့် စာဝှက်ခြင်းကို ပံ့ပိုးပြီး Mac ဆော့ဖ်ဝဲလ်ဒေါင်းလုဒ်အတွက် အဓိကဖော်မတ်ဖြစ်သည်)"

msgid "mime_emz"
msgstr "EMZ ချုံ့ထားသောရုပ်ပုံ (Windows compressed Enhanced Metafile, EMF ၏ ချုံ့ထားသောဗားရှင်း။ Office စာရွက်စာတမ်းများတွင် ဗက်တာဂရပ်ဖစ်သိုလှောင်မှုဖော်မတ်၊ အခြေခံအားဖြင့် GZIP ဖြင့် ချုံ့ထားသော EMF ဖိုင်ဖြစ်သည်)"

msgid "mime_gz"
msgstr "GZIP ချုံ့ထားသောဖိုင် (Jean-loup Gailly နှင့် Mark Adler တို့က ၁၉၉၂ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ GNU ပရောဂျက်။ Unix/Linux ၏ စံချုံ့ကိရိယာ၊ HTTP transmission ချုံ့မှုအတွက် အသုံးများသော ဖော်မတ်။ extension .gz၊ TAR နှင့် မကြာခဏ တွဲဖက်အသုံးပြုသည်)"

msgid "mime_jar"
msgstr "JAR ချုံ့ထားသောဖိုင် (Sun Microsystems က ၁၉၉၇ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Java ARchive ဖော်မတ်။ အခြေခံအားဖြင့် ZIP ဖိုင်ဖြစ်ပြီး Java လိုင်ဘရေရီများနှင့် အပလီကေးရှင်းများကို ထုပ်ပိုးရန် အသုံးပြုသည်။ Maven, Gradle စသည့် Java ဂေဟစနစ်၏ အဓိကဖော်မတ်၊ Android ကလည်း JAR ကို အသုံးပြုသည်)"

msgid "mime_lzma"
msgstr "LZMA ချုံ့ထားသောဖိုင် (Igor Pavlov က ၁၉၉၈ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Lempel-Ziv-Markov chain algorithm။ 7z ဖော်မတ်၏ အဓိက compression algorithm၊ မြင့်မားသော ချုံ့နှုန်း၊ ဖြုတ်ချခြင်းအမြန်နှုန်း။ firmware နှင့် embedded system ဆော့ဖ်ဝဲလ်ဖြန့်ချိမှုအတွက် အသုံးပြုသည်)"

msgid "mime_rar"
msgstr "RAR ချုံ့ထားသောဖိုင် (Eugene Roshal က ၁၉၉၃ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Roshal ARchive ဖော်မတ်။ မြင့်မားသော ချုံ့နှုန်း၊ volume splitting နှင့် recovery record ကို ပံ့ပိုးသည်။ WinRAR ပရိုဂရမ်ဖော်မတ်၊ ZIP ထက် ပိုမိုကောင်းမွန်သော ချုံ့နှုန်းရှိသော်လည်း အခပေးဆော့ဖ်ဝဲလ် လိုအပ်ပြီး unrar ကဲ့သို့သော open-source ကိရိယာများဖြင့် ဖြုတ်ချနိုင်သည်)"

msgid "mime_tar"
msgstr "TAR မော်ကွန်းဖိုင် (Unix V7 က ၁၉၇၉ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Tape ARchive ဖော်မတ်။ တိပ်မော်ကွန်းဖော်မတ်၊ ချုံ့ခြင်းမပြုဘဲ ထုပ်ပိုးရုံသာဖြစ်ပြီး GZIP/BZIP2/XZ တို့နှင့် မကြာခဏ တွဲဖက်အသုံးပြုသည်။ Linux ပက်ကေ့ချ် source code, Docker image layer သိုလှောင်မှုတို့သည် TAR ဖော်မတ်ကို အသုံးပြုသည်)"

msgid "mime_tgz"
msgstr "TGZ ချုံ့ထားသောဖိုင် (TAR + GZIP ပေါင်းစပ်ဖော်မတ်၊ extension .tgz သို့မဟုတ် .tar.gz။ Unix/Linux ဆော့ဖ်ဝဲလ်ပက်ကေ့ချ်များအတွက် အသုံးအများဆုံး ဖြန့်ချိဖော်မတ်၊ source code ပက်ကေ့ချ်များ၊ binary ပက်ကေ့ချ်များ၊ ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုကြပြီး 'ဖြုတ်ပြီးသုံးပါ' ၏ ကိုယ်စားလှယ်ဖြစ်သည်)"

msgid "mime_tbz2"
msgstr "TBZ2 ချုံ့ထားသောဖိုင် (TAR + BZIP2 ပေါင်းစပ်ဖော်မတ်၊ extension .tbz2 သို့မဟုတ် .tar.bz2။ TGZ ထက် ၁၅-၂၀% ပိုမိုမြင့်မားသော ချုံ့နှုန်းရှိပြီး ကြီးမားသောဖိုင်များ ဖြန့်ချိရန်အတွက် သင့်လျော်သည်၊ Linux kernel သည် ဤဖော်မတ်ကို ကာလကြာရှည်စွာ အသုံးပြုခဲ့သည်)"

msgid "mime_xz"
msgstr "XZ ချုံ့ထားသောဖိုင် (၂၀၀၉ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ LZMA2 algorithm ကို အခြေခံသည်။ အလွန်မြင့်မားသော ချုံ့နှုန်း၊ GZIP ထက် ၃၀-၅၀% ပိုမိုမြင့်မားပြီး ဖြုတ်ချခြင်းအမြန်နှုန်းမှာ အတော်အတန်မြန်ဆန်သည်။ Linux kernel, package managers (Debian ၏ .deb အတွင်းပိုင်းကဲ့သို့) တို့က ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုကြပြီး လက်ရှိ Linux ဂေဟစနစ်တွင် အကြံပြုထားသော ဖော်မတ်ဖြစ်သည်)"

msgid "mime_z"
msgstr "Z ချုံ့ထားသောဖိုင် (၁၉၈၅ ခုနှစ်တွင် Unix compress command ဖော်မတ်၊ LZW algorithm။ အစောပိုင်း Unix ချုံ့ဖော်မတ်၊ GZIP ဖြင့် အစားထိုးခဲ့ပြီးဖြစ်သည်။ extension .Z၊ ခေတ်မီစနစ်များတွင် အသုံးနည်းပါးလာသည်)"

msgid "mime_zip"
msgstr "ZIP ချုံ့ထားသောဖိုင် (Phil Katz က ၁၉၈၉ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ PKZIP ဖော်မတ်။ Windows တွင် ဇာတိပံ့ပိုးမှုရှိပြီး အင်တာနက်ပေါ်တွင် အသုံးအများဆုံး ချုံ့ဖော်မတ်ဖြစ်သည်။ ဖိုင်များစွာ၊ လမ်းညွှန်ဖွဲ့စည်းပုံကို ပံ့ပိုးပြီး ချုံ့ algorithm ကို ရွေးချယ်နိုင်သည်။ Java ၏ JAR၊ Android ၏ APK၊ Office စာရွက်စာတမ်းများ၏ DOCX/XLSX တို့သည် ZIP ဖော်မတ်ကို အခြေခံထားသည်)"

msgid "mime_zst"
msgstr "Zstandard ချုံ့ထားသောဖိုင် (Facebook က ၂၀၁၅ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Yann Collet က ဒီဇိုင်းထုတ်သည်။ မြန်နှုန်းမြင့် compression algorithm၊ ချုံ့နှုန်းသည် LZMA နှင့် နီးစပ်ပြီး အမြန်နှုန်းမှာ GZIP ထက် များစွာပိုမိုမြန်ဆန်သည်။ Linux kernel 5.9+ က ပံ့ပိုးထားပြီး Arch Linux pacman, Debian APT တို့က တဖြည်းဖြည်း လက်ခံကျင့်သုံးလာကြသည်၊ မျိုးဆက်သစ် compression စံနှုန်းဖြစ်သည်)"

msgid "mime_lz4"
msgstr "LZ4 ချုံ့ထားသောဖိုင် (Yann Collet က ၂၀၁၁ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ အလွန်မြန်ဆန်သော compression algorithm။ compression အမြန်နှုန်းသည် GZIP ထက် ၁၀ ဆပိုမိုမြန်ဆန်ပြီး real-time compression အခြေအနေများအတွက် သင့်လျော်သည်။ Linux kernel, OpenZFS, Hadoop တို့က ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုကြပြီး အမြန်နှုန်းကိုအလေးပေးသော အခြေအနေများအတွက် ရွေးချယ်စရာဖြစ်သည်)"

msgid "mime_lzo"
msgstr "LZO ချုံ့ထားသောဖိုင် (Markus Oberhumer က ၁၉၉၆ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Lempel-Ziv-Oberhumer algorithm။ ဖြုတ်ချခြင်းအမြန်နှုန်းသည် အလွန်မြန်ဆန်ပြီး ချုံ့နှုန်းမှာ ယေဘုယျအားဖြင့်ဖြစ်သည်။ Linux kernel Squashfs, OpenWrt firmware တို့က အသုံးပြုကြပြီး embedded system များအတွက် သင့်လျော်သည်)"

msgid "mime_msi"
msgstr "MSI တပ်ဆင်မှုပက်ကေ့ချ် (Microsoft က ၁၉၉၉ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows Installer ပက်ကေ့ချ်ဖော်မတ်။ Windows အပလီကေးရှင်း တပ်ဆင်မှု စံဖော်မတ်၊ transaction rollback, component management, silent installation ကို ပံ့ပိုးသည်။ လုပ်ငန်းသုံး ဆော့ဖ်ဝဲလ်ဖြန့်ချိမှုအတွက် ရွေးချယ်စရာဖော်မတ်ဖြစ်ပြီး ယနေ့ထိ Windows ဆော့ဖ်ဝဲလ်တပ်ဆင်မှု၏ ပင်မရေစီးကြောင်းဖြစ်နေဆဲဖြစ်သည်)"

msgid "mime_pkg"
msgstr "PKG တပ်ဆင်မှုပက်ကေ့ချ် (macOS အပလီကေးရှင်း တပ်ဆင်မှုပက်ကေ့ချ်ဖော်မတ်၊ Apple ၏ Installer နည်းပညာကို အခြေခံသည်။ macOS ဆော့ဖ်ဝဲလ်ဖြန့်ချိမှု စံဖော်မတ်၊ component selection, installation script, uninstall function ကို ပံ့ပိုးသည်။ .pkg ဖိုင်ကို double-click နှိပ်ခြင်းဖြင့် တပ်ဆင်နိုင်ပြီး Mac App Store ပြင်ပရှိ ဆော့ဖ်ဝဲလ်များအတွက် အသုံးများသော ဖြန့်ချိမှုနည်းလမ်းဖြစ်သည်)"

msgid "mime_apk"
msgstr "APK Android အက်ပလီကေးရှင်းပက်ကေ့ခ်ျ (Google မှ ၂၀၀၈ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Android စနစ်၏ ရိုးရာအက်ပလီကေးရှင်း ထည့်သွင်းခြင်းပုံစံ။ APK သည် အခြေခံအားဖြင့် ZIP ပက်ကေ့ခ်ျဖြစ်ပြီး ကုဒ်၊ အရင်းအမြစ်များနှင့် မန်နီဖတ်စ်ဖိုင်ပါဝင်သည်။ ၂၀၂၁ ခုနှစ်မှစ၍ Google Play သည် အက်ပ်အသစ်များကို AAB ပုံစံအသုံးပြုရန် လိုအပ်သော်လည်း APK ကို အမှားရှာခြင်း၊ တတိယပါတီစတိုးများနှင့် ဘေးထွက်တင်ဆောင်ခြင်းအတွက် ဆက်လက်အသုံးပြုနေဆဲဖြစ်သည်)"

msgid "mime_ipa"
msgstr "IPA iOS အက်ပလီကေးရှင်းပက်ကေ့ခ်ျ (iOS App Store Package၊ iOS/iPadOS အက်ပလီကေးရှင်းများ ထည့်သွင်းခြင်းပုံစံ။ ၂၀၀၈ ခုနှစ်တွင် iPhone SDK နှင့်အတူ မိတ်ဆက်ခဲ့သည်။ App Store မှတစ်ဆင့် ဖြန့်ဝေရန် သို့မဟုတ် လုပ်ငန်းလက်မှတ်ဖြင့် လက်မှတ်ထိုးရန် လိုအပ်သည်။ လုပ်ဆောင်နိုင်သောဖိုင်၊ အရင်းအမြစ်များ၊ Info.plist နှင့် လက်မှတ်အချက်အလက်များ ပါဝင်သည်)"

msgid "mime_hap"
msgstr "HAP HarmonyOS အက်ပလီကေးရှင်းပက်ကေ့ခ်ျ (HarmonyOS Ability Package၊ HarmonyOS အက်ပလီကေးရှင်းတစ်ခု၏ အခြေခံယူနစ်။ ၂၀၂၀ ခုနှစ်တွင် HarmonyOS 2.0 နှင့်အတူ မိတ်ဆက်ခဲ့သည်။ အမျိုးအစားနှစ်မျိုးကို ပံ့ပိုးသည်- entry နှင့် feature၊ Huawei ဖုန်းများ၊ တက်ဘလက်များ၊ စမတ်နာရီများနှင့် အခြား HarmonyOS စက်ပစ္စည်းများအတွက် ဖြန့်ချိမှုပုံစံ)"

msgid "mime_har"
msgstr "HAR HarmonyOS static မျှဝေထားသော စာကြည့်တိုက် (HarmonyOS Archive၊ HarmonyOS ၏ static မျှဝေထားသော စာကြည့်တိုက်၊ HAP ပက်ကေ့ခ်ျများစွာမှ မျှဝေနိုင်သည်၊ အစိတ်အပိုင်းအခြေခံ ဖွံ့ဖြိုးတိုးတက်မှုနှင့် module များ ပြန်လည်အသုံးပြုခြင်းအတွက် အသုံးပြုသည်)"

msgid "mime_aab"
msgstr "Android App Bundle (Google က ၂၀၁၈ ခုနှစ်တွင် မိတ်ဆက်ခဲ့ပြီး ၂၀၂၁ ခုနှစ်မှစ၍ Google Play သို့ တင်သွင်းသော အပလီကေးရှင်းအသစ်များကို ဤဖော်မတ်သုံးရန် ပြဌာန်းခဲ့သည်။ AAB သည် ဖြန့်ချိမှုဖော်မတ်ဖြစ်ပြီး Google Play က စက်ပစ္စည်းဖွဲ့စည်းပုံ (CPU architecture, screen density, language) အရ ပြောင်းလဲပြီး အကောင်းဆုံးဖြစ်အောင် APK ကို ထုတ်လုပ်ပေးကာ ပက်ကေ့ချ်အရွယ်အစားကို ပျမ်းမျှ ၃၅% လျှော့ချပေးသည်။ developer များက AAB ကို အပ်လုဒ်တင်ပြီး အသုံးပြုသူများက APK ကို ဒေါင်းလုဒ်လုပ်ကြသည်)"

msgid "mime_xapk"
msgstr "XAPK အပလီကေးရှင်း ပက်ကေ့ချ် (တတိယပုဂ္ဂိုလ် Android အပလီကေးရှင်း extension ပက်ကေ့ချ်၊ APK + OBB ဒေတာဖိုင်များ ပါဝင်သည်။ ကြီးမားသောဂိမ်းများနှင့် ရှုပ်ထွေးသော အပလီကေးရှင်းများအတွက် အသုံးပြုပြီး ဖိုင်တစ်ခုတည်း APK ၏ 100MB ကန့်သတ်ချက်ကို ဖြေရှင်းပေးသည်။ APKPure, APKMirror ကဲ့သို့သော တတိယပုဂ္ဂိုလ် အပလီကေးရှင်းစတိုးများတွင် အများအားဖြင့်တွေ့ရပြီး Google ၏ တရားဝင်ဖော်မတ် မဟုတ်ပါ)"

msgid "mime_appx"
msgstr "Windows အပလီကေးရှင်း ပက်ကေ့ချ် (Microsoft က ၂၀၁၂ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows 8/10/11 အပလီကေးရှင်း တပ်ဆင်မှုဖော်မတ်။ UWP အပလီကေးရှင်းများနှင့် desktop အပလီကေးရှင်း conversion ကို ပံ့ပိုးပြီး Microsoft Store မှတစ်ဆင့် ဖြန့်ချိသည်။ ၂၀၂၄ ခုနှစ်တွင် Microsoft က MSIX ကို ဆက်ခံဖော်မတ်အဖြစ် မိတ်ဆက်ခဲ့ပြီး APPX ကို တဖြည်းဖြည်းအစားထိုးသွားမည်)"

msgid "mime_msix"
msgstr "MSIX အပလီကေးရှင်း ပက်ကေ့ချ် (Microsoft က ၂၀၁၈ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows ပက်ကေ့ချ်ဖော်မတ်အသစ်။ APPX နှင့် MSI တို့၏ အားသာချက်များကို ပေါင်းစပ်ထားပြီး Windows အပလီကေးရှင်းအမျိုးအစားအားလုံးကို ပံ့ပိုးကာ Microsoft Store မှတစ်ဆင့် သို့မဟုတ် side-load ဖြင့် တပ်ဆင်နိုင်ပြီး Windows 11 အတွက် အကြံပြုထားသော ဖော်မတ်ဖြစ်သည်)"

msgid "mime_appimage"
msgstr "AppImage အပလီကေးရှင်း ပက်ကေ့ချ် (၂၀၀၄ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Linux တပ်ဆင်ရန်မလိုသော အပလီကေးရှင်းဖော်မတ်။ 'တစ်ခုသော အပလီကေးရှင်းအတွက် ဖိုင်တစ်ခု'၊ တပ်ဆင်ရန်မလိုဘဲ တိုက်ရိုက်လည်ပတ်နိုင်ပြီး Linux ဖြန့်ချိမှုအများစုကို ပံ့ပိုးကာ developer များအတွက် Linux ဆော့ဖ်ဝဲလ်ဖြန့်ချိရန် အသုံးများသောနည်းလမ်းဖြစ်သည်)"

msgid "mime_flatpak"
msgstr "Flatpak အပလီကေးရှင်း ပက်ကေ့ချ် (၂၀၁၅ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Linux sandbox အပလီကေးရှင်းဖော်မတ်။ ဖြန့်ချိမှုများကိုဖြတ်၍ လည်ပတ်နိုင်ပြီး host system မှ သီးခြားဖြစ်ကာ Fedora, Red Hat တို့က ဦးဆောင်ဖန်တီးထားပြီး GNOME Software Center ၏ မူရင်းဖော်မတ်ဖြစ်သည်)"

msgid "mime_snap"
msgstr "Snap အပလီကေးရှင်း ပက်ကေ့ချ် (Canonical က ၂၀၁၄ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Ubuntu မိခင်ကုမ္ပဏီက ဖန်တီးထားပြီး Linux အထွေထွေသုံး အပလီကေးရှင်းဖော်မတ်ဖြစ်သည်။ အလိုအလျောက် အပ်ဒိတ်လုပ်ခြင်း, sandbox isolation, Linux ဖြန့်ချိမှု ၄၀ ကျော်ကို ပံ့ပိုးပြီး Ubuntu Software Center ၏ မူရင်းဖော်မတ်ဖြစ်သည်)"

msgid "mime_deb"
msgstr "Debian ဆော့ဖ်ဝဲလ် ပက်ကေ့ချ် (Debian Project က ၁၉၉၃ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Debian/Ubuntu နှင့် ၎င်းတို့၏ အကိုင်းအခက်များအတွက် စံတပ်ဆင်မှုဖော်မတ်။ dpkg ဖြင့် စီမံခန့်ခွဲပြီး APT သည် ၎င်း၏ package manager front-end ဖြစ်ကာ Linux ဂေဟစနစ်တွင် အတော်ဆုံးသော package ဖော်မတ်များထဲမှတစ်ခုဖြစ်ပြီး ယနေ့ထိ Debian မိသားစုတွင် ပင်မရေစီးကြောင်းဖြစ်နေဆဲဖြစ်သည်)"

msgid "mime_rpm"
msgstr "RPM ဆော့ဖ်ဝဲလ် ပက်ကေ့ချ် (Red Hat က ၁၉၉၇ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Red Hat/Fedora/CentOS/SUSE စသည့် ဖြန့်ချိမှုများအတွက် စံဖော်မတ်။ RPM သည် 'Red Hat Package Manager' ၏ အတိုကောက်ဖြစ်ပြီး DEB နှင့်အတူ Linux ၏ အဓိက package ဖော်မတ်နှစ်ခုထဲမှတစ်ခုဖြစ်ကာ ယနေ့ထိ RHEL မိသားစုတွင် ပင်မရေစီးကြောင်းဖြစ်နေဆဲဖြစ်သည်)"

msgid "mime_pacman"
msgstr "Arch ဆော့ဖ်ဝဲလ် ပက်ကေ့ချ် (Arch Linux က ၂၀၀၂ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ pacman package manager မှ အသုံးပြုသော .pkg.tar.zst ဖော်မတ်။ Arch Linux rolling release ၏ အဓိကအချက်အချာဖြစ်ပြီး ရိုးရှင်းမှုနှင့် KISS နိယာမတို့ဖြင့် ကျော်ကြားကာ AUR (Arch User Repository) သည် ၎င်း၏ထူးခြားချက်ဖြစ်သည်)"

msgid "mime_exe"
msgstr "EXE လုပ်ဆောင်နိုင်သောဖိုင် (Windows လုပ်ဆောင်နိုင်သော ပရိုဂရမ်ဖော်မတ်၊ 'Executable' ၏ အတိုကောက်။ Windows လည်ပတ်မှုစနစ်၏ ဇာတိလုပ်ဆောင်မှုဖော်မတ်၊ PE structure ပါဝင်သည်။ MS-DOS ၏ MZ ဖော်မတ်မှ ဆင့်ကဲပြောင်းလဲလာပြီး ၁၉၉၃ ခုနှစ်တွင် Windows NT က PE (Portable Executable) ဖော်မတ်ကို မိတ်ဆက်ခဲ့ကာ ယနေ့ထိ အသုံးပြုနေဆဲဖြစ်သည်။ ဆော့ဖ်ဝဲလ်တပ်ဆင်မှုပက်ကေ့ချ်များ၊ အပလီကေးရှင်းများ၊ စနစ်ကိရိယာများအားလုံးသည် ဤဖော်မတ်ကို အသုံးပြုကြသည်။ အသုံးပြုသူက double-click နှိပ်ခြင်းဖြင့် စတင်နိုင်ပြီး ကမ္ဘာပေါ်တွင် အသုံးအများဆုံးသော လုပ်ဆောင်နိုင်သောဖော်မတ်ဖြစ်သည်)"

msgid "mime_dll"
msgstr "DLL ဒိုင်နမစ်လင့်ခ်လိုင်ဘရေရီ (Microsoft က ၁၉၉၃ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Dynamic Link Library။ Windows ၏ မျှဝေကုဒ်စုစည်းမှု၊ ပရိုဂရမ်လည်ပတ်နေချိန်တွင် ဒိုင်နမစ်လင့်ခ်လုပ်ကာ memory နှင့် disk space ကို သက်သာစေသည်။ စနစ်အစိတ်အပိုင်းများ၊ အပလီကေးရှင်း plugin များ၊ driver များအားလုံးသည် DLL ဖော်မတ်ကို အသုံးပြုကြသည်။ Windows API ၏ အဓိကအကောင်အထည်ဖော်မှုနည်းလမ်းဖြစ်ပြီး DLL Hell ပြဿနာကို .NET ခေတ်တွင် သက်သာလာစေခဲ့သည်)"

msgid "mime_com"
msgstr "COM လုပ်ဆောင်နိုင်သောဖိုင် (MS-DOS ခေတ်၏ လုပ်ဆောင်နိုင်သောဖော်မတ်၊ 'Command' ၏ အတိုကောက်။ ဖိုင်ဖွဲ့စည်းပုံရိုးရှင်းပြီး 64KB ကန့်သတ်ချက်ရှိပြီး Windows 3.x မတိုင်မီက အဓိကဖော်မတ်ဖြစ်ခဲ့ကာ ဖယ်ရှားပြီးဖြစ်သည်။ ခေတ်မီ Windows များသည် EXE ဖော်မတ်ကို အသုံးပြုကြပြီး COM extension ကို အချို့သော အစိတ်အပိုင်းဖိုင်များအတွက် ဆက်လက်အသုံးပြုနေဆဲဖြစ်သည်)"

msgid "mime_aac"
msgstr "AAC အသံ (၁၉၉၇ ခုနှစ်တွင် MPEG စံနှုန်း၊ Advanced Audio Coding။ MP3 ၏ ဆက်ခံသူ၊ bit rate တူညီပါက MP3 ထက် အသံအရည်အသွေးပိုမိုကောင်းမွန်ပြီး YouTube, iTunes, Nintendo Switch တို့၏ မူရင်းအသံဖော်မတ်)"

msgid "mime_alac"
msgstr "ALAC အသံ (Apple က ၂၀၀၄ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Apple Lossless Audio Codec။ Apple ၏ lossless ဖော်မတ်၊ ၂၀၁၁ ခုနှစ်တွင် open-source ဖြစ်လာပြီး iTunes နှင့် Apple Music ရှိ lossless အသံအတွက် မူရင်းဖော်မတ်)"

msgid "mime_flac"
msgstr "FLAC အသံ (Xiph.Org Foundation က ၂၀၀၁ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Free Lossless Audio Codec။ lossless compression၊ အသံအရည်အသွေးသည် CD နှင့် တူညီပြီး ဖိုင်အရွယ်အစားမှာ မူရင်း WAV ၏ ထက်ဝက်ခန့်ရှိသည်။ open-source နှင့် မူပိုင်ခွင့်ကင်းပြီး အသံဝါသနာရှင်များနှင့် ဒစ်ဂျစ်တယ်ဂီတစုဆောင်းမှုအတွက် ရွေးချယ်စရာဖော်မတ်ဖြစ်သည်)"

msgid "mime_mp3"
msgstr "MP3 အသံ (Fraunhofer Institute က ၁၉၉၃ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ MPEG-1 Audio Layer 3။ lossy compression ဖော်မတ်၊ ဖိုင်သေးသော်လည်း အသံအရည်အသွေးအတော်အတန်ကောင်းမွန်ပြီး ၂၀၀၀ ပြည့်လွန်နှစ်များ၏ ဒစ်ဂျစ်တယ်ဂီတတော်လှန်ရေး၏ အဓိကဖော်မတ်ဖြစ်ကာ iPod နှင့် Napster ၏ သူရဲကောင်းဖြစ်သည်။ မူပိုင်ခွင့်များ ၂၀၁၇ ခုနှစ်တွင် သက်တမ်းကုန်ဆုံးခဲ့ပြီး အများပိုင် domain ဖော်မတ်ဖြစ်လာသည်)"

msgid "mime_oga"
msgstr "Ogg Audio အသံ (Xiph.Org Foundation က ဖန်တီးခဲ့သည်၊ Ogg container ၏ သီးသန့်အသံဖော်မတ်၊ Vorbis encoding ကို အသုံးပြုသည်။ open-source နှင့် မူပိုင်ခွင့်ကင်းပြီး MP3 ထက် ပိုမိုကောင်းမွန်သော compression စွမ်းဆောင်ရည်ရှိကာ open-source ပရောဂျက်များတွင် ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုသည်)"

msgid "mime_ogg"
msgstr "OGG အသံ (Xiph.Org Foundation က ၂၀၀၀ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Ogg Vorbis ဖော်မတ်။ open-source နှင့် မူပိုင်ခွင့်ကင်းပြီး MP3 ထက် ပိုမိုကောင်းမွန်သော compression စွမ်းဆောင်ရည်ရှိကာ Spotify အစောပိုင်းက အသုံးပြုခဲ့ပြီး ဂိမ်းအသံအကျိုးသက်ရောက်မှုများတွင် ကျယ်ကျယ်ပြန့်ပြန့်အသုံးပြုသည်)"

msgid "mime_opus"
msgstr "Opus အသံ (IETF က ၂၀၁၂ ခုနှစ်တွင် စံသတ်မှတ်ခဲ့သည်၊ open-source နှင့် မူပိုင်ခွင့်ကင်းသော အသံဖော်မတ်၊ SILK နှင့် CELT နည်းပညာများကို ပေါင်းစပ်ထားပြီး latency အလွန်နည်းကာ compression စွမ်းဆောင်ရည် အမြင့်ဆုံးဖြစ်ပြီး WebRTC, WhatsApp, Discord တို့၏ မူရင်းအသံဖော်မတ်ဖြစ်သည်)"

msgid "mime_wav"
msgstr "WAV အသံ (Microsoft နှင့် IBM တို့က ၁၉၉၁ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Windows ၏ ဇာတိအသံဖော်မတ်။ PCM encoding ချုံ့ခြင်းမပြုဘဲ အသံအရည်အသွေးမှာ lossless ဖြစ်သော်လည်း ဖိုင်အလွန်ကြီးမားပြီး ပရော်ဖက်ရှင်နယ်အသံတည်းဖြတ်မှုအတွက် စံဖော်မတ်ဖြစ်သည်)"

msgid "mime_wma"
msgstr "WMA အသံ (Microsoft က ၁၉၉၉ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Windows Media Audio။ lossy/lossless ဗားရှင်းနှစ်မျိုးစလုံးရှိပြီး Windows တွင် ဇာတိပံ့ပိုးမှုရှိကာ Windows Media Player နှင့်အတူ ပျံ့နှံ့လာခဲ့သည်။ ယခုအခါ ဘေးသို့ရောက်သွားပြီး MP3/AAC တို့ဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_dsf"
msgstr "DSF အသံ (Direct Stream Digital ဖော်မတ်၊ Sony နှင့် Philips တို့က ဖန်တီးခဲ့သည်။ 1-bit မြင့်မားသော နမူနာနှုန်း၊ DSD အသံစံဖော်မတ်၊ SACD ၏ ဒစ်ဂျစ်တယ်ဗားရှင်း၊ အသံဝါသနာရှင်များအတွက် high-end အသံဖော်မတ်၊ ဖိုင်အလွန်ကြီးမားသည်)"

msgid "mime_ape"
msgstr "APE အသံ (၂၀၀၀ ခုနှစ်တွင် Monkey's Audio မှ တီထွင်ခဲ့သည်၊ ဆုံးရှုံးမှုမရှိသော ချုံ့သည့်ပုံစံ။ FLAC ထက် ချုံ့မှုပိုများသော်လည်း ကုဒ်သွင်းမှုနှေးကွေးသည်၊ Windows ပလက်ဖောင်းနှင့် အသံဝါသနာရှင်များကြားတွင် ဆက်လက်အသုံးပြုနေဆဲ)"

msgid "mime_mid"
msgstr "MIDI အသံ (MIDI Association က ၁၉၈၃ ခုနှစ်တွင် သတ်မှတ်ခဲ့သည်၊ Musical Instrument Digital Interface။ အသံသွင်းခြင်းမဟုတ်ဘဲ ဂီတမှတ်စုဖော်မတ်၊ ဖိုင်အလွန်သေးငယ်ပြီး အီလက်ထရွန်နစ်ဂီတကိရိယာများ၊ ဖုန်းမြည်သံများ၊ ဂိမ်းအသံအကျိုးသက်ရောက်မှုများအတွက် စံနှုန်းဖြစ်သည်။ General MIDI ကို ၁၉၉၁ ခုနှစ်တွင် စံသတ်မှတ်ခဲ့ပြီး ဂီတကိရိယာအမျိုးအစား ၁၂၈ ခုကို သတ်မှတ်ခဲ့သည်)"

msgid "mime_m4a"
msgstr "M4A အသံ (MPEG-4 Audio, AAC ၏ container ဖော်မတ်။ iTunes Music Store ၏ စံဖော်မတ်၊ Apple ဂေဟစနစ်၏ ပင်မအသံဖော်မတ်၊ DRM ကာကွယ်ရေးကို ပံ့ပိုးသည်)"

msgid "mime_m3u"
msgstr "M3U ဖွင့်စဉ်စာရင်း (MP3 URL ဖွင့်စဉ်စာရင်းဖော်မတ်၊ စာသားဖိုင်အကြမ်းစာ၊ အသံဖိုင်လမ်းကြောင်းများကို မှတ်တမ်းတင်သည်။ Winamp ခေတ်၏ စံနှုန်း၊ အွန်လိုင်းရေဒီယို၊ အွန်လိုင်းဂီတ streaming အတွက် အသုံးပြုသည်။ M3U8 သည် ၎င်း၏ UTF-8 ဗားရှင်းဖြစ်ပြီး HTTP Live Streaming အတွက် အသုံးပြုသည်)"

msgid "mime_asf"
msgstr "ASF streaming မီဒီယာ (Microsoft က ၁၉၉၆ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Advanced Systems Format။ Windows Media streaming container၊ အသံနှင့် ဗီဒီယို တစ်ပြိုင်တည်း ထုတ်လွှင့်မှုကို ပံ့ပိုးသည်။ အွန်လိုင်း live broadcast နှင့် video-on-demand streaming အတွက် အသုံးပြုပြီး WMA/WMV နှစ်ခုစလုံးသည် ASF container ကို အခြေခံထားသည်)"

msgid "mime_avi"
msgstr "AVI ဗီဒီယို (Microsoft က ၁၉၉၂ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ Windows ၏ အစောပိုင်းဗီဒီယိုစံနှုန်း။ 'Audio Video Interleave'၊ အသံနှင့် ဗီဒီယိုကို အလှည့်ကျ သိမ်းဆည်းပြီး ၁၉၉၀-၂၀၀၀ ပြည့်လွန်နှစ်များတွင် လူကြိုက်အများဆုံး ဗီဒီယိုဖော်မတ်ဖြစ်ခဲ့ကာ ယခုအခါ MP4/MKV ဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_divx"
msgstr "DivX ဗီဒီယို (DivX Corporation က ၁၉၉၈ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ MPEG-4 ကိုအခြေခံသော ဗီဒီယို codec ဖော်မတ်။ ၂၀၀၀ ပြည့်လွန်နှစ်များ၏ အွန်လိုင်းဗီဒီယိုမျှဝေခြင်း၏ အဓိကဖော်မတ်ဖြစ်ပြီး DVD အရည်အသွေးကို CD အရွယ်အစားသို့ ချုံ့ပေးနိုင်သော ပထမဆုံးသောနည်းပညာဖြစ်သည်။ မူပိုင်ခွင့်အငြင်းပွားမှုများကြောင့် နောက်ပိုင်းတွင် စီးပွားဖြစ် encoder အဖြစ် ပြောင်းလဲခဲ့သည်)"

msgid "mime_mp4"
msgstr "MP4 ဗီဒီယို (၂၀၀၁ ခုနှစ်တွင် MPEG စံနှုန်း၊ MPEG-4 Part 14။ ကမ္ဘာပေါ်တွင် အသုံးအများဆုံး ဗီဒီယိုဖော်မတ်၊ H.264/H.265 encoding ကို ပံ့ပိုးပြီး အင်တာနက်ဗီဒီယို၊ ဖုန်းရိုက်ကူးချက်၊ YouTube တို့၏ မူရင်းဖော်မတ်ဖြစ်သည်)"

msgid "mime_m4v"
msgstr "M4V ဗီဒီယို (iTunes ၏ ဗီဒီယိုဖော်မတ်၊ MP4 ၏ မူကွဲတစ်ခု။ Apple ဂေဟစနစ်ရှိ ဗီဒီယိုဖော်မတ်၊ iTunes Store ရှိ ရုပ်ရှင်များနှင့် တီဗွီရှိုးများ၏ စံဖော်မတ်ဖြစ်ပြီး DRM မူပိုင်ခွင့်ကာကွယ်ရေးကို ပံ့ပိုးသည်)"

msgid "mime_mpeg"
msgstr "MPEG ဗီဒီယို (MPEG အဖွဲ့အစည်းက ၁၉၈၈ ခုနှစ်တွင် သတ်မှတ်ခဲ့သည်၊ Moving Picture Experts Group။ ဒစ်ဂျစ်တယ်ဗီဒီယိုချုံ့ခြင်း စံနှုန်းများ၏ အုတ်မြစ်ချသူဖြစ်ပြီး MPEG-1 (VCD)၊ MPEG-2 (DVD)၊ MPEG-4 (အွန်လိုင်းဗီဒီယို) တို့သည် နက်ရှိုင်းစွာ လွှမ်းမိုးမှုရှိခဲ့သည်)"

msgid "mime_mkv"
msgstr "MKV ဗီဒီယို (Matroska ပရောဂျက်က ၂၀၀၂ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ open-source မာလ်တီမီဒီယာ container ဖော်မတ်။ အသံအပိုင်းများစွာ၊ စာတန်းထိုးများစွာ၊ အခန်းကြီးများကို ပံ့ပိုးပြီး 'ထုပ်ပိုးသည့်ကိရိယာ' ဟုခေါ်ကာ ရုပ်ရှင်အရည်အသွေးမြင့် မျှဝေခြင်းအတွက် ရွေးချယ်စရာဖော်မတ်ဖြစ်သည်)"

msgid "mime_mpg"
msgstr "MPEG ဗီဒီယို (MPEG-1/MPEG-2 ဗီဒီယို extension, VCD နှင့် DVD အတွက် စံဖော်မတ်။ ၁၉၉၀-၂၀၀၀ ပြည့်လွန်နှစ်များအတွင်း disk ပေါ်ရှိ ဗီဒီယိုအတွက် အဓိကဖော်မတ်ဖြစ်ခဲ့ပြီး ယခုအခါ H.264/H.265 ဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_ogv"
msgstr "Ogg Video ဗီဒီယို (Xiph.Org Foundation က ဖန်တီးခဲ့သည်၊ Ogg container ၏ ဗီဒီယိုဖော်မတ်၊ Theora encoding ကို အသုံးပြုသည်။ open-source နှင့် မူပိုင်ခွင့်ကင်းပြီး HTML5 ဗီဒီယို၏ အစောပိုင်းစံနှုန်းများထဲမှတစ်ခုဖြစ်ကာ Firefox က ဇာတိပံ့ပိုးမှုရှိသည်)"

msgid "mime_ogx"
msgstr "Ogg မာလ်တီမီဒီယာ container (Xiph.Org Foundation က ဖန်တီးခဲ့သည်၊ Ogg container ၏ အထွေထွေ extension၊ အသံ၊ ဗီဒီယို၊ စာတန်းထိုးစသည့် အပိုင်းများစွာ ပါဝင်နိုင်သည်။ open-source မာလ်တီမီဒီယာစံနှုန်း၊ ဂိမ်းများ၊ streaming များအတွက် အသုံးပြုသည်)"

msgid "mime_rm"
msgstr "RealMedia ဗီဒီယို (RealNetworks က ၁၉၉၅ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ RealMedia ဖော်မတ်။ ၁၉၉၀-၂၀၀၀ ပြည့်လွန်နှစ်များအတွင်း အွန်လိုင်း streaming ၏ ရှေ့ဆောင်ဖြစ်ပြီး RealPlayer ၏ အဓိကဖော်မတ်ဖြစ်သည်။ အားနည်းချက်များ- သီးသန့် player လိုအပ်မှု၊ ချုံ့အရည်အသွေးညံ့ဖျင်းမှု၊ နောက်ပိုင်းတွင် Flash/MP4 ဖြင့် အစားထိုးခဲ့သည်)"

msgid "mime_flv"
msgstr "Flash ဗီဒီယို (၂၀၀၂ ခုနှစ်တွင် ဖော်မတ်စတင်ပေါ်ပေါက်ခဲ့သည်၊ Flash Video ဖော်မတ်။ တစ်ချိန်က အွန်လိုင်းဗီဒီယို၏ အဓိကဖော်မတ်ဖြစ်ခဲ့ပြီး YouTube အစောပိုင်းက အသုံးပြုခဲ့သည်။ အားနည်းချက်များ- Flash plugin လိုအပ်မှု၊ စွမ်းဆောင်ရည်ညံ့ဖျင်းမှု၊ လုံခြုံရေးအားနည်းချက်များစွာ။ ၂၀၁၅ ခုနှစ်မှစ၍ အဓိကဝဘ်ဆိုက်များသည် HTML5 ဗီဒီယိုသို့ ပြောင်းလဲခဲ့ပြီး ယခုအခါ ဖယ်ရှားပြီးဖြစ်သည်)"

msgid "mime_f4v"
msgstr "F4V ဗီဒီယို (Adobe မှ ဖန်တီးထားသော Flash ဗီဒီယိုဖော်မတ်၊ FLV ၏ ဆက်ခံသူ။ MPEG-4 စံနှုန်းကို အခြေခံပြီး H.264 encoding ကို ပံ့ပိုးသည်။ Flash နည်းပညာနှင့်အတူ ဖယ်ရှားခဲ့ပြီး Adobe က ၂၀၂၀ ခုနှစ်တွင် ပံ့ပိုးမှုရပ်ဆိုင်းခဲ့သည်)"

msgid "mime_wmv"
msgstr "WMV ဗီဒီယို (Microsoft က ၁၉၉၉ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ Windows Media Video။ Windows တွင် ဇာတိပံ့ပိုးမှုရှိပြီး streaming transmission အတွက် အကောင်းဆုံးဖြစ်အောင် ပြုလုပ်ထားကာ အစောပိုင်းအွန်လိုင်းဗီဒီယိုများတွင် အသုံးများသောဖော်မတ်ဖြစ်ခဲ့သော်လည်း ယခုအခါ ဘေးသို့ရောက်သွားပြီဖြစ်သည်)"

msgid "mime_wmf"
msgstr "WMF မီဒီယာဖော်မတ် (Windows Media Format, Microsoft ၏ မီဒီယာဘောင်၊ WMV ဗီဒီယို၊ WMA အသံတို့ကို ခြုံငုံပြီး Windows Media Player က ဇာတိပံ့ပိုးမှုရှိသည်)"

msgid "mime_mov"
msgstr "MOV ဗီဒီယို (Apple က ၁၉၉၁ ခုနှစ်တွင် ဖန်တီးခဲ့သည်၊ QuickTime container ဖော်မတ်။ ပရော်ဖက်ရှင်နယ် ဗီဒီယိုတည်းဖြတ်ခြင်းအတွက် စံဖော်မတ်ဖြစ်ပြီး codec အမျိုးမျိုးကို ပံ့ပိုးကာ Final Cut Pro, Premiere တို့က ဇာတိပံ့ပိုးမှုရှိသည်)"

msgid "mime_qt"
msgstr "QuickTime ဗီဒီယို (Apple က ၁၉၉၁ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ QuickTime ဖော်မတ်။ Mac ပလက်ဖောင်းပေါ်ရှိ ဗီဒီယိုစံနှုန်း၊ MOV သည် ၎င်း၏ container ဖြစ်ပြီး QuickTime player ကို ကျယ်ကျယ်ပြန့်ပြန့် အသုံးပြုခဲ့ကြသည်။ Apple က ၂၀၁၆ ခုနှစ်တွင် Windows ဗားရှင်း ဖွံ့ဖြိုးရေးကို ရပ်ဆိုင်းခဲ့ပြီး MP4 ဖြင့် တဖြည်းဖြည်း အစားထိုးခဲ့သည်)"

msgid "mime_webm"
msgstr "WebM ဗီဒီယို (Google က ၂၀၁၀ ခုနှစ်တွင် မိတ်ဆက်ခဲ့သည်၊ open-source နှင့် မူပိုင်ခွင့်ကင်းသော ဗီဒီယိုဖော်မတ်။ Matroska container ကို အခြေခံပြီး VP8/VP9 encoding၊ HTML5 ဗီဒီယို၏ စံဖော်မတ်၊ YouTube ၏ web ပေါ်ရှိ မူရင်းဖွင့်စဉ်ဖော်မတ်ဖြစ်သည်)"

msgid "mime_3gp"
msgstr "3GP ဗီဒီယို (3GPP က ၂၀၀၀ ခုနှစ်တွင် သတ်မှတ်ခဲ့သည်၊ မိုဘိုင်းစက်ပစ္စည်းများအတွက် ဗီဒီယိုဖော်မတ်။ ဖိုင်အလွန်သေးငယ်ပြီး အရည်အသွေးနိမ့်ကာ အစောပိုင်း အခြေခံဖုန်းများ၏ ဗီဒီယိုရိုက်ကူးမှုဖော်မတ်ဖြစ်ပြီး MMS ပေးပို့ရန်အတွက် အသုံးပြုခဲ့သည်)"

