#------------------------------------------------------------------------------
# Penerangan Format
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Fail teks (Distandardkan ASCII pada 1963, teks kosong tidak berformat. Asas semua kod sumber, konfigurasi dan log. Unix menggunakan LF, Windows menggunakan CRLF untuk baris baharu, masih format data paling universal dalam komputer)"

msgid "mime_log"
msgstr "Fail log (fail teks kosong yang merekod maklumat operasi sistem dan aplikasi, sering digunakan untuk penyelesaian masalah, analisis prestasi, audit keselamatan. Format standard seperti Apache combined log, Nginx access log, syslog dll.)"

msgid "mime_page"
msgstr "Halaman HTML (Tim Berners-Lee mencipta WWW pada 1989, mentakrifkan tiga teknologi HTML/HTTP/URL pada 1990, membukanya secara percuma tanpa paten. Pada 2014 HTML5 menjadi standard rasmi W3C, menyokong paparan, multimedia dan pencetakan. Menerima Anugerah Turing pada 2016)"

msgid "mime_khtml"
msgstr "Enjin halaman web KHTML (KDE 2.0 dikeluarkan pada 1998, enjin persembahan pelayar Konqueror. Pada 2001 Apple mencipta WebKit berdasarkan KHTML, pada 2008 Google mencipta Blink daripada WebKit, yang menjadi teras pelayar Chrome, Edge, Safari dan lain-lain. KHTML adalah contoh bagaimana komuniti sumber terbuka meletakkan asas untuk enjin pelayar moden, warisan teknologinya diteruskan melalui WebKit/Blink)"

msgid "mime_script"
msgstr "Skrip dinamik (bahasa tafsiran, tidak memerlukan kompilasi. Termasuk ASP, JSP, CGI, ColdFusion, Tcl, VBScript dll., digunakan secara meluas dalam pembangunan web awal, pentadbiran sistem, automasi tugas. Bahasa skrip moden seperti Python, Ruby, JavaScript telah berkembang menjadi alat utama pembangunan full-stack)"

msgid "mime_js"
msgstr "Skrip JavaScript (Brendan Eich menciptanya dalam 10 hari di Netscape pada 1995, bahasa pengaturcaraan asli pelayar. Pada 1997 ECMAScript distandardkan, pada 2009 Node.js lahir menjadikannya bahasa full-stack, npm adalah pengurus pakej terbesar di dunia. Bertahun-tahun menjadi bahasa pengaturcaraan paling popular di GitHub)"

msgid "mime_py"
msgstr "Skrip Python (dicipta oleh Guido van Rossum pada 1991, terkenal dengan lekukan paksa dan sintaks yang bersih. Digunakan secara meluas dalam pembangunan web, sains data, kecerdasan buatan, operasi automatik. Pemenang pelbagai kali Bahasa Pengaturcaraan Tahunan TIOBE)"

msgid "mime_sh"
msgstr "Skrip Shell (Unix lahir pada 1971, bahasa skrip arahan. Digunakan untuk pentadbiran sistem, automasi tugas, memulakan perkhidmatan, skrip penggunaan. Kemahiran wajib untuk pentadbir Linux)"

msgid "mime_rb"
msgstr "Skrip Ruby (dicipta oleh Yukihiro Matsumoto pada 1995, menekankan kebahagiaan pengaturcara. Rangka kerja Ruby on Rails membuka paradigma pembangunan konvensyen berbanding konfigurasi, mempengaruhi reka bentuk rangka kerja web moden)"

msgid "mime_pl"
msgstr "Skrip Perl (dicipta oleh Larry Wall pada 1987, terkenal dengan kepraktisan, digelar 'pisau tentera Swiss'. CPAN adalah perintis pengurus pakej bahasa moden, mempunyai pengaruh mendalam dalam pemprosesan teks, pentadbiran sistem, bidang CGI)"

msgid "mime_php"
msgstr "Halaman dinamik PHP (dicipta oleh Rasmus Lerdorf pada 1995, direka khusus untuk pembangunan web. Lebih 70% laman web di dunia menggunakannya, memacu platform seperti WordPress, Facebook, Wikipedia. PHP 8 memperkenalkan kompilasi JIT, peningkatan prestasi yang ketara)"

msgid "mime_image"
msgstr "Fail imej"

msgid "mime_document"
msgstr "Fail dokumen"

msgid "mime_package"
msgstr "Pakej perisian"

msgid "mime_archive"
msgstr "Fail termampat Gzip (projek GNU 1992, berdasarkan algoritma DEFLATE. Di web digunakan untuk mampatan dinamik kandungan respons, kadar mampatan biasanya 60-90%. Selepas 2015 digantikan oleh Brotli dalam beberapa senario, tetapi masih format mampatan paling disokong di sebelah pelayan)"

msgid "mime_audio"
msgstr "Fail audio"

msgid "mime_video"
msgstr "Fail video"

msgid "mime_jscript"
msgstr "JavaScript (dibangunkan oleh Brendan Eich pada 1995)"

msgid "mime_json"
msgstr "Data JSON (dicadangkan oleh Douglas Crockford pada 2001, format pertukaran data ringan, standard de facto untuk API Web)"

msgid "mime_vbs"
msgstr "VBScript (dibangunkan oleh Microsoft pada 1996, bahasa skrip Windows, digunakan untuk halaman ASP dan skrip pentadbiran Windows. Dengan penyebaran PowerShell dan JavaScript, secara beransur-ansur dihapuskan)"

msgid "mime_conf"
msgstr "Fail konfigurasi (format teks untuk menyimpan konfigurasi perisian, format biasa: INI, JSON, YAML, TOML, XML. Konfigurasi sistem Linux kebanyakannya dalam direktori /etc)"

msgid "mime_css"
msgstr "Lembaran gaya CSS (W3C mengeluarkan CSS1 sebagai standard rasmi pertama pada Disember 1996, CSS2 menambah kedudukan dan jenis media pada 1998, mulai 2011 CSS3 secara modular memperkenalkan sudut bulat, animasi, kotak fleksibel, susun atur grid dan reka bentuk responsif. Bersama HTML dan JavaScript adalah tiga teknologi teras frontend, semua pelayar moden (Chrome, Firefox, Safari, Edge) menyokongnya secara asli, satu-satunya standard untuk definisi gaya web)"

msgid "mime_xsl"
msgstr "Lembaran gaya XSL (standard W3C 1999, bahasa transformasi dokumen XML, boleh menukar XML kepada HTML/PDF/teks. Selepas JSON meluas, penggunaannya berkurang)"

msgid "mime_runtime"
msgstr "Fail boleh laku (format boleh laku sistem pengendalian seperti EXE, ELF, Mach-O, mengandungi kod mesin dan maklumat pemuatan)"

msgid "mime_library"
msgstr "Fail pustaka (DLL, SO, dylib dan pustaka pautan dinamik lain, kod yang dimuatkan semasa pelaksanaan program)"

msgid "mime_swf"
msgstr "Animasi Flash (dibangunkan oleh Macromedia pada 1996, kemudian diserahkan kepada Adobe. Standard animasi web interaktif, pernah menguasai animasi dan permainan internet. Kelemahan: bergantung pada plugin, tiada sokongan mudah alih, risiko keselamatan tinggi. Pada 2017 Adobe mengumumkan pemansuhan, sokongan dihentikan sepenuhnya pada 2020, digantikan oleh HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "Definisi Jenis Dokumen DTD (spesifikasi XML, mentakrifkan struktur dokumen XML, digunakan untuk mengesahkan kesahan XML)"

msgid "mime_csv"
msgstr "Format data CSV (nilai dipisah koma, format universal untuk data jadual, standard import/eksport Excel dan pangkalan data)"

msgid "mime_jnlp"
msgstr "Java Web Start (pelancar aplikasi Java, teknologi pengedaran aplikasi desktop Java tahun 2000-an, kini dihapuskan)"

msgid "mime_lit"
msgstr "E-book Microsoft Reader (dilancarkan oleh Microsoft pada 2000, format LIT, dihapuskan)"

msgid "mime_svg"
msgstr "Grafik vektor SVG (standard W3C 1999, kerana Microsoft lama mempromosikan format VML sendiri, pelayar IE hanya menyokong pada 2011, menyebabkan kelewatan penyebaran. Selepas 2015 dengan penghapusan IE dan penyebaran skrin HD, menjadi format pilihan untuk ikon dan logo)"

msgid "mime_ai"
msgstr "Grafik vektor Adobe Illustrator (dilancarkan pada 1987, format grafik vektor standard industri, pilihan utama untuk reka bentuk percetakan, logo, ikon)"

msgid "mime_phshop"
msgstr "Imej Photoshop (dilancarkan oleh Adobe pada 1990, format fail sumber Photoshop PSD, standard industri pemprosesan imej)"

msgid "mime_ttf"
msgstr "Fon TrueType (dibangunkan bersama oleh Apple dan Microsoft pada 1989, format fon vektor, paparan skrin dan cetakan konsisten, format fon lalai sistem pengendalian moden)"

msgid "mime_fon"
msgstr "Fon web WOFF2 (Cadangan W3C 2014, menggunakan algoritma mampatan Brotli, berbanding WOFF lama saiz berkurangan kira-kira 30%, berbanding TTF/OTF berkurangan lebih 50%, semua pelayar moden menyokongnya, format pilihan untuk fon web moden, disokong oleh lebih 98% pelayar)"

msgid "mime_pdf"
msgstr "Dokumen PDF (dibangunkan oleh Adobe pada 1993, menjadi standard antarabangsa ISO pada 2008. Format dokumen rentas platform, mengekalkan konsistensi format, standard global untuk pengedaran dokumen elektronik)"

msgid "mime_dotnet"
msgstr "Halaman dinamik ASP.NET (dilancarkan oleh Microsoft pada 2002, teknologi web dinamik untuk platform Windows, sebahagian daripada .NET Framework)"

msgid "mime_mdb"
msgstr "Pangkalan data Access (fail pangkalan data Microsoft Access, dilancarkan pada 1992, penyelesaian pangkalan data desktop Windows)"

msgid "mime_md"
msgstr "Dokumen Markdown (dicipta oleh John Gruber pada 2004, reka bentuk sintaks dipengaruhi oleh reStructuredText dan Setext. Falsafah reka bentuk teras ialah 'kebolehbacaan adalah persembahan', implementasi asal Markdown.pl ditulis dalam Perl dan melaksanakan transformasi teks berdasarkan ungkapan biasa. Spesifikasi terbitan termasuk GFM (2013), CommonMark (2017), Pandoc Markdown dll. Memacu ekosistem seperti GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, menjadi format standard de facto untuk penjana laman web statik dan dokumentasi pembangun)"

msgid "mime_crystal"
msgstr "Format laporan Crystal Reports (laporan risikan perniagaan SAP, format laporan korporat standard)"

msgid "mime_libreoffice"
msgstr "Dokumen LibreOffice (dibangunkan oleh The Document Foundation pada 2010, cabang OpenOffice, implementasi standard ODF, pakej pejabat sumber terbuka utama)"

msgid "mime_encrypt"
msgstr "Fail disulitkan (fail yang perlu dinyahsulit untuk dilihat, sambungan biasa: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Data trek GPS (format pertukaran GPS, merekod maklumat lokasi geografi, format universal untuk jam tangan sukan dan peranti navigasi)"

msgid "mime_diskimage"
msgstr "Imej cakera (DMG, ISO, IMG dan fail imej cakera optik/cakera lain, digunakan untuk pengedaran perisian atau sandaran media storan)"

msgid "mime_vm"
msgstr "Imej mesin maya (VMDK, VDI, VHDX, OVA dan fail cakera maya lain, format platform virtualisasi seperti VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "Fail torrent BitTorrent (dicipta oleh Bram Cohen pada 2001, fail indeks muat turun P2P, mengandungi metadata fail dan maklumat Tracker)"

msgid "mime_gis"
msgstr "Data Sistem Maklumat Geografi GIS (Shapefile, GeoJSON dan format data geospatial lain, digunakan untuk peta dan analisis spatial)"

msgid "mime_ebook"
msgstr "E-book (EPUB, MOBI, AZW dan format e-book lain. EPUB adalah standard antarabangsa, MOBI/AZW adalah format Amazon Kindle)"

msgid "mime_avif"
msgstr "Imej AVIF (dilancarkan oleh Alliance for Open Media pada 2019, berdasarkan pengekodan AV1, kadar mampatan 50% lebih baik daripada WebP, standard imej web generasi baharu)"

msgid "mime_markdown"
msgstr "Dokumen Markdown (direka oleh John Gruber pada 2004, bahasa penanda ringan, format universal untuk README GitHub, dokumentasi teknikal, siaran forum)"

msgid "mime_yaml"
msgstr "Konfigurasi YAML (direka oleh Clark Evans pada 2001, format siri data boleh dibaca manusia, format fail konfigurasi standard untuk Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Konfigurasi TOML (direka oleh Tom Preston-Werner pada 2013, 'Tom's Obvious Minimal Language', format fail konfigurasi untuk alat moden seperti Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Fail komponen Vue (diperkenalkan pada tahun 2014 oleh Evan You, rangka kerja JavaScript progresif. Melalui komponen fail tunggal (SFC), ia menggabungkan HTML, CSS dan JS dengan sempurna, meningkatkan kecekapan pembangunan dengan ketara. Ia adalah salah satu rangka kerja frontend paling popular di dunia. Juga sebagai teras penjana laman statik moden seperti VitePress, ia digunakan secara meluas untuk memacu dokumentasi teknikal interaktif dan blog.)"

msgid "mime_wasm"
msgstr "Modul WebAssembly (standard W3C 2017, format pelaksanaan prestasi tinggi dalam pelayar, C/C++/Rust/R boleh kompil ke sasaran, prestasi hampir asli)"

msgid "mime_jsx"
msgstr "Komponen React JSX (Facebook memperkenalkan JavaScript XML pada 2013, sintaks komponen rangka kerja React, paradigma inovatif untuk menulis HTML dalam JavaScript)"

msgid "mime_tsx"
msgstr "Komponen TypeScript TSX (dibangunkan oleh Microsoft pada 2012, TypeScript + JSX, cara penulisan standard untuk pembangunan React dengan keselamatan jenis)"

msgid "mime_heif"
msgstr "Imej HEIF (standard MPEG 2015, format fail imej cekap, digunakan secara meluas dalam ekosistem Apple)"

msgid "mime_heic"
msgstr "Imej HEIC (implementasi HEIF Apple, format foto lalai iPhone, disokong secara asli pada iOS/macOS)"

msgid "mime_gltf"
msgstr "Model 3D GLTF (format pemindahan GL, 'JPEG untuk dunia 3D', dikeluarkan oleh Khronos Group pada 2015, format standard untuk web 3D)"

msgid "mime_glb"
msgstr "Model 3D binari GLB (versi binari GLTF, satu fail mengandungi semua sumber, digunakan untuk pengedaran adegan 3D)"

msgid "mime_gls"
msgstr "Glosari GLOSSARY (fail definisi istilah, digunakan untuk pengurusan terminologi dalam sistem dokumentasi)"

msgid "mime_cbz"
msgstr "Buku komik CBZ (imej komik termampat ZIP, format universal untuk koleksi komik)"

msgid "mime_cbr"
msgstr "Buku komik CBR (imej komik termampat RAR, format universal untuk koleksi komik)"

msgid "mime_fb2"
msgstr "E-book FB2 (FictionBook 2.0, format e-book Rusia, struktur XML, disokong secara meluas oleh pembaca sumber terbuka)"

msgid "mime_kepub"
msgstr "E-book KEPUB (format EPUB khusus Kobo, format dioptimumkan untuk pembaca e-book Kobo)"

msgid "mime_m4b"
msgstr "Buku audio M4B (format buku audio MPEG-4, menyokong penanda halaman, format buku audio iTunes)"

msgid "mime_kfx"
msgstr "Format Kindle KFX (dilancarkan oleh Amazon pada 2015, format khusus untuk e-book Kindle, menyokong tipografi dipertingkat dan gelinciran pantas)"

msgid "mime_chm"
msgstr "Fail bantuan CHM (dilancarkan oleh Microsoft pada 1997, format bantuan HTML terkompil, standard untuk dokumentasi bantuan perisian Windows)"

msgid "mime_mht"
msgstr "Arkib web MHT (dilancarkan oleh Microsoft pada 1999, format web fail tunggal, format penyimpanan halaman web pelayar IE)"

msgid "mime_wml"
msgstr "Bahasa penanda wayarles WML (standard WAP 1999, digunakan untuk fail halaman web telefon bimbit awal, dihapuskan)"

msgid "mime_xhtml"
msgstr "Halaman web XHTML (standard W3C 2000, versi XML HTML, sintaks lebih ketat. Pada 2009 W3C menghentikan penyelenggaraan, tumpuan beralih kepada HTML5)"

msgid "mime_xml"
msgstr "Dokumen XML (standard W3C 1998, bahasa penanda boleh dikembangkan, format asas untuk perkhidmatan web, fail konfigurasi, pertukaran data)"

msgid "mime_sgml"
msgstr "Dokumen SGML (standard ISO 1986, pendahulu HTML, bahasa penanda umum standard, kedua-dua XML dan HTML berasal daripada SGML)"

msgid "mime_apng"
msgstr "Animasi APNG (dibangunkan oleh Mozilla pada 2004, sambungan animasi PNG, pengganti moden untuk GIF, menyokong warna sebenar dan ketelusan)"

msgid "mime_bmp"
msgstr "Bitmap BMP (format bitmap Windows, disokong secara asli sejak Windows 1.0. Tidak termampat, saiz fail besar, tetapi disebabkan strukturnya yang mudah dan tidak memerlukan codec tambahan, ia masih digunakan dalam Alat Pemotong Windows 11, program Paint, sumber ikon dalam pakej pemasangan EXE/MSI, fail kursor, dan beberapa pemandu lama. Pada kualiti imej yang sama, saiz fail adalah kira-kira 3-10 kali lebih besar daripada PNG. Dalam kebanyakan kes ia telah digantikan oleh PNG/JPEG, tetapi ekosistem Windows masih mengekalkan keserasian yang luas)"

msgid "mime_cdr"
msgstr "Grafik vektor CDR (format khusus CorelDRAW, syarikat Corel Kanada, perisian reka bentuk grafik vektor)"

msgid "mime_gif"
msgstr "Imej GIF (dibangunkan oleh CompuServe pada 1987, format imej animasi 256 warna. Kelemahan: warna sedikit, kualiti imej kasar, tidak menyokong ketelusan, fail besar, kadar bingkai rendah. Digantikan oleh format imej animasi moden seperti APNG, WebP)"

msgid "mime_ico"
msgstr "Ikon ICO (format fail ikon Windows, menyokong pelbagai resolusi, format standard untuk favicon laman web)"

msgid "mime_jpeg"
msgstr "Imej JPEG (standard ISO 1992, format foto mampatan lossy, standard de facto untuk foto internet)"

msgid "mime_jpg"
msgstr "Imej JPEG (standard ISO 1992, format foto mampatan lossy, standard de facto untuk foto internet)"

msgid "mime_png"
msgstr "Imej PNG (cadangan W3C 1996, menyokong warna sebenar dan ketelusan, pengganti statik untuk GIF, standard imej lossless internet)"

msgid "mime_ps"
msgstr "Fail penerangan halaman PostScript (dilancarkan oleh Adobe pada 1985, bahasa penerangan halaman, pendahulu PDF, digunakan untuk percetakan dan penerbitan)"

msgid "mime_psb"
msgstr "Dokumen besar PSB (format imej besar Adobe Photoshop, menyokong imej gergasi melebihi 2GB atau 30000 piksel)"

msgid "mime_psd"
msgstr "Imej PSD (fail sumber Adobe Photoshop, menyokong lapisan, saluran, laluan, format standard industri pemprosesan imej)"

msgid "mime_webp"
msgstr "Imej WebP (dibangunkan oleh Google pada 2010, format imej web, menyokong mampatan lossy/lossless dan animasi, kadar mampatan 25-35% lebih baik daripada PNG, 25% lebih baik daripada JPEG)"

msgid "mime_woff"
msgstr "Fon web WOFF (dicipta pada 2009, standard W3C 2018. Mampatan berdasarkan TrueType/OpenType, pengoptimuman pemuatan fon web, format standard fon ikon laman web moden)"

msgid "mime_7z"
msgstr "Pakej termampat 7z (dibangunkan oleh Igor Pavlov pada 1999, format khusus program 7-Zip. Algoritma LZMA, mampatan tinggi, sumber terbuka dan percuma. Format 7z pada kadar mampatan yang sama biasanya 30-50% lebih kecil daripada ZIP, format biasa untuk komuniti sumber terbuka dan pengedaran perisian)"

msgid "mime_ace"
msgstr "Pakej termampat ACE (dibangunkan pada 1990-an, format program WinACE. Pernah bersaing dengan RAR, kadar mampatan agak tinggi. Pembangunan dihentikan pada 2007, kini digantikan oleh 7z/RAR, jarang digunakan)"

msgid "mime_bz2"
msgstr "Pakej termampat BZIP2 (dibangunkan oleh Julian Seward pada 1996, algoritma mampatan penyisihan blok. Kadar mampatan 15-20% lebih baik daripada GZIP, tetapi lebih perlahan. Kod sumber kernel Linux, pakej sumber terbuka biasa menggunakan format ini, sambungan .bz2)"

msgid "mime_cab"
msgstr "Pakej termampat CAB (dibangunkan oleh Microsoft pada 1995, format Kabinet. Format pakej pemasangan sistem Windows, digunakan untuk pemandu, pengedaran fail sistem. Windows Installer (MSI) secara dalaman menggunakan CAB untuk menyimpan fail)"

msgid "mime_dmg"
msgstr "Imej cakera DMG (dilancarkan oleh Apple pada 1980-an, format Imej Cakera. Format standard pengedaran perisian macOS, klik dua kali dipasang sebagai cakera maya, seret dan lepas untuk memasang aplikasi. Menyokong mampatan dan penyulitan, format utama untuk muat turun perisian Mac)"

msgid "mime_emz"
msgstr "Imej termampat EMZ (metafail dipertingkat termampat Windows, versi termampat EMF. Format storan grafik vektor dalam dokumen Office, pada dasarnya adalah fail EMF termampat GZIP)"

msgid "mime_gz"
msgstr "Pakej termampat GZIP (dibangunkan oleh Jean-loup Gailly dan Mark Adler pada 1992, projek GNU. Alat mampatan standard Unix/Linux, format biasa untuk mampatan penghantaran HTTP. Sambungan .gz, sering digunakan bersama dengan TAR)"

msgid "mime_jar"
msgstr "Pakej termampat JAR (dilancarkan oleh Sun Microsystems pada 1997, format Java ARchive. Pada dasarnya adalah pakej termampat ZIP, digunakan untuk membungkus pustaka kelas Java dan aplikasi. Format teras dalam ekosistem Java seperti Maven, Gradle, Android juga menggunakan JAR)"

msgid "mime_lzma"
msgstr "Pakej termampat LZMA (dibangunkan oleh Igor Pavlov pada 1998, algoritma rantaian Lempel-Ziv-Markov. Algoritma mampatan teras format 7z, mampatan tinggi, nyahmampatan pantas. Digunakan untuk firmware, pengedaran perisian sistem terbenam)"

msgid "mime_rar"
msgstr "Pakej termampat RAR (dibangunkan oleh Eugene Roshal pada 1993, format Roshal ARchive. Mampatan tinggi, menyokong pembahagian volum, rekod pemulihan. Format program WinRAR, mampatan lebih baik daripada ZIP, tetapi memerlukan perisian berbayar, alat sumber terbuka seperti unrar boleh menyahmampat)"

msgid "mime_tar"
msgstr "Arkib TAR (diperkenalkan dalam Unix V7 pada 1979, format Tape ARchive. Format arkib pita, tidak memampat hanya membungkus, sering digunakan bersama dengan GZIP/BZIP2/XZ. Kod sumber pakej Linux, storan lapisan imej Docker menggunakan format TAR)"

msgid "mime_tgz"
msgstr "Pakej termampat TGZ (format gabungan TAR + GZIP, sambungan .tgz atau .tar.gz. Format pengedaran paling universal untuk pakej Unix/Linux, digunakan secara meluas untuk pakej kod sumber, pakej binari, wakil 'nyahmampat dan guna')"

msgid "mime_tbz2"
msgstr "Pakej termampat TBZ2 (format gabungan TAR + BZIP2, sambungan .tbz2 atau .tar.bz2. Kadar mampatan 15-20% lebih baik daripada TGZ, sesuai untuk pengedaran fail besar, kod sumber kernel Linux telah lama menggunakan format ini)"

msgid "mime_xz"
msgstr "Pakej termampat XZ (dilancarkan pada 2009, berdasarkan algoritma LZMA2. Mampatan sangat tinggi, 30-50% lebih baik daripada GZIP, nyahmampatan agak pantas. Digunakan secara meluas dalam kernel Linux, pengurus pakej (seperti dalaman .deb Debian), format yang disyorkan untuk ekosistem Linux semasa)"

msgid "mime_z"
msgstr "Pakej termampat Z (format arahan compress Unix 1985, algoritma LZW. Format mampatan Unix awal, digantikan oleh GZIP. Sambungan .Z, jarang digunakan pada sistem moden)"

msgid "mime_zip"
msgstr "Pakej termampat ZIP (dibangunkan oleh Phil Katz pada 1989, format PKZIP. Disokong secara asli oleh Windows, format mampatan paling universal di internet. Menyokong berbilang fail, struktur direktori, boleh memilih algoritma mampatan. JAR Java, APK Android, dokumen Office DOCX/XLSX semuanya berdasarkan format ZIP)"

msgid "mime_zst"
msgstr "Pakej termampat Zstandard (dibangunkan oleh Facebook pada 2015, direka oleh Yann Collet. Algoritma mampatan berkelajuan tinggi, kadar mampatan hampir dengan LZMA, kelajuan jauh melebihi GZIP. Kernel Linux 5.9+ menyokong, Arch Linux pacman, Debian APT semakin menerima pakai, standard mampatan generasi baharu)"

msgid "mime_lz4"
msgstr "Pakej termampat LZ4 (dibangunkan oleh Yann Collet pada 2011, algoritma mampatan sangat pantas. Kelajuan mampatan lebih 10 kali lebih pantas daripada GZIP, sesuai untuk senario mampatan masa nyata. Kernel Linux, OpenZFS, Hadoop digunakan secara meluas, pilihan pertama untuk senario yang mengutamakan kelajuan)"

msgid "mime_lzo"
msgstr "Pakej termampat LZO (dibangunkan oleh Markus Oberhumer pada 1996, algoritma Lempel-Ziv-Oberhumer. Kelajuan nyahmampatan sangat pantas, kadar mampatan sederhana. Kernel Linux Squashfs, firmware OpenWrt menggunakannya, sesuai untuk sistem terbenam)"

msgid "mime_msi"
msgstr "Pakej pemasangan MSI (dilancarkan oleh Microsoft pada 1999, format pakej Windows Installer. Format pemasangan standard untuk aplikasi Windows, menyokong pemulangan transaksi, pengurusan komponen, pemasangan senyap. Format pilihan untuk pengedaran perisian peringkat perusahaan, masih menjadi arus perdana untuk pemasangan perisian Windows sehingga kini)"

msgid "mime_pkg"
msgstr "Pakej pemasangan PKG (format pakej pemasangan aplikasi macOS, berdasarkan teknologi Installer Apple. Format standard pengedaran perisian macOS, menyokong pemilihan komponen, skrip pemasangan, fungsi nyahpasang. Klik dua kali fail .pkg untuk memasang, kaedah pengedaran biasa untuk perisian di luar Mac App Store)"

msgid "mime_apk"
msgstr "Pakej aplikasi Android APK (dilancarkan oleh Google pada 2008, format pemasangan aplikasi tradisional untuk sistem Android. APK pada dasarnya adalah pakej ZIP, mengandungi kod, sumber, fail manifes. Mulai 2021 Google Play memerlukan aplikasi baharu menggunakan format AAB, tetapi APK masih digunakan untuk pembangunan dan penyahpepijatan, kedai pihak ketiga dan pemasangan sisi)"

msgid "mime_ipa"
msgstr "Pakej aplikasi iOS IPA (Pakej App Store iOS, format pemasangan untuk aplikasi iOS/iPadOS. Dilancarkan pada 2008 bersama iPhone SDK. Mesti diedarkan melalui App Store atau ditandatangani dengan sijil perusahaan. Mengandungi fail boleh laku, sumber, Info.plist dan maklumat tandatangan)"

msgid "mime_hap"
msgstr "Pakej aplikasi HarmonyOS HAP (Pakej Keupayaan HarmonyOS, unit asas aplikasi HarmonyOS. Dilancarkan pada 2020 bersama HarmonyOS 2.0. Menyokong dua jenis: entry dan feature, format pengedaran untuk telefon Huawei, tablet, jam pintar dan peranti HarmonyOS lain)"

msgid "mime_har"
msgstr "Pustaka kongsi statik HarmonyOS HAR (Arkib HarmonyOS, pustaka kongsi statik HarmonyOS, boleh dikongsi oleh berbilang pakej HAP, digunakan untuk pembangunan berasaskan komponen dan penggunaan semula modul)"

msgid "mime_aab"
msgstr "Android App Bundle (dilancarkan oleh Google pada 2018, mulai 2021 Google Play memerlukan aplikasi baharu menggunakan format ini. AAB adalah format pengedaran, Google Play menjana APK yang dioptimumkan mengikut konfigurasi peranti (seni bina CPU, ketumpatan skrin, bahasa), saiz pakej pemasangan berkurangan secara purata 35%. Pembangun memuat naik AAB, pengguna memuat turun APK)"

msgid "mime_xapk"
msgstr "Pakej aplikasi XAPK (pakej sambungan aplikasi Android pihak ketiga, mengandungi APK + fail data OBB. Digunakan untuk permainan besar dan aplikasi kompleks, menyelesaikan had 100MB fail APK tunggal. Biasa di kedai aplikasi pihak ketiga seperti APKPure, APKMirror, bukan format rasmi Google)"

msgid "mime_appx"
msgstr "Pakej aplikasi Windows (dilancarkan oleh Microsoft pada 2012, format pemasangan aplikasi Windows 8/10/11. Menyokong penukaran aplikasi UWP dan desktop, diedarkan melalui Microsoft Store. Pada 2024 Microsoft melancarkan MSIX sebagai format pengganti, secara beransur-ansur menggantikan APPX)"

msgid "mime_msix"
msgstr "Pakej aplikasi MSIX (dilancarkan oleh Microsoft pada 2018, format pembungkusan aplikasi generasi baharu untuk Windows. Menggabungkan kelebihan APPX dan MSI, menyokong semua jenis aplikasi Windows, boleh diedarkan melalui Microsoft Store atau dipasang secara sisi, format yang disyorkan untuk Windows 11)"

msgid "mime_appimage"
msgstr "Pakej aplikasi AppImage (dilancarkan pada 2004, format aplikasi Linux tanpa pemasangan. 'Satu aplikasi satu fail', tidak perlu pemasangan, berjalan terus, menyokong kebanyakan edaran Linux, cara biasa pembangun mengedarkan perisian Linux)"

msgid "mime_flatpak"
msgstr "Pakej aplikasi Flatpak (dilancarkan pada 2015, format aplikasi sandbox Linux. Berjalan merentas edaran, diasingkan daripada sistem hos, diterajui oleh Fedora, Red Hat, format lalai Pusat Perisian GNOME)"

msgid "mime_snap"
msgstr "Pakej aplikasi Snap (dilancarkan oleh Canonical pada 2014, syarikat induk Ubuntu, format aplikasi universal Linux. Kemas kini automatik, pengasingan sandbox, menyokong 40+ edaran Linux, format lalai Pusat Perisian Ubuntu)"

msgid "mime_deb"
msgstr "Pakej perisian Debian (dilancarkan oleh projek Debian pada 1993, format pemasangan standard untuk Debian/Ubuntu dan terbitannya. Diurus menggunakan dpkg, APT adalah antara muka pengurus pakejnya, salah satu format pakej paling matang dalam ekosistem Linux, masih menjadi arus perdana dalam keluarga Debian hingga kini)"

msgid "mime_rpm"
msgstr "Pakej perisian RPM (dilancarkan oleh Red Hat pada 1997, format standard untuk edaran Red Hat/Fedora/CentOS/SUSE dan lain-lain. RPM bermaksud 'Red Hat Package Manager', bersama DEB adalah dua format pakej besar Linux, masih menjadi arus perdana dalam keluarga RHEL hingga kini)"

msgid "mime_pacman"
msgstr "Pakej perisian Arch (dilancarkan oleh Arch Linux pada 2002, format .pkg.tar.zst yang digunakan oleh pengurus pakej pacman. Teras edaran bergulir Arch Linux, terkenal dengan prinsip kesederhanaan dan KISS, AUR (Arkib Pengguna Arch) adalah ciri khasnya)"

msgid "mime_exe"
msgstr "Fail boleh laku EXE (format program boleh laku Windows, singkatan untuk 'Executable'. Format boleh laku asli sistem pengendalian Windows, mengandungi struktur PE. Berkembang daripada format MZ dari MS-DOS, pada 1993 Windows NT memperkenalkan format PE (Portable Executable) dan masih digunakan hingga kini. Pakej pemasangan perisian, aplikasi, alat sistem menggunakan format ini. Pengguna klik dua kali untuk menjalankan, format boleh laku paling meluas di dunia)"

msgid "mime_dll"
msgstr "Pustaka pautan dinamik DLL (dilancarkan oleh Microsoft pada 1993, Perpustakaan Pautan Dinamik. Pustaka kod kongsi Windows, dimuatkan secara dinamik semasa pelaksanaan program, menjimatkan memori dan ruang cakera. Komponen sistem, plugin aplikasi, pemandu menggunakan format DLL. Cara pelaksanaan teras API Windows, masalah DLL Hell telah dikurangkan dalam era .NET)"

msgid "mime_com"
msgstr "Fail boleh laku COM (format boleh laku era MS-DOS, singkatan untuk 'Command'. Struktur fail mudah, had 64KB, format utama sebelum Windows 3.x. Dihapuskan, Windows moden menggunakan format EXE, sambungan COM masih digunakan untuk beberapa fail komponen)"

msgid "mime_aac"
msgstr "Audio AAC (standard MPEG 1997, Pengekodan Audio Lanjutan. Pengganti MP3, kualiti audio lebih baik daripada MP3 pada kadar bit yang sama, format audio lalai untuk YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Audio ALAC (dibangunkan oleh Apple pada 2004, Pengekod Audio Lossless Apple. Format lossless Apple, sumber terbuka pada 2011, format lalai audio lossless untuk iTunes dan Apple Music)"

msgid "mime_flac"
msgstr "Audio FLAC (dibangunkan oleh Yayasan Xiph.Org pada 2001, Pengekod Audio Lossless Percuma. Mampatan lossless, kualiti audio sama seperti CD, saiz fail kira-kira separuh daripada WAV asal. Sumber terbuka tanpa paten, format pilihan untuk peminat audio dan pengumpul muzik digital)"

msgid "mime_mp3"
msgstr "Audio MP3 (dibangunkan oleh Institut Fraunhofer pada 1993, Lapisan Audio MPEG-1 3. Format mampatan lossy, saiz fail kecil kualiti sederhana, format teras revolusi muzik digital tahun 2000-an, tulang belakang iPod dan Napster. Paten tamat pada 2017, menjadi format domain awam)"

msgid "mime_oga"
msgstr "Audio Ogg Audio (dibangunkan oleh Yayasan Xiph.Org, format audio tulen bekas Ogg, menggunakan pengekodan Vorbis. Sumber terbuka tanpa paten, kecekapan mampatan lebih baik daripada MP3, digunakan secara meluas dalam projek sumber terbuka)"

msgid "mime_ogg"
msgstr "Audio OGG (dibangunkan oleh Yayasan Xiph.Org pada 2000, format Ogg Vorbis. Sumber terbuka tanpa paten, kecekapan mampatan lebih baik daripada MP3, awal digunakan oleh Spotify, digunakan secara meluas dalam kesan bunyi permainan)"

msgid "mime_opus"
msgstr "Audio Opus (distandardkan oleh IETF pada 2012, format audio sumber terbuka tanpa paten. Menggabungkan teknologi SILK dan CELT, kependaman sangat rendah, kecekapan mampatan tertinggi, format audio lalai untuk WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Audio WAV (dibangunkan oleh Microsoft dan IBM pada 1991, format audio asli Windows. Pengekodan PCM tanpa mampatan, kualiti audio lossless, tetapi saiz fail besar, format standard penyuntingan audio profesional)"

msgid "mime_wma"
msgstr "Audio WMA (dibangunkan oleh Microsoft pada 1999, Audio Windows Media. Dua versi: lossy dan lossless, disokong secara asli oleh Windows, tersebar dengan Windows Media Player. Kini terpinggir, digantikan oleh MP3/AAC)"

msgid "mime_dsf"
msgstr "Audio DSF (format Direct Stream Digital, dibangunkan oleh Sony dan Philips. Kadar persampelan tinggi 1bit, format audio standard DSD, versi digital SACD, format audio tahap tinggi untuk peminat audio, saiz fail besar)"

msgid "mime_ape"
msgstr "Audio APE (dibangunkan oleh Monkey's Audio pada tahun 2000, format mampatan tanpa kehilangan. Mampatan lebih tinggi daripada FLAC tetapi pengekodan lebih perlahan, masih digunakan pada platform Windows dan dalam kalangan peminat audio)"

msgid "mime_mid"
msgstr "Audio MIDI (ditetapkan oleh Persatuan MIDI pada 1983, Antara Muka Digital Alat Muzik. Format skor muzik, bukan rakaman, saiz fail sangat kecil, standard untuk alat elektronik, nada dering telefon bimbit, kesan bunyi permainan. Pada 1991 General MIDI distandardkan, mentakrifkan 128 timbre alat)"

msgid "mime_m4a"
msgstr "Audio M4A (Audio MPEG-4, format bekas AAC. Format standard kedai muzik iTunes, format audio utama dalam ekosistem Apple, menyokong perlindungan DRM)"

msgid "mime_m3u"
msgstr "Senarai main M3U (format senarai main URL MP3, fail teks kosong, merekod laluan fail audio. Standard era Winamp, digunakan untuk radio internet, penstriman muzik dalam talian. M3U8 adalah versi UTF-8nya, digunakan untuk Penstriman Langsung HTTP)"

msgid "mime_asf"
msgstr "Penstriman ASF (dibangunkan oleh Microsoft pada 1996, Format Sistem Lanjutan. Bekas penstriman Windows Media, menyokong penghantaran audio-video segerak. Digunakan untuk siaran langsung dan penstriman video atas permintaan, WMA/WMV berdasarkan bekas ASF)"

msgid "mime_avi"
msgstr "Video AVI (dilancarkan oleh Microsoft pada 1992, standard video awal Windows. 'Selang Seling Audio Video', storan berselang-seli audio dan video, format video paling popular pada 1990-2000-an, kini digantikan oleh MP4/MKV)"

msgid "mime_divx"
msgstr "Video DivX (dibangunkan oleh syarikat DivX pada 1998, format pengekodan video berdasarkan MPEG-4. Format utama perkongsian video internet pada 2000-an, teknologi pertama yang memampatkan kualiti DVD ke saiz CD. Kerana pertikaian hak cipta, kemudian berubah menjadi pengekod komersial)"

msgid "mime_mp4"
msgstr "Video MP4 (standard MPEG 2001, MPEG-4 Bahagian 14. Format video paling universal di dunia, menyokong pengekodan H.264/H.265, format lalai untuk video internet, rakaman telefon, YouTube)"

msgid "mime_m4v"
msgstr "Video M4V (format video iTunes, varian MP4. Format video dalam ekosistem Apple, format standard untuk filem, rancangan TV di iTunes Store, menyokong perlindungan hak cipta DRM)"

msgid "mime_mpeg"
msgstr "Video MPEG (ditetapkan oleh organisasi MPEG pada 1988, Kumpulan Pakar Gambar Bergerak. Pengasas standard mampatan video digital, pengaruh mendalam MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (video internet))"

msgid "mime_mkv"
msgstr "Video MKV (dibangunkan oleh projek Matroska pada 2002, bekas multimedia sumber terbuka. Menyokong berbilang trek audio, berbilang sarikata, bab, 'alat pembalut', format pilihan untuk perkongsian filem HD)"

msgid "mime_mpg"
msgstr "Video MPEG (sambungan video MPEG-1/MPEG-2, format standard untuk VCD dan DVD. Format video utama pada cakera optik 1990-2000-an, kini digantikan oleh H.264/H.265)"

msgid "mime_ogv"
msgstr "Video Ogg Video (dibangunkan oleh Yayasan Xiph.Org, format video bekas Ogg, menggunakan pengekodan Theora. Sumber terbuka tanpa paten, salah satu standard awal video HTML5, disokong secara asli oleh Firefox)"

msgid "mime_ogx"
msgstr "Bekas multimedia Ogg (dibangunkan oleh Yayasan Xiph.Org, sambungan universal bekas Ogg, boleh mengandungi berbilang trek seperti audio, video, sarikata dll. Standard multimedia sumber terbuka, digunakan untuk permainan, penstriman)"

msgid "mime_rm"
msgstr "Video RealMedia (dibangunkan oleh RealNetworks pada 1995, format RealMedia. Perintis penstriman internet pada 1990-2000-an, format teras pemain RealPlayer. Kelemahan: memerlukan pemain khas, kualiti mampatan lemah, kemudian digantikan oleh Flash/MP4)"

msgid "mime_flv"
msgstr "Video Flash (format muncul pada 2002, format Video Flash. Pernah menjadi format utama video internet, awal digunakan oleh YouTube. Kelemahan: memerlukan plugin Flash, prestasi lemah, banyak lubang keselamatan. Mulai 2015 laman web utama beralih ke video HTML5, kini dihapuskan)"

msgid "mime_f4v"
msgstr "Video F4V (format video Flash yang dibangunkan oleh Adobe, pengganti FLV. Berdasarkan standard MPEG-4, menyokong pengekodan H.264. Bersama teknologi Flash dihapuskan, Adobe menghentikan sokongan pada 2020)"

msgid "mime_wmv"
msgstr "Video WMV (dibangunkan oleh Microsoft pada 1999, Video Windows Media. Disokong secara asli oleh Windows, dioptimumkan untuk penghantaran penstriman, format biasa untuk video dalam talian awal, kini terpinggir)"

msgid "mime_wmf"
msgstr "Format media WMF (Format Windows Media, rangka kerja media Microsoft. Merangkumi video WMV dan audio WMA, disokong secara asli oleh Windows Media Player)"

msgid "mime_mov"
msgstr "Video MOV (dibangunkan oleh Apple pada 1991, format bekas QuickTime. Format standard suntingan video profesional, menyokong berbilang pengekod, disokong secara asli oleh Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "Video QuickTime (dilancarkan oleh Apple pada 1991, format QuickTime. Standard video untuk platform Mac, MOV adalah bekasnya, pemain QuickTime pernah digunakan secara meluas. Pada 2016 Apple menghentikan pembangunan versi Windows, secara beransur-ansur digantikan oleh MP4)"

msgid "mime_webm"
msgstr "Video WebM (dilancarkan oleh Google pada 2010, format video sumber terbuka tanpa paten. Berdasarkan bekas Matroska, pengekodan VP8/VP9, format standard video HTML5, format mainan web lalai YouTube)"

msgid "mime_3gp"
msgstr "Video 3GP (ditetapkan oleh 3GPP pada 2000, format video untuk peranti mudah alih. Saiz fail sangat kecil, kualiti rendah, format rakaman video telefon bimbit awal, digunakan untuk penghantaran MMS)"

