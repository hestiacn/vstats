msgstr "URL có lỗi %s - Số yêu cầu"

msgid "Last URL referrer"
msgstr "URL giới thiệu cuối cùng"

msgid "Errors - Hits - Bandwidth"
msgstr "Lỗi - Số yêu cầu - Băng thông"

msgid "Search keywords - Number of search"
msgstr "Từ khóa - Số lượt tìm kiếm"

msgid "Only top %s keywords shown on main page (sorted by search count). See full list on detail page."
msgstr "Trang chính sẽ chỉ hiển thị %s từ khóa cao nhất (sắp xếp theo số lượt tìm kiếm). Vui lòng xem danh sách đầy đủ trong trang chi tiết"

