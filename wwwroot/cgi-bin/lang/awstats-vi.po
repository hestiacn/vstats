msgid "period_00"
msgstr "Nửa đêm · AWStats ngủ hết rồi, bạn vẫn xem dữ liệu à? Tình yêu đích thực"

msgid "period_01"
msgstr "1 giờ sáng · Truy cập giờ này? Bạn mất ngủ hay mới tan làm"

msgid "period_02"
msgstr "2 giờ sáng · Bot còn chăm chỉ hơn bạn, nó vẫn đang làm việc"

msgid "period_03"
msgstr "3 giờ sáng · Thành phố đang ngủ, máy chủ đang làm thêm giờ, ai tệ hơn?"

msgid "period_04"
msgstr "4 giờ sáng · Ngôi sao sáng nhất trong bóng tối, là màn hình của bạn hay đèn báo máy chủ"

msgid "period_05"
msgstr "5 giờ sáng · Chim dậy sớm có sâu ăn, bot dậy sớm có dữ liệu thu thập"

msgid "period_06"
msgstr "6 giờ sáng · Có người thức dậy, có người chưa ngủ, internet không bao giờ đóng cửa"

msgid "period_07"
msgstr "7 giờ sáng · Giờ chen lấn tàu điện, cũng là giờ lướt web"

