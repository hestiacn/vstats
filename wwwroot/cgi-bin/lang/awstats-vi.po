msgstr "Email - Số yêu cầu - Băng thông - Thời gian truy cập cuối cùng"

msgid "The %s first hits must be first (order not required for others)"
msgstr "Trang chính sẽ chỉ hiển thị %s email yêu cầu cao nhất, vui lòng xem danh sách đầy đủ trong trang chi tiết"

msgid "URL - Pages - Bandwidth - Entry - Exit"
msgstr "URL - Số trang - Băng thông - Vào - Ra"

msgid "Files type - Hits - Bandwidth - Bandwidth without compression - Bandwidth after compression"
msgstr "Loại tệp - Số yêu cầu - Băng thông - Băng thông trước nén - Băng thông sau nén"

msgid "Request Time Range - Request Time Frequency"
msgstr "Khoảng thời gian yêu cầu - Tần suất thời gian yêu cầu"

msgid "Payload Range - Payload Frequency"
msgstr "Khoảng kích thước tệp - Số lượng tệp"

msgid "Session range - Number of visits"
msgstr "Khoảng thời lượng phiên - Số lượt truy cập"

