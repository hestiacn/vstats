msgstr "8 giờ sáng · Việc đầu tiên khi bắt đầu làm việc: xem dữ liệu hôm qua"

msgid "period_09"
msgstr "9 giờ sáng · Giờ vàng, trốn việc cũng phải có nguyên tắc"

msgid "period_10"
msgstr "10 giờ sáng · Giờ cà phê, xem lưu lượng tăng chưa"

msgid "period_11"
msgstr "11 giờ sáng · Còn một giờ nữa đến giờ ăn cơm, cố gắng thêm chút nữa"

