#------------------------------------------------------------------------------
# Mô tả định dạng
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tệp văn bản (được chuẩn hóa ASCII năm 1963, văn bản thuần không định dạng. Nền tảng của mã nguồn, tệp cấu hình và nhật ký. Unix dùng LF, Windows dùng CRLF xuống dòng, vẫn là định dạng dữ liệu phổ biến nhất của máy tính)"

msgid "mime_log"
msgstr "Tệp nhật ký (tệp văn bản thuần ghi dữ liệu hệ thống, hoạt động ứng dụng, dùng để khắc phục sự cố, phân tích hiệu suất, kiểm tra bảo mật. Định dạng chuẩn như Apache combined log, Nginx access log, syslog v.v.)"

msgid "mime_page"
msgstr "Trang web HTML (Tim Berners-Lee phát minh World Wide Web năm 1989, định nghĩa ba công nghệ HTML/HTTP/URL năm 1990, cung cấp miễn phí không xin bằng sáng chế. HTML5 trở thành tiêu chuẩn W3C năm 2014, hỗ trợ hiển thị, đa phương tiện và in ấn. Được giải Turing năm 2016)"

msgid "mime_khtml"
msgstr "Công cụ trang web KHTML (phát hành trong KDE 2.0 năm 1998, công cụ hiển thị trình duyệt Konqueror. Apple tạo WebKit dựa trên KHTML năm 2001. Google tạo Blink từ WebKit năm 2008, trở thành lõi chính của trình duyệt Chrome, Edge, Safari. KHTML là hình mẫu của cộng đồng nguồn mở đặt nền móng cho công cụ trình duyệt hiện đại, di sản công nghệ vẫn tiếp tục qua WebKit/Blink)"

msgid "mime_script"
msgstr "Kịch bản động (ngôn ngữ thông dịch, không cần biên dịch. Bao gồm ASP, JSP, CGI, ColdFusion, Tcl, VBScript v.v., được sử dụng rộng rãi trong phát triển web thời kỳ đầu, quản lý hệ thống, tác vụ tự động. Ngôn ngữ kịch bản hiện đại như Python, Ruby, JavaScript đã phát triển thành ngôn ngữ chính trong phát triển full-stack)"

msgid "mime_js"
msgstr "Kịch bản JavaScript (Brendan Eich tạo trong 10 ngày tại Netscape năm 1995, ngôn ngữ lập trình gốc của trình duyệt. ECMAScript được chuẩn hóa năm 1997. Node.js ra đời năm 2009 biến nó thành ngôn ngữ full-stack. npm là trình quản lý gói lớn nhất thế giới. Nhiều năm liền là ngôn ngữ lập trình phổ biến nhất trên GitHub)"

msgid "mime_py"
msgstr "Kịch bản Python (Guido van Rossum tạo năm 1991, nổi tiếng với thụt lề bắt buộc, cú pháp đơn giản. Được sử dụng rộng rãi trong phát triển web, khoa học dữ liệu, trí tuệ nhân tạo, vận hành tự động. Nhiều lần đoạt giải TIOBE Programming Language of the Year)"

msgid "mime_sh"
msgstr "Kịch bản Shell (Unix ra đời năm 1971, ngôn ngữ kịch bản lệnh. Dùng cho quản lý hệ thống, tác vụ tự động, khởi động dịch vụ, kịch bản triển khai. Kỹ năng thiết yếu cho quản trị Linux)"

msgid "mime_rb"
msgstr "Kịch bản Ruby (Yukihiro Matsumoto tạo năm 1995, chú trọng hạnh phúc của lập trình viên. Framework Ruby on Rails khởi xướng mô hình phát triển 'cấu hình hơn là quy định', ảnh hưởng đến thiết kế framework web hiện đại)"

msgid "mime_pl"
msgstr "Kịch bản Perl (Larry Wall tạo năm 1987, nổi tiếng với chủ nghĩa thực dụng, được mệnh danh là 'dao quân đội Thụy Sĩ'. CPAN là tiên phong của trình quản lý gói ngôn ngữ hiện đại, có ảnh hưởng sâu sắc trong xử lý văn bản, quản lý hệ thống và CGI)"

msgid "mime_php"
msgstr "Trang web động PHP (Rasmus Lerdorf tạo năm 1995, được thiết kế đặc biệt cho phát triển web. Hơn 70% trang web trên toàn cầu sử dụng, điều khiển các nền tảng như WordPress, Facebook, Wikipedia. PHP 8 giới thiệu biên dịch JIT, cải thiện hiệu suất đáng kể)"

msgid "mime_image"
msgstr "Tệp hình ảnh"

msgid "mime_document"
msgstr "Tệp tài liệu"

msgid "mime_package"
msgstr "Gói phần mềm"

msgid "mime_archive"
msgstr "Tệp nén Gzip (dự án GNU năm 1992, dựa trên thuật toán DEFLATE. Dùng trong web để nén nội dung phản hồi động, tỷ lệ nén thường 60-90%. Sau 2015 một số trường hợp được thay thế bằng Brotli, nhưng vẫn là định dạng nén được hỗ trợ rộng rãi nhất phía máy chủ)"

msgid "mime_audio"
msgstr "Tệp âm thanh"

msgid "mime_video"
msgstr "Tệp video"

msgid "mime_jscript"
msgstr "JavaScript (phát triển bởi Brendan Eich năm 1995)"

msgid "mime_json"
msgstr "Dữ liệu JSON (Douglas Crockford đề xuất năm 2001, định dạng trao đổi dữ liệu nhẹ, tiêu chuẩn thực tế của Web API)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft phát triển năm 1996, ngôn ngữ kịch bản Windows, dùng cho trang web ASP và kịch bản quản lý Windows. Hiện đã bị loại bỏ dần do PowerShell và JavaScript phổ biến)"

msgid "mime_conf"
msgstr "Tệp cấu hình (lưu cấu hình phần mềm dạng văn bản, định dạng phổ biến: INI, JSON, YAML, TOML, XML. Cấu hình hệ thống Linux thường nằm trong thư mục /etc)"

msgid "mime_css"
msgstr "Bảng định kiểu CSS (W3C phát hành CSS1 tiêu chuẩn đầu tiên vào tháng 12 năm 1996, CSS2 thêm định vị và loại phương tiện năm 1998, từ năm 2011 CSS3 theo mô-đun giới thiệu bo góc, hoạt ảnh, hộp co giãn, bố cục lưới và thiết kế đáp ứng. Cùng với HTML và JavaScript là ba công nghệ lõi của front-end, tất cả trình duyệt hiện đại (Chrome, Firefox, Safari, Edge) đều hỗ trợ nguyên bản, là tiêu chuẩn duy nhất để định nghĩa kiểu trang web)"

msgid "mime_xsl"
msgstr "Bảng định kiểu XSL (tiêu chuẩn W3C năm 1999, ngôn ngữ chuyển đổi tài liệu XML, có thể chuyển XML sang HTML/PDF/văn bản. Sử dụng giảm sau khi JSON phổ biến)"

msgid "mime_runtime"
msgstr "Tệp thực thi (định dạng thực thi của hệ điều hành như EXE, ELF, Mach-O, bao gồm mã máy và thông tin tải)"

msgid "mime_library"
msgstr "Tệp thư viện (DLL, SO, dylib v.v. thư viện liên kết động, mã chia sẻ được tải khi chương trình chạy)"

msgid "mime_swf"
msgstr "Hoạt ảnh Flash (Macromedia phát triển năm 1996, sau thuộc về Adobe. Tiêu chuẩn hoạt ảnh web tương tác, từng thống trị game và hoạt ảnh trên internet. Điểm yếu: phụ thuộc plugin, không hỗ trợ di động, rủi ro bảo mật cao. Adobe tuyên bố loại bỏ năm 2017, ngừng hỗ trợ hoàn toàn năm 2020, bị thay thế bởi HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD (Định nghĩa loại tài liệu) (đặc tả XML, định nghĩa cấu trúc tài liệu XML, dùng để xác thực tính hợp lệ của XML)"

msgid "mime_csv"
msgstr "Định dạng dữ liệu CSV (giá trị phân cách bằng dấu phẩy, định dạng dữ liệu bảng phổ biến, tiêu chuẩn xuất nhập Excel và cơ sở dữ liệu)"

msgid "mime_jnlp"
msgstr "Java Web Start (trình khởi chạy ứng dụng Java, công nghệ phân phối ứng dụng Java trên desktop thập niên 2000, nay đã bị loại bỏ)"

msgid "mime_lit"
msgstr "Sách điện tử Microsoft Reader (Microsoft ra mắt năm 2000, định dạng LIT, đã bị loại bỏ)"

msgid "mime_svg"
msgstr "Đồ họa vector SVG (tiêu chuẩn W3C năm 1999, do Microsoft đẩy mạnh định dạng VML riêng trong thời gian dài, trình duyệt IE chỉ hỗ trợ đến năm 2011, khiến việc phổ biến bị chậm trễ. Sau năm 2015 khi IE bị loại bỏ và màn hình độ phân giải cao phổ biến, nó trở thành định dạng ưu tiên cho biểu tượng, logo)"

msgid "mime_ai"
msgstr "Đồ họa vector Adobe Illustrator (ra mắt năm 1987, định dạng đồ họa vector tiêu chuẩn ngành, ưu tiên cho thiết kế in ấn, logo, biểu tượng)"

msgid "mime_phshop"
msgstr "Hình ảnh Photoshop (Adobe ra mắt năm 1990, định dạng tệp gốc PSD của Photoshop, tiêu chuẩn ngành xử lý ảnh)"

msgid "mime_ttf"
msgstr "Phông chữ TrueType (Apple và Microsoft đồng phát triển năm 1989, định dạng phông chữ vector, hiển thị trên màn hình và in ấn nhất quán, định dạng phông chữ mặc định của hệ điều hành hiện đại)"

msgid "mime_fon"
msgstr "Phông chữ web WOFF2 (W3C khuyến nghị năm 2014, sử dụng thuật toán nén Brotli, kích thước giảm khoảng 30% so với WOFF cũ, giảm hơn 50% so với TTF/OTF, hiện tất cả trình duyệt hiện đại đều hỗ trợ, là định dạng ưu tiên cho phông chữ web hiện đại, được hơn 98% trình duyệt hỗ trợ)"

msgid "mime_pdf"
msgstr "Tài liệu PDF (Adobe phát triển năm 1993, trở thành tiêu chuẩn ISO năm 2008. Định dạng tài liệu đa nền tảng, giữ nhất quán định dạng, là tiêu chuẩn toàn cầu cho phân phối tài liệu điện tử)"

msgid "mime_dotnet"
msgstr "Trang web động ASP.NET (Microsoft ra mắt năm 2002, công nghệ trang web động trên nền tảng Windows, một phần của .NET Framework)"

msgid "mime_mdb"
msgstr "Cơ sở dữ liệu Access (tệp cơ sở dữ liệu Microsoft Access, ra mắt năm 1992, giải pháp cơ sở dữ liệu trên desktop Windows)"

msgid "mime_md"
msgstr "Tài liệu Markdown (John Gruber tạo năm 2004, thiết kế cú pháp chịu ảnh hưởng từ reStructuredText và Setext. Triết lý thiết kế chính là 'đọc được là hiển thị được'. Bản triển khai gốc Markdown.pl dùng biểu thức chính quy Perl. Các đặc tả phái sinh bao gồm GFM (2013), CommonMark (2017), Pandoc Markdown v.v. Điều khiển hệ sinh thái như GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, trở thành định dạng tiêu chuẩn thực tế cho trình tạo trang web tĩnh và tài liệu nhà phát triển)"

msgid "mime_crystal"
msgstr "Định dạng báo cáo Crystal Reports (báo cáo thông minh kinh doanh của SAP, định dạng báo cáo doanh nghiệp tiêu chuẩn)"

msgid "mime_libreoffice"
msgstr "Tài liệu LibreOffice (The Document Foundation phát triển năm 2010, nhánh của OpenOffice, triển khai chuẩn ODF, bộ ứng dụng văn phòng nguồn mở chính thống)"

msgid "mime_encrypt"
msgstr "Tệp mã hóa (cần giải mã mới xem được tệp, phần mở rộng phổ biến: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Dữ liệu lộ trình GPS (định dạng trao đổi GPS, ghi dữ liệu vị trí địa lý, định dạng phổ biến cho đồng hồ thể thao và thiết bị định vị)"

msgid "mime_diskimage"
msgstr "Ảnh đĩa (tệp ảnh đĩa/CD-ROM như DMG, ISO, IMG, dùng để phân phối phần mềm hoặc sao lưu phương tiện lưu trữ)"

msgid "mime_vm"
msgstr "Ảnh máy ảo (tệp đĩa máy ảo như VMDK, VDI, VHDX, OVA, định dạng cho nền tảng ảo hóa như VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "Tệp BitTorrent (Bram Cohen phát minh năm 2001, tệp chỉ mục tải xuống P2P, bao gồm siêu dữ liệu tệp và thông tin Tracker)"

msgid "mime_gis"
msgstr "Dữ liệu Hệ thống Thông tin Địa lý GIS (dữ liệu không gian địa lý như Shapefile, GeoJSON, dùng cho bản đồ và phân tích không gian)"

msgid "mime_ebook"
msgstr "Sách điện tử (định dạng sách điện tử như EPUB, MOBI, AZW. EPUB là tiêu chuẩn quốc tế, MOBI/AZW là định dạng cho Amazon Kindle)"

msgid "mime_avif"
msgstr "Hình ảnh AVIF (Alliance for Open Media ra mắt năm 2019, dựa trên mã hóa AV1, tỷ lệ nén cao hơn WebP 50%, tiêu chuẩn hình ảnh web thế hệ mới)"

msgid "mime_markdown"
msgstr "Tài liệu Markdown (John Gruber thiết kế năm 2004, ngôn ngữ đánh dấu nhẹ, định dạng phổ biến cho README trên GitHub, tài liệu kỹ thuật, bài đăng trên diễn đàn)"

msgid "mime_yaml"
msgstr "Cấu hình YAML (Clark Evans thiết kế năm 2001, định dạng tuần tự hóa dữ liệu con người có thể đọc được, tiêu chuẩn tệp cấu hình cho Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Cấu hình TOML (Tom Preston-Werner thiết kế năm 2013, 'Ngôn ngữ tối giản rõ ràng của Tom', định dạng tệp cấu hình cho các công cụ hiện đại như Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Tệp thành phần Vue (được giới thiệu vào năm 2014 bởi Evan You, một framework JavaScript lũy tiến. Thông qua các thành phần một tệp (SFC), nó kết hợp hoàn hảo HTML, CSS và JS, giúp tăng đáng kể hiệu quả phát triển. Đây là một trong những framework frontend phổ biến nhất thế giới. Đồng thời, là cốt lõi của các trình tạo trang tĩnh hiện đại như VitePress, nó được sử dụng rộng rãi để điều khiển tài liệu kỹ thuật tương tác và blog.)"

msgid "mime_wasm"
msgstr "Mô-đun WebAssembly (tiêu chuẩn W3C năm 2017, định dạng thực thi hiệu suất cao trong trình duyệt, C/C++/Rust/R có thể biên dịch thành mục tiêu, hiệu suất gần với bản địa)"

msgid "mime_jsx"
msgstr "Thành phần React JSX (Facebook ra mắt JavaScript XML năm 2013, cú pháp thành phần của framework React, đổi mới đưa HTML vào JavaScript)"

msgid "mime_tsx"
msgstr "Thành phần TypeScript TSX (Microsoft phát triển năm 2012, TypeScript + JSX, cách viết chuẩn cho phát triển React an toàn kiểu)"

msgid "mime_heif"
msgstr "Hình ảnh HEIF (tiêu chuẩn MPEG năm 2015, định dạng tệp hình ảnh hiệu quả cao, được sử dụng rộng rãi trong hệ sinh thái Apple)"

msgid "mime_heic"
msgstr "Hình ảnh HEIC (triển khai HEIF của Apple, định dạng ảnh mặc định của iPhone, hỗ trợ nguyên bản trên iOS/macOS)"

msgid "mime_gltf"
msgstr "Mô hình 3D GLTF (Định dạng truyền tải GL, 'JPEG của thế giới 3D', Khronos Group phát hành năm 2015, định dạng chuẩn Web 3D)"

msgid "mime_glb"
msgstr "Mô hình 3D GLB nhị phân (phiên bản nhị phân của GLTF, một tệp chứa tất cả tài nguyên, dùng để phân phối cảnh 3D)"

msgid "mime_gls"
msgstr "Bảng thuật ngữ GLOSSARY (tệp định nghĩa thuật ngữ, dùng để quản lý thuật ngữ trong hệ thống tài liệu)"

msgid "mime_cbz"
msgstr "Truyện tranh CBZ (hình ảnh truyện tranh được nén bằng ZIP, định dạng phổ biến để sưu tầm truyện tranh)"

msgid "mime_cbr"
msgstr "Truyện tranh CBR (hình ảnh truyện tranh được nén bằng RAR, định dạng phổ biến để sưu tầm truyện tranh)"

msgid "mime_fb2"
msgstr "Sách điện tử FB2 (FictionBook 2.0, định dạng sách điện tử của Nga, cấu trúc XML, được hỗ trợ rộng rãi bởi trình đọc nguồn mở)"

msgid "mime_kepub"
msgstr "Sách điện tử KEPUB (định dạng EPUB dành riêng cho Kobo, định dạng tối ưu cho máy đọc sách điện tử Kobo)"

msgid "mime_m4b"
msgstr "Sách nói M4B (định dạng sách âm thanh MPEG-4, hỗ trợ đánh dấu trang, định dạng sách nói của iTunes)"

msgid "mime_kfx"
msgstr "Định dạng Kindle KFX (Amazon ra mắt năm 2015, định dạng sách điện tử dành riêng cho Kindle, hỗ trợ bố cục nâng cao và lật trang nhanh)"

msgid "mime_chm"
msgstr "Tệp trợ giúp CHM (Microsoft ra mắt năm 1997, định dạng Trợ giúp HTML đã biên dịch, tiêu chuẩn tài liệu trợ giúp phần mềm Windows)"

msgid "mime_mht"
msgstr "Lưu trữ trang web MHT (Microsoft ra mắt năm 1999, định dạng trang web một tệp, định dạng lưu trang web của trình duyệt IE)"

msgid "mime_wml"
msgstr "Ngôn ngữ đánh dấu không dây WML (tiêu chuẩn WAP năm 1999, dùng cho tệp trang web điện thoại chức năng đời đầu, đã bị loại bỏ)"

msgid "mime_xhtml"
msgstr "Trang web XHTML (tiêu chuẩn W3C năm 2000, phiên bản XML của HTML, cú pháp chặt chẽ hơn. W3C ngừng bảo trì năm 2009, chuyển trọng tâm sang HTML5)"

msgid "mime_xml"
msgstr "Tài liệu XML (tiêu chuẩn W3C năm 1998, ngôn ngữ đánh dấu mở rộng được, định dạng cơ bản cho dịch vụ web, tệp cấu hình, trao đổi dữ liệu)"

msgid "mime_sgml"
msgstr "Tài liệu SGML (tiêu chuẩn ISO năm 1986, tiền thân của HTML, ngôn ngữ đánh dấu tổng quát chuẩn, XML và HTML đều bắt nguồn từ SGML)"

msgid "mime_apng"
msgstr "Hoạt ảnh APNG (Mozilla phát triển năm 2004, phần mở rộng hoạt ảnh của PNG, thay thế hiện đại cho GIF, hỗ trợ màu thực và trong suốt)"

msgid "mime_bmp"
msgstr "BMP bitmap (Định dạng bitmap của Windows, được hỗ trợ nguyên bản từ Windows 1.0. Không nén, kích thước tệp lớn, nhưng do cấu trúc đơn giản và không cần codec bổ sung, nó vẫn được sử dụng trong Công cụ cắt của Windows 11, chương trình Paint, tài nguyên biểu tượng trong gói cài đặt EXE/MSI, tệp con trỏ và một số trình điều khiển cũ hơn. Với cùng chất lượng hình ảnh, kích thước tệp lớn hơn PNG khoảng 3-10 lần. Trong hầu hết các trường hợp, nó đã được thay thế bằng PNG/JPEG, nhưng hệ sinh thái Windows vẫn duy trì khả năng tương thích rộng rãi)"

msgid "mime_cdr"
msgstr "Đồ họa vector CDR (định dạng độc quyền của CorelDRAW, công ty Corel của Canada, phần mềm thiết kế đồ họa vector)"

msgid "mime_gif"
msgstr "Hình ảnh GIF (CompuServe phát triển năm 1987, định dạng ảnh động 256 màu. Điểm yếu: màu ít, chất lượng ảnh thô, không hỗ trợ trong suốt, tệp lớn, tốc độ khung hình thấp. Bị thay thế bởi các định dạng ảnh động hiện đại như APNG, WebP)"

msgid "mime_ico"
msgstr "Biểu tượng ICO (định dạng tệp biểu tượng Windows, hỗ trợ nhiều độ phân giải, định dạng favicon tiêu chuẩn của trang web)"

msgid "mime_jpeg"
msgstr "Hình ảnh JPEG (tiêu chuẩn ISO năm 1992, định dạng nén mất dữ liệu cho ảnh chụp, tiêu chuẩn thực tế cho ảnh trên internet)"

msgid "mime_jpg"
msgstr "Hình ảnh JPEG (tiêu chuẩn ISO năm 1992, định dạng nén mất dữ liệu cho ảnh chụp, tiêu chuẩn thực tế cho ảnh trên internet)"

msgid "mime_png"
msgstr "Hình ảnh PNG (W3C khuyến nghị năm 1996, hỗ trợ màu thực và trong suốt, thay thế tĩnh cho GIF, tiêu chuẩn ảnh không mất dữ liệu trên internet)"

msgid "mime_ps"
msgstr "Tệp mô tả trang PostScript (Adobe ra mắt năm 1985, ngôn ngữ mô tả trang, tiền thân của PDF, dùng cho in ấn và xuất bản)"

msgid "mime_psb"
msgstr "Tài liệu lớn PSB (định dạng ảnh siêu lớn của Adobe Photoshop, hỗ trợ ảnh khổng lồ vượt quá 2GB hoặc 30000 pixel)"

msgid "mime_psd"
msgstr "Hình ảnh PSD (tệp gốc Adobe Photoshop, hỗ trợ lớp, kênh, đường dẫn, định dạng tiêu chuẩn ngành xử lý ảnh)"

msgid "mime_webp"
msgstr "Hình ảnh WebP (Google phát triển năm 2010, định dạng ảnh web, hỗ trợ nén mất dữ liệu/không mất dữ liệu và hoạt ảnh, tỷ lệ nén cao hơn PNG 25-35% và cao hơn JPEG 25%)"

msgid "mime_woff"
msgstr "Phông chữ web WOFF (tạo năm 2009, tiêu chuẩn W3C năm 2018. Nén dựa trên TrueType/OpenType, tối ưu tải phông chữ web, định dạng chuẩn cho phông chữ biểu tượng trang web hiện đại)"

msgid "mime_7z"
msgstr "Gói nén 7z (Igor Pavlov phát triển năm 1999, định dạng độc quyền của chương trình 7-Zip. Thuật toán LZMA, tỷ lệ nén cao, nguồn mở miễn phí. Định dạng 7z ở cùng tỷ lệ nén thường nhỏ hơn ZIP 30-50%, là định dạng phổ biến cho cộng đồng nguồn mở và phân phối phần mềm)"

msgid "mime_ace"
msgstr "Gói nén ACE (phát triển thập niên 1990, định dạng chương trình WinACE. Từng cạnh tranh với RAR, tỷ lệ nén khá cao. Ngừng phát triển năm 2007, nay bị thay thế bởi 7z/RAR, ít được sử dụng)"

msgid "mime_bz2"
msgstr "Gói nén BZIP2 (Julian Seward phát triển năm 1996, thuật toán nén khối. Tỷ lệ nén cao hơn GZIP 15-20% nhưng chậm hơn. Định dạng phổ biến cho mã nguồn nhân Linux, gói phần mềm nguồn mở, phần mở rộng .bz2)"

msgid "mime_cab"
msgstr "Gói nén CAB (Microsoft phát triển năm 1995, định dạng Cabinet. Định dạng gói cài đặt Windows, dùng cho trình điều khiển, phân phối tệp hệ thống. Windows Installer (MSI) sử dụng CAB nội bộ để lưu trữ tệp)"

msgid "mime_dmg"
msgstr "Ảnh đĩa DMG (Apple ra mắt thập niên 1980, định dạng Disk Image. Định dạng phân phối phần mềm macOS tiêu chuẩn, nhấp đúp để gắn kết thành đĩa ảo, kéo thả để cài đặt ứng dụng. Hỗ trợ nén và mã hóa, là định dạng chính để tải phần mềm Mac)"

msgid "mime_emz"
msgstr "Ảnh nén EMZ (Windows compressed Enhanced Metafile, phiên bản nén của EMF. Định dạng lưu trữ đồ họa vector trong tài liệu Office, bản chất là tệp EMF được nén bằng GZIP)"

msgid "mime_gz"
msgstr "Gói nén GZIP (Jean-loup Gailly và Mark Adler phát triển năm 1992, dự án GNU. Công cụ nén tiêu chuẩn của Unix/Linux, định dạng phổ biến cho nén truyền tải HTTP. Phần mở rộng .gz, thường dùng kết hợp với TAR)"

msgid "mime_jar"
msgstr "Gói nén JAR (Sun Microsystems ra mắt năm 1997, định dạng Java ARchive. Bản chất là tệp ZIP, dùng để đóng gói thư viện và ứng dụng Java. Định dạng cốt lõi của hệ sinh thái Java như Maven, Gradle. Android cũng sử dụng JAR)"

msgid "mime_lzma"
msgstr "Gói nén LZMA (Igor Pavlov phát triển năm 1998, thuật toán Lempel-Ziv-Markov chain. Thuật toán nén cốt lõi của định dạng 7z, tỷ lệ nén cao, tốc độ giải nén nhanh. Dùng cho phân phối phần mềm firmware và hệ thống nhúng)"

msgid "mime_rar"
msgstr "Gói nén RAR (Eugene Roshal phát triển năm 1993, định dạng Roshal ARchive. Tỷ lệ nén cao, hỗ trợ chia tập tin, bản ghi phục hồi. Định dạng chương trình WinRAR, tỷ lệ nén tốt hơn ZIP nhưng cần phần mềm trả phí, công cụ nguồn mở như unrar có thể giải nén)"

msgid "mime_tar"
msgstr "Gói lưu trữ TAR (Unix V7 giới thiệu năm 1979, định dạng Tape ARchive. Định dạng lưu trữ băng, không nén chỉ đóng gói, thường dùng kết hợp với GZIP/BZIP2/XZ. Mã nguồn gói Linux, lưu trữ lớp ảnh Docker đều sử dụng định dạng TAR)"

msgid "mime_tgz"
msgstr "Gói nén TGZ (định dạng kết hợp TAR + GZIP, phần mở rộng .tgz hoặc .tar.gz. Định dạng phân phối phổ biến nhất cho gói phần mềm Unix/Linux, gói mã nguồn, gói nhị phân, được sử dụng rộng rãi, đại diện cho 'giải nén là dùng được')"

msgid "mime_tbz2"
msgstr "Gói nén TBZ2 (định dạng kết hợp TAR + BZIP2, phần mở rộng .tbz2 hoặc .tar.bz2. Tỷ lệ nén cao hơn TGZ 15-20%, phù hợp phân phối tệp lớn, nhân Linux sử dụng định dạng này trong thời gian dài)"

msgid "mime_xz"
msgstr "Gói nén XZ (ra mắt năm 2009, dựa trên thuật toán LZMA2. Tỷ lệ nén cực cao, cao hơn GZIP 30-50%, tốc độ giải nén khá nhanh. Nhân Linux, trình quản lý gói (như bên trong .deb của Debian) sử dụng rộng rãi, là định dạng được khuyến nghị trong hệ sinh thái Linux hiện tại)"

msgid "mime_z"
msgstr "Gói nén Z (định dạng lệnh Unix compress năm 1985, thuật toán LZW. Định dạng nén Unix thời kỳ đầu, đã bị GZIP thay thế. Phần mở rộng .Z, hệ thống hiện đại ít sử dụng)"

msgid "mime_zip"
msgstr "Gói nén ZIP (Phil Katz phát triển năm 1989, định dạng PKZIP. Hỗ trợ nguyên bản trong Windows, định dạng nén phổ biến nhất trên internet. Hỗ trợ nhiều tệp, cấu trúc thư mục, có thể chọn thuật toán nén. JAR của Java, APK của Android, DOCX/XLSX của tài liệu Office đều dựa trên định dạng ZIP)"

msgid "mime_zst"
msgstr "Gói nén Zstandard (Facebook phát triển năm 2015, Yann Collet thiết kế. Thuật toán nén tốc độ cao, tỷ lệ nén gần với LZMA, tốc độ vượt xa GZIP. Nhân Linux 5.9+ hỗ trợ, Arch Linux pacman, Debian APT đang dần áp dụng, là tiêu chuẩn nén thế hệ mới)"

msgid "mime_lz4"
msgstr "Gói nén LZ4 (Yann Collet phát triển năm 2011, thuật toán nén cực nhanh. Tốc độ nén nhanh hơn GZIP 10 lần trở lên, phù hợp cho nén thời gian thực. Nhân Linux, OpenZFS, Hadoop sử dụng rộng rãi, là lựa chọn hàng đầu cho các tình huống ưu tiên tốc độ)"

msgid "mime_lzo"
msgstr "Gói nén LZO (Markus Oberhumer phát triển năm 1996, thuật toán Lempel-Ziv-Oberhumer. Tốc độ giải nén cực nhanh, tỷ lệ nén trung bình. Nhân Linux Squashfs, firmware OpenWrt sử dụng, phù hợp cho hệ thống nhúng)"

msgid "mime_msi"
msgstr "Gói cài đặt MSI (Microsoft ra mắt năm 1999, định dạng gói Windows Installer. Định dạng cài đặt ứng dụng Windows tiêu chuẩn, hỗ trợ hoàn tác giao dịch, quản lý thành phần, cài đặt im lặng. Định dạng ưu tiên phân phối phần mềm doanh nghiệp, vẫn là chính thống cho cài đặt phần mềm Windows đến nay)"

msgid "mime_pkg"
msgstr "Gói cài đặt PKG (định dạng gói cài đặt ứng dụng macOS, dựa trên công nghệ Installer của Apple. Định dạng phân phối phần mềm macOS tiêu chuẩn, hỗ trợ chọn thành phần, kịch bản cài đặt, chức năng gỡ cài đặt. Nhấp đúp vào tệp .pkg để cài đặt, cách phân phối phổ biến cho phần mềm bên ngoài Mac App Store)"

msgid "mime_apk"
msgstr "Gói ứng dụng Android APK (được Google giới thiệu vào năm 2008, định dạng cài đặt ứng dụng Android truyền thống. APK về cơ bản là gói ZIP chứa mã, tài nguyên và tệp kê khai. Từ năm 2021, Google Play yêu cầu các ứng dụng mới sử dụng định dạng AAB, nhưng APK vẫn được sử dụng để gỡ lỗi, cửa hàng bên thứ ba và cài đặt tải bên)"

msgid "mime_ipa"
msgstr "Gói ứng dụng iOS IPA (iOS App Store Package, định dạng cài đặt cho ứng dụng iOS/iPadOS. Được giới thiệu vào năm 2008 cùng với iPhone SDK. Phải được phân phối qua App Store hoặc ký bằng chứng chỉ doanh nghiệp. Chứa tệp thực thi, tài nguyên, Info.plist và thông tin chữ ký)"

msgid "mime_hap"
msgstr "Gói ứng dụng HarmonyOS HAP (HarmonyOS Ability Package, đơn vị cơ bản của ứng dụng HarmonyOS. Được giới thiệu vào năm 2020 cùng với HarmonyOS 2.0. Hỗ trợ hai loại: entry và feature, định dạng phân phối cho điện thoại Huawei, máy tính bảng, đồng hồ thông minh và các thiết bị HarmonyOS khác)"

msgid "mime_har"
msgstr "Thư viện dùng chung tĩnh HarmonyOS HAR (HarmonyOS Archive, thư viện dùng chung tĩnh của HarmonyOS, có thể được chia sẻ bởi nhiều gói HAP, được sử dụng cho phát triển dựa trên thành phần và tái sử dụng mô-đun)"

msgid "mime_aab"
msgstr "Android App Bundle (Google ra mắt năm 2018, từ 2021 Google Play bắt buộc ứng dụng mới sử dụng định dạng này. AAB là định dạng phân phối, Google Play tạo APK tối ưu theo cấu hình thiết bị (kiến trúc CPU, mật độ màn hình, ngôn ngữ), kích thước gói trung bình giảm 35%. Nhà phát triển tải lên AAB, người dùng tải xuống APK)"

msgid "mime_xapk"
msgstr "Gói ứng dụng XAPK (gói mở rộng ứng dụng Android bên thứ ba, bao gồm APK + tệp dữ liệu OBB. Dùng cho game lớn và ứng dụng phức tạp, giải quyết giới hạn 100MB của tệp APK đơn. Phổ biến trên các cửa hàng ứng dụng bên thứ ba như APKPure, APKMirror, không phải định dạng chính thức của Google)"

msgid "mime_appx"
msgstr "Gói ứng dụng Windows (Microsoft ra mắt năm 2012, định dạng cài đặt ứng dụng Windows 8/10/11. Hỗ trợ ứng dụng UWP và chuyển đổi ứng dụng desktop, phân phối qua Microsoft Store. Năm 2024 Microsoft ra mắt MSIX làm định dạng kế nhiệm, thay thế dần APPX)"

msgid "mime_msix"
msgstr "Gói ứng dụng MSIX (Microsoft ra mắt năm 2018, định dạng đóng gói ứng dụng Windows thế hệ mới. Kết hợp ưu điểm của APPX và MSI, hỗ trợ mọi loại ứng dụng Windows, có thể phân phối qua Microsoft Store hoặc cài đặt side-load, định dạng được khuyến nghị cho Windows 11)"

msgid "mime_appimage"
msgstr "Gói ứng dụng AppImage (ra mắt năm 2004, định dạng ứng dụng Linux không cần cài đặt. 'Một ứng dụng một tệp', chạy ngay không cần cài đặt, hỗ trợ hầu hết các bản phân phối Linux, cách phổ biến để nhà phát triển phân phối phần mềm Linux)"

msgid "mime_flatpak"
msgstr "Gói ứng dụng Flatpak (ra mắt năm 2015, định dạng ứng dụng Linux trong hộp cát. Chạy đa bản phân phối, cách ly với hệ thống máy chủ, do Fedora, Red Hat dẫn dắt phát triển, định dạng mặc định của Trung tâm phần mềm GNOME)"

msgid "mime_snap"
msgstr "Gói ứng dụng Snap (Canonical ra mắt năm 2014, công ty mẹ của Ubuntu phát triển, định dạng ứng dụng Linux phổ thông. Cập nhật tự động, hộp cát cách ly, hỗ trợ 40+ bản phân phối Linux, định dạng mặc định của Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Gói phần mềm Debian (Debian Project ra mắt năm 1993, định dạng cài đặt tiêu chuẩn cho Debian/Ubuntu và các bản phái sinh. Quản lý bằng dpkg, APT là trình quản lý gói phía trước, một trong những định dạng gói trưởng thành nhất trong hệ sinh thái Linux, vẫn là chính thống trong hệ thống Debian đến nay)"

msgid "mime_rpm"
msgstr "Gói phần mềm RPM (Red Hat ra mắt năm 1997, định dạng tiêu chuẩn cho các bản phân phối như Red Hat/Fedora/CentOS/SUSE. RPM viết tắt của 'Red Hat Package Manager', cùng với DEB là hai định dạng gói chính của Linux, vẫn là chính thống trong hệ thống RHEL đến nay)"

msgid "mime_pacman"
msgstr "Gói phần mềm Arch (Arch Linux ra mắt năm 2002, định dạng .pkg.tar.zst được sử dụng bởi trình quản lý gói pacman. Cốt lõi của Arch Linux bản phát hành cuốn chiếu, nổi tiếng với sự đơn giản và nguyên tắc KISS, AUR (Kho lưu trữ người dùng Arch) là điểm đặc trưng)"

msgid "mime_exe"
msgstr "Tệp thực thi EXE (định dạng chương trình thực thi Windows, viết tắt của 'Executable'. Định dạng thực thi gốc của hệ điều hành Windows, chứa cấu trúc PE. Phát triển từ định dạng MZ của MS-DOS, Windows NT giới thiệu định dạng PE (Portable Executable) năm 1993 và sử dụng đến nay. Gói cài đặt phần mềm, ứng dụng, công cụ hệ thống đều sử dụng định dạng này. Người dùng nhấp đúp để chạy, là định dạng thực thi được sử dụng rộng rãi nhất trên thế giới)"

msgid "mime_dll"
msgstr "Thư viện liên kết động DLL (Microsoft ra mắt năm 1993, Dynamic Link Library. Thư viện mã chia sẻ của Windows, tải động khi chương trình chạy, tiết kiệm bộ nhớ và không gian đĩa. Thành phần hệ thống, plugin ứng dụng, trình điều khiển đều sử dụng định dạng DLL. Cách triển khai cốt lõi của Windows API, vấn đề DLL Hell đã được giảm nhẹ trong thời đại .NET)"

msgid "mime_com"
msgstr "Tệp thực thi COM (định dạng thực thi thời MS-DOS, viết tắt của 'Command'. Cấu trúc tệp đơn giản, giới hạn 64KB, định dạng chính trước Windows 3.x, đã bị loại bỏ. Windows hiện đại sử dụng định dạng EXE, phần mở rộng COM vẫn được dùng cho một số tệp thành phần)"

msgid "mime_aac"
msgstr "Âm thanh AAC (tiêu chuẩn MPEG năm 1997, Advanced Audio Coding. Người kế nhiệm MP3, chất lượng âm thanh tốt hơn MP3 ở cùng tốc độ bit, định dạng âm thanh mặc định của YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Âm thanh ALAC (Apple phát triển năm 2004, Apple Lossless Audio Codec. Định dạng không mất dữ liệu của Apple, mở nguồn năm 2011, định dạng mặc định cho âm thanh không mất dữ liệu trong iTunes và Apple Music)"

msgid "mime_flac"
msgstr "Âm thanh FLAC (Xiph.Org Foundation phát triển năm 2001, Free Lossless Audio Codec. Nén không mất dữ liệu, chất lượng âm thanh tương đương CD, tệp bằng khoảng một nửa WAV gốc. Mã nguồn mở miễn phí bản quyền, định dạng ưu tiên cho người đam mê âm thanh và sưu tầm nhạc số)"

msgid "mime_mp3"
msgstr "Âm thanh MP3 (Fraunhofer Institute phát triển năm 1993, MPEG-1 Audio Layer 3. Định dạng nén mất dữ liệu, tệp nhỏ chất lượng tạm được, định dạng cốt lõi của cuộc cách mạng nhạc số thập niên 2000, công thần của iPod và Napster. Bằng sáng chế hết hạn năm 2017, trở thành định dạng công cộng)"

msgid "mime_oga"
msgstr "Âm thanh Ogg Audio (Xiph.Org Foundation phát triển, định dạng âm thanh thuần túy của bộ chứa Ogg, sử dụng mã hóa Vorbis. Nguồn mở miễn phí bản quyền, hiệu quả nén tốt hơn MP3, được sử dụng rộng rãi trong các dự án nguồn mở)"

msgid "mime_ogg"
msgstr "Âm thanh OGG (Xiph.Org Foundation phát triển năm 2000, định dạng Ogg Vorbis. Nguồn mở miễn phí bản quyền, hiệu quả nén tốt hơn MP3, Spotify thời đầu sử dụng, được sử dụng rộng rãi trong hiệu ứng âm thanh game)"

msgid "mime_opus"
msgstr "Âm thanh Opus (IETF chuẩn hóa năm 2012, định dạng âm thanh nguồn mở miễn phí bản quyền, kết hợp công nghệ SILK và CELT, độ trễ cực thấp, hiệu quả nén cao nhất, định dạng âm thanh mặc định của WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Âm thanh WAV (Microsoft và IBM phát triển năm 1991, định dạng âm thanh gốc của Windows. Mã hóa PCM không nén, chất lượng không mất dữ liệu nhưng tệp rất lớn, định dạng chuẩn cho biên tập âm thanh chuyên nghiệp)"

msgid "mime_wma"
msgstr "Âm thanh WMA (Microsoft phát triển năm 1999, Windows Media Audio. Có cả phiên bản nén mất dữ liệu/không mất dữ liệu, hỗ trợ nguyên bản trong Windows, phổ biến cùng Windows Media Player. Hiện đã bị lép vế, thay thế bởi MP3/AAC)"

msgid "mime_dsf"
msgstr "Âm thanh DSF (định dạng Direct Stream Digital, Sony và Philips phát triển. Lấy mẫu tần số cao 1 bit, định dạng âm thanh DSD tiêu chuẩn, phiên bản số của SACD, định dạng âm thanh cao cấp cho người đam mê, tệp rất lớn)"

msgid "mime_ape"
msgstr "Âm thanh APE (được Monkey's Audio phát triển vào năm 2000, định dạng nén không mất dữ liệu. Tỷ lệ nén cao hơn FLAC nhưng mã hóa chậm hơn, vẫn được sử dụng trên nền tảng Windows và trong giới đam mê âm thanh)"

msgid "mime_mid"
msgstr "Âm thanh MIDI (Hiệp hội MIDI thiết lập năm 1983, Giao diện thiết bị âm nhạc kỹ thuật số. Định dạng bản nhạc chứ không phải ghi âm, tệp rất nhỏ, tiêu chuẩn cho nhạc cụ điện tử, nhạc chuông điện thoại, hiệu ứng âm thanh game. General MIDI được chuẩn hóa năm 1991, định nghĩa 128 âm sắc nhạc cụ)"

msgid "mime_m4a"
msgstr "Âm thanh M4A (MPEG-4 Audio, định dạng bộ chứa của AAC. Định dạng tiêu chuẩn của iTunes Music Store, định dạng âm thanh chính trong hệ sinh thái Apple, hỗ trợ bảo vệ DRM)"

msgid "mime_m3u"
msgstr "Danh sách phát M3U (định dạng danh sách phát URL MP3, tệp văn bản thuần, ghi đường dẫn tệp âm thanh. Tiêu chuẩn thời Winamp, dùng cho phát thanh trực tuyến, phát trực tuyến nhạc trực tuyến. M3U8 là phiên bản UTF-8 của nó, dùng cho HTTP Live Streaming)"

msgid "mime_asf"
msgstr "Đa phương tiện trực tuyến ASF (Microsoft phát triển năm 1996, Advanced Systems Format. Bộ chứa đa phương tiện Windows Media, hỗ trợ truyền tải đồng bộ âm thanh và video. Dùng cho phát trực tiếp trên internet và phát video theo yêu cầu, WMA/WMV đều dựa trên bộ chứa ASF)"

msgid "mime_avi"
msgstr "Video AVI (Microsoft ra mắt năm 1992, tiêu chuẩn video Windows thời kỳ đầu. 'Audio Video Interleave', lưu trữ xen kẽ âm thanh và video, định dạng video phổ biến nhất thập niên 1990-2000, nay bị thay thế bởi MP4/MKV)"

msgid "mime_divx"
msgstr "Video DivX (DivX Corporation phát triển năm 1998, định dạng mã hóa video dựa trên MPEG-4. Định dạng chia sẻ video trực tuyến chính thống thập niên 2000, công nghệ đầu tiên nén chất lượng DVD xuống kích thước CD. Do tranh chấp bản quyền, sau chuyển thành bộ mã hóa thương mại)"

msgid "mime_mp4"
msgstr "Video MP4 (tiêu chuẩn MPEG năm 2001, MPEG-4 Part 14. Định dạng video phổ biến nhất thế giới, hỗ trợ mã hóa H.264/H.265, định dạng mặc định cho video trên internet, quay điện thoại, YouTube)"

msgid "mime_m4v"
msgstr "Video M4V (định dạng video của iTunes, biến thể của MP4. Định dạng video trong hệ sinh thái Apple, định dạng tiêu chuẩn cho phim và chương trình truyền hình trên iTunes Store, hỗ trợ bảo vệ bản quyền DRM)"

msgid "mime_mpeg"
msgstr "Video MPEG (tổ chức MPEG thiết lập năm 1988, Nhóm chuyên gia hình ảnh chuyển động. Người đặt nền móng cho tiêu chuẩn nén video kỹ thuật số, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (video trực tuyến) có ảnh hưởng sâu sắc)"

msgid "mime_mkv"
msgstr "Video MKV (dự án Matroska phát triển năm 2002, định dạng bộ chứa đa phương tiện nguồn mở. Hỗ trợ nhiều luồng âm thanh, nhiều phụ đề, chương, 'công cụ bọc', định dạng ưu tiên cho chia sẻ phim độ phân giải cao)"

msgid "mime_mpg"
msgstr "Video MPEG (phần mở rộng video MPEG-1/MPEG-2, định dạng tiêu chuẩn cho VCD và DVD. Định dạng chính cho video trên đĩa thập niên 1990-2000, nay bị thay thế bởi H.264/H.265)"

msgid "mime_ogv"
msgstr "Video Ogg Video (Xiph.Org Foundation phát triển, định dạng video của bộ chứa Ogg, sử dụng mã hóa Theora. Nguồn mở miễn phí bản quyền, một trong những tiêu chuẩn đầu tiên của video HTML5, Firefox hỗ trợ nguyên bản)"

msgid "mime_ogx"
msgstr "Bộ chứa đa phương tiện Ogg (Xiph.Org Foundation phát triển, phần mở rộng phổ dụng của bộ chứa Ogg, có thể chứa nhiều luồng như âm thanh, video, phụ đề. Tiêu chuẩn đa phương tiện nguồn mở, dùng cho game, phát trực tuyến)"

msgid "mime_rm"
msgstr "Video RealMedia (RealNetworks phát triển năm 1995, định dạng RealMedia. Người tiên phong phát trực tuyến trên internet thập niên 1990-2000, định dạng cốt lõi của trình phát RealPlayer. Điểm yếu: cần trình phát riêng, chất lượng nén kém, sau bị Flash/MP4 thay thế)"

msgid "mime_flv"
msgstr "Video Flash (định dạng xuất hiện năm 2002, định dạng Flash Video. Từng là định dạng chính của video trực tuyến, YouTube thời đầu sử dụng. Điểm yếu: cần plugin Flash, hiệu suất kém, nhiều lỗ hổng bảo mật. Từ 2015 các trang web chính chuyển sang video HTML5, nay đã bị loại bỏ)"

msgid "mime_f4v"
msgstr "Video F4V (định dạng video Flash do Adobe phát triển, người kế nhiệm của FLV. Dựa trên tiêu chuẩn MPEG-4, hỗ trợ mã hóa H.264. Bị loại bỏ cùng với công nghệ Flash, Adobe ngừng hỗ trợ năm 2020)"

msgid "mime_wmv"
msgstr "Video WMV (Microsoft phát triển năm 1999, Windows Media Video. Hỗ trợ nguyên bản trong Windows, tối ưu cho truyền tải phát trực tuyến, định dạng phổ biến trong video trực tuyến thời kỳ đầu, nay đã bị lép vế)"

msgid "mime_wmf"
msgstr "Định dạng đa phương tiện WMF (Windows Media Format, khuôn khổ đa phương tiện của Microsoft, bao gồm video WMV, âm thanh WMA, Windows Media Player hỗ trợ nguyên bản)"

msgid "mime_mov"
msgstr "Video MOV (Apple phát triển năm 1991, định dạng bộ chứa QuickTime. Định dạng chuẩn cho dựng video chuyên nghiệp, hỗ trợ nhiều codec, Final Cut Pro, Premiere hỗ trợ nguyên bản)"

msgid "mime_qt"
msgstr "Video QuickTime (Apple ra mắt năm 1991, định dạng QuickTime. Tiêu chuẩn video trên nền tảng Mac, MOV là bộ chứa, trình phát QuickTime từng được sử dụng rộng rãi. Apple ngừng phát triển phiên bản Windows năm 2016, dần bị MP4 thay thế)"

msgid "mime_webm"
msgstr "Video WebM (Google ra mắt năm 2010, định dạng video nguồn mở miễn phí bản quyền. Dựa trên bộ chứa Matroska, mã hóa VP8/VP9, định dạng video HTML5 tiêu chuẩn, định dạng phát mặc định của YouTube trên web)"

msgid "mime_3gp"
msgstr "Video 3GP (3GPP thiết lập năm 2000, định dạng video cho thiết bị di động. Tệp rất nhỏ, chất lượng hình ảnh thấp, định dạng quay video của điện thoại chức năng đời đầu, dùng để gửi MMS)"

