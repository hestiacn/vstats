#------------------------------------------------------------------------------
# Opis formata
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Tekstualni fajl (standardizovan ASCII 1963. godine, običan tekst bez formatiranja. Osnova izvornog koda, konfiguracionih fajlova i logova. Unix koristi LF, Windows koristi CRLF za novi red, i dalje najčešći format podataka na računaru)"

msgid "mime_log"
msgstr "Log fajl (običan tekstualni fajl koji beleži sistemske podatke, informacije o radu aplikacija, koristi se za rešavanje problema, analizu performansi, bezbednosnu reviziju. Standardni formati kao Apache combined log, Nginx access log, syslog itd.)"

msgid "mime_page"
msgstr "HTML veb stranica (Tim Berners-Li je izumeo World Wide Web 1989. godine, 1990. definisao tri tehnologije HTML/HTTP/URL, besplatno ih ponudio bez patenta. HTML5 je postao W3C standard 2014. godine, podržava prikaz, multimediju i štampanje. Dobitnik Turingove nagrade 2016. godine)"

msgid "mime_khtml"
msgstr "KHTML veb stranica motor (objavljen u KDE 2.0 1998. godine, motor za prikazivanje Konqueror pretraživača. Apple je stvorio WebKit na osnovu KHTML-a 2001. Google je stvorio Blink iz WebKit-a 2008. godine, postao jezgro pretraživača Chrome, Edge, Safari. KHTML je uzor zajednice otvorenog koda koji je postavio temelje za moderne motore pretraživača, čije tehnološko nasleđe se nastavlja kroz WebKit/Blink)"

msgid "mime_script"
msgstr "Dinamički skript (interpretirani jezik, ne zahteva kompilaciju. Uključuje ASP, JSP, CGI, ColdFusion, Tcl, VBScript itd., široko korišćen u ranom razvoju veba, upravljanju sistemom, automatskim zadacima. Moderni skript jezici kao Python, Ruby, JavaScript razvili su se u glavne jezike za full-stack razvoj)"

msgid "mime_js"
msgstr "JavaScript skript (Brendan Eich je stvorio za 10 dana u Netscape-u 1995. godine, izvorni programski jezik pretraživača. ECMAScript je standardizovan 1997. Node.js je rođen 2009. i pretvorio ga je u full-stack jezik. npm je najveći menadžer paketa na svetu. Godinama uzastopno najpopularniji programski jezik na GitHub-u)"

msgid "mime_py"
msgstr "Python skript (Guido van Rossum je stvorio 1991. godine, poznat po obaveznom uvlačenju, jednostavnoj sintaksi. Široko korišćen u veb razvoju, nauci o podacima, veštačkoj inteligenciji, automatskim operacijama. Višestruki dobitnik TIOBE nagrade za programski jezik godine)"

msgid "mime_sh"
msgstr "Shell skript (Unix je rođen 1971. godine, jezik za komandne skripte. Koristi se za upravljanje sistemom, automatske zadatke, pokretanje usluga, skripte za postavljanje. Neophodna veština za administraciju Linux-a)"

msgid "mime_rb"
msgstr "Ruby skript (Yukihiro Matsumoto je stvorio 1995. godine, fokusira se na sreću programera. Ruby on Rails okvir je započeo paradigmu razvoja 'konvencije umesto konfiguracije', utičući na dizajn modernih veb okvira)"

msgid "mime_pl"
msgstr "Perl skript (Larry Wall je stvorio 1987. godine, poznat po pragmatičnosti, nazivan 'švajcarski vojni nož'. CPAN je pionir modernih menadžera paketa za jezike, ima dubok uticaj u obradi teksta, upravljanju sistemom i CGI-ju)"

msgid "mime_php"
msgstr "PHP dinamička veb stranica (Rasmus Lerdorf je stvorio 1995. godine, posebno dizajniran za veb razvoj. Preko 70% veb sajtova u svetu ga koristi, pokreće platforme kao WordPress, Facebook, Wikipedia. PHP 8 uvodi JIT kompilaciju, značajno poboljšava performanse)"

msgid "mime_image"
msgstr "Fajl slike"

msgid "mime_document"
msgstr "Fajl dokumenta"

msgid "mime_package"
msgstr "Softverski paket"

msgid "mime_archive"
msgstr "Gzip kompresovani fajl (GNU projekat 1992. godine, zasnovan na DEFLATE algoritmu. Koristi se na web-u za kompresiju dinamičkog sadržaja odgovora, stopa kompresije je obično 60-90%. Nakon 2015. u nekim slučajevima zamenjen Brotli-jem, ali je i dalje najšire podržani format kompresije na strani servera)"

msgid "mime_audio"
msgstr "Audio fajl"

msgid "mime_video"
msgstr "Video fajl"

msgid "mime_jscript"
msgstr "JavaScript (razvio Brendan Eich 1995. godine)"

msgid "mime_json"
msgstr "JSON podaci (Douglas Crockford je predložio 2001. godine, lagani format za razmenu podataka, stvarni standard za Web API)"

msgid "mime_vbs"
msgstr "VBScript (Microsoft razvio 1996. godine, Windows skript jezik, koristi se za ASP veb stranice i Windows skripte za upravljanje. Širenjem PowerShell-a i JavaScript-a, postepeno se napušta)"

msgid "mime_conf"
msgstr "Konfiguracioni fajl (čuva konfiguraciju softvera u tekstualnom formatu, uobičajeni formati: INI, JSON, YAML, TOML, XML. Konfiguracija Linux sistema je uglavnom u /etc direktorijumu)"

msgid "mime_css"
msgstr "CSS stilski list (W3C je objavio CSS1 prvi zvanični standard u decembru 1996. godine, CSS2 je dodao pozicioniranje i tipove medija 1998. godine, od 2011. CSS3 modularni uvodi zaobljenje uglova, animaciju, fleksibilnu kutiju, mrežni raspored i responzivni dizajn. Zajedno sa HTML-om i JavaScript-om jedna je od tri glavne tehnologije front-enda, svi moderni pretraživači (Chrome, Firefox, Safari, Edge) ga podržavaju izvorno, jedini je standard za definisanje stila veb stranica)"

msgid "mime_xsl"
msgstr "XSL stilski list (W3C standard iz 1999. godine, jezik za transformaciju XML dokumenata, može pretvoriti XML u HTML/PDF/tekst. Upotreba opada nakon širenja JSON-a)"

msgid "mime_runtime"
msgstr "Izvršni fajl (izvršni format operativnog sistema kao EXE, ELF, Mach-O, sadrži mašinski kod i informacije o učitavanju)"

msgid "mime_library"
msgstr "Bibliotečki fajl (DLL, SO, dylib itd. dinamički povezane biblioteke, deljeni kod koji se učitava tokom rada programa)"

msgid "mime_swf"
msgstr "Flash animacija (Macromedia razvila 1996., kasnije u vlasništvu Adobe-a. Standard interaktivne veb animacije, nekada je dominirao igrama i animacijama na internetu. Slabosti: zavisnost od dodatka, nedostatak podrške za mobilne uređaje, visok bezbednosni rizik. Adobe je najavio ukidanje 2017., potpuno obustavio podršku 2020., zamenjen HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD (definicija tipa dokumenta) (specifikacija XML-a, definiše strukturu XML dokumenta, koristi se za proveru ispravnosti XML-a)"

msgid "mime_csv"
msgstr "CSV format podataka (vrednosti odvojene zarezom, uobičajeni tablični format podataka, standard za uvoz/izvoz Excel-a i baza podataka)"

msgid "mime_jnlp"
msgstr "Java Web Start (pokretač Java aplikacija, tehnologija za distribuciju Java desktop aplikacija 2000-ih, sada ukinuta)"

msgid "mime_lit"
msgstr "Microsoft Reader e-knjiga (Microsoft je lansirao 2000. godine, LIT format, ukinut)"

msgid "mime_svg"
msgstr "SVG vektorska grafika (W3C standard iz 1999. godine, zbog dugog promovisanja sopstvenog VML formata od strane Microsofta, IE pretraživač je podržavao tek do 2011. godine, što je usporilo širenje. Nakon 2015. kada je IE ukinut i sa širenjem ekrana visoke rezolucije, postao je preferirani format za ikone i logotipe)"

msgid "mime_ai"
msgstr "Adobe Illustrator vektorska grafika (lansirana 1987. godine, industrijski standardni vektorski grafički format, preferirani za dizajn štampe, logotipe, ikone)"

msgid "mime_phshop"
msgstr "Photoshop slika (Adobe je lansirao 1990. godine, originalni format fajla Photoshop-a PSD, industrijski standard za obradu slika)"

msgid "mime_ttf"
msgstr "TrueType font (Apple i Microsoft su zajedno razvili 1989. godine, vektorski font format, prikaz na ekranu i štampa su isti, podrazumevani font format modernih operativnih sistema)"

msgid "mime_fon"
msgstr "WOFF2 veb font (W3C preporučuje 2014. godine, koristi Brotli algoritam kompresije, veličina se smanjuje za oko 30% u odnosu na stari WOFF i za preko 50% u odnosu na TTF/OTF, svi moderni pretraživači ga podržavaju, preferirani format za moderne veb fontove, podržan od strane preko 98% pretraživača)"

msgid "mime_pdf"
msgstr "PDF dokument (Adobe je razvio 1993. godine, postao ISO standard 2008. godine. Višeplatformski format dokumenta, održava doslednost formata, globalni standard za distribuciju elektronskih dokumenata)"

msgid "mime_dotnet"
msgstr "ASP.NET dinamička stranica (Microsoft lansirao 2002. godine, tehnologija dinamičkih veb stranica na Windows platformi, deo .NET Framework-a)"

msgid "mime_mdb"
msgstr "Access baza podataka (Microsoft Access fajl baze podataka, lansiran 1992. godine, rešenje za desktop bazu podataka na Windows-u)"

msgid "mime_md"
msgstr "Markdown dokument (John Gruber je stvorio 2004. godine, dizajn sintakse je pod uticajem reStructuredText i Setext-a. Osnovna filozofija dizajna je 'čitljivost znači mogućnost renderovanja'. Originalna implementacija Markdown.pl koristi Perl regularne izraze. Izvedene specifikacije uključuju GFM (2013), CommonMark (2017), Pandoc Markdown itd. Pokreće ekosisteme kao GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, postajući de facto standardni format za generatore statičkih veb sajtova i dokumentaciju programera)"

msgid "mime_crystal"
msgstr "Crystal Reports format izveštaja (SAP izveštaj poslovne inteligencije, standardni korporativni format izveštaja)"

msgid "mime_libreoffice"
msgstr "LibreOffice dokument (The Document Foundation razvio 2010. godine, grana OpenOffice-a, implementacija ODF standarda, mainstream kancelarijski paket otvorenog koda)"

msgid "mime_encrypt"
msgstr "Šifrovani fajl (potrebno je dešifrovati da bi se fajl video, uobičajene ekstenzije: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS podaci o putanji (format za razmenu GPS-a, beleži podatke o geografskoj lokaciji, uobičajeni format za sportske satove i navigacione uređaje)"

msgid "mime_diskimage"
msgstr "Disk slika (fajlovi slike diska/CD-ROM-a kao DMG, ISO, IMG, koriste se za distribuciju softvera ili rezervnu kopiju medija za skladištenje)"

msgid "mime_vm"
msgstr "Slika virtuelne mašine (fajlovi virtuelnog diska kao VMDK, VDI, VHDX, OVA, format za platforme za virtuelizaciju kao VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent fajl semena (Bram Cohen je izumeo 2001. godine, indeksni fajl za P2P preuzimanje, sadrži metapodatke fajla i informacije o Tracker-u)"

msgid "mime_gis"
msgstr "GIS podaci geografskog informacionog sistema (geoprostorni podaci kao Shapefile, GeoJSON, koriste se za mape i prostornu analizu)"

msgid "mime_ebook"
msgstr "E-knjiga (formati e-knjiga kao EPUB, MOBI, AZW. EPUB je međunarodni standard, MOBI/AZW su formati za Amazon Kindle)"

msgid "mime_avif"
msgstr "AVIF slika (Alliance for Open Media lansirao 2019. godine, zasnovan na AV1 kodeku, stopa kompresije je 50% veća od WebP-a, nova generacija standarda za veb slike)"

msgid "mime_markdown"
msgstr "Markdown dokument (John Gruber je dizajnirao 2004. godine, lagani jezik za obeležavanje, uobičajeni format za README na GitHub-u, tehničku dokumentaciju, postove na forumima)"

msgid "mime_yaml"
msgstr "YAML konfiguracija (Clark Evans je dizajnirao 2001. godine, ljudski čitljiv format za serijalizaciju podataka, standard za konfiguracione fajlove za Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML konfiguracija (Tom Preston-Werner je dizajnirao 2013. godine, 'Tom's Obvious Minimal Language', format konfiguracionog fajla za moderne alate kao Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue komponentna datoteka (Evan You, 2014. Progresivni JavaScript okvir. Putem jednodatotečnih komponenti (SFC) savršeno objedinjuje HTML, CSS i JS, značajno povećavajući efikasnost razvoja. Jedan je od najpopularnijih frontend okvira na svetu. Takođe, kao jezgro modernih generatora statičkih stranica poput VitePress-a, široko se koristi za pokretanje interaktivne tehničke dokumentacije i blogova.)"

msgid "mime_wasm"
msgstr "WebAssembly modul (W3C standard iz 2017. godine, izvršni format visokih performansi u pretraživaču, C/C++/Rust/R mogu se kompajlirati kao cilj, performanse bliske izvornim)"

msgid "mime_jsx"
msgstr "React JSX komponenta (Facebook je lansirao JavaScript XML 2013. godine, sintaksa komponente React okvira, inovativna paradigma koja unosi HTML u JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX komponenta (Microsoft razvio 2012. godine, TypeScript + JSX, standardni način pisanja za tipski bezbedan React razvoj)"

msgid "mime_heif"
msgstr "HEIF slika (MPEG standard iz 2015. godine, visokoefikasni format fajla za slike, široko korišćen u Apple ekosistemu)"

msgid "mime_heic"
msgstr "HEIC slika (Apple-ova implementacija HEIF-a, podrazumevani format fotografije za iPhone, podržan izvorno na iOS/macOS-u)"

msgid "mime_gltf"
msgstr "GLTF 3D model (GL format za prenos, 'JPEG 3D sveta', Khronos Group objavio 2015. godine, standardni Web 3D format)"

msgid "mime_glb"
msgstr "GLB binarni 3D model (binarna verzija GLTF-a, jedan fajl sadrži sve resurse, koristi se za distribuciju 3D scena)"

msgid "mime_gls"
msgstr "GLOSSARY rečnik (fajl sa definicijama termina, koristi se za upravljanje terminima u sistemu dokumentacije)"

msgid "mime_cbz"
msgstr "CBZ strip knjiga (komprimovane strip slike sa ZIP-om, uobičajeni format za kolekcionisanje stripova)"

msgid "mime_cbr"
msgstr "CBR strip knjiga (komprimovane strip slike sa RAR-om, uobičajeni format za kolekcionisanje stripova)"

msgid "mime_fb2"
msgstr "FB2 e-knjiga (FictionBook 2.0, ruski format e-knjige, XML struktura, široko podržan od strane čitača otvorenog koda)"

msgid "mime_kepub"
msgstr "KEPUB e-knjiga (poseban EPUB format za Kobo, format optimizovan za Kobo čitač e-knjiga)"

msgid "mime_m4b"
msgstr "M4B audio knjiga (MPEG-4 format audio knjige, podržava oznake, format audio knjige na iTunes-u)"

msgid "mime_kfx"
msgstr "Kindle KFX format (Amazon lansirao 2015. godine, poseban format e-knjige za Kindle, podržava napredni raspored i brzo listanje stranica)"

msgid "mime_chm"
msgstr "CHM fajl pomoći (Microsoft lansirao 1997. godine, kompilirani HTML format pomoći, standard za dokumentaciju pomoći za Windows softver)"

msgid "mime_mht"
msgstr "MHT veb arhiva (Microsoft lansirao 1999. godine, format veb stranice u jednom fajlu, format za čuvanje veb stranica IE pretraživača)"

msgid "mime_wml"
msgstr "WML jezik za obeležavanje bežičnih uređaja (WAP standard iz 1999. godine, korišćen za veb stranice ranih funkcionalnih telefona, ukinut)"

msgid "mime_xhtml"
msgstr "XHTML veb stranica (W3C standard iz 2000. godine, XML verzija HTML-a, strožija sintaksa. W3C je obustavio održavanje 2009. godine, preusmerio fokus na HTML5)"

msgid "mime_xml"
msgstr "XML dokument (W3C standard iz 1998. godine, proširivi jezik za obeležavanje, osnovni format za veb usluge, konfiguracione fajlove, razmenu podataka)"

msgid "mime_sgml"
msgstr "SGML dokument (ISO standard iz 1986. godine, prethodnik HTML-a, standardni opšti jezik za obeležavanje, XML i HTML potiču od SGML-a)"

msgid "mime_apng"
msgstr "APNG animacija (Mozilla razvila 2004. godine, animaciono proširenje PNG-a, moderna alternativa GIF-u, podržava prave boje i providnost)"

msgid "mime_bmp"
msgstr "BMP rasterska slika (Windows rasterski format, izvorno podržan od Windows 1.0. Nekomprimovan, velika veličina datoteke, ali zbog jednostavne strukture i nedostatka potrebe za dodatnim kodeksima, i dalje se koristi u alatu za isecanje Windows 11, programu Paint, resursima ikona u EXE/MSI instalacionim paketima, datotekama kursora i nekim starijim drajverima. Pri istom kvalitetu slike, veličina datoteke je oko 3-10 puta veća od PNG. U većini slučajeva zamenjen je sa PNG/JPEG, ali Windows ekosistem i dalje zadržava široku kompatibilnost)"

msgid "mime_cdr"
msgstr "CDR vektorska grafika (specifični format CorelDRAW-a, kanadska kompanija Corel, softver za dizajn vektorske grafike)"

msgid "mime_gif"
msgstr "GIF slika (CompuServe razvio 1987. godine, 256-boja animirani format slike. Slabosti: malo boja, grub kvalitet slike, ne podržava providnost, veliki fajl, niska frekvenca okvira. Zamenjen modernim animiranim formatima slike kao APNG, WebP)"

msgid "mime_ico"
msgstr "ICO ikona (Windows format ikona, podržava višestruke rezolucije, standardni format favicon-a za veb sajtove)"

msgid "mime_jpeg"
msgstr "JPEG slika (ISO standard iz 1992. godine, format kompresije sa gubitkom za fotografije, stvarni standard za fotografije na internetu)"

msgid "mime_jpg"
msgstr "JPEG slika (ISO standard iz 1992. godine, format kompresije sa gubitkom za fotografije, stvarni standard za fotografije na internetu)"

msgid "mime_png"
msgstr "PNG slika (W3C preporučio 1996. godine, podržava prave boje i providnost, statička alternativa GIF-u, standard za slike bez gubitka na internetu)"

msgid "mime_ps"
msgstr "PostScript fajl za opis stranice (Adobe lansirao 1985. godine, jezik za opis stranice, prethodnik PDF-a, koristi se za štampanje i izdavaštvo)"

msgid "mime_psb"
msgstr "PSB veliki dokument (Adobe Photoshop format za izuzetno velike slike, podržava džinovske slike veće od 2 GB ili 30000 piksela)"

msgid "mime_psd"
msgstr "PSD slika (originalni fajl Adobe Photoshop-a, podržava slojeve, kanale, putanje, industrijski standardni format za obradu slika)"

msgid "mime_webp"
msgstr "WebP slika (Google razvio 2010. godine, veb format slike, podržava kompresiju sa gubitkom/bez gubitka i animaciju, stopa kompresije je 25-35% veća od PNG i 25% veća od JPEG-a)"

msgid "mime_woff"
msgstr "WOFF veb font (stvoren 2009. godine, W3C standard iz 2018. godine. Komprimovan na bazi TrueType/OpenType, optimizovan za učitavanje veb fontova, standardni format za ikonske fontove modernih veb sajtova)"

msgid "mime_7z"
msgstr "7z kompresovani fajl (Igor Pavlov razvio 1999. godine, specifični format programa 7-Zip. LZMA algoritam, visoka stopa kompresije, otvorenog koda i besplatan. 7z format je pri istoj stopi kompresije obično 30-50% manji od ZIP-a, uobičajeni format za zajednicu otvorenog koda i distribuciju softvera)"

msgid "mime_ace"
msgstr "ACE kompresovani fajl (razvijen 1990-ih, format programa WinACE. Nekada se takmičio sa RAR-om, stopa kompresije je bila prilično visoka. Razvoj obustavljen 2007. godine, sada zamenjen 7z/RAR-om, retko se koristi)"

msgid "mime_bz2"
msgstr "BZIP2 kompresovani fajl (Julian Seward razvio 1996. godine, algoritam za sortiranje blokova. Stopa kompresije je 15-20% veća od GZIP-a ali sporiji. Uobičajeni format za izvorni kod Linux kernela, softverske pakete otvorenog koda, ekstenzija .bz2)"

msgid "mime_cab"
msgstr "CAB kompresovani fajl (Microsoft razvio 1995. godine, Cabinet format. Format instalacionog paketa za Windows, koristi se za drajvere, distribuciju sistemskih fajlova. Windows Installer (MSI) interno koristi CAB za čuvanje fajlova)"

msgid "mime_dmg"
msgstr "DMG disk slika (Apple lansirao 1980-ih, Disk Image format. Standardni format za distribuciju softvera za macOS, dvostruki klik za montiranje kao virtuelni disk, prevucite i otpustite da biste instalirali aplikaciju. Podržava kompresiju i šifrovanje, glavni je format za preuzimanje softvera za Mac)"

msgid "mime_emz"
msgstr "EMZ kompresovana slika (Windows kompresovana poboljšana metadatoteka, kompresovana verzija EMF-a. Format za skladištenje vektorske grafike u Office dokumentima, u suštini je EMF fajl kompresovan sa GZIP-om)"

msgid "mime_gz"
msgstr "GZIP kompresovani fajl (Jean-loup Gailly i Mark Adler razvili 1992. godine, GNU projekat. Standardni alat za kompresiju na Unix/Linux-u, uobičajeni format za kompresiju HTTP prenosa. Ekstenzija .gz, često se koristi u kombinaciji sa TAR-om)"

msgid "mime_jar"
msgstr "JAR kompresovani fajl (Sun Microsystems lansirao 1997. godine, Java ARchive format. U suštini je ZIP fajl, koristi se za pakovanje Java biblioteka i aplikacija. Glavni format Java ekosistema kao Maven, Gradle. Android takođe koristi JAR)"

msgid "mime_lzma"
msgstr "LZMA kompresovani fajl (Igor Pavlov razvio 1998. godine, Lempel-Ziv-Markov chain algoritam. Glavni kompresioni algoritam 7z formata, visoka stopa kompresije, brzina dekompresije brza. Koristi se za distribuciju firmvera i softvera za ugrađene sisteme)"

msgid "mime_rar"
msgstr "RAR kompresovani fajl (Eugene Roshal razvio 1993. godine, Roshal ARchive format. Visoka stopa kompresije, podržava deljenje po tomovima i zapise za oporavak. Format programa WinRAR, stopa kompresije je bolja od ZIP-a ali zahteva plaćeni softver, alati otvorenog koda kao unrar mogu da dekompresuju)"

msgid "mime_tar"
msgstr "TAR arhivski fajl (Unix V7 uveo 1979. godine, Tape ARchive format. Trakasta arhiva, ne komprimuje samo pakuje, često se koristi u kombinaciji sa GZIP/BZIP2/XZ. Izvorni kod Linux paketa, skladištenje slojeva Docker slika koriste TAR format)"

msgid "mime_tgz"
msgstr "TGZ kompresovani fajl (kombinovani format TAR + GZIP, ekstenzija .tgz ili .tar.gz. Najčešći format za distribuciju softverskih paketa za Unix/Linux, paketi izvornog koda, binarni paketi, široko korišćen, predstavnik 'dekompresuj i koristi')"

msgid "mime_tbz2"
msgstr "TBZ2 kompresovani fajl (kombinovani format TAR + BZIP2, ekstenzija .tbz2 ili .tar.bz2. Stopa kompresije je 15-20% veća od TGZ-a, pogodan za distribuciju velikih fajlova, Linux kernel dugo koristi ovaj format)"

msgid "mime_xz"
msgstr "XZ kompresovani fajl (lansiran 2009. godine, zasnovan na LZMA2 algoritmu. Izuzetno visoka stopa kompresije, 30-50% veća od GZIP-a, brzina dekompresije relativno brza. Linux kernel, menadžeri paketa (kao unutar .deb fajlova Debian-a) široko koriste, preporučeni format u trenutnom Linux ekosistemu)"

msgid "mime_z"
msgstr "Z kompresovani fajl (format komande Unix compress iz 1985. godine, LZW algoritam. Rani Unix format kompresije, zamenjen GZIP-om. Ekstenzija .Z, retko se koristi u modernim sistemima)"

msgid "mime_zip"
msgstr "ZIP kompresovani fajl (Phil Katz razvio 1989. godine, PKZIP format. Izvorno podržan na Windows-u, najčešći format kompresije na internetu. Podržava više fajlova, strukturu direktorijuma, može se birati algoritam kompresije. JAR od Java, APK od Android-a, DOCX/XLSX Office dokumenata zasnovani su na ZIP formatu)"

msgid "mime_zst"
msgstr "Zstandard kompresovani fajl (Facebook razvio 2015. godine, dizajnirao Yann Collet. Algoritam kompresije velike brzine, stopa kompresije bliska LZMA-i, brzina mnogo veća od GZIP-a. Linux kernel 5.9+ podržava, Arch Linux pacman, Debian APT postepeno usvajaju, nova generacija standarda kompresije)"

msgid "mime_lz4"
msgstr "LZ4 kompresovani fajl (Yann Collet razvio 2011. godine, izuzetno brz algoritam kompresije. Brzina kompresije je više od 10 puta brža od GZIP-a, pogodan za scenarije kompresije u realnom vremenu. Linux kernel, OpenZFS, Hadoop široko koriste, prvi izbor za scenarije gde je brzina prioritet)"

msgid "mime_lzo"
msgstr "LZO kompresovani fajl (Markus Oberhumer razvio 1996. godine, Lempel-Ziv-Oberhumer algoritam. Brzina dekompresije je izuzetno brza, stopa kompresije je prosečna. Linux kernel Squashfs, OpenWrt firmver koriste, pogodan za ugrađene sisteme)"

msgid "mime_msi"
msgstr "MSI instalacioni paket (Microsoft lansirao 1999. godine, Windows Installer format paketa. Standardni format za instalaciju Windows aplikacija, podržava vraćanje transakcija, upravljanje komponentama, tihu instalaciju. Prvi izbor za distribuciju softvera na nivou preduzeća, još uvek je glavni za instalaciju Windows softvera do danas)"

msgid "mime_pkg"
msgstr "PKG instalacioni paket (macOS format instalacionog paketa za aplikacije, zasnovan na Apple-ovoj Installer tehnologiji. Standardni format za distribuciju softvera na macOS-u, podržava izbor komponenti, skripte za instalaciju, funkciju deinstalacije. Dvostruki klik na .pkg fajl za instalaciju, uobičajeni metod distribucije za softver van Mac App Store-a)"

msgid "mime_apk"
msgstr "APK Android aplikacijski paket (Google ga je predstavio 2008. godine, tradicionalni format instalacije za Android aplikacije. APK je u suštini ZIP paket koji sadrži kod, resurse i manifest fajl. Od 2021. Google Play zahteva da nove aplikacije koriste AAB format, ali APK se i dalje koristi za otklanjanje grešaka, prodavnice trećih strana i bočno učitavanje)"

msgid "mime_ipa"
msgstr "IPA iOS aplikacijski paket (iOS App Store Package, format instalacije za iOS/iPadOS aplikacije. Predstavljen 2008. sa iPhone SDK-om. Mora se distribuirati putem App Store-a ili biti potpisan sertifikatom preduzeća. Sadrži izvršnu datoteku, resurse, Info.plist i informacije o potpisu)"

msgid "mime_hap"
msgstr "HAP HarmonyOS aplikacijski paket (HarmonyOS Ability Package, osnovna jedinica HarmonyOS aplikacije. Predstavljen 2020. sa HarmonyOS 2.0. Podržava dva tipa: entry i feature, format distribucije za Huawei telefone, tablete, pametne satove i druge HarmonyOS uređaje)"

msgid "mime_har"
msgstr "HAR HarmonyOS statička deljena biblioteka (HarmonyOS Archive, statička deljena biblioteka HarmonyOS-a, može se deliti između više HAP paketa, koristi se za razvoj zasnovan na komponentama i ponovnu upotrebu modula)"

msgid "mime_aab"
msgstr "Android App Bundle (Google lansirao 2018. godine, od 2021. Google Play obavezuje nove aplikacije da koriste ovaj format. AAB je format za distribuciju, Google Play generiše optimizovane APK prema konfiguraciji uređaja (CPU arhitektura, gustina ekrana, jezik), veličina paketa se u proseku smanjuje za 35%. Programeri otpremaju AAB, korisnici preuzimaju APK)"

msgid "mime_xapk"
msgstr "XAPK aplikacijski paket (ekstenzijski paket Android aplikacija treće strane, sadrži APK + OBB fajlove sa podacima. Koristi se za velike igre i složene aplikacije, rešava ograničenje od 100MB za jedan APK fajl. Obično se nalazi u prodavnicama aplikacija treće strane kao APKPure, APKMirror, nije zvanični Google format)"

msgid "mime_appx"
msgstr "Windows aplikacijski paket (Microsoft lansirao 2012. godine, format za instalaciju aplikacija za Windows 8/10/11. Podržava UWP aplikacije i konverziju desktop aplikacija, distribuira se preko Microsoft Store-a. 2024. Microsoft je lansirao MSIX kao format naslednika, postepeno zamenjuje APPX)"

msgid "mime_msix"
msgstr "MSIX aplikacijski paket (Microsoft lansirao 2018. godine, nova generacija formata za pakovanje Windows aplikacija. Kombinuje prednosti APPX i MSI, podržava sve tipove Windows aplikacija, može se distribuirati preko Microsoft Store-a ili bočnim učitavanjem, preporučeni format za Windows 11)"

msgid "mime_appimage"
msgstr "AppImage aplikacijski paket (lansiran 2004. godine, Linux format aplikacije bez instalacije. 'Jedna aplikacija - jedan fajl', radi direktno bez instalacije, podržava većinu Linux distribucija, uobičajeni metod za programere da distribuiraju Linux softver)"

msgid "mime_flatpak"
msgstr "Flatpak aplikacijski paket (lansiran 2015. godine, Linux format aplikacije u peskovniku. Radi kroz distribucije, izolovan od host sistema, razvoj vođen od strane Fedora, Red Hat-a, podrazumevani format GNOME softverskog centra)"

msgid "mime_snap"
msgstr "Snap aplikacijski paket (Canonical lansirao 2014. godine, matična kompanija Ubuntu-a razvila, opšti Linux format aplikacije. Automatsko ažuriranje, izolacija u peskovniku, podržava 40+ Linux distribucija, podrazumevani format Ubuntu softverskog centra)"

msgid "mime_deb"
msgstr "Debian softverski paket (Debian projekat lansirao 1993. godine, standardni format za instalaciju za Debian/Ubuntu i njihove izvedenice. Upravlja se pomoću dpkg-a, APT je njegov menadžer paketa front-end, jedan od najzrelijih paketnih formata u Linux ekosistemu, još uvek je glavni u Debian porodici do danas)"

msgid "mime_rpm"
msgstr "RPM softverski paket (Red Hat lansirao 1997. godine, standardni format za distribucije kao Red Hat/Fedora/CentOS/SUSE. RPM je skraćenica od 'Red Hat Package Manager', zajedno sa DEB-om jedan od dva glavna paketna formata Linux-a, još uvek je glavni u RHEL porodici do danas)"

msgid "mime_pacman"
msgstr "Arch softverski paket (Arch Linux lansirao 2002. godine, .pkg.tar.zst format koji koristi menadžer paketa pacman. Jezgro Arch Linux rolling release-a, poznat po svojoj jednostavnosti i KISS principu, AUR (Arch korisničko skladište) je njegova karakteristika)"

msgid "mime_exe"
msgstr "EXE izvršni fajl (Windows izvršni programski format, skraćenica od 'Executable'. Izvorni izvršni format operativnog sistema Windows, sadrži PE strukturu. Evoluirao iz MZ formata MS-DOS-a, Windows NT je uveo PE (Prenosivi izvršni) format 1993. godine i koristi se do danas. Paketi za instalaciju softvera, aplikacije, sistemski alati koriste ovaj format. Korisnik dvostruko klikće da bi ga pokrenuo, najšire korišćeni izvršni format na svetu)"

msgid "mime_dll"
msgstr "DLL dinamički povezana biblioteka (Microsoft uveo 1993. godine, Dynamic Link Library. Deljena kodna biblioteka Windows-a, dinamički se učitava tokom rada programa, štedi memoriju i prostor na disku. Sistemske komponente, dodaci za aplikacije, drajveri koriste DLL format. Glavni metod implementacije Windows API-ja, problem DLL Hell je ublažen u .NET eri)"

msgid "mime_com"
msgstr "COM izvršni fajl (izvršni format iz MS-DOS ere, skraćenica od 'Command'. Jednostavna struktura fajla, ograničenje od 64KB, glavni format pre Windows 3.x, ukinut. Moderni Windows koristi EXE format, COM ekstenzija se i dalje koristi za neke komponentne fajlove)"

msgid "mime_aac"
msgstr "AAC audio (MPEG standard iz 1997. godine, Advanced Audio Coding. Naslednik MP3-a, kvalitet zvuka je bolji od MP3 pri istoj brzini prenosa, podrazumevani audio format YouTube-a, iTunes-a, Nintendo Switch-a)"

msgid "mime_alac"
msgstr "ALAC audio (Apple razvio 2004. godine, Apple Lossless Audio Codec. Apple-ov format bez gubitaka, postao otvorenog koda 2011. godine, podrazumevani format za audio bez gubitaka u iTunes-u i Apple Music-u)"

msgid "mime_flac"
msgstr "FLAC audio (Xiph.Org Foundation razvio 2001. godine, Free Lossless Audio Codec. Kompresija bez gubitaka, kvalitet zvuka jednak CD-u, veličina fajla je oko polovine originalnog WAV-a. Otvorenog koda i bez patenata, preferirani format za audiofile i kolekcionisanje digitalne muzike)"

msgid "mime_mp3"
msgstr "MP3 audio (Fraunhofer Institute razvio 1993. godine, MPEG-1 Audio Layer 3. Format kompresije sa gubitkom, mali fajl pristojnog kvaliteta zvuka, glavni format digitalne muzičke revolucije 2000-ih, zaslužan za iPod i Napster. Patenti su istekli 2017. godine, postao javni domen format)"

msgid "mime_oga"
msgstr "Ogg Audio audio (razvio Xiph.Org Foundation, čisti audio format Ogg kontejnera, koristi Vorbis kodiranje. Otvorenog koda i bez patenata, efikasnost kompresije bolja od MP3-a, široko korišćen u projektima otvorenog koda)"

msgid "mime_ogg"
msgstr "OGG audio (Xiph.Org Foundation razvio 2000. godine, Ogg Vorbis format. Otvorenog koda i bez patenata, efikasnost kompresije bolja od MP3-a, rani Spotify ga je koristio, široko korišćen u zvučnim efektima za igre)"

msgid "mime_opus"
msgstr "Opus audio (IETF standardizovao 2012. godine, audio format otvorenog koda bez patenata, kombinacija SILK i CELT tehnologija, veoma nisko kašnjenje, najveća efikasnost kompresije, podrazumevani audio format WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV audio (Microsoft i IBM razvili 1991. godine, izvorni audio format Windows-a. PCM kodiranje, nekomprimovan, kvalitet zvuka bez gubitaka ali fajl veoma velik, standardni format za profesionalnu audio montažu)"

msgid "mime_wma"
msgstr "WMA audio (Microsoft razvio 1999. godine, Windows Media Audio. Ima verzije sa gubitkom/bez gubitka, izvorno podržan na Windows-u, proširio se sa Windows Media Player-om. Sada je marginalizovan, zamenjen MP3/AAC-om)"

msgid "mime_dsf"
msgstr "DSF audio (Direct Stream Digital format, razvili Sony i Philips. 1-bit visoka frekvencija uzorkovanja, standardni DSD audio format, digitalna verzija SACD-a, visokokvalitetni audio format za audiofile, fajl veoma velik)"

msgid "mime_ape"
msgstr "APE Audio (razvio Monkey's Audio 2000. godine, format kompresije bez gubitaka. Veća kompresija od FLAC-a ali sporije kodiranje, i dalje se koristi na Windows platformi i među audio entuzijastima)"

msgid "mime_mid"
msgstr "MIDI audio (MIDI Association odredio 1983. godine, Musical Instrument Digital Interface. Muzički notni format, a ne snimak, fajl veoma mali, standard za elektronske muzičke instrumente, zvučne signale telefona, zvučne efekte u igrama. General MIDI je standardizovan 1991. godine, definisao 128 instrumenta)

msgid "mime_m4a"
msgstr "M4A audio (MPEG-4 Audio, kontejnerski format AAC-a. Standardni format iTunes muzičke prodavnice, glavni audio format u Apple ekosistemu, podržava DRM zaštitu)"

msgid "mime_m3u"
msgstr "M3U lista pesama (MP3 URL lista pesama format, običan tekstualni fajl, beleži putanje audio fajlova. Standard iz ere Winamp-a, koristi se za online radio, online muzičke tokove. M3U8 je njegova UTF-8 verzija, koristi se za HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF tok medija (Microsoft razvio 1996. godine, Advanced Systems Format. Windows Media kontejner za tokove, podržava sinhrono prenošenje audio i video zapisa. Koristi se za online prenos uživo i video na zahtev, WMA/WMV su zasnovani na ASF kontejneru)"

msgid "mime_avi"
msgstr "AVI video (Microsoft lansirao 1992. godine, rani Windows video standard. 'Audio Video Interleave', smenjuje audio i video, najpopularniji video format 1990-2000-ih, sada zamenjen MP4/MKV-om)"

msgid "mime_divx"
msgstr "DivX video (DivX Corporation razvio 1998. godine, video kodek format zasnovan na MPEG-4. Glavni format za deljenje online videa 2000-ih, prva tehnologija koja je kompresovala DVD kvalitet na veličinu CD-a. Zbog sporova oko autorskih prava, kasnije se transformisao u komercijalni enkoder)"

msgid "mime_mp4"
msgstr "MP4 video (MPEG standard iz 2001. godine, MPEG-4 Part 14. Najčešći video format na svetu, podržava H.264/H.265 kodiranje, podrazumevani format za internet video, snimanje telefonom, YouTube)"

msgid "mime_m4v"
msgstr "M4V video (iTunes video format, varijacija MP4-a. Video format u Apple ekosistemu, standardni format za filmove i televizijske programe u iTunes prodavnici, podržava DRM zaštitu autorskih prava)"

msgid "mime_mpeg"
msgstr "MPEG video (organizacija MPEG odredila 1988. godine, Moving Picture Experts Group. Postavio temelje za standarde kompresije digitalnog videa, MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (online video) imaju dubok uticaj)"

msgid "mime_mkv"
msgstr "MKV video (Matroska projekat razvio 2002. godine, kontejner otvorenog koda za multimediju. Podržava više audio zapisa, više titlova, poglavlja, 'alat za umotavanje', preferirani format za deljenje filmova visoke rezolucije)"

msgid "mime_mpg"
msgstr "MPEG video (ekstenzije MPEG-1/MPEG-2 videa, standardni format za VCD i DVD. Glavni format za video na disku 1990-2000-ih, sada zamenjen H.264/H.265-om)"

msgid "mime_ogv"
msgstr "Ogg Video video (razvio Xiph.Org Foundation, video format Ogg kontejnera, koristi Theora kodiranje. Otvorenog koda i bez patenata, jedan od ranih standarda za HTML5 video, Firefox izvorno podržava)"

msgid "mime_ogx"
msgstr "Ogg multimedijalni kontejner (razvio Xiph.Org Foundation, opšte proširenje Ogg kontejnera, može sadržati više zapisa kao audio, video, titlove. Standard otvorenog koda za multimediju, koristi se za igre, tokove)"

msgid "mime_rm"
msgstr "RealMedia video (RealNetworks razvio 1995. godine, RealMedia format. Pionir online strimovanja 1990-2000-ih, glavni format RealPlayer-a. Slabosti: zahteva poseban plejer, slab kvalitet kompresije, kasnije zamenjen Flash/MP4-om)"

msgid "mime_flv"
msgstr "Flash video (format se pojavio 2002. godine, Flash Video format. Nekada je bio glavni format online videa. Rani YouTube ga je koristio. Slabosti: potreba za Flash dodatkom, slabe performanse, mnoge bezbednosne ranjivosti. Od 2015. glavni veb sajtovi su prešli na HTML5 video, sada je ukinut)"

msgid "mime_f4v"
msgstr "F4V video (Flash video format koji je razvio Adobe, naslednik FLV-a. Zasnovan na MPEG-4 standardu, podržava H.264 kodiranje. Ukinut zajedno sa Flash tehnologijom, Adobe je obustavio podršku 2020. godine)"

msgid "mime_wmv"
msgstr "WMV video (Microsoft razvio 1999. godine, Windows Media Video. Izvorno podržan na Windows-u, optimizovan za striming, bio je uobičajeni format u ranom online videu, sada je marginalizovan)"

msgid "mime_wmf"
msgstr "WMF medijski format (Windows Media Format, Microsoft-ov medijski okvir, uključuje WMV video, WMA audio, izvorno podržan od strane Windows Media Player-a)"

msgid "mime_mov"
msgstr "MOV video (Apple razvio 1991. godine, QuickTime kontejnerski format. Standardni format za profesionalnu montažu videa, podržava više kodeka, izvorno podržan od strane Final Cut Pro-a, Premiere-a)"

msgid "mime_qt"
msgstr "QuickTime video (Apple lansirao 1991. godine, QuickTime format. Video standard na Mac platformi, MOV je njegov kontejner, QuickTime plejer je nekada bio široko korišćen. Apple je obustavio razvoj Windows verzije 2016. godine, postepeno ga zamenjuje MP4)"

msgid "mime_webm"
msgstr "WebM video (Google lansirao 2010. godine, video format otvorenog koda bez patenata. Zasnovan na Matroska kontejneru, VP8/VP9 kodiranje, standardni HTML5 video format, podrazumevani format za reprodukciju na YouTube-u na web-u)"

msgid "mime_3gp"
msgstr "3GP video (3GPP odredio 2000. godine, video format za mobilne uređaje. Fajl veoma mali, niskog kvaliteta, format za snimanje videa na ranim funkcionalnim telefonima, korišćen za slanje MMS-a)"

