#------------------------------------------------------------------------------
# Formatbeskrivningar
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Textfil (standardiserad ASCII 1963, oformaterad ren text. Grunden för all källkod, konfiguration och loggar. Unix använder LF, Windows använder CRLF för ny rad, fortfarande det mest universella dataformatet i datorer)"

msgid "mime_log"
msgstr "Loggfil (ren textfil som registrerar system- och applikationsdriftsinformation, ofta använd för felsökning, prestandaanalys, säkerhetsrevision. Standardformat som Apache combined log, Nginx access log, syslog etc.)"

msgid "mime_page"
msgstr "HTML-webbsida (Tim Berners-Lee uppfann WWW 1989, definierade de tre teknologierna HTML/HTTP/URL 1990, gjorde dem gratis utan patent. 2014 blev HTML5 en officiell W3C-standard, stöder visning, multimedia och utskrift. Tilldelades Turingpriset 2016)"

msgid "mime_khtml"
msgstr "KHTML-webbsidemotor (KDE 2.0 släpptes 1998, Konqueror-webbläsarens renderingsmotor. 2001 skapade Apple WebKit baserat på KHTML, 2008 skapade Google Blink från WebKit, som blev kärnan i Chrome, Edge, Safari och andra webbläsare. KHTML är ett exempel på hur open source-gemenskapen lade grunden för moderna webbläsarmotorer, dess tekniska arv fortsätter genom WebKit/Blink)"

msgid "mime_script"
msgstr "Dynamiskt skript (tolkat språk, behöver inte kompileras. Inkluderar ASP, JSP, CGI, ColdFusion, Tcl, VBScript etc., används i stor utsträckning i tidig webbutveckling, systemadministration, automatisering av uppgifter. Moderna skriptspråk som Python, Ruby, JavaScript har utvecklats till huvudverktyg för fullstack-utveckling)"

msgid "mime_js"
msgstr "JavaScript-skript (Brendan Eich skapade det på 10 dagar i Netscape 1995, webbläsarnas inbyggda programmeringsspråk. 1997 standardiserades ECMAScript, 2009 föddes Node.js vilket gjorde det till ett fullstack-språk, npm är världens största pakethanterare. Flera år i rad det mest populära programmeringsspråket på GitHub)"

msgid "mime_py"
msgstr "Python-skript (skapat av Guido van Rossum 1991, känt för obligatorisk indragning och ren syntax. Används i stor utsträckning inom webbutveckling, datavetenskap, artificiell intelligens, automatiserad drift. Flerfaldig vinnare av TIOBEs programmeringsspråk-år)"

msgid "mime_sh"
msgstr "Shell-skript (Unix föddes 1971, kommandoskriftspråk. Används för systemadministration, automatisering av uppgifter, start av tjänster, distributionsskript. Grundläggande färdighet för Linux-administratörer)"

msgid "mime_rb"
msgstr "Ruby-skript (skapat av Yukihiro Matsumoto 1995, fokuserar på utvecklarens lycka. Ruby on Rails-ramverket introducerade paradigmet konvention före konfiguration, vilket påverkade designen av moderna webbramverk)"

msgid "mime_pl"
msgstr "Perl-skript (skapat av Larry Wall 1987, känt för sin pragmatism, kallad \"schweizisk armékniv\". CPAN var en pionjär inom moderna språkpakethanterare, hade djupgående inflytande inom textbehandling, systemadministration och CGI-området)"

msgid "mime_php"
msgstr "PHP-dynamisk sida (skapat av Rasmus Lerdorf 1995, speciellt utformad för webbutveckling. Över 70% av webbplatserna i världen använder det, driver plattformar som WordPress, Facebook, Wikipedia. PHP 8 introducerade JIT-kompilering, vilket förbättrade prestandan avsevärt)"

msgid "mime_image"
msgstr "Bildfil"

msgid "mime_document"
msgstr "Dokumentfil"

msgid "mime_package"
msgstr "Programvarupaket"

msgid "mime_archive"
msgstr "Gzip-komprimerad fil (GNU-projekt från 1992, baserat på DEFLATE-algoritmen. På webben används för dynamisk komprimering av svarsinnehåll, komprimeringsgrad vanligtvis 60-90%. Efter 2015 ersattes den i vissa scenarier av Brotli, men är fortfarande det mest stödda komprimeringsformatet på serversidan)"

msgid "mime_audio"
msgstr "Ljudfil"

msgid "mime_video"
msgstr "Videofil"

msgid "mime_jscript"
msgstr "JavaScript (utvecklat av Brendan Eich 1995)"

msgid "mime_json"
msgstr "JSON-data (föreslagen av Douglas Crockford 2001, lättviktsdatautbytesformat, de facto-standard för webb-API:er)"

msgid "mime_vbs"
msgstr "VBScript (utvecklat av Microsoft 1996, Windows-skriptspråk, används för ASP-sidor och Windows-administrationsskript. Med spridningen av PowerShell och JavaScript fasas det gradvis ut)"

msgid "mime_conf"
msgstr "Konfigurationsfil (textformat för lagring av programvarukonfiguration, vanliga format: INI, JSON, YAML, TOML, XML. Linux-systemkonfigurationer finns oftast i /etc-katalogen)"

msgid "mime_css"
msgstr "CSS-stilmall (W3C släppte CSS1 som första officiella standard i december 1996, CSS2 lade till positionering och medietyper 1998, från 2011 introducerade CSS3 modulärt rundade hörn, animationer, flexibla boxar, rutnätslayout och responsiv design. Tillsammans med HTML och JavaScript är de tre grundläggande frontend-teknologierna, alla moderna webbläsare (Chrome, Firefox, Safari, Edge) stöder det inbyggt, är den enda standarden för definition av webbstilar)"

msgid "mime_xsl"
msgstr "XSL-stilmall (W3C-standard från 1999, XML-dokumentomvandlingsspråk, kan konvertera XML till HTML/PDF/text. Efter att JSON spridits har användningen minskat)"

msgid "mime_runtime"
msgstr "Körbar fil (körbara format för operativsystem som EXE, ELF, Mach-O, innehåller maskinkod och laddningsinformation)"

msgid "mime_library"
msgstr "Biblioteksfil (DLL, SO, dylib och andra dynamiskt länkade bibliotek, kod som laddas under programkörning)"

msgid "mime_swf"
msgstr "Flash-animation (utvecklad av Macromedia 1996, senare överförd till Adobe. Standard för interaktiva webbanimationer, dominerade en gång internetanimationer och spel. Nackdelar: beroende av plugin, inget mobilstöd, hög säkerhetsrisk. 2017 meddelade Adobe nedläggning, stödet upphörde helt 2020, ersatt av HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "DTD-dokumenttypsdefinition (XML-specifikation, definierar strukturen för ett XML-dokument, används för att validera XML-giltighet)"

msgid "mime_csv"
msgstr "CSV-dataformat (kommaseparerade värden, universellt format för tabelldata, standard för import/export i Excel och databaser)"

msgid "mime_jnlp"
msgstr "Java Web Start (startare för Java-applikationer, teknik för distribution av Java-skrivbordsapplikationer från 2000-talet, nu nedlagd)"

msgid "mime_lit"
msgstr "Microsoft Reader e-bok (lanserad av Microsoft 2000, LIT-format, nedlagd)"

msgid "mime_svg"
msgstr "SVG-vektorgrafik (W3C-standard från 1999, eftersom Microsoft länge marknadsförde sitt eget VML-format, stödde IE-webbläsaren det först 2011, vilket försenade spridningen. Efter 2015, med nedläggningen av IE och spridningen av HD-skärmar, blev det det föredragna formatet för ikoner och logotyper)"

msgid "mime_ai"
msgstr "Adobe Illustrator-vektorgrafik (lanserad 1987, branschstandard för vektorgrafikformat, förstahandsval för tryckdesign, logotyper och ikoner)"

msgid "mime_phshop"
msgstr "Photoshop-bild (lanserad av Adobe 1990, Photoshop-källformat PSD, branschstandard för bildbehandling)"

msgid "mime_ttf"
msgstr "TrueType-teckensnitt (utvecklat gemensamt av Apple och Microsoft 1989, vektor-teckensnittsformat, konsekvent visning på skärm och utskrift, standardteckensnittsformat på moderna operativsystem)"

msgid "mime_fon"
msgstr "WOFF2-webbteckensnitt (W3C-rekommendation från 2014, använder Brotli-komprimeringsalgoritm, jämfört med äldre WOFF är volymen reducerad med cirka 30%, jämfört med TTF/OTF reducerad med över 50%, alla moderna webbläsare stöder det, föredraget format för moderna webbteckensnitt, stöds av över 98% av webbläsarna)"

msgid "mime_pdf"
msgstr "PDF-dokument (utvecklat av Adobe 1993, blev ISO-internationell standard 2008. Plattformsoberoende dokumentformat, bibehåller formatkonsistens, global standard för distribution av elektroniska dokument)"

msgid "mime_dotnet"
msgstr "ASP.NET-dynamisk sida (lanserad av Microsoft 2002, dynamisk webbteknologi för Windows-plattformen, en del av .NET Framework)"

msgid "mime_mdb"
msgstr "Access-databas (Microsoft Access-databasfil, lanserad 1992, Windows-skrivbordsdatabaslösning)"

msgid "mime_md"
msgstr "Markdown-dokument (skapat av John Gruber 2004, syntaxdesignen påverkades av reStructuredText och Setext. Den centrala designfilosofin är 'läsbarhet är rendering', den ursprungliga implementeringen Markdown.pl är skriven i Perl och utför textomvandling baserad på reguljära uttryck. Härledda specifikationer inkluderar GFM (2013), CommonMark (2017), Pandoc Markdown etc. Driver ekosystem som GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, och har blivit de facto-standardformat för statiska webbplatsgeneratorer och utvecklardokumentation)"

msgid "mime_crystal"
msgstr "Crystal Reports-rapportformat (SAP business intelligence-rapport, standardformat för företagsrapporter)"

msgid "mime_libreoffice"
msgstr "LibreOffice-dokument (utvecklat av The Document Foundation 2010, en gren av OpenOffice, ODF-standardimplementering, ledande open source-kontorspaket)"

msgid "mime_encrypt"
msgstr "Krypterad fil (fil som måste dekrypteras för att visas, vanliga tillägg: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "GPS-spårdata (GPS-utbytesformat, registrerar geografisk platsinformation, universellt format för sportklockor och navigationsenheter)"

msgid "mime_diskimage"
msgstr "Diskavbildning (DMG, ISO, IMG och andra optiska skiv-/diskavbildningsfiler, används för programvarudistribution eller säkerhetskopiering av lagringsmedia)"

msgid "mime_vm"
msgstr "Virtuell maskinavbildning (VMDK, VDI, VHDX, OVA och andra virtuella diskfiler, format för virtualiseringsplattformar som VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "BitTorrent-torrentfil (uppfunnen av Bram Cohen 2001, P2P-nedladdningsindexfil, innehåller filmetadata och Tracker-information)"

msgid "mime_gis"
msgstr "GIS-geografiskt informationssystemdata (Shapefile, GeoJSON och andra geospatiala dataformat, används för kartor och rumslig analys)"

msgid "mime_ebook"
msgstr "E-bok (EPUB, MOBI, AZW och andra e-boksformat. EPUB är internationell standard, MOBI/AZW är Amazons Kindle-format)"

msgid "mime_avif"
msgstr "AVIF-bild (lanserad av Alliance for Open Media 2019, baserad på AV1-kodning, komprimeringsgraden är 50% bättre än WebP, ny generations standard för webbilder)"

msgid "mime_markdown"
msgstr "Markdown-dokument (designat av John Gruber 2004, lättviktigt märkspråk, universellt format för GitHub README, teknisk dokumentation, foruminlägg)"

msgid "mime_yaml"
msgstr "YAML-konfiguration (designad av Clark Evans 2001, människoläsbart dataserialiseringsformat, standardformat för konfigurationsfiler för Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "TOML-konfiguration (designad av Tom Preston-Werner 2013, \"Tom's Obvious Minimal Language\", konfigurationsfilformat för moderna verktyg som Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Vue-komponentfil (introducerad 2014 av Evan You, progressivt JavaScript-ramverk. Genom enfilskomponenter (SFC) kombinerar den perfekt HTML, CSS och JS, vilket avsevärt ökar utvecklingseffektiviteten. Det är ett av världens mest populära frontend-ramverk. Även som kärna i moderna generatorer för statiska webbplatser som VitePress, används det i stor utsträckning för att driva interaktiv teknisk dokumentation och bloggar.)"

msgid "mime_wasm"
msgstr "WebAssembly-modul (W3C-standard från 2017, högpresterande körningsformat i webbläsare, C/C++/Rust/R kan kompileras till mål, prestanda nära inbyggd)"

msgid "mime_jsx"
msgstr "React JSX-komponent (Facebook introducerade JavaScript XML 2013, komponentsyntax för React-ramverket, en innovativ paradigm för att skriva HTML i JavaScript)"

msgid "mime_tsx"
msgstr "TypeScript TSX-komponent (utvecklad av Microsoft 2012, TypeScript + JSX, standardsätt för React-utveckling med typsäkerhet)"

msgid "mime_heif"
msgstr "HEIF-bild (MPEG-standard från 2015, effektivt bildfilformat, används i stor utsträckning i Apples ekosystem)"

msgid "mime_heic"
msgstr "HEIC-bild (Apples implementering av HEIF, standardformat för foton på iPhone, inbyggt stöd på iOS/macOS)"

msgid "mime_gltf"
msgstr "GLTF 3D-modell (GL-överföringsformat, \"JPEG för 3D-världen\", släppt av Khronos Group 2015, standardformat för webb-3D)"

msgid "mime_glb"
msgstr "GLB binär 3D-modell (binär version av GLTF, en fil innehåller alla resurser, används för distribution av 3D-scener)"

msgid "mime_gls"
msgstr "GLOSSARY-ordlista (termdefinitionsfil, används för terminologihantering i dokumentsystem)"

msgid "mime_cbz"
msgstr "CBZ-serietidning (ZIP-komprimerade seriebilder, universellt format för seriesamlingar)"

msgid "mime_cbr"
msgstr "CBR-serietidning (RAR-komprimerade seriebilder, universellt format för seriesamlingar)"

msgid "mime_fb2"
msgstr "FB2 e-bok (FictionBook 2.0, ryskt e-boksformat, XML-struktur, brett stöd av open source-läsare)"

msgid "mime_kepub"
msgstr "KEPUB e-bok (Kobo-specifikt EPUB-format, optimerat format för Kobo e-boksläsare)"

msgid "mime_m4b"
msgstr "M4B ljudbok (MPEG-4 ljudboksformat, stöder bokmärken, iTunes ljudboksformat)"

msgid "mime_kfx"
msgstr "Kindle KFX-format (lanserat av Amazon 2015, specialformat för Kindle e-böcker, stöder förbättrad typografi och snabb sidbläddring)"

msgid "mime_chm"
msgstr "CHM-hjälpfil (lanserad av Microsoft 1997, kompilerat HTML-hjälpformat, standard för Windows-programvaruhjälpdokumentation)"

msgid "mime_mht"
msgstr "MHT-webbarkiv (lanserat av Microsoft 1999, en-fils webbformat, IE-webbläsarens format för att spara webbsidor)"

msgid "mime_wml"
msgstr "WML trådlöst märkspråk (WAP-standard från 1999, används för webbsidesfiler för tidiga funktionstelefoner, nedlagt)"

msgid "mime_xhtml"
msgstr "XHTML-webbsida (W3C-standard från 2000, XML-version av HTML, striktare syntax. 2009 upphörde W3C med underhållet, fokus flyttades till HTML5)"

msgid "mime_xml"
msgstr "XML-dokument (W3C-standard från 1998, utbyggbart märkspråk, grundformat för webbtjänster, konfigurationsfiler, datautbyte)"

msgid "mime_sgml"
msgstr "SGML-dokument (ISO-standard från 1986, föregångare till HTML, standard generaliserat märkspråk, både XML och HTML härstammar från SGML)"

msgid "mime_apng"
msgstr "APNG-animation (utvecklad av Mozilla 2004, animationsutvidgning av PNG, modern ersättning för GIF, stöder äkta färger och transparens)"

msgid "mime_bmp"
msgstr "BMP-bitmapp (Windows bitmap-format, inbyggt stöd sedan Windows 1.0. Okomprimerad, stor filstorlek, men på grund av sin enkla struktur och avsaknad av behov av ytterligare codecs, används den fortfarande i Windows 11s klippverktyg, Paint-programmet, ikonresurser i EXE/MSI-installationspaket, markörfiler och vissa äldre drivrutiner. Vid samma bildkvalitet är filstorleken cirka 3-10 gånger större än PNG. I de flesta fall har den ersatts av PNG/JPEG, men Windows-ekosystemet behåller fortfarande bred kompatibilitet)"

msgid "mime_cdr"
msgstr "CDR-vektorgrafik (CorelDRAW-specifikt format, kanadensiska företaget Corel, programvara för vektorgrafikdesign)"

msgid "mime_gif"
msgstr "GIF-bild (utvecklad av CompuServe 1987, 256-färgs animerat bildformat. Nackdelar: få färger, grov bildkvalitet, stöder inte transparens, stor fil, låg bildfrekvens. Ersatt av moderna animerade bildformat som APNG, WebP)"

msgid "mime_ico"
msgstr "ICO-ikon (Windows ikonfilformat, stöder flera upplösningar, standardformat för favicon på webbplatser)"

msgid "mime_jpeg"
msgstr "JPEG-bild (ISO-standard från 1992, förlustgivande komprimeringsformat för foton, de facto-standard för foton på internet)"

msgid "mime_jpg"
msgstr "JPEG-bild (ISO-standard från 1992, förlustgivande komprimeringsformat för foton, de facto-standard för foton på internet)"

msgid "mime_png"
msgstr "PNG-bild (W3C-rekommendation från 1996, stöder äkta färger och transparens, statisk ersättning för GIF, internetstandard för förlustfri bild)"

msgid "mime_ps"
msgstr "PostScript-sidbeskrivningsfil (lanserad av Adobe 1985, sidbeskrivningsspråk, föregångare till PDF, används för utskrift och publicering)"

msgid "mime_psb"
msgstr "PSB-stort dokument (Adobe Photoshop extra stort bildformat, stöder gigantiska bilder över 2 GB eller 30000 pixlar)"

msgid "mime_psd"
msgstr "PSD-bild (Adobe Photoshop-källfil, stöder lager, kanaler, sökvägar, branschstandard för bildbehandling)"

msgid "mime_webp"
msgstr "WebP-bild (utvecklad av Google 2010, webbbildsformat, stöder förlustgivande/förlustfri komprimering och animation, komprimeringsgraden är 25-35% bättre än PNG, 25% bättre än JPEG)"

msgid "mime_woff"
msgstr "WOFF-webbteckensnitt (skapad 2009, W3C-standard från 2018. Komprimering baserad på TrueType/OpenType, optimering av inläsning av webbteckensnitt, standardformat för ikonteckensnitt på moderna webbplatser)"

msgid "mime_7z"
msgstr "7z-komprimerat paket (utvecklat av Igor Pavlov 1999, specialformat för 7-Zip-programmet. LZMA-algoritm, hög komprimering, open source och gratis. 7z-formatet vid samma komprimeringsgrad är vanligtvis 30-50% mindre än ZIP, vanligt format i open source-gemenskapen och för programvarudistribution)"

msgid "mime_ace"
msgstr "ACE-komprimerat paket (utvecklat på 1990-talet, format för WinACE-programmet. Tävlande en gång med RAR, relativt hög komprimeringsgrad. Utvecklingen stoppades 2007, nu ersatt av 7z/RAR, används sällan)"

msgid "mime_bz2"
msgstr "BZIP2-komprimerat paket (utvecklat av Julian Seward 1996, blocksorteringskomprimeringsalgoritm. Komprimeringsgraden är 15-20% bättre än GZIP, men långsammare. Källkoden för Linux-kärnan, open source-paket använder ofta detta format, tillägg .bz2)"

msgid "mime_cab"
msgstr "CAB-komprimerat paket (utvecklat av Microsoft 1995, Cabinet-format. Format för installationspaket för Windows-system, används för drivrutiner, distribution av systemfiler. Windows Installer (MSI) använder internt CAB för att lagra filer)"

msgid "mime_dmg"
msgstr "DMG-diskavbildning (lanserad av Apple på 1980-talet, Disk Image-format. Standardformat för programvarudistribution på macOS, dubbelklick monteras som virtuell disk, dra och släpp för att installera applikationen. Stöder komprimering och kryptering, huvudformat för nedladdning av Mac-programvara)"

msgid "mime_emz"
msgstr "EMZ-komprimerad bild (Windows komprimerad förbättrad metafil, komprimerad version av EMF. Format för lagring av vektorgrafik i Office-dokument, i huvudsak en GZIP-komprimerad EMF-fil)"

msgid "mime_gz"
msgstr "GZIP-komprimerat paket (utvecklat av Jean-loup Gailly och Mark Adler 1992, GNU-projekt. Standardkomprimeringsverktyg på Unix/Linux, vanligt format för HTTP-överföringskomprimering. Tillägg .gz, används ofta tillsammans med TAR)"

msgid "mime_jar"
msgstr "JAR-komprimerat paket (lanserat av Sun Microsystems 1997, Java ARchive-format. I huvudsak ett ZIP-komprimerat paket, används för att paketera Java-klassbibliotek och applikationer. Kärnformat i Java-ekosystemet som Maven, Gradle, Android använder också JAR)"

msgid "mime_lzma"
msgstr "LZMA-komprimerat paket (utvecklat av Igor Pavlov 1998, Lempel-Ziv-Markov chain-algoritm. Kärnkomprimeringsalgoritm för 7z-format, hög komprimering, snabb dekomprimering. Används för firmware, distribution av programvara för inbyggda system)"

msgid "mime_rar"
msgstr "RAR-komprimerat paket (utvecklat av Eugene Roshal 1993, Roshal ARchive-format. Hög komprimering, stöder delning i volymer, återställningsposter. Format för WinRAR-programmet, komprimering bättre än ZIP, men kräver betalprogramvara, open source-verktyg som unrar kan dekomprimera)"

msgid "mime_tar"
msgstr "TAR-arkiv (introducerat i Unix V7 1979, Tape ARchive-format. Bandarkivformat, komprimerar inte bara paketerar, används ofta tillsammans med GZIP/BZIP2/XZ. Källkoden för Linux-paket, lagring av lager i Docker-avbildningar använder TAR-format)"

msgid "mime_tgz"
msgstr "TGZ-komprimerat paket (kombinationsformat TAR + GZIP, tillägg .tgz eller .tar.gz. Det mest universella distributionsformatet för Unix/Linux-paket, används i stor utsträckning för källkodspaket, binära paket, representant för \"packa upp och använd\")"

msgid "mime_tbz2"
msgstr "TBZ2-komprimerat paket (kombinationsformat TAR + BZIP2, tillägg .tbz2 eller .tar.bz2. Komprimeringsgraden är 15-20% bättre än TGZ, lämplig för distribution av stora filer, källkoden för Linux-kärnan har länge använt detta format)"

msgid "mime_xz"
msgstr "XZ-komprimerat paket (lanserat 2009, baserat på LZMA2-algoritm. Extremt hög komprimering, 30-50% bättre än GZIP, relativt snabb dekomprimering. Används i stor utsträckning i Linux-kärnan, pakethanterare (som internt i Debians .deb), rekommenderat format för nuvarande Linux-ekosystem)"

msgid "mime_z"
msgstr "Z-komprimerat paket (format för Unix compress-kommando från 1985, LZW-algoritm. Tidigt Unix-komprimeringsformat, ersatt av GZIP. Tillägg .Z, används sällan på moderna system)"

msgid "mime_zip"
msgstr "ZIP-komprimerat paket (utvecklat av Phil Katz 1989, PKZIP-format. Inbyggt stöd i Windows, det mest universella komprimeringsformatet på internet. Stöder flera filer, katalogstruktur, kan välja komprimeringsalgoritm. Java JAR, Android APK, Office-dokument DOCX/XLSX baseras på ZIP-format)"

msgid "mime_zst"
msgstr "Zstandard-komprimerat paket (utvecklat av Facebook 2015, designat av Yann Collet. Höghastighetskomprimeringsalgoritm, komprimeringsgrad nära LZMA, hastighet långt över GZIP. Linux-kärnan 5.9+ stöder, Arch Linux pacman, Debian APT inför gradvis, ny generations komprimeringsstandard)"

msgid "mime_lz4"
msgstr "LZ4-komprimerat paket (utvecklat av Yann Collet 2011, extremt snabb komprimeringsalgoritm. Komprimeringshastigheten är över 10 gånger snabbare än GZIP, lämplig för realtidskomprimeringsscenarier. Linux-kärnan, OpenZFS, Hadoop använder den i stor utsträckning, förstahandsval för scenarier där hastighet är prioritet)"

msgid "mime_lzo"
msgstr "LZO-komprimerat paket (utvecklat av Markus Oberhumer 1996, Lempel-Ziv-Oberhumer-algoritm. Dekomprimeringshastigheten är extremt snabb, komprimeringsgraden är genomsnittlig. Linux-kärnan Squashfs, OpenWrt-firmware använder den, lämplig för inbyggda system)"

msgid "mime_msi"
msgstr "MSI-installationspaket (lanserat av Microsoft 1999, Windows Installer-paketformat. Standardinstallationsformat för Windows-applikationer, stöder transaktionsåterrullning, komponenthantering, tyst installation. Förstahandsval för programvarudistribution på företagsnivå, fortfarande huvudformat för installation av Windows-programvara idag)"

msgid "mime_pkg"
msgstr "PKG-installationspaket (format för installationspaket för macOS-applikationer, baserat på Apples Installer-teknik. Standardformat för distribution av macOS-programvara, stöder val av komponenter, installationsskript, avinstallationsfunktion. Dubbelklicka på .pkg-filen för att installera, vanlig distributionsmetod för programvara utanför Mac App Store)"

msgid "mime_apk"
msgstr "APK Android-applikationspaket (introducerat av Google 2008, traditionellt installationsformat för Android-applikationer. APK är i grunden ett ZIP-paket som innehåller kod, resurser, manifestfil. Från 2021 kräver Google Play att nya applikationer använder AAB-format, men APK används fortfarande för utveckling och felsökning, tredjepartsbutiker och sideladdning)"

msgid "mime_ipa"
msgstr "IPA iOS-applikationspaket (iOS App Store Package, installationsformat för iOS/iPadOS-applikationer. Introducerat 2008 tillsammans med iPhone SDK. Måste distribueras via App Store eller signeras med företagscertifikat. Innehåller körbar fil, resurser, Info.plist och signaturinformation)"

msgid "mime_hap"
msgstr "HAP HarmonyOS-applikationspaket (HarmonyOS Ability Package, grundenhet för HarmonyOS-applikationer. Introducerat 2020 med HarmonyOS 2.0. Stöder två typer: entry och feature, distributionsformat för Huawei-telefoner, surfplattor, smartklockor och andra HarmonyOS-enheter)"

msgid "mime_har"
msgstr "HAR HarmonyOS statiskt delat bibliotek (HarmonyOS Archive, statiskt delat bibliotek för HarmonyOS, kan delas av flera HAP-paket, används för komponentbaserad utveckling och återanvändning av moduler)"

msgid "mime_aab"
msgstr "Android App Bundle (introducerat av Google 2018, från 2021 kräver Google Play att nya applikationer använder detta format. AAB är ett distributionsformat, Google Play genererar optimerade APK:er baserat på enhetskonfiguration (CPU-arkitektur, skärmdensitet, språk), installationspaketets storlek minskar i genomsnitt med 35%. Utvecklare laddar upp AAB, användare laddar ner APK)"

msgid "mime_xapk"
msgstr "XAPK-applikationspaket (tredjeparts Android-applikationsutvidgningspaket, innehåller APK + OBB-datafiler. Används för stora spel och komplexa applikationer, löser 100 MB-begränsningen för en enskild APK-fil. Vanligt i tredjeparts app-butiker som APKPure, APKMirror, inte ett officiellt Google-format)"

msgid "mime_appx"
msgstr "Windows-applikationspaket (lanserat av Microsoft 2012, installationsformat för Windows 8/10/11-applikationer. Stöder UWP- och skrivbordsapplikationskonvertering, distribueras via Microsoft Store. 2024 introducerade Microsoft MSIX som efterföljarformat, gradvis ersätter APPX)"

msgid "mime_msix"
msgstr "MSIX-applikationspaket (lanserat av Microsoft 2018, ny generations applikationspaketeringsformat för Windows. Kombinerar fördelarna med APPX och MSI, stöder alla typer av Windows-applikationer, kan distribueras via Microsoft Store eller sideladdas, rekommenderat format för Windows 11)"

msgid "mime_appimage"
msgstr "AppImage-applikationspaket (introducerat 2004, Linux-installationsfritt applikationsformat. \"En applikation, en fil\", ingen installation krävs, körs direkt, stöder de flesta Linux-distributioner, vanligt sätt för utvecklare att distribuera Linux-programvara)"

msgid "mime_flatpak"
msgstr "Flatpak-applikationspaket (introducerat 2015, Linux-sandlådeapplikationsformat. Körs över distributioner, isolerad från värdsystemet, leds av Fedora, Red Hat, standardformat för GNOME Software Center)"

msgid "mime_snap"
msgstr "Snap-applikationspaket (lanserat av Canonical 2014, moderbolaget Ubuntu, Linux universellt applikationsformat. Automatiska uppdateringar, sandlådeisolering, stöder 40+ Linux-distributioner, standardformat för Ubuntu Software Center)"

msgid "mime_deb"
msgstr "Debian-programvarupaket (introducerat av Debian-projektet 1993, standardinstallationsformat för Debian/Ubuntu och deras derivat. Hanteras med dpkg, APT är dess pakethanterargränssnitt, ett av de mest mogna paketformaten i Linux-ekosystemet, fortfarande huvudformat i Debian-familjen)"

msgid "mime_rpm"
msgstr "RPM-programvarupaket (introducerat av Red Hat 1997, standardformat för Red Hat/Fedora/CentOS/SUSE och andra distributioner. RPM står för \"Red Hat Package Manager\", tillsammans med DEB är de två stora paketformaten i Linux, fortfarande huvudformat i RHEL-familjen)"

msgid "mime_pacman"
msgstr "Arch-programvarupaket (introducerat av Arch Linux 2002, .pkg.tar.zst-format som används av pacman-pakethanteraren. Kärnan i Arch Linux med rullande utgåvor, känd för enkelhet och KISS-principen, AUR (Arch User Repository) är dess kännetecken)"

msgid "mime_exe"
msgstr "EXE körbar fil (Windows körbart programformat, förkortning för \"Executable\". Inbyggt körbart format för Windows-operativsystemet, innehåller PE-struktur. Utvecklades från MZ-formatet från MS-DOS, 1993 introducerade Windows NT PE-formatet (Portable Executable) och används fortfarande. Programvaruinstallationspaket, applikationer, systemverktyg använder detta format. Användaren dubbelklickar för att köra, det mest använda körbara formatet i världen)"

msgid "mime_dll"
msgstr "DLL dynamiskt länkbibliotek (lanserat av Microsoft 1993, Dynamic Link Library. Windows delat kodbibliotek, laddas dynamiskt under programkörning, sparar minne och diskutrymme. Systemkomponenter, applikationsplugin, drivrutiner använder DLL-format. Det primära sättet att implementera Windows API, DLL Hell-problemet mildrades under .NET-eran)"

msgid "mime_com"
msgstr "COM körbar fil (körbart format från MS-DOS-eran, förkortning för \"Command\". Enkel filstruktur, 64KB-begränsning, huvudformat före Windows 3.x. Nedlagd, modern Windows använder EXE-format, COM-tillägg används fortfarande för vissa komponentfiler)"

msgid "mime_aac"
msgstr "AAC-ljud (MPEG-standard från 1997, Advanced Audio Coding. Efterträdare till MP3, ljudkvalitet bättre än MP3 vid samma bithastighet, standardljudformat för YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "ALAC-ljud (utvecklat av Apple 2004, Apple Lossless Audio Codec. Apples förlustfria format, open source 2011, standardformat för förlustfritt ljud i iTunes och Apple Music)"

msgid "mime_flac"
msgstr "FLAC-ljud (utvecklat av Xiph.Org Foundation 2001, Free Lossless Audio Codec. Förlustfri komprimering, ljudkvalitet som CD, filstorlek ungefär hälften av original WAV. Open source utan patent, föredraget format för audiofiler och digitala musiksamlingar)"

msgid "mime_mp3"
msgstr "MP3-ljud (utvecklat av Fraunhofer Institute 1993, MPEG-1 Audio Layer 3. Förlustgivande komprimeringsformat, liten filstorlek acceptabel kvalitet, kärnformat för den digitala musikrevolutionen på 2000-talet, drivkraften bakom iPod och Napster. Patentet löpte ut 2017, blev offentligt domänformat)"

msgid "mime_oga"
msgstr "Ogg Audio-ljud (utvecklat av Xiph.Org Foundation, rent ljudformat för Ogg-behållaren, använder Vorbis-kodning. Open source utan patent, komprimeringseffektivitet bättre än MP3, används i stor utsträckning i open source-projekt)"

msgid "mime_ogg"
msgstr "OGG-ljud (utvecklat av Xiph.Org Foundation 2000, Ogg Vorbis-format. Open source utan patent, komprimeringseffektivitet bättre än MP3, tidig användare var Spotify, används i stor utsträckning för ljudeffekter i spel)"

msgid "mime_opus"
msgstr "Opus-ljud (standardiserat av IETF 2012, open source utan patent ljudformat. Kombinerar SILK- och CELT-teknik, extremt låg latens, högsta komprimeringseffektivitet, standardljudformat för WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "WAV-ljud (utvecklat av Microsoft och IBM 1991, inbyggt Windows-ljudformat. PCM-kodning utan komprimering, förlustfri ljudkvalitet, men enorma filer, standardformat för professionell ljudredigering)"

msgid "mime_wma"
msgstr "WMA-ljud (utvecklat av Microsoft 1999, Windows Media Audio. Två versioner: förlustgivande och förlustfri, inbyggt stöd i Windows, spreds med Windows Media Player. Nu marginaliserat, ersatt av MP3/AAC)"

msgid "mime_dsf"
msgstr "DSF-ljud (Direct Stream Digital-format, utvecklat av Sony och Philips. 1-bit hög samplingsfrekvens, standardformat för DSD-ljud, digital version av SACD, audiofil high-end-ljudformat, enorma filstorlekar)"

msgid "mime_ape"
msgstr "APE Ljud (utvecklad av Monkey's Audio år 2000, förlustfritt komprimeringsformat. Högre komprimering än FLAC men långsammare kodning, används fortfarande på Windows-plattformen och bland audioentusiaster)"

msgid "mime_mid"
msgstr "MIDI-ljud (fastställt av MIDI Association 1983, Musical Instrument Digital Interface. Notformat snarare än inspelning, mycket små filer, standard för elektroniska instrument, ringsignaler för mobiltelefoner, ljudeffekter i spel. 1991 standardiserades General MIDI, definierade 128 instrumentklanger)"

msgid "mime_m4a"
msgstr "M4A-ljud (MPEG-4 Audio, containerformat för AAC. Standardformat för iTunes Music Store, huvudljudformat i Apples ekosystem, stöder DRM-skydd)"

msgid "mime_m3u"
msgstr "M3U-spellista (MP3 URL-spellistformat, ren textfil, registrerar sökvägar till ljudfiler. Standard från Winamp-eran, används för internetradio, onlinemusikstreaming. M3U8 är dess UTF-8-version, används för HTTP Live Streaming)"

msgid "mime_asf"
msgstr "ASF-strömning (utvecklad av Microsoft 1996, Advanced Systems Format. Windows Media-strömningscontainer, stöder synkron ljud- och videoöverföring. Används för direktsändningar och video-on-demand-strömning, WMA/WMV baseras på ASF-container)"

msgid "mime_avi"
msgstr "AVI-video (lanserad av Microsoft 1992, tidig videostandard för Windows. \"Audio Video Interleave\", överlagrad lagring av ljud och video, mest populära videoformatet på 1990-2000-talen, nu ersatt av MP4/MKV)"

msgid "mime_divx"
msgstr "DivX-video (utvecklad av DivX-företaget 1998, videokodningsformat baserat på MPEG-4. Huvudformat för videodelning på internet under 2000-talet, den första teknologin som komprimerade DVD-kvalitet till CD-storlek. På grund av upphovsrättstvister, omvandlades den senare till en kommersiell kodare)"

msgid "mime_mp4"
msgstr "MP4-video (MPEG-standard från 2001, MPEG-4 del 14. Det mest universella videoformatet i världen, stöder H.264/H.265-kodning, standardformat för internetvideo, mobilinspelning, YouTube)"

msgid "mime_m4v"
msgstr "M4V-video (iTunes-videoformat, variant av MP4. Videoformat i Apples ekosystem, standardformat för filmer, TV-program i iTunes Store, stöder DRM-upphovsrättsskydd)"

msgid "mime_mpeg"
msgstr "MPEG-video (fastställt av MPEG-organisationen 1988, Moving Picture Experts Group. Grundare av standarder för digital videokomprimering, djupt inflytande från MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (internetvideo))"

msgid "mime_mkv"
msgstr "MKV-video (utvecklad av Matroska-projektet 2002, open source multimedia-container. Stöder flera ljudspår, flera undertexter, kapitel, \"paketeringsverktyg\", föredraget format för delning av HD-filmer)"

msgid "mime_mpg"
msgstr "MPEG-video (MPEG-1/MPEG-2 videotillägg, standardformat för VCD och DVD. Huvudvideoformat på optiska skivor under 1990-2000-talen, nu ersatt av H.264/H.265)"

msgid "mime_ogv"
msgstr "Ogg Video-video (utvecklad av Xiph.Org Foundation, videoformat för Ogg-behållaren, använder Theora-kodning. Open source utan patent, en av de tidiga standarderna för HTML5-video, inbyggt stöd i Firefox)"

msgid "mime_ogx"
msgstr "Ogg-multimediabehållare (utvecklad av Xiph.Org Foundation, universell utvidgning av Ogg-behållaren, kan innehålla flera spår: ljud, video, undertexter etc. Open source multimediestandard, används för spel, strömning)"

msgid "mime_rm"
msgstr "RealMedia-video (utvecklad av RealNetworks 1995, RealMedia-format. Pionjär inom internetströmning på 1990-2000-talen, grundformat för RealPlayer-spelaren. Nackdelar: kräver specialspelare, dålig komprimeringskvalitet, senare ersatt av Flash/MP4)"

msgid "mime_flv"
msgstr "Flash-video (formatet dök upp 2002, Flash Video-format. En gång huvudformat för internetvideo, tidig användare var YouTube. Nackdelar: kräver Flash-plugin, dålig prestanda, många säkerhetshål. Från 2015 gick huvudwebbplatserna över till HTML5-video, nu nedlagt)"

msgid "mime_f4v"
msgstr "F4V-video (Flash-videoformat utvecklat av Adobe, efterträdare till FLV. Baserat på MPEG-4-standarden, stöder H.264-kodning. Tillsammans med Flash-tekniken nedlagd, Adobe upphörde med stöd 2020)"

msgid "mime_wmv"
msgstr "WMV-video (utvecklad av Microsoft 1999, Windows Media Video. Inbyggt stöd i Windows, optimerad för strömning, vanligt format för tidiga onlinevideor, nu marginaliserad)"

msgid "mime_wmf"
msgstr "WMF-mediaformat (Windows Media Format, Microsofts mediaplattform. Omfattar samlingsnamnet för WMV-video och WMA-ljud, inbyggt stöd i Windows Media Player)"

msgid "mime_mov"
msgstr "MOV-video (utvecklad av Apple 1991, QuickTime-containerformat. Standardformat för professionell videoredigering, stöder flera codecs, inbyggt stöd i Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "QuickTime-video (lanserad av Apple 1991, QuickTime-format. Videostandard för Mac-plattformen, MOV är dess container, QuickTime-spelaren användes i stor utsträckning. 2016 upphörde Apple med utvecklingen av Windows-versionen, gradvis ersatt av MP4)"

msgid "mime_webm"
msgstr "WebM-video (lanserad av Google 2010, open source utan patent videoformat. Baserad på Matroska-container, VP8/VP9-kodning, standardformat för HTML5-video, YouTubes standardwebbuppspelningsformat)"

msgid "mime_3gp"
msgstr "3GP-video (fastställt av 3GPP 2000, videoformat för mobila enheter. Mycket små filer, låg kvalitet, format för videoinspelning på tidiga mobiltelefoner, används för MMS-sändning)"

