msgstr "  -showdirectorigin     manba to'g'ridan-to'g'ri kirish bo'lganda jurnal qatorini chiqarish"

msgid "  -updatefor=n   to stop the update process after parsing n lines"
msgstr "  -updatefor=n    n ta qatorni tahlil qilgandan keyin yangilash jarayonini to'xtatish"

msgid "  -LogFile=x     to change log to analyze whatever is 'LogFile' in config file"
msgstr "  -LogFile=x     tahlil qilish uchun jurnalni o'zgartirish, sozlash faylidagi 'LogFile' nima bo'lishidan qat'iy nazar"

