#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "ٹیکسٹ فائل (1963 میں ASCII معیاری بنایا گیا، بغیر فارمیٹ کے سادہ متن۔ تمام سورس کوڈ، کنفیگریشن، لاگ کی بنیاد۔ Unix میں LF، Windows میں CRLF لائن بریک، آج بھی کمپیوٹر کا سب سے عام ڈیٹا فارمیٹ)"

msgid "mime_log"
msgstr "لاگ فائل (سادہ ٹیکسٹ فائل جو سسٹم، ایپلیکیشن کے آپریشن معلومات ریکارڈ کرتی ہے، خرابیوں کی جانچ، کارکردگی کے تجزیہ، سیکیورٹی آڈٹ کے لیے استعمال ہوتی ہے۔ معیاری فارمیٹ جیسے Apache combined log، Nginx access log، syslog)"

msgid "mime_page"
msgstr "HTML ویب صفحہ (1989 میں Tim Berners-Lee نے ورلڈ وائڈ ویب ایجاد کیا، 1990 میں HTML/HTTP/URL تینوں ٹیکنالوجیز کی تعریف کی، مفت میں کھولا، پیٹنٹ نہیں کرایا۔ 2014 میں HTML5 W3C کا سرکاری معیار بن گیا، ڈسپلے، ملٹی میڈیا اور پرنٹنگ کو سپورٹ کرتا ہے۔ 2016 میں ٹیورنگ ایوارڈ ملا)"

msgid "mime_khtml"
msgstr "KHTML ویب صفحہ انجن (1998 KDE 2.0 ریلیز، Konqueror براؤزر رینڈرنگ انجن۔ 2001 میں Apple نے KHTML سے WebKit بنایا، 2008 میں Google نے WebKit سے Blink بنا کر شاخ بندی کی، جو Chrome، Edge، Safari جیسے براؤزرز کا مرکز ہے۔ KHTML اوپن سورس کمیونٹی کی جدید براؤزر انجن کی بنیاد رکھنے کی مثال ہے، اس کی تکنیکی میراث WebKit/Blink کے ذریعے آج تک جاری ہے)"

msgid "mime_script"
msgstr "ڈائنامک اسکرپٹ (تشریحی زبان، کمپائل کی ضرورت نہیں۔ ASP, JSP, CGI, ColdFusion, Tcl, VBScript شامل ہیں، ابتدائی ویب ڈویلپمنٹ، سسٹم ایڈمنسٹریشن، آٹومیشن کے کاموں میں وسیع پیمانے پر استعمال ہوتی ہیں۔ جدید اسکرپٹ زبانیں جیسے Python، Ruby، JavaScript مکمل اسٹیک ڈویلپمنٹ کی اہم زبانیں بن چکی ہیں)"

msgid "mime_js"
msgstr "JavaScript اسکرپٹ (1995 میں Brendan Eich نے Netscape میں 10 دنوں میں بنائی، براؤزر کی مقامی پروگرامنگ زبان۔ 1997 میں ECMAScript معیاری بنی، 2009 میں Node.js کی پیدائش نے اسے فل اسٹیک زبان بنا دیا، npm دنیا کا سب سے بڑا پیکیج مینیجر ہے۔ مسلسل کئی سال GitHub پر سب سے زیادہ مقبول پروگرامنگ زبان)"

msgid "mime_py"
msgstr "Python اسکرپٹ (1991 میں Guido van Rossum نے بنائی، لازمی انڈینٹیشن، سادہ نحو کے لیے مشہور۔ ویب ڈویلپمنٹ، ڈیٹا سائنس، مصنوعی ذہانت، آٹومیشن میں وسیع پیمانے پر استعمال ہوتی ہے۔ TIOBE کی سال کی بہترین پروگرامنگ زبان کا متعدد بار اعزاز)"

msgid "mime_sh"
msgstr "شیل اسکرپٹ (1971 میں Unix کی پیدائش، کمانڈ اسکرپٹ زبان۔ سسٹم مینجمنٹ، آٹومیشن کے کاموں، سروس اسٹارٹ، ڈپلائی اسکرپٹس کے لیے استعمال ہوتی ہے۔ Linux کی دیکھ بھال کے لیے ضروری مہارت)"

msgid "mime_rb"
msgstr "Ruby اسکرپٹ (1995 میں Yukihiro Matsumoto نے بنائی، ڈویلپر کی خوشی پر توجہ مرکوز کرتی ہے۔ Ruby on Rails فریم ورک نے ترتیب سے پہلے کنونشن کے ڈویلپمنٹ پیراڈائم کی بنیاد رکھی، جس نے جدید ویب فریم ورک کے ڈیزائن کو متاثر کیا)"

msgid "mime_pl"
msgstr "Perl اسکرپٹ (1987 میں Larry Wall نے بنائی، عملیت پسندی کے لیے مشہور، اسے 'سوئس آرمی چاقو' کہا جاتا ہے۔ CPAN جدید زبان کے پیکیج مینیجرز کا پیش خیمہ ہے، ٹیکسٹ پروسیسنگ، سسٹم ایڈمنسٹریشن، CGI کے میدان میں گہرا اثر رکھتا ہے)"

msgid "mime_php"
msgstr "PHP متحرک ویب صفحہ (1995 میں Rasmus Lerdorf نے بنائی، خاص طور پر ویب ڈویلپمنٹ کے لیے ڈیزائن کی گئی۔ دنیا کی 70% سے زیادہ ویب سائٹیں استعمال کرتی ہیں، WordPress، Facebook، Wikipedia جیسے پلیٹ فارمز کو چلاتی ہے۔ PHP 8 نے JIT کمپائلر متعارف کرایا، کارکردگی میں بہت اضافہ ہوا)"

msgid "mime_image"
msgstr "تصویری فائل"

msgid "mime_document"
msgstr "دستاویزی فائل"

msgid "mime_package"
msgstr "سافٹ ویئر پیکج"

msgid "mime_archive"
msgstr "Gzip کمپریسڈ فائل (1992 میں GNU پروجیکٹ، DEFLATE الگورتھم پر مبنی۔ ویب میں جوابی مواد کو متحرک طور پر کمپریس کرنے کے لیے استعمال ہوتی ہے، کمپریشن کی شرح عام طور پر 60-90% ہوتی ہے۔ 2015 کے بعد کچھ منظرناموں میں Brotli نے اس کی جگہ لے لی، لیکن یہ اب بھی سرور کی طرف سب سے زیادہ تعاون یافتہ کمپریشن فارمیٹ ہے)"

msgid "mime_audio"
msgstr "آڈیو فائل"

msgid "mime_video"
msgstr "ویڈیو فائل"

msgid "mime_jscript"
msgstr "JavaScript (1995 میں Brendan Eich نے تیار کیا)"

msgid "mime_json"
msgstr "JSON ڈیٹا (2001 میں Douglas Crockford نے تجویز کیا، ہلکی پھلکی ڈیٹا تبادلے کی شکل، Web API کی حقیقت پسندانہ معیار)"

msgid "mime_vbs"
msgstr "VBScript (1996 میں Microsoft نے تیار کیا، Windows اسکرپٹ زبان، ASP ویب صفحات اور ونڈوز مینجمنٹ اسکرپٹس کے لیے استعمال ہوتی ہے۔ PowerShell اور JavaScript کے بڑھتے ہوئے استعمال کے ساتھ، آہستہ آہستہ ختم ہو گئی)"

msgid "mime_conf"
msgstr "کنفیگریشن فائل (ٹیکسٹ فارمیٹ میں سافٹ ویئر کنفیگریشن اسٹور کرتی ہے، عام فارمیٹس: INI، JSON، YAML، TOML، XML۔ Linux سسٹم کنفیگریشن زیادہ تر /etc ڈائریکٹری میں ہوتی ہے)"

msgid "mime_css"
msgstr "CSS اسٹائل شیٹ (دسمبر 1996 میں W3C نے CSS1 پہلا سرکاری معیار جاری کیا، 1998 میں CSS2 نے پوزیشننگ اور میڈیا کی اقسام شامل کیں، 2011 سے CSS3 ماڈیولر طریقے سے گول کونوں، اینیمیشن، فلیکس باکس، گرڈ لے آؤٹ اور ریسپانسیو ڈیزائن متعارف کرایا۔ HTML اور JavaScript کے ساتھ فرنٹ اینڈ کی تین بڑی ٹیکنالوجیز میں سے ایک، تمام جدید براؤزرز (Chrome، Firefox، Safari، Edge) مقامی طور پر سپورٹ کرتے ہیں، ویب صفحات کی اسٹائل کی تعریف کا واحد معیار)"

msgid "mime_xsl"
msgstr "XSL اسٹائل شیٹ (1999 W3C معیار، XML دستاویز کی تبدیلی کی زبان، XML کو HTML/PDF/ٹیکسٹ میں تبدیل کر سکتی ہے۔ JSON کے مقبول ہونے کے بعد استعمال کم ہو گیا)"

msgid "mime_runtime"
msgstr "قابل عمل فائل (EXE، ELF، Mach-O جیسے آپریٹنگ سسٹم کے قابل عمل فارمیٹ، جس میں مشین کوڈ اور لوڈنگ کی معلومات ہوتی ہیں)"

msgid "mime_library"
msgstr "لائبریری فائل (DLL، SO، dylib جیسی متحرک لنک لائبریریاں، پروگرام چلتے وقت لوڈ ہونے والا مشترکہ کوڈ)"

msgid "mime_swf"
msgstr "Flash اینیمیشن (1996 میں Macromedia نے تیار کیا، بعد میں Adobe کے پاس چلا گیا۔ انٹرایکٹو ویب اینیمیشن کا معیار، کبھی انٹرنیٹ اینیمیشن اور گیمز پر راج کرتا تھا۔ مسائل: پلگ ان پر انحصار، موبائل سپورٹ نہ ہونا، زیادہ سیکیورٹی خطرات۔ 2017 میں Adobe نے ختم کرنے کا اعلان کیا، 2020 میں مکمل طور پر سپورٹ بند کر دی، اس کی جگہ HTML5/CSS3/JS نے لے لی)"

msgid "mime_dtd"
msgstr "DTD دستاویز کی قسم کی تعریف (XML تصریح، XML دستاویز کی ساخت کی وضاحت کرتی ہے، XML کی قانونی حیثیت کی تصدیق کے لیے استعمال ہوتی ہے)"

msgid "mime_csv"
msgstr "CSV ڈیٹا فارمیٹ (کوما سے الگ کردہ اقدار، ٹیبلر ڈیٹا کا عام فارمیٹ، Excel اور ڈیٹا بیس کی درآمد/برآمد کا معیار)"

msgid "mime_jnlp"
msgstr "Java Web Start (Java ایپلیکیشن لانچر، 2000 کی دہائی میں Java ڈیسک ٹاپ ایپلیکیشن کی تقسیم کی ٹیکنالوجی، اب ختم ہو چکی)"

msgid "mime_lit"
msgstr "Microsoft Reader ای بک (2000 میں Microsoft نے متعارف کرائی، LIT فارمیٹ، ختم ہو چکی)"

msgid "mime_svg"
msgstr "SVG ویکٹر گرافک (1999 W3C معیار، Microsoft کی طرف سے طویل عرصے تک اپنی VML فارمیٹ کو دھکیلنے کی وجہ سے، IE براؤزر نے 2011 تک اسے سپورٹ نہیں کیا، جس سے اس کا پھیلاؤ تاخیر کا شکار ہوا۔ 2015 کے بعد IE کے خاتمے اور ہائی ڈیف اسکرینوں کے مقبول ہونے کے ساتھ، آئیکن، لوگو کے لیے پہلا انتخاب بن گیا)"

msgid "mime_ai"
msgstr "Adobe Illustrator ویکٹر گرافک (1987 میں متعارف کرایا گیا، صنعتی معیاری ویکٹر گرافک فارمیٹ، پرنٹنگ ڈیزائن، لوگو، آئیکن کے لیے پہلا انتخاب)"

msgid "mime_phshop"
msgstr "Photoshop تصویر (1990 میں Adobe نے متعارف کرایا، Photoshop ماخذ فائل PSD، امیج پروسیسنگ کا صنعتی معیار)"

msgid "mime_ttf"
msgstr "TrueType فونٹ (1989 میں Apple اور Microsoft نے مشترکہ طور پر تیار کیا، ویکٹر فونٹ فارمیٹ، اسکرین ڈسپلے اور پرنٹنگ ایک جیسی، جدید آپریٹنگ سسٹم کا ڈیفالٹ فونٹ فارمیٹ)"

msgid "mime_fon"
msgstr "WOFF2 ویب فونٹ (2014 W3C تجویز، Brotli کمپریشن الگورتھم استعمال کرتا ہے، پرانے WOFF کے مقابلے میں حجم تقریباً 30% کم، TTF/OTF کے مقابلے میں 50% سے زیادہ کم، اب تمام جدید براؤزرز اسے سپورٹ کرتے ہیں، موجودہ جدید ویب فونٹس کے لیے پہلا انتخاب ہے، 98% سے زیادہ براؤزرز اسے سپورٹ کرتے ہیں)"

msgid "mime_pdf"
msgstr "PDF دستاویز (1993 میں Adobe نے تیار کیا، 2008 میں ISO بین الاقوامی معیار بنا۔ کراس پلیٹ فارم دستاویز کا فارمیٹ، شکل کی یکسانیت برقرار رکھتا ہے، الیکٹرانک دستاویز کی تقسیم کا عالمی معیار ہے)"

msgid "mime_dotnet"
msgstr "ASP.NET متحرک صفحہ (2002 میں Microsoft نے متعارف کرایا، Windows پلیٹ فارم کی متحرک ویب ٹیکنالوجی، .NET فریم ورک کا حصہ)"

msgid "mime_mdb"
msgstr "Access ڈیٹا بیس (Microsoft Access ڈیٹابیس فائل، 1992 میں متعارف کرائی گئی، Windows ڈیسک ٹاپ ڈیٹا بیس حل)"

msgid "mime_md"
msgstr "Markdown دستاویز (2004 میں John Gruber نے تخلیق کیا، نحو کا ڈیزائن reStructuredText اور Setext سے متاثر تھا۔ بنیادی ڈیزائن فلسفہ 'پڑھنے کے قابل ہی رینڈر ہے'، اصل نفاذ Markdown.pl نے Perl ریگولر ایکسپریشنز استعمال کیے۔ مشتق تصریحات میں GFM (2013)، CommonMark (2017)، Pandoc Markdown وغیرہ شامل ہیں۔ GitHub، GitLab، Stack Overflow، Jupyter Notebook، Obsidian، Hugo، VitePress جیسے ماحولیاتی نظام کو چلاتا ہے، جامد ویب سائٹ جنریٹرز اور ڈویلپر دستاویزات کا حقیقت پسندانہ معیاری فارمیٹ بن گیا)"

msgid "mime_crystal"
msgstr "Crystal Reports رپورٹ فارمیٹ (SAP بزنس انٹیلیجنس رپورٹ، انٹرپرائز رپورٹس کا معیاری فارمیٹ)"

msgid "mime_libreoffice"
msgstr "LibreOffice دستاویز (2010 میں The Document Foundation نے تیار کیا، OpenOffice کی شاخ، ODF معیار کا نفاذ، مرکزی اوپن سورس آفس سوٹ)"

msgid "mime_encrypt"
msgstr "خفیہ کردہ فائل (دیکھنے کے لیے ڈکرپٹ کرنے کی ضرورت ہوتی ہے، عام توسیعات: .enc، .crypt، .pgp، .gpg)"

msgid "mime_gpx"
msgstr "GPS ٹریک ڈیٹا (GPS ایکسچینج فارمیٹ، جغرافیائی محل وقوع کی معلومات ریکارڈ کرتا ہے، اسپورٹس واچ، نیویگیشن ڈیوائسز کا عام فارمیٹ)"

msgid "mime_diskimage"
msgstr "ڈسک امیج (DMG، ISO، IMG جیسی CD/ڈسک امیج فائلیں، سافٹ ویئر کی تقسیم یا بیک اپ اسٹوریج میڈیا کے لیے استعمال ہوتی ہیں)"

msgid "mime_vm"
msgstr "ورجوئل مشین امیج (VMDK، VDI، VHDX، OVA جیسی ورجوئل مشین ڈسک فائلیں، VMware، VirtualBox، Hyper-V جیسے ورچوئلائزیشن پلیٹ فارمز کے فارمیٹس)"

msgid "mime_torrent"
msgstr "BitTorrent ٹورنٹ فائل (2001 میں Bram Cohen نے ایجاد کی، P2P ڈاؤن لوڈ انڈیکس فائل، جس میں فائل میٹا ڈیٹا اور ٹریکر معلومات ہوتی ہیں)"

msgid "mime_gis"
msgstr "GIS جغرافیائی معلوماتی نظام ڈیٹا (Shapefile، GeoJSON جیسے جغرافیائی مقامی ڈیٹا فارمیٹس، نقشوں اور مقامی تجزیہ کے لیے استعمال ہوتے ہیں)"

msgid "mime_ebook"
msgstr "ای بک (EPUB، MOBI، AZW جیسے ای بک فارمیٹس۔ EPUB بین الاقوامی معیار ہے، MOBI/AZW Amazon Kindle کے فارمیٹ ہیں)"

msgid "mime_avif"
msgstr "AVIF تصویر (2019 میں Open Media Alliance نے متعارف کرائی، AV1 کوڈیک پر مبنی، WebP سے 50% زیادہ کمپریشن شرح، نئی نسل کا ویب امیج معیار)"

msgid "mime_markdown"
msgstr "Markdown دستاویز (2004 میں John Gruber نے ڈیزائن کی، ہلکی پھلکی مارک اپ زبان، GitHub README، تکنیکی دستاویزات، فورم پوسٹس کا عام فارمیٹ)"

msgid "mime_yaml"
msgstr "YAML کنفیگریشن (2001 میں Clark Evans نے ڈیزائن کی، انسان کے پڑھنے کے قابل ڈیٹا سیریلائزیشن فارمیٹ، Kubernetes، Ansible، Docker Compose کنفیگریشن فائلوں کا معیار)"

msgid "mime_toml"
msgstr "TOML کنفیگریشن (2013 میں Tom Preston-Werner نے ڈیزائن کی، 'Tom's Obvious Minimal Language'، Rust/Cargo، Python/pip، Go جیسے جدید ٹولز کی کنفیگریشن فائل کا فارمیٹ)"

msgid "mime_vue"
msgstr "Vue جزو فائل (2014 میں ایوان یو نے متعارف کرایا، ایک ترقی پسند JavaScript فریم ورک۔ سنگل فائل اجزاء (SFC) کے ذریعے یہ HTML، CSS اور JS کو مکمل طور پر یکجا کرتا ہے، جس سے ترقی کی کارکردگی میں بہت اضافہ ہوتا ہے۔ یہ دنیا کے سب سے مقبول فرنٹ اینڈ فریم ورکس میں سے ایک ہے۔ اس کے علاوہ، VitePress جیسے جدید جامد سائٹ جنریٹرز کے بنیادی حصے کے طور پر، یہ انٹرایکٹو تکنیکی دستاویزات اور بلاگز کو چلانے کے لیے بڑے پیمانے پر استعمال ہوتا ہے۔)"

msgid "mime_wasm"
msgstr "WebAssembly ماڈیول (2017 W3C معیار، براؤزر میں اعلیٰ کارکردگی پر عمل درآمد کا فارمیٹ، C/C++/Rust/R اسے ہدف بنا سکتے ہیں، کارکردگی مقامی کے قریب)"

msgid "mime_jsx"
msgstr "React JSX اجزاء (2013 میں Facebook نے JavaScript XML متعارف کرایا، React فریم ورک کے اجزاء کا نحو، HTML کو JavaScript میں لکھنے کا جدید نمونہ)"

msgid "mime_tsx"
msgstr "TypeScript TSX اجزاء (2012 میں Microsoft نے تیار کیا، TypeScript + JSX، React کی قسم سے محفوظ ترقی کا معیاری طریقہ)"

msgid "mime_heif"
msgstr "HEIF تصویر (2015 MPEG معیار، موثر امیج فائل فارمیٹ، Apple ایکو سسٹم میں وسیع پیمانے پر استعمال)"

msgid "mime_heic"
msgstr "HEIC تصویر (Apple کا HEIF نفاذ، iPhone کی ڈیفالٹ تصویری فارمیٹ، iOS/macOS مقامی طور پر سپورٹ کرتے ہیں)"

msgid "mime_gltf"
msgstr "GLTF 3D ماڈل (GL ٹرانسمیشن فارمیٹ، '3D کا JPEG'، 2015 میں Khronos Group نے جاری کیا، ویب 3D کا معیاری فارمیٹ)"

msgid "mime_glb"
msgstr "GLB بائنری 3D ماڈل (GLTF کا بائنری ورژن، واحد فائل میں تمام وسائل شامل ہیں، 3D مناظر کی تقسیم کے لیے استعمال ہوتا ہے)"

msgid "mime_gls"
msgstr "GLOSSARY فرہنگ (اصطلاحات کی تعریف کرنے والی فائل، دستاویزی نظاموں میں اصطلاحات کے انتظام کے لیے)"

msgid "mime_cbz"
msgstr "CBZ کامک بک (ZIP کمپریسڈ کامک امیجز، کامک کلیکشن کا عام فارمیٹ)"

msgid "mime_cbr"
msgstr "CBR کامک بک (RAR کمپریسڈ کامک امیجز، کامک کلیکشن کا عام فارمیٹ)"

msgid "mime_fb2"
msgstr "FB2 ای بک (FictionBook 2.0، روسی ای بک فارمیٹ، XML ساخت، اوپن سورس ریڈرز وسیع پیمانے پر سپورٹ کرتے ہیں)"

msgid "mime_kepub"
msgstr "KEPUB ای بک (Kobo کا خصوصی EPUB فارمیٹ، Kobo ای بک ریڈر کے لیے بہتر بنایا گیا فارمیٹ)"

msgid "mime_m4b"
msgstr "M4B آڈیو بک (MPEG-4 آڈیو بک فارمیٹ، بک مارک سپورٹ کرتا ہے، iTunes آڈیو بک کا فارمیٹ)"

msgid "mime_kfx"
msgstr "Kindle KFX فارمیٹ (2015 میں Amazon نے متعارف کرایا، Kindle کا خصوصی ای بک فارمیٹ، بہتر ٹائپوگرافی اور تیز صفحہ پلٹنے کی سہولت فراہم کرتا ہے)"

msgid "mime_chm"
msgstr "CHM مدد فائل (1997 میں Microsoft نے متعارف کرائی، مرتب شدہ HTML مدد فارمیٹ، Windows سافٹ ویئر مدد دستاویزات کا معیار)"

msgid "mime_mht"
msgstr "MHT ویب آرکائیو (1999 میں Microsoft نے متعارف کرایا، واحد فائل ویب فارمیٹ، IE براؤزر میں ویب صفحات محفوظ کرنے کا فارمیٹ)"

msgid "mime_wml"
msgstr "WML وائرلیس مارک اپ لینگویج (1999 WAP معیار، ابتدائی فیچر فون ویب صفحات کے لیے استعمال ہوتی تھی، اب ختم ہو چکی)"

msgid "mime_xhtml"
msgstr "XHTML ویب صفحہ (2000 W3C معیار، HTML کا XML ورژن، زیادہ سخت نحو۔ 2009 میں W3C نے اسے برقرار رکھنا بند کر دیا، توجہ HTML5 کی طرف مرکوز کر دی)"

msgid "mime_xml"
msgstr "XML دستاویز (1998 W3C معیار، قابل توسیع مارک اپ لینگویج، ویب سروسز، کنفیگریشن فائلوں، ڈیٹا کے تبادلے کی بنیادی شکل)"

msgid "mime_sgml"
msgstr "SGML دستاویز (1986 ISO معیار، HTML کا پیش خیمہ، معیاری عمومی مارک اپ لینگویج، XML اور HTML دونوں SGML سے اخذ کیے گئے ہیں)"

msgid "mime_apng"
msgstr "APNG اینیمیشن (2004 میں Mozilla نے تیار کیا، PNG کی اینیمیشن توسیع، GIF کا جدید متبادل، حقیقی رنگ اور نیم شفافیت کو سپورٹ کرتا ہے)"

msgid "mime_bmp"
msgstr "BMP بٹ میپ (Windows بٹ میپ فارمیٹ، Windows 1.0 سے مقامی طور پر سپورٹ کیا جاتا ہے۔ بغیر کمپریشن کے، فائل بڑی ہوتی ہے، لیکن ساخت سادہ ہونے اور اضافی کوڈیک کی ضرورت نہ ہونے کی وجہ سے، Windows 11 اسکرین شاٹ ٹول، پینٹ پروگرام، EXE/MSI انسٹالیشن پیکج کے آئیکن وسائل، کرسر فائلیں اور کچھ پرانے ڈرائیورز اب بھی اسے استعمال کرتے ہیں۔ ایک جیسے معیار میں PNG سے تقریباً 3-10 گنا بڑی فائل، زیادہ تر منظرناموں میں PNG/JPEG نے اس کی جگہ لے لی، لیکن Windows ماحولیاتی نظام میں اب بھی وسیع مطابقت برقرار ہے)"

msgid "mime_cdr"
msgstr "CDR ویکٹر گرافک (CorelDRAW کا خصوصی فارمیٹ، کینیڈا کی Corel کمپنی، ویکٹر گرافک ڈیزائن سافٹ ویئر)"

msgid "mime_gif"
msgstr "GIF تصویر (1987 میں CompuServe نے تیار کی، 256 رنگوں والا اینیمیشن فارمیٹ۔ مسائل: کم رنگ، خراب معیار، نیم شفافیت کو سپورٹ نہ کرنا، بڑی فائل، کم فریم ریٹ۔ APNG، WebP جیسے جدید اینیمیشن فارمیٹس نے اس کی جگہ لے لی)"

msgid "mime_ico"
msgstr "ICO آئیکن (Windows آئیکن فائل فارمیٹ، متعدد ریزولوشنز کو سپورٹ کرتا ہے، ویب سائٹ favicon کا معیاری فارمیٹ)"

msgid "mime_jpeg"
msgstr "JPEG تصویر (1992 ISO معیار، نقصان دہ کمپریشن والی تصویری فارمیٹ، انٹرنیٹ تصاویر کا حقیقت پسندانہ معیار)"

msgid "mime_jpg"
msgstr "JPEG تصویر (1992 ISO معیار، نقصان دہ کمپریشن والی تصویری فارمیٹ، انٹرنیٹ تصاویر کا حقیقت پسندانہ معیار)"

msgid "mime_png"
msgstr "PNG تصویر (1996 W3C تجویز، حقیقی رنگ اور نیم شفافیت کو سپورٹ کرتی ہے، GIF کا جامد متبادل، انٹرنیٹ کی غیر نقصان دہ تصویری معیار)"

msgid "mime_ps"
msgstr "PostScript صفحہ تفصیل فائل (1985 میں Adobe نے متعارف کرائی، صفحہ تفصیل زبان، PDF کی پیش خیمہ، پرنٹنگ اور اشاعت کے لیے استعمال ہوتی ہے)"

msgid "mime_psb"
msgstr "PSB بڑی دستاویز (Adobe Photoshop کی بہت بڑی تصویری فارمیٹ، 2GB یا 30000 پکسلز سے بڑی تصاویر کو سپورٹ کرتی ہے)"

msgid "mime_psd"
msgstr "PSD تصویر (Adobe Photoshop ماخذ فائل، تہوں، چینلز، راستوں کو سپورٹ کرتی ہے، امیج پروسیسنگ کا صنعتی معیاری فارمیٹ)"

msgid "mime_webp"
msgstr "WebP تصویر (2010 میں Google نے تیار کی، ویب امیج فارمیٹ، نقصان دہ/غیر نقصان دہ کمپریشن اور اینیمیشن کو سپورٹ کرتی ہے، PNG سے 25-35% زیادہ کمپریشن شرح، JPEG سے 25% زیادہ)"

msgid "mime_woff"
msgstr "WOFF ویب فونٹ (2009 میں تخلیق کیا گیا، 2018 W3C معیار۔ TrueType/OpenType پر مبنی کمپریشن، ویب فونٹ لوڈنگ کو بہتر بناتا ہے، جدید ویب سائٹ آئیکن فونٹس کا معیاری فارمیٹ)"

msgid "mime_7z"
msgstr "7z کمپریسڈ پیکج (1999 میں Igor Pavlov نے تیار کیا، 7-Zip پروگرام کا خصوصی فارمیٹ۔ LZMA الگورتھم، اعلیٰ کمپریشن شرح، اوپن سورس اور مفت۔ 7z فارمیٹ ایک ہی کمپریشن شرح پر عام طور پر ZIP سے 30-50% چھوٹا ہوتا ہے، یہ اوپن سورس کمیونٹی اور سافٹ ویئر کی تقسیم کے لیے ایک عام فارمیٹ ہے)"

msgid "mime_ace"
msgstr "ACE کمپریسڈ پیکج (1990 کی دہائی میں تیار کیا گیا، WinACE پروگرام کا فارمیٹ۔ کبھی RAR سے مقابلہ کرتا تھا، کمپریشن شرح زیادہ تھی۔ 2007 میں ترقی بند ہو گئی، اب 7z/RAR نے اس کی جگہ لے لی، کم استعمال ہوتا ہے)"

msgid "mime_bz2"
msgstr "BZIP2 کمپریسڈ پیکج (1996 میں Julian Seward نے تیار کیا، بلاک سورٹنگ کمپریشن الگورتھم۔ GZIP سے 15-20% زیادہ کمپریشن شرح، لیکن رفتار سست۔ Linux کرنل سورس کوڈ، اوپن سورس سافٹ ویئر پیکجز کے لیے عام فارمیٹ، توسیع .bz2"

msgid "mime_cab"
msgstr "CAB کمپریسڈ پیکج (1995 میں Microsoft نے متعارف کرایا، Cabinet فارمیٹ۔ Windows سسٹم انسٹالیشن پیکج فارمیٹ، ڈرائیورز، سسٹم فائلوں کی تقسیم کے لیے استعمال ہوتا ہے۔ Windows Installer (MSI) اندرونی طور پر CAB کا استعمال کرتا ہے"

msgid "mime_dmg"
msgstr "DMG ڈسک امیج (1980 کی دہائی میں Apple نے متعارف کرایا، Disk Image فارمیٹ۔ macOS سافٹ ویئر کی تقسیم کا معیاری فارمیٹ، ڈبل کلک کرنے پر ورچوئل ڈسک کے طور پر ماؤنٹ ہو جاتا ہے، ایپلیکیشن کو گھسیٹ کر انسٹال کیا جا سکتا ہے۔ کمپریشن اور خفیہ کاری کو سپورٹ کرتا ہے، Mac سافٹ ویئر ڈاؤن لوڈ کا مرکزی فارمیٹ ہے)"

msgid "mime_emz"
msgstr "EMZ کمپریسڈ تصویر (Windows کمپریسڈ اینہانسڈ میٹا فائل، EMF کا کمپریسڈ ورژن۔ Office دستاویزات میں ویکٹر گرافکس کے اسٹوریج فارمیٹ، بنیادی طور پر GZIP کمپریسڈ EMF فائل ہے)"

msgid "mime_gz"
msgstr "GZIP کمپریسڈ پیکج (1992 میں Jean-loup Gailly اور Mark Adler نے تیار کیا، GNU پروجیکٹ۔ Unix/Linux کا معیاری کمپریشن ٹول، HTTP ٹرانسمیشن کمپریشن کے لیے عام فارمیٹ۔ توسیع .gz، اکثر TAR کے ساتھ استعمال ہوتا ہے)"

msgid "mime_jar"
msgstr "JAR کمپریسڈ پیکج (1997 میں Sun Microsystems نے متعارف کرایا، Java ARchive فارمیٹ۔ بنیادی طور پر ZIP کمپریسڈ پیکج ہے، Java کلاس لائبریریوں اور ایپلیکیشنز کو پیک کرنے کے لیے استعمال ہوتا ہے۔ Maven، Gradle جیسے Java ماحولیاتی نظام کا بنیادی فارمیٹ، Android بھی JAR استعمال کرتا ہے)"

msgid "mime_lzma"
msgstr "LZMA کمپریسڈ پیکج (1998 میں Igor Pavlov نے تیار کیا، Lempel-Ziv-Markov chain الگورتھم۔ 7z فارمیٹ کا بنیادی کمپریشن الگورتھم، اعلیٰ کمپریشن شرح، تیز ڈیکمپریشن۔ فرمویر، ایمبیڈڈ سسٹم سافٹ ویئر کی تقسیم کے لیے استعمال ہوتا ہے)"

msgid "mime_rar"
msgstr "RAR کمپریسڈ پیکج (1993 میں Eugene Roshal نے تیار کیا، Roshal ARchive فارمیٹ۔ اعلیٰ کمپریشن شرح، والیوم اسپلٹنگ، ریکوری ریکارڈ کو سپورٹ کرتا ہے۔ WinRAR پروگرام کا فارمیٹ، ZIP سے بہتر کمپریشن شرح، لیکن ادائیگی والے سافٹ ویئر کی ضرورت ہوتی ہے، اوپن سورس ٹولز جیسے unrar ڈیکمپریس کر سکتے ہیں)"

msgid "mime_tar"
msgstr "TAR آرکائیو پیکج (1979 میں Unix V7 میں متعارف کرایا گیا، Tape ARchive فارمیٹ۔ ٹیپ آرکائیو فارمیٹ، صرف پیک کرتا ہے کمپریس نہیں کرتا، اکثر GZIP/BZIP2/XZ کے ساتھ استعمال ہوتا ہے۔ Linux سافٹ ویئر پیکج کا سورس کوڈ، Docker امیج لیئرڈ اسٹوریج TAR فارمیٹ استعمال کرتے ہیں)"

msgid "mime_tgz"
msgstr "TGZ کمپریسڈ پیکج (TAR + GZIP مجموعہ فارمیٹ، توسیع .tgz یا .tar.gz۔ Unix/Linux سافٹ ویئر پیکج کی سب سے عام تقسیم کا فارمیٹ، سورس کوڈ پیکجز، بائنری پیکجز وسیع پیمانے پر استعمال کرتے ہیں، 'ڈیکمپریس اور استعمال کریں' کی نمائندگی)"

msgid "mime_tbz2"
msgstr "TBZ2 کمپریسڈ پیکج (TAR + BZIP2 مجموعہ فارمیٹ، توسیع .tbz2 یا .tar.bz2۔ کمپریشن شرح TGZ سے 15-20% زیادہ، بڑی فائلوں کی تقسیم کے لیے موزوں، Linux کرنل سورس کوڈ نے طویل عرصے تک یہ فارمیٹ استعمال کیا)"

msgid "mime_xz"
msgstr "XZ کمپریسڈ پیکج (2009 میں متعارف کرایا گیا، LZMA2 الگورتھم پر مبنی۔ انتہائی اعلیٰ کمپریشن شرح، GZIP سے 30-50% زیادہ، ڈیکمپریشن رفتار نسبتاً تیز۔ Linux کرنل، پیکیج مینیجرز (جیسے Debian کا .deb اندرونی طور پر) وسیع پیمانے پر استعمال کرتے ہیں، موجودہ Linux ماحولیاتی نظام کا تجویز کردہ فارمیٹ ہے)"

msgid "mime_z"
msgstr "Z کمپریسڈ پیکج (1985 میں Unix compress کمانڈ فارمیٹ، LZW الگورتھم۔ ابتدائی Unix کمپریشن فارمیٹ، GZIP نے اس کی جگہ لے لی۔ توسیع .Z، جدید نظاموں میں کم استعمال ہوتا ہے)"

msgid "mime_zip"
msgstr "ZIP کمپریسڈ پیکج (1989 میں Phil Katz نے تیار کیا، PKZIP فارمیٹ۔ Windows مقامی طور پر سپورٹ کرتا ہے، انٹرنیٹ کا سب سے عام کمپریشن فارمیٹ۔ متعدد فائلوں، ڈائریکٹری ڈھانچے کو سپورٹ کرتا ہے، کمپریشن الگورتھم کا انتخاب کر سکتا ہے۔ Java کا JAR، Android کا APK، Office دستاویزات کا DOCX/XLSX سب ZIP فارمیٹ پر مبنی ہیں)"

msgid "mime_zst"
msgstr "Zstandard کمپریسڈ پیکج (2015 میں Facebook نے تیار کیا، Yann Collet نے ڈیزائن کیا۔ تیز رفتار کمپریشن الگورتھم، کمپریشن شرح LZMA کے قریب، رفتار GZIP سے کہیں زیادہ۔ Linux کرنل 5.9+ سپورٹ کرتا ہے، Arch Linux pacman، Debian APT آہستہ آہستہ اپنا رہے ہیں، یہ نئی نسل کا کمپریشن معیار ہے)"

msgid "mime_lz4"
msgstr "LZ4 کمپریسڈ پیکج (2011 میں Yann Collet نے تیار کیا، انتہائی تیز کمپریشن الگورتھم۔ کمپریشن رفتار GZIP سے 10 گنا سے زیادہ تیز، ریئل ٹائم کمپریشن منظرناموں کے لیے موزوں۔ Linux کرنل، OpenZFS، Hadoop وسیع پیمانے پر استعمال کرتے ہیں، رفتار کو ترجیح دینے والے منظرناموں کے لیے پہلا انتخاب ہے)"

msgid "mime_lzo"
msgstr "LZO کمپریسڈ پیکج (1996 میں Markus Oberhumer نے تیار کیا، Lempel-Ziv-Oberhumer الگورتھم۔ ڈیکمپریشن کی رفتار انتہائی تیز، کمپریشن شرح عام ہے۔ Linux کرنل Squashfs، OpenWrt فرم ویئر استعمال کرتے ہیں، ایمبیڈڈ سسٹمز کے لیے موزوں ہے)"

msgid "mime_msi"
msgstr "MSI انسٹالیشن پیکج (1999 میں Microsoft نے متعارف کرایا، Windows Installer پیکج فارمیٹ۔ Windows ایپلیکیشنز کا معیاری انسٹالیشن فارمیٹ، ٹرانزیکشن رول بیک، کمپونینٹ مینجمنٹ، خاموش انسٹالیشن کو سپورٹ کرتا ہے۔ انٹرپرائز سطح کے سافٹ ویئر کی تقسیم کے لیے پہلا انتخاب، آج بھی Windows سافٹ ویئر انسٹالیشن کا مرکزی فارمیٹ ہے)"

msgid "mime_pkg"
msgstr "PKG انسٹالیشن پیکج (macOS ایپلیکیشن انسٹالیشن پیکج فارمیٹ، Apple کے Installer ٹیکنالوجی پر مبنی۔ macOS سافٹ ویئر کی تقسیم کا معیاری فارمیٹ، کمپونینٹ سلیکشن، انسٹالیشن اسکرپٹس، ان انسٹال فنکشن کو سپورٹ کرتا ہے۔ .pkg فائل ڈبل کلک کرنے پر انسٹال ہو جاتی ہے، Mac App Store کے علاوہ سافٹ ویئر کی تقسیم کا عام طریقہ)"

msgid "mime_apk"
msgstr "APK Android ایپلیکیشن پیکج (2008 میں Google نے متعارف کرایا، Android سسٹم کا روایتی ایپلیکیشن انسٹالیشن فارمیٹ۔ APK بنیادی طور پر ZIP کمپریسڈ پیکج ہے، جس میں کوڈ، وسائل، مینی فیسٹ فائل ہوتی ہے۔ 2021 میں Google Play نے نئی ایپلیکیشنز کے لیے AAB فارمیٹ استعمال کرنے کی ضرورت شروع کر دی، لیکن APK اب بھی ڈویلپمنٹ ڈیبگنگ، تھرڈ پارٹی اسٹورز اور سائیڈ لوڈ انسٹالیشن کے لیے استعمال ہوتا ہے)"

msgid "mime_ipa"
msgstr "IPA Apple ایپلیکیشن پیکج (iOS App Store Package، iOS/iPadOS ایپلیکیشن انسٹالیشن فارمیٹ۔ 2008 میں iPhone SDK کے ساتھ جاری کیا گیا۔ App Store کے ذریعے تقسیم یا انٹرپرائز سرٹیفکیٹ کے ساتھ دستخط کرنے کی ضرورت ہوتی ہے۔ اس میں قابل عمل فائل، وسائل، Info.plist دستخط کی معلومات ہوتی ہیں)"

msgid "mime_hap"
msgstr "HAP ہارمونی او ایس ایپلیکیشن پیکج (HarmonyOS Ability Package، ہارمونی ایپلیکیشن کی بنیادی اکائی۔ 2020 میں HarmonyOS 2.0 کے ساتھ جاری کیا گیا۔ entry اور feature دو اقسام کو سپورٹ کرتا ہے، ہواوے فونز، ٹیبلٹس، سمارٹ واٹچز جیسے ہارمونی آلات کی تقسیم کا فارمیٹ)"

msgid "mime_har"
msgstr "HAR ہارمونی جامد مشترکہ پیکج (HarmonyOS Archive، ہارمونی جامد مشترکہ لائبریری، جسے متعدد HAPs کے درمیان شیئر کیا جا سکتا ہے، کمپوننٹ پر مبنی ترقی اور ماڈیول ریوز کے لیے استعمال ہوتا ہے)"

msgid "mime_aab"
msgstr "Android App Bundle (2018 میں Google نے متعارف کرایا، 2021 سے Google Play نئی ایپلیکیشنز کے لیے اس فارمیٹ کو لازمی قرار دے چکا ہے۔ AAB تقسیم کا فارمیٹ ہے، Google Play آلہ کی ترتیب (CPU آرکیٹیکچر، اسکرین کثافت، زبان) کے مطابق متحرک طور پر بہتر کردہ APK تیار کرتا ہے، انسٹالیشن پیکج کا سائز اوسطاً 35% کم ہوتا ہے۔ ڈویلپر AAB اپ لوڈ کرتے ہیں، صارفین APK ڈاؤن لوڈ کرتے ہیں)"

msgid "mime_xapk"
msgstr "XAPK ایپلیکیشن پیکج (تیسری پارٹی Android ایپلیکیشن توسیعی پیکج، جس میں APK + OBB ڈیٹا فائل ہوتی ہے۔ بڑے گیمز اور پیچیدہ ایپلیکیشنز کے لیے استعمال ہوتی ہے، APK کی واحد فائل کی 100MB حد کو حل کرتی ہے۔ APKPure، APKMirror جیسے تھرڈ پارٹی ایپ اسٹورز میں عام ہے، Google کا سرکاری فارمیٹ نہیں ہے)"

msgid "mime_appx"
msgstr "Windows ایپلیکیشن پیکج (2012 میں Microsoft نے متعارف کرایا، Windows 8/10/11 ایپلیکیشن انسٹالیشن فارمیٹ۔ UWP اور ڈیسک ٹاپ ایپلیکیشن کنورژن کو سپورٹ کرتا ہے، Microsoft Store کے ذریعے تقسیم کیا جاتا ہے۔ 2024 میں Microsoft نے MSIX بطور جانشین فارمیٹ متعارف کرایا، آہستہ آہستہ APPX کی جگہ لے رہا ہے)"

msgid "mime_msix"
msgstr "MSIX ایپلیکیشن پیکج (2018 میں Microsoft نے متعارف کرایا، Windows کی نئی نسل کا ایپلیکیشن پیکجنگ فارمیٹ۔ APPX اور MSI کے فوائد کو یکجا کرتا ہے، تمام Windows ایپلیکیشن اقسام کو سپورٹ کرتا ہے، Microsoft Store یا سائیڈ لوڈ کے ذریعے انسٹال کیا جا سکتا ہے، Windows 11 کا تجویز کردہ فارمیٹ)"

msgid "mime_appimage"
msgstr "AppImage ایپلیکیشن پیکج (2004 میں متعارف کرایا گیا، Linux بغیر انسٹالیشن والا ایپلیکیشن فارمیٹ۔ 'ایک ایپلیکیشن ایک فائل'، بغیر انسٹالیشن کے براہ راست چلتی ہے، زیادہ تر Linux ڈسٹری بیوشنز کو سپورٹ کرتی ہے، ڈویلپرز کے لیے Linux سافٹ ویئر تقسیم کرنے کا عام طریقہ)"

msgid "mime_flatpak"
msgstr "Flatpak ایپلیکیشن پیکج (2015 میں متعارف کرایا گیا، Linux سینڈ باکس شدہ ایپلیکیشن فارمیٹ۔ کراس ڈسٹری بیوشن چلتی ہے، میزبان سسٹم سے الگ تھلگ رہتی ہے، Fedora، Red Hat کی سربراہی میں تیار کی گئی، GNOME سافٹ ویئر سینٹر کا ڈیفالٹ فارمیٹ)"

msgid "mime_snap"
msgstr "Snap ایپلیکیشن پیکج (2014 میں Canonical نے متعارف کرایا، Ubuntu کی بنیادی کمپنی نے تیار کیا، Linux کا عمومی ایپلیکیشن فارمیٹ۔ خودکار اپ ڈیٹ، سینڈ باکس الگ تھلگ، 40+ Linux ڈسٹری بیوشنز کو سپورٹ کرتا ہے، Ubuntu سافٹ ویئر سینٹر کا ڈیفالٹ فارمیٹ)"

msgid "mime_deb"
msgstr "Debian سافٹ ویئر پیکج (1993 میں Debian پروجیکٹ نے متعارف کرایا، Debian/Ubuntu اور ان کے مشتقات کا معیاری انسٹالیشن فارمیٹ۔ dpkg کے ذریعے منظم کیا جاتا ہے، APT اس کا پیکیج مینیجر فرنٹ اینڈ ہے، Linux ماحولیاتی نظام کے سب سے پختہ پیکج فارمیٹس میں سے ایک، آج بھی Debian فیملی کا مرکزی فارمیٹ ہے)"

msgid "mime_rpm"
msgstr "RPM سافٹ ویئر پیکج (1997 میں Red Hat نے متعارف کرایا، Red Hat/Fedora/CentOS/SUSE جیسی ڈسٹری بیوشنز کا معیاری فارمیٹ۔ RPM کا مطلب 'Red Hat Package Manager' ہے، DEB کے ساتھ Linux کے دو بڑے پیکج فارمیٹس میں سے ایک، آج بھی RHEL فیملی کا مرکزی فارمیٹ ہے)"

msgid "mime_pacman"
msgstr "آرچ سافٹ ویئر پیکج (2002 میں Arch Linux نے متعارف کرایا، pacman پیکیج مینیجر کا .pkg.tar.zst فارمیٹ۔ Arch Linux رولنگ ریلیز ڈسٹری بیوشن کا بنیادی جزو، سادگی اور KISS اصول کے لیے جانا جاتا ہے، AUR (Arch User Repository) اس کی خاص بات ہے)"

msgid "mime_exe"
msgstr "EXE قابل عمل فائل (Windows قابل عمل پروگرام فارمیٹ، 'Executable' کا مخفف۔ Windows آپریٹنگ سسٹم کا مقامی قابل عمل فارمیٹ، PE ڈھانچہ پر مشتمل ہوتا ہے۔ MS-DOS کے MZ فارمیٹ سے تیار ہوا، 1993 میں Windows NT نے PE (Portable Executable) فارمیٹ متعارف کرایا جو آج تک استعمال ہو رہا ہے۔ سافٹ ویئر انسٹالیشن پیکجز، ایپلیکیشنز، سسٹم ٹولز یہ فارمیٹ استعمال کرتے ہیں۔ صارف ڈبل کلک کر کے چلا سکتا ہے، یہ دنیا میں سب سے زیادہ استعمال ہونے والا قابل عمل فارمیٹ ہے)"

msgid "mime_dll"
msgstr "DLL متحرک لنک لائبریری (1993 میں Microsoft نے متعارف کرائی، Dynamic Link Library۔ Windows کا مشترکہ کوڈ لائبریری، پروگرام چلتے وقت متحرک طور پر لوڈ ہوتی ہے، میموری اور ڈسک کی جگہ بچاتی ہے۔ سسٹم کے اجزاء، ایپلیکیشن پلگ انز، ڈرائیورز DLL فارمیٹ استعمال کرتے ہیں۔ Windows API کے نفاذ کا بنیادی طریقہ، DLL Hell مسئلہ .NET دور میں کم ہوا)"

msgid "mime_com"
msgstr "COM قابل عمل فائل (MS-DOS دور کا قابل عمل فارمیٹ، 'Command' کا مخفف۔ فائل کا ڈھانچہ آسان، 64KB کی حد، Windows 3.x سے پہلے مرکزی فارمیٹ تھا۔ اب ختم ہو چکا ہے، جدید Windows EXE فارمیٹ استعمال کرتا ہے، COM توسیع اب بھی کچھ کمپوننٹ فائلوں کے لیے استعمال ہوتی ہے)"

msgid "mime_aac"
msgstr "AAC آڈیو (1997 MPEG معیار، Advanced Audio Coding۔ MP3 کا جانشین، ایک ہی بٹ ریٹ پر MP3 سے بہتر آواز کا معیار، YouTube، iTunes، Nintendo Switch کا ڈیفالٹ آڈیو فارمیٹ)"

msgid "mime_alac"
msgstr "ALAC آڈیو (2004 میں Apple نے تیار کیا، Apple Lossless Audio Codec۔ ایپل کا غیر نقصان دہ فارمیٹ، 2011 میں اوپن سورس ہوا، iTunes اور Apple Music کے غیر نقصان دہ آڈیو کا ڈیفالٹ فارمیٹ)"

msgid "mime_flac"
msgstr "FLAC آڈیو (2001 میں Xiph.Org فاؤنڈیشن نے تیار کیا، Free Lossless Audio Codec۔ غیر نقصان دہ کمپریشن، آواز کا معیار CD کے برابر، فائل کا سائز اصل WAV کا نصف کے قریب ہوتا ہے۔ اوپن سورس اور پیٹنٹ سے پاک، آڈیو فائلز اور ڈیجیٹل میوزک کلیکشن کرنے والوں کے لیے پہلا انتخاب"

msgid "mime_mp3"
msgstr "MP3 آڈیو (1993 میں Fraunhofer انسٹی ٹیوٹ نے تیار کیا، MPEG-1 Audio Layer 3۔ نقصان دہ کمپریشن فارمیٹ، فائل کا سائز چھوٹا اور آواز کا معیار قابل قبول، 2000 کی دہائی میں ڈیجیٹل میوزک انقلاب کا بنیادی فارمیٹ، iPod اور Napster کی کامیابی کی وجہ۔ 2017 میں پیٹنٹ کی میعاد ختم ہو گئی، عوامی ڈومین کا فارمیٹ بن گیا)"

msgid "mime_oga"
msgstr "Ogg Audio آڈیو (Xiph.Org فاؤنڈیشن نے تیار کیا، Ogg کنٹینر کا خالص آڈیو فارمیٹ، Vorbis کوڈیک استعمال کرتا ہے۔ اوپن سورس اور پیٹنٹ سے پاک، کمپریشن کی کارکردگی MP3 سے بہتر، اوپن سورس پروجیکٹس وسیع پیمانے پر استعمال کرتے ہیں)"

msgid "mime_ogg"
msgstr "OGG آڈیو (2000 میں Xiph.Org فاؤنڈیشن نے تیار کیا، Ogg Vorbis فارمیٹ۔ اوپن سورس اور پیٹنٹ سے پاک، کمپریشن کی کارکردگی MP3 سے بہتر، Spotify نے ابتدائی طور پر اپنایا، گیمز میں بڑے پیمانے پر استعمال ہوتا ہے)"

msgid "mime_opus"
msgstr "Opus آڈیو (2012 میں IETF نے معیاری بنایا، اوپن سورس اور پیٹنٹ سے پاک آڈیو فارمیٹ۔ SILK اور CELT ٹیکنالوجیز کو یکجا کرتا ہے، انتہائی کم تاخیر، سب سے زیادہ کمپریشن کارکردگی، WebRTC، WhatsApp، Discord کا ڈیفالٹ آڈیو فارمیٹ)"

msgid "mime_wav"
msgstr "WAV آڈیو (1991 میں Microsoft اور IBM نے تیار کیا، Windows کا مقامی آڈیو فارمیٹ۔ بغیر کمپریشن کے PCM کوڈیک، آواز کا معیار غیر نقصان دہ لیکن فائل بہت بڑی، پیشہ ورانہ آڈیو ایڈیٹنگ کا معیاری فارمیٹ)"

msgid "mime_wma"
msgstr "WMA آڈیو (1999 میں Microsoft نے تیار کیا، Windows Media Audio۔ نقصان دہ/غیر نقصان دہ دو ورژن، Windows مقامی طور پر سپورٹ کرتا ہے، Windows Media Player کے ساتھ مقبول ہوا۔ اب کنارے پر ہے، MP3/AAC نے اس کی جگہ لے لی)"

msgid "mime_dsf"
msgstr "DSF آڈیو (Direct Stream Digital فارمیٹ، Sony اور Philips نے تیار کیا۔ 1bit ہائی نمونہ ریٹ، DSD آڈیو کا معیاری فارمیٹ، SACD کا ڈیجیٹل ورژن، آڈیو فائلز کا اعلیٰ درجے کا فارمیٹ، فائل بہت بڑی)"

msgid "mime_ape"
msgstr "APE آڈیو (2000 میں Monkey's Audio نے تیار کیا، بے نقصان کمپریشن فارمیٹ۔ FLAC سے زیادہ کمپریشن لیکن سست انکوڈنگ، اب بھی ونڈوز پلیٹ فارم اور آڈیو کے شوقین افراد میں استعمال ہوتا ہے)"

msgid "mime_mid"
msgstr "MIDI آڈیو (1983 میں MIDI ایسوسی ایشن نے وضع کیا، Musical Instrument Digital Interface۔ ریکارڈنگ کے بجائے موسیقی کے اسکور کا فارمیٹ، فائل انتہائی چھوٹی، الیکٹرانک آلات، موبائل فون کی گھنٹیاں، گیم آڈیو کا معیار۔ 1991 میں General MIDI معیاری بنا، جس میں 128 آلات کی آوازوں کی تعریف کی گئی)"

msgid "mime_m4a"
msgstr "M4A آڈیو (MPEG-4 Audio، AAC کا کنٹینر فارمیٹ۔ iTunes میوزک اسٹور کا معیاری فارمیٹ، Apple ماحولیاتی نظام کا مرکزی آڈیو فارمیٹ، DRM تحفظ کو سپورٹ کرتا ہے)"

msgid "mime_m3u"
msgstr "M3U پلے لسٹ (MP3 URL پلے لسٹ فارمیٹ، سادہ ٹیکسٹ فائل، آڈیو فائل کے راستے ریکارڈ کرتی ہے۔ Winamp دور کا معیار، انٹرنیٹ براڈکاسٹ، آن لائن میوزک اسٹریمنگ کے لیے استعمال ہوتی ہے۔ M3U8 اس کا UTF-8 ورژن ہے، HTTP Live Streaming کے لیے استعمال ہوتا ہے)"

msgid "mime_asf"
msgstr "ASF اسٹریمنگ میڈیا (1996 میں Microsoft نے تیار کیا، Advanced Systems Format۔ Windows Media اسٹریمنگ کنٹینر، آڈیو اور ویڈیو کی ہم وقت ساز ترسیل کو سپورٹ کرتا ہے۔ آن لائن لائیو براڈکاسٹ اور اسٹریمنگ آن ڈیمانڈ کے لیے استعمال ہوتا ہے، WMA/WMV دونوں ASF کنٹینر پر مبنی ہیں)"

msgid "mime_avi"
msgstr "AVI ویڈیو (1992 میں Microsoft نے متعارف کرایا، Windows کا ابتدائی ویڈیو معیار۔ 'Audio Video Interleave'، آڈیو اور ویڈیو کو باری باری اسٹور کرتا ہے، 1990-2000 کی دہائی کا سب سے مقبول ویڈیو فارمیٹ، اب MP4/MKV نے اس کی جگہ لے لی)"

msgid "mime_divx"
msgstr "DivX ویڈیو (1998 میں DivX کمپنی نے تیار کیا، MPEG-4 پر مبنی ویڈیو کوڈیک فارمیٹ۔ 2000 کی دہائی میں آن لائن ویڈیو شیئرنگ کا مرکزی فارمیٹ، پہلی ٹیکنالوجی جس نے DVD کوالٹی کو CD سائز میں کمپریس کیا۔ کاپی رائٹ کے تنازعات کی وجہ سے، بعد میں تجارتی کوڈیک میں تبدیل ہو گیا)"

msgid "mime_mp4"
msgstr "MP4 ویڈیو (2001 MPEG معیار، MPEG-4 Part 14۔ دنیا کا سب سے عام ویڈیو فارمیٹ، H.264/H.265 کوڈیک کو سپورٹ کرتا ہے، انٹرنیٹ ویڈیو، موبائل فون کی ریکارڈنگ، YouTube کا ڈیفالٹ فارمیٹ)"

msgid "mime_m4v"
msgstr "M4V ویڈیو (iTunes ویڈیو فارمیٹ، MP4 کی تبدیلی۔ Apple ماحولیاتی نظام کا ویڈیو فارمیٹ، iTunes Store کی فلموں، ٹی وی شوز کا معیاری فارمیٹ، DRM کاپی رائٹ تحفظ کو سپورٹ کرتا ہے)"

msgid "mime_mpeg"
msgstr "MPEG ویڈیو (1988 میں MPEG تنظیم نے وضع کیا، Moving Picture Experts Group۔ ڈیجیٹل ویڈیو کمپریشن معیار کی بنیاد رکھنے والا، MPEG-1 (VCD)، MPEG-2 (DVD)، MPEG-4 (انٹرنیٹ ویڈیو) نے گہرا اثر ڈالا)"

msgid "mime_mkv"
msgstr "MKV ویڈیو (2002 میں Matroska پروجیکٹ نے تیار کیا، اوپن سورس ملٹی میڈیا کنٹینر فارمیٹ۔ متعدد آڈیو ٹریکس، متعدد سب ٹائٹلز، ابواب کو سپورٹ کرتا ہے، 'پیکجنگ کا جادوگر'، ہائی ڈیفینیشن فلم شیئرنگ کا پہلا انتخاب"

msgid "mime_mpg"
msgstr "MPEG ویڈیو (MPEG-1/MPEG-2 ویڈیو کی توسیع، VCD اور DVD کا معیاری فارمیٹ۔ 1990-2000 کی دہائی میں آپٹیکل ڈسک ویڈیو کا مرکزی فارمیٹ، اب H.264/H.265 نے اس کی جگہ لے لی)"

msgid "mime_ogv"
msgstr "Ogg Video ویڈیو (Xiph.Org فاؤنڈیشن نے تیار کیا، Ogg کنٹینر کا ویڈیو فارمیٹ، Theora کوڈیک استعمال کرتا ہے۔ اوپن سورس اور پیٹنٹ سے پاک، HTML5 ویڈیو کے ابتدائی معیارات میں سے ایک، Firefox مقامی طور پر سپورٹ کرتا ہے)"

msgid "mime_ogx"
msgstr "Ogg ملٹی میڈیا کنٹینر (Xiph.Org فاؤنڈیشن نے تیار کیا، Ogg کنٹینر کی عمومی توسیع، جس میں آڈیو، ویڈیو، سب ٹائٹلز جیسے متعدد ٹریک شامل ہو سکتے ہیں۔ اوپن سورس ملٹی میڈیا معیار، گیمز، اسٹریمنگ میڈیا کے لیے استعمال ہوتا ہے)"

msgid "mime_rm"
msgstr "RealMedia ویڈیو (1995 میں RealNetworks نے تیار کیا، RealMedia فارمیٹ۔ 1990-2000 کی دہائی میں انٹرنیٹ اسٹریمنگ میڈیا کا علمبردار، RealPlayer پلیئر کا بنیادی فارمیٹ۔ مسائل: خصوصی پلیئر کی ضرورت، کمپریشن کا خراب معیار، بعد میں Flash/MP4 نے اس کی جگہ لے لی)"

msgid "mime_flv"
msgstr "Flash ویڈیو (2002 میں فارمیٹ سامنے آیا، Flash Video فارمیٹ۔ کبھی انٹرنیٹ ویڈیو کا مرکزی فارمیٹ تھا، YouTube نے ابتدائی طور پر اپنایا۔ مسائل: Flash پلگ ان کی ضرورت، کم کارکردگی، بہت زیادہ سیکیورٹی خطرات۔ 2015 سے مرکزی ویب سائٹس نے HTML5 ویڈیو کی طرف رخ کیا، اب ختم ہو چکا ہے)"

msgid "mime_f4v"
msgstr "F4V ویڈیو (Adobe نے تیار کیا Flash ویڈیو فارمیٹ، FLV کا جانشین۔ MPEG-4 معیار پر مبنی، H.264 کوڈیک کو سپورٹ کرتا ہے۔ Flash ٹیکنالوجی کے ساتھ ختم ہو گیا، Adobe نے 2020 میں سپورٹ بند کر دی)"

msgid "mime_wmv"
msgstr "WMV ویڈیو (1999 میں Microsoft نے تیار کیا، Windows Media Video۔ Windows مقامی طور پر سپورٹ کرتا ہے، اسٹریمنگ ٹرانسمیشن کے لیے بہتر بنایا گیا، ابتدائی آن لائن ویڈیو کا عام فارمیٹ، اب کنارے پر ہے)"

msgid "mime_wmf"
msgstr "WMF میڈیا فارمیٹ (Windows Media Format، مائیکروسافٹ کا میڈیا فریم ورک۔ WMV ویڈیو، WMA آڈیو کا مجموعہ، Windows Media Player مقامی طور پر سپورٹ کرتا ہے)"

msgid "mime_mov"
msgstr "MOV ویڈیو (1991 میں Apple نے تیار کیا، QuickTime کنٹینر فارمیٹ۔ پیشہ ورانہ ویڈیو ایڈیٹنگ کا معیاری فارمیٹ، متعدد کوڈیکس کو سپورٹ کرتا ہے، Final Cut Pro، Premiere مقامی طور پر سپورٹ کرتے ہیں)"

msgid "mime_qt"
msgstr "QuickTime ویڈیو (1991 میں Apple نے متعارف کرایا، QuickTime فارمیٹ۔ Mac پلیٹ فارم کا ویڈیو معیار، MOV اس کا کنٹینر ہے، QuickTime پلیئر بڑے پیمانے پر استعمال ہوتا تھا۔ 2016 میں Apple نے Windows ورژن کی ترقی بند کر دی، آہستہ آہستہ MP4 نے اس کی جگہ لے لی)"

msgid "mime_webm"
msgstr "WebM ویڈیو (2010 میں Google نے متعارف کرایا، اوپن سورس اور پیٹنٹ سے پاک ویڈیو فارمیٹ۔ Matroska کنٹینر پر مبنی، VP8/VP9 کوڈیک، HTML5 ویڈیو کا معیاری فارمیٹ، YouTube کا ڈیفالٹ ویب پلے بیک فارمیٹ)"

msgid "mime_3gp"
msgstr "3GP ویڈیو (2000 میں 3GPP نے وضع کیا، موبائل ڈیوائس کا ویڈیو فارمیٹ۔ فائل کا سائز بہت چھوٹا، معیار کم، ابتدائی فیچر فونز کی ویڈیو ریکارڈنگ کا فارمیٹ، MMS کے ذریعے بھیجنے کے لیے استعمال ہوتا تھا)"

