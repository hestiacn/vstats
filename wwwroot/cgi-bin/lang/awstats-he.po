#------------------------------------------------------------------------------
# תיאורי פורמטים
#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "קובץ טקסט (סטנדרטיזציית ASCII בשנת 1963, טקסט פשוט ללא עיצוב. הבסיס לכל קוד המקור, התצורות, קובצי היומן. Unix משתמש ב-LF, Windows משתמש ב-CRLF לשורת חדשה, עדיין הפורמט הנפוץ ביותר למחשבים)"

msgid "mime_log"
msgstr "קובץ יומן (קובץ טקסט פשוט המתעד מידע על פעולת מערכת ואפליקציה, משמש לפתרון בעיות, ניתוח ביצועים, ביקורת אבטחה. פורמטים סטנדרטיים כמו Apache combined log, Nginx access log, syslog וכו')"

msgid "mime_page"
msgstr "דף HTML (טים ברנרס-לי המציא את World Wide Web ב-1989, הגדיר את שלוש הטכנולוגיות HTML/HTTP/URL ב-1990, הציע אותן בחינם ללא פטנט. HTML5 הפך לתקן הרשמי של W3C ב-2014, תומך בתצוגה, מולטימדיה והדפסה. זכה בפרס טיורינג ב-2016)"

msgid "mime_khtml"
msgstr "מנוע אינטרנט KHTML (שוחרר עם KDE 2.0 ב-1998, מנוע העיבוד של דפדפן Konqueror. Apple יצרה את WebKit על בסיס KHTML ב-2001, Google יצרה את Blink מ-WebKit ב-2008, שהפך לליבה של דפדפנים כמו Chrome, Edge, Safari. KHTML היא דוגמה לאופן שבו קהילת הקוד הפתוח הניחה את היסודות למנועי דפדפן מודרניים, שהמורשת הטכנולוגית שלו ממשיכה דרך WebKit/Blink)"

msgid "mime_script"
msgstr "סקריפט דינמי (שפה מפורשת, אינה דורשת הידור. כוללת ASP, JSP, CGI, ColdFusion, Tcl, VBScript וכו', בשימוש נרחב בפיתוח אינטרנט מוקדם, ניהול מערכת, אוטומציה של משימות. שפות סקריפט מודרניות כמו Python, Ruby, JavaScript התפתחו לשפות העיקריות לפיתוח full-stack)"

msgid "mime_js"
msgstr "סקריפט JavaScript (ברנדן אייך יצר אותו תוך 10 ימים ב-Netscape ב-1995, שפת התכנות המקורית של הדפדפן. ECMAScript עברה סטנדרטיזציה ב-1997, הולדת Node.js ב-2009 הפכה אותה לשפת full-stack, npm הוא מנהל החבילות הגדול בעולם. במשך שנים השפה הפופולרית ביותר ב-GitHub)"

msgid "mime_py"
msgstr "סקריפט Python (נוצר על ידי Guido van Rossum ב-1991, ידוע בהזחה הכפויה ובתחביר הפשוט. בשימוש נרחב בפיתוח אינטרנט, מדעי נתונים, בינה מלאכותית, אוטומציה של תפעול. זוכה מרובה של פרס TIOBE לשפת התכנות של השנה)"

msgid "mime_sh"
msgstr "סקריפט Shell (לידת Unix ב-1971, שפת סקריפט פקודות. משמש לניהול מערכת, אוטומציה של משימות, הפעלת שירותים, סקריפטים לפריסה. מיומנות חיונית לניהול Linux)"

msgid "mime_rb"
msgstr "סקריפט Ruby (נוצר על ידי Yukihiro Matsumoto ב-1995, מתמקד באושרם של מפתחים. מסגרת Ruby on Rails הציגה את הפרדיגמה 'מוסכמה על פני תצורה', המשפיעה על עיצוב מסגרות אינטרנט מודרניות)"

msgid "mime_pl"
msgstr "סקריפט Perl (נוצר על ידי Larry Wall ב-1987, ידוע בפרגמטיות שלו, מכונה 'הסכין השוויצרית'. CPAN היה חלוץ מנהלי החבילות המודרניים, עם השפעה עמוקה על עיבוד טקסט, ניהול מערכת ו-CGI)"

msgid "mime_php"
msgstr "דף אינטרנט דינמי PHP (נוצר על ידי Rasmus Lerdorf ב-1995, תוכנן במיוחד לפיתוח אינטרנט. מעל 70% מאתרי האינטרנט בעולם משתמשים בו, מניע פלטפורמות כמו WordPress, Facebook, Wikipedia. PHP 8 מציג קימפול JIT, משפר משמעותית את הביצועים)"

msgid "mime_image"
msgstr "קובץ תמונה"

msgid "mime_document"
msgstr "קובץ מסמך"

msgid "mime_package"
msgstr "חבילת תוכנה"

msgid "mime_archive"
msgstr "קובץ דחוס Gzip (פרויקט GNU משנת 1992, מבוסס על אלגוריתם DEFLATE. באינטרנט משמש לדחיסה דינמית של תוכן תגובה, שיעור הדחיסה הוא בדרך כלל 60-90%. לאחר 2015 הוחלף בחלק מהתרחישים על ידי Brotli, אך עדיין הפורמט הנפוץ ביותר לדחיסה בצד השרת)"

msgid "mime_audio"
msgstr "קובץ שמע"

msgid "mime_video"
msgstr "קובץ וידאו"

msgid "mime_jscript"
msgstr "JavaScript (פותח על ידי ברנדן אייך ב-1995)"

msgid "mime_json"
msgstr "נתוני JSON (הוצע על ידי Douglas Crockford ב-2001, פורמט קל להחלפת נתונים, דה פקטו סטנדרט עבור API אינטרנט)"

msgid "mime_vbs"
msgstr "VBScript (פותח על ידי Microsoft ב-1996, שפת סקריפט של Windows, משמש לדפי ASP וסקריפטים לניהול Windows. עם התפשטות PowerShell ו-JavaScript, הולך ונעלם)"

msgid "mime_conf"
msgstr "קובץ תצורה (מאחסן תצורת תוכנה בפורמט טקסט, פורמטים נפוצים: INI, JSON, YAML, TOML, XML. תצורת מערכת Linux נמצאת בעיקר בספריית /etc)"

msgid "mime_css"
msgstr "גיליון סגנון CSS (W3C פרסם את התקן הרשמי הראשון CSS1 בדצמבר 1996, CSS2 הוסיף מיקום וסוגי מדיה ב-1998, מ-2011 המודולריזציה של CSS3 הציגה פינות מעוגלות, אנימציות, תיבה גמישה, פריסת רשת ועיצוב רספונסיבי. יחד עם HTML ו-JavaScript אחת משלוש הטכנולוגיות העיקריות של front-end, כל הדפדפנים המודרניים (Chrome, Firefox, Safari, Edge) תומכים בה באופן מקורי, זהו התקן היחיד להגדרת סגנון דפי אינטרנט)"

msgid "mime_xsl"
msgstr "גיליון סגנון XSL (תקן W3C משנת 1999, שפת המרת מסמכי XML, יכולה להמיר XML ל-HTML/PDF/טקסט. השימוש פחת לאחר התפשטות JSON)"

msgid "mime_runtime"
msgstr "קובץ הפעלה (פורמט הפעלה של מערכת ההפעלה כמו EXE, ELF, Mach-O, מכיל קוד מכונה ומידע טעינה)"

msgid "mime_library"
msgstr "קובץ ספרייה (DLL, SO, dylib וכו', ספריות מקושרות דינמית, קוד משותף שהתוכנה טוענת במהלך הריצה)"

msgid "mime_swf"
msgstr "אנימציית Flash (Macromedia פיתחה אותה ב-1996, מאוחר יותר בבעלות Adobe. סטנדרט אינטראקטיבי לאנימציה, שלט באנימציות ומשחקים באינטרנט. חסרונות: דורש תוסף, אינו נתמך במכשירים ניידים, סיכון אבטחה גבוה. Adobe הכריזה על הפסקתו ב-2017, הפסיקה לחלוטין את התמיכה ב-2020, הוחלף ב-HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "הגדרת סוג מסמך DTD (מפרט XML, מגדיר את מבנה מסמך XML, משמש לאימות תקינות XML)"

msgid "mime_csv"
msgstr "פורמט נתונים CSV (ערכים מופרדים בפסיקים, פורמט נפוץ לנתונים טבלאיים, סטנדרט לייבוא/ייצוא של Excel ומסדי נתונים)"

msgid "mime_jnlp"
msgstr "Java Web Start (מפעיל יישומי Java, טכנולוגיית הפצה של יישומי Java שולחניים משנות ה-2000, כעת מיושן)"

msgid "mime_lit"
msgstr "ספר אלקטרוני של Microsoft Reader (Microsoft השיקה אותו בשנת 2000, פורמט LIT, מיושן)"

msgid "mime_svg"
msgstr "גרפיקה וקטורית SVG (תקן W3C משנת 1999, מכיוון ש-Microsoft קידמה זמן רב פורמט VML משלה, דפדפן IE תמך בו רק ב-2011, מה שעיכב את האימוץ. לאחר 2015, עם היעלמות IE והתפשטות מסכי ה-HD, הוא הפך לפורמט המועדף על סמלים ולוגואים)"

msgid "mime_ai"
msgstr "גרפיקה וקטורית של Adobe Illustrator (הושק ב-1987, פורמט גרפי וקטורי סטנדרטי בתעשייה, מועדף לעיצוב דפוס, לוגואים, סמלים)"

msgid "mime_phshop"
msgstr "תמונת Photoshop (Adobe השיקה אותה ב-1990, פורמט קובץ המקור של Photoshop PSD, סטנדרט תעשייתי לעיבוד תמונה)"

msgid "mime_ttf"
msgstr "גופן TrueType (Apple ו-Microsoft פיתחו יחד ב-1989, פורמט גופן וקטורי, התצוגה על המסך וההדפסה זהים, פורמט גופן ברירת מחדל של מערכות הפעלה מודרניות)"

msgid "mime_fon"
msgstr "גופן רשת WOFF2 (המלצת W3C משנת 2014, משתמש באלגוריתם דחיסת Brotli, בהשוואה ל-WOFF הישן הנפח קטן בכ-30%, בהשוואה ל-TTF/OTF קטן ביותר מ-50%, נתמך כעת על ידי כל הדפדפנים המודרניים, הוא הפורמט המועדף לגופני רשת מודרניים, נתמך על ידי יותר מ-98% מהדפדפנים)"

msgid "mime_pdf"
msgstr "מסמך PDF (Adobe פיתחה אותו ב-1993, הפך לתקן ISO ב-2008. פורמט מסמך חוצה פלטפורמות, שומר על עקביות העיצוב, הוא התקן העולמי להפצת מסמכים אלקטרוניים)"

msgid "mime_dotnet"
msgstr "דף דינמי ASP.NET (Microsoft השיקה אותו ב-2002, טכנולוגיית דפים דינמיים בפלטפורמת Windows, חלק מ-.NET Framework)"

msgid "mime_mdb"
msgstr "מסד נתונים של Access (קובץ מסד נתונים של Microsoft Access, הושק ב-1992, פתרון מסד נתונים שולחני ל-Windows)"

msgid "mime_md"
msgstr "מסמך Markdown (נוצר על ידי John Gruber ב-2004, עיצוב התחביר הושפע מ-reStructuredText ו-Setext. פילוסופיית העיצוב הבסיסית היא 'קריאות פירושה יכולת עיבוד', היישום המקורי Markdown.pl משתמש בביטויים רגולריים של Perl. מפרטים נגזרים כוללים GFM (2013), CommonMark (2017), Pandoc Markdown וכו'. מניע מערכות אקולוגיות כמו GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, והופך לפורמט הסטנדרטי דה פקטו עבור מחוללי אתרים סטטיים ותיעוד מפתחים)"

msgid "mime_crystal"
msgstr "פורמט דוח Crystal Reports (מידע עסקי של SAP, פורמט סטנדרטי לדוחות ארגוניים)"

msgid "mime_libreoffice"
msgstr "מסמך LibreOffice (The Document Foundation פיתחה אותו ב-2010, ענף של OpenOffice, יישום תקן ODF, חבילת המשרד הפתוחה העיקרית)"

msgid "mime_encrypt"
msgstr "קובץ מוצפן (יש לפענח כדי לראות, סיומות נפוצות: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "נתוני מסלול GPS (פורמט החלפת GPS, מתעד מידע גיאוגרפי, פורמט נפוץ לשעוני ספורט ולהתקני ניווט)"

msgid "mime_diskimage"
msgstr "תמונת דיסק (קבצי תמונת דיסק/CD-ROM כמו DMG, ISO, IMG, משמשים להפצת תוכנה או לגיבוי אמצעי אחסון)"

msgid "mime_vm"
msgstr "תמונת מכונה וירטואלית (קבצי דיסק וירטואלי כמו VMDK, VDI, VHDX, OVA, פורמטים לפלטפורמות וירטואליזציה כמו VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "קובץ Torrent של BitTorrent (בראם כהן המציא אותו ב-2001, קובץ אינדקס להורדות P2P, מכיל מטא נתונים של הקובץ ומידע על Tracker)"

msgid "mime_gis"
msgstr "נתוני מערכת מידע גיאוגרפי GIS (נתונים גיאו-מרחביים כמו Shapefile, GeoJSON, משמשים למפות ולניתוח מרחבי)"

msgid "mime_ebook"
msgstr "ספר אלקטרוני (פורמטי ספר אלקטרוני כמו EPUB, MOBI, AZW. EPUB הוא התקן הבינלאומי, MOBI/AZW הם פורמטים עבור Amazon Kindle)"

msgid "mime_avif"
msgstr "תמונת AVIF (הושקה על ידי Alliance for Open Media ב-2019, מבוססת על קידוד AV1, יחס דחיסה טוב ב-50% מ-WebP, תקן תמונה חדש לדור הבא)"

msgid "mime_markdown"
msgstr "מסמך Markdown (עוצב על ידי John Gruber ב-2004, שפת סימון קלת משקל, פורמט נפוץ עבור README של GitHub, תיעוד טכני, הודעות פורום)"

msgid "mime_yaml"
msgstr "תצורת YAML (עוצבה על ידי Clark Evans ב-2001, פורמט סידור נתונים קריא לאדם, סטנדרט עבור קבצי תצורה של Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "תצורת TOML (עוצבה על ידי Tom Preston-Werner ב-2013, 'Tom's Obvious Minimal Language', פורמט קובץ תצורה לכלים מודרניים כמו Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "קובץ רכיב Vue (הוצג בשנת 2014 על ידי אוון יו, מסגרת JavaScript פרוגרסיבית. באמצעות רכיבי קובץ בודד (SFC) הוא משלב בצורה מושלמת HTML, CSS ו-JS, ומגביר מאוד את יעילות הפיתוח. זוהי אחת המסגרות הפופולריות ביותר בעולם לפיתוח צד לקוח. כמו כן, כליבה של מחוללי אתרים סטטיים מודרניים כמו VitePress, היא נמצאת בשימוש נרחב להנעת תיעוד טכני אינטראקטיבי ובלוגים.)"

msgid "mime_wasm"
msgstr "מודול WebAssembly (תקן W3C משנת 2017, פורמט ביצוע בעל ביצועים גבוהים בדפדפן, C/C++/Rust/R יכולים להדר למטרה זו, ביצועים קרובים למקור)"

msgid "mime_jsx"
msgstr "רכיב React JSX (Facebook השיקה את JavaScript XML ב-2013, תחביר רכיב של מסגרת React, פרדיגמה חדשנית המביאה HTML לתוך JavaScript)"

msgid "mime_tsx"
msgstr "רכיב TypeScript TSX (פותח על ידי Microsoft ב-2012, TypeScript + JSX, הדרך הסטנדרטית לכתוב לפיתוח React עם בטיחות טיפוסים)"

msgid "mime_heif"
msgstr "תמונת HEIF (תקן MPEG משנת 2015, פורמט קובץ תמונה יעיל, בשימוש נרחב במערכת האקולוגית של Apple)"

msgid "mime_heic"
msgstr "תמונת HEIC (יישום Apple של HEIF, פורמט צילום ברירת מחדל ב-iPhone, נתמך באופן מקורי ב-iOS/macOS)"

msgid "mime_gltf"
msgstr "מוצג תלת מימד GLTF (פורמט העברה GL, 'ה-JPEG של עולם התלת מימד', Khronos Group פרסמה אותו ב-2015, פורמט סטנדרטי לאינטרנט תלת מימד)"

msgid "mime_glb"
msgstr "מודל תלת מימד בינארי GLB (גרסה בינארית של GLTF, קובץ יחיד מכיל את כל המשאבים, משמש להפצת סצנות תלת מימד)"

msgid "mime_gls"
msgstr "מילון GLOSSARY (קובץ הגדרות מונחים, לניהול מונחים במערכות תיעוד)"

msgid "mime_cbz"
msgstr "ספר קומיקס CBZ (תמונות קומיקס דחוסות עם ZIP, פורמט נפוץ לאיסוף קומיקס)"

msgid "mime_cbr"
msgstr "ספר קומיקס CBR (תמונות קומיקס דחוסות עם RAR, פורמט נפוץ לאיסוף קומיקס)"

msgid "mime_fb2"
msgstr "ספר אלקטרוני FB2 (FictionBook 2.0, פורמט ספר אלקטרוני רוסי, מבנה XML, נתמך באופן נרחב על ידי קוראי קוד פתוח)"

msgid "mime_kepub"
msgstr "ספר אלקטרוני KEPUB (פורמט EPUB מיוחד עבור Kobo, פורמט מותאם לקורא הספרים האלקטרוניים Kobo)"

msgid "mime_m4b"
msgstr "ספר מוקלט M4B (פורמט אודיו MPEG-4 לספרים, תומך בסימניות, פורמט ספרים מוקלטים של iTunes)"

msgid "mime_kfx"
msgstr "פורמט Kindle KFX (Amazon השיקה אותו ב-2015, פורמט ספר אלקטרוני מיוחד עבור Kindle, תומך בעיצוב מתקדם ודפדוף מהיר בדפים)"

msgid "mime_chm"
msgstr "קובץ עזרה CHM (Microsoft השיקה אותו ב-1997, פורמט עזרה HTML מהודר, סטנדרט לתיעוד עזרה של תוכנות Windows)"

msgid "mime_mht"
msgstr "ארכיון אינטרנט MHT (Microsoft השיקה אותו ב-1999, פורמט דף אינטרנט בקובץ יחיד, פורמט שמירת דפי אינטרנט של דפדפן IE)"

msgid "mime_wml"
msgstr "שפת סימון אלחוטית WML (תקן WAP משנת 1999, שימש לדפי אינטרנט בטלפונים מוקדמים, מיושן)"

msgid "mime_xhtml"
msgstr "דף אינטרנט XHTML (תקן W3C משנת 2000, גרסת XML של HTML, תחביר מחמיר יותר. W3C הפסיקה את התחזוקה ב-2009, העבירה את המיקוד ל-HTML5)"

msgid "mime_xml"
msgstr "מסמך XML (תקן W3C משנת 1998, שפת סימון הניתנת להרחבה, פורמט בסיסי לשירותי אינטרנט, קבצי תצורה, החלפת נתונים)"

msgid "mime_sgml"
msgstr "מסמך SGML (תקן ISO משנת 1986, קודמו של HTML, שפת סימון כללית סטנדרטית, גם XML וגם HTML נגזרים מ-SGML)"

msgid "mime_apng"
msgstr "אנימציית APNG (Mozilla פיתחה ב-2004, הרחבת אנימציה של PNG, תחליף מודרני ל-GIF, תומך בצבעים אמיתיים ושקיפות)"

msgid "mime_bmp"
msgstr "BMP מפת סיביות (פורמט מפת סיביות של Windows, נתמך באופן מקורי מאז Windows 1.0. לא דחוס, גודל קובץ גדול, אך בשל המבנה הפשוט שלו וחוסר הצורך בקודקים נוספים, הוא עדיין נמצא בשימוש בכלי החיתוך של Windows 11, בתוכנת הציור, במשאבי אייקונים בחבילות התקנה EXE/MSI, בקבצי סמן, ובכמה מנהלי התקנים ישנים יותר. באותה איכות תמונה, גודל הקובץ גדול בערך פי 3-10 מ-PNG. ברוב המקרים הוא הוחלף ב-PNG/JPEG, אך מערכת האקולוגית של Windows עדיין שומרת על תאימות רחבה)"

msgid "mime_cdr"
msgstr "גרפיקה וקטורית CDR (פורמט ייחודי של CorelDRAW, חברה קנדית Corel, תוכנת עיצוב גרפי וקטורי)"

msgid "mime_gif"
msgstr "תמונת GIF (CompuServe פיתחה ב-1987, פורמט תמונה מונפש עם 256 צבעים. חסרונות: מעט צבעים, איכות תמונה גסה, לא תומך בשקיפות, קובץ גדול, קצב פריימים נמוך. הוחלף בפורמטים מודרניים כמו APNG, WebP)"

msgid "mime_ico"
msgstr "סמל ICO (פורמט סמל של Windows, תומך ברזולוציות מרובות, פורמט סטנדרטי עבור ה-favicon של אתרי אינטרנט)"

msgid "mime_jpeg"
msgstr "תמונת JPEG (תקן ISO משנת 1992, פורמט דחיסה מאבדת עבור תצלומים, דה פקטו סטנדרט עבור תצלומים באינטרנט)"

msgid "mime_jpg"
msgstr "תמונת JPEG (תקן ISO משנת 1992, פורמט דחיסה מאבדת עבור תצלומים, דה פקטו סטנדרט עבור תצלומים באינטרנט)"

msgid "mime_png"
msgstr "תמונת PNG (המלצת W3C משנת 1996, תומכת בצבעים אמיתיים ושקיפות, תחליף סטטי ל-GIF, סטנדרט לתמונות ללא אובדן באינטרנט)"

msgid "mime_ps"
msgstr "קובץ תיאור עמוד PostScript (Adobe השיקה אותו ב-1985, שפת תיאור עמוד, קודמו של PDF, משמש להדפסה ולהוצאה לאור)"

msgid "mime_psb"
msgstr "מסמך גדול PSB (פורמט Adobe Photoshop עבור תמונות גדולות במיוחד, תומך בתמונות ענק של מעל 2 GB או 30000 פיקסלים)"

msgid "mime_psd"
msgstr "תמונת PSD (קובץ המקור של Adobe Photoshop, תומך בשכבות, ערוצים, נתיבים, פורמט סטנדרטי בתעשייה לעיבוד תמונה)"

msgid "mime_webp"
msgstr "תמונת WebP (Google פיתחה ב-2010, פורמט תמונה לאינטרנט, תומך בדחיסה מאבדת/ללא אובדן ובאנימציה, יחס דחיסה טוב ב-25-35% מ-PNG וב-25% מ-JPEG)"

msgid "mime_woff"
msgstr "גופן רשת WOFF (נוצר ב-2009, תקן W3C משנת 2018. דחוס על בסיס TrueType/OpenType, אופטימלי לטעינת גופני רשת, פורמט סטנדרטי לגופני סמלים של אתרים מודרניים)"

msgid "mime_7z"
msgstr "ארכיון דחוס 7z (איגור פאבלוב פיתח אותו ב-1999, פורמט ייחודי של תוכנת 7-Zip. אלגוריתם LZMA, יחס דחיסה גבוה, קוד פתוח וחינמי. פורמט 7z הוא בדרך כלל 30-50% קטן יותר מ-ZIP באותו יחס דחיסה, פורמט נפוץ בקהילת הקוד הפתוח ולהפצת תוכנות)"

msgid "mime_ace"
msgstr "ארכיון דחוס ACE (פותח בשנות ה-90, פורמט של תוכנת WinACE. התחרה פעם ב-RAR, יחס הדחיסה היה גבוה למדי. הפיתוח הופסק ב-2007, כיום הוחלף ב-7z/RAR, נדיר בשימוש)"

msgid "mime_bz2"
msgstr "ארכיון דחוס BZIP2 (ג'וליאן סיוארד פיתח אותו ב-1996, אלגוריתם דחיסה על ידי מיון בלוקים. יחס דחיסה גבוה ב-15-20% מ-GZIP אך איטי יותר. פורמט נפוץ לקוד המקור של ליבת Linux, חבילות תוכנה בקוד פתוח, סיומת .bz2)"

msgid "mime_cab"
msgstr "ארכיון דחוס CAB (Microsoft פיתחה אותו ב-1995, פורמט Cabinet. פורמט חבילת התקנה עבור Windows, משמש לדרייברים, הפצת קבצי מערכת. Windows Installer (MSI) משתמש פנימית ב-CAB לאחסון קבצים)"

msgid "mime_dmg"
msgstr "תמונת דיסק DMG (Apple הציגה אותו בשנות ה-80, פורמט Disk Image. פורמט סטנדרטי להפצת תוכנות macOS, לחיצה כפולה להרכבה כדיסק וירטואלי, גרור ושחרר להתקנת היישום. תומך בדחיסה והצפנה, הפורמט העיקרי להורדת תוכנות Mac)"

msgid "mime_emz"
msgstr "תמונה דחוסה EMZ (מטא-קובץ משופר דחוס של Windows, גרסה דחוסה של EMF. פורמט אחסון של גרפיקה וקטורית במסמכי Office, הוא למעשה קובץ EMF דחוס ב-GZIP)"

msgid "mime_gz"
msgstr "ארכיון דחוס GZIP (ז'אן-לו גאי ומארק אדלר פיתחו אותו ב-1992, פרויקט GNU. כלי דחיסה סטנדרטי ב-Unix/Linux, פורמט נפוץ לדחיסת העברת HTTP. סיומת .gz, משמש לעתים קרובות יחד עם TAR)"

msgid "mime_jar"
msgstr "ארכיון דחוס JAR (Sun Microsystems השיקה אותו ב-1997, פורמט Java ARchive. הוא למעשה קובץ ZIP, משמש לאריזת ספריות ויישומי Java. פורמט בסיסי של המערכת האקולוגית של Java כמו Maven, Gradle. Android משתמש גם ב-JAR)"

msgid "mime_lzma"
msgstr "ארכיון דחוס LZMA (איגור פאבלוב פיתח אותו ב-1998, אלגוריתם Lempel-Ziv-Markov chain. אלגוריתם הדחיסה הראשי של פורמט 7z, יחס דחיסה גבוה, מהירות שחרור דחיסה מהירה. משמש להפצת קושחת ותוכנות למערכות משובצות)"

msgid "mime_rar"
msgstr "ארכיון דחוס RAR (יבגני רושאל פיתח אותו ב-1993, פורמט Roshal ARchive. יחס דחיסה גבוה, תומך בחלוקה לכרכים ובתעודות שחזור. פורמט של תוכנת WinRAR, יחס הדחיסה טוב מ-ZIP אך דורש תוכנה בתשלום, כלי קוד פתוח כמו unrar יכולים לשחרר דחיסה)"

msgid "mime_tar"
msgstr "ארכיון TAR (Unix V7 הציג אותו ב-1979, פורמט Tape ARchive. ארכיון קלטות, רק אורז ללא דחיסה, משמש לעתים קרובות יחד עם GZIP/BZIP2/XZ. קוד המקור של חבילות Linux, אחסון שכבות תמונות Docker משתמש בפורמט TAR)"

msgid "mime_tgz"
msgstr "ארכיון דחוס TGZ (פורמט משולב TAR + GZIP, סיומת .tgz או .tar.gz. הפורמט הנפוץ ביותר להפצת חבילות תוכנה של Unix/Linux, חבילות קוד מקור, חבילות בינאריות, בשימוש נרחב, מייצג 'פתח דחיסה והשתמש')"

msgid "mime_tbz2"
msgstr "ארכיון דחוס TBZ2 (פורמט משולב TAR + BZIP2, סיומת .tbz2 או .tar.bz2. יחס דחיסה גבוה ב-15-20% מ-TGZ, מתאים להפצת קבצים גדולים, ליבת Linux השתמשה בפורמט זה זמן רב)"

msgid "mime_xz"
msgstr "ארכיון דחוס XZ (הוצג ב-2009, מבוסס על אלגוריתם LZMA2. יחס דחיסה גבוה ביותר, 30-50% טוב יותר מ-GZIP, מהירות שחרור דחיסה מהירה יחסית. ליבת Linux, מנהלי חבילות (כמו בתוך .deb של Debian) משתמשים בו רבות, פורמט מומלץ במערכת האקולוגית הנוכחית של Linux)"

msgid "mime_z"
msgstr "ארכיון דחוס Z (פורמט הפקודה Unix compress משנת 1985, אלגוריתם LZW. פורמט דחיסה מוקדם של Unix, הוחלף על ידי GZIP. סיומת .Z, מערכות מודרניות משתמשות בו לעתים רחוקות)"

msgid "mime_zip"
msgstr "ארכיון דחוס ZIP (פיל כץ פיתח אותו ב-1989, פורמט PKZIP. Windows תומך בו באופן מקורי, פורמט הדחיסה הנפוץ ביותר באינטרנט. תומך במספר קבצים, מבנה ספריות, יכול לבחור אלגוריתם דחיסה. ה-JAR של Java, ה-APK של Android, ה-DOCX/XLSX של מסמכי Office מבוססים על פורמט ZIP)"

msgid "mime_zst"
msgstr "ארכיון דחוס Zstandard (Facebook פיתחה ב-2015, עוצב על ידי Yann Collet. אלגוריתם דחיסה במהירות גבוהה, יחס דחיסה קרוב ל-LZMA, מהירות עולה בהרבה על GZIP. ליבת Linux 5.9+ תומכת בו, pacman של Arch Linux, APT של Debian מאמצים אותו בהדרגה, דור חדש של תקן דחיסה)"

msgid "mime_lz4"
msgstr "ארכיון דחוס LZ4 (יאן קולט פיתח אותו ב-2011, אלגוריתם דחיסה מהיר במיוחד. מהירות הדחיסה מהירה יותר מפי 10 מ-GZIP, מתאים לתרחישי דחיסה בזמן אמת. ליבת Linux, OpenZFS, Hadoop משתמשים בו רבות, הבחירה הראשונה לתרחישים שבהם מהירות היא בראש סדר העדיפויות)"

msgid "mime_lzo"
msgstr "ארכיון דחוס LZO (מרקוס אוברהומר פיתח אותו ב-1996, אלגוריתם Lempel-Ziv-Oberhumer. מהירות שחרור הדחיסה מהירה במיוחד, יחס הדחיסה ממוצע. ליבת Linux Squashfs, קושחת OpenWrt משתמשות בו, מתאים למערכות משובצות)"

msgid "mime_msi"
msgstr "חבילת התקנה MSI (Microsoft השיקה אותו ב-1999, פורמט חבילת Windows Installer. פורמט התקנה סטנדרטי עבור יישומי Windows, תומך בביטול עסקאות, ניהול רכיבים, התקנה שקטה. הבחירה הראשונה להפצת תוכנות ברמה הארגונית, עדיין הפורמט העיקרי להתקנת תוכנות Windows כיום)"

msgid "mime_pkg"
msgstr "חבילת התקנה PKG (פורמט חבילת התקנה של יישומי macOS, מבוסס על טכנולוגיית Installer של Apple. פורמט סטנדרטי להפצת תוכנות macOS, תומך בבחירת רכיבים, סקריפטים להתקנה, פונקציית הסרה. לחיצה כפולה על קובץ .pkg להתקנה, שיטת הפצה נפוצה לתוכנות מחוץ ל-Mac App Store)"

msgid "mime_apk"
msgstr "חבילת יישום Android APK (הוצגה על ידי Google בשנת 2008, פורמט התקנה מסורתי עבור יישומי Android. APK הוא למעשה חבילת ZIP המכילה קוד, משאבים וקובץ מניפסט. החל משנת 2021, Google Play מחייב יישומים חדשים להשתמש בפורמט AAB, אך APK עדיין משמש לניפוי באגים, חנויות צד שלישי והתקנה צדדית)"

msgid "mime_ipa"
msgstr "חבילת יישום iOS IPA (iOS App Store Package, פורמט התקנה עבור יישומי iOS/iPadOS. הוצג בשנת 2008 עם ה-iPhone SDK. חייב להיות מופץ דרך ה-App Store או חתום עם אישור ארגוני. מכיל קובץ הרצה, משאבים, Info.plist ומידע חתימה)"

msgid "mime_hap"
msgstr "חבילת יישום HarmonyOS HAP (HarmonyOS Ability Package, יחידת הבסיס של יישום HarmonyOS. הוצג בשנת 2020 עם HarmonyOS 2.0. תומך בשני סוגים: entry ו-feature, פורמט הפצה עבור טלפונים של Huawei, טאבלטים, שעונים חכמים והתקני HarmonyOS אחרים)"

msgid "mime_har"
msgstr "ספרייה סטטית משותפת HarmonyOS HAR (HarmonyOS Archive, ספרייה סטטית משותפת של HarmonyOS, יכולה להיות משותפת על ידי מספר חבילות HAP, משמשת לפיתוח מבוסס רכיבים ושימוש חוזר במודולים)"

msgid "mime_aab"
msgstr "Android App Bundle (Google השיקה אותו ב-2018, החל מ-2021 Google Play מחייב יישומים חדשים להשתמש בפורמט זה. AAB הוא פורמט הפצה, Google Play מייצר APK מותאמים בהתאם לתצורת המכשיר (ארכיטקטורת CPU, צפיפות מסך, שפה), גודל חבילת ההתקנה קטן בממוצע ב-35%. מפתחים מעלים AAB, משתמשים מורידים APK)"

msgid "mime_xapk"
msgstr "חבילת יישום XAPK (חבילת הרחבה ליישומי Android של צד שלישי, מכילה APK + קבצי נתונים OBB. משמש למשחקים גדולים ויישומים מורכבים, פותר את הגבלת 100 MB עבור קובץ APK יחיד. נפוץ בחנויות אפליקציות של צד שלישי כמו APKPure, APKMirror, אינו פורמט רשמי של Google)"

msgid "mime_appx"
msgstr "חבילת יישום Windows (Microsoft השיקה אותו ב-2012, פורמט התקנה עבור יישומי Windows 8/10/11. תומך ביישומי UWP והמרת יישומי שולחן עבודה, מופץ דרך Microsoft Store. ב-2024, Microsoft השיקה את MSIX כיורש, מחליפה בהדרגה את APPX)"

msgid "mime_msix"
msgstr "חבילת יישום MSIX (Microsoft השיקה אותו ב-2018, דור חדש של פורמט אריזה ליישומי Windows. משלב את היתרונות של APPX ו-MSI, תומך בכל סוגי יישומי Windows, ניתן להפצה דרך Microsoft Store או בהתקנה צדדית, פורמט מומלץ עבור Windows 11)"

msgid "mime_appimage"
msgstr "חבילת יישום AppImage (הוצגה ב-2004, פורמט יישום Linux ללא התקנה. 'יישום אחד - קובץ אחד', פועל ישירות ללא התקנה, תומך ברוב הפצות Linux, שיטה נפוצה עבור מפתחים להפצת תוכנות Linux)"

msgid "mime_flatpak"
msgstr "חבילת יישום Flatpak (הוצגה ב-2015, פורמט יישום Linux בארגז חול. פועל על פני הפצות, מבודד ממערכת המארח, הפיתוח מונחה על ידי Fedora ו-Red Hat, פורמט ברירת מחדל של מרכז התוכנה GNOME)"

msgid "mime_snap"
msgstr "חבילת יישום Snap (Canonical השיקה אותו ב-2014, חברת האם של Ubuntu פיתחה, פורמט יישום Linux אוניברסלי. עדכון אוטומטי, בידוד בארגז חול, תומך ביותר מ-40 הפצות Linux, פורמט ברירת מחדל של מרכז התוכנה Ubuntu)"

msgid "mime_deb"
msgstr "חבילת תוכנה של Debian (פרויקט Debian השיק אותו ב-1993, פורמט התקנה סטנדרטי עבור Debian/Ubuntu ונפוצותיהם. מנוהל באמצעות dpkg, APT הוא מנהל החבילות הקדמי שלו, אחד מפורמטי החבילות הבוגרים ביותר במערכת האקולוגית של Linux, עדיין העיקרי במשפחת Debian כיום)"

msgid "mime_rpm"
msgstr "חבילת תוכנה RPM (Red Hat השיק אותו ב-1997, פורמט סטנדרטי עבור הפצות כמו Red Hat/Fedora/CentOS/SUSE. RPM ראשי תיבות של 'Red Hat Package Manager', יחד עם DEB שני פורמטי החבילות העיקריים של Linux, עדיין העיקרי במשפחת RHEL כיום)"

msgid "mime_pacman"
msgstr "חבילת תוכנה של Arch (Arch Linux השיק אותו ב-2002, פורמט .pkg.tar.zst המשמש את מנהל החבילות pacman. הליבה של הפצות rolling release של Arch Linux, ידוע בפשטותו ובעקרון KISS, AUR (Arch User Repository) הוא המאפיין הייחודי שלו)"

msgid "mime_exe"
msgstr "קובץ הפעלה EXE (פורמט תוכנית הפעלה של Windows, קיצור של 'Executable'. פורמט ההפעלה המקורי של מערכת ההפעלה Windows, מכיל מבנה PE. התפתח מפורמט MZ מתקופת MS-DOS, Windows NT הציגה את פורמט PE (Portable Executable) ב-1993 והוא בשימוש עד היום. חבילות התקנה של תוכנה, יישומים, כלי מערכת משתמשים בפורמט זה. המשתמש לוחץ פעמיים כדי להפעיל, הפורמט ההפעלה הנפוץ ביותר בעולם)"

msgid "mime_dll"
msgstr "ספרייה מקושרת דינמית DLL (Microsoft הציגה אותה ב-1993, Dynamic Link Library. ספריית קוד משותפת של Windows, התוכנה נטענת באופן דינמי במהלך הריצה, חוסכת זיכרון ומקום דיסק. רכיבי מערכת, תוספים ליישומים, דרייברים משתמשים בפורמט DLL. הדרך העיקרית ליישום API של Windows, בעיית 'גיהנום DLL' התמתנה בעידן .NET)"

msgid "mime_com"
msgstr "קובץ הפעלה COM (פורמט הפעלה מתקופת MS-DOS, קיצור של 'Command'. מבנה קובץ פשוט מאוד, הגבלה של 64KB, פורמט עיקרי לפני Windows 3.x, מיושן. Windows מודרניים משתמשים בפורמט EXE, סיומת COM עדיין משמשת לקבצי רכיבים מסוימים)"

msgid "mime_aac"
msgstr "אודיו AAC (תקן MPEG משנת 1997, Advanced Audio Coding. היורש של MP3, איכות שמע טובה מ-MP3 באותו קצב סיביות, פורמט אודיו ברירת מחדל עבור YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "אודיו ALAC (Apple פיתחה ב-2004, Apple Lossless Audio Codec. פורמט ללא אובדן של Apple, הפך לקוד פתוח ב-2011, פורמט ללא אובדן ברירת מחדל עבור iTunes ו-Apple Music)"

msgid "mime_flac"
msgstr "אודיו FLAC (קרן Xiph.Org פיתחה ב-2001, Free Lossless Audio Codec. דחיסה ללא אובדן, איכות שמע זהה ל-CD, גודל קובץ כמחצית מה-WAV המקורי. קוד פתוח וללא פטנטים, פורמט מועדף עבור אודיופילים ואוספי מוזיקה דיגיטלית)"

msgid "mime_mp3"
msgstr "אודיו MP3 (מכון Fraunhofer פיתח ב-1993, MPEG-1 Audio Layer 3. פורמט דחיסה מאבדת, קובץ קטן באיכות שמע סבירה, הפורמט העיקרי של מהפכת המוזיקה הדיגיטלית בשנות ה-2000, אחראי לאייפוד ולנפסטר. הפטנטים פג ב-2017, הפך לפורמט נחלת הכלל)"

msgid "mime_oga"
msgstr "אודיו Ogg Audio (פותח על ידי קרן Xiph.Org, פורמט אודיו טהור של מיכל Ogg, משתמש בקידוד Vorbis. קוד פתוח וללא פטנטים, יעילות דחיסה טובה מ-MP3, בשימוש נרחב בפרויקטי קוד פתוח)"

msgid "mime_ogg"
msgstr "אודיו OGG (קרן Xiph.Org פיתחה ב-2000, פורמט Ogg Vorbis. קוד פתוח וללא פטנטים, יעילות דחיסה טובה מ-MP3, Spotify המוקדם השתמש בו, בשימוש נרחב לאפקטים קוליים במשחקים)"

msgid "mime_opus"
msgstr "אודיו Opus (IEEE ביצע סטנדרטיזציה ב-2012, פורמט אודיו פתוח וללא פטנטים, משלב טכנולוגיות SILK ו-CELT, השהייה נמוכה במיוחד, היעילות הגבוהה ביותר בדחיסה, פורמט אודיו ברירת מחדל עבור WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "אודיו WAV (Microsoft ו-IBM פיתחו ב-1991, פורמט אודיו מקורי של Windows. קידוד PCM, לא דחוס, איכות שמע ללא אובדן אך קובץ גדול מאוד, פורמט סטנדרטי לעריכת אודיו מקצועית)"

msgid "mime_wma"
msgstr "אודיו WMA (Microsoft פיתחה ב-1999, Windows Media Audio. יש גרסאות מאבדות/ללא אובדן, נתמך באופן מקורי ב-Windows, התפשט עם Windows Media Player. כיום בשוליים, הוחלף על ידי MP3/AAC)"

msgid "mime_dsf"
msgstr "אודיו DSF (פורמט Direct Stream Digital, פותח על ידי Sony ו-Philips. קצב דגימה גבוה של 1 סיבית, פורמט אודיו DSD סטנדרטי, גרסה דיגיטלית של SACD, פורמט אודיו איכותי לאודיופילים, קובץ גדול מאוד)"

msgid "mime_ape"
msgstr "שמע APE (פותח על ידי Monkey's Audio בשנת 2000, פורמט דחיסה ללא אובדן. דחיסה גבוהה מ-FLAC אך קידוד איטי יותר, עדיין בשימוש בפלטפורמת Windows ובקרב חובבי אודיו)"

msgid "mime_mid"
msgstr "אודיו MIDI (איגוד MIDI קבע ב-1983, Musical Instrument Digital Interface. פורמט תווים, לא הקלטה, קובץ קטן מאוד, סטנדרט לכלי נגינה אלקטרוניים, צלצולי טלפון, אפקטים קוליים במשחקים. General MIDI תוקנן ב-1991, מגדיר 128 כלים)"

msgid "mime_m4a"
msgstr "אודיו M4A (MPEG-4 Audio, פורמט מיכל עבור AAC. פורמט סטנדרטי של חנות המוזיקה iTunes, פורמט אודיו ראשי במערכת האקולוגית של Apple, תומך בהגנת DRM)"

msgid "mime_m3u"
msgstr "רשימת השמעה M3U (פורמט רשימת השמעה של URL MP3, קובץ טקסט פשוט, מתעד נתיבי קבצי אודיו. סטנדרט מתקופת Winamp, משמש לרדיו באינטרנט, הזרמת מוזיקה מקוונת. M3U8 היא גרסת ה-UTF-8 שלו, משמשת להזרמת HTTP Live Streaming)"

msgid "mime_asf"
msgstr "הזרמת ASF (Microsoft פיתחה ב-1996, Advanced Systems Format. מיכל הזרמת Windows Media, תומך בהעברה סינכרונית של אודיו ווידאו. משמש לשידורים חיים באינטרנט ולהזרמת וידאו לפי דרישה, WMA/WMV מבוססים על מיכל ASF)"

msgid "mime_avi"
msgstr "וידאו AVI (Microsoft השיקה ב-1992, תקן וידאו מוקדם של Windows. 'Audio Video Interleave', מחליף אודיו ווידאו, היה פורמט הווידאו הפופולרי ביותר בשנות ה-1990-2000, כיום הוחלף על ידי MP4/MKV)"

msgid "mime_divx"
msgstr "וידאו DivX (חברת DivX פיתחה ב-1998, פורמט קודק וידאו מבוסס MPEG-4. פורמט עיקרי לשיתוף וידאו באינטרנט בשנות ה-2000, הטכנולוגיה הראשונה שדחסה איכות DVD לגודל CD. עקב מחלוקות בנושא זכויות יוצרים, הפך מאוחר יותר לקודק מסחרי)"

msgid "mime_mp4"
msgstr "וידאו MP4 (תקן MPEG משנת 2001, MPEG-4 Part 14. פורמט הווידאו הנפוץ ביותר בעולם, תומך בקידוד H.264/H.265, פורמט ברירת מחדל לווידאו באינטרנט, צילום בטלפון נייד, YouTube)"

msgid "mime_m4v"
msgstr "וידאו M4V (פורמט וידאו של iTunes, גרסה של MP4. פורמט וידאו במערכת האקולוגית של Apple, פורמט סטנדרטי עבור סרטים ותוכניות טלוויזיה בחנות iTunes, תומך בהגנה על זכויות יוצרים DRM)"

msgid "mime_mpeg"
msgstr "וידאו MPEG (ארגון MPEG קבע ב-1988, Moving Picture Experts Group. הניח את היסודות לתקני דחיסת וידאו דיגיטלית, ל-MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (וידאו באינטרנט) הייתה השפעה עמוקה)"

msgid "mime_mkv"
msgstr "וידאו MKV (פרויקט Matroska פיתח ב-2002, מיכל מולטימדיה בקוד פתוח. תומך במספר רצועות אודיו, מספר כתוביות, פרקים, 'כלי אריזה', פורמט מועדף לשיתוף סרטים ברזולוציה גבוהה)"

msgid "mime_mpg"
msgstr "וידאו MPEG (סיומות וידאו MPEG-1/MPEG-2, פורמט סטנדרטי עבור VCD ו-DVD. פורמט הווידאו העיקרי בדיסקים אופטיים בשנות ה-1990-2000, כיום הוחלף על ידי H.264/H.265)"

msgid "mime_ogv"
msgstr "וידאו Ogg Video (פותח על ידי קרן Xiph.Org, פורמט וידאו של מיכל Ogg, משתמש בקידוד Theora. קוד פתוח וללא פטנטים, אחד הסטנדרטים המוקדמים לווידאו HTML5, Firefox תומך בו באופן מקורי)"

msgid "mime_ogx"
msgstr "מיכל מולטימדיה Ogg (פותח על ידי קרן Xiph.Org, הרחבה כללית של מיכל Ogg, יכול להכיל מספר רצועות כמו אודיו, וידאו, כתוביות. תקן מולטימדיה פתוח, משמש למשחקים, הזרמה)"

msgid "mime_rm"
msgstr "וידאו RealMedia (RealNetworks פיתחה ב-1995, פורמט RealMedia. חלוץ ההזרמה באינטרנט בשנות ה-1990-2000, פורמט עיקרי של נגן RealPlayer. חסרונות: דורש נגן מיוחד, איכות דחיסה ירודה, מאוחר יותר הוחלף על ידי Flash/MP4)"

msgid "mime_flv"
msgstr "וידאו Flash (הפורמט הופיע ב-2002, פורמט Flash Video. היה פעם פורמט הווידאו העיקרי באינטרנט. YouTube המוקדם השתמש בו. חסרונות: צורך בתוסף Flash, ביצועים ירודים, פגיעויות אבטחה רבות. החל מ-2015, אתרים עיקריים עברו לווידאו HTML5, כיום מיושן)"

msgid "mime_f4v"
msgstr "וידאו F4V (פורמט וידאו Flash שפותח על ידי Adobe, יורש של FLV. מבוסס על תקן MPEG-4, תומך בקידוד H.264. מיושן יחד עם טכנולוגיית Flash, Adobe הפסיקה את התמיכה ב-2020)"

msgid "mime_wmv"
msgstr "וידאו WMV (Microsoft פיתחה ב-1999, Windows Media Video. נתמך באופן מקורי ב-Windows, מותאם להזרמה, היה פורמט נפוץ בווידאו מקוון מוקדם, כיום בשוליים)"

msgid "mime_wmf"
msgstr "פורמט מדיה WMF (Windows Media Format, מסגרת המדיה של Microsoft, כוללת וידאו WMV, אודיו WMA, נתמך באופן מקורי על ידי Windows Media Player)"

msgid "mime_mov"
msgstr "וידאו MOV (Apple פיתחה ב-1991, פורמט מיכל QuickTime. פורמט סטנדרטי לעריכת וידאו מקצועית, תומך במספר קודקים, נתמך באופן מקורי על ידי Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "וידאו QuickTime (Apple השיקה ב-1991, פורמט QuickTime. תקן וידאו בפלטפורמת Mac, MOV הוא המיכל שלו, נגן QuickTime היה בשימוש נרחב. Apple הפסיקה את הפיתוח של גרסת Windows ב-2016, מחליפה אותו בהדרגה ב-MP4)"

msgid "mime_webm"
msgstr "וידאו WebM (Google השיקה ב-2010, פורמט וידאו פתוח וללא פטנטים. מבוסס על מיכל Matroska, קידוד VP8/VP9, פורמט וידאו סטנדרטי של HTML5, פורמט ברירת מחדל להפעלה ב-YouTube באינטרנט)"

msgid "mime_3gp"
msgstr "וידאו 3GP (3GPP קבע ב-2000, פורמט וידאו למכשירים ניידים. קובץ קטן מאוד, איכות נמוכה, פורמט להקלטת וידאו בטלפונים מוקדמים, שימש לשליחת MMS)"

