msgstr "  -showunknownorigin   מציג את המפנה כאשר לא ניתן לנתח אותו"

msgid "  -showdirectorigin   to output log line when origin is a direct access"
msgstr "  -showdirectorigin    מציג את שורת היומן כאשר המקור הוא גישה ישירה"

msgid "  -updatefor=n   to stop the update process after parsing n lines"
msgstr "  -updatefor=n   עוצר את תהליך העדכון לאחר ניתוח n שורות"

