msgstr "MonthHostsKnown   = จำนวนโฮสต์ที่รู้จัก"

msgid "MonthHostsUnKnown = Number of hosts unknown"
msgstr "MonthHostsUnKnown = จำนวนโฮสต์ที่ไม่รู้จัก"

