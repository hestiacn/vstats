#------------------------------------------------------------------------------

msgid "mime_text"
msgstr "Skedar teksti (standardizuar ASCII në 1963, tekst i thjeshtë i paformatizuar. Baza e të gjithë kodit burimor, konfigurimeve dhe regjistrave. Unix përdor LF, Windows përdor CRLF për rresht të ri, ende formati më universal i të dhënave në kompjuterë)"

msgid "mime_log"
msgstr "Skedar regjistri (skedar i thjeshtë teksti që regjistron informacione rreth funksionimit të sistemit dhe aplikacioneve, përdoret shpesh për zgjidhjen e problemeve, analizën e performancës, auditimin e sigurisë. Formate standarde si Apache combined log, Nginx access log, syslog etj.)"

msgid "mime_page"
msgstr "Faqe HTML (Tim Berners-Lee shpiku WWW në 1989, përcaktoi tre teknologjitë HTML/HTTP/URL në 1990, i hapi ato falas pa patentë. Në 2014 HTML5 u bë standardi zyrtar i W3C, mbështet shfaqjen, multimedian dhe printimin. Fitoi çmimin Turing në 2016)"

msgid "mime_khtml"
msgstr "Motor faqesh web KHTML (KDE 2.0 u publikua në 1998, motor renderimi i shfletuesit Konqueror. Në 2001 Apple krijoi WebKit bazuar në KHTML, në 2008 Google krijoi Blink nga WebKit, i cili u bë thelbi i shfletuesve Chrome, Edge, Safari dhe të tjerë. KHTML është një shembull se si komuniteti me burim të hapur hodhi themelet për motorët modernë të shfletuesve, trashëgimia e tij teknologjike vazhdon përmes WebKit/Blink)"

msgid "mime_script"
msgstr "Skript dinamik (gjuhë e interpretuar, nuk kërkon përpilim. Përfshin ASP, JSP, CGI, ColdFusion, Tcl, VBScript etj., përdoret gjerësisht në zhvillimin e hershëm të web-it, administrimin e sistemit, automatizimin e detyrave. Gjuhët moderne të skriptit si Python, Ruby, JavaScript janë zhvilluar në mjete kryesore për zhvillimin full-stack)"

msgid "mime_js"
msgstr "Skript JavaScript (Brendan Eich e krijoi atë në 10 ditë në Netscape në 1995, gjuhë programimi vendase e shfletuesve. Në 1997 ECMAScript u standardizua, në 2009 lindi Node.js duke e bërë atë një gjuhë full-stack, npm është menaxheri më i madh i paketave në botë. Për vite me radhë gjuha programuese më e popullarizuar në GitHub)"

msgid "mime_py"
msgstr "Skript Python (krijuar nga Guido van Rossum në 1991, i njohur për dhëmbëzimin e detyruar dhe sintaksën e pastër. Përdoret gjerësisht në zhvillimin e web-it, shkencën e të dhënave, inteligjencën artificiale, operacionet e automatizuara. Fitues i shumëfishtë i çmimit Gjuha Programuese e Vitit nga TIOBE)"

msgid "mime_sh"
msgstr "Skript Shell (Unix lindi në 1971, gjuhë skriptimi komanduese. Përdoret për administrimin e sistemit, automatizimin e detyrave, nisjen e shërbimeve, skriptet e vendosjes. Aftësi themelore për administratorët e Linux-it)"

msgid "mime_rb"
msgstr "Skript Ruby (krijuar nga Yukihiro Matsumoto në 1995, fokusohet në lumturinë e zhvilluesit. Korniza Ruby on Rails hapi paradigmin e zhvillimit \"konventë në vend të konfigurimit\", duke ndikuar në dizajnin e kornizave moderne të web-it)"

msgid "mime_pl"
msgstr "Skript Perl (krijuar nga Larry Wall në 1987, i njohur për pragmatizmin e tij, i quajtur \"thika zvicerane\". CPAN ishte pionier i menaxherëve modernë të paketave të gjuhëve, pati ndikim të thellë në përpunimin e tekstit, administrimin e sistemit dhe fushën CGI)"

msgid "mime_php"
msgstr "Faqe dinamike PHP (krijuar nga Rasmus Lerdorf në 1995, projektuar posaçërisht për zhvillimin e web-it. Mbi 70% e faqeve të internetit në botë e përdorin atë, fuqizon platforma si WordPress, Facebook, Wikipedia. PHP 8 prezantoi përpilimin JIT, duke përmirësuar ndjeshëm performancën)"

msgid "mime_image"
msgstr "Skedar imazhi"

msgid "mime_document"
msgstr "Skedar dokumenti"

msgid "mime_package"
msgstr "Paketë softuerike"

msgid "mime_archive"
msgstr "Skedar i ngjeshur Gzip (projekt GNU nga 1992, bazuar në algoritmin DEFLATE. Në web përdoret për ngjeshjen dinamike të përmbajtjes së përgjigjes, shkalla e ngjeshjes zakonisht 60-90%. Pas 2015 në disa skenarë u zëvendësua nga Brotli, por mbetet formati më i mbështetur i ngjeshjes në anën e serverit)"

msgid "mime_audio"
msgstr "Skedar audio"

msgid "mime_video"
msgstr "Skedar video"

msgid "mime_jscript"
msgstr "JavaScript (zhvilluar nga Brendan Eich në 1995)"

msgid "mime_json"
msgstr "Të dhëna JSON (propozuar nga Douglas Crockford në 2001, format i lehtë i shkëmbimit të të dhënave, standard de facto për API-të e web-it)"

msgid "mime_vbs"
msgstr "VBScript (zhvilluar nga Microsoft në 1996, gjuhë skriptimi për Windows, përdoret për faqet ASP dhe skriptet e administrimit të Windows. Me përhapjen e PowerShell dhe JavaScript, po hiqet gradualisht)"

msgid "mime_conf"
msgstr "Skedar konfigurimi (format teksti për ruajtjen e konfigurimit të softuerit, formate të zakonshme: INI, JSON, YAML, TOML, XML. Konfigurimet e sistemit Linux janë kryesisht në direktorinë /etc)"

msgid "mime_css"
msgstr "Fletë stili CSS (W3C publikoi CSS1 si standardin e parë zyrtar në dhjetor 1996, CSS2 shtoi pozicionimin dhe llojet e medias në 1998, nga 2011 CSS3 modulare prezantoi qoshet e rrumbullakosura, animacionet, kutitë fleksibël, paraqitjen në rrjetë dhe dizajnin e përgjegjshëm. Së bashku me HTML dhe JavaScript janë tre teknologjitë bazë të front-end-it, të gjithë shfletuesit modernë (Chrome, Firefox, Safari, Edge) e mbështesin atë në mënyrë vendase, është standardi i vetëm për përcaktimin e stileve të web-it)"

msgid "mime_xsl"
msgstr "Fletë stili XSL (standard W3C nga 1999, gjuhë transformimi i dokumenteve XML, mund të konvertojë XML në HTML/PDF/tekst. Pas përhapjes së JSON, përdorimi i tij u zvogëlua)"

msgid "mime_runtime"
msgstr "Skedar i ekzekutueshëm (formate të ekzekutueshme të sistemit operativ si EXE, ELF, Mach-O, përmban kodin e makinës dhe informacionin e ngarkimit)"

msgid "mime_library"
msgstr "Skedar bibliotekë (DLL, SO, dylib dhe biblioteka të tjera të lidhura në mënyrë dinamike, kod i ngarkuar gjatë ekzekutimit të programit)"

msgid "mime_swf"
msgstr "Animacion Flash (zhvilluar nga Macromedia në 1996, më pas kaloi te Adobe. Standard për animacionet interaktive të web-it, dikur dominoi animacionet dhe lojërat në internet. Dobësitë: varet nga shtojca, pa mbështetje në celular, rrezik i lartë sigurie. Në 2017 Adobe njoftoi eliminimin, mbështetja u ndërpre plotësisht në 2020, u zëvendësua nga HTML5/CSS3/JS)"

msgid "mime_dtd"
msgstr "Përkufizim i tipit të dokumentit DTD (specifikim XML, përcakton strukturën e një dokumenti XML, përdoret për të vërtetuar vlefshmërinë e XML)"

msgid "mime_csv"
msgstr "Format të dhënash CSV (vlera të ndara me presje, format universal për të dhënat tabelare, standard për import/eksport në Excel dhe baza të dhënash)"

msgid "mime_jnlp"
msgstr "Java Web Start (nisës i aplikacioneve Java, teknologji e shpërndarjes së aplikacioneve Java për desktop nga vitet 2000, tani e hequr)"

msgid "mime_lit"
msgstr "Libër elektronik Microsoft Reader (lëshuar nga Microsoft në 2000, format LIT, i hequr)"

msgid "mime_svg"
msgstr "Grafikë vektoriale SVG (standard W3C nga 1999, sepse Microsoft promovoi prej kohësh formatin e vet VML, shfletuesi IE e mbështeti vetëm në 2011, gjë që vonoi përhapjen. Pas 2015, me heqjen e IE dhe përhapjen e ekraneve HD, u bë formati i preferuar për ikona dhe logo)"

msgid "mime_ai"
msgstr "Grafikë vektoriale Adobe Illustrator (lëshuar në 1987, format standard industrial për grafikë vektoriale, zgjedhja e parë për dizajnin e shtypjes, logo dhe ikona)"

msgid "mime_phshop"
msgstr "Imazh Photoshop (lëshuar nga Adobe në 1990, format burimor i Photoshop-it PSD, standard industrial për përpunimin e imazheve)"

msgid "mime_ttf"
msgstr "Font TrueType (zhvilluar bashkërisht nga Apple dhe Microsoft në 1989, format fonti vektorial, shfaqje konsistente në ekran dhe printim, format i paracaktuar i fontit në sistemet moderne operative)"

msgid "mime_fon"
msgstr "Font web WOFF2 (Rekomandim i W3C nga 2014, përdor algoritmin e ngjeshjes Brotli, krahasuar me WOFF-in e vjetër vëllimi zvogëlohet rreth 30%, krahasuar me TTF/OTF zvogëlohet mbi 50%, të gjithë shfletuesit modernë e mbështesin atë, formati i preferuar për fontet moderne të web-it, i mbështetur nga mbi 98% e shfletuesve)"

msgid "mime_pdf"
msgstr "Dokument PDF (zhvilluar nga Adobe në 1993, u bë standard ndërkombëtar ISO në 2008. Format dokumenti i pavarur nga platforma, ruan konsistencën e formatimit, standard global për shpërndarjen e dokumenteve elektronike)"

msgid "mime_dotnet"
msgstr "Faqe dinamike ASP.NET (lëshuar nga Microsoft në 2002, teknologji dinamike web për platformën Windows, pjesë e .NET Framework)"

msgid "mime_mdb"
msgstr "Bazë të dhënash Access (skedar baze të dhënash Microsoft Access, lëshuar në 1992, zgjidhje baze të dhënash desktop për Windows)"

msgid "mime_md"
msgstr "Dokument Markdown (krijuar nga John Gruber në 2004, dizajni i sintaksës u ndikua nga reStructuredText dhe Setext. Filozofia kryesore e dizajnit është 'lexueshmëria është paraqitje', implementimi origjinal Markdown.pl është shkruar në Perl dhe kryen transformimin e tekstit bazuar në shprehje të rregullta. Specifikimet e derivuara përfshijnë GFM (2013), CommonMark (2017), Pandoc Markdown etj. Fuqizon ekosisteme si GitHub, GitLab, Stack Overflow, Jupyter Notebook, Obsidian, Hugo, VitePress, duke u bërë formati standard de facto për gjeneratorët e faqeve statike dhe dokumentacionin e zhvilluesve)"

msgid "mime_crystal"
msgstr "Format raporti Crystal Reports (raport i inteligjencës së biznesit SAP, format standard për raportet e korporatave)"

msgid "mime_libreoffice"
msgstr "Dokument LibreOffice (zhvilluar nga The Document Foundation në 2010, degë e OpenOffice, implementim i standardit ODF, paketa kryesore zyre me burim të hapur)"

msgid "mime_encrypt"
msgstr "Skedar i enkriptuar (skedar që duhet të dekriptohet për t'u parë, zgjerime të zakonshme: .enc, .crypt, .pgp, .gpg)"

msgid "mime_gpx"
msgstr "Të dhëna të gjurmës GPS (format shkëmbimi GPS, regjistron informacione të vendndodhjes gjeografike, format universal për orët sportive dhe pajisjet e navigimit)"

msgid "mime_diskimage"
msgstr "Imazh disku (DMG, ISO, IMG dhe skedarë të tjerë imazhi të diskut optik/disk, përdoren për shpërndarjen e softuerit ose rezervimin e mediave të ruajtjes)"

msgid "mime_vm"
msgstr "Imazh i makinerisë virtuale (VMDK, VDI, VHDX, OVA dhe skedarë të tjerë të diskut virtual, formate të platformave të virtualizimit si VMware, VirtualBox, Hyper-V)"

msgid "mime_torrent"
msgstr "Skedar torrent BitTorrent (shpikur nga Bram Cohen në 2001, skedar indeksi i shkarkimit P2P, përmban metadata të skedarit dhe informacion të Tracker-it)"

msgid "mime_gis"
msgstr "Të dhëna SIG (Shapefile, GeoJSON dhe formate të tjera të dhënash gjeohapësinore, përdoren për harta dhe analizë hapësinore)"

msgid "mime_ebook"
msgstr "Libër elektronik (EPUB, MOBI, AZW dhe formate të tjera librash elektronikë. EPUB është standard ndërkombëtar, MOBI/AZW janë formati i Amazon Kindle)"

msgid "mime_avif"
msgstr "Imazh AVIF (lëshuar nga Aleanca për Media të Hapur në 2019, bazuar në kodimin AV1, shkalla e ngjeshjes është 50% më e mirë se WebP, standard i imazhit të web-it të gjeneratës së re)"

msgid "mime_markdown"
msgstr "Dokument Markdown (projektuar nga John Gruber në 2004, gjuhë e lehtë markup, format universal për GitHub README, dokumentacion teknik, postime në forum)"

msgid "mime_yaml"
msgstr "Konfigurim YAML (projektuar nga Clark Evans në 2001, format i lexueshëm nga njeriu për serializimin e të dhënave, format standard i skedarëve të konfigurimit për Kubernetes, Ansible, Docker Compose)"

msgid "mime_toml"
msgstr "Konfigurim TOML (projektuar nga Tom Preston-Werner në 2013, \"Tom's Obvious Minimal Language\", format i skedarit të konfigurimit për mjete moderne si Rust/Cargo, Python/pip, Go)"

msgid "mime_vue"
msgstr "Skedë e komponentit Vue (prezantuar në 2014 nga Evan You, një kornizë progresive JavaScript. Nëpërmjet komponentëve me skedë të vetme (SFC), ajo kombinon në mënyrë të përkryer HTML, CSS dhe JS, duke rritur shumë efikasitetin e zhvillimit. Është një nga kornizat më të njohura frontend në botë. Gjithashtu, si bërthamë e gjeneruesve modernë të faqeve statike si VitePress, përdoret gjerësisht për të drejtuar dokumentacionin teknik interaktiv dhe blogjet.)"

msgid "mime_wasm"
msgstr "Modul WebAssembly (standard W3C nga 2017, format ekzekutimi me performancë të lartë në shfletues, C/C++/Rust/R mund të përpilohen në objektiv, performanca afër asaj vendase)"

msgid "mime_jsx"
msgstr "Komponent React JSX (Facebook prezantoi JavaScript XML në 2013, sintaksë e komponentëve të kornizës React, një paradigmë inovative për të shkruar HTML në JavaScript)"

msgid "mime_tsx"
msgstr "Komponent TypeScript TSX (zhvilluar nga Microsoft në 2012, TypeScript + JSX, mënyra standarde e zhvillimit të React me siguri të llojit)"

msgid "mime_heif"
msgstr "Imazh HEIF (standard MPEG nga 2015, format efikas i skedarit të imazhit, përdoret gjerësisht në ekosistemin e Apple)"

msgid "mime_heic"
msgstr "Imazh HEIC (implementimi i HEIF nga Apple, format i paracaktuar i fotove për iPhone, i mbështetur në mënyrë vendase në iOS/macOS)"

msgid "mime_gltf"
msgstr "Model 3D GLTF (format transferimi GL, \"JPEG për botën 3D\", lëshuar nga Khronos Group në 2015, format standard për web 3D)"

msgid "mime_glb"
msgstr "Model 3D binar GLB (versioni binar i GLTF, një skedar përmban të gjitha burimet, përdoret për shpërndarjen e skenave 3D)"

msgid "mime_gls"
msgstr "Glosar GLOSSARY (skedar përkufizimesh termash, përdoret për menaxhimin e terminologjisë në sistemet e dokumentacionit)"

msgid "mime_cbz"
msgstr "Libër stripash CBZ (imazhe stripash të ngjeshura me ZIP, format universal për mbledhjen e stripit)"

msgid "mime_cbr"
msgstr "Libër stripash CBR (imazhe stripash të ngjeshura me RAR, format universal për mbledhjen e stripit)"

msgid "mime_fb2"
msgstr "Libër elektronik FB2 (FictionBook 2.0, format rus i librit elektronik, strukturë XML, i mbështetur gjerësisht nga lexuesit me burim të hapur)"

msgid "mime_kepub"
msgstr "Libër elektronik KEPUB (format EPUB specifik për Kobo, format i optimizuar për lexuesit e librave elektronikë Kobo)"

msgid "mime_m4b"
msgstr "Libër audio M4B (format i librit audio MPEG-4, mbështet faqerojtësit, format i librave audio të iTunes)"

msgid "mime_kfx"
msgstr "Format Kindle KFX (lëshuar nga Amazon në 2015, format i veçantë për librat elektronikë Kindle, mbështet tipografi të përmirësuar dhe rrotullim të shpejtë të faqeve)"

msgid "mime_chm"
msgstr "Skedar ndihme CHM (lëshuar nga Microsoft në 1997, format i ndihmës HTML të përpiluar, standard për dokumentacionin e ndihmës së softuerit Windows)"

msgid "mime_mht"
msgstr "Arkiv web MHT (lëshuar nga Microsoft në 1999, format web me një skedar, format i ruajtjes së faqeve të internetit nga shfletuesi IE)"

msgid "mime_wml"
msgstr "Gjuhë markup pa tela WML (standard WAP nga 1999, përdoret për skedarët e faqeve të internetit të telefonave të hershëm funksional, i hequr)"

msgid "mime_xhtml"
msgstr "Faqe web XHTML (standard W3C nga 2000, versioni XML i HTML, sintaksë më e rreptë. Në 2009 W3C ndërroi mirëmbajtjen, duke e përqendruar vëmendjen në HTML5)"

msgid "mime_xml"
msgstr "Dokument XML (standard W3C nga 1998, gjuhë markup e zgjerueshme, format bazë për shërbimet e web-it, skedarët e konfigurimit, shkëmbimin e të dhënave)"

msgid "mime_sgml"
msgstr "Dokument SGML (standard ISO nga 1986, paraardhësi i HTML, gjuhë markup e përgjithshme standarde, si XML ashtu edhe HTML rrjedhin nga SGML)"

msgid "mime_apng"
msgstr "Animacion APNG (zhvilluar nga Mozilla në 2004, zgjerim animacioni i PNG, zëvendësues modern për GIF, mbështet ngjyrat reale dhe transparencën)"

msgid "mime_bmp"
msgstr "Bitmap BMP (format bitmap i Windows, i mbështetur në mënyrë vendase që nga Windows 1.0. I pangjeshur, madhësi e madhe e skedarit, por për shkak të strukturës së tij të thjeshtë dhe mungesës së nevojës për kodekë shtesë, përdoret ende në Mjetin e Prerjes së Windows 11, programin Paint, burimet e ikonave në paketat e instalimit EXE/MSI, skedarët e kursorit dhe disa drejtues të vjetër. Me të njëjtën cilësi imazhi, madhësia e skedarit është rreth 3-10 herë më e madhe se PNG. Në shumicën e rasteve është zëvendësuar nga PNG/JPEG, por ekosistemi i Windows ruan ende përputhshmëri të gjerë)"

msgid "mime_cdr"
msgstr "Grafikë vektoriale CDR (format specifik i CorelDRAW, kompania Corel nga Kanadaja, softuer për dizajnimin e grafikës vektoriale)"

msgid "mime_gif"
msgstr "Imazh GIF (zhvilluar nga CompuServe në 1987, format imazhi i animuar me 256 ngjyra. Dobësitë: pak ngjyra, cilësi e trashë e imazhit, nuk mbështet transparencën, skedar i madh, shkallë e ulët e kornizave. Zëvendësuar nga formatet moderne të imazhit të animuar si APNG, WebP)"

msgid "mime_ico"
msgstr "Ikonë ICO (format i skedarit të ikonave të Windows, mbështet shumë rezolucione, format standard për favicon-in e faqeve të internetit)"

msgid "mime_jpeg"
msgstr "Imazh JPEG (standard ISO nga 1992, format i ngjeshjes me humbje për fotografi, standard de facto për fotot në internet)"

msgid "mime_jpg"
msgstr "Imazh JPEG (standard ISO nga 1992, format i ngjeshjes me humbje për fotografi, standard de facto për fotot në internet)"

msgid "mime_png"
msgstr "Imazh PNG (rekomandim i W3C nga 1996, mbështet ngjyrat reale dhe transparencën, zëvendësues statik për GIF, standard i imazhit pa humbje në internet)"

msgid "mime_ps"
msgstr "Skedar përshkrimi i faqes PostScript (lëshuar nga Adobe në 1985, gjuhë përshkrimi i faqes, paraardhësi i PDF, përdoret për printim dhe botim)"

msgid "mime_psb"
msgstr "Dokument i madh PSB (format i imazhit shumë të madh të Adobe Photoshop, mbështet imazhe gjigante mbi 2 GB ose 30000 piksel)"

msgid "mime_psd"
msgstr "Imazh PSD (skedar burimor i Adobe Photoshop, mbështet shtresat, kanalet, shtigjet, format standard industrial për përpunimin e imazheve)"

msgid "mime_webp"
msgstr "Imazh WebP (zhvilluar nga Google në 2010, format i imazhit të web-it, mbështet ngjeshje me humbje/pa humbje dhe animacion, shkalla e ngjeshjes është 25-35% më e mirë se PNG, 25% më e mirë se JPEG)"

msgid "mime_woff"
msgstr "Font web WOFF (krijuar në 2009, standard W3C nga 2018. Ngjeshje e bazuar në TrueType/OpenType, optimizim i ngarkimit të fonteve të web-it, format standard për fontet e ikonave të faqeve moderne të web-it)"

msgid "mime_7z"
msgstr "Paketë e ngjeshur 7z (zhvilluar nga Igor Pavlov në 1999, format specifik i programit 7-Zip. Algoritmi LZMA, ngjeshje e lartë, burim i hapur dhe falas. Formati 7z me të njëjtën shkallë ngjeshjeje është zakonisht 30-50% më i vogël se ZIP, format i zakonshëm në komunitetin me burim të hapur dhe për shpërndarjen e softuerit)"

msgid "mime_ace"
msgstr "Paketë e ngjeshur ACE (zhvilluar në vitet 1990, format i programit WinACE. Dikur konkurronte me RAR, shkallë ngjeshjeje relativisht e lartë. Zhvillimi u ndërpre në 2007, tani është zëvendësuar nga 7z/RAR, përdoret rrallë)"

msgid "mime_bz2"
msgstr "Paketë e ngjeshur BZIP2 (zhvilluar nga Julian Seward në 1996, algoritëm ngjeshjeje me renditje blloku. Shkalla e ngjeshjes është 15-20% më e mirë se GZIP, por më e ngadaltë. Kodi burimor i bërthamës së Linux-it, paketat me burim të hapur përdorin shpesh këtë format, zgjerimi .bz2)"

msgid "mime_cab"
msgstr "Paketë e ngjeshur CAB (zhvilluar nga Microsoft në 1995, format Kabineti. Format i paketave të instalimit të sistemit Windows, përdoret për drejtuesit, shpërndarjen e skedarëve të sistemit. Windows Installer (MSI) brendazi përdor CAB për ruajtjen e skedarëve)"

msgid "mime_dmg"
msgstr "Imazh disku DMG (lëshuar nga Apple në vitet 1980, format Disk Image. Format standard për shpërndarjen e softuerit në macOS, klikimi i dyfishtë montohet si disk virtual, tërhiq dhe lësho për të instaluar aplikacionin. Mbështet ngjeshjen dhe enkriptimin, format kryesor për shkarkimin e softuerit Mac)"

msgid "mime_emz"
msgstr "Imazh i ngjeshur EMZ (metafajll i përmirësuar i ngjeshur i Windows, version i ngjeshur i EMF. Format i ruajtjes së grafikës vektoriale në dokumentet e Office, në thelb është një skedar EMF i ngjeshur me GZIP)"

msgid "mime_gz"
msgstr "Paketë e ngjeshur GZIP (zhvilluar nga Jean-loup Gailly dhe Mark Adler në 1992, projekt GNU. Mjet standard i ngjeshjes në Unix/Linux, format i zakonshëm për ngjeshjen e transmetimit HTTP. Zgjerimi .gz, shpesh i përdorur së bashku me TAR)"

msgid "mime_jar"
msgstr "Paketë e ngjeshur JAR (lëshuar nga Sun Microsystems në 1997, format Java ARchive. Në thelb është një paketë e ngjeshur ZIP, përdoret për paketimin e bibliotekave të klasave Java dhe aplikacioneve. Format bazë në ekosistemin Java si Maven, Gradle, Android gjithashtu përdor JAR)"

msgid "mime_lzma"
msgstr "Paketë e ngjeshur LZMA (zhvilluar nga Igor Pavlov në 1998, algoritmi i zinxhirit Lempel-Ziv-Markov. Algoritmi kryesor i ngjeshjes së formatit 7z, ngjeshje e lartë, çngjeshje e shpejtë. Përdoret për firmuer, shpërndarjen e softuerit për sisteme të ngulitura)"

msgid "mime_rar"
msgstr "Paketë e ngjeshur RAR (zhvilluar nga Eugene Roshal në 1993, format Roshal ARchive. Ngjeshje e lartë, mbështet ndarjen në vëllime, regjistrime rikuperimi. Format i programit WinRAR, ngjeshja superiore ndaj ZIP, por kërkon softuer të paguar, mjetet me burim të hapur si unrar mund të çngjeshin)"

msgid "mime_tar"
msgstr "Arkiv TAR (prezantuar në Unix V7 në 1979, format Tape ARchive. Format arkivi i shiritit, nuk ngjesh vetëm paketon, shpesh përdoret së bashku me GZIP/BZIP2/XZ. Kodi burimor i paketave të Linux-it, ruajtja e shtresave të imazheve të Docker përdor formatin TAR)"

msgid "mime_tgz"
msgstr "Paketë e ngjeshur TGZ (format i kombinuar TAR + GZIP, zgjerimi .tgz ose .tar.gz. Formati më universal i shpërndarjes së paketave Unix/Linux, përdoret gjerësisht për paketat burimore, paketat binare, përfaqësues i \"shpaketoni dhe përdorni\")"

msgid "mime_tbz2"
msgstr "Paketë e ngjeshur TBZ2 (format i kombinuar TAR + BZIP2, zgjerimi .tbz2 ose .tar.bz2. Shkalla e ngjeshjes është 15-20% më e mirë se TGZ, e përshtatshme për shpërndarjen e skedarëve të mëdhenj, kodi burimor i bërthamës së Linux-it ka përdorur prej kohësh këtë format)"

msgid "mime_xz"
msgstr "Paketë e ngjeshur XZ (lëshuar në 2009, bazuar në algoritmin LZMA2. Ngjeshje jashtëzakonisht e lartë, 30-50% më e mirë se GZIP, çngjeshje relativisht e shpejtë. Përdoret gjerësisht në bërthamën e Linux-it, menaxherët e paketave (si brenda .deb të Debian), format i rekomanduar për ekosistemin aktual të Linux-it)"

msgid "mime_z"
msgstr "Paketë e ngjeshur Z (formati i komandës compress të Unix nga 1985, algoritmi LZW. Format i hershëm i ngjeshjes së Unix-it, u zëvendësua nga GZIP. Zgjerimi .Z, përdoret rrallë në sistemet moderne)"

msgid "mime_zip"
msgstr "Paketë e ngjeshur ZIP (zhvilluar nga Phil Katz në 1989, format PKZIP. I mbështetur në mënyrë vendase nga Windows, formati më universal i ngjeshjes në internet. Mbështet shumë skedarë, strukturë direktorish, mund të zgjedhë algoritmin e ngjeshjes. JAR-i i Java, APK i Android, dokumentet Office DOCX/XLSX bazohen në formatin ZIP)"

msgid "mime_zst"
msgstr "Paketë e ngjeshur Zstandard (zhvilluar nga Facebook në 2015, projektuar nga Yann Collet. Algoritëm i shpejtë i ngjeshjes, shkalla e ngjeshjes afër LZMA-s, shpejtësia tejkalon shumë GZIP. Bërthama e Linux-it 5.9+ e mbështet, Arch Linux pacman, Debian APT po e miratojnë gradualisht, standard i ngjeshjes i gjeneratës së re)"

msgid "mime_lz4"
msgstr "Paketë e ngjeshur LZ4 (zhvilluar nga Yann Collet në 2011, algoritëm jashtëzakonisht i shpejtë i ngjeshjes. Shpejtësia e ngjeshjes është mbi 10 herë më e shpejtë se GZIP, e përshtatshme për skenarë të ngjeshjes në kohë reale. Bërthama e Linux-it, OpenZFS, Hadoop e përdorin gjerësisht, zgjedhja e parë për skenarët ku shpejtësia është prioritet)"

msgid "mime_lzo"
msgstr "Paketë e ngjeshur LZO (zhvilluar nga Markus Oberhumer në 1996, algoritmi Lempel-Ziv-Oberhumer. Shpejtësia e çngjeshjes është jashtëzakonisht e shpejtë, shkalla e ngjeshjes është mesatare. Bërthama e Linux-it Squashfs, firmueri i OpenWrt e përdorin atë, i përshtatshëm për sisteme të ngulitura)"

msgid "mime_msi"
msgstr "Paketë instalimi MSI (lëshuar nga Microsoft në 1999, format i paketës së Windows Installer. Format standard i instalimit për aplikacionet Windows, mbështet kthimin e transaksioneve, menaxhimin e komponentëve, instalimin e heshtur. Format i preferuar për shpërndarjen e softuerit në nivel ndërmarrje, ende kryesor për instalimin e softuerit Windows edhe sot)"

msgid "mime_pkg"
msgstr "Paketë instalimi PKG (format i paketës së instalimit të aplikacioneve macOS, bazuar në teknologjinë Installer të Apple. Format standard i shpërndarjes së softuerit macOS, mbështet zgjedhjen e komponentëve, skriptet e instalimit, funksionin e çinstalimit. Klikimi i dyfishtë në skedarin .pkg për të instaluar, metodë e zakonshme shpërndarjeje për softuerin jashtë Mac App Store)"

msgid "mime_apk"
msgstr "Paketë aplikacioni Android APK (lëshuar nga Google në 2008, format tradicional i instalimit për aplikacionet Android. APK është në thelb një paketë ZIP që përmban kod, burime, skedar manifesti. Nga viti 2021 Google Play kërkon që aplikacionet e reja të përdorin formatin AAB, por APK përdoret ende për zhvillim dhe korrigjim, dyqane të palëve të treta dhe instalim anësor)"

msgid "mime_ipa"
msgstr "Paketë aplikacioni iOS IPA (Paketa e Dyqanit të Aplikacioneve iOS, format instalimi për aplikacionet iOS/iPadOS. Lëshuar në 2008 së bashku me iPhone SDK. Duhet të shpërndahet përmes App Store ose të nënshkruhet me një certifikatë ndërmarrjeje. Përmban skedar të ekzekutueshëm, burime, Info.plist dhe informacion nënshkrimi)"

msgid "mime_hap"
msgstr "Paketë aplikacioni HarmonyOS HAP (Paketa e Aftësisë së HarmonyOS, njësia bazë e një aplikacioni HarmonyOS. Lëshuar në 2020 me HarmonyOS 2.0. Mbështet dy lloje: entry dhe feature, format shpërndarjeje për telefonat Huawei, tabletët, orët inteligjente dhe pajisje të tjera HarmonyOS)"

msgid "mime_har"
msgstr "Bibliotekë e përbashkët statike HarmonyOS HAR (Arkivi HarmonyOS, bibliotekë e përbashkët statike e HarmonyOS, mund të ndahet nga shumë paketa HAP, përdoret për zhvillim të bazuar në komponentë dhe ripërdorim të moduleve)"

msgid "mime_aab"
msgstr "Android App Bundle (lëshuar nga Google në 2018, nga viti 2021 Google Play kërkon që aplikacionet e reja të përdorin këtë format. AAB është një format shpërndarjeje, Google Play gjeneron APK të optimizuara sipas konfigurimit të pajisjes (arkitektura CPU, dendësia e ekranit, gjuha), madhësia e paketës së instalimit zvogëlohet mesatarisht 35%. Zhvilluesit ngarkojnë AAB, përdoruesit shkarkojnë APK)"

msgid "mime_xapk"
msgstr "Paketë aplikacioni XAPK (paketë zgjerimi i aplikacioneve Android të palëve të treta, përmban APK + skedarë të dhënash OBB. Përdoret për lojëra të mëdha dhe aplikacione komplekse, zgjidh kufirin 100 MB për një skedar të vetëm APK. E zakonshme në dyqanet e aplikacioneve të palëve të treta si APKPure, APKMirror, nuk është format zyrtar i Google)"

msgid "mime_appx"
msgstr "Paketë aplikacioni Windows (lëshuar nga Microsoft në 2012, format instalimi për aplikacionet Windows 8/10/11. Mbështet konvertimin e aplikacioneve UWP dhe desktop, shpërndahet përmes Microsoft Store. Në 2024 Microsoft prezantoi MSIX si format pasardhës, duke zëvendësuar gradualisht APPX)"

msgid "mime_msix"
msgstr "Paketë aplikacioni MSIX (lëshuar nga Microsoft në 2018, format i ri i paketimit të aplikacioneve për Windows. Kërkon avantazhet e APPX dhe MSI, mbështet të gjitha llojet e aplikacioneve Windows, mund të shpërndahet përmes Microsoft Store ose të instalohet anësisht, format i rekomanduar për Windows 11)"

msgid "mime_appimage"
msgstr "Paketë aplikacioni AppImage (lëshuar në 2004, format aplikacioni Linux pa instalim. \"Një aplikacion, një skedar\", nuk kërkon instalim, funksionon drejtpërdrejt, mbështet shumicën e shpërndarjeve të Linux-it, mënyrë e zakonshme që zhvilluesit të shpërndajnë softuer Linux)"

msgid "mime_flatpak"
msgstr "Paketë aplikacioni Flatpak (lëshuar në 2015, format aplikacioni Linux i sandbox-uar. Funksionon nëpër shpërndarje, i izoluar nga sistemi pritës, i udhëhequr nga Fedora, Red Hat, format i paracaktuar i Qendrës së Softuerit GNOME)"

msgid "mime_snap"
msgstr "Paketë aplikacioni Snap (lëshuar nga Canonical në 2014, kompania mëmë e Ubuntu, format universal i aplikacioneve Linux. Përditësime automatike, izolim në sandbox, mbështet mbi 40 shpërndarje Linux, format i paracaktuar i Qendrës së Softuerit Ubuntu)"

msgid "mime_deb"
msgstr "Paketë softuerike Debian (lëshuar nga projekti Debian në 1993, format standard i instalimit për Debian/Ubuntu dhe derivatet e tyre. Menaxhohet duke përdorur dpkg, APT është ndërfaqja e menaxherit të paketave, një nga formatet më të pjekura të paketave në ekosistemin Linux, ende kryesor në familjen Debian)"

msgid "mime_rpm"
msgstr "Paketë softuerike RPM (lëshuar nga Red Hat në 1997, format standard për shpërndarjet Red Hat/Fedora/CentOS/SUSE dhe të tjera. RPM qëndron për \"Red Hat Package Manager\", së bashku me DEB janë dy formatet e mëdha të paketave në Linux, ende kryesor në familjen RHEL)"

msgid "mime_pacman"
msgstr "Paketë softuerike Arch (lëshuar nga Arch Linux në 2002, format .pkg.tar.zst i përdorur nga menaxheri i paketave pacman. Bërthama e shpërndarjes rrotulluese Arch Linux, i njohur për thjeshtësinë dhe parimin KISS, AUR (Arch User Repository) është karakteristika e tij dalluese)"

msgid "mime_exe"
msgstr "Skedar i ekzekutueshëm EXE (format i programit të ekzekutueshëm të Windows, shkurtim për \"Executable\". Format vendas i ekzekutueshëm i sistemit operativ Windows, përmban strukturën PE. Evoluar nga formati MZ i MS-DOS, në 1993 Windows NT prezantoi formatin PE (Portable Executable) dhe përdoret edhe sot. Paketat e instalimit të softuerit, aplikacionet, mjetet e sistemit përdorin këtë format. Përdoruesi klikon dy herë për ta ekzekutuar, formati më i përdorur i ekzekutueshëm në botë)"

msgid "mime_dll"
msgstr "Bibliotekë dinamike DLL (lëshuar nga Microsoft në 1993, Dynamic Link Library. Bibliotekë e përbashkët e kodit të Windows, ngarkohet në mënyrë dinamike gjatë ekzekutimit të programit, kursen memorie dhe hapësirë në disk. Komponentët e sistemit, shtojcat e aplikacioneve, drejtuesit përdorin formatin DLL. Mënyra kryesore e implementimit të API të Windows, problemi DLL Hell u zbut në epokën .NET)"

msgid "mime_com"
msgstr "Skedar i ekzekutueshëm COM (format i ekzekutueshëm nga epoka e MS-DOS, shkurtim për \"Command\". Strukturë e thjeshtë skedari, kufi 64 KB, format kryesor përpara Windows 3.x. I hequr, Windows modern përdor formatin EXE, zgjerimi COM përdoret ende për disa skedarë komponentësh)"

msgid "mime_aac"
msgstr "Audio AAC (standard MPEG nga 1997, Advanced Audio Coding. Pasardhësi i MP3, cilësia e zërit superiore ndaj MP3 me të njëjtin bitrate, format i paracaktuar i audios për YouTube, iTunes, Nintendo Switch)"

msgid "mime_alac"
msgstr "Audio ALAC (zhvilluar nga Apple në 2004, Apple Lossless Audio Codec. Format i humbjes së Apple, burim i hapur në 2011, format i paracaktuar për audio pa humbje në iTunes dhe Apple Music)"

msgid "mime_flac"
msgstr "Audio FLAC (zhvilluar nga Fondacioni Xiph.Org në 2001, Free Lossless Audio Codec. Ngjeshje pa humbje, cilësi e zërit e njëjtë me CD-në, madhësia e skedarit rreth gjysma e WAV origjinal. Burim i hapur pa patenta, format i preferuar për audiofilët dhe koleksionistët e muzikës dixhitale)"

msgid "mime_mp3"
msgstr "Audio MP3 (zhvilluar nga Instituti Fraunhofer në 1993, MPEG-1 Audio Layer 3. Format ngjeshjeje me humbje, madhësi e vogël e skedarit, cilësi e pranueshme, formati kryesor i revolucionit të muzikës dixhitale të viteve 2000, shtytësi i iPod dhe Napster. Patenta skadoi në 2017, u bë format i domenit publik)"

msgid "mime_oga"
msgstr "Audio Ogg Audio (zhvilluar nga Fondacioni Xiph.Org, format i pastër audio i kontejnerit Ogg, përdor kodimin Vorbis. Burim i hapur pa patenta, efikasiteti i ngjeshjes më i mirë se MP3, përdoret gjerësisht në projektet me burim të hapur)"

msgid "mime_ogg"
msgstr "Audio OGG (zhvilluar nga Fondacioni Xiph.Org në 2000, format Ogg Vorbis. Burim i hapur pa patenta, efikasiteti i ngjeshjes më i mirë se MP3, përdorues i hershëm ishte Spotify, përdoret gjerësisht për efekte zanore në lojëra)"

msgid "mime_opus"
msgstr "Audio Opus (standardizuar nga IETF në 2012, format audio me burim të hapur pa patenta. Kombinon teknologjitë SILK dhe CELT, vonesë jashtëzakonisht e ulët, efikasiteti më i lartë i ngjeshjes, format i paracaktuar i audios për WebRTC, WhatsApp, Discord)"

msgid "mime_wav"
msgstr "Audio WAV (zhvilluar nga Microsoft dhe IBM në 1991, format i paracaktuar i audios në Windows. Kodim PCM pa ngjeshje, cilësi e zërit pa humbje, por madhësi e madhe e skedarit, format standard për redaktimin profesional të audios)"

msgid "mime_wma"
msgstr "Audio WMA (zhvilluar nga Microsoft në 1999, Windows Media Audio. Dy versione: me humbje dhe pa humbje, i mbështetur në mënyrë vendase nga Windows, u përhap me Windows Media Player. Tani i margjinalizuar, i zëvendësuar nga MP3/AAC)"

msgid "mime_dsf"
msgstr "Audio DSF (format Direct Stream Digital, zhvilluar nga Sony dhe Philips. Frekuencë e lartë e kampionimit 1-bit, format standard për audio DSD, versioni dixhital i SACD, format audio i nivelit të lartë për audiofilët, madhësia e skedarit të madhe)"

msgid "mime_ape"
msgstr "Audio APE (zhvilluar nga Monkey's Audio në vitin 2000, format kompresimi pa humbje. Kompresim më i lartë se FLAC por kodim më i ngadalshëm, ende në përdorim në platformën Windows dhe në mesin e entuziastëve të audios)"

msgid "mime_mid"
msgstr "Audio MIDI (krijuar nga Asociacioni MIDI në 1983, Musical Instrument Digital Interface. Format i partiturës muzikore, jo regjistrim, madhësia e skedarit shumë e vogël, standard për instrumentet elektronike, tonet e ziles së telefonave celularë, efektet zanore në lojëra. Në 1991 General MIDI u standardizua, duke përcaktuar 120 timbra instrumentesh)"

msgid "mime_m4a"
msgstr "Audio M4A (Audio MPEG-4, format kontejneri për AAC. Format standard i dyqanit të muzikës iTunes, format kryesor i audios në ekosistemin Apple, mbështet mbrojtjen DRM)"

msgid "mime_m3u"
msgstr "Listë për luajtje M3U (format i listës së luajtjes me URL MP3, skedar i thjeshtë teksti, regjistron shtigjet e skedarëve audio. Standard nga epoka e Winamp, përdoret për radio në internet, transmetim muzikor në internet. M3U8 është versioni i tij UTF-8, përdoret për HTTP Live Streaming)"

msgid "mime_asf"
msgstr "Transmetim ASF (zhvilluar nga Microsoft në 1996, Advanced Systems Format. Kontejner transmetimi i Windows Media, mbështet transmetimin sinkron të audios dhe videos. Përdoret për transmetime të drejtpërdrejta dhe video në kërkesë, WMA/WMV bazohen në kontejnerin ASF)"

msgid "mime_avi"
msgstr "Video AVI (lëshuar nga Microsoft në 1992, standard i hershëm video për Windows. \"Audio Video Interleave\", ruajtje e ndërthurur e audios dhe videos, formati më i popullarizuar i videos në vitet 1990-2000, tani i zëvendësuar nga MP4/MKV)"

msgid "mime_divx"
msgstr "Video DivX (zhvilluar nga kompania DivX në 1998, format kodimi video i bazuar në MPEG-4. Format kryesor i ndarjes së videove në internet në vitet 2000, teknologjia e parë që ngjeshi cilësinë DVD në madhësinë e CD-së. Për shkak të mosmarrëveshjeve mbi të drejtat e autorit, më vonë u shndërrua në një kodues komercial)"

msgid "mime_mp4"
msgstr "Video MP4 (standard MPEG nga 2001, MPEG-4 Pjesa 14. Formati më universal i videos në botë, mbështet kodimin H.264/H.265, format i paracaktuar për video në internet, regjistrime në telefon, YouTube)"

msgid "mime_m4v"
msgstr "Video M4V (format video i iTunes, variant i MP4. Format video në ekosistemin Apple, format standard për filma, emisione televizive në iTunes Store, mbështet mbrojtjen e të drejtave të autorit DRM)"

msgid "mime_mpeg"
msgstr "Video MPEG (krijuar nga organizata MPEG në 1988, Moving Picture Experts Group. Themelues i standardeve të ngjeshjes dixhitale të videos, ndikim i thellë i MPEG-1 (VCD), MPEG-2 (DVD), MPEG-4 (video në internet))"

msgid "mime_mkv"
msgstr "Video MKV (zhvilluar nga projekti Matroska në 2002, kontejner multimedial me burim të hapur. Mbështet shumë pista audio, shumë titra, kapituj, \"mjet ambalazhimi\", format i preferuar për ndarjen e filmave HD)"

msgid "mime_mpg"
msgstr "Video MPEG (zgjerim i videos MPEG-1/MPEG-2, format standard për VCD dhe DVD. Format kryesor i videos në disqet optike në vitet 1990-2000, tani i zëvendësuar nga H.264/H.265)"

msgid "mime_ogv"
msgstr "Video Ogg Video (zhvilluar nga Fondacioni Xiph.Org, format video i kontejnerit Ogg, përdor kodimin Theora. Burim i hapur pa patenta, një nga standardet e hershme për video HTML5, i mbështetur në mënyrë vendase nga Firefox)"

msgid "mime_ogx"
msgstr "Kontejner multimedial Ogg (zhvilluar nga Fondacioni Xiph.Org, zgjerim universal i kontejnerit Ogg, mund të përmbajë shumë pista: audio, video, titra etj. Standard multimedial me burim të hapur, përdoret për lojëra, transmetim)"

msgid "mime_rm"
msgstr "Video RealMedia (zhvilluar nga RealNetworks në 1995, format RealMedia. Pionier i transmetimit në internet në vitet 1990-2000, format bazë i luajtësit RealPlayer. Dobësitë: kërkon luajtës të veçantë, cilësi e dobët e ngjeshjes, më vonë u zëvendësua nga Flash/MP4)"

msgid "mime_flv"
msgstr "Video Flash (formati u shfaq në 2002, format Flash Video. Dikur ishte format kryesor për videot në internet, përdorues i hershëm ishte YouTube. Dobësitë: kërkon plugin Flash, performancë e dobët, shumë vrima sigurie. Nga viti 2015 faqet kryesore të internetit kaluan në videon HTML5, tani i hequr)"

msgid "mime_f4v"
msgstr "Video F4V (format video Flash i zhvilluar nga Adobe, pasardhës i FLV. Bazuar në standardin MPEG-4, mbështet kodimin H.264. Së bashku me teknologjinë Flash u hoq, Adobe ndërpreu mbështetjen në 2020)"

msgid "mime_wmv"
msgstr "Video WMV (zhvilluar nga Microsoft në 1999, Windows Media Video. I mbështetur në mënyrë vendase nga Windows, i optimizuar për transmetim, format i zakonshëm për videot e hershme në internet, tani i margjinalizuar)"

msgid "mime_wmf"
msgstr "Format mediatik WMF (Windows Media Format, platforma mediatike e Microsoft. Përfshin emrin e përgjithshëm për videon WMV dhe audion WMA, i mbështetur në mënyrë vendase nga Windows Media Player)"

msgid "mime_mov"
msgstr "Video MOV (zhvilluar nga Apple në 1991, format kontejneri QuickTime. Format standard për redaktimin profesional të videos, mbështet shumë kodekë, i mbështetur në mënyrë vendase nga Final Cut Pro, Premiere)"

msgid "mime_qt"
msgstr "Video QuickTime (lëshuar nga Apple në 1991, format QuickTime. Standard video për platformën Mac, MOV është kontejneri i tij, luajtësi QuickTime u përdor gjerësisht. Në 2016 Apple ndërpreu zhvillimin e versionit për Windows, duke u zëvendësuar gradualisht nga MP4)"

msgid "mime_webm"
msgstr "Video WebM (lëshuar nga Google në 2010, format video me burim të hapur pa patenta. Bazuar në kontejnerin Matroska, kodimin VP8/VP9, format standard për videon HTML5, format i paracaktuar i luajtjes në ueb për YouTube)"

msgid "mime_3gp"
msgstr "Video 3GP (krijuar nga 3GPP në 2000, format video për pajisjet celulare. Madhësia e skedarit shumë e vogël, cilësi e ulët, format për regjistrimet video të telefonave celularë të hershëm, përdoret për dërgimin e MMS)"

