msgid "will be lost/reset."
msgstr "do të humbasin/rivendosen!"

msgid "Last config file used to build this data file was"
msgstr "Skedari i fundit i konfigurimit i përdorur për të ndërtuar këtë skedar të dhënash ishte"

msgid "Position (offset in bytes) in this file for beginning of each section for"
msgstr "Pozicioni (zhvendosja në bajt) në këtë skedar për fillimin e secilës pjesë për"

