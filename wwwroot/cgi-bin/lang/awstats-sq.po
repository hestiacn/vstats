msgstr "ID-ja e robotit - Goditjet - Gjerësia e brezit - Vizita e fundit - Goditjet në robots.txt"

msgid "Worm ID - Hits - Bandwidth - Last visit"
msgstr "ID-ja e krimbit - Goditjet - Gjerësia e brezit - Vizita e fundit"

