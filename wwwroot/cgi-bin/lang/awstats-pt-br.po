#==============================================================================
# Ajuda da Linha de Comando
#==============================================================================

msgid "----- %s %s (c) 2000-2025 Laurent Destailleur -----\n"
msgstr "----- %s %s (c) 2000-2025 Laurent Destailleur -----\n"

msgid "AWStats is a free web server logfile analyzer to show you advanced web\n"
msgstr "AWStats é um analisador gratuito de arquivos de log de servidores web para mostrar estatísticas web avançadas\n"

msgid "statistics.\n"
msgstr "estatísticas.\n"

msgid "AWStats comes with ABSOLUTELY NO WARRANTY. It's a free software distributed\n"
msgstr "AWStats é distribuído SEM QUALQUER GARANTIA. É um software livre distribuído\n"

msgid "with a GNU General Public License (See LICENSE file for details).\n"
msgstr "sob a Licença Pública Geral GNU (Consulte o arquivo LICENSE para detalhes).\n"

msgid "Syntax: %s.%s -config=virtualhostname [options]\n"
msgstr "Sintaxe: %s.%s -config=nomehostvirtual [opções]\n"

msgid "  This runs %s in command line to update statistics (-update option) of a\n"
msgstr "  Isto executa %s na linha de comando para atualizar estatísticas (opção -update) de um\n"

msgid "   web site, from the log file defined in AWStats config file, or build a HTML\n"
msgstr "   site web, a partir do arquivo de log definido no arquivo de configuração do AWStats, ou constrói um relatório\n"

msgid "   report (-output option).\n"
msgstr "   HTML (opção -output).\n"

msgid "  First, %s tries to read %s.virtualhostname.conf as the config file.\n"
msgstr "  Primeiro, %s tenta ler %s.virtualhostname.conf como arquivo de configuração.\n"

msgid "  If not found, %s tries to read %s.conf, and finally the full path passed to -config=\n"
msgstr "  Se não encontrado, %s tenta ler %s.conf, e finalmente o caminho completo passado para -config=\n"

msgid "  Note 1: Config files (%s.virtualhostname.conf or %s.conf) must be\n"
msgstr "  Nota 1: Os arquivos de configuração (%s.virtualhostname.conf ou %s.conf) devem estar\n"

msgid "   in /etc/awstats, /usr/local/etc/awstats, /etc or same directory than\n"
msgstr "   em /etc/awstats, /usr/local/etc/awstats, /etc ou no mesmo diretório que\n"

msgid "   awstats.pl script file.\n"
msgstr "   o arquivo de script awstats.pl.\n"

msgid "  Note 2: If AWSTATS_FORCE_CONFIG environment variable is defined, AWStats will\n"
msgstr "  Nota 2: Se a variável de ambiente AWSTATS_FORCE_CONFIG estiver definida, o AWStats\n"

msgid "   use it as the \"config\" value, whatever is the value on command line or URL.\n"
msgstr "   usará esse valor como \"config\", independentemente do valor na linha de comando ou URL.\n"

msgid "   See AWStats documentation for all setup instrutions.\n"
msgstr "   Consulte a documentação do AWStats para todas as instruções de configuração.\n"

msgid "Options to update statistics:\n"
msgstr "Opções para atualizar estatísticas:\n"

msgid "  -update        to update statistics (default)\n"
msgstr "  -update        para atualizar estatísticas (padrão)\n"

msgid "  -showsteps     to add benchmark information every %s lines processed\n"
msgstr "  -showsteps     para adicionar informação de benchmark a cada %s linhas processadas\n"

msgid "  -showcorrupted to add output for each corrupted lines found, with reason\n"
msgstr "  -showcorrupted para adicionar saída para cada linha corrompida encontrada, com motivo\n"

msgid "  -showdropped   to add output for each dropped lines found, with reason\n"
msgstr "  -showdropped   para adicionar saída para cada linha descartada encontrada, com motivo\n"

msgid "  -showunknownorigin  to output referer when it can't be parsed\n"
msgstr "  -showunknownorigin  para mostrar o referenciador quando não pode ser analisado\n"

msgid "  -showdirectorigin   to output log line when origin is a direct access\n"
msgstr "  -showdirectorigin   para mostrar a linha de log quando a origem é um acesso direto\n"

msgid "  -updatefor=n   to stop the update process after parsing n lines\n"
msgstr "  -updatefor=n   para parar o processo de atualização após analisar n linhas\n"

msgid "  -LogFile=x     to change log to analyze whatever is 'LogFile' in config file\n"
msgstr "  -LogFile=x     para alterar o log a analisar, sobrescrevendo 'LogFile' no arquivo de configuração\n"

msgid "  Be care to process log files in chronological order when updating statistics.\n"
msgstr "  Tenha cuidado para processar os arquivos de log em ordem cronológica ao atualizar estatísticas.\n"

msgid "Options to show statistics:\n"
msgstr "Opções para mostrar estatísticas:\n"

msgid "  -output      to output main HTML report (no update made except with -update)\n"
msgstr "  -output      para mostrar o relatório HTML principal (sem atualização, exceto com -update)\n"

msgid "  -output=x    to output other report pages where x is:\n"
msgstr "  -output=x    para mostrar outras páginas de relatório onde x é:\n"

msgid "               alldomains       to build page of all domains/countries\n"
msgstr "               alldomains       para construir página de todos os domínios/países\n"

msgid "               allhosts         to build page of all hosts\n"
msgstr "               allhosts         para construir página de todos os hospedeiros\n"

msgid "               lasthosts        to build page of last hits for hosts\n"
msgstr "               lasthosts        para construir página dos últimos acessos por hospedeiro\n"

msgid "               unknownip        to build page of all unresolved IP\n"
msgstr "               unknownip        para construir página de todos os IPs não resolvidos\n"

msgid "               allemails        to build page of all email senders (maillog)\n"
msgstr "               allemails        para construir página de todos os remetentes de email (log de correio)\n"

msgid "               lastemails       to build page of last email senders (maillog)\n"
msgstr "               lastemails       para construir página dos últimos remetentes de email (log de correio)\n"

msgid "               allemailr        to build page of all email receivers (maillog)\n"
msgstr "               allemailr        para construir página de todos os destinatários de email (log de correio)\n"

msgid "               lastemailr       to build page of last email receivers (maillog)\n"
msgstr "               lastemailr       para construir página dos últimos destinatários de email (log de correio)\n"

msgid "               alllogins        to build page of all logins used\n"
msgstr "               alllogins        para construir página de todos os logins usados\n"

msgid "               lastlogins       to build page of last hits for logins\n"
msgstr "               lastlogins       para construir página dos últimos acessos por login\n"

msgid "               allrobots        to build page of all robots/spider visits\n"
msgstr "               allrobots        para construir página de todas as visitas de robôs/spiders\n"

msgid "               lastrobots       to build page of last hits for robots\n"
msgstr "               lastrobots       para construir página dos últimos acessos por robôs\n"

msgid "               urldetail        to list most often viewed pages\n"
msgstr "               urldetail        para listar as páginas mais visualizadas\n"

msgid "               urldetail:filter to list most often viewed pages matching filter\n"
msgstr "               urldetail:filter para listar as páginas mais visualizadas que correspondem ao filtro\n"

msgid "               urlentry         to list entry pages\n"
msgstr "               urlentry         para listar páginas de entrada\n"

msgid "               urlentry:filter  to list entry pages matching filter\n"
msgstr "               urlentry:filter  para listar páginas de entrada que correspondem ao filtro\n"

msgid "               urlexit          to list exit pages\n"
msgstr "               urlexit          para listar páginas de saída\n"

msgid "               urlexit:filter   to list exit pages matching filter\n"
msgstr "               urlexit:filter   para listar páginas de saída que correspondem ao filtro\n"

msgid "               osdetail         to build page with os detailed versions\n"
msgstr "               osdetail         para construir página com versões detalhadas do SO\n"

msgid "               browserdetail    to build page with browsers detailed versions\n"
msgstr "               browserdetail    para construir página com versões detalhadas dos navegadores\n"

msgid "               unknownbrowser   to list 'User Agents' with unknown browser\n"
msgstr "               unknownbrowser   para listar 'User Agents' com navegador desconhecido\n"

msgid "               unknownos        to list 'User Agents' with unknown OS\n"
msgstr "               unknownos        para listar 'User Agents' com SO desconhecido\n"

msgid "               refererse        to build page of all refering search engines\n"
msgstr "               refererse        para construir página de todos os mecanismos de busca de referência\n"

msgid "               refererpages     to build page of all refering pages\n"
msgstr "               refererpages     para construir página de todas as páginas de referência\n"

msgid "               keyphrases       to list all keyphrases used on search engines\n"
msgstr "               keyphrases       para listar todas as frases-chave usadas em mecanismos de busca\n"

msgid "               keywords         to list all keywords used on search engines\n"
msgstr "               keywords         para listar todas as palavras-chave usadas em mecanismos de busca\n"

msgid "               errors404        to list 'Referers' for 404 errors\n"
msgstr "               errors404        para listar 'Referenciadores' para erros 404\n"

msgid "               allextraX        to build page of all values for ExtraSection X\n"
msgstr "               allextraX        para construir página de todos os valores para Seção Extra X\n"

msgid "  -staticlinks           to have static links in HTML report page\n"
msgstr "  -staticlinks           para ter links estáticos na página de relatório HTML\n"

msgid "  -staticlinksext=xxx    to have static links with .xxx extension instead of .html\n"
msgstr "  -staticlinksext=xxx    para ter links estáticos com extensão .xxx em vez de .html\n"

msgid "  -lang=LL     to output a HTML report in language LL (en,de,es,fr,it,nl,...)\n"
msgstr "  -lang=LL     para mostrar um relatório HTML no idioma LL (en,de,es,fr,it,nl,...)\n"

msgid "  -month=MM    to output a HTML report for an old month MM\n"
msgstr "  -month=MM    para mostrar um relatório HTML para um mês antigo MM\n"

msgid "  -year=YYYY   to output a HTML report for an old year YYYY\n"
msgstr "  -year=YYYY   para mostrar um relatório HTML para um ano antigo YYYY\n"

msgid "  The 'date' options doesn't allow you to process old log file. They only\n"
msgstr "  As opções de 'data' não permitem processar arquivos de log antigos. Elas apenas\n"

msgid "  allow you to see a past report for a chosen month/year period instead of\n"
msgstr "  permitem ver um relatório passado para um período mês/ano escolhido em vez do\n"

msgid "  current month/year.\n"
msgstr "  mês/ano atual.\n"

msgid "Other options:\n"
msgstr "Outras opções:\n"

msgid "  -debug=X     to add debug informations lesser than level X (speed reduced)\n"
msgstr "  -debug=X     para adicionar informações de depuração menores que o nível X (velocidade reduzida)\n"

msgid "  -version     show AWStats version\n"
msgstr "  -version     mostrar versão do AWStats\n"

msgid "Now supports/detects:\n"
msgstr "Agora suporta/detecta:\n"

msgid "  Web/Ftp/Mail/streaming server log analyzis (and load balanced log files)\n"
msgstr "  Análise de logs de servidores Web/FTP/Correio/streaming (e arquivos de log com balanceamento de carga)\n"

msgid "  Reverse DNS lookup (IPv4 and IPv6) and GeoIP lookup\n"
msgstr "  Pesquisa DNS reversa (IPv4 e IPv6) e pesquisa GeoIP\n"

msgid "  Number of visits, number of unique visitors\n"
msgstr "  Número de visitas, número de visitantes únicos\n"

msgid "  Visits duration and list of last visits\n"
msgstr "  Duração das visitas e lista das últimas visitas\n"

msgid "  Authenticated users\n"
msgstr "  Usuários autenticados\n"

msgid "  Days of week and rush hours\n"
msgstr "  Dias da semana e horas de pico\n"

