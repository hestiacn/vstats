{
  "schema_version": 1,
  "login_rotation": {
    "enabled": 0,
    "window_seconds": 86400,
    "pair_seconds": 30,
    "min_pairs": 3,
    "min_platform_switches": 2,
    "distinct_user_agents": 3,
    "distinct_platforms": 2,
    "login_paths": []
  },
  "head_scan": {
    "distinct_paths": 6,
    "enabled": 0,
    "min_requests": 12,
    "not_found_requests": 4,
    "window_seconds": 60
  },
  "sensitive_scan": {
    "distinct_paths": 3,
    "enabled": 0,
    "min_requests": 3,
    "paths": [
      "/.env",
      "/.env.local",
      "/.env.backup",
      "/.env.bak",
      "/.env.example",
      "/.git/config",
      "/.git-credentials",
      "/.svn/wc.db"
    ],
    "window_seconds": 60
  },
  "wp_enumeration": {
    "author_paths": [
      "/",
      "/index.php"
    ],
    "distinct_author_ids": 3,
    "distinct_platforms": 2,
    "distinct_user_agents": 4,
    "enabled": 0,
    "min_requests": 8,
    "not_found_requests": 3,
    "rest_routes": [
      "/wp/v2/users"
    ],
    "user_api_requests": 1,
    "user_paths": [
      "/wp-json/wp/v2/users",
      "/index.php/wp-json/wp/v2/users"
    ],
    "window_seconds": 60
  },
  "crawler_tokens": [
    "Googlebot",
    "Bytespider",
    "bingbot",
    "AhrefsBot",
    "ClaudeBot",
    "GPTBot",
    "curl",
    "Wget",
    "python-requests",
    "fd-crm-enrich",
    "RisikomonitorNotify"
  ],
  "wp_query_probe": {
    "enabled": 0,
    "window_seconds": 60,
    "query_paths": [
      "/",
      "/index.php"
    ],
    "plugin_prefixes": [
      "/wp-content/plugins/"
    ],
    "query_keys": [
      "wp_query",
      "wp_stylesheet_path",
      "wp_template_path",
      "_wp_current_template_content"
    ]
  },
  "backdoor_probe": {
    "enabled": 0,
    "window_seconds": 60,
    "min_requests": 3,
    "distinct_paths": 3,
    "not_found_requests": 2,
    "post_requests": 1,
    "entry_paths": [
      "/",
      "/index.php",
      "/favicon.ico"
    ],
    "paths": [
      "/wp-content/themes/seotheme/db.php",
      "/wp-plain.php",
      "/wp-content/plugins/fix/up.php",
      "/ALFA_DATA/alfacgiapi/perl.alfa",
      "/alfacgiapi/perl.alfa",
      "/wp-content/plugins/apikey/apikey.php",
      "/wp-content/plugins/apikey/apikey.php.suspected",
      "/plugins/content/apismtp/apismtp.php",
      "/plugins/content/apismtp/apismtp.php.suspected"
    ]
  },
  "protocol_probe": {
    "enabled": 0,
    "window_seconds": 60,
    "post_paths": [
      "/mcp"
    ],
    "get_paths": [
      "/sse"
    ],
    "tool_tokens": [
      "python-httpx"
    ],
    "entry_paths": [
      "/",
      "/index.php",
      "/favicon.ico"
    ]
  },
  "service_discovery": {
    "enabled": 0,
    "window_seconds": 60,
    "distinct_families": 3
  },
  "operator_association": {
    "enabled": 0,
    "retrospective_enabled": 0,
    "retrospective_months": []
  }
}
