use v5.020;
use strict;
use warnings;
use Test::More;
use JSON::PP;
use Time::Local qw(timegm);
use VStats::TrafficClassifier;
my $C='VStats::TrafficClassifier';my $J=JSON::PP->new->utf8->canonical;
my @clients=('192.0.2.1','2001:db8::1','2001:0DB8:0:0:0:0:0:1','::ffff:192.0.2.1','not-an-ip.example');
my @events=map{+{timestamp=>timegm(0,0,0,1,9,2026),client=>$_,target=>'/',status=>200,user_agent=>undef}}@clients;
push @events,{%{$events[0]},timestamp=>timegm(0,0,0,1,10,2026)};
my $engine=$C->new(config=>$C->config('{"schema_version":1}'),format=>'jsonl',details=>1);
$engine->feed(join('',map{$J->encode($_)."\n"}@events));my$r=$engine->finish;my$d=$r->{details};
is($d->[0]{source_month_key},'2026-10|4:c0000201','canonical key binds literal IPv4 and UTC month');
is($d->[1]{source_month_key},$d->[2]{source_month_key},'IPv6 spelling aliases get the same site-month key');
isnt($d->[0]{source_key},$d->[3]{source_key},'IPv4-mapped IPv6 stays separate from IPv4');
ok(!defined $d->[4]{source_month_key},'hostnames do not become literal-IP policy keys');
isnt($d->[0]{source_month_key},$d->[5]{source_month_key},'source does not carry policy into another month');
is($d->[0]{source_key},$d->[5]{source_key},'source identity itself is month independent');
is($r->{behavior}{flagged_requests},0,'source annotation invents no detection');
ok(!grep({$_->{excluded}}@$d),'source annotation invents no request exclusions');
delete$r->{details};delete$r->{details_warning};
unlike(VStats::TrafficClassifier::canonical_json($r),qr/c0000201|20010db8|192\.0\.2\.1/,'source keys remain private detail only');
done_testing;
